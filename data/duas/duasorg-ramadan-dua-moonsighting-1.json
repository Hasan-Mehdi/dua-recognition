{
 "dua_id": "duasorg-ramadan-dua-moonsighting-1",
 "dua_name_en": "Moonsighting of the Month of Ramadhan - Rabbi wa Rabbukallah",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-dua-moonsighting.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "رَبّي وَرَبّكَ اللّهُ رَبّ العَالَمِينَ."
  },
  {
   "segment_id": 2,
   "arabic": "اللّهُمّ أَهِلّهُ عَلَيْنَا بِالأَمْنِ وَالإيمَانِ"
  },
  {
   "segment_id": 3,
   "arabic": "وَالسّلامَةِ وَالإسْلامِ"
  },
  {
   "segment_id": 4,
   "arabic": "وَالمُسَارَعَةِ إلَى مَا تُحِبّ وَتَرْضَى."
  },
  {
   "segment_id": 5,
   "arabic": "اللّهُمّ بَارِكْ لَنَا فِي شَهْرِنَا هذَا،"
  },
  {
   "segment_id": 6,
   "arabic": "وَارْزُقْنَا خَيْرَهُ وَعَوْنَهُ،"
  },
  {
   "segment_id": 7,
   "arabic": "وَاصْرِفْ عَنَّا ضُرّهُ وَشَرّهُ وَبَلاءَهُ وَفِتْنَتَهُ."
  }
 ]
}