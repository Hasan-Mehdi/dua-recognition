{
 "dua_id": "sahifa-25",
 "dua_name_en": "Sahifa 25: his supplication for his children",
 "dua_name_ar": "دُعَاؤُهُ لِوُلْدِهِ",
 "source": "https://duas.pro/25-his-supplication-for-his-children",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "أَللَّهُمَّ وَمُنَّ عَلَيَّ بِبَقَاءِ وُلْدِي،"
  },
  {
   "segment_id": 2,
   "arabic": "وَبِإصْلاَحِهِمْ لِي، وَبِإمْتَاعِي بِهِمْ."
  },
  {
   "segment_id": 3,
   "arabic": "إلهِي أمْدُدْ لِي فِي أَعْمَارِهِمْ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَزِدْ لِي فِي آجَالِهِمْ،"
  },
  {
   "segment_id": 5,
   "arabic": "وَرَبِّ لِي صَغِيرَهُمْ"
  },
  {
   "segment_id": 6,
   "arabic": "وَقَوِّ لِي ضَعِيْفَهُمْ،"
  },
  {
   "segment_id": 7,
   "arabic": "وَأَصِحَّ لِي أَبْدَانَهُمْ وَأَدْيَانَهُمْ وَأَخْلاَقَهُمْ ،"
  },
  {
   "segment_id": 8,
   "arabic": "وَعَافِهِمْ فِي أَنْفُسِهِمْ وَفِي جَوَارِحِهِمْ"
  },
  {
   "segment_id": 9,
   "arabic": "وَفِي كُلِّ مَا عُنِيْتُ بِهِ مِنْ أَمْرِهِمْ،"
  },
  {
   "segment_id": 10,
   "arabic": "وَأَدْرِرْ لِي وَعَلَى يَـدِي أَرْزَاقَهُمْ،"
  },
  {
   "segment_id": 11,
   "arabic": "وَاجْعَلْهُمْ أَبْرَاراً أَتْقِيَاءَ بُصَراءَ سَامِعِينَ"
  },
  {
   "segment_id": 12,
   "arabic": "مُطِيعِينَ لَكَ وَلأوْلِيَائِكَ مُحِبِّينَ مُنَاصِحِينَ،"
  },
  {
   "segment_id": 13,
   "arabic": "وَلِجَمِيْعِ أَعْدَآئِكَ مُعَانِدِينَ وَمُبْغِضِينَ آمِينَ."
  },
  {
   "segment_id": 14,
   "arabic": "أَللَّهُمَّ اشْدُدْ بِهِمْ عَضُدِي،"
  },
  {
   "segment_id": 15,
   "arabic": "وَأَقِمْ بِهِمْ أَوَدِيْ،"
  },
  {
   "segment_id": 16,
   "arabic": "وَكَثِّرْ بِهِمْ عَدَدِي،"
  },
  {
   "segment_id": 17,
   "arabic": "وَزَيِّنْ بِهِمْ مَحْضَرِي،"
  },
  {
   "segment_id": 18,
   "arabic": "وَأَحْييِ بِهِمْ ذِكْرِي،"
  },
  {
   "segment_id": 19,
   "arabic": "وَاكْفِنِي بِهِمْ فِي غَيْبَتِي"
  },
  {
   "segment_id": 20,
   "arabic": "وَأَعِنِّي بِهِمْ عَلَى حَاجَتِي،"
  },
  {
   "segment_id": 21,
   "arabic": "وَاجْعَلْهُمْ لِي مُحِبِّينَ، وَعَلَيَّ حَدِبِينَ"
  },
  {
   "segment_id": 22,
   "arabic": "مُقْبِلِينَ مُسْتَقِيمِينَ لِيْ،"
  },
  {
   "segment_id": 23,
   "arabic": "مُطِيعِينَ غَيْرَ عَاصِينَ"
  },
  {
   "segment_id": 24,
   "arabic": "وَلاَ عَاقِّينَ وَلا مُخَالِفِينَ وَلاَ خـاطِئِينَ،"
  },
  {
   "segment_id": 25,
   "arabic": "وَأَعِنِّي عَلَى تَرْبِيَتِهِمْ وَتَأدِيْبِهِمْ وَبِرِّهِمْ،"
  },
  {
   "segment_id": 26,
   "arabic": "وَهَبْ لِيْ مِنْ لَدُنْكَ مَعَهُمْ أَوْلاداً ذُكُوراً ،"
  },
  {
   "segment_id": 27,
   "arabic": "وَاجْعَلْ ذَلِكَ خَيْراً لي"
  },
  {
   "segment_id": 28,
   "arabic": "وَاجْعَلْهُمْ لِي عَوناً عَلَى مَا سَأَلْتُكَ،"
  },
  {
   "segment_id": 29,
   "arabic": "وَأَعِذْنِي وَذُرِّيَّتِي مِنَ الشَّيْطَانِ الرَّجِيمِ،"
  },
  {
   "segment_id": 30,
   "arabic": "فَإنَّكَ خَلَقْتَنَا وَأَمَرْتَنَا وَنَهَيْتَنَا"
  },
  {
   "segment_id": 31,
   "arabic": "وَرَغّبْتَنَا فِي ثَوَابِ مَا أَمَرْتَنَا وَرَهَّبْتَنَا عِقَابَهُ،"
  },
  {
   "segment_id": 32,
   "arabic": "وَجَعَلْتَ لَنَا عَدُوّاً يَكِيدُنَا،"
  },
  {
   "segment_id": 33,
   "arabic": "سَلَّطْتَهُ مِنَّا عَلَى مَا لَمْ تُسَلِّطْنَا عَلَيْهِ مِنْهُ،"
  },
  {
   "segment_id": 34,
   "arabic": "أَسْكَنْتَهُ صُدُورَنَا، وَأَجْرَيْتَهُ مَجَارِيَ دِمَائِنَا،"
  },
  {
   "segment_id": 35,
   "arabic": "لاَ يَغْفُلُ إنْ غَفَلْنَا، وَلاَ يَنْسَى إنْ نَسِينَا،"
  },
  {
   "segment_id": 36,
   "arabic": "يُؤْمِنُنَا عِقَابَكَ، وَيَخَوِّفُنَا بِغَيْرِكَ،"
  },
  {
   "segment_id": 37,
   "arabic": "إنْ هَمَمْنَا بِفَاحِشَة شَجَّعَنَا عَلَيْهَا،"
  },
  {
   "segment_id": 38,
   "arabic": "وَإنْ هَمَمْنَا بِعَمَل صَالِح ثَبَّطْنَا عَنْهُ،"
  },
  {
   "segment_id": 39,
   "arabic": "يَتَعَرَّضُ لَنَا بِالشَّهَوَاتِ،"
  },
  {
   "segment_id": 40,
   "arabic": "وَيَنْصِبُ لَنَا بِالشَّبُهَاتِ،"
  },
  {
   "segment_id": 41,
   "arabic": "إنْ وَعَدَنَا كَذَبَنَا"
  },
  {
   "segment_id": 42,
   "arabic": "وَإنْ مَنَّانا، أَخْلَفَنَا"
  },
  {
   "segment_id": 43,
   "arabic": "وَإلاّ تَصْرِفْ عَنَّا كَيْدَهُ يُضِلَّنَا،"
  },
  {
   "segment_id": 44,
   "arabic": "وَإلاّ تَقِنَا خَبالَهُ يَسْتَزِلَّنَا."
  },
  {
   "segment_id": 45,
   "arabic": "أَللَّهُمَّ فَاقْهَرْ سُلْطَانَهُ عَنَّا بِسُلْطَانِكَ"
  },
  {
   "segment_id": 46,
   "arabic": "حَتَّى تَحْبِسَهُ عَنَّا بِكَثْرَةِ الدُّعَاءِ لَكَ،"
  },
  {
   "segment_id": 47,
   "arabic": "فَنُصْبحَ مِنْ كَيْدِهِ فِي الْمَعْصُومِينَ بِكَ."
  },
  {
   "segment_id": 48,
   "arabic": "أَللَّهُمَّ أَعْطِنِي كُلَّ سُؤْلِي،"
  },
  {
   "segment_id": 49,
   "arabic": "وَاقْضِ لِي حَوَائِجِي،"
  },
  {
   "segment_id": 50,
   "arabic": "وَلاَ تَمْنَعْنِي الإجَابَةَ وَقَدْ ضَمِنْتَهَا لِي،"
  },
  {
   "segment_id": 51,
   "arabic": "وَلا تَحْجُبْ دُعَائِي عَنْكَ وَقَدْ أَمَرْتَنِي بِهِ،"
  },
  {
   "segment_id": 52,
   "arabic": "وَامْنُنْ عَلَيَّ بِكُلِّ مَا يُصْلِحُنِيْ"
  },
  {
   "segment_id": 53,
   "arabic": "فِيْ دُنْيَايَ وَآخِرَتِي"
  },
  {
   "segment_id": 54,
   "arabic": "مَا ذَكَرْتُ مِنْهُ وَمَـا نَسِيتُ،"
  },
  {
   "segment_id": 55,
   "arabic": "أَوْ أَظْهَـرتُ أَوْ أَخْفَيْتُ،"
  },
  {
   "segment_id": 56,
   "arabic": "أَوْ أَعْلَنْتُ أَوْ أَسْرَرْتُ،"
  },
  {
   "segment_id": 57,
   "arabic": "وَاجْعَلْنِي فِي جَمِيعِ ذلِكَ مِنَ الْمُصْلِحِينَ بِسُؤَالِي إيَّـاكَ،"
  },
  {
   "segment_id": 58,
   "arabic": "الْمُنْجِحِينَ بِالـطَّلَبِ إلَيْـكَ،"
  },
  {
   "segment_id": 59,
   "arabic": "غَيْـرِ الْمَمْنُوعِينَ بِالتَّوَكُّلِ عَلَيْكَ،"
  },
  {
   "segment_id": 60,
   "arabic": "الْمُعَوَّدِينَ بِالتَّعَوُّذِ بِكَ،"
  },
  {
   "segment_id": 61,
   "arabic": "الرَّابِحِينَ فِي التِّجَارَةِ عَلَيْـكَ،"
  },
  {
   "segment_id": 62,
   "arabic": "الْمُجَارِيْنَ بِعِـزِّكَ،"
  },
  {
   "segment_id": 63,
   "arabic": "الْمُـوَسَّـعِ عَلَيْهِمُ الـرِّزْقُ الْحَـلاَلُ"
  },
  {
   "segment_id": 64,
   "arabic": "مِنْ فَضْلِكَ الْوَاسِعِ بِجُودِكَ وَكَرَمِكَ،"
  },
  {
   "segment_id": 65,
   "arabic": "الْمُعَزِّينَ مِنَ الذُّلِّ بِكَ،"
  },
  {
   "segment_id": 66,
   "arabic": "وَالْمُجَارِينَ مِن الظُّلْمِ بِعَدْلِكَ،"
  },
  {
   "segment_id": 67,
   "arabic": "وَالْمُعَافَيْنَ مِنَ الْبَلاءِ بِرَحْمَتِكَ،"
  },
  {
   "segment_id": 68,
   "arabic": "وَالْمُغْنَيْنَ مِنَ الْفَقْرِ بِغِنَاكَ،"
  },
  {
   "segment_id": 69,
   "arabic": "وَالْمَعْصومِينَ مِنَ الذُّنُوبِ وَالزَّلَلِ وَالْخَطَأِ بِتَقْوَاكَ،"
  },
  {
   "segment_id": 70,
   "arabic": "وَالْمُوَفَّقِينَ لِلْخَيْرِ وَالرُّشْدِ وَالصَّوَابِ بِطَاعَتِكَ،"
  },
  {
   "segment_id": 71,
   "arabic": "وَالْمُحَالِ بَيْنَهُمْ وَبَيْنَ الذُّنُوبِ بِقُدْرَتِكَ،"
  },
  {
   "segment_id": 72,
   "arabic": "التَّـارِكِينَ لِكُلِّ مَعْصِيَتِكَ،"
  },
  {
   "segment_id": 73,
   "arabic": "السَّاكِنِينَ فِي جِوَارِكَ."
  },
  {
   "segment_id": 74,
   "arabic": "أَللَّهُمَّ أَعْطِنَا جَمِيعَ ذلِكَ بِتَوْفِيقِكَ وَرَحْمَتِكَ"
  },
  {
   "segment_id": 75,
   "arabic": "وَأَعِذْنَا مِنْ عَذَابِ السَّعِيرِ،"
  },
  {
   "segment_id": 76,
   "arabic": "وَأَعْطِ جَمِيعَ الْمُسْلِمِينَ وَالْمُسْلِمَـاتِ"
  },
  {
   "segment_id": 77,
   "arabic": "وَالْمُؤْمِنِيْنَ وَالْمُؤْمِنَاتِ مِثْلَ الَّذِي سَأَلْتُكَ لِنَفْسِي"
  },
  {
   "segment_id": 78,
   "arabic": "وَلِوُلْدِي فِي عَاجِلِ الدُّنْيَا وَآجِلِ الآخِرَةِ،"
  },
  {
   "segment_id": 79,
   "arabic": "إنَّكَ قَرِيبٌ مُجِيبٌ سَمِيعٌ عَلِيمٌ"
  },
  {
   "segment_id": 80,
   "arabic": "عَفُوٌّ غَفُـورٌ رَؤُوفٌ رَحِيمٌ."
  },
  {
   "segment_id": 81,
   "arabic": "وَآتِنَا فِي الدُّنْيَا حَسَنَةً"
  },
  {
   "segment_id": 82,
   "arabic": "وَفِي الآخِرَةِ حَسَنَةً وَقِنَا عَذَابَ النَّارِ."
  }
 ]
}