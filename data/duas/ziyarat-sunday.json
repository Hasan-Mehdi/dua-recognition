{
 "dua_id": "ziyarat-sunday",
 "dua_name_en": "Ziyarat al-Ahad",
 "dua_name_ar": "زیارة الأحَد",
 "source": "https://www.duaplayer.org/en/ziyarat/sunday",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمٰنِ ٱلرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَلسَّلاَمُ عَلَىٰ ٱلشَّجَرَةِ ٱلنَّبَوِيَّةِ"
  },
  {
   "segment_id": 3,
   "arabic": "وَٱلدَّوْحَةِ ٱلْهَاشِمِيَّةِ ٱلْمُضيئَةِ"
  },
  {
   "segment_id": 4,
   "arabic": "ٱلْمُثْمِرَةِ بِٱلنَّبُوَّةِ"
  },
  {
   "segment_id": 5,
   "arabic": "ٱلْمُونِقَةِ بِٱلإِمَامَةِ"
  },
  {
   "segment_id": 6,
   "arabic": "وَعَلىٰ ضَجِيعَيْكَ آدَمَ وَنُوحٍ"
  },
  {
   "segment_id": 7,
   "arabic": "عَلَيْهِمَا ٱلسَّلاَمُ"
  },
  {
   "segment_id": 8,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ وَعَلَىٰ اهْلِ بَيْتِكَ"
  },
  {
   "segment_id": 9,
   "arabic": "ٱلطَّيِّبِينَ ٱلطَّاهِرِينَ"
  },
  {
   "segment_id": 10,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ وَعَلَىٰ ٱلْمَلاَئِكَةِ ٱلْمُحْدِقِينَ بِكَ"
  },
  {
   "segment_id": 11,
   "arabic": "وَٱلْحَافِّينَ بِقَبْرِكَ"
  },
  {
   "segment_id": 12,
   "arabic": "يَا مَوْلاَيَ يَا امِيرَ ٱلْمُوْمِنينَ"
  },
  {
   "segment_id": 13,
   "arabic": "هٰذَا يَوْمُ ٱلاحَدِ"
  },
  {
   "segment_id": 14,
   "arabic": "وَهُوَ يَوْمُكَ وَبِٱسْمِكَ"
  },
  {
   "segment_id": 15,
   "arabic": "وَانَا ضَيْفُكَ فِيهِ وَجَارُكَ"
  },
  {
   "segment_id": 16,
   "arabic": "فَاضِفْنِي يَا مَوْلاَيَ وَ اجِرْنِي"
  },
  {
   "segment_id": 17,
   "arabic": "فَإنَّكَ كَرِيمٌ تُحِبُّ ٱلضِّيَافَةَ"
  },
  {
   "segment_id": 18,
   "arabic": "وَمَاْمُورٌ بِٱلإجَارَةِ"
  },
  {
   "segment_id": 19,
   "arabic": "فَٱفْعَلْ مَا رَغِبْتُ إِلَيْكَ فِيهِ"
  },
  {
   "segment_id": 20,
   "arabic": "وَرَجَوْتُهُ مِنْكَ"
  },
  {
   "segment_id": 21,
   "arabic": "بِمَنْزِلَتِكَ وَآلِ بَيْتِكَ عِنْدَ ٱللَّهِ"
  },
  {
   "segment_id": 22,
   "arabic": "وَمَنْزِلَتِهِ عِنْدَكُمْ"
  },
  {
   "segment_id": 23,
   "arabic": "وَبِحَقِّ ٱبْنِ عَمِّكَ رَسُولِ ٱللَّهِ"
  },
  {
   "segment_id": 24,
   "arabic": "صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ وَسَلَّمَ"
  },
  {
   "segment_id": 25,
   "arabic": "وَعَلَيْهِمْ اجْمَعينَ"
  },
  {
   "segment_id": 26,
   "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمٰنِ ٱلرَّحِيمِ"
  },
  {
   "segment_id": 27,
   "arabic": "اَلسَّلاَمُ عَلَيْكِ يَا مُمْتَحَنَةُ"
  },
  {
   "segment_id": 28,
   "arabic": "اِمْتَحَنَكِ ٱلَّذِي خَلَقَكِ"
  },
  {
   "segment_id": 29,
   "arabic": "فَوَجَدَكِ لِمَا ٱمْتَحَنَكِ صَابِرَةً"
  },
  {
   "segment_id": 30,
   "arabic": "انَا لَكِ مُصَدِّقٌ"
  },
  {
   "segment_id": 31,
   "arabic": "صَابِرٌ عَلَىٰ مَا اتَىٰ بِهِ ابُوكِ وَوَصِيُّهُ"
  },
  {
   "segment_id": 32,
   "arabic": "صَلَوَاتُ ٱللَّهِ عَلَيْهِمَا"
  },
  {
   "segment_id": 33,
   "arabic": "وَانَا اسْالُكِ إِنْ كُنْتُ صَدَّقْتُكِ"
  },
  {
   "segment_id": 34,
   "arabic": "إِلاَّ الْحَقْتِنِي بِتَصْدِيقِي لَهُمَا"
  },
  {
   "segment_id": 35,
   "arabic": "لِتُسَرَّ نَفْسِي"
  },
  {
   "segment_id": 36,
   "arabic": "فَٱشْهَدِي انِّي ظَاهِرٌ بِوَلاَيَتِكِ"
  },
  {
   "segment_id": 37,
   "arabic": "وَوَلاَيَةِ آلِ بَيْتِكِ"
  },
  {
   "segment_id": 38,
   "arabic": "صَلَوَاتُ ٱللَّهِ عَلَيْهِمْ اجْمَعينَ"
  }
 ]
}