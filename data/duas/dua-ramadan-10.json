{
 "dua_id": "dua-ramadan-10",
 "dua_name_en": "Day 10",
 "dua_name_ar": " شهر رمضان ١٠  ",
 "source": "https://www.duaplayer.org/en/dua/ramadan-10",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "اللّهُمّ اجْعَلْنِي فِيهِ مِنَ المُتَوَكّلِينَ عَلَيْكَ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَاجْعَلْنِي فِيهِ مِنَ الفَائِزِينَ لَدَيْكَ،"
  },
  {
   "segment_id": 5,
   "arabic": "وَاجْعَلْنِي فِيهِ مِنَ المُقَرّبِينَ إِلَيْكَ،"
  },
  {
   "segment_id": 6,
   "arabic": "بِإِحْسَانِكَ يَا غَايَةَ الطَّالِبِينَ."
  }
 ]
}