{
 "dua_id": "duasorg-imam-mohammed-baqir-as-2",
 "dua_name_en": "Another Ziyarat",
 "dua_name_ar": "",
 "source": "https://www.duas.org/imam-mohammed-baqir-as.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "السَّلامُ عَلَيْكَ يَا إِمَامَ الْهُدَىٰ"
  },
  {
   "segment_id": 2,
   "arabic": "السَّلامُ عَلَيْكَ يَا بَدْرَ الدُّجَىٰ"
  },
  {
   "segment_id": 3,
   "arabic": "السَّلامُ عَلَيْكَ يَا كَهْفَ التُّقَىٰ"
  },
  {
   "segment_id": 4,
   "arabic": "السَّلامُ عَلَيْكَ يَا قَائِدَ أَهْلِ التَّقْوَىٰ"
  },
  {
   "segment_id": 5,
   "arabic": "السَّلامُ عَلَيْكَ يَا بَاقِرَ عِلْمِ النَّبِيِّينَ"
  },
  {
   "segment_id": 6,
   "arabic": "السَّلامُ عَلَيْكَ يَا زَيْنَ السَّمَاوَاتِ وَالْأَرْضِينَ،"
  },
  {
   "segment_id": 7,
   "arabic": "اللَّهُمَّ كَمَا جَعَلْتَهُ عَلَمًا"
  },
  {
   "segment_id": 8,
   "arabic": "لِعِبَادِكَ وَمُسْتَوْدَعًا لِحِلْمِكَ وَمُتَرْجِمًا"
  },
  {
   "segment_id": 9,
   "arabic": "لِوَحْيِكَ فَصَلِّ عَلَيْهِ أَفْضَلَ مَا صَلَّيْتَ"
  },
  {
   "segment_id": 10,
   "arabic": "عَلَىٰ أَحَدٍ مِنْ ذُرِّيَّةِ أَنْبِيَائِكَ وَأَصْفِيَائِكَ"
  },
  {
   "segment_id": 11,
   "arabic": "وَرُسُلِكَ وَأُمَنَائِكَ يَا رَبَّ الْعَالَمِينَ"
  }
 ]
}