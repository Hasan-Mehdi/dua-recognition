{
 "dua_id": "duasorg-ziyarat-of-holy-prophet-on-17-rabbi-al-awwal-1",
 "dua_name_en": "Ziyarat of Holy Prophet (sawa) on 17th Rabbi al Awwal",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ziyarat-of-holy-prophet-on-17-rabbi-al-awwal.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اشْهَدُ انْ لاَ إِلٰهَ إِلاَّ ٱللَّهُ وَحْدَهُ لاَ شَرِيكَ لَهُ"
  },
  {
   "segment_id": 2,
   "arabic": "وَاشْهَدُ انَّ مُحَمَّداً عَبْدُهُ وَرَسُولُهُ"
  },
  {
   "segment_id": 3,
   "arabic": "وَانَّهُ سَيِّدُ ٱلاوَّلِينَ وَٱلآخِرِينَ"
  },
  {
   "segment_id": 4,
   "arabic": "وَانَّهُ سَيِّدُ ٱلانْبِيَاءِ وَٱلْمُرْسَلِينَ"
  },
  {
   "segment_id": 5,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَيْهِ وَعَلَىٰ اهْلِ بَيْتِهِ ٱلائِمَةِ ٱلطَّيِّبِينَ"
  },
  {
   "segment_id": 6,
   "arabic": "السَّلاَمُ عَلَيْكَ يَا رَسُولَ ٱللَّهِ"
  },
  {
   "segment_id": 7,
   "arabic": "السَّلاَمُ عَلَيْكَ يَا خَلِيلَ ٱللَّهِ"
  },
  {
   "segment_id": 8,
   "arabic": "السَّلاَمُ عَلَيْكَ يَا نَبِيَّ ٱللَّهِ"
  },
  {
   "segment_id": 9,
   "arabic": "السَّلاَمُ عَلَيْكَ يَا صَفِيَّ ٱللَّهِ"
  },
  {
   "segment_id": 10,
   "arabic": "السَّلاَمُ عَلَيْكَ يَا رَحْمَةَ ٱللَّهِ"
  },
  {
   "segment_id": 11,
   "arabic": "السَّلاَمُ عَلَيْكَ يَا خِيَرَةَ ٱللَّهِ"
  },
  {
   "segment_id": 12,
   "arabic": "السَّلاَمُ عَلَيْكَ يَا حَبِيبَ ٱللَّهِ"
  },
  {
   "segment_id": 13,
   "arabic": "السَّلاَمُ عَلَيْكَ يَا نَجِيبَ ٱللَّهِ"
  },
  {
   "segment_id": 14,
   "arabic": "السَّلاَمُ عَلَيْكَ يَا خَاتَمَ ٱلنَّبِيِّينَ"
  },
  {
   "segment_id": 15,
   "arabic": "السَّلاَمُ عَلَيْكَ يَا سَيِّدَ ٱلْمُرْسَلِينَ"
  },
  {
   "segment_id": 16,
   "arabic": "السَّلاَمُ عَلَيْكَ يَا قَائِماً بِٱلْقِسْطِ"
  },
  {
   "segment_id": 17,
   "arabic": "السَّلاَمُ عَلَيْكَ يَا فَاتِحَ ٱلْخَيْرِ"
  },
  {
   "segment_id": 18,
   "arabic": "السَّلاَمُ عَلَيْكَ يَا مَعْدِنَ ٱلوَحْيِ وَٱلتَّنْزِيلِ"
  },
  {
   "segment_id": 19,
   "arabic": "السَّلاَمُ عَلَيْكَ يَا مُبَلِّغاً عَنِ ٱللَّهِ"
  },
  {
   "segment_id": 20,
   "arabic": "السَّلاَمُ عَلَيْكَ ايُّهَا ٱلسِّرَاجُ ٱلْمُنِيرُ"
  },
  {
   "segment_id": 21,
   "arabic": "السَّلاَمُ عَلَيْكَ يَا مُبَشِّرُ"
  },
  {
   "segment_id": 22,
   "arabic": "السَّلاَمُ عَلَيْكَ يَا نَذِيرُ"
  },
  {
   "segment_id": 23,
   "arabic": "السَّلاَمُ عَلَيْكَ يَا مُنْذِرُ"
  },
  {
   "segment_id": 24,
   "arabic": "السَّلاَمُ عَلَيْكَ يَا نُورَ ٱللَّهِ ٱلَّذِي يُسْتَضَاءُ بِهِ"
  },
  {
   "segment_id": 25,
   "arabic": "السَّلاَمُ عَلَيْكَ وَعَلَىٰ اهْلِ بَيْتِكَ ٱلطَّيِّبِينَ ٱلطَّاهِرِينَ"
  },
  {
   "segment_id": 26,
   "arabic": "ٱلْهَادِينَ ٱلْمَهْدِيِّينَ"
  },
  {
   "segment_id": 27,
   "arabic": "السَّلاَمُ عَلَيْكَ وَعَلَىٰ جَدِّكَ عَبْدِ ٱلْمُطَّلِبِ"
  },
  {
   "segment_id": 28,
   "arabic": "وَعَلَىٰ ابِيكَ عَبْدِ ٱللَّهِ"
  },
  {
   "segment_id": 29,
   "arabic": "السَّلاَمُ عَلَىٰ امِّكَ آمِنَةَ بِنْتِ وَهَبٍ"
  },
  {
   "segment_id": 30,
   "arabic": "السَّلاَمُ عَلَىٰ عَمِّكَ حَمْزَةَ سَيِّدِ ٱلشُّهَدَاءِ"
  },
  {
   "segment_id": 31,
   "arabic": "السَّلاَمُ عَلَىٰ عَمِّكَ ٱلعَبَّاسِ بْنِ عَبْدِ ٱلْمُطَّلِبِ"
  },
  {
   "segment_id": 32,
   "arabic": "السَّلاَمُ عَلَىٰ عَمِّكَ وَكَفِيلِكَ ابِي طَالِبٍ"
  },
  {
   "segment_id": 33,
   "arabic": "السَّلاَمُ عَلَىٰ ٱبْنِ عَمِّكَ جَعْفَرٍ ٱلطَّيَّارِ فِي جِنَانِ ٱلْخُلْدِ"
  },
  {
   "segment_id": 34,
   "arabic": "السَّلاَمُ عَلَيْكَ يَا مُحَمَّدُ"
  },
  {
   "segment_id": 35,
   "arabic": "السَّلاَمُ عَلَيْكَ يَا احْمَدُ"
  },
  {
   "segment_id": 36,
   "arabic": "السَّلاَمُ عَلَيْكَ يَا حُجَّةَ اللَّهِ عَلَىٰ ٱلاوَّلِينَ وَٱلآخِرِينَ"
  },
  {
   "segment_id": 37,
   "arabic": "وَٱلسَّابِقَ إِلَىٰ طَاعَةِ رَبِّ ٱلعَالَمِينَ"
  },
  {
   "segment_id": 38,
   "arabic": "وَٱلْمُهَيْمِنَ عَلَىٰ رُسُلِهِ"
  },
  {
   "segment_id": 39,
   "arabic": "وَٱلْخَاتِمَ لاِنْبِيَائِهِ"
  },
  {
   "segment_id": 40,
   "arabic": "وَٱلشَّاهِدَ عَلَىٰ خَلْقِهِ"
  },
  {
   "segment_id": 41,
   "arabic": "وَٱلشَّفِيعَ إِلَيْهِ"
  },
  {
   "segment_id": 42,
   "arabic": "وَٱلْمَكِينَ لَدَيْهِ"
  },
  {
   "segment_id": 43,
   "arabic": "وَٱلْمُطَاعَ فِي مَلَكُوتِهِ"
  },
  {
   "segment_id": 44,
   "arabic": "ٱلاحْمَدَ مِنَ ٱلاوْصَافِ"
  },
  {
   "segment_id": 45,
   "arabic": "ٱلمُحَمَّدَ لِسَائِرِ ٱلاشْرَافِ"
  },
  {
   "segment_id": 46,
   "arabic": "ٱلكَرِيمَ عِنْدَ ٱلرَّبِّ"
  },
  {
   "segment_id": 47,
   "arabic": "وَٱلْمُكَلَّمَ مِنْ وَرَاءِ ٱلْحُجُبِ"
  },
  {
   "segment_id": 48,
   "arabic": "ٱلفَائِزَ بِٱلسِّبَاقِ"
  },
  {
   "segment_id": 49,
   "arabic": "وَٱلفَائِتَ عَنِ ٱللِّحَاقِ"
  },
  {
   "segment_id": 50,
   "arabic": "تَسْلِيمَ عَارِفٍ بِحَقِّكَ"
  },
  {
   "segment_id": 51,
   "arabic": "مُعْتَرِفٍ بِٱلتَّقْصِيرِ فِي قِيَامِهِ بِوَاجِبِكَ"
  },
  {
   "segment_id": 52,
   "arabic": "غَيْرِ مُنْكِرٍ مَا ٱنْتَهَىٰ إِلَيْهِ مِنْ فَضْلِكَ"
  },
  {
   "segment_id": 53,
   "arabic": "مُوْقِنٍ بِٱلْمَزِيدَاتِ مِنْ رَبِّكَ"
  },
  {
   "segment_id": 54,
   "arabic": "مُؤْمِنٍ بِٱلكِتَابِ ٱلْمُنْزَلِ عَلَيْكَ"
  },
  {
   "segment_id": 55,
   "arabic": "مُحَلِّلٍ حَلالَكَ"
  },
  {
   "segment_id": 56,
   "arabic": "مُحَرِّمٍ حَرَامَكَ"
  },
  {
   "segment_id": 57,
   "arabic": "اشْهَدُ يَا رَسُولَ ٱللَّهِ مَعَ كُلِّ شَاهِدٍ"
  },
  {
   "segment_id": 58,
   "arabic": "وَاتَحَمَّلُهَا عَنْ كُلِّ جَاحِدٍ"
  },
  {
   "segment_id": 59,
   "arabic": "انَّكَ قَدْ بَلَّغْتَ رِسَالاَتِ رَبِّكَ"
  },
  {
   "segment_id": 60,
   "arabic": "وَنَصَحْتَ لاِمَّتِكَ"
  },
  {
   "segment_id": 61,
   "arabic": "وَجَاهَدْتَ فِي سَبِيلِ رَبِّكَ"
  },
  {
   "segment_id": 62,
   "arabic": "وَصَدَعْتَ بِامْرِهِ"
  },
  {
   "segment_id": 63,
   "arabic": "وَٱحْتَمَلْتَ ٱلاذَىٰ فِي جَنْبِهِ"
  },
  {
   "segment_id": 64,
   "arabic": "وَدَعَوْتَ إِلَىٰ سَبِيلِهِ بِٱلْحِكْمَةِ وَٱلْمَوْعِظَةِ ٱلْحَسَنَةِ ٱلْجَمِيلَةِ"
  },
  {
   "segment_id": 65,
   "arabic": "وَادَّيْتَ ٱلحَقَّ ٱلَّذِي كَانَ عَلَيْكَ"
  },
  {
   "segment_id": 66,
   "arabic": "وَانَّكَ قَدْ رَؤُفْتَ بِٱلْمُؤْمِنِينَ"
  },
  {
   "segment_id": 67,
   "arabic": "وَغَلُظْتَ عَلَىٰ ٱلكَافِرِينَ"
  },
  {
   "segment_id": 68,
   "arabic": "وَعَبَدْتَ ٱللَّهَ مُخْلِصاً حَتَّىٰ اتَاكَ ٱليَقِينُ"
  },
  {
   "segment_id": 69,
   "arabic": "فَبَلَغَ ٱللَّهُ بِكَ اشْرَفَ مَحَلِّ ٱلْمُكَرَّمِينَ"
  },
  {
   "segment_id": 70,
   "arabic": "وَاعْلَىٰ مَنَازِلِ ٱلْمُقَرَّبِينَ"
  },
  {
   "segment_id": 71,
   "arabic": "وَارْفَعَ دَرَجَاتِ ٱلْمُرْسَلِينَ حَيْثُ لاَ يَلْحَقُكَ لاَحِقٌ"
  },
  {
   "segment_id": 72,
   "arabic": "وَلاَ يفُوقُكَ فَائِقٌ"
  },
  {
   "segment_id": 73,
   "arabic": "وَلاَ يَسْبِقُكَ سَابِقٌ"
  },
  {
   "segment_id": 74,
   "arabic": "وَلاَ يَطْمَعُ فِي إِدْرَاكِكَ طَامِعٌ"
  },
  {
   "segment_id": 75,
   "arabic": "الْحَمْدُ لِلَّهِ ٱلَّذِي ٱسْتَنْقَذَنَا بِكَ مِنَ ٱلْهَلَكَةِ"
  },
  {
   "segment_id": 76,
   "arabic": "وَهَدَانَا بِكَ مِنَ ٱلضَّلالَةِ"
  },
  {
   "segment_id": 77,
   "arabic": "وَنَوَّرَنَا بِكَ مِنَ ٱلظُّلْمَةِ"
  },
  {
   "segment_id": 78,
   "arabic": "فَجَزَاكَ ٱللَّهُ يَا رَسُولَ ٱللَّهِ مِنْ مَبْعُوثٍ افْضَلَ مَا جَازَىٰ  نَبِيّاً عَنْ امَّتِهِ"
  },
  {
   "segment_id": 79,
   "arabic": "وَرَسُولاً عَمَّنْ ارْسِلَ إِلَيْهِ"
  },
  {
   "segment_id": 80,
   "arabic": "بِابِي انْتَ وَامِّي يَا رَسُولَ ٱللَّهِ زُرْتُكَ عَارِفاً بِحَقِّكَ"
  },
  {
   "segment_id": 81,
   "arabic": "مُقِرّاً بِفَضْلِكَ"
  },
  {
   "segment_id": 82,
   "arabic": "مُسْتَبْصِراً بِضَلالَةِ مَنْ خَالَفَكَ وَخَالَفَ اهْلَ بَيْتِكَ"
  },
  {
   "segment_id": 83,
   "arabic": "عَارِفاً بِٱلْهُدَىٰ ٱلَّذِي انْتَ عَلَيْهِ"
  },
  {
   "segment_id": 84,
   "arabic": "بِابِي انْتَ وَامِّي وَنَفْسِي وَاهْلِي وَمَالِي وَوَلَدِي"
  },
  {
   "segment_id": 85,
   "arabic": "انَا اصَلِّي عَلَيْكَ كَمَا صَلَّىٰ ٱللَّهُ عَلَيْكَ"
  },
  {
   "segment_id": 86,
   "arabic": "وَصَلَّىٰ عَلَيْكَ مَلائِكَتُهُ وَانْبِيَاؤُهُ وَرُسُلُهُ"
  },
  {
   "segment_id": 87,
   "arabic": "صَلاةً مُتَتَابِعَةً وَافِرَةً مُتَوَاصِلَةً"
  },
  {
   "segment_id": 88,
   "arabic": "لاَ ٱنْقِطَاعَ لَهَا وَلاَ امَدَ وَلاَ اجَلَ"
  },
  {
   "segment_id": 89,
   "arabic": "صَلَّىٰ ٱللَّهُ عَلَيْكَ وَعَلَىٰ اهْلِ بَيْتِكَ ٱلطَّيِّبِينَ ٱلطَّاهِرِينَ كَمَا انْتُمْ اهْلُهُ"
  },
  {
   "segment_id": 90,
   "arabic": "اَللَّهُمَّ ٱجْعَلْ جَوَامِعَ صَلَوَاتِكَ"
  },
  {
   "segment_id": 91,
   "arabic": "وَنَوَامِيَ بَرَكَاتِكَ"
  },
  {
   "segment_id": 92,
   "arabic": "وَفَوَاضِلَ خَيْرَاتِكَ"
  },
  {
   "segment_id": 93,
   "arabic": "وَشَرَائِفَ تَحِيَّاتِكَ وَتَسْلِيمَاتِكَ"
  },
  {
   "segment_id": 94,
   "arabic": "وَكَرَامَاتِكَ وَرَحَمَاتِكَ"
  },
  {
   "segment_id": 95,
   "arabic": "وَصَلَوَاتِ مَلائِكَتِكَ ٱلْمُقَرَّبِينَ"
  },
  {
   "segment_id": 96,
   "arabic": "وَانْبِيَائِكَ ٱلْمُرْسَلِينَ"
  },
  {
   "segment_id": 97,
   "arabic": "وَائِمَّتِكَ ٱلْمُنْتَجَبِينَ"
  },
  {
   "segment_id": 98,
   "arabic": "وَعِبَادِكَ ٱلصَّالِحِينَ"
  },
  {
   "segment_id": 99,
   "arabic": "وَاهْلِ ٱلسَّمَاوَاتِ وَٱلارَضِينَ"
  },
  {
   "segment_id": 100,
   "arabic": "وَمَنْ سَبَّحَ لَكَ يَا رَبَّ ٱلعَالَمِينَ"
  },
  {
   "segment_id": 101,
   "arabic": "مِنَ ٱلاوَّلِينَ وَٱلآخِرِينَ"
  },
  {
   "segment_id": 102,
   "arabic": "عَلَىٰ مُحَمَّدٍ عَبْدِكَ وَرَسُولِكَ"
  },
  {
   "segment_id": 103,
   "arabic": "وَشَاهِدِكَ وَنَبِيِّكَ"
  },
  {
   "segment_id": 104,
   "arabic": "وَنَذِيرِكَ وَامِينِكَ"
  },
  {
   "segment_id": 105,
   "arabic": "وَمَكِينِكَ وَنَجِيِّكَ"
  },
  {
   "segment_id": 106,
   "arabic": "وَنَجِيبِكَ وَحَبِيبِكَ"
  },
  {
   "segment_id": 107,
   "arabic": "وَخَلِيلِكَ وَصَفِيِّكَ"
  },
  {
   "segment_id": 108,
   "arabic": "وَصَفْوَتِكَ وَخَاصَّتِكَ"
  },
  {
   "segment_id": 109,
   "arabic": "وَخَالِصَتِكَ وَرَحْمَتِكَ"
  },
  {
   "segment_id": 110,
   "arabic": "وَخَيْرِ خِيَرَتِكَ مِنْ خَلْقِكَ"
  },
  {
   "segment_id": 111,
   "arabic": "نَبِيِّ ٱلرَّحْمَةِ"
  },
  {
   "segment_id": 112,
   "arabic": "وَخَازِنِ ٱلْمَغْفِرَةِ"
  },
  {
   "segment_id": 113,
   "arabic": "وَقَائِدِ ٱلْخَيْرِ وَٱلبَرَكَةِ"
  },
  {
   "segment_id": 114,
   "arabic": "وَمُنْقِذِ ٱلْعِبَادِ مِنَ ٱلْهَلَكَةِ بِإِذْنِكَ"
  },
  {
   "segment_id": 115,
   "arabic": "وَدَاعِيهِمْ إِلَىٰ دِينِكَ"
  },
  {
   "segment_id": 116,
   "arabic": "الْقَيِّمِ بِامْرِكَ"
  },
  {
   "segment_id": 117,
   "arabic": "اوَّلِ ٱلنَّبِيِّينَ مِيثَاقاً"
  },
  {
   "segment_id": 118,
   "arabic": "وَآخِرِهِمْ مَبْعَثاً"
  },
  {
   "segment_id": 119,
   "arabic": "ٱلَّذِي غَمَسْتَهُ فِي بَحْرِ ٱلفَضِيلَةِ"
  },
  {
   "segment_id": 120,
   "arabic": "وَٱلْمَنْزِلَةِ ٱلْجَلِيلَةِ"
  },
  {
   "segment_id": 121,
   "arabic": "وَٱلدَّرَجَةِ ٱلرَّفِيعَةِ"
  },
  {
   "segment_id": 122,
   "arabic": "وَٱلْمَرْتَبَةِ ٱلْخَطِيرَةِ"
  },
  {
   "segment_id": 123,
   "arabic": "وَاوْدَعْتَهُ ٱلاصْلاَبَ ٱلطَّاهِرَةَ"
  },
  {
   "segment_id": 124,
   "arabic": "وَنَقَلْتَهُ مِنْهَا إِلَىٰ ٱلارْحَامِ ٱلْمُطَهَّرَةِ"
  },
  {
   "segment_id": 125,
   "arabic": "لُطْفاً مِنْكَ لَهُ"
  },
  {
   "segment_id": 126,
   "arabic": "وَتَحَنُّناً مِنْكَ عَلَيْهِ"
  },
  {
   "segment_id": 127,
   "arabic": "إِذْ وَكَّلْتَ لِصَوْنِهِ وَحِرَاسَتِهِ"
  },
  {
   "segment_id": 128,
   "arabic": "وَحِفْظِهِ وَحِيَاطَتِهِ"
  },
  {
   "segment_id": 129,
   "arabic": "مِنْ قُدْرَتِكَ عَيْناً عَاصِمَةً"
  },
  {
   "segment_id": 130,
   "arabic": "حَجَبْتَ بِهَا عَنْهُ مَدَانِسَ ٱلعَهْرِ"
  },
  {
   "segment_id": 131,
   "arabic": "وَمَعَائِبَ ٱلسِّفَاحِ"
  },
  {
   "segment_id": 132,
   "arabic": "حَتَّىٰ رَفَعْتَ بِهِ نَوَاظِرَ ٱلعِبَادِ"
  },
  {
   "segment_id": 133,
   "arabic": "وَاحْيَيْتَ بِهِ مَيْتَ ٱلبِلادِ"
  },
  {
   "segment_id": 134,
   "arabic": "بِانْ كَشَفْتَ عَنْ نُورِ وِلادَتِهِ ظُلَمَ ٱلاسْتَارِ"
  },
  {
   "segment_id": 135,
   "arabic": "وَالْبَسْتَ حَرَمَكَ بِهِ حُلَلَ ٱلانْوَارِ"
  },
  {
   "segment_id": 136,
   "arabic": "اَللَّهُمَّ فَكَمَا خَصَصْتَهُ بِشرَفِ هٰذِهِ ٱلْمَرْتَبَةِ ٱلكَرِيمَةِ"
  },
  {
   "segment_id": 137,
   "arabic": "وَذُخْرِ هٰذِهِ ٱلْمَنْقَبَةِ ٱلعَظِيمَةِ"
  },
  {
   "segment_id": 138,
   "arabic": "صَلِّ عَلَيْهِ كَمَا وَفَىٰ بِعَهْدِكَ"
  },
  {
   "segment_id": 139,
   "arabic": "وَبَلَّغَ رِسَالاَتِكَ"
  },
  {
   "segment_id": 140,
   "arabic": "وَقَاتَلَ اهْلَ ٱلْجُحُودِ عَلَىٰ تَوْحِيدِكَ"
  },
  {
   "segment_id": 141,
   "arabic": "وَقَطَعَ رَحِمَ ٱلكُفْرِ فِي إِعْزَازِ دِينِكَ"
  },
  {
   "segment_id": 142,
   "arabic": "وَلَبِسَ ثَوْبَ ٱلبَلْوَىٰ فِي مُجَاهَدَةِ اعْدَائِكَ"
  },
  {
   "segment_id": 143,
   "arabic": "وَاوْجَبْتَ لَهُ بِكُلِّ اذَىٰ مَسَّهُ"
  },
  {
   "segment_id": 144,
   "arabic": "اوْ كَيْدٍ احَسَّ بِهِ"
  },
  {
   "segment_id": 145,
   "arabic": "مِنَ ٱلفِئَةِ ٱلَّتِي حَاوَلَتْ قَتْلَهُ"
  },
  {
   "segment_id": 146,
   "arabic": "فَضِيلَةً تَفُوقُ ٱلفَضَائِلَ"
  },
  {
   "segment_id": 147,
   "arabic": "وَيَمْلِكُ بِهَا ٱلْجَزِيلَ مِنْ نَوَالِكَ"
  },
  {
   "segment_id": 148,
   "arabic": "وَقَدْ اسَرَّ ٱلْحَسْرَةَ"
  },
  {
   "segment_id": 149,
   "arabic": "وَاخْفَىٰ ٱلزَّفْرَةَ"
  },
  {
   "segment_id": 150,
   "arabic": "وَتَجَرَّعَ ٱلغُصَّةَ"
  },
  {
   "segment_id": 151,
   "arabic": "وَلَمْ يَتَخَطَّ مَا مَثَّلَ لَهُ وَحْيُكَ"
  },
  {
   "segment_id": 152,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَيْهِ وَعَلَىٰ اهْلِ بَيْتِهِ صَلاةً تَرْضَاهَا لَهُمْ"
  },
  {
   "segment_id": 153,
   "arabic": "وَبَلِّغْهُمْ مِنَّا تَحِيَّةً كَثِيرَةً وَسَلاَماً"
  },
  {
   "segment_id": 154,
   "arabic": "وَآتِنَا مِنْ لَدُنْكَ فِي مُوَالاَتِهِمْ فَضْلاً وَإِحْسَاناً"
  },
  {
   "segment_id": 155,
   "arabic": "وَرَحْمَةً وَغُفْرَاناً"
  },
  {
   "segment_id": 156,
   "arabic": "إِنَّكَ ذُو ٱلفَضْلِ ٱلعَظِيمِ"
  },
  {
   "segment_id": 157,
   "arabic": "اَللَّهُمَّ إِنَّكَ قُلْتَ لِنَبِيِّكَ مُحَمَّدٍ"
  },
  {
   "segment_id": 158,
   "arabic": "صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ:"
  },
  {
   "segment_id": 159,
   "arabic": "«وَلَوْ انَّهُمْ إِذْ ظَلَمُوٱ انْفُسَهُمْ"
  },
  {
   "segment_id": 160,
   "arabic": "جَاؤُوكَ فَٱسْتَغْفَرُوٱ ٱللَّهَ"
  },
  {
   "segment_id": 161,
   "arabic": "وَٱسْتَغْفَرَ لَهُمُ ٱلرَّسُولُ"
  },
  {
   "segment_id": 162,
   "arabic": "لَوَجَدُوٱ ٱللَّهَ تَوَّاباً رَحِيماً.»"
  },
  {
   "segment_id": 163,
   "arabic": "وَلَمْ احْضُرْ زَمَانَ رَسُولِكَ عَلَيْهِ وَآلِهِ ٱلسَّلاَمُ"
  },
  {
   "segment_id": 164,
   "arabic": "اَللَّهُمَّ وَقَدْ زُرْتُهُ رَاغِباً تَائِباً مِنْ سَيِّءِ عَمَلِي"
  },
  {
   "segment_id": 165,
   "arabic": "وَمُسْتَغْفِراً لَكَ مِنْ ذُنُوبِي"
  },
  {
   "segment_id": 166,
   "arabic": "وَمُقِرّاً لَكَ بِهَا وَانْتَ اعْلَمُ بِهَا مِنِّي"
  },
  {
   "segment_id": 167,
   "arabic": "وَمُتَوَجِّهاً إِلَيْكَ بِنَبِيِّكَ نَبِيِّ ٱلرَّحْمَةِ"
  },
  {
   "segment_id": 168,
   "arabic": "صَلَوَاتُكَ عَلَيْهِ وَآلِهِ"
  },
  {
   "segment_id": 169,
   "arabic": "فَٱجْعَلْنِي ٱللَّهُمَّ بِمُحَمَّدٍ وَاهْلِ بَيْتِهِ عِنْدَكَ وَجِيهاً"
  },
  {
   "segment_id": 170,
   "arabic": "فِي ٱلدُّنْيَا وَٱلآخِرَةِ وَمِنَ ٱلْمُقَرَّبِينَ"
  },
  {
   "segment_id": 171,
   "arabic": "يَا مُحَمَّدُ"
  },
  {
   "segment_id": 172,
   "arabic": "يَا رَسُولَ ٱللَّهِ"
  },
  {
   "segment_id": 173,
   "arabic": "بِابِي انْتَ وَامِّي"
  },
  {
   "segment_id": 174,
   "arabic": "يَا نَبِيَّ ٱللَّهِ"
  },
  {
   "segment_id": 175,
   "arabic": "يَا سَيِّدَ خَلْقِ ٱللَّهِ"
  },
  {
   "segment_id": 176,
   "arabic": "إِنِّي اتَوَجَّهُ بِكَ إِلَىٰ ٱللَّهِ رَبِّكَ وَرَبِّي"
  },
  {
   "segment_id": 177,
   "arabic": "لِيَغْفِرَ لِي ذُنُوبِي"
  },
  {
   "segment_id": 178,
   "arabic": "وَيَتَقَبَّلَ مِنِّي عَمَلِي"
  },
  {
   "segment_id": 179,
   "arabic": "وَيَقْضِيَ لِي حَوَائِجِي"
  },
  {
   "segment_id": 180,
   "arabic": "فَكُنْ لِي شَفِيعاً عِنْدَ رَبِّكَ وَرَبِّي"
  },
  {
   "segment_id": 181,
   "arabic": "فَنِعْمَ ٱلْمَسْؤُولُ ٱلْمَوْلَىٰ رَبِّي"
  },
  {
   "segment_id": 182,
   "arabic": "وَنِعْمَ ٱلشَّفِيعُ انْتَ"
  },
  {
   "segment_id": 183,
   "arabic": "يَا مُحَمَّدُ"
  },
  {
   "segment_id": 184,
   "arabic": "عَلَيْكَ وَعَلَىٰ اهْلِ بَيتِكَ ٱلسَّلاَمُ"
  },
  {
   "segment_id": 185,
   "arabic": "اَللَّهُمَّ وَاوْجِبْ لِي مِنْكَ ٱلْمَغْفِرَةَ وَٱلرَّحْمَةَ"
  },
  {
   "segment_id": 186,
   "arabic": "وَٱلرِّزْقَ ٱلوَاسِعَ ٱلطَّيِّبَ ٱلنَّافِعَ"
  },
  {
   "segment_id": 187,
   "arabic": "كَمَا اوْجَبْتَ لِمَنْ اتَىٰ نَبِيِّكَ مُحَمَّداً"
  },
  {
   "segment_id": 188,
   "arabic": "صَلَوَاتُكَ عَلَيْهِ وَآلِهِ"
  },
  {
   "segment_id": 189,
   "arabic": "وَهُوَ حَيٌّ فَاقَرَّ لَهُ بِذُنُوبِهِ"
  },
  {
   "segment_id": 190,
   "arabic": "وَٱسْتَغْفَرَ لَهُ رَسُولُكَ"
  },
  {
   "segment_id": 191,
   "arabic": "عَلَيْهِ وَآلِهِ ٱلسَّلاَمُ"
  },
  {
   "segment_id": 192,
   "arabic": "فَغَفَرْتَ لَهُ بِرَحْمَتِكَ يَا ارْحَمَ ٱلرَّاحِمِينَ"
  },
  {
   "segment_id": 193,
   "arabic": "اَللَّهُمَّ وَقَدْ امَّلْتُكَ وَرَجَوْتُكَ"
  },
  {
   "segment_id": 194,
   "arabic": "وَقُمْتُ بَيْنَ يَدَيْكَ"
  },
  {
   "segment_id": 195,
   "arabic": "وَرَغِبْتُ إِلَيْكَ عَمَّنْ سِوَاكَ"
  },
  {
   "segment_id": 196,
   "arabic": "وَقَدْ امَّلْتُ جَزِيلَ ثَوَابِكَ"
  },
  {
   "segment_id": 197,
   "arabic": "وَإِنِّي لَمُقِرٌّ غَيْرُ مُنْكِرٍ"
  },
  {
   "segment_id": 198,
   "arabic": "وَتَائِبٌ إِلَيْكَ مِمَّا ٱقْتَرَفْتُ"
  },
  {
   "segment_id": 199,
   "arabic": "وَعَائِذٌ بِكَ فِي هٰذَا ٱلْمَقَامِ"
  },
  {
   "segment_id": 200,
   "arabic": "مِمَّا قَدَّمْتُ مِنَ ٱلاعْمَالِ"
  },
  {
   "segment_id": 201,
   "arabic": "ٱلَّتِي تَقَدَّمْتَ إِلَيَّ فِيهَا وَنَهَيْتَنِي عَنْهَا"
  },
  {
   "segment_id": 202,
   "arabic": "وَاوْعَدْتَ عَلَيْهَا ٱلعِقَابَ"
  },
  {
   "segment_id": 203,
   "arabic": "وَاعُوذُ بِكَرَمِ وَجْهِكَ"
  },
  {
   "segment_id": 204,
   "arabic": "انْ تُقِيمَنِي مَقَامَ ٱلْخِزْيِ وَٱلذُّلِّ"
  },
  {
   "segment_id": 205,
   "arabic": "يَوْمَ تُهْتَكُ فِيهِ ٱلاسْتَارُ"
  },
  {
   "segment_id": 206,
   "arabic": "وَتَبْدُو فِيهِ ٱلاسْرَارُ وَٱلفَضَائِحُ"
  },
  {
   "segment_id": 207,
   "arabic": "وَتَرْعَدُ فِيهِ ٱلفَرَائِصُ"
  },
  {
   "segment_id": 208,
   "arabic": "يَوْمَ ٱلْحَسْرَةِ وَٱلنَّدَامَةِ"
  },
  {
   "segment_id": 209,
   "arabic": "يَوْمَ ٱلآفِكَةِ"
  },
  {
   "segment_id": 210,
   "arabic": "يَوْمَ ٱلآزِفَةِ"
  },
  {
   "segment_id": 211,
   "arabic": "يَوْمَ ٱلتَّغَابُنِ"
  },
  {
   "segment_id": 212,
   "arabic": "يَوْمَ ٱلفَصْلِ"
  },
  {
   "segment_id": 213,
   "arabic": "يَوْمَ ٱلْجَزَاءِ"
  },
  {
   "segment_id": 214,
   "arabic": "يَوْماً كَانَ مِقْدَارُهُ خَمْسِينَ الْفَ سَنَةٍ"
  },
  {
   "segment_id": 215,
   "arabic": "يَوْمَ ٱلنَّفْخَةِ"
  },
  {
   "segment_id": 216,
   "arabic": "يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ"
  },
  {
   "segment_id": 217,
   "arabic": "تَتْبَعُهَا ٱلرَّادِفَةُ"
  },
  {
   "segment_id": 218,
   "arabic": "يَوْمَ ٱلنَّشْرِ"
  },
  {
   "segment_id": 219,
   "arabic": "يَوْمَ ٱلعَرْضِ"
  },
  {
   "segment_id": 220,
   "arabic": "يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلعَالَمِينَ"
  },
  {
   "segment_id": 221,
   "arabic": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ اخِيهِ"
  },
  {
   "segment_id": 222,
   "arabic": "وَامِّهِ وَابِيهِ"
  },
  {
   "segment_id": 223,
   "arabic": "وَصَاحِبَتِهِ وَبَنِيهِ"
  },
  {
   "segment_id": 224,
   "arabic": "يَوْمَ تَشَقَّقُ ٱلارْضُ وَاكْنَافُ ٱلسَّمَاءِ"
  },
  {
   "segment_id": 225,
   "arabic": "يَوْمَ تَاتِي كُلُّ نَفْسٍ تُجَادِلُ عَنْ نَفْسِهَا"
  },
  {
   "segment_id": 226,
   "arabic": "يَوْمَ يُرَدُّونَ إِلَىٰ ٱللَّهِ فَيُنَبِّئُهُمْ بِمَا عَمِلُوٱ"
  },
  {
   "segment_id": 227,
   "arabic": "يَوْمَ لاَ يُغْنِي مَوْلَىٰ عَنْ مَوْلَىٰ شَيْئاً"
  },
  {
   "segment_id": 228,
   "arabic": "وَلاَ هُمْ يُنْصَرُونَ"
  },
  {
   "segment_id": 229,
   "arabic": "إِلاَّ مَنْ رَحِمَ ٱللَّهُ"
  },
  {
   "segment_id": 230,
   "arabic": "إِنَّهُ هُوَ ٱلعَزِيزُ ٱلرَّحِيمُ"
  },
  {
   "segment_id": 231,
   "arabic": "يَوْمَ يُرَدُّونَ إِلَىٰ عَالِمِ ٱلغَيْبِ وَٱلشَّهَادَةِ"
  },
  {
   "segment_id": 232,
   "arabic": "يَوْمَ يُرَدُّونَ إِلَىٰ اللَّهِ مَوْلاهُمُ ٱلْحَقِّ"
  },
  {
   "segment_id": 233,
   "arabic": "يَوْمَ يَخْرُجُونَ مِنَ ٱلاجْدَاثِ سِرَاعاً"
  },
  {
   "segment_id": 234,
   "arabic": "كَانَّهُمْ إِلَىٰ نُصُبٍ يُوفِضُونَ"
  },
  {
   "segment_id": 235,
   "arabic": "وَكَانَّهُمْ جَرَادٌ مُنْتَشِرٌ"
  },
  {
   "segment_id": 236,
   "arabic": "مُهْطِعِينَ إِلَىٰ ٱلدَّاعِي"
  },
  {
   "segment_id": 237,
   "arabic": "إِلَىٰ ٱللَّهِ"
  },
  {
   "segment_id": 238,
   "arabic": "يَوْمَ ٱلوَاقِعَةِ"
  },
  {
   "segment_id": 239,
   "arabic": "يَوْمَ تُرَجُّ ٱلارْضُ رَجّاً"
  },
  {
   "segment_id": 240,
   "arabic": "يَوْمَ تَكُونُ ٱلسَّمَاءُ كَٱلْمُهْلِ"
  },
  {
   "segment_id": 241,
   "arabic": "وَتَكُونُ ٱلْجِبَالُ كَٱلعِهْنِ"
  },
  {
   "segment_id": 242,
   "arabic": "وَلاَ يَسْالُ حَمِيمٌ حَمِيماً"
  },
  {
   "segment_id": 243,
   "arabic": "يَوْمَ ٱلشَّاهِدِ وَٱلْمَشْهُودِ"
  },
  {
   "segment_id": 244,
   "arabic": "يَوْمَ تَكُونُ ٱلْمَلائِكَةُ صَفّاً صَفّاً"
  },
  {
   "segment_id": 245,
   "arabic": "اَللَّهُمَّ ٱرْحَمْ مَوْقِفِي فِي ذٰلِكَ ٱليَوْمِ بِمَوْقِفِي فِي هٰذَا ٱليَوْمِ"
  },
  {
   "segment_id": 246,
   "arabic": "وَلاَ تُخْزِنِي فِي ذٰلِكَ ٱلْمَوْقِفِ بِمَا جَنَيْتُ عَلَىٰ نَفْسِي"
  },
  {
   "segment_id": 247,
   "arabic": "وَٱجْعَلْ يَا رَبِّ فِي ذٰلِكَ ٱليَوْمِ مَعَ اوْلِيَائِكَ مُنْطَلَقِي"
  },
  {
   "segment_id": 248,
   "arabic": "وَفِي زُمْرَةِ مُحَمَّدٍ وَاهْلِ بَيْتِهِ عَلَيْهِمُ ٱلسَّلاَمُ مَحْشَرِي"
  },
  {
   "segment_id": 249,
   "arabic": "وَٱجْعَلْ حَوْضَهُ مَوْرِدِي"
  },
  {
   "segment_id": 250,
   "arabic": "وَفِي ٱلغُرِّ ٱلكِرَامِ مَصْدَرِي"
  },
  {
   "segment_id": 251,
   "arabic": "وَاعْطِنِي كِتَابِي بِيَمِينِي"
  },
  {
   "segment_id": 252,
   "arabic": "حَتَّىٰ افُوزَ بِحَسَنَاتِي"
  },
  {
   "segment_id": 253,
   "arabic": "وَتُبَيِّضَ بِهِ وَجْهِي"
  },
  {
   "segment_id": 254,
   "arabic": "وَتُيَسِّرَ بِهِ حِسَابِي"
  },
  {
   "segment_id": 255,
   "arabic": "وَتُرَجِّحَ بِهِ مِيزَانِي"
  },
  {
   "segment_id": 256,
   "arabic": "وَامْضِيَ مَعَ ٱلفَائِزِينَ"
  },
  {
   "segment_id": 257,
   "arabic": "مِنْ عِبَادِكَ ٱلصَّالِحِينَ"
  },
  {
   "segment_id": 258,
   "arabic": "إِلَىٰ رِضْوَانِكَ وَجِنَانِكَ"
  },
  {
   "segment_id": 259,
   "arabic": "إِلٰهَ ٱلعَالَمِينَ"
  },
  {
   "segment_id": 260,
   "arabic": "اَللَّهُمَّ إِنِّي اعُوذُ بِكَ مِنْ انْ تَفْضَحَنِي فِي ذٰلِكَ ٱليَوْمِ"
  },
  {
   "segment_id": 261,
   "arabic": "بَيْنَ يَدَي ٱلْخَلائِقِ بِجَرِيرَتِي"
  },
  {
   "segment_id": 262,
   "arabic": "او اَنْ الْقَىٰ ٱلْخِزْيَ وَٱلنَّدَامَةَ بِخَطِيئَتِي"
  },
  {
   "segment_id": 263,
   "arabic": "اوْ انْ تُظْهِرَ فِيهِ سَيِّئَاتِي عَلَىٰ حَسَنَاتِي"
  },
  {
   "segment_id": 264,
   "arabic": "اوْ انْ تُنَوِّهَ بَيْنَ ٱلْخَلاَئِقِ بِٱسْمِي"
  },
  {
   "segment_id": 265,
   "arabic": "يَا كَرِيمُ يَا كَرِيمُ"
  },
  {
   "segment_id": 266,
   "arabic": "ٱلعَفْوَ ٱلعَفْوَ"
  },
  {
   "segment_id": 267,
   "arabic": "ٱلسِّتْرَ ٱلسِّتْرَ"
  },
  {
   "segment_id": 268,
   "arabic": "اَللَّهُمَّ وَاعُوذُ بِكَ مِنْ انْ يَكُونَ فِي ذٰلِكَ ٱليَوْمِ"
  },
  {
   "segment_id": 269,
   "arabic": "فِي مَوَاقِفِ ٱلاشْرَارِ مَوْقِفِي"
  },
  {
   "segment_id": 270,
   "arabic": "اوْ فِي مَقَامِ ٱلاشْقِيَاءِ مَقَامِي"
  },
  {
   "segment_id": 271,
   "arabic": "وَإِذَا مَيَّزْتَ بَيْنَ خَلْقِكَ"
  },
  {
   "segment_id": 272,
   "arabic": "فَسُقْتَ كُلاًّ بِاعْمَالِهِمْ"
  },
  {
   "segment_id": 273,
   "arabic": "زُمَراً إِلَىٰ مَنَازِلِهِمْ"
  },
  {
   "segment_id": 274,
   "arabic": "فَسُقْنِي بِرَحْمَتِكَ مَعَ عِبَادِكَ ٱلصَّالِحِينَ"
  },
  {
   "segment_id": 275,
   "arabic": "وَفِي زُمْرَةِ اوْلِيَائِكَ ٱلْمُتَّقِينَ"
  },
  {
   "segment_id": 276,
   "arabic": "إِلَىٰ جَنَّاتِكَ يَا رَبَّ ٱلْعَالَمِينَ"
  },
  {
   "segment_id": 277,
   "arabic": "السَّلاَمُ عَلَيْكَ يَا رَسُولَ ٱللَّهِ"
  },
  {
   "segment_id": 278,
   "arabic": "السَّلاَمُ عَلَيْكَ ايُّهَا ٱلْبَشِيرُ ٱلنَّذِيرُ"
  },
  {
   "segment_id": 279,
   "arabic": "السَّلاَمُ عَلَيْكَ ايُّهَا ٱلسِّرَاجُ ٱلْمُنِيرُ"
  },
  {
   "segment_id": 280,
   "arabic": "السَّلاَمُ عَلَيْكَ ايُّهَا ٱلسَّفِيرُ بَيْنَ ٱللَّهِ وَبَيْنَ خَلْقِهِ"
  },
  {
   "segment_id": 281,
   "arabic": "اشْهَدُ يَا رَسُولَ ٱللَّهِ انَّكَ كُنْتَ نُوراً فِي ٱلاصْلاَبِ ٱلشَّامِخَةِ"
  },
  {
   "segment_id": 282,
   "arabic": "وَٱلارْحَامِ الْمُطَهَّرَةِ"
  },
  {
   "segment_id": 283,
   "arabic": "لَمْ تُنَجِّسْكَ ٱلْجَاهِلِيَّةُ بِانْجَاسِهَا"
  },
  {
   "segment_id": 284,
   "arabic": "وَلَمْ تُلْبِسْكَ مِنْ مُدْلَهِمَّاتِ ثِيَابِهَا"
  },
  {
   "segment_id": 285,
   "arabic": "وَاَشْهَدُ يَا رَسُولَ ٱللَّهِ انِّي مُؤْمِنٌ بِكَ"
  },
  {
   "segment_id": 286,
   "arabic": "وَبِٱلائِمَّةِ مِنْ اهْلِ بَيْتِكَ"
  },
  {
   "segment_id": 287,
   "arabic": "مُوقِنٌ بِجَمِيعِ مَا اتَيْتَ بِهِ"
  },
  {
   "segment_id": 288,
   "arabic": "رَاضٍ مُؤْمِنٌ"
  },
  {
   "segment_id": 289,
   "arabic": "وَاشْهَدُ انَّ ٱلائِمَّةَ مِنْ اهْلِ بَيْتِكَ اعْلامُ ٱلْهُدَىٰ"
  },
  {
   "segment_id": 290,
   "arabic": "وَٱلعُرْوَةُ ٱلوُثْقَىٰ"
  },
  {
   "segment_id": 291,
   "arabic": "وَٱلْحُجَّةُ عَلَىٰ اهْلِ ٱلدُّنْيَا"
  },
  {
   "segment_id": 292,
   "arabic": "اَللَّهُمَّ لاَ تَجْعَلْهُ آخِرَ ٱلعَهْدِ مِنْ زِيَارَةِ نَبِيِّكَ"
  },
  {
   "segment_id": 293,
   "arabic": "عَلَيْهِ وَآلِهِ ٱلسَّلاَمُ"
  },
  {
   "segment_id": 294,
   "arabic": "وَإِنْ تَوَفَّيْتَنِي فَإِنِّي اشْهَدُ فِي مَمَاتِي"
  },
  {
   "segment_id": 295,
   "arabic": "عَلَىٰ مَا اشْهَدُ عَلَيْهِ فِي حَيَاتِي"
  },
  {
   "segment_id": 296,
   "arabic": "انَّكَ انْتَ ٱللَّهُ لاَ إِلٰهَ إِلاَّ انْتَ"
  },
  {
   "segment_id": 297,
   "arabic": "وَحْدَكَ لاَ شَرِيكَ لَكَ"
  },
  {
   "segment_id": 298,
   "arabic": "وَاَنَّ مُحَمَّداً عَبْدُكَ وَرَسُولُكَ"
  },
  {
   "segment_id": 299,
   "arabic": "وَانَّ ٱلائِمَّةَ مِنْ اهْلِ بَيْتِهِ اوْلِيَاؤُكَ وَانْصَارُكَ"
  },
  {
   "segment_id": 300,
   "arabic": "وَحُجَجُكَ عَلَىٰ خَلْقِكَ"
  },
  {
   "segment_id": 301,
   "arabic": "وَخُلَفَاؤُكَ فِي عِبَادِكَ"
  },
  {
   "segment_id": 302,
   "arabic": "وَاعْلامُكَ فِي بِلاَدِكَ"
  },
  {
   "segment_id": 303,
   "arabic": "وَخُزَّانُ عِلْمِكَ"
  },
  {
   "segment_id": 304,
   "arabic": "وَحَفَظَةُ سِرِّكَ"
  },
  {
   "segment_id": 305,
   "arabic": "وَتَرَاجِمَةُ وَحْيِكَ"
  },
  {
   "segment_id": 306,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 307,
   "arabic": "وَبَلِّغْ رُوحَ نَبِيِّكَ مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 308,
   "arabic": "فِي سَاعَتِي هٰذِهِ وَفِي كُلِّ سَاعَةٍ"
  },
  {
   "segment_id": 309,
   "arabic": "تَحِيَّةً مِنِّي وَسَلاماً"
  },
  {
   "segment_id": 310,
   "arabic": "وَٱلسَّلاَمُ عَلَيْكَ يَا رَسُولَ ٱللَّهِ وَرَحْمَةُ ٱللَّهِ وَبَرَكَاتُهُ"
  },
  {
   "segment_id": 311,
   "arabic": "لاَ جَعَلَهُ ٱللَّهُ آخِرَ تَسْلِيمِي عَلَيْكَ"
  }
 ]
}