{
 "dua_id": "duasorg-sahifa-fatimiya-dua-after-isha",
 "dua_name_en": "Dua of Sayeda Fatima (sa) after Isha Salaat",
 "dua_name_ar": "",
 "source": "https://www.duas.org/sahifa-fatimiya-dua-after-isha.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "سُبْحَانَ مَنْ تَوَاضَعَ كُلُّ شَيْ‏ءٍ لِعَظَمَتِهٖ"
  },
  {
   "segment_id": 2,
   "arabic": "سُبْحَانَ مَنْ ذَلَّ كُلُّ شَيْ‏ءٍ لِعِزَّتِهٖ"
  },
  {
   "segment_id": 3,
   "arabic": "سُبْحَانَ مَنْ خَضَعَ كُلُّ شَيْ‏ءٍ لِاَمْرِهٖ وَ مُلْكِهٖ"
  },
  {
   "segment_id": 4,
   "arabic": "سُبْحَانَ مَنِ انْقَادَتْ لَهُ الْاُمُوْرُ بِاَزِمَّتِهَا"
  },
  {
   "segment_id": 5,
   "arabic": "اَلْحَمْدُ لِلَّهِ الَّذِي لَا يَنْسَى مَنْ ذَكَرَهُ"
  },
  {
   "segment_id": 6,
   "arabic": "اَلْحَمْدُ لِلَّهِ الَّذِي لَا يُخَيِّبُ مَنْ دَعَاهُ"
  },
  {
   "segment_id": 7,
   "arabic": "اَلْحَمْدُ لِلَّهِ الَّذِي مَنْ تَوَكَّلَ عَلَيْهِ كَفَاهُ"
  },
  {
   "segment_id": 8,
   "arabic": "اَلْحَمْدُ لِلَّهِ سَامِكِ السَّمَاءِ"
  },
  {
   "segment_id": 9,
   "arabic": "وَ سَاطِحِ الْأَرْضِ"
  },
  {
   "segment_id": 10,
   "arabic": "وَ حَاصِرِ الْبِحَارِ"
  },
  {
   "segment_id": 11,
   "arabic": "وَ نَاضِدِ الْجِبَالِ"
  },
  {
   "segment_id": 12,
   "arabic": "وَ بَارِئِ الْحَيَوَانِ"
  },
  {
   "segment_id": 13,
   "arabic": "وَ خَالِقِ الشَّجَرِ"
  },
  {
   "segment_id": 14,
   "arabic": "وَ فَاتِحِ يَنَابِيعِ الْأَرْضِ"
  },
  {
   "segment_id": 15,
   "arabic": "وَ مُدَبِّرِ الْأُمُورِ"
  },
  {
   "segment_id": 16,
   "arabic": "وَ مُسَيِّرِ السَّحَابِ"
  },
  {
   "segment_id": 17,
   "arabic": "وَ مُجْرِي الرِّيحِ وَ الْمَاءِ"
  },
  {
   "segment_id": 18,
   "arabic": "وَ النَّارِ مِنْ أَغْوَارِ الْأَرْضِ مُتَسَارِعَاتٍ فِي الْهَوَاءِ"
  },
  {
   "segment_id": 19,
   "arabic": "وَ مُهْبِطِ الْحَرِّ وَ الْبَرْدِ"
  },
  {
   "segment_id": 20,
   "arabic": "اَلَّذِيْ بِنِعْمَتِهِ تَتِمُّ الصَّالِحَاتُ"
  },
  {
   "segment_id": 21,
   "arabic": "وَ بِشُكْرِهِ تُسْتَوْجَبُ الزِّيَادَاتُ"
  },
  {
   "segment_id": 22,
   "arabic": "وَبِأَمْرِهِ قَامَتِ السَّمَاوَاتُ"
  },
  {
   "segment_id": 23,
   "arabic": "وَبِعِزَّتِهِ اسْتَقَرَّتِ الرَّاسِيَاتُ"
  },
  {
   "segment_id": 24,
   "arabic": "وَسَبَّحَتِ الْوُحُوشُ فِي الْفَلَوَاتِ"
  },
  {
   "segment_id": 25,
   "arabic": "وَالطَّيْرُ فِي الْوَكَنَاتِ"
  },
  {
   "segment_id": 26,
   "arabic": "اَلْحَمْدُ لِلَّهِ رَفِيعِ الدَّرَجَاتِ"
  },
  {
   "segment_id": 27,
   "arabic": "مُنْزِلِ الْآيَاتِ"
  },
  {
   "segment_id": 28,
   "arabic": "وَاسِعِ الْبَرَكَاتِ"
  },
  {
   "segment_id": 29,
   "arabic": "سَاتِرِ الْعَوْرَاتِ"
  },
  {
   "segment_id": 30,
   "arabic": "قَابِلِ الْحَسَنَاتِ"
  },
  {
   "segment_id": 31,
   "arabic": "مُقِيلِ الْعَثَرَاتِ"
  },
  {
   "segment_id": 32,
   "arabic": "مُنَفِّسِ الْكُرُبَاتِ"
  },
  {
   "segment_id": 33,
   "arabic": "مُنْزِلِ الْبَرَكَاتِ"
  },
  {
   "segment_id": 34,
   "arabic": "مُجِيبِ الدَّعَوَاتِ"
  },
  {
   "segment_id": 35,
   "arabic": "مُحْيِي الْأَمْوَاتِ"
  },
  {
   "segment_id": 36,
   "arabic": "إِلٰهِ مَنْ فِي الْأَرْضِ وَ السَّمَاوَاتِ"
  },
  {
   "segment_id": 37,
   "arabic": "اَلْحَمْدُ لِلَّهِ عَلَى كُلِّ حَمْدٍ وَ ذِكْرٍ"
  },
  {
   "segment_id": 38,
   "arabic": "وَ شُكْرٍ وَ صَبْرٍ"
  },
  {
   "segment_id": 39,
   "arabic": "وَ صَلَاةٍ وَ زَكَاةٍ"
  },
  {
   "segment_id": 40,
   "arabic": "وَ قِيَامٍ وَ عِبَادَةٍ"
  },
  {
   "segment_id": 41,
   "arabic": "وَ سَعَادَةٍ وَ بَرَكَةٍ"
  },
  {
   "segment_id": 42,
   "arabic": "وَ زِيَادَةٍ وَ رَحْمَةٍ"
  },
  {
   "segment_id": 43,
   "arabic": "وَ نِعْمَةٍ وَ كَرَامَةٍ"
  },
  {
   "segment_id": 44,
   "arabic": "وَ فَرِيضَةٍ وَ سَرَّاءَ وَ ضَرَّاءَ"
  },
  {
   "segment_id": 45,
   "arabic": "وَ شِدَّةٍ وَ رَخَاءٍ"
  },
  {
   "segment_id": 46,
   "arabic": "وَ مُصِيبَةٍ وَ بَلَاءٍ"
  },
  {
   "segment_id": 47,
   "arabic": "وَ عُسْرٍ وَ يُسْرٍ"
  },
  {
   "segment_id": 48,
   "arabic": "وَ غِنَاءٍ وَ فَقْرٍ"
  },
  {
   "segment_id": 49,
   "arabic": "وَ عَلَى كُلِّ حَالٍ"
  },
  {
   "segment_id": 50,
   "arabic": "وَ فِي كُلِّ أَوَانٍ وَ زَمَانٍ"
  },
  {
   "segment_id": 51,
   "arabic": "وَ فِي كُلِّ مَثْوًى وَ مُنْقَلَبٍ وَ مُقَامٍ"
  },
  {
   "segment_id": 52,
   "arabic": "اَللَّهُمَّ إِنِّي عَائِذٌ بِكَ"
  },
  {
   "segment_id": 53,
   "arabic": "وَ لَائِذٌ بِحِمَاكَ"
  },
  {
   "segment_id": 54,
   "arabic": "مُتَحَرِّزٌ فِي حِصْنِكَ"
  },
  {
   "segment_id": 55,
   "arabic": "مُتَعَرِّضٌ لِرَحْمَتِكَ"
  },
  {
   "segment_id": 56,
   "arabic": "وَ مُسْتَسْلِمٌ لِقَضَائِكَ"
  },
  {
   "segment_id": 57,
   "arabic": "وَ رَاضٍ بِحُكْمِكَ"
  },
  {
   "segment_id": 58,
   "arabic": "مُوَكِّلٌ أَمْرِي إِلَيْكَ"
  },
  {
   "segment_id": 59,
   "arabic": "أُفَوِّضُ أَمْرِي إِلَى اللهِ"
  },
  {
   "segment_id": 60,
   "arabic": "إِنَّ اللهَ بَصِيرٌ بِالْعِبَادِ"
  },
  {
   "segment_id": 61,
   "arabic": "اَلْحَمْدُ لِلَّهِ الَّذِي لَا يُرْجَى إِلَّا فَضْلُهُ"
  },
  {
   "segment_id": 62,
   "arabic": "وَلَا يُسْأَلُ إِلَّا عَفْوُهُ"
  },
  {
   "segment_id": 63,
   "arabic": "وَلَا يُنْظَرُ إِلَّا بِرُّهُ"
  },
  {
   "segment_id": 64,
   "arabic": "وَلَا يُخَافُ إِلَّا عَدْلُهُ"
  },
  {
   "segment_id": 65,
   "arabic": "وَلَا يُدْرَكُ إِلَّا عِلْمُهُ"
  },
  {
   "segment_id": 66,
   "arabic": "وَلَا يُحَاطُ إِلَّا بِسُلْطَانِهِ"
  },
  {
   "segment_id": 67,
   "arabic": "وَلَا يَبْقَى إِلَّا مُلْكُهُ"
  },
  {
   "segment_id": 68,
   "arabic": "وَلَا يُعْبَدُ إِلَّا إِيَّاهُ"
  },
  {
   "segment_id": 69,
   "arabic": "وَلَا إِلَهَ إِلَّا هُوَ"
  },
  {
   "segment_id": 70,
   "arabic": "اللَّهُمَّ اجْعَلْنِي أَخْشَاكَ كَأَنِّي أَرَاكَ أَبَدًا حَتَّى أَلْقَاكَ"
  },
  {
   "segment_id": 71,
   "arabic": "وَأَسْعِدْنِي بِتَقْوَاكَ"
  },
  {
   "segment_id": 72,
   "arabic": "وَلَا تُشْقِنِي بِمَعْصِيَتِكَ"
  },
  {
   "segment_id": 73,
   "arabic": "وَخِرْ لِي فِي قَضَائِكَ"
  },
  {
   "segment_id": 74,
   "arabic": "وَبَارِكْ لِي فِي قَدَرِكَ"
  },
  {
   "segment_id": 75,
   "arabic": "حَتَّى لَا أُحِبَّ تَعْجِيلَ مَا أَخَّرْتَ وَلَا تَأْخِيرَ مَا عَجَّلْتَ"
  },
  {
   "segment_id": 76,
   "arabic": "وَاجْعَلْ غِنَايَ فِي نَفْسِي"
  },
  {
   "segment_id": 77,
   "arabic": "وَأَمْتِعْنِي بِسَمْعِي وَبَصَرِي"
  },
  {
   "segment_id": 78,
   "arabic": "وَاجْعَلْهُمَا الْوَارِثَيْنِ مِنِّي"
  },
  {
   "segment_id": 79,
   "arabic": "وَانْصُرْنِي عَلَى مَنْ ظَلَمَنِي"
  },
  {
   "segment_id": 80,
   "arabic": "وَأَرِنِي فِيهِ ثَأْرِي"
  },
  {
   "segment_id": 81,
   "arabic": "وَأَقِرَّ بِذَلِكَ عَيْنِي"
  },
  {
   "segment_id": 82,
   "arabic": "اَللَّهُمَّ اكْفِنِي حَسَدَ الْحَاسِدِينَ"
  },
  {
   "segment_id": 83,
   "arabic": "وَ بَغْيَ الْبَاغِينَ"
  },
  {
   "segment_id": 84,
   "arabic": "وَ كَيْدَ الْكَائِدِينَ"
  },
  {
   "segment_id": 85,
   "arabic": "وَ مَكْرَ الْمَاكِرِينَ"
  },
  {
   "segment_id": 86,
   "arabic": "وَ حِيلَةَ الْمُحْتَالِينَ"
  },
  {
   "segment_id": 87,
   "arabic": "وَ غِيلَةَ الْمُغْتَالِينَ"
  },
  {
   "segment_id": 88,
   "arabic": "وَ ظُلْمَ الظَّالِمِينَ"
  },
  {
   "segment_id": 89,
   "arabic": "وَ جَوْرَ الْجَائِرِينَ"
  },
  {
   "segment_id": 90,
   "arabic": "وَ اعْتِدَاءَ الْمُعْتَدِينَ"
  },
  {
   "segment_id": 91,
   "arabic": "وَ سَخَطَ الْمُسْخِطِينَ"
  },
  {
   "segment_id": 92,
   "arabic": "وَ تَشَحُّبَ الْمُتَشَحِّبِينَ"
  },
  {
   "segment_id": 93,
   "arabic": "وَ صَوْلَةَ الصَّائِلِينَ"
  },
  {
   "segment_id": 94,
   "arabic": "وَ اقْتِسَارَ الْمُقْتَسِرِينَ"
  },
  {
   "segment_id": 95,
   "arabic": "وَ غَشْمَ الْغَاشِمِينَ"
  },
  {
   "segment_id": 96,
   "arabic": "وَ خَبْطَ الْخَابِطِينَ"
  },
  {
   "segment_id": 97,
   "arabic": "وَ سِعَايَةَ السَّاعِينَ"
  },
  {
   "segment_id": 98,
   "arabic": "وَ نَمَامَةَ النَّمَّامِينَ"
  },
  {
   "segment_id": 99,
   "arabic": "وَ سِحْرَ السَّحَرَةِ وَ الْمَرَدَّةِ وَ الشَّيَاطِينِ"
  },
  {
   "segment_id": 100,
   "arabic": "وَ جَوْرَ السَّلَاطِينِ"
  },
  {
   "segment_id": 101,
   "arabic": "وَ مَكْرُوْهَ الْعَالَمِينَ"
  },
  {
   "segment_id": 102,
   "arabic": "اَللَّهُمَّ إِنِّي أَسْأَلُكَ بِاسْمِكَ الْمَخْزُونِ الطَّيِّبِ الطَّاهِرِ"
  },
  {
   "segment_id": 103,
   "arabic": "الَّذِي قَامَتْ بِهِ السَّمَاوَاتُ وَ الْأَرْضُ"
  },
  {
   "segment_id": 104,
   "arabic": "وَ أَشْرَقَتْ لَهُ الظُّلُمُ"
  },
  {
   "segment_id": 105,
   "arabic": "وَ سَبَّحَتْ لَهُ الْمَلَائِكَةُ"
  },
  {
   "segment_id": 106,
   "arabic": "وَ وَجِلَتْ مِنْهُ الْقُلُوبُ"
  },
  {
   "segment_id": 107,
   "arabic": "وَ خَضَعَتْ لَهُ الرِّقَابُ"
  },
  {
   "segment_id": 108,
   "arabic": "وَ أُحْيِيَتْ بِهِ الْمَوْتَى"
  },
  {
   "segment_id": 109,
   "arabic": "أَنْ تَغْفِرَ لِي كُلَّ ذَنْبٍ أَذْنَبْتُهُ فِي ظُلُمِ اللَّيْلِ وَ ضَوْءِ النَّهَارِ"
  },
  {
   "segment_id": 110,
   "arabic": "عَمْدًا أَوْ خَطَأً"
  },
  {
   "segment_id": 111,
   "arabic": "سِرًّا أَوْ عَلَانِيَةً"
  },
  {
   "segment_id": 112,
   "arabic": "وَ أَنْ تَهَبَ لِي يَقِينًا وَ هُدًى"
  },
  {
   "segment_id": 113,
   "arabic": "وَ نُورًا وَ عِلْمًا وَ فَهْمًا"
  },
  {
   "segment_id": 114,
   "arabic": "حَتَّى أُقِيمَ كِتَابَكَ"
  },
  {
   "segment_id": 115,
   "arabic": "وَ أُحِلَّ حَلَالَكَ"
  },
  {
   "segment_id": 116,
   "arabic": "وَ أُحَرِّمَ حَرَامَكَ"
  },
  {
   "segment_id": 117,
   "arabic": "وَ أُؤَدِّيَ فَرَائِضَكَ"
  },
  {
   "segment_id": 118,
   "arabic": "وَ أُقِيمَ سُنَّةَ نَبِيِّكَ مُحَمَّدٍ صَلَّى اللهُ عَلَيْهِ وَ آلِهِ"
  },
  {
   "segment_id": 119,
   "arabic": "اَللَّهُمَّ الْحِقْنِي بِصَالِحِ مَنْ مَضَى"
  },
  {
   "segment_id": 120,
   "arabic": "وَ اجْعَلْنِي مِنْ صَالِحِ مَنْ بَقِيَ"
  },
  {
   "segment_id": 121,
   "arabic": "وَ اخْتِمْ لِي عَمَلِي بِأَحْسَنِهِ"
  },
  {
   "segment_id": 122,
   "arabic": "إِنَّكَ غَفُورٌ رَحِيمٌ"
  },
  {
   "segment_id": 123,
   "arabic": "اَللَّهُمَّ إِذَا فَنَى عُمْرِي وَ تَصَرَّمَتْ أَيَّامُ حَيَاتِي"
  },
  {
   "segment_id": 124,
   "arabic": "وَ كَانَ لَا بُدَّ لِي مِنْ لِقَائِكَ"
  },
  {
   "segment_id": 125,
   "arabic": "فَأَسْأَلُكَ يَا لَطِيفُ أَنْ تُوجِبَ لِي مِنَ الْجَنَّةِ مَنْزِلًا"
  },
  {
   "segment_id": 126,
   "arabic": "يَغْبِطُنِي بِهِ الْأَوَّلُونَ وَ الْآخِرُونَ"
  },
  {
   "segment_id": 127,
   "arabic": "اَللَّهُمَّ اقْبَلْ مِدْحَتِي وَ الْتِهَافِي"
  },
  {
   "segment_id": 128,
   "arabic": "وَ ارْحَمْ ضَرَاعَتِي وَ هُتَافِي"
  },
  {
   "segment_id": 129,
   "arabic": "وَ إِقْرَارِي عَلَى نَفْسِي وَ اعْتِرَافِي"
  },
  {
   "segment_id": 130,
   "arabic": "فَقَدْ أَسْمَعْتُكَ صَوْتِي فِي الدَّاعِينَ"
  },
  {
   "segment_id": 131,
   "arabic": "وَ خُشُوعِي فِي الضَّارِعِينَ"
  },
  {
   "segment_id": 132,
   "arabic": "وَ مِدْحَتِي فِي الْقَائِلِينَ"
  },
  {
   "segment_id": 133,
   "arabic": "وَ تَسْبِيحِي فِي الْمَادِحِينَ"
  },
  {
   "segment_id": 134,
   "arabic": "وَ أَنْتَ مُجِيبُ الْمُضْطَرِّينَ"
  },
  {
   "segment_id": 135,
   "arabic": "وَ مُغِيثُ الْمُسْتَغِيثِينَ"
  },
  {
   "segment_id": 136,
   "arabic": "وَ غِيَاثُ الْمَلْهُوفِينَ"
  },
  {
   "segment_id": 137,
   "arabic": "وَ حِرْزُ الْهَارِبِينَ"
  },
  {
   "segment_id": 138,
   "arabic": "وَ صَرِيخُ الْمُؤْمِنِينَ"
  },
  {
   "segment_id": 139,
   "arabic": "وَ مُقِيلُ الْمُذْنِبِينَ"
  },
  {
   "segment_id": 140,
   "arabic": "وَ صَلَّى اللهُ عَلَى الْبَشِيرِ النَّذِيرِ وَ السِّرَاجِ الْمُنِيرِ"
  },
  {
   "segment_id": 141,
   "arabic": "وَ عَلَى الْمَلَائِكَةِ وَ النَّبِيِّينَ"
  },
  {
   "segment_id": 142,
   "arabic": "اَللَّهُمَّ دَاحِيَ الْمَدْحُوَّاتِ"
  },
  {
   "segment_id": 143,
   "arabic": "وَ بَارِئَ الْمَسْمُوكَاتِ"
  },
  {
   "segment_id": 144,
   "arabic": "وَ جَبَّالَ الْقُلُوبِ عَلَى فِطْرَتِهَا شَقِيِّهَا وَ سَعِيدِهَا"
  },
  {
   "segment_id": 145,
   "arabic": "اجْعَلْ شَرَائِفَ صَلَوَاتِكَ"
  },
  {
   "segment_id": 146,
   "arabic": "وَ نَوَامِيَ بَرَكَاتِكَ"
  },
  {
   "segment_id": 147,
   "arabic": "وَ كَرَائِمَ تَحِيَّاتِكَ"
  },
  {
   "segment_id": 148,
   "arabic": "عَلَى مُحَمَّدٍ عَبْدِكَ وَ رَسُولِكَ وَ أَمِينِكَ عَلَى وَحْيِكَ"
  },
  {
   "segment_id": 149,
   "arabic": "الْقَائِمِ بِحُجَّتِكَ"
  },
  {
   "segment_id": 150,
   "arabic": "وَ الذَّابِّ عَنْ حَرَمِكَ"
  },
  {
   "segment_id": 151,
   "arabic": "وَ الصَّادِعِ بِأَمْرِكَ"
  },
  {
   "segment_id": 152,
   "arabic": "وَ الْمُشَيِّدِ لِآيَاتِكَ"
  },
  {
   "segment_id": 153,
   "arabic": "وَ الْمُوفِي لِنَذْرِكَ"
  },
  {
   "segment_id": 154,
   "arabic": "اَللَّهُمَّ فَأَعْطِهِ بِكُلِّ فَضِيلَةٍ مِنْ فَضَائِلِهِ"
  },
  {
   "segment_id": 155,
   "arabic": "وَ مَنْقَبَةٍ مِنْ مَنَاقِبِهِ"
  },
  {
   "segment_id": 156,
   "arabic": "وَ حَالٍ مِنْ أَحْوَالِهِ"
  },
  {
   "segment_id": 157,
   "arabic": "وَ مَنْزِلَةٍ مِنْ مَنَازِلِهِ"
  },
  {
   "segment_id": 158,
   "arabic": "رَأَيْتَ مُحَمَّدًا لَكَ فِيهَا نَاصِرًا"
  },
  {
   "segment_id": 159,
   "arabic": "وَ عَلَى مَكْرُوهِ بَلَائِكَ صَابِرًا"
  },
  {
   "segment_id": 160,
   "arabic": "وَ لِمَنْ عَادَاكَ مُعَادِيًا"
  },
  {
   "segment_id": 161,
   "arabic": "وَ لِمَنْ وَالَاكَ مُوَالِيًا"
  },
  {
   "segment_id": 162,
   "arabic": "وَ عَمَّا كَرِهْتَ نَائِيًا"
  },
  {
   "segment_id": 163,
   "arabic": "وَ إِلَى مَا أَحْبَبْتَ دَاعِيًا"
  },
  {
   "segment_id": 164,
   "arabic": "فَضَائِلَ مِنْ جَزَائِكَ"
  },
  {
   "segment_id": 165,
   "arabic": "وَ خَصَائِصَ مِنْ عَطَائِكَ وَ حِبَائِكَ"
  },
  {
   "segment_id": 166,
   "arabic": "تُسْنِي بِهَا أَمْرَهُ"
  },
  {
   "segment_id": 167,
   "arabic": "وَ تُعْلِي بِهَا دَرَجَتَهُ مَعَ الْقُوَّامِ بِقِسْطِكَ"
  },
  {
   "segment_id": 168,
   "arabic": "وَ الذَّابِّينَ عَنْ حَرَمِكَ"
  },
  {
   "segment_id": 169,
   "arabic": "حَتَّى لَا يَبْقَى سَنَاءٌ وَ لَا بَهَاءٌ وَ لَا رَحْمَةٌ وَ لَا كَرَامَةٌ"
  },
  {
   "segment_id": 170,
   "arabic": "إِلَّا خَصَّصْتَ مُحَمَّدًا بِذَلِكَ"
  },
  {
   "segment_id": 171,
   "arabic": "وَ آتَيْتَهُ مِنْكَ الذُّرَى"
  },
  {
   "segment_id": 172,
   "arabic": "وَ بَلَّغْتَهُ الْمَقَامَاتِ الْعُلَى"
  },
  {
   "segment_id": 173,
   "arabic": "آمِينَ رَبَّ الْعَالَمِينَ"
  },
  {
   "segment_id": 174,
   "arabic": "اَللَّهُمَّ إِنِّي أَسْتَوْدِعُكَ دِينِي وَ نَفْسِي وَ جَمِيعَ نِعْمَتِكَ عَلَيَّ"
  },
  {
   "segment_id": 175,
   "arabic": "فَاجْعَلْنِي فِي كَنَفِكَ وَ حِفْظِكَ"
  },
  {
   "segment_id": 176,
   "arabic": "وَ عِزِّكَ وَ مَنْعِكَ"
  },
  {
   "segment_id": 177,
   "arabic": "عَزَّ جَارُكَ"
  },
  {
   "segment_id": 178,
   "arabic": "وَ جَلَّ ثَنَاؤُكَ"
  },
  {
   "segment_id": 179,
   "arabic": "وَ تَقَدَّسَتْ أَسْمَاؤُكَ"
  },
  {
   "segment_id": 180,
   "arabic": "وَ لَا إِلَهَ غَيْرُكَ"
  },
  {
   "segment_id": 181,
   "arabic": "حَسْبِي أَنْتَ فِي السَّرَّاءِ وَ الضَّرَّاءِ وَ الشِّدَّةِ وَ الرَّخَاءِ"
  },
  {
   "segment_id": 182,
   "arabic": "وَ نِعْمَ الْوَكِيلُ"
  },
  {
   "segment_id": 183,
   "arabic": "رَبَّنَا عَلَيْكَ تَوَكَّلْنَا"
  },
  {
   "segment_id": 184,
   "arabic": "وَ إِلَيْكَ أَنَبْنَا"
  },
  {
   "segment_id": 185,
   "arabic": "وَ إِلَيْكَ الْمَصِيرُ"
  },
  {
   "segment_id": 186,
   "arabic": "رَبَّنَا لَا تَجْعَلْنَا فِتْنَةً لِلَّذِينَ كَفَرُوا"
  },
  {
   "segment_id": 187,
   "arabic": "وَ اغْفِرْ لَنَا رَبَّنَا"
  },
  {
   "segment_id": 188,
   "arabic": "إِنَّكَ أَنْتَ الْعَزِيزُ الْحَكِيمُ"
  },
  {
   "segment_id": 189,
   "arabic": "رَبَّنَا اصْرِفْ عَنَّا عَذَابَ جَهَنَّمَ"
  },
  {
   "segment_id": 190,
   "arabic": "إِنَّ عَذَابَهَا كَانَ غَرَامًا"
  },
  {
   "segment_id": 191,
   "arabic": "إِنَّهَا سَاءَتْ مُسْتَقَرًّا وَ مُقَامًا"
  },
  {
   "segment_id": 192,
   "arabic": "رَبَّنَا افْتَحْ بَيْنَنَا وَ بَيْنَ قَوْمِنَا بِالْحَقِّ"
  },
  {
   "segment_id": 193,
   "arabic": "وَ أَنْتَ خَيْرُ الْفَاتِحِينَ"
  },
  {
   "segment_id": 194,
   "arabic": "رَبَّنَا فَاغْفِرْ لَنَا ذُنُوبَنَا"
  },
  {
   "segment_id": 195,
   "arabic": "وَ كَفِّرْ عَنَّا سَيِّئَاتِنَا"
  },
  {
   "segment_id": 196,
   "arabic": "وَ تَوَفَّنَا مَعَ الْأَبْرَارِ"
  },
  {
   "segment_id": 197,
   "arabic": "رَبَّنَا وَ آتِنَا مَا وَعَدْتَنَا عَلَى رُسُلِكَ"
  },
  {
   "segment_id": 198,
   "arabic": "وَ لَا تُخْزِنَا يَوْمَ الْقِيَامَةِ"
  },
  {
   "segment_id": 199,
   "arabic": "إِنَّكَ لَا تُخْلِفُ الْمِيعَادَ"
  },
  {
   "segment_id": 200,
   "arabic": "رَبَّنَا لَا تُؤَاخِذْنَا إِنْ نَسِينَا أَوْ أَخْطَأْنَا"
  },
  {
   "segment_id": 201,
   "arabic": "رَبَّنَا وَ لَا تَحْمِلْ عَلَيْنَا إِصْرًا كَمَا حَمَلْتَهُ عَلَى الَّذِينَ مِنْ قَبْلِنَا"
  },
  {
   "segment_id": 202,
   "arabic": "رَبَّنَا وَ لَا تُحَمِّلْنَا مَا لَا طَاقَةَ لَنَا بِهِ"
  },
  {
   "segment_id": 203,
   "arabic": "وَ اعْفُ عَنَّا"
  },
  {
   "segment_id": 204,
   "arabic": "وَ اغْفِرْ لَنَا"
  },
  {
   "segment_id": 205,
   "arabic": "وَ ارْحَمْنَا"
  },
  {
   "segment_id": 206,
   "arabic": "أَنْتَ مَوْلَانَا فَانْصُرْنَا عَلَى الْقَوْمِ الْكَافِرِينَ"
  },
  {
   "segment_id": 207,
   "arabic": "رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً"
  },
  {
   "segment_id": 208,
   "arabic": "وَ فِي الْآخِرَةِ حَسَنَةً"
  },
  {
   "segment_id": 209,
   "arabic": "وَ قِنَا عَذَابَ النَّارِ"
  },
  {
   "segment_id": 210,
   "arabic": "وَ صَلَّى اللهُ عَلَى سَيِّدِنَا مُحَمَّدٍ النَّبِيِّ وَ آلِهِ الطَّاهِرِينَ وَ سَلَّمَ تَسْلِيمًا"
  }
 ]
}