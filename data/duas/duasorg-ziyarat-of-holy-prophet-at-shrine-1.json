{
 "dua_id": "duasorg-ziyarat-of-holy-prophet-at-shrine-1",
 "dua_name_en": "Ziyarat of Holy Prophet (sawa) (at Rawza in Madinah)",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ziyarat-of-holy-prophet-at-shrine.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "السَّلاَمُ عَلَيْكَ يَا رَسُولَ ٱللَّهِ"
  },
  {
   "segment_id": 2,
   "arabic": "السَّلاَمُ عَلَيْكَ يَا نَبِيَّ ٱللَّهِ"
  },
  {
   "segment_id": 3,
   "arabic": "السَّلاَمُ عَلَيْكَ يَا مُحَمَّدُ بْنَ عَبْدِ ٱللَّهِ"
  },
  {
   "segment_id": 4,
   "arabic": "السَّلاَمُ عَلَيْكَ يَا خَاتَمَ ٱلنَّبِيِّينَ"
  },
  {
   "segment_id": 5,
   "arabic": "اشْهَدُ انَّكَ قَدْ بَلَّغْتَ ٱلرِّسَالَةَ"
  },
  {
   "segment_id": 6,
   "arabic": "وَاقَمْتَ ٱلصَّلاةَ"
  },
  {
   "segment_id": 7,
   "arabic": "وَآتَيْتَ ٱلزَّكَاةَ"
  },
  {
   "segment_id": 8,
   "arabic": "وَامَرْتَ بِٱلمَعْرُوفِ"
  },
  {
   "segment_id": 9,
   "arabic": "وَنَهَيْتَ عَنِ ٱلمُنْكَرِ"
  },
  {
   "segment_id": 10,
   "arabic": "وَعَبَدْتَ ٱللَّهَ مُخْلِصاً حَتَّىٰ اتَاكَ ٱليَقِينُ"
  },
  {
   "segment_id": 11,
   "arabic": "فَصَلَوَاتُ ٱللَّهِ عَلَيْكَ وَرَحْمَتُهُ"
  },
  {
   "segment_id": 12,
   "arabic": "وَعَلَىٰ اهْلِ بَيْتِكَ ٱلطَّاهِرِينَ"
  }
 ]
}