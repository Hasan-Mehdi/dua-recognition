{
 "dua_id": "duasorg-sahifa-alaviya-supplication-after-completing-eight-rakats-of-midnight-prayers-108",
 "dua_name_en": "Sahifa Alavia - After Completing Eight Rakats (Units) Of Midnight Prayers (108)",
 "dua_name_ar": "",
 "source": "https://www.duas.org/sahifa-alaviya-supplication-after-completing-eight-rakats-of-midnight-prayers-108.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللّٰهُمَّ اِنِّيْ اَسْئَلُكَ بِحُرْمَةِ مَنْ عَاذَ بِكَ مِنْكَ"
  },
  {
   "segment_id": 2,
   "arabic": "وَ لَجَأَ اِلٰى عِزِّكَ"
  },
  {
   "segment_id": 3,
   "arabic": "وَ اسْتَظَلَّ بِفَيْئِكَ"
  },
  {
   "segment_id": 4,
   "arabic": "وَ اعْتَصَمَ بِحَبْلِكَ"
  },
  {
   "segment_id": 5,
   "arabic": "وَ لَمْ يَثِقْ اِلَّا بِكَ"
  },
  {
   "segment_id": 6,
   "arabic": "يَا جَزِيْلَ الْعَطَايَا"
  },
  {
   "segment_id": 7,
   "arabic": "يَا مُطْلِقَ الْاُسَارٰى"
  },
  {
   "segment_id": 8,
   "arabic": "يَا مَنْ سَمّٰى نَفْسَهُ مِنْ جُوْدِهِ وَهَّابًا"
  },
  {
   "segment_id": 9,
   "arabic": "وَ هَا اَنَا اَدْعُوْكَ"
  },
  {
   "segment_id": 10,
   "arabic": "رَغَبًا وَ رَهَبًا"
  },
  {
   "segment_id": 11,
   "arabic": "وَ خَوْفًا وَ طَمَعًا"
  },
  {
   "segment_id": 12,
   "arabic": "وَ اِلْحَافًا وَ اِلْحَاحًا"
  },
  {
   "segment_id": 13,
   "arabic": "وَ تَضَرُّعًا وَ تَمَلُّقًا"
  },
  {
   "segment_id": 14,
   "arabic": "وَ قَائِمًا وَ قَاعِدًا"
  },
  {
   "segment_id": 15,
   "arabic": "وَ رَاكِعًا وَ سَاجِدًا"
  },
  {
   "segment_id": 16,
   "arabic": "وَ رَاكِبًا وَ مَاشِيًا"
  },
  {
   "segment_id": 17,
   "arabic": "وَ ذَاهِبًا وَ جَائِيًا"
  },
  {
   "segment_id": 18,
   "arabic": "وَ فِيْ كُلِّ حَالَاتِيْ"
  },
  {
   "segment_id": 19,
   "arabic": "اَسْئَلُكَ اَنْ تُصَلِّيَ عَلٰى مُحَمَّدٍ وَ اٰلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 20,
   "arabic": "وَ اَنْ تَفْعَلَ بِيْ كَذَا وَ كَذَا"
  }
 ]
}