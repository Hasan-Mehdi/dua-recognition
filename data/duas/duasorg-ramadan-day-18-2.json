{
 "dua_id": "duasorg-ramadan-day-18-2",
 "dua_name_en": "Ramadan Day 18 · from Muhammad ibn Abi Qurrah",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-day-18.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللَّهُمَّ لَكَ الْحَمْدُ كَمَا حَمِدْتَ نَفْسَكَ"
  },
  {
   "segment_id": 2,
   "arabic": "وَ أَفْضَلَ مَا حَمِدَكَ الْحَامِدُونَ مِنْ خَلْقِكَ"
  },
  {
   "segment_id": 3,
   "arabic": "حَمْداً يَكُونُ أَرْضَى الْحَمْدِ لَكَ"
  },
  {
   "segment_id": 4,
   "arabic": "وَ أَحَقَّ الْحَمْدِ عِنْدَكَ"
  },
  {
   "segment_id": 5,
   "arabic": "وَ أَحَبَّ الْحَمْدِ إِلَيْكَ"
  },
  {
   "segment_id": 6,
   "arabic": "وَ أَفْضَلَ الْحَمْدِ لَدَيْكَ"
  },
  {
   "segment_id": 7,
   "arabic": "وَ أَقْرَبَ الْحَمْدِ مِنْكَ"
  },
  {
   "segment_id": 8,
   "arabic": "وَ أَوْجَبَ الْحَمْدِ جَزَاءً عَلَيْكَ"
  },
  {
   "segment_id": 9,
   "arabic": "حَمْداً لَا يَبْلُغُهُ وَصْفُ وَاصِفٍ"
  },
  {
   "segment_id": 10,
   "arabic": "وَ لَا يُدْرِكُهُ نَعْتُ نَاعِتٍ"
  },
  {
   "segment_id": 11,
   "arabic": "وَ لَا وَهْمُ مُتَوَهِّمٍ"
  },
  {
   "segment_id": 12,
   "arabic": "وَ لَا فِكْرُ مُتَفَكِّرٍ"
  },
  {
   "segment_id": 13,
   "arabic": "حَمْداً يَضْعُفُ عَنْهُ كُلُّ أَحَدٍ"
  },
  {
   "segment_id": 14,
   "arabic": "مِمَّنْ فِي السَّمَاوَاتِ وَ الْأَرَضِينَ"
  },
  {
   "segment_id": 15,
   "arabic": "وَ يَقْصُرُ عَنْهُ وَ عَنْ حُدُودِهِ وَ مُنْتَهَاهُ"
  },
  {
   "segment_id": 16,
   "arabic": "جَمِيعُ الْمَعْصُومِينَ الْمُؤَيَّدِينَ"
  },
  {
   "segment_id": 17,
   "arabic": "الَّذِينَ أَخَذْتَ مِيثَاقَهُمْ فِي كِتَابِكَ"
  },
  {
   "segment_id": 18,
   "arabic": "حَمْداً يَنْبَغِي لَكَ وَ يَدُومُ مَعَكَ"
  },
  {
   "segment_id": 19,
   "arabic": "وَ لَا يَصْلُحُ إِلَّا لَكَ"
  },
  {
   "segment_id": 20,
   "arabic": "حَمْداً يَعْلُو حَمْدَ كُلِّ حَامِدٍ"
  },
  {
   "segment_id": 21,
   "arabic": "وَ شُكْراً يُحِيطُ بِشُكْرِ كُلِّ شَاكِرٍ"
  },
  {
   "segment_id": 22,
   "arabic": "حَمْداً يَبْقَى مَعَ بَقَائِكَ"
  },
  {
   "segment_id": 23,
   "arabic": "وَ يَزِيدُ إِذَا رَضِيتَ"
  },
  {
   "segment_id": 24,
   "arabic": "وَ يَنْمِي كُلَّمَا شِئْتَ"
  },
  {
   "segment_id": 25,
   "arabic": "حَمْداً خَالِداً مَعَ خُلُودِكَ"
  },
  {
   "segment_id": 26,
   "arabic": "وَ دَائِماً مَعَ دَوَامِكَ"
  },
  {
   "segment_id": 27,
   "arabic": "كَمَا فَضَّلْتَنَا عَلَى كَثِيرٍ مِنْ خَلْقِكَ"
  },
  {
   "segment_id": 28,
   "arabic": "وَ لِمَا وَهَبْتَ مِنْ مَعْرِفَتِكَ"
  },
  {
   "segment_id": 29,
   "arabic": "وَ صِيَامِ شَهْرِ رَمَضَانَ"
  },
  {
   "segment_id": 30,
   "arabic": "اللَّهُمَّ إِنِّي أَسْأَلُكَ بِمَقَامِ مُحَمَّدٍ"
  },
  {
   "segment_id": 31,
   "arabic": "وَ بِمَقَامِ أَنْبِيَائِكَ عَلَيْهِ وَ عَلَيْهِمُ السَّلَامُ"
  },
  {
   "segment_id": 32,
   "arabic": "أَنْ تُصَلِّيَ عَلَى مُحَمَّدٍ وَ آلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 33,
   "arabic": "وَ تَقَبَّلَ صَوْمِي"
  },
  {
   "segment_id": 34,
   "arabic": "وَ تَصْرِفَ إِلَيَّ وَ إِلَى أَهْلِي"
  },
  {
   "segment_id": 35,
   "arabic": "وَ وُلْدِي وَ أَهْلِ بَيْتِي وَ مَنْ يَعْنِينِي أَمْرُهُ"
  },
  {
   "segment_id": 36,
   "arabic": "وَ إِلَى جَمِيعِ الْمُؤْمِنِينَ وَ الْمُؤْمِنَاتِ"
  },
  {
   "segment_id": 37,
   "arabic": "مِنْ فَضْلِكَ وَ رَحْمَتِكَ وَ عَافِيَتِكَ"
  },
  {
   "segment_id": 38,
   "arabic": "وَ نِعَمِكَ وَ رِزْقِكَ الْهَنِي‌ءِ الْمَرِي‌ءِ"
  },
  {
   "segment_id": 39,
   "arabic": "مَا تَجْعَلُهُ صَلَاحاً لِدِينِنَا"
  },
  {
   "segment_id": 40,
   "arabic": "وَ قَوَاماً لِآخِرَتِنَا"
  }
 ]
}