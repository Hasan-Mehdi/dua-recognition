{
 "dua_id": "sahifa-30",
 "dua_name_en": "Sahifa 30: his supplication for help in repaying debts",
 "dua_name_ar": "دُعَاؤُهُ فِي الْمَعُونَةِ عَلَى قَضَاءِ الدَّيْنِ",
 "source": "https://duas.pro/30-his-supplication-for-help-in-repaying-debts",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "أَللَّهُمَّ صَلِّ عَلَى مُحَمَّد وَآلِهِ"
  },
  {
   "segment_id": 2,
   "arabic": "وَهَبْ لِيَ الْعَافِيَةَ مِنْ دَيْن تُخْلِقُ بِهِ وَجْهِي،"
  },
  {
   "segment_id": 3,
   "arabic": "وَيَحَارُ فِيهِ ذِهْنِي، وَيَتَشَعَّبُ لَهُ فِكْرِي،"
  },
  {
   "segment_id": 4,
   "arabic": "وَيَطُولُ بِمُمَارَسَتِهِ شُغْلِي،"
  },
  {
   "segment_id": 5,
   "arabic": "وَأَعُوذُ بِكَ يَا رَبِّ مِنْ هَمِّ الدَّيْنِ وَفِكْرِهِ،"
  },
  {
   "segment_id": 6,
   "arabic": "وَشُغْلِ الدَّيْنِ وَسَهَرِهِ."
  },
  {
   "segment_id": 7,
   "arabic": "فَصَلِّ عَلَى مُحَمَّد وَآلِهِ وَأَعِذْنِي مِنْهُ."
  },
  {
   "segment_id": 8,
   "arabic": "وَأَسْتَجيرُ بِكَ يَا رَبِّ مِنْ ذِلَّتِهِ فِي الْحَيَاةِ"
  },
  {
   "segment_id": 9,
   "arabic": "وَمِنْ تَبِعَتِهِ بَعْدَ الْوَفَاةِ."
  },
  {
   "segment_id": 10,
   "arabic": "فَصَلِّ عَلَى مُحَمَّد وَآلِهِ وَأَجِرْنِي مِنْهُ"
  },
  {
   "segment_id": 11,
   "arabic": "بِوُسْع فاضِل أَوْ كَفَاف وَاصِل."
  },
  {
   "segment_id": 12,
   "arabic": "أَللَّهُمَّ صَلِّ عَلَى مُحَمَّد وَآلِـهِ"
  },
  {
   "segment_id": 13,
   "arabic": "وَاحْجُبْنِي عَنِ السَّرَفِ وَالازْدِيَادِ،"
  },
  {
   "segment_id": 14,
   "arabic": "وَقَوِّمْنِي بِالْبَذْلِ وَالاقْتِصَـادِ،"
  },
  {
   "segment_id": 15,
   "arabic": "وَعَلِّمْنِي حُسْنَ التَّقْدِيرِ،"
  },
  {
   "segment_id": 16,
   "arabic": "وَاقْبِضْنِي بِلُطْفِكَ عَنِ التَّبْذِيرِ"
  },
  {
   "segment_id": 17,
   "arabic": "وَأَجْرِ مِنْ أَسْبَابِ الْحَلاَلِ أَرْزَاقِي،"
  },
  {
   "segment_id": 18,
   "arabic": "وَوَجِّهْ فِي أَبْوَابِ الْبِرِّ إنْفَاقِي،"
  },
  {
   "segment_id": 19,
   "arabic": "وَازْوِ عَنِّي مِنَ الْمَالِ مَا يُحْدِثُ لِي مَخِيلَةً"
  },
  {
   "segment_id": 20,
   "arabic": "أَوْ تَأَدِّياً إلَى بَغْي، أَوْ مَا أَتَعَقَّبُ مِنْهُ طُغْيَـاناً."
  },
  {
   "segment_id": 21,
   "arabic": "أَللَّهُمَّ حَبِّبْ إلَيَّ صُحْبَـةَ الْفُقَرَاءِ،"
  },
  {
   "segment_id": 22,
   "arabic": "وَأَعِنِّي عَلَى صُحْبَتِهِمْ بِحُسْنِ الْصَّبْرِ،"
  },
  {
   "segment_id": 23,
   "arabic": "وَمَـا زَوَيْتَ عَنِّي مِنْ مَتَاعِ الدُّنْيَاالفَانِيَةِ"
  },
  {
   "segment_id": 24,
   "arabic": "فَاذْخَرْهُ لِيْ فِي خَزَائِنِكَ البَاقِيَةِ،"
  },
  {
   "segment_id": 25,
   "arabic": "وَاجْعَلْ مَا خَوَّلْتَنِي مِنْ حُطَامِهَا،"
  },
  {
   "segment_id": 26,
   "arabic": "وَعَجَّلْتَ لِي مِنْ مَتَاعِهَا بُلْغَةً إلَى جِوَارِكَ،"
  },
  {
   "segment_id": 27,
   "arabic": "وَوُصْلَةً إلَى قُرْبِكَ، وَذَرِيعَةً إلَى جَنَّتِكَ"
  },
  {
   "segment_id": 28,
   "arabic": "إنَّكَ ذو الْفَضْلِ الْعَظِيمِ،"
  },
  {
   "segment_id": 29,
   "arabic": "وَأَنْتَ الْجَوَادُ الْكَرِيْمُ."
  }
 ]
}