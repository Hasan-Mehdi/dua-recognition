{
 "dua_id": "duasorg-ramadan-amaal-dua-first-day-2",
 "dua_name_en": "Dua after Fajr - First Ramadan",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-amaal-dua-first-day.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللَّهُمَّ قَدْ حَضَرَ شَهْرُ رَمَضَانَ"
  },
  {
   "segment_id": 2,
   "arabic": "وَقَدِ ٱفْتَرضْتَ عَلَيْنَا صِيَامَهُ"
  },
  {
   "segment_id": 3,
   "arabic": "وَأَنْزَلْتَ فِيهِ ٱلْقُرْآنَ"
  },
  {
   "segment_id": 4,
   "arabic": "هُدَىً لِلنَّاسِ وَبَيِّنَاتٍ مِنَ ٱلْهُدَىٰ وَٱلْفُرْقَانِ"
  },
  {
   "segment_id": 5,
   "arabic": "اللَّهُمَّ أَعِنَّا عَلَىٰ صِيَامِهِ"
  },
  {
   "segment_id": 6,
   "arabic": "وَتَقَبَّلْهُ مِنَّا"
  },
  {
   "segment_id": 7,
   "arabic": "وَتَسَلَّمْهُ مِنا"
  },
  {
   "segment_id": 8,
   "arabic": "وَسَلِّمْهُ لَنَا فِي يُسْرٍ مِنْكَ وَعَافِيَةٍ"
  },
  {
   "segment_id": 9,
   "arabic": "إِنَّكَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ"
  }
 ]
}