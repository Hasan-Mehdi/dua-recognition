   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا صِرَاطَ ٱللَّهِ"
  },
  {
   "segment_id": 11,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا بَيَانَ حُكْمِ ٱللَّهِ"
  },
  {
   "segment_id": 12,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا نَاصِرَ دِينِ ٱللَّهِ"
  },
  {
   "segment_id": 13,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ ايُّهَا ٱلسَّيِدُ ٱلزَّكِيُّ"
  },
  {
   "segment_id": 14,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ ايُّهَا ٱلْبَرُّ ٱلْوَفِيُّ"
  },
  {
   "segment_id": 15,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ ايُّهَا ٱلْقَائِمُ ٱلامِينُ"
  },
  {
   "segment_id": 16,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ ايُّهَا ٱلْعَالِمُ بِٱلتَّاوِيلِ"
  },
  {
   "segment_id": 17,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ ايُّهَا ٱلْهَادِي ٱلْمَهْدِيُّ"
  },
  {
   "segment_id": 18,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ ايُّهَا ٱلطَّاهِرُ ٱلزَّكِيُّ"
  },
  {
   "segment_id": 19,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ ايُّهَا ٱلتَّقِيُّ ٱلنَّقِيُّ"
  },
  {
   "segment_id": 20,
   "arabic": "السَّلاَمُ عَلَيْكَ ايُّهَا ٱلْحَقُّ ٱلْحَقِيقُ"
  },
  {
   "segment_id": 21,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ ايُّهَا ٱلشَّهِيدُ ٱلصِّدِّيقُ"
  },
  {
   "segment_id": 22,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا ابَا مُحَمَّدٍ ٱلْحَسَنَ بْنَ عَلِيٍّ"
  },
  {
   "segment_id": 23,
   "arabic": "وَرَحْمَةُ ٱللَّهِ وَبَرَكَاتُهُ"
  },
  {
   "segment_id": 24,
   "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمٰنِ ٱلرَّحِيمِ"
  },
  {
   "segment_id": 25,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا بْنَ رَسُولِ ٱللَّهِ"
  },
  {
   "segment_id": 26,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا بْنَ امِيرِ ٱلْمُؤْمِنِينَ"
  },
  {
   "segment_id": 27,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا بْنَ سَيِّدَةِ نِسَاءِ ٱلْعَالَمِينَ"
  },
  {
   "segment_id": 28,
   "arabic": "اشْهَدُ انَّكَ اقَمْتَ ٱلصَّلاَةَ"
  },
  {
   "segment_id": 29,
   "arabic": "وَآتَيْتَ ٱلزَّكَاةَ"
  },
  {
   "segment_id": 30,
   "arabic": "وَامَرْتَ بِٱلْمَعْرُوفِ"
  },
  {
   "segment_id": 31,
   "arabic": "وَنَهَيْتَ عَنِ ٱلْمُنْكَرِ"
  },
  {
   "segment_id": 32,
   "arabic": "وَعَبَدْتَ ٱللَّهَ مُخْلِصاً"
  },
  {
   "segment_id": 33,
   "arabic": "وَجَاهَدْتَ فِي ٱللَّهِ حَقَّ جِهَادِهِ"
  },
  {
   "segment_id": 34,
   "arabic": "حَتَّىٰ اتَاكَ ٱلْيَقِينُ"
  },
  {
   "segment_id": 35,
   "arabic": "فَعَلَيْكَ ٱلسَّلاَمُ مِنِّي"
  },
  {
   "segment_id": 36,
   "arabic": "مَا بَقِيتُ وَبَقِيَ ٱللَّيْلُ وَٱلنَّهَارُ"
  },
  {
   "segment_id": 37,
   "arabic": "وَعَلَىٰ آلِ بَيْتِكَ ٱلطَّيِّبِينَ ٱلطَّاهِرِينَ"
  },
  {
   "segment_id": 38,
   "arabic": "انَا يَا مَوْلاَيَ مَوْلىٰ لَكَ وَلآِلِ بَيْتِكَ"
  },
  {
   "segment_id": 39,
   "arabic": "سِلْمٌ لِمَنْ سَالَمَكُمْ"
  },
  {
   "segment_id": 40,
   "arabic": "وَحَرْبٌ لِمَنْ حَارَبَكُمْ"
  },
  {
   "segment_id": 41,
   "arabic": "مُؤْمِنٌ بِسِرِّكُمْ وَجَهْرِكُمْ"
  },
  {
   "segment_id": 42,
   "arabic": "وَظَاهِرِكُمْ وَبَاطِنِكُمْ"
  },
  {
   "segment_id": 43,
   "arabic": "لَعَنَ ٱللَّهُ اعْدَاءَكُمْ"
  },
  {
   "segment_id": 44,
   "arabic": "مِنَ ٱلاوَّلينَ وَٱلآخِرِينَ"
  },
  {
   "segment_id": 45,
   "arabic": "وَانَا ابْرَا إِلَىٰ ٱللَّهِ تَعَالَىٰ مِنْهُمْ"
  },
  {
   "segment_id": 46,
   "arabic": "يَا مَوْلاَيَ يَا ابَا مُحَمَّدٍ"
  },
  {
   "segment_id": 47,
   "arabic": "يَا مَوْلاَيَ يَا ابَا عَبْدِ ٱللَّهِ"
  },
  {
   "segment_id": 48,
   "arabic": "هٰذَا يَوْمُ ٱلإِثْنَيْنِ"
  },
  {
   "segment_id": 49,
   "arabic": "وَهُوَ يَوْمُكُمَا وَبِٱسْمِكُمَا"
  },
  {
   "segment_id": 50,
   "arabic": "وَانَا فِيهِ ضَيْفُكُمَا"
  },
  {
   "segment_id": 51,
   "arabic": "فَاضِيفَانِي وَاحْسِنَا ضِيَافَتِي"
  },
  {
   "segment_id": 52,
   "arabic": "فَنِعْمَ مَنِ ٱسْتُضِيفَ بِهِ انْتُمَا"
  },
  {
   "segment_id": 53,
   "arabic": "وَانَا فِيهِ مِنْ جِوَارِكُمَا فَاجِيرَانِي"
  },
  {
   "segment_id": 54,
   "arabic": "فَإنَّكُمَا مَامُورَانِ بِٱلضِّيَافَةِ وَٱلإِجَارَةِ"
  },
  {
   "segment_id": 55,
   "arabic": "فَصَلَّىٰ ٱللَّهُ عَلَيْكُمَا وَآلِكُمَا ٱلطَّيِّبِينَ"
  }
 ]
}