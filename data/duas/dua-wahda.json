{
 "dua_id": "dua-wahda",
 "dua_name_en": "Dua Wahda",
 "dua_name_ar": "دعاء وحدة",
 "source": "https://www.duaplayer.org/en/dua/wahda",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللهِ الرَّحْمنِ الرَّحيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "لاَ إِلهَ إِلاّﷲُ"
  },
  {
   "segment_id": 3,
   "arabic": "إِلهاً وَاحِداً وَ نَحْنُ لَهُ مُسْلِمُونَ."
  },
  {
   "segment_id": 4,
   "arabic": "لاَ إِلهَ إِلاّﷲُ"
  },
  {
   "segment_id": 5,
   "arabic": "وَلاَ نَعْبُدُ إِلاَّ إِيَّاهُ،"
  },
  {
   "segment_id": 6,
   "arabic": "مُخْلِصِينَ لَهُ الدَّينَ"
  },
  {
   "segment_id": 7,
   "arabic": "وَ لَوْ كَرِهَ الْمُشْرِكُونَ."
  },
  {
   "segment_id": 8,
   "arabic": "لاَ إِلهَ إِلاّﷲُ"
  },
  {
   "segment_id": 9,
   "arabic": "رَبُّنَا وَرَبُّ آبائِنَا الأَوَّلِينَ."
  },
  {
   "segment_id": 10,
   "arabic": "لاَ إِلهَ إِلاّﷲُ"
  },
  {
   "segment_id": 11,
   "arabic": "وَحْدَهُ وَحْدَهُ وَحْدَهُ،"
  },
  {
   "segment_id": 12,
   "arabic": "أَنْجَزَ وَعْدَهُ،"
  },
  {
   "segment_id": 13,
   "arabic": "وَ نَصَرَعَبْدَهُ،"
  },
  {
   "segment_id": 14,
   "arabic": "وَأَعَزَّ جُنْدَهُ."
  },
  {
   "segment_id": 15,
   "arabic": "وَ هَزَمَ الأَحْزَابَ وَحْدَهُ،"
  },
  {
   "segment_id": 16,
   "arabic": "فَلَهُ الْمُلْكُ، وَلَهُ الْحَمْدُ."
  },
  {
   "segment_id": 17,
   "arabic": "يُحْيِي وَيُمِيتُ"
  },
  {
   "segment_id": 18,
   "arabic": "وَيُمِيتُ وَيُحْيِي."
  },
  {
   "segment_id": 19,
   "arabic": "وَهُوَ حَيٌّ لاَ يَمُوتُ،"
  },
  {
   "segment_id": 20,
   "arabic": "بِيَدِهِ الْخَيْرُ"
  },
  {
   "segment_id": 21,
   "arabic": "وَهُوَعَلَى كُلِّ شَيْءٍ قَدِيرٌ"
  },
  {
   "segment_id": 22,
   "arabic": "اللّهُمّ صَلّ عَلَى مُحَمّدٍ وَآلِ مُحَمّد"
  }
 ]
}