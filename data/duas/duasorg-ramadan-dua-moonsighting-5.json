{
 "dua_id": "duasorg-ramadan-dua-moonsighting-5",
 "dua_name_en": "Syeda Fatima (sa) Dua - Ramadan Moonsighting",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-dua-moonsighting.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "رَبُّنَا وَ رَبُّكَ اللَّهُ رَبُّ الْعَالَمِينَ"
  },
  {
   "segment_id": 2,
   "arabic": "اللَّهُمَّ اجْعَلْهُ عَلَيْنَا هلالاً مُبَارَكًا،"
  },
  {
   "segment_id": 3,
   "arabic": "وَ وَفِّقْنَا لِصِيَامٍ شَهْرِ رَمَضَانَ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَ وَ سَلِّمُنَا فِيهِ، وَ تَسَلَّمْنَا مِنْهُ،"
  },
  {
   "segment_id": 5,
   "arabic": "فِي يُسْرٍ وَ عَافِيَةٍ،"
  },
  {
   "segment_id": 6,
   "arabic": "وَ اسْتَعْمِلُنَا فِيهِ بِطَاعَتِكَ،"
  },
  {
   "segment_id": 7,
   "arabic": "إِنَّكَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ"
  }
 ]
}