{
 "dua_id": "duasorg-sahifa-fatimiya-dua-hareeq-ater-fajr-2",
 "dua_name_en": "Instruction Block",
 "dua_name_ar": "",
 "source": "https://www.duas.org/sahifa-fatimiya-dua-hareeq-ater-fajr.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "لا إِلهَ إِلَّا اللهُ وَحْدَهُ لا شَريكَ لَهُ"
  },
  {
   "segment_id": 2,
   "arabic": "سُبْحانَ اللهِ وَبِحَمْدِهِ"
  },
  {
   "segment_id": 3,
   "arabic": "أَسْتَغْفِرُ اللهَ وَأَتُوبُ إِلَيْهِ"
  },
  {
   "segment_id": 4,
   "arabic": "ما شاءَ اللهُ وَلا قُوَّةَ إِلّا بِاللهِ"
  },
  {
   "segment_id": 5,
   "arabic": "هُوَ الْأَوَّلُ وَالْآخِرُ وَالظَّاهِرُ وَالْباطِنُ"
  },
  {
   "segment_id": 6,
   "arabic": "لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ"
  },
  {
   "segment_id": 7,
   "arabic": "يُحْيي وَيُميتُ وَيُميتُ وَيُحْيي"
  },
  {
   "segment_id": 8,
   "arabic": "وَهُوَ حَيٌّ لايَمُوتُ بِيَدِهِ الْخَيْرُ"
  },
  {
   "segment_id": 9,
   "arabic": "وَهُوَ عَلى كُلِّ شَيْءٍ قَديرٌ"
  }
 ]
}