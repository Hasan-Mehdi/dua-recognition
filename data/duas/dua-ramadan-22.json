{
 "dua_id": "dua-ramadan-22",
 "dua_name_en": "Day 22",
 "dua_name_ar": " شهر رمضان ٢٢  ",
 "source": "https://www.duaplayer.org/en/dua/ramadan-22",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "اللّهُمّ افْتَحْ لِي فِيهِ أَبْوَابَ فَضْلِكَ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَأَنْزِلْ عَلَيّ فِيهِ بَرَكَاتِكَ،"
  },
  {
   "segment_id": 5,
   "arabic": "وَوَفّقْنِي فِيهِ لِمُوجِبَاتِ مَرْضَاتِكَ،"
  },
  {
   "segment_id": 6,
   "arabic": "وَ أَسْكِنّي فِيهِ بُحْبُوحَاتِ جَنَّاتِكَ،"
  },
  {
   "segment_id": 7,
   "arabic": "يَا مُجِيبَ دَعْوَةِ المُضْطَرّينَ."
  }
 ]
}