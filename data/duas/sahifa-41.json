{
 "dua_id": "sahifa-41",
 "dua_name_en": "Sahifa 41: His supplication in asking for covering and protection",
 "dua_name_ar": "دُعَاؤُهُ فِي طَلَبِ السَّتْرِ وَ الْوِقَايَةِ",
 "source": "https://duas.pro/41-his-supplication-in-asking-for-covering-and-protection",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "أَللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 2,
   "arabic": "وَأَفْرِشْنِي مِهَادَ كَرَامَتِكَ"
  },
  {
   "segment_id": 3,
   "arabic": "وَأَوْرِدْنِي مَشَارِعَ رَحْمَتِكَ"
  },
  {
   "segment_id": 4,
   "arabic": "وَأَحْلِلْنِي بُحْبُوحَةَ جَنَّتِكَ"
  },
  {
   "segment_id": 5,
   "arabic": "وَلَا تَسُمْنِي بِالرَّدِّ عَنْكَ"
  },
  {
   "segment_id": 6,
   "arabic": "وَلَا تَحْرِمْنِي بِالْخَيْبَةِ مِنْكَ"
  },
  {
   "segment_id": 7,
   "arabic": "وَلَا تُقَاصَّنِي بِمَا اجْتَرَحْتُ"
  },
  {
   "segment_id": 8,
   "arabic": "وَلَا تُنَاقِشْنِي بِمَا اكْتَسَبْتُ"
  },
  {
   "segment_id": 9,
   "arabic": "وَلَا تُبْرِزْ مَكْتُومِي، وَلَا تَكْشِفْ مَسْتُورِي"
  },
  {
   "segment_id": 10,
   "arabic": "وَلَا تَحْمِلْ عَلَى مِيزَانِ الْأَنْصَافِ عَمَلِي"
  },
  {
   "segment_id": 11,
   "arabic": "وَلَا تُعْلِنْ عَلَى عُيُونِ الْمَلَاءِ خَبَرِي"
  },
  {
   "segment_id": 12,
   "arabic": "أَخْفِ عَنْهُمْ مَا يَكُونُ نَشْرُهُ عَلَيَّ عَارًا"
  },
  {
   "segment_id": 13,
   "arabic": "وَاطْوِ عَنْهُمْ مَا يُلْحِقُنِي عِندَكَ شَنَارًا"
  },
  {
   "segment_id": 14,
   "arabic": "شَرِّفْ دَرَجَتِي بِرِضْوَانِكَ"
  },
  {
   "segment_id": 15,
   "arabic": "وَأَكْمِلْ كَرَامَتِي بِغُفْرَانِكَ"
  },
  {
   "segment_id": 16,
   "arabic": "وَانْظِمْنِي فِي أَصْحَابِ الْيَمِينِ"
  },
  {
   "segment_id": 17,
   "arabic": "وَوَجِّهْنِي فِي مَسَالِكِ الْآمِنِينَ"
  },
  {
   "segment_id": 18,
   "arabic": "وَاجْعَلْنِي فِي فَوْجِ الْفَائِزِينَ"
  },
  {
   "segment_id": 19,
   "arabic": "وَاعْمُرْ بِي مَجَالِسَ الصَّالِحِينَ"
  },
  {
   "segment_id": 20,
   "arabic": "آمِينَ رَبَّ الْعَالَمِينَ"
  }
 ]
}