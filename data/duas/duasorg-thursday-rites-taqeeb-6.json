{
 "dua_id": "duasorg-thursday-rites-taqeeb-6",
 "dua_name_en": "last hours of Thursday - Dua",
 "dua_name_ar": "",
 "source": "https://www.duas.org/thursday-rites-taqeeb.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "أَسْتَغْفِرُ ٱللَّهَ الَّذِي لاَ إِلٰهَ إِلاَّ هُوَ"
  },
  {
   "segment_id": 2,
   "arabic": "ٱلْحَيُّ ٱلْقَيُّومُ"
  },
  {
   "segment_id": 3,
   "arabic": "وَأَتُوبُ إِلَيْهِ"
  },
  {
   "segment_id": 4,
   "arabic": "تَوْبَةَ عَبْدٍ خَاضِعٍ"
  },
  {
   "segment_id": 5,
   "arabic": "مِسْكِينٍ مُسْتَكِينٍ"
  },
  {
   "segment_id": 6,
   "arabic": "لاَ يَسْتَطيعُ لِنَفْسِهِ صَرْفاً وَلاَ عَدْلاً"
  },
  {
   "segment_id": 7,
   "arabic": "وَلاَ نَفْعاً وَلاَ ضَرّاً"
  },
  {
   "segment_id": 8,
   "arabic": "وَلاَ حَيَاةً وَلاَ مَوْتاً وَلاَ نُشُوراً"
  },
  {
   "segment_id": 9,
   "arabic": "وَصَلَّىٰ ٱللَّهُ عَلَىٰ مُحَمَّدٍ"
  },
  {
   "segment_id": 10,
   "arabic": "وَعِتْرَتِهِ ٱلطَّيِّبينَ ٱلطَّاهِرينَ"
  },
  {
   "segment_id": 11,
   "arabic": "ٱلْأَخْيَارِ ٱلْأَبْرَارِ"
  },
  {
   "segment_id": 12,
   "arabic": "وَسَلَّمَ تَسْليماً"
  },
  {
   "segment_id": 13,
   "arabic": "اَللَّهُمَّ إِنِّي أَسْأَلُكَ بِوَجْهِكَ ٱلْكَريمِ"
  },
  {
   "segment_id": 14,
   "arabic": "وَٱسْمِكَ ٱلْعَظيمِ"
  },
  {
   "segment_id": 15,
   "arabic": "أَنْ تُصَلِّيَ عَلَىٰ مُحَمَّد وَآلِهِ"
  },
  {
   "segment_id": 16,
   "arabic": "وَأَنْ تَغْفِرَ لِي ذَنْبِيَ ٱلْعَظيمَ"
  }
 ]
}