{
 "dua_id": "sahifa-24",
 "dua_name_en": "Sahifa 24: his prayer for parents",
 "dua_name_ar": "دُعَاؤُهُ لِأَبَوَيْهِ",
 "source": "https://duas.pro/24-his-prayer-for-parents",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللَّهُمَّ صَلِّ عَلَى مُحَمَّد عَبْـدِكَ وَرَسُولِـكَ"
  },
  {
   "segment_id": 2,
   "arabic": "وَأَهْلِ بَيْتِهِ الطَّاهِرِينَ،"
  },
  {
   "segment_id": 3,
   "arabic": "وَاخْصُصْهُمْ بِأَفْضَلِ صَلَوَاتِكَ وَرَحْمَتِكَ"
  },
  {
   "segment_id": 4,
   "arabic": "وَبَرَكَاتِكَ وَسَلاَمِكَ،"
  },
  {
   "segment_id": 5,
   "arabic": "وَاخْصُصِ اللَّهُمَّ وَالِدَيَّ بِالْكَرَامَةِ لَدَيْكَ،"
  },
  {
   "segment_id": 6,
   "arabic": "وَالصَّلاَةِ مِنْكَ يَا أَرْحَمَ الرَّاحِمِينَ."
  },
  {
   "segment_id": 7,
   "arabic": "أللَّهُمَّ صَلِّ عَلَى مُحَمَّد وَآلِهِ"
  },
  {
   "segment_id": 8,
   "arabic": "وَأَلْهِمْنِي عِلْمَ مَا يَجبُ لَهُمَا عَلَىَّ إلْهَاماً،"
  },
  {
   "segment_id": 9,
   "arabic": "وَاجْمَعْ لِي عِلْمَ ذلِكَ كُلِّهِ تَمَامـاً،"
  },
  {
   "segment_id": 10,
   "arabic": "ثُمَّ اسْتَعْمِلْنِي بِمَا تُلْهِمُنِي مِنْـهُ،"
  },
  {
   "segment_id": 11,
   "arabic": "وَوَفِّقْنِي لِلنُّفُوذِ فِيمَا تُبَصِّـرُنِيْ مِنْ عِلْمِهِ،"
  },
  {
   "segment_id": 12,
   "arabic": "حَتَّى لاَ يَفُوتَنِي اسْتِعْمَالُ شَيْء عَلَّمْتَنِيْهِ،"
  },
  {
   "segment_id": 13,
   "arabic": "وَلاَ تَثْقُلَ أَرْكَانِي عَنِ الْحُفُوفِ فِيمَا أَلْهَمْتَنِيهِ."
  },
  {
   "segment_id": 14,
   "arabic": "أللَّهُمَّ صَلِّ عَلَى مُحَمَّد وَآلِهِ كَمَا شَرَّفْتَنَا بِهِ"
  },
  {
   "segment_id": 15,
   "arabic": "وَصَلِّ عَلَى مُحَمَّد وَآلِهِ"
  },
  {
   "segment_id": 16,
   "arabic": "كَمَا أَوْجَبْتَ لَنَا الْحَقَّ عَلَى الْخَلْقِ بِسَبَبِهِ."
  },
  {
   "segment_id": 17,
   "arabic": "أللَّهُمَّ اجْعَلْنِي أَهَابُهُمَا هَيْبَةَ السُّلْطَانِ الْعَسُوفِ،"
  },
  {
   "segment_id": 18,
   "arabic": "وَأَبَرُّهُمَا بِرَّ الأُمِّ الرَّؤُوفِ،"
  },
  {
   "segment_id": 19,
   "arabic": "وَاجْعَلْ طَاعَتِي لِوَالِدَيَّ وَبِرِّيْ بِهِمَا"
  },
  {
   "segment_id": 20,
   "arabic": "أَقَرَّ لِعَيْنِي مِنْ رَقْدَةِ الْوَسْنَانِ،"
  },
  {
   "segment_id": 21,
   "arabic": "وَأَثْلَجَ لِصَدْرِي مِنْ شَرْبَةِ الظَّمْآنِ"
  },
  {
   "segment_id": 22,
   "arabic": "حَتَّى أوثِرَ عَلَى هَوَايَ هَوَاهُمَا"
  },
  {
   "segment_id": 23,
   "arabic": "وَأُقَدِّمَ عَلَى رِضَاىَ رِضَاهُمَا"
  },
  {
   "segment_id": 24,
   "arabic": "وَأَسْتَكْثِرَ بِرَّهُمَا بِي وَإنْ قَلَّ"
  },
  {
   "segment_id": 25,
   "arabic": "وَأَسْتَقِلَّ بِرِّي بِهِمَا وَإنْ كَثُرَ."
  },
  {
   "segment_id": 26,
   "arabic": "أللَّهُمَّ خَفِّضْ لَهُمَا صَوْتِي، وَأَطِبْ لَهُمَا كَلاَمِي،"
  },
  {
   "segment_id": 27,
   "arabic": "وَأَلِنْ لَهُمَا عَرِيْكَتِي، وَاعْطِفْ عَلَيْهِمَا قَلْبِي،"
  },
  {
   "segment_id": 28,
   "arabic": "وَصَيِّرْنِي بِهِمَا رَفِيقاً، وَعَلَيْهِمَا شَفِيقاً."
  },
  {
   "segment_id": 29,
   "arabic": "أللَّهُمَّ اشْكُرْ لَهُمَا تَرْبِيَتِي وَأَثِبْهُمَا عَلَى تَكْرِمَتِي،"
  },
  {
   "segment_id": 30,
   "arabic": "وَاحْفَظْ لَهُمَا مَا حَفِظَاهُ مِنِّي فِي صِغَرِي."
  },
  {
   "segment_id": 31,
   "arabic": "اللَّهُمَّ وَمَا مَسَّهُمَا مِنِّي مِنْ أَذَىً"
  },
  {
   "segment_id": 32,
   "arabic": "أَوْ خَلَصَ إلَيْهِمَا عَنِّي مِنْ مَكْرُوه"
  },
  {
   "segment_id": 33,
   "arabic": "أَوْ ضَاعَ قِبَلِي لَهُمَا مِنْ حَقٍّ"
  },
  {
   "segment_id": 34,
   "arabic": "فَاجْعَلْهُ حِطَّةً لِذُنُوبِهِمَا"
  },
  {
   "segment_id": 35,
   "arabic": "وَعُلُوّاً فِي دَرَجَاتِهِمَا"
  },
  {
   "segment_id": 36,
   "arabic": "وَزِيَادَةً فِي حَسَنَاتِهِمَا"
  },
  {
   "segment_id": 37,
   "arabic": "يَا مُبَدِّلَ السَّيِّئاتِ بِأَضْعَافِهَا مِنَ الْحَسَنَاتِ."
  },
  {
   "segment_id": 38,
   "arabic": "أللَّهُمَّ وَمَا تَعَدَّيَا عَلَيَّ فِيهِ مِنْ قَوْل،"
  },
  {
   "segment_id": 39,
   "arabic": "أَوْ أَسْرَفَا عَلَىَّ فِيْهِ مِنْ فِعْل،"
  },
  {
   "segment_id": 40,
   "arabic": "أَوْ ضَيَّعَاهُ لِي مِنْ حَقٍّ"
  },
  {
   "segment_id": 41,
   "arabic": "أَوْ قَصَّرا بِي عَنْهُ مِنْ وَاجِب"
  },
  {
   "segment_id": 42,
   "arabic": "فَقَدْ وَهَبْتُهُ وَجُدْتُ بِهِ عَلَيْهِمَا،"
  },
  {
   "segment_id": 43,
   "arabic": "وَرَغِبْتُ إلَيْكَ فِي وَضْعِ تَبِعَتِهِ عَنْهُمَا"
  },
  {
   "segment_id": 44,
   "arabic": "فَإنِّي لا أَتَّهِمُهُمَا عَلَى نَفْسِي،"
  },
  {
   "segment_id": 45,
   "arabic": "وَلاَ أَسْتَبْطِئُهُمَا فِي بِرِّي،"
  },
  {
   "segment_id": 46,
   "arabic": "وَلا أكْرَهُ مَا تَوَلَّياهُ مِنْ أَمْرِي يَا رَبِّ"
  },
  {
   "segment_id": 47,
   "arabic": "فَهُمَا أَوْجَبُ حَقّاً عَلَيَّ،"
  },
  {
   "segment_id": 48,
   "arabic": "وَأَقْدَمُ إحْسَانـاً إلَيَّ"
  },
  {
   "segment_id": 49,
   "arabic": "وَأَعْظَمُ مِنَّةً لَـدَيَّ"
  },
  {
   "segment_id": 50,
   "arabic": "مِنْ أَنْ أقَاصَّهُمَا بِعَدْل،"
  },
  {
   "segment_id": 51,
   "arabic": "أَوْ أُجَازِيَهُمَا عَلَى مِثْل،"
  },
  {
   "segment_id": 52,
   "arabic": "أَيْنَ إذاً يَا إلهِيْ طُولُ شُغْلِهِمَا بِتَرْبِيَتِي ؟"
  },
  {
   "segment_id": 53,
   "arabic": "وَأَيْنَ شِدَّةُ تَعَبِهِمَا فِي حِرَاسَتِيْ ؟"
  },
  {
   "segment_id": 54,
   "arabic": "وَأَيْنَ إقْتَارُهُمَا عَلَى أَنْفُسِهِمَا لِلتَّوْسِعَةِ عَلَيَّ؟"
  },
  {
   "segment_id": 55,
   "arabic": "هَيْهَاتَ مَا يَسْتَوْفِيَانِ مِنِّي حَقَّهُمَا،"
  },
  {
   "segment_id": 56,
   "arabic": "وَلاَ اُدْرِكُ مَا يَجِبُ عَلَيَّ لَهُمَا"
  },
  {
   "segment_id": 57,
   "arabic": "وَلا أَنَا بِقَاض وَظِيفَةَ خِدْمَتِهِمَا."
  },
  {
   "segment_id": 58,
   "arabic": "فَصَلِّ عَلَى مُحَمَّد وَآلِهِ"
  },
  {
   "segment_id": 59,
   "arabic": "وَأَعِنِّي يَا خَيْرَ مَنِ اسْتُعِينَ بِهِ."
  },
  {
   "segment_id": 60,
   "arabic": "وَوَفِّقْنِي يَا أَهْدَى مَنْ رُغِبَ إلَيْهِ،"
  },
  {
   "segment_id": 61,
   "arabic": "وَلاَ تَجْعَلْنِي فِي أَهْلِ الْعُقُوقِ لِلآباءِوَالأُمَّهاتِ"
  },
  {
   "segment_id": 62,
   "arabic": "يَوْمَ تُجْزى كُلُّ نَفْس بِمَا كَسَبَتْ وَهُمْ لاَيُظْلَمُونَ."
  },
  {
   "segment_id": 63,
   "arabic": "أللَّهُمَّ صَلِّ عَلَى مُحَمَّد وَآلِـهِ وَذُرِّيَّتِهِ،"
  },
  {
   "segment_id": 64,
   "arabic": "وَاخْصُصْ أَبَوَيَّ بِأَفْضَلِ مَا خَصَصْتَ بِهِ"
  },
  {
   "segment_id": 65,
   "arabic": "آبَاءَ عِبَادِكَ الْمُؤْمِنِينَ وَاُمَّهَاتِهِمْ يَا أَرْحَمَ الـرَّاحِمِينَ."
  },
  {
   "segment_id": 66,
   "arabic": "أللَّهُمَّ لاَ تُنْسِنِي ذِكْرَهُمَا فِي أَدْبَارِ صَلَوَاتِي"
  },
  {
   "segment_id": 67,
   "arabic": "وَفِي أَناً مِنْ آناءِ لَيْلِي،"
  },
  {
   "segment_id": 68,
   "arabic": "وَفِي كُلِّ سَاعَة مِنْ سَاعَاتِ نَهَارِي."
  },
  {
   "segment_id": 69,
   "arabic": "أللَّهُمَّ صَلِّ عَلَى مُحَمَّد وَآلِهِ"
  },
  {
   "segment_id": 70,
   "arabic": "وَاغْفِرْ لِي بِدُعَائِي لَهُمَا،"
  },
  {
   "segment_id": 71,
   "arabic": "وَاغْفِرْ لَهُمَـا بِبِرِّهِمَـا بِي،"
  },
  {
   "segment_id": 72,
   "arabic": "مَغْفِرَةً حَتْمـاً"
  },
  {
   "segment_id": 73,
   "arabic": "وَارْضَ عَنْهُمَا بِشَفَاعَتِي لَهُمَا رِضَىً عَزْماً،"
  },
  {
   "segment_id": 74,
   "arabic": "وَبَلِّغْهُمَا بِالْكَرَامَةِ مَوَاطِنَ السَّلاَمَةِ."
  },
  {
   "segment_id": 75,
   "arabic": "أللَّهُمَّ وَإنْ سَبَقَتْ مَغْفِرَتُكَ لَهُمَا فَشَفِّعْهُمَا فِيَّ،"
  },
  {
   "segment_id": 76,
   "arabic": "وَإنْ سَبَقَتْ مَغْفِرَتُـكَ لِي فَشَفِّعْنِي فِيْهِمَا،"
  },
  {
   "segment_id": 77,
   "arabic": "حَتّى نَجْتَمِعَ بِرَأفَتِكَ فِي دَارِ كَرَامَتِكَ"
  },
  {
   "segment_id": 78,
   "arabic": "وَمَحَلِّ مَغْفِرَتِكَ وَرَحْمَتِكَ،"
  },
  {
   "segment_id": 79,
   "arabic": "إنَّكَ ذُو الْفَضْلِ الْعَظِيمِ وَالْمَنِّ الْقَدِيْمِ"
  },
  {
   "segment_id": 80,
   "arabic": "وَأَنْتَ أَرْحَمُ الرَّاحِمِينَ."
  }
 ]
}