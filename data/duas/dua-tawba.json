{
 "dua_id": "dua-tawba",
 "dua_name_en": "Dua Tawba",
 "dua_name_ar": "دعـاؤه بالتـوبة",
 "source": "https://www.duaplayer.org/en/dua/tawba",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اللَّهُمَّ  يَا مَن لا يَصِفُهُ نَعْتُ الْوَاصِفِينَ"
  },
  {
   "segment_id": 3,
   "arabic": "وَيَا مَن لا يُجَاوِزُهُ رَجَاءُ الرَّاجِينَ"
  },
  {
   "segment_id": 4,
   "arabic": "وَيَا مَن لا يَضِيعُ لَديْهِ أَجْرُ الْمُحْسِنِينَ"
  },
  {
   "segment_id": 5,
   "arabic": "وَيَا مَنْ هُوَ مُنتَهَى خَوْفِ الْعَابِدِينَ"
  },
  {
   "segment_id": 6,
   "arabic": "وَيَا مَنْ هُوَ غَايَةُ خَشْيَةِ الْمُتَّقِينَ"
  },
  {
   "segment_id": 7,
   "arabic": "هَذَا مَقَامُ مَن تَدَاوَلَتْهُ أَيْدِي الذُّنُوبِ،"
  },
  {
   "segment_id": 8,
   "arabic": "وَقَادَتْهُ أَزِمَّةُ الْخَطَايَا،"
  },
  {
   "segment_id": 9,
   "arabic": "وَاسْتَحْوَذَ عَلَيْهِ الشَّيْطَانُ"
  },
  {
   "segment_id": 10,
   "arabic": "فَقَصَّرَ عَمَّا أَمَرْتَ بِهِ تَفْرِيطاً،"
  },
  {
   "segment_id": 11,
   "arabic": "وَتَعَاطَى مَا نَهَيْتَ عَنْهُ تَعْزِيراً،"
  },
  {
   "segment_id": 12,
   "arabic": "كَالْجَاهِلِ بِقُدْرَتِكَ عَلَيْهِ،"
  },
  {
   "segment_id": 13,
   "arabic": "أَوْ كَالْمُنكِرِ فَضْلِ إِحْسَانِكَ إِلَيْهِ"
  },
  {
   "segment_id": 14,
   "arabic": "حَتَّى إِذَا انفَتَحَ لَهُ بَصَرُ الْهُدَي،"
  },
  {
   "segment_id": 15,
   "arabic": "وَتَقَشَّعَتْ عَنهُ سَحَائِبُ العَمَي،"
  },
  {
   "segment_id": 16,
   "arabic": "أَحْصَى مَا ظَلَمَ بِهِ نَفْسَهُ،"
  },
  {
   "segment_id": 17,
   "arabic": "وَفَكَّرَ فِيمَا خَالَفَ فِيهِ رَبَّهُ"
  },
  {
   "segment_id": 18,
   "arabic": "فَرَأَى كَبِيرَ عِصْيَانِهِ كَبِيراً،"
  },
  {
   "segment_id": 19,
   "arabic": "وَجَلِيلَ مُخَالَفَتِهِ جَلِيلاً"
  },
  {
   "segment_id": 20,
   "arabic": "فَأَقْبَلَ نَحْوَكَ مُؤَمِّلاً لَّكَ،"
  },
  {
   "segment_id": 21,
   "arabic": "مُسْتَحْيِياً مِّنكَ،"
  },
  {
   "segment_id": 22,
   "arabic": "وَوَجَّهَ رَغْبَتَهُ إِلَيْكَ ثِقَةً بِكَ،"
  },
  {
   "segment_id": 23,
   "arabic": "فَأَمَّكَ بِطَبْعِهِ يَقِيناً،"
  },
  {
   "segment_id": 24,
   "arabic": "وَقَصَدَكَ بِخَوْفِهِ إِخْلاَصاً،"
  },
  {
   "segment_id": 25,
   "arabic": "قَدْ خَلاَ طَمَعُهُ مِن كُلِّ مَطْمُوعٍ فِيهِ غَيْرُكَ،"
  },
  {
   "segment_id": 26,
   "arabic": "وَأَفْرَجَ رَوْعُهُ مِن كُلِّ مَحْذُورٍ مِّنْهُ سِوَاكَ"
  },
  {
   "segment_id": 27,
   "arabic": "فَمَثَلَ بَيْنَ يَديْكَ مُتَضَرِّعاً،"
  },
  {
   "segment_id": 28,
   "arabic": "وَغَمَّضَ بَصَرَهُ إِلىَ الأَرْضِ مُتَخَشِّعاً،"
  },
  {
   "segment_id": 29,
   "arabic": "وَطَأْطَأَ رَأْسَهُ لِعِزَّتِكَ مُتَذَلِّلاً"
  },
  {
   "segment_id": 30,
   "arabic": "وَأَبَثَّكَ مِن سِرِّهِ مَا أَنتَ أَعْلَمُ بِهِ مِنْهُ خُضُوعاً"
  },
  {
   "segment_id": 31,
   "arabic": "وَعَدَّدَ مِن ذُنُوبِهِ مَا أَنتَ أَحْصى لَهَا خُشُوعاً"
  },
  {
   "segment_id": 32,
   "arabic": "وَاسْتَغَاثَ بِكَ مِنْ"
  },
  {
   "segment_id": 33,
   "arabic": "عَظِيمِ مَا وَقَعَ بِهِ فِي عِلْمِكَ،"
  },
  {
   "segment_id": 34,
   "arabic": "وَقَبِيحِ مَا فَضَحَهُ فِي حُكْمِكَ،"
  },
  {
   "segment_id": 35,
   "arabic": "مِن ذُنُوبٍ أَدْبَرَتْ لَذَّاتُهَا فَذَهَبَتْ،"
  },
  {
   "segment_id": 36,
   "arabic": "وَأَقَامَتْ تَبِعَاتُهَا فَلَزِمَتْ"
  },
  {
   "segment_id": 37,
   "arabic": "لا يُنكِرُ يَا إِلَهِي عَدْلَكَ إِنْ عَاقَبْتَهُ،"
  },
  {
   "segment_id": 38,
   "arabic": "وَلا يَسْتَعْصِمُ عَفْوَكَ عَنْهُ إِنْ عَفَوْتَ عَنْهُ وَرَحِمْتَهُ"
  },
  {
   "segment_id": 39,
   "arabic": "لأَنَّكَ الرَّبُّ الْكَرِيمُ الَّذِي لا يَتَعَاظَمُهُ غُفْرَانُ الذَّنْبِ الْعَظِيمِ"
  },
  {
   "segment_id": 40,
   "arabic": "اللَّهُمَّ فَهَا أَنَا ذَا"
  },
  {
   "segment_id": 41,
   "arabic": "قَدْ جِئْتُكَ مُطِيعاً لأَمْرِكَ،"
  },
  {
   "segment_id": 42,
   "arabic": "فِيمَا أَمَرْتَ بِهِ مِنَ الدُّعَاءِ،"
  },
  {
   "segment_id": 43,
   "arabic": "مُتَنَجِّزاً وَّعْدَكَ فِيمَا وَعَدتَّ بِهِ مِنَ الإِجَابَةِ، إِذْ تَقُولُ:"
  },
  {
   "segment_id": 44,
   "arabic": "(اُدْعُوني أَسْتَجِبْ لَكُمْ)"
  },
  {
   "segment_id": 45,
   "arabic": "اللَّهُمَّ فَصَلِّ عَلَى مُحَمَّدٍ وَآلهِ"
  },
  {
   "segment_id": 46,
   "arabic": "وَالْقَنِي بِمَغْفِرَتِكَ كَمَا لَقِيتُكَ بِإِقْرَارِي"
  },
  {
   "segment_id": 47,
   "arabic": "وَارْفَعْنِي عَن مَّصَاِرعِ الذُّنُوبِ كَمَا وَضَعْتُ لَكَ نَفْسِي"
  },
  {
   "segment_id": 48,
   "arabic": "وَاسْتُرْنِي بِسِتْرِكَ كَمَا تَأَنَّيْتَنِي عَنِ الإنتِقَامِ مِنِّي"
  },
  {
   "segment_id": 49,
   "arabic": "اللَّهُمَّ وَثَبِّتْ فِي طَاعَتِكَ نِيَّتِي"
  },
  {
   "segment_id": 50,
   "arabic": "وَأَحْكِمْ فِي عِبَادَتِكَ بَصِيرَتِي"
  },
  {
   "segment_id": 51,
   "arabic": "وَوَفِّقْنِي إِلىَ الأَعْمَاِل مَا تَغْسِلُ بِهِ دَنَسَ الْخَطَايَا عَنِّي"
  },
  {
   "segment_id": 52,
   "arabic": "وَتَوَفَّنِي عَلَى مِلَّتِكَ وَمِلَّةِ نَبِيِّكَ مُحَمَّدٍ عَلَيِهْ السَّلاَمُ إِذَا تَوَفَّيْتَنِي"
  },
  {
   "segment_id": 53,
   "arabic": "اللَّهُمَّ إِنِّي أَتُوبُ إِلَيْكَ فِي مَقَامِي هَذَا مِن"
  },
  {
   "segment_id": 54,
   "arabic": "كَبَائِرِ ذُنُوبِي وَصَغَائِرِهَا،"
  },
  {
   "segment_id": 55,
   "arabic": "وَبَوَاطِنِ سَيِّئَاتِي وَظَوَاهِرِهَا،"
  },
  {
   "segment_id": 56,
   "arabic": "وَسَوَاِلفِ زَلاَّتِي وَحَوَادِثِهَا"
  },
  {
   "segment_id": 57,
   "arabic": "تَوْبَةَ مَن لا يُحَدِّثُ نَفْسَهُ بِمَعْصِيَةٍ،"
  },
  {
   "segment_id": 58,
   "arabic": "وَلا يُضْمِرُ أَن يَّعُودَ فِي خَطِيئَةٍ"
  },
  {
   "segment_id": 59,
   "arabic": "وَقَدْ قُلْتَ يَا إِلَهِي فِي مُحْكَمِ كِتَابِكَ"
  },
  {
   "segment_id": 60,
   "arabic": "إِنَّكَ تَقْبَلُ التَّوْبَةَ عَنْ عِبَادِكَ"
  },
  {
   "segment_id": 61,
   "arabic": "وَتَعْفُو عَنِ السَّيِّئَاتِ"
  },
  {
   "segment_id": 62,
   "arabic": "وَتُحِبُّ التَّوَّابِينَ"
  },
  {
   "segment_id": 63,
   "arabic": "فَاقْبَلْ تَوْبَتِي كَمَا وَعَدتَّ"
  },
  {
   "segment_id": 64,
   "arabic": "وَاعْفُ عَن سَيِّئَاتِي كَمَا ضَمِنتَ"
  },
  {
   "segment_id": 65,
   "arabic": "وَأَوْجِبْ لِي مَحَبَّتَكَ كَمَا شَرَطتَّ"
  },
  {
   "segment_id": 66,
   "arabic": "وَلَكَ يَا رَبِّ"
  },
  {
   "segment_id": 67,
   "arabic": "شَرْطِي لا أَعُودَ فِي مَكْرُوهِكَ"
  },
  {
   "segment_id": 68,
   "arabic": "وَضَمَاِني لا أَرْجِعَ فِي مَذْمُومِكَ"
  },
  {
   "segment_id": 69,
   "arabic": "وَعَهْدِي أَنْ أَهْجُرَ جَمِيعَ مَعَاصِيكَ"
  },
  {
   "segment_id": 70,
   "arabic": "اللَّهُمَّ إِنَّكَ أَعْلَمُ بِمَا عَمِلْتُ"
  },
  {
   "segment_id": 71,
   "arabic": "فَاغْفِرْ لِي مَا عَلِمْتَ"
  },
  {
   "segment_id": 72,
   "arabic": "وَاصْرِفْنِي بِقُدْرَتِكَ إِلَى مَا أَحْبَبْتَ"
  },
  {
   "segment_id": 73,
   "arabic": "اللَّهُمَّ وَعَلَيَّ تَبِعَاتٌ قَدْ حَفِظْتُهُنَّ،"
  },
  {
   "segment_id": 74,
   "arabic": "وَتَبِعَاتٌ قَدْ نَسِيتُهُنَّ،"
  },
  {
   "segment_id": 75,
   "arabic": "وَكُلُّهُنَّ بِعَيْنِكَ الَّتِي لا تَنَامُ،"
  },
  {
   "segment_id": 76,
   "arabic": "وَعِلْمِكَ الَّذِي لا يَنْسَى"
  },
  {
   "segment_id": 77,
   "arabic": "فَعَوِّضْ مِنْهَا أَهْلَهَا، وَاحْطُطْ عَنِّي وِزْرَهَا، وَخَفِّفْ عَنِّي ثِقْلَهَا، وَاعْصِمْنِي مِنْ أَنْ أُقَارِفَ مِثْلَهَا"
  },
  {
   "segment_id": 78,
   "arabic": "اللَّهُمَّ وَإِنَّهُ لا وَفَاءَ لِي بِالتَّوْبَةِ إِلاَّ بِعِصْمَتِكَ،"
  },
  {
   "segment_id": 79,
   "arabic": "وَلا اسْتِمْسَاكَ بِي عَنِ الْخَطَايَا إِلاَّ عَن قُوَّتِكَ"
  },
  {
   "segment_id": 80,
   "arabic": "فَقَوِّنِي بِقُوَّةٍ كَافِيَةٍ"
  },
  {
   "segment_id": 81,
   "arabic": "وَتَوَلَّنِي بِعِصْمَةٍ مَّانِعَةٍ"
  },
  {
   "segment_id": 82,
   "arabic": "اللَّهُمَّ أَيُّمَا عَبْدٍ تَابَ إِلَيْكَ"
  },
  {
   "segment_id": 83,
   "arabic": "وَهُوَ فِي عِلْمِ الْغَيْبِ عِندَكَ فَاسِخً لِّتَوْبَتِهِ،"
  },
  {
   "segment_id": 84,
   "arabic": "وَعَائِدٌ فِي ذَنْبِهِ وَخَطِيئَتِهِ"
  },
  {
   "segment_id": 85,
   "arabic": "فَإِنِّي أَعُوذُ بِكَ أَنْ أَكُونَ كَذلِكَ"
  },
  {
   "segment_id": 86,
   "arabic": "فاجْعَلْ تَوْبَتِي هَذِهِ لا أَحْتَاجُ بَعْدَهَا إِلَى تَوْبَةٍ،"
  },
  {
   "segment_id": 87,
   "arabic": "تَوْبَةً مُّوجِبَةً لِّمَحْوِ مَا سَلَفَ وَالسَّلاَمَةِ فِيمَا بَقِيَ"
  },
  {
   "segment_id": 88,
   "arabic": "اللَّهُمَ إِنِّي أَعْتَذِرُ إِلَيْكَ مِنْ جَهْلِي"
  },
  {
   "segment_id": 89,
   "arabic": "وَأَسْتَوْهِبُكَ سُوءَ فِعْلِي"
  },
  {
   "segment_id": 90,
   "arabic": "فَاضْمُمْنِي إِلَى كَنَفِ رَحْمَتِكَ تَطَوُّلاً"
  },
  {
   "segment_id": 91,
   "arabic": "وَاسْتُرْنِي بِسِتْرِ عَافِيَتِكَ تَفَضُّلاً"
  },
  {
   "segment_id": 92,
   "arabic": "اللَّهُمَّ وَإِنّي أَتُوبُ إِلَيْكَ مِن كُلِّ مَا خَالَفَ إِرَادَتَكَ،"
  },
  {
   "segment_id": 93,
   "arabic": "أَوْ زَالَ عَن مَّحَبَّتِكَ،"
  },
  {
   "segment_id": 94,
   "arabic": "مِنْ خَطَرَاتِ قَلْبِي،"
  },
  {
   "segment_id": 95,
   "arabic": "وَلَحَظَاتِ عَيْنِي،"
  },
  {
   "segment_id": 96,
   "arabic": "وَحِكَايَاتِ لِسَانِي،"
  },
  {
   "segment_id": 97,
   "arabic": "تَوْبَةً تَسْلَمُ بِهَا كُلُّ جَارِحَةٍ عَلَى حِيَاِلهَا مِن تَبِعَاتِكَ"
  },
  {
   "segment_id": 98,
   "arabic": "وَتَأْمَنُ مِمَّا يَخَافُ الْمُعْتَدُونَ مِنْ أَلِيمِ سَطَوَاتِكَ"
  },
  {
   "segment_id": 99,
   "arabic": "اللَّهُمَّ فَارْحَمْ وَحْدَتِي بَيْنَ يَديْكَ،"
  },
  {
   "segment_id": 100,
   "arabic": "وَوَجِيبَ قَلْبِي مِنْ خَشْيَتِكَ"
  },
  {
   "segment_id": 101,
   "arabic": "وَاضْطِرَابَ أَرْكَانِي مِنْ هَيْبَتِكَ"
  },
  {
   "segment_id": 102,
   "arabic": "فَقَدْ أَقَامَتْنِي يَا رَبِّ ذُنُوبِي مَقَامَ الْخِزْيِ بِفِنَائِكَ،"
  },
  {
   "segment_id": 103,
   "arabic": "فَإِن سَكَتُّ لَمْ يَنطِقْ عَنِّي أَحَدٌ،"
  },
  {
   "segment_id": 104,
   "arabic": "وَإِن شَفَعْتُ فَلَسْتُ بِأَهْلِ الشَّفَاعَةِ"
  },
  {
   "segment_id": 105,
   "arabic": "اللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَّآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 106,
   "arabic": "وَشَفِّعْ فِي خَطَايَايَ كَرَمَكَ"
  },
  {
   "segment_id": 107,
   "arabic": "وَعُدْ عَلَى سَيِّئَاتِي بِعَفْوِكَ"
  },
  {
   "segment_id": 108,
   "arabic": "وَلا تَجْزِنِي جَزَائِي مِنْ عُقُوبَتِكَ"
  },
  {
   "segment_id": 109,
   "arabic": "وَابْسُطْ عَلَيَّ طَوْلَكَ"
  },
  {
   "segment_id": 110,
   "arabic": "وَجَلِّلْنِي بِسِتْرِكَ"
  },
  {
   "segment_id": 111,
   "arabic": "وَافْعَلْ بِي فِعْلَ عَزِيزٍ تَضَرَّعَ إِلَيْهِ عَبْدٌ ذَلِيلٌ فَرَحِمَهُ،"
  },
  {
   "segment_id": 112,
   "arabic": "أَوْ غَنِيٍّ تَعَرَّضَ لَهُ عَبْدٌ فَقِيرٌ فَنَعَشَهُ"
  },
  {
   "segment_id": 113,
   "arabic": "اللَّهُمَّ لا خَفِيرَ لِي مِنكَ فَلْيَخْفِرْنِي عِزُّكَ"
  },
  {
   "segment_id": 114,
   "arabic": "وَلا شَفِيعَ لِي إِلَيْكَ فَلْيَشْفَعْ لِي فَضْلُكَ"
  },
  {
   "segment_id": 115,
   "arabic": "وَقَدْ أَوْجَلَتْنِي خَطَايَايَ فَلْيُؤْمِنِّي عَفْوُكَ"
  },
  {
   "segment_id": 116,
   "arabic": "فَمَا كُلُّ مَا نَطَقْتُ بِهِ عَن جَهْلٍ مِّنِّي بِسُوءِ أثَرِي،"
  },
  {
   "segment_id": 117,
   "arabic": "وَلا نِسْيَانٍ لِّمَا سَبَقَ مِن ذَمِيمِ فِعْلِي"
  },
  {
   "segment_id": 118,
   "arabic": "لَكِن لِّتَسْمَعْ سَمَاؤُكَ وَمَن فِيهَا"
  },
  {
   "segment_id": 119,
   "arabic": "وَأَرْضُكَ وَمَنْ عَلَيْهَا"
  },
  {
   "segment_id": 120,
   "arabic": "مَا أَظْهَرْتُ لَكَ مِنَ النَّدَمِ،"
  },
  {
   "segment_id": 121,
   "arabic": "وَلَجَأْتُ إِلَيْكَ فِيهِ مِنَ التَّوْبَةِ"
  },
  {
   "segment_id": 122,
   "arabic": "فَلَعَلَّ بَعْضَهُم بِرَحْمَتِكَ يَرْحَمُنِي مِن سُوءِ مَوْقِفِي،"
  },
  {
   "segment_id": 123,
   "arabic": "أَوْ تُدْرِكُهُ الرِّقَّةُ عَلَيَّ بِسُوءِ حَاِلي،"
  },
  {
   "segment_id": 124,
   "arabic": "فَيَنَالَنِي مِنْهُ بِدَعْوَةٍ هِيَ أَسْمَعُ لَديْكَ مِن دُعَائِي،"
  },
  {
   "segment_id": 125,
   "arabic": "أَوْشَفَاعَةٍ أَوْكَدُ عِندَكَ مِن شَفَاعَتِي،"
  },
  {
   "segment_id": 126,
   "arabic": "تَكُونُ بِهَا نَجَاتِي مِنْ غَضَبِكَ،"
  },
  {
   "segment_id": 127,
   "arabic": "وَفَوْزِي بِرِضَاكَ"
  },
  {
   "segment_id": 128,
   "arabic": "اللَّهُمَّ إِن يَّكُنِ النَّدَمُ تَوْبَةً إِلَيْكَ فَأَنَا أَندَمُ النَّادِمِينَ"
  },
  {
   "segment_id": 129,
   "arabic": "وَإِن يَّكُنِ التَّرْكُ لِمَعْصِيَتِكَ إِنَابَةً فَأَنَا أَوَّلُ الْمُنِيبِينَ"
  },
  {
   "segment_id": 130,
   "arabic": "وَإِن يَّكُنِ الإسْتِغْفَارُ حِطَّةً لِّلذُّنُوبِ فَإِنِّي لَكَ مِنَ الْمُسْتَغْفِرِينَ"
  },
  {
   "segment_id": 131,
   "arabic": "اللَّهُمَّ فَكَمَا أَمَرْتَ بِالتَّوْبَةِ وَضَمِنتَ الْقَبُولَ"
  },
  {
   "segment_id": 132,
   "arabic": "وَحَثَثْتَ عَلىَ الدُّعَاءِ وَوَعَدتَّ الإِجَابَةَ"
  },
  {
   "segment_id": 133,
   "arabic": "فَصَلِّ عَلَى مُحَمَّدٍ وَّآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 134,
   "arabic": "وَاقْبَلْ تَوْبَتِي وَلا تَرْجِعْنِي مَرْجِعَ الْخَيْبَةِ مِن رَّحْمَتِكَ"
  },
  {
   "segment_id": 135,
   "arabic": "إِنَّكَ أَنتَ التَّوَّابُ عَلىَ الْمُذْنِبِينَ،"
  },
  {
   "segment_id": 136,
   "arabic": "وَالرَّحِيمُ لِلْخَاطِئِينَ الْمُنِيبِينَ"
  },
  {
   "segment_id": 137,
   "arabic": "اللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَّآلِ مُحَمَّدٍ كَمَا هَديْتَنَا بِهِ"
  },
  {
   "segment_id": 138,
   "arabic": "وَصَلِّ عَلَى مُحَمَّدٍ وَّآلِهِ كَمَا اسْتَنقَذْتنَا بِهِ"
  },
  {
   "segment_id": 139,
   "arabic": "وَصَلِّ عَلَى مُحَمَّدٍ وَّآلِ مُحَمَّدٍ صَلاَةً تَشْفَعُ لَنَا يَوْمَ الْقِيَامَةِ وَيَوْمَ الْفَاقَةِ إِلَيْكَ"
  },
  {
   "segment_id": 140,
   "arabic": "إِنَّكَ عَلَى كُلِّ شَيٍْء قَدِيرٌ، وَهُوَ عَلَيْكَ يَسِيرٌ"
  }
 ]
}