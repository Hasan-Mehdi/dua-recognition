 "segments": [
  {
   "segment_id": 1,
   "arabic": "أُعِيذُ نَفْسِي وَذُرِّيَّتِي وَأَهْلَ بَيْتِي"
  },
  {
   "segment_id": 2,
   "arabic": "وَمَالِي بِكَلِمَاتِ اللَّهِ التَّامَّاتِ"
  },
  {
   "segment_id": 3,
   "arabic": "مِنْ كُلِّ شَيْطَانٍ وَهَامَّةٍ"
  },
  {
   "segment_id": 4,
   "arabic": "وَمِنْ كُلِّ عَيْنٍ لَامَّةٍ"
  },
  {
   "segment_id": 5,
   "arabic": "وهي العوذة الَّتِي عَوَّذَ بِهَا جَبْرَائِيلُ الْحَسَنَ وَالْحُسَيْنَ"
  }
 ]
