{
 "dua_id": "duasorg-ziyarat-of-imam-jafar-al-sadiq-1",
 "dua_name_en": "Ziyarat of Imam Jafar al-Sadiq (as)",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ziyarat-of-imam-jafar-al-sadiq.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "السَّلامُ عَلَیْكَ أَیُّهَا الإِمَامُ الصَّادِقُ."
  },
  {
   "segment_id": 2,
   "arabic": "السَّلامُ عَلَیْكَ أَیُّهَا الوَصِیُّ النَّاطِقُ."
  },
  {
   "segment_id": 3,
   "arabic": "السَّلامُ عَلَیْكَ أَیُّهَا الفَاتِقُ الرَّاتِقُ."
  },
  {
   "segment_id": 4,
   "arabic": "السَّلامُ عَلَیْكَ أَیُّهَا السَّنَامُ الأَعْظَمُ."
  },
  {
   "segment_id": 5,
   "arabic": "السَّلامُ عَلَیْكَ أَیُّهَا الصِّرَاطُ الأَقْوَمُ."
  },
  {
   "segment_id": 6,
   "arabic": "السَّلامُ عَلَیْكَ یَا مِفْتَاحَ الخَیْرَاتِ."
  },
  {
   "segment_id": 7,
   "arabic": "السَّلَامُ عَلَیْكَ یَا مِصْبَاحَ الْظُلُمَاتِ"
  },
  {
   "segment_id": 8,
   "arabic": "السَّلَامُ عَلَیْكَ یَا دَافِعَ الْمُعْضِلَاتِ"
  },
  {
   "segment_id": 9,
   "arabic": "السَّلامُ عَلَیْكَ یَا مَعْدِنَ البَرَكَاتِ."
  },
  {
   "segment_id": 10,
   "arabic": "السَّلامُ عَلَیْكَ یَا صَاحِبَ الحُجَجِ وَالدَّلالاتِ."
  },
  {
   "segment_id": 11,
   "arabic": "السَّلامُ عَلَیْكَ یَا صَاحِبَ البَرَاهِینِ الوَاضِحَاتِ."
  },
  {
   "segment_id": 12,
   "arabic": "السَّلامُ عَلَیْكَ یَا نَاصِرَ دِینِ اللَّهِ."
  },
  {
   "segment_id": 13,
   "arabic": "السَّلامُ عَلَیْكَ یَا نَاشِرَ حُكْمِ اللَّهِ."
  },
  {
   "segment_id": 14,
   "arabic": "السَّلامُ عَلَیْكَ یَا فَاصِلَ الخِطَابَاتِ."
  },
  {
   "segment_id": 15,
   "arabic": "السَّلامُ عَلَیْكَ یَا كَاشِفَ الكُرُبَاتِ."
  },
  {
   "segment_id": 16,
   "arabic": "السَّلامُ عَلَیْكَ یَا عَمِیدَ الصَّادِقِینَ."
  },
  {
   "segment_id": 17,
   "arabic": "السَّلامُ عَلَیْكَ یَا لِسَانَ النَّاطِقِینَ."
  },
  {
   "segment_id": 18,
   "arabic": "السَّلامُ عَلَیْكَ یَا خَلَفَ الخَائِفِینَ."
  },
  {
   "segment_id": 19,
   "arabic": "السَّلامُ عَلَیْكَ یَا زَعِیمَ الصَّالِحِینَ."
  },
  {
   "segment_id": 20,
   "arabic": "السَّلامُ عَلَیْكَ یَا سَیِّدَ المُسْلِمِینَ."
  },
  {
   "segment_id": 21,
   "arabic": "السَّلامُ عَلَیْ. یَا كَهْفَ المُؤْمِنِینَ."
  },
  {
   "segment_id": 22,
   "arabic": "السَّلامُ عَلَیْكَ یَا هَادِیَ المُضِلِّینَ."
  },
  {
   "segment_id": 23,
   "arabic": "السَّلامُ عَلَیْكَ یَا سَكَنَ الطَّائِعِینَ."
  },
  {
   "segment_id": 24,
   "arabic": "أَشْهَدُ یَا مَوْلایَ أَنَّكَ عَلَمُ الهُدَى،"
  },
  {
   "segment_id": 25,
   "arabic": "وَالعُرْوَةُ الوُثْقَى، وَشَمْسُ الضُّحَى،"
  },
  {
   "segment_id": 26,
   "arabic": "وَبَحْرُ النَّدَى،وَكَهْفُ الوَرَى، وَالمَثَلُ الأَعْلَى،"
  },
  {
   "segment_id": 27,
   "arabic": "وَصَلَّى اللَّهُ عَلَى رُوحِكَ وَبَدَنِكَ."
  }
 ]
}