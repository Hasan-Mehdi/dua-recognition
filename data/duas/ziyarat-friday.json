{
 "dua_id": "ziyarat-friday",
 "dua_name_en": "Ziyarat Jummah",
 "dua_name_ar": "زیارة الجمعة",
 "source": "https://www.duaplayer.org/en/ziyarat/friday",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمٰنِ ٱلرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا حُجَّةَ ٱللَّهِ فِي ارْضِهِ"
  },
  {
   "segment_id": 3,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا عَيْنَ ٱللَّهِ فِي خَلْقِهِ"
  },
  {
   "segment_id": 4,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا نُورَ ٱللَّهِ"
  },
  {
   "segment_id": 5,
   "arabic": "ٱلَّذِي يَهْتَدِي بِهِ ٱلْمُهْتَدُونَ"
  },
  {
   "segment_id": 6,
   "arabic": "وَيُفَرَّجُ بِهِ عَنِ ٱلْمُؤْمِنِينَ"
  },
  {
   "segment_id": 7,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ ايُّهَا ٱلْمُهَذَّبُ ٱلْخَائِفُ"
  },
  {
   "segment_id": 8,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ ايُّهَا ٱلْوَلِيُّ ٱلنَّاصِحُ"
  },
  {
   "segment_id": 9,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا سَفِينَةَ ٱلنَّجَاةِ"
  },
  {
   "segment_id": 10,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا عَيْنَ ٱلْحَيَاةِ"
  },
  {
   "segment_id": 11,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ"
  },
  {
   "segment_id": 12,
   "arabic": "صَلَّىٰ ٱللَّهُ عَلَيْكَ"
  },
  {
   "segment_id": 13,
   "arabic": "وَعَلَىٰ آلِ بَيْتِكَ"
  },
  {
   "segment_id": 14,
   "arabic": "ٱلطَّيِّبينَ ٱلطَّاهِرِينَ"
  },
  {
   "segment_id": 15,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ"
  },
  {
   "segment_id": 16,
   "arabic": "عَجَّلَ ٱللَّهُ لَكَ مَا وَعَدَكَ"
  },
  {
   "segment_id": 17,
   "arabic": "مِنَ ٱلنَّصْرِ وَظُهُورِ ٱلامْرِ"
  },
  {
   "segment_id": 18,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا مَوْلاَيَ"
  },
  {
   "segment_id": 19,
   "arabic": "انَا مَوْلاَكَ"
  },
  {
   "segment_id": 20,
   "arabic": "عَارِفٌ بِاولاَكَ وَاخْرَاكَ"
  },
  {
   "segment_id": 21,
   "arabic": "اتَقَرَّبُ إِلَىٰ ٱللَّهِ تَعَالَىٰ بِكَ وَبِآلِ بَيْتِكَ"
  },
  {
   "segment_id": 22,
   "arabic": "وَانْتَظِرُ ظُهُورَكَ وَظُهُورَ ٱلْحَقِّ عَلَىٰ يَدَيْكَ"
  },
  {
   "segment_id": 23,
   "arabic": "وَاسْالُ ٱللَّهَ انْ يُصَلِّيَ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 24,
   "arabic": "وَانْ يَجْعَلَنِي مِنَ ٱلمُنْتَظِرِينَ لَكَ"
  },
  {
   "segment_id": 25,
   "arabic": "وَٱلتَّابِعِينَ وَٱلنَّاصِرِينَ لَكَ عَلَىٰ اعْدَائِكَ"
  },
  {
   "segment_id": 26,
   "arabic": "وَٱلْمُسْتَشْهَدِينَ بَيْنَ يَدَيْكَ فِي جُمْلَةِ اوْلِيَائِكَ"
  },
  {
   "segment_id": 27,
   "arabic": "يَا مَوْلاَيَ يَا صَاحِبَ ٱلزَّمَانِ"
  },
  {
   "segment_id": 28,
   "arabic": "صَلَوَاتُ ٱللَّهِ عَلَيْكَ"
  },
  {
   "segment_id": 29,
   "arabic": "وَعَلَىٰ آلِ بَيْتِكَ"
  },
  {
   "segment_id": 30,
   "arabic": "هٰذَا يَوْمُ ٱلْجُمُعَةِ"
  },
  {
   "segment_id": 31,
   "arabic": "وَهُوَ يَوْمُكَ ٱلْمُتَوَقَّعُ فِيهِ ظُهُورُكَ"
  },
  {
   "segment_id": 32,
   "arabic": "وَٱلْفَرَجُ فِيهِ لِلْمُؤْمِنِينَ عَلَىٰ يَدَيْكَ"
  },
  {
   "segment_id": 33,
   "arabic": "وَقَتْلُ ٱلْكَافِرِينَ بِسَيْفِكَ"
  },
  {
   "segment_id": 34,
   "arabic": "وَانَا يَا مَوْلاَيَ فِيهِ ضَيْفُكَ وَجَارُكَ"
  },
  {
   "segment_id": 35,
   "arabic": "وَانْتَ يَا مَوْلاَيَ كَرِيمٌ مِنْ اوْلاَدِ ٱلْكِرَامِ"
  },
  {
   "segment_id": 36,
   "arabic": "وَمَاْمُورٌ بِٱلضِّيَافَةِ وَٱلإِجَارَةِ"
  },
  {
   "segment_id": 37,
   "arabic": "فَاضِفْنِي وَاجِرْنِي"
  },
  {
   "segment_id": 38,
   "arabic": "صَلَوَاتُ ٱللَّهِ عَلَيْكَ"
  },
  {
   "segment_id": 39,
   "arabic": "وَعَلىٰ اهْلِ بَيْتِكَ ٱلطَّاهِرينَ"
  }
 ]
}