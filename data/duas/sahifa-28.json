{
 "dua_id": "sahifa-28",
 "dua_name_en": "Sahifa 28: His supplication in fleeing to God for protection",
 "dua_name_ar": "دُعَاؤُهُ فِي التَّفَزُّعِ الى اللهِ",
 "source": "https://duas.pro/28-his-supplication-in-fleeing-to-god-for-protection",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللَّهُمَّ إنِّي أَخْلَصْتُ بِانْقِطَاعِي إلَيْكَ،"
  },
  {
   "segment_id": 2,
   "arabic": "وَأَقْبَلْتُ بِكُلِّي عَلَيْـكَ،"
  },
  {
   "segment_id": 3,
   "arabic": "وَصَـرَفْتُ وَجْهِي عَمَّنْ يَحْتَاجُ إلَى رِفْدِكَ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَقَلَبْتُ مَسْأَلَتِي عَمَّنْ لَمْ يَسْتَغْنِ عَنْ فَضْلِكَ،"
  },
  {
   "segment_id": 5,
   "arabic": "وَرَأَيْتُ أَنَّ طَلَبَ الْمُحْتَاجِ إلَى الْمُحْتَاجِ"
  },
  {
   "segment_id": 6,
   "arabic": "سَفَهٌ مِنْ رَأْيِهِ وَضَلَّةٌ مِنْ عَقْلِهِ،"
  },
  {
   "segment_id": 7,
   "arabic": "فَكَمْ قَدْ رَأَيْتُ يَـا إِلَهِيْ"
  },
  {
   "segment_id": 8,
   "arabic": "مِنْ أُنَاسٍ طَلَبُوا الْعِزَّ بِغَيْرِكَ فَذَلُّوا،"
  },
  {
   "segment_id": 9,
   "arabic": "وَرَامُوا الثَّرْوَةَ مِنْ سِوَاكَ فَافْتَقَرُوا،"
  },
  {
   "segment_id": 10,
   "arabic": "وَحَاوَلُوا الارْتِفَاعَ فَاتَّضَعُوا،"
  },
  {
   "segment_id": 11,
   "arabic": "فَصَحَّ بِمُعَايَنَةِ أَمْثَالِهِمْ حَازِمٌ"
  },
  {
   "segment_id": 12,
   "arabic": "وَفَّقَهُ اعْتِبَارُهُ"
  },
  {
   "segment_id": 13,
   "arabic": "وَأَرْشَدَهُ إِلَى طَرِيقِ صَوَابِهِ اِخْتِیارُهُ"
  },
  {
   "segment_id": 14,
   "arabic": "فَأَنْتَ يَا مَوْلايَ"
  },
  {
   "segment_id": 15,
   "arabic": "دُونَ كُلِّ مَسْؤُولٍ مَوْضِعُ مَسْأَلَتِي"
  },
  {
   "segment_id": 16,
   "arabic": "وَدُونَ كُلِّ مَطْلُوبٍ إِلَيْهِ وَلِيُّ حَاجَتِي."
  },
  {
   "segment_id": 17,
   "arabic": "اَنتَ الْمَخْصُوصُ قَبْلَ كُلِّ مَدْعُوٍّ بِدَعْوَتِي"
  },
  {
   "segment_id": 18,
   "arabic": "لاَ يَشْرَكُكَ أَحَدٌ فِي رَجَائِي،"
  },
  {
   "segment_id": 19,
   "arabic": "وَلاَ يَتَّفِقُ أَحَدٌ مَعَكَ فِي دُعَائِي،"
  },
  {
   "segment_id": 20,
   "arabic": "وَلاَ يَنْظِمُهُ وَإِيَّاكَ نِدَائِي"
  },
  {
   "segment_id": 21,
   "arabic": "لَكَ يَا إِلَهِي وَحْدَانِيَّةُ الْعَدَدِ،"
  },
  {
   "segment_id": 22,
   "arabic": "وَمَلَكَةُ الْقُدْرَةِ الصَّمَدِ،"
  },
  {
   "segment_id": 23,
   "arabic": "وَفَضِيلَةُ الْحَوْلِ وَالْقُوَّةِ،"
  },
  {
   "segment_id": 24,
   "arabic": "وَدَرَجَةُ الْعُلُوِّ وَالرِّفْعَةِ"
  },
  {
   "segment_id": 25,
   "arabic": "وَمَنْ سِوَاكَ مَرْحُومٌ فِي عُمْرِهِ،"
  },
  {
   "segment_id": 26,
   "arabic": "مَغْلُوبٌ عَلَى أَمْرِهِ، مَقْهُورٌ عَلَى شَأْنِهِ،"
  },
  {
   "segment_id": 27,
   "arabic": "مُخْتَلِفُ الْحَالاَتِ، مُتَنَقِّلٌ فِي الصِّفَاتِ."
  },
  {
   "segment_id": 28,
   "arabic": "فَتَعَالَيْتَ عَنِ الْأَشْبَاهِ وَالْأَضْـدَادِ،"
  },
  {
   "segment_id": 29,
   "arabic": "وَتَكَبَّـرْتَ عَنِ الْأَمْثَـالِ وَالْأَنْدَادِ،"
  },
  {
   "segment_id": 30,
   "arabic": "فَسُبْحَانَكَ لاَ إِلَهَ إِلاَّ أَنْتَ."
  }
 ]
}