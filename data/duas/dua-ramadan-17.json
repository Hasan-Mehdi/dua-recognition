{
 "dua_id": "dua-ramadan-17",
 "dua_name_en": "Day 17",
 "dua_name_ar": " شهر رمضان ١٧  ",
 "source": "https://www.duaplayer.org/en/dua/ramadan-17",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "اللّهُمّ اهْدِنِي فِيهِ لِصَالِحِ الأَعْمَالِ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَاقْضِ لِي فِيهِ الحَوَائِجَ وَالآمَالَ،"
  },
  {
   "segment_id": 5,
   "arabic": "يَا مَنْ لا يَحْتَاجُ إِلَى التّفْسِيرِ وَالسّؤَالِ،"
  },
  {
   "segment_id": 6,
   "arabic": "يَا عَالِماً بِمَا فِي صُدُورِ العَالَمِينَ،"
  },
  {
   "segment_id": 7,
   "arabic": "صَلّ عَلَى مُحَمّدٍ وَآلِهِ الطَّاهِرِينَ."
  }
 ]
}