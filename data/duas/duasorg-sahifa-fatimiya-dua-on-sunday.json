{
 "dua_id": "duasorg-sahifa-fatimiya-dua-on-sunday",
 "dua_name_en": "Dua of Sayeda Fatima (sa) for Sunday",
 "dua_name_ar": "",
 "source": "https://www.duas.org/sahifa-fatimiya-dua-on-sunday.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "ا َللّٰهُمَّ اجْعَلْ اَوَّلَ يَوْمِيْ هٰذَا فَلَاحًا،"
  },
  {
   "segment_id": 2,
   "arabic": "وَ اٰخِرَهٗ نَجَاحًا،"
  },
  {
   "segment_id": 3,
   "arabic": "وَ اَوْسَطَهٗ صَلَاحًا،"
  },
  {
   "segment_id": 4,
   "arabic": "اَللّٰهُمَّ صَلِّ عَلٰى مُحَمَّدٍ وَ اٰلِ مُحَمَّدٍ،"
  },
  {
   "segment_id": 5,
   "arabic": "وَ اجْعَلْنَا مِمَّنْ اَنَابَ اِلَيْكَ فَقَبِلْتَهٗ،"
  },
  {
   "segment_id": 6,
   "arabic": "وَ تَوَكَّلَ عَلَيْكَ فَكَفَيْتَهٗ،"
  },
  {
   "segment_id": 7,
   "arabic": "وَ تَضَرَّعَ اِلَيْكَ فَرَحِمْتَهٗ.‏"
  }
 ]
}