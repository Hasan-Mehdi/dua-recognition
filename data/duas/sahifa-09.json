{
 "dua_id": "sahifa-09",
 "dua_name_en": "Sahifa 09: in yearning to ask forgiveness",
 "dua_name_ar": "دُعَاؤُهُ فِي الِاشْتِيَاقِ الى طَلَبِ المَغفِرَةِ مِن الله",
 "source": "https://duas.pro/9-in-yearning-to-ask-forgiveness",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "أَللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 2,
   "arabic": "وَصَيِّرْنَا إِلَى مَحْبُوبِكَ مِنَ التَّوْبَةِ"
  },
  {
   "segment_id": 3,
   "arabic": "وَأَزِلْنَا عَنْ مَكْرُوهِكَ مِنَ الْإِصْرَارِ"
  },
  {
   "segment_id": 4,
   "arabic": "أَللَّهُمَّ وَمَتَى وَقَفْنَا بَيْنَ نَقْصَيْنِ فِي دِينٍ أَوْ دُنْيَا"
  },
  {
   "segment_id": 5,
   "arabic": "فَأَوْقِعِ النَّقْصَ بِأَسْرَعِهِمَا فَنَاءً"
  },
  {
   "segment_id": 6,
   "arabic": "وَاجْعَلِ التَّوْبَةَ فِي أَطْوَلِهِمَا بَقَاءً"
  },
  {
   "segment_id": 7,
   "arabic": "وَإِذَا هَمَمْنَا بِهَمَّيْنِ يُرْضِيكَ أَحَدُهُمَا عَنَّا"
  },
  {
   "segment_id": 8,
   "arabic": "وَيُسْخِطُكَ الْآخَرُ عَلَيْنَا"
  },
  {
   "segment_id": 9,
   "arabic": "فَمِلْ بِنَا إِلَى مَا يُرْضِيكَ عَنَّا"
  },
  {
   "segment_id": 10,
   "arabic": "وَأَوْهِنْ قُوَّتَنَا عَمَّا يُسْخِطُكَ عَلَيْنَا"
  },
  {
   "segment_id": 11,
   "arabic": "وَلَا تُخَلِّ فِي ذَلِكَ بَيْنَ نُفُوسِنَا وَاخْتِيَارِهَا"
  },
  {
   "segment_id": 12,
   "arabic": "فَإِنَّهَا مُخْتَارَةٌ لِلْبَاطِلِ إِلَّا مَا وَفَّقْتَ"
  },
  {
   "segment_id": 13,
   "arabic": "أَمَّارَةٌ بِالسُّوءِ إِلَّا مَا رَحِمْتَ"
  },
  {
   "segment_id": 14,
   "arabic": "اللَّهُمَّ وَإِنَّكَ مِنَ الضَّعْفِ خَلَقْتَنَا"
  },
  {
   "segment_id": 15,
   "arabic": "وَعَلَى الْوَهْنِ بَنَيْتَنَا"
  },
  {
   "segment_id": 16,
   "arabic": "وَمِنْ مَاءٍ مَهِينٍ ابْتَدَأْتَنَا"
  },
  {
   "segment_id": 17,
   "arabic": "فَلَا حَوْلَ لَنَا إِلَّا بِقُوَّتِكَ"
  },
  {
   "segment_id": 18,
   "arabic": "وَلَا قُوَّةَ لَنَا إِلَّا بِعَوْنِكَ"
  },
  {
   "segment_id": 19,
   "arabic": "فَأَيِّدْنَا بِتَوْفِيقِكَ وَسَدِّدْنَا بِتَسْدِيدِكَ"
  },
  {
   "segment_id": 20,
   "arabic": "وَأَعْمِ أَبْصَارَ قُلُوبِنَا عَمَّا خَالَفَ مَحَبَّتَكَ"
  },
  {
   "segment_id": 21,
   "arabic": "وَلَا تَجْعَلْ لِشَيْءٍ مِنْ جَوَارِحِنَا نُفُوذًا فِي مَعْصِيَتِكَ"
  },
  {
   "segment_id": 22,
   "arabic": "اللَّهُمَّ فَصَلِّ عَلَى مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 23,
   "arabic": "وَاجْعَلْ هَمَسَاتِ قُلُوبِنَا وَحَرَكَاتِ أَعْضَائِنَا"
  },
  {
   "segment_id": 24,
   "arabic": "وَلَمَحَاتِ أَعْيُنِنَا وَلَهَجَاتِ أَلْسِنَتِنَا"
  },
  {
   "segment_id": 25,
   "arabic": "فِي مُوجِبَاتِ ثَوَابِكَ"
  },
  {
   "segment_id": 26,
   "arabic": "حَتَّى لَا تَفُوتَنَا حَسَنَةٌ نَسْتَحِقُّ بِهَا جَزَاءَكَ"
  },
  {
   "segment_id": 27,
   "arabic": "وَلَا تَبْقَى لَنَا سَيِّئَةٌ نَسْتَوْجِبُ بِهَا عِقَابَكَ"
  }
 ]
}