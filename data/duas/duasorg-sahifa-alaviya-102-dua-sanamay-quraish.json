{
 "dua_id": "duasorg-sahifa-alaviya-102-dua-sanamay-quraish",
 "dua_name_en": "Dua Sanamay Quraish",
 "dua_name_ar": "",
 "source": "https://www.duas.org/sahifa-alaviya-102-dua-sanamay-quraish.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللَّهُمَّ الْعَنْ صَنَمَيْ قُرَيْشٍ"
  },
  {
   "segment_id": 2,
   "arabic": "وَ جِبْتَيْهَا"
  },
  {
   "segment_id": 3,
   "arabic": "وَ طَاغُوتَيْهَا"
  },
  {
   "segment_id": 4,
   "arabic": "وَ إِفْكَيْهَا"
  },
  {
   "segment_id": 5,
   "arabic": "وَ ابْنَتَيْهِمَا"
  },
  {
   "segment_id": 6,
   "arabic": "اللَّذَيْنِ خَالَفَا أَمْرَكَ"
  },
  {
   "segment_id": 7,
   "arabic": "وَ أَنْكَرَا وَحْيَكَ"
  },
  {
   "segment_id": 8,
   "arabic": "وَ جَحَدَا إِنْعَامَكَ"
  },
  {
   "segment_id": 9,
   "arabic": "وَ عَصَيَا رَسُولَكَ"
  },
  {
   "segment_id": 10,
   "arabic": "وَ قَلَّبَا دِينَكَ"
  },
  {
   "segment_id": 11,
   "arabic": "وَ حَرَّفَا كِتَابَكَ"
  },
  {
   "segment_id": 12,
   "arabic": "وَ أَحَبَّا أَعْدَاءَكَ"
  },
  {
   "segment_id": 13,
   "arabic": "وَ جَحَدَا آلَاءَكَ"
  },
  {
   "segment_id": 14,
   "arabic": "وَ عَطَّلَا أَحْكَامَكَ"
  },
  {
   "segment_id": 15,
   "arabic": "وَ أَبْطَلَا فَرَائِضَكَ"
  },
  {
   "segment_id": 16,
   "arabic": "وَ أَلْحَدَا فِي آيَاتِكَ"
  },
  {
   "segment_id": 17,
   "arabic": "وَ عَادَيَا أَوْلِيَاءَكَ"
  },
  {
   "segment_id": 18,
   "arabic": "وَ وَالَيَا أَعْدَاءَكَ"
  },
  {
   "segment_id": 19,
   "arabic": "وَ خَرَّبَا بِلَادَكَ"
  },
  {
   "segment_id": 20,
   "arabic": "وَ أَفْسَدَا عِبَادَكَ"
  },
  {
   "segment_id": 21,
   "arabic": "اَللَّهُمَّ الْعَنْهُمَا"
  },
  {
   "segment_id": 22,
   "arabic": "وَ أَتْبَاعَهُمَا"
  },
  {
   "segment_id": 23,
   "arabic": "وَ أَوْلِيَاءَهُمَا"
  },
  {
   "segment_id": 24,
   "arabic": "وَ أَشْيَاعَهُمَا"
  },
  {
   "segment_id": 25,
   "arabic": "وَ مُحِبِّيهِمَا"
  },
  {
   "segment_id": 26,
   "arabic": "فَقَدْ أَخْرَبَا بَيْتَ النُّبُوَّةِ"
  },
  {
   "segment_id": 27,
   "arabic": "وَ رَدَمَا بَابَهُ"
  },
  {
   "segment_id": 28,
   "arabic": "وَ نَقَضَا سَقْفَهُ"
  },
  {
   "segment_id": 29,
   "arabic": "وَ أَلْحَقَا سَمَاءَهُ بِأَرْضِهِ"
  },
  {
   "segment_id": 30,
   "arabic": "وَ عَالِيَهُ بِسَافِلِهِ"
  },
  {
   "segment_id": 31,
   "arabic": "وَ ظَاهِرَهُ بِبَاطِنِهِ"
  },
  {
   "segment_id": 32,
   "arabic": "وَ اسْتَأْصَلَا أَهْلَهُ"
  },
  {
   "segment_id": 33,
   "arabic": "وَ أَبَادَا أَنْصَارَهُ"
  },
  {
   "segment_id": 34,
   "arabic": "وَ قَتَلَا أَطْفَالَهُ"
  },
  {
   "segment_id": 35,
   "arabic": "وَ أَخْلَيَا مِنْبَرَهُ مِنْ وَصِيِّهِ وَ وَارِثِ عِلْمِهِ"
  },
  {
   "segment_id": 36,
   "arabic": "وَ جَحَدَا إِمَامَتَهُ"
  },
  {
   "segment_id": 37,
   "arabic": "وَ أَشْرَكَا بِرَبِّهِمَا"
  },
  {
   "segment_id": 38,
   "arabic": "فَعَظِّمْ ذَنْبَهُمَا"
  },
  {
   "segment_id": 39,
   "arabic": "وَ خَلِّدْهُمَا فِي سَقَرَ"
  },
  {
   "segment_id": 40,
   "arabic": "وَ مَا أَدْرَاكَ مَا سَقَرُ"
  },
  {
   "segment_id": 41,
   "arabic": "لَا تُبْقِي وَ لَا تَذَرُ"
  },
  {
   "segment_id": 42,
   "arabic": "اَللَّهُمَّ الْعَنْهُمْ بِعَدَدِ كُلِّ مُنْكَرٍ أَتَوْهُ"
  },
  {
   "segment_id": 43,
   "arabic": "وَ حَقٍّ أَخْفَوْهُ"
  },
  {
   "segment_id": 44,
   "arabic": "وَ مِنْبَرٍ عَلَوْهُ"
  },
  {
   "segment_id": 45,
   "arabic": "وَ مُؤْمِنٍ أَرْجَوْهُ"
  },
  {
   "segment_id": 46,
   "arabic": "وَ مُنَافِقٍ وَلَّوْهُ"
  },
  {
   "segment_id": 47,
   "arabic": "وَ وَلِيٍّ آذَوْهُ"
  },
  {
   "segment_id": 48,
   "arabic": "وَ طَرِيدٍ آوَوْهُ"
  },
  {
   "segment_id": 49,
   "arabic": "وَ صَادِقٍ طَرَدُوهُ"
  },
  {
   "segment_id": 50,
   "arabic": "وَ كَافِرٍ نَصَرُوهُ"
  },
  {
   "segment_id": 51,
   "arabic": "وَ إِمَامٍ قَهَرُوهُ"
  },
  {
   "segment_id": 52,
   "arabic": "وَ فَرْضٍ غَيَّرُوهُ"
  },
  {
   "segment_id": 53,
   "arabic": "وَ أَثَرٍ أَنْكَرُوهُ"
  },
  {
   "segment_id": 54,
   "arabic": "وَ شَرٍّ آثَرُوهُ"
  },
  {
   "segment_id": 55,
   "arabic": "وَ دَمٍ أَرَاقُوهُ"
  },
  {
   "segment_id": 56,
   "arabic": "وَ خَيْرٍ بَدَّلُوهُ"
  },
  {
   "segment_id": 57,
   "arabic": "وَ كُفْرٍ نَصَبُوهُ"
  },
  {
   "segment_id": 58,
   "arabic": "وَ كِذْبٍ دَلَّسُوهُ"
  },
  {
   "segment_id": 59,
   "arabic": "وَ إِرْثٍ غَصَبُوهُ"
  },
  {
   "segment_id": 60,
   "arabic": "وَ فَيْءٍ اقْتَطَعُوهُ"
  },
  {
   "segment_id": 61,
   "arabic": "وَ سُحْتٍ أَكَلُوهُ"
  },
  {
   "segment_id": 62,
   "arabic": "وَ خُمْسٍ اسْتَحَلُّوهُ"
  },
  {
   "segment_id": 63,
   "arabic": "وَ بَاطِلٍ أَسَّسُوهُ"
  },
  {
   "segment_id": 64,
   "arabic": "وَ جَوْرٍ بَسَطُوهُ"
  },
  {
   "segment_id": 65,
   "arabic": "وَ نِفَاقٍ أَسَرُّوهُ"
  },
  {
   "segment_id": 66,
   "arabic": "وَ غَدْرٍ أَضْمَرُوهُ"
  },
  {
   "segment_id": 67,
   "arabic": "وَ ظُلْمٍ نَشَرُوهُ"
  },
  {
   "segment_id": 68,
   "arabic": "وَ وَعْدٍ أَخْلَفُوهُ"
  },
  {
   "segment_id": 69,
   "arabic": "وَ أَمَانَةٍ خَانُوهَا"
  },
  {
   "segment_id": 70,
   "arabic": "وَ عَهْدٍ نَقَضُوهُ"
  },
  {
   "segment_id": 71,
   "arabic": "وَ حَلَالٍ حَرَّمُوهُ"
  },
  {
   "segment_id": 72,
   "arabic": "وَ حَرَامٍ أَحَلُّوهُ"
  },
  {
   "segment_id": 73,
   "arabic": "وَ بَطْنٍ فَتَقُوهُ"
  },
  {
   "segment_id": 74,
   "arabic": "وَ جَنِينٍ أَسْقَطُوهُ"
  },
  {
   "segment_id": 75,
   "arabic": "وَ ضِلْعٍ دَقُّوهُ"
  },
  {
   "segment_id": 76,
   "arabic": "وَ صَكٍّ مَزَّقُوهُ"
  },
  {
   "segment_id": 77,
   "arabic": "وَ شَمْلٍ بَدَّدُوهُ"
  },
  {
   "segment_id": 78,
   "arabic": "وَ عَزِيزٍ أَذَلُّوهُ"
  },
  {
   "segment_id": 79,
   "arabic": "وَ ذَلِيلٍ أَعَزُّوهُ"
  },
  {
   "segment_id": 80,
   "arabic": "وَ حَقٍّ مَنَعُوهُ"
  },
  {
   "segment_id": 81,
   "arabic": "وَ كِذْبٍ دَلَّسُوهُ"
  },
  {
   "segment_id": 82,
   "arabic": "وَ حُكْمٍ قَلَّبُوهُ"
  },
  {
   "segment_id": 83,
   "arabic": "وَ إِمَامٍ خَالَفُوهُ"
  },
  {
   "segment_id": 84,
   "arabic": "اَللَّهُمَّ الْعَنْهُمَا بِعَدَدِ كُلِّ آيَةٍ حَرَّفُوهَا"
  },
  {
   "segment_id": 85,
   "arabic": "وَ فَرِيضَةٍ تَرَكُوهَا"
  },
  {
   "segment_id": 86,
   "arabic": "وَ سُنَّةٍ غَيَّرُوهَا"
  },
  {
   "segment_id": 87,
   "arabic": "وَ أَحْكَامٍ عَطَّلُوهَا"
  },
  {
   "segment_id": 88,
   "arabic": "وَ رُسُومٍ قَطَعُوهَا"
  },
  {
   "segment_id": 89,
   "arabic": "وَ وَصِيَّةٍ بَدَّلُوهَا"
  },
  {
   "segment_id": 90,
   "arabic": "وَ أُمُورٍ ضَيَّعُوهَا"
  },
  {
   "segment_id": 91,
   "arabic": "وَ بَيْعَةٍ نَكَثُوهَا"
  },
  {
   "segment_id": 92,
   "arabic": "وَ شَهَادَاتٍ كَتَمُوهَا"
  },
  {
   "segment_id": 93,
   "arabic": "وَ دَعْوَى أَبْطَلُوهَا"
  },
  {
   "segment_id": 94,
   "arabic": "وَ بَيِّنَةٍ أَنْكَرُوهَا"
  },
  {
   "segment_id": 95,
   "arabic": "وَ حِيلَةٍ أَحْدَثُوهَا"
  },
  {
   "segment_id": 96,
   "arabic": "وَ خِيَانَةٍ أَوْرَدُوهَا"
  },
  {
   "segment_id": 97,
   "arabic": "وَ عَقَبَةٍ ارْتَقَوْهَا"
  },
  {
   "segment_id": 98,
   "arabic": "وَ دِبَابٍ دَحْرَجُوهَا"
  },
  {
   "segment_id": 99,
   "arabic": "وَ أَزْيَافٍ لَزِمُوهَا"
  },
  {
   "segment_id": 100,
   "arabic": "اَللَّهُمَّ الْعَنْهُمَا فِي مَكْنُونِ السِّرِّ وَ ظَاهِرِ الْعَلَانِيَةِ"
  },
  {
   "segment_id": 101,
   "arabic": "لَعْنًا كَثِيرًا"
  },
  {
   "segment_id": 102,
   "arabic": "أَبَدًا دَائِمًا دَائِبًا سَرْمَدًا"
  },
  {
   "segment_id": 103,
   "arabic": "لَا انْقِطَاعَ لِأَمَدِهِ"
  },
  {
   "segment_id": 104,
   "arabic": "وَ لَا نَفَادَ لِعَدَدِهِ"
  },
  {
   "segment_id": 105,
   "arabic": "لَعْنًا يَعُودُ أَوَّلُهُ"
  },
  {
   "segment_id": 106,
   "arabic": "وَ لَا يَنْقَطِعُ آخِرُهُ"
  },
  {
   "segment_id": 107,
   "arabic": "لَهُمْ وَ لِأَعْوَانِهِمْ"
  },
  {
   "segment_id": 108,
   "arabic": "وَ أَنْصَارِهِمْ"
  },
  {
   "segment_id": 109,
   "arabic": "وَ مُحِبِّيهِمْ"
  },
  {
   "segment_id": 110,
   "arabic": "وَ مُوَالِيهِمْ"
  },
  {
   "segment_id": 111,
   "arabic": "وَ الْمُسْلِمِينَ لَهُمْ"
  },
  {
   "segment_id": 112,
   "arabic": "وَ الْمَائِلِينَ إِلَيْهِمْ"
  },
  {
   "segment_id": 113,
   "arabic": "وَ النَّاهِقِينَ بِاحْتِجَاجِهِمْ"
  },
  {
   "segment_id": 114,
   "arabic": "وَ النَّاهِضِينَ بِأَجْنِحَتِهِمْ"
  },
  {
   "segment_id": 115,
   "arabic": "وَ الْمُقْتَدِينَ بِكَلَامِهِمْ"
  },
  {
   "segment_id": 116,
   "arabic": "وَ الْمُصَدِّقِينَ بِأَحْكَامِهِمْ"
  },
  {
   "segment_id": 117,
   "arabic": "اَللَّهُمَّ عَذِّبْهُمْ عَذَابًا يَسْتَغِيثُ مِنْهُ أَهْلُ النَّارِ"
  },
  {
   "segment_id": 118,
   "arabic": "آمِينَ رَبَّ الْعَالَمِينَ"
  }
 ]
}