   "arabic": "وَأَسْأَلُهُ بِحَقِّكُمَا أَنْ يَشَاءَ ذٰلِكَ وَيَفْعَلَ"
  },
  {
   "segment_id": 179,
   "arabic": "فَإِنَّهُ حَمِيدٌ مَجِيدٌ"
