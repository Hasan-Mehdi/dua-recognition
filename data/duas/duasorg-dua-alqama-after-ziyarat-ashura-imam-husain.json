   "arabic": "مُنْتَظِراً لِتَنَجُّزِ ٱلْحَاجَةِ"
  },
  {
   "segment_id": 149,
   "arabic": "وَقَضَائِهَا وَنَجَاحِهَا مِنَ ٱللَّهِ"
