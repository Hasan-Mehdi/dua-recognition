  },
  {
   "segment_id": 171,
   "arabic": "إِنْصَرَفْتُ يَا سَيِّدِي يَا أَمِيرَ ٱلْمُؤْمِنِينَ وَمَوْلاَي"
  },
  {
   "segment_id": 172,
   "arabic": "وَأَنْتَ يَا أَبَا عَبْدِ ٱللَّهِ يَا سَيِّدِي"
  },
  {
   "segment_id": 173,
   "arabic": "وَسَلاَمِي عَلَيْكُمَا مُتَّصِلٌ"
  },
  {
