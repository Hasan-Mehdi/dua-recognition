  {
   "segment_id": 141,
   "arabic": "وَمُتَوَجِّهاً إِلَيْهِ بِكُمَا"
  },
  {
   "segment_id": 142,
   "arabic": "وَمُسْتَشْفِعاً بِكُمَا إِلَىٰ ٱللَّهِ تَعَالَىٰ فِي حَاجَتِي هٰذِهِ"
