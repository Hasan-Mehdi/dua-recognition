  {
   "segment_id": 153,
   "arabic": "بَلْ يَكُونُ مُنْقَلَبِي مُنْقَلَباً رَاجِحاً"
  },
  {
   "segment_id": 154,
   "arabic": "مُفْلِحاً مُنْجِحاً مُسْتَجَاباً"
  },
  {
   "segment_id": 155,
   "arabic": "بِقَضَاءِ جَمِيعِ حَوَائِجِي"
