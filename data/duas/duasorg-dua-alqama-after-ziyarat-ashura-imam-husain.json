  {
   "segment_id": 185,
   "arabic": "غَيْرَ رَاغِبٍ عَنْكُمَا وَلاَ عَنْ زِيَارَتِكُمَا"
  },
  {
   "segment_id": 186,
   "arabic": "بَلْ رَاجِعٌ عَائِدٌ إِنْ شَاءَ ٱللَّهُ"
