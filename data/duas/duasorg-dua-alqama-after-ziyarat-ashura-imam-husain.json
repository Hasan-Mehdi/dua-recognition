   "segment_id": 156,
   "arabic": "وَتَشَفَّعَا لِي إِلَىٰ ٱللَّهِ"
  },
  {
   "segment_id": 157,
   "arabic": "إِنْقَلَبْتُ عَلَىٰ مَا شَاءَ ٱللَّهُ"
