   "arabic": "وَمَؤُونَةَ مَا أَخَافُ مَؤُونَتَهُ"
  },
  {
   "segment_id": 119,
   "arabic": "وَهَمَّ مَا أَخَافُ هَمَّهُ"
  },
  {
   "segment_id": 120,
   "arabic": "بِلا مَؤُونَةٍ عَلَىٰ نَفْسِي مِنْ ذٰلِكَ"
  },
  {
   "segment_id": 121,
   "arabic": "وَٱصْرِفْنِي بِقَضَاءِ حَوَائِجِي"
  },
  {
   "segment_id": 122,
   "arabic": "وَكِفَايَةِ مَا أَهَمَّنِي هَمُّهُ"
  },
  {
   "segment_id": 123,
   "arabic": "مِنْ أَمْرِ آخِرَتِي وَدُنْيَايَ"
  },
  {
   "segment_id": 124,
   "arabic": "يَا أَمِيرَ ٱلْمُؤْمِنِينَ"
  },
  {
   "segment_id": 125,
   "arabic": "وَيَا أَبَا عَبْدِ ٱللَّهِ"
  },
  {
   "segment_id": 126,
   "arabic": "عَلَيْكُمَا مِنِّي سَلامُ ٱللَّهِ أَبَداً"
  },
  {
   "segment_id": 127,
   "arabic": "مَا بَقِيتُ وَبَقِيَ ٱللَّيْلُ وَٱلنَّهَارُ"
  },
  {
   "segment_id": 128,
   "arabic": "وَلاَ جَعَلَهُ ٱللَّهُ آخِرَ ٱلْعَهْدِ مِنْ زِيَارَتِكُمَا"
  },
  {
   "segment_id": 129,
   "arabic": "وَلاَ فَرَّقَ ٱللَّهُ بَيْنِي وَبَيْنَكُمَا"
  },
  {
   "segment_id": 130,
   "arabic": "اَللَّهُمَّ أَحْيِنِي حَيَاةَ مُحَمَّدٍ وَذُرِّيَّتِهِ"
  },
  {
   "segment_id": 131,
   "arabic": "وَأَمِتْنِي مَمَاتَهُمْ"
