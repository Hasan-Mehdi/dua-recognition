   "arabic": "مَا ٱتَّصَلَ ٱللَّيْلُ وَٱلنَّهَارُ"
  },
  {
   "segment_id": 175,
   "arabic": "وَاصِلٌ ذٰلِكَ إِلَيْكُمَا"
