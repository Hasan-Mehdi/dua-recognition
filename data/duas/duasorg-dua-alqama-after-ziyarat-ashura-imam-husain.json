   "arabic": "وَٱحْشُرْنِي فِي زُمْرَتِهِمْ"
  },
  {
   "segment_id": 134,
   "arabic": "وَلاَ تُفَرِّقْ بَيْنِي وَبَيْنَهُمْ"
  },
  {
   "segment_id": 135,
   "arabic": "طَرْفَةَ عَيْنٍ أَبَداً"
  },
  {
   "segment_id": 136,
   "arabic": "فِي ٱلدُّنْيَا وَٱلآخِرَةِ"
  },
  {
   "segment_id": 137,
   "arabic": "يَا أَمِيرَ ٱلْمُؤْمِنِينَ"
  },
  {
   "segment_id": 138,
   "arabic": "وَيَا أَبَا عَبْدِ ٱللَّهِ"
  },
  {
   "segment_id": 139,
   "arabic": "أَتَيْتُكُمَا زَائِراً"
  },
  {
   "segment_id": 140,
   "arabic": "وَمُتَوَسِّلاً إِلَىٰ ٱللَّهِ رَبِّي وَرَبِّكُمَا"
