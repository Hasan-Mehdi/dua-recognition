   "arabic": "مُلْجِئاً ظَهْرِي إِلَىٰ ٱللَّهِ"
  },
  {
   "segment_id": 161,
   "arabic": "مُتَوَكِّلاً عَلَىٰ ٱللَّهِ"
  },
  {
   "segment_id": 162,
   "arabic": "وَأَقُولُ حَسْبِيَ ٱللَّهُ وَكَفَىٰ"
  },
  {
   "segment_id": 163,
   "arabic": "سَمِعَ ٱللَّهُ لِمَنْ دَعَا"
