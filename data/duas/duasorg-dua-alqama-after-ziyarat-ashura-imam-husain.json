   "segment_id": 164,
   "arabic": "لَيْسَ لِي وَرَاءَ ٱللَّهِ"
  },
  {
   "segment_id": 165,
   "arabic": "وَوَرَاءَكُمْ يَا سَادَتِي مُنْتَهَىٰ"
  },
  {
   "segment_id": 166,
   "arabic": "مَا شَاءَ رَبِّي كَانَ"
  },
  {
   "segment_id": 167,
   "arabic": "وَمَا لَمْ يَشَأْ لَمْ يَكُنْ"
