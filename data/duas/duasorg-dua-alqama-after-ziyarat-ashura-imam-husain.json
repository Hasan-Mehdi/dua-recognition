  {
   "segment_id": 168,
   "arabic": "وَلاَ حَوْلَ وَلاَ قُوَّةَ إِلاَّ بِٱللَّهِ"
  },
  {
   "segment_id": 169,
   "arabic": "أَسْتَوْدِعُكُمَا ٱللَّهَ"
