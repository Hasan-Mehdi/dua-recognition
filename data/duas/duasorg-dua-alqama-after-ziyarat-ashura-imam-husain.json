{
 "dua_id": "duasorg-dua-alqama-after-ziyarat-ashura-imam-husain",
 "dua_name_en": "Dua Alqama (Safwan)",
 "dua_name_ar": "",
 "source": "https://www.duas.org/dua-alqama-after-ziyarat-ashura-imam-husain.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "يَا اللَّهُ يَا اللَّهُ يَا اللَّهُ"
  },
  {
   "segment_id": 2,
   "arabic": "يَا مُجِيبَ دَعْوَةِ ٱلْمُضْطَرِّينَ"
  },
  {
   "segment_id": 3,
   "arabic": "يَا كَاشِفَ كُرَبِ ٱلْمَكْرُوبِينَ"
  },
  {
   "segment_id": 4,
   "arabic": "يَا غِيَاثَ ٱلْمُسْتَغِيثِينَ"
  },
  {
   "segment_id": 5,
   "arabic": "يَا صَرِيخَ ٱلْمُسْتَصْرِخِينَ"
  },
  {
   "segment_id": 6,
   "arabic": "وَيَا مَنْ هُوَ أَقْرَبُ إِلَيَّ مِنْ حَبْلِ ٱلْوَرِيدِ"
  },
  {
   "segment_id": 7,
   "arabic": "وَيَا مَنْ يَحُولُ بَيْنَ ٱلْمَرْءِ وَقَلْبِهِ"
  },
  {
   "segment_id": 8,
   "arabic": "وَيَا مَنْ هُوَ بِٱلْمَنْظَرِ ٱلأَعْلَىٰ وَبِٱلأُفُقِ ٱلْمُبِينِ"
  },
  {
   "segment_id": 9,
   "arabic": "وَيَا مَنْ هُوَ ٱلرَّحْمٰنُ ٱلرَّحِيمُ عَلَىٰ ٱلْعَرْشِ ٱسْتَوَىٰ"
  },
  {
   "segment_id": 10,
   "arabic": "وَيَا مَنْ يَعْلَمُ خَائِنَةَ ٱلأَعْيُنِ وَمَا تُخْفِي ٱلصُّدُورُ"
  },
  {
   "segment_id": 11,
   "arabic": "وَيَا مَنْ لاَ يَخْفَىٰ عَلَيْهِ خَافِيَةٌ"
  },
  {
   "segment_id": 12,
   "arabic": "يَا مَنْ لاَ تَشْتَبِهُ عَلَيْهِ ٱلأَصْوَاتُ"
  },
  {
   "segment_id": 13,
   "arabic": "وَيَا مَنْ لاَ تُغَلِّطُهُ ٱلْحَاجَاتُ"
  },
  {
   "segment_id": 14,
   "arabic": "وَيَا مَنْ لاَ يُبْرِمُهُ إِلْحَاحُ ٱلْمُلِحِّينَ"
  },
  {
   "segment_id": 15,
   "arabic": "يَا مُدْرِكَ كُلِّ فَوْتٍ"
  },
  {
   "segment_id": 16,
   "arabic": "وَيَا جَامِعَ كُلِّ شَمْلٍ"
  },
  {
   "segment_id": 17,
   "arabic": "وَيَا بَارِئَ ٱلنُّفُوسِ بَعْدَ ٱلْمَوْتِ"
  },
  {
   "segment_id": 18,
   "arabic": "يَا مَنْ هُوَ كُلِّ يَوْمٍ فِي شَأْنٍ"
  },
  {
   "segment_id": 19,
   "arabic": "يَا قَاضِيَ ٱلْحَاجَاتِ"
  },
  {
   "segment_id": 20,
   "arabic": "يَا مُنَفِّسَ ٱلْكُرُبَاتِ"
  },
  {
   "segment_id": 21,
   "arabic": "يَا مُعْطِيَ ٱلسُّؤُلاَتِ"
  },
  {
   "segment_id": 22,
   "arabic": "يَا وَلِيَّ ٱلرَّغَبَاتِ"
  },
  {
   "segment_id": 23,
   "arabic": "يَا كَافِيَ ٱلْمُهِمَّاتِ"
  },
  {
   "segment_id": 24,
   "arabic": "يَا مَنْ يَكْفِي مِنْ كُلِّ شَيْءٍ"
  },
  {
   "segment_id": 25,
   "arabic": "وَلاَ يَكْفِي مِنْهُ شَيْءٌ فِي ٱلسَّمَاوَاتِ وَٱلأَرْضِ"
  },
  {
   "segment_id": 26,
   "arabic": "أَسْأَلُكَ بِحَقِّ مُحَمَّدٍ خَاتَمِ ٱلنَّبِيِّينَ"
  },
  {
   "segment_id": 27,
   "arabic": "وَعَلِيٍّ أَمِيرِ ٱلْمُؤْمِنِينَ"
  },
  {
   "segment_id": 28,
   "arabic": "وَبِحَقِّ فَاطِمَةَ بِنْتِ نَبِيِّكَ"
  },
  {
   "segment_id": 29,
   "arabic": "وَبِحَقِّ ٱلْحَسَنِ وَٱلْحُسَيْنِ"
  },
  {
   "segment_id": 30,
   "arabic": "فَإِنِّي بِهِمْ أَتَوَجَّهُ إِلَيْكَ فِي مَقَامِي هٰذَا"
  },
  {
   "segment_id": 31,
   "arabic": "وَبِهِمْ أَتَوَسَّلُ"
  },
  {
   "segment_id": 32,
   "arabic": "وَبِهِمْ أَتَشَفَّعُ إِلَيْكَ"
  },
  {
   "segment_id": 33,
   "arabic": "وَبِحَقِّهِمْ أَسْأَلُكَ وَأُقْسِمُ وَأَعْزِمُ عَلَيْكَ"
  },
  {
   "segment_id": 34,
   "arabic": "وَبِٱلشَّأْنِ ٱلَّذِي لَهُمْ عِنْدَكَ"
  },
  {
   "segment_id": 35,
   "arabic": "وَبِٱلْقَدْرِ ٱلَّذِي لَهُمْ عِنْدَكَ"
  },
  {
   "segment_id": 36,
   "arabic": "وَبِٱلَّذِي فَضَّلْتَهُمْ عَلَىٰ ٱلْعَالَمِينَ"
  },
  {
   "segment_id": 37,
   "arabic": "وَبِٱسْمِكَ ٱلَّذِي جَعَلْتَهُ عِنْدَهُمْ"
  },
  {
   "segment_id": 38,
   "arabic": "وَبِهِ خَصَصْتَهُمْ دُونَ ٱلْعَالَمِينَ"
  },
  {
   "segment_id": 39,
   "arabic": "وَبِهِ أَبَنْتَهُمْ"
  },
  {
   "segment_id": 40,
   "arabic": "وَأَبَنْتَ فَضْلَهُمْ مِنْ فَضْلِ ٱلْعَالَمِينَ"
  },
  {
   "segment_id": 41,
   "arabic": "حَتَّىٰ فَاقَ فَضْلُهُمْ فَضْلَ ٱلْعَالَمِينَ جَمِيعاً"
  },
  {
   "segment_id": 42,
   "arabic": "أَسْأَلُكَ أَنْ تُصَلِّيَ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 43,
   "arabic": "وَأَنْ تَكْشِفَ عَنِّي غَمِّي"
  },
  {
   "segment_id": 44,
   "arabic": "وَهَمِّي وَكَرْبِي"
  },
  {
   "segment_id": 45,
   "arabic": "وَتَكْفِيَنِي ٱلْمُهِمَّ مِنْ أُمُورِي"
  },
  {
   "segment_id": 46,
   "arabic": "وَتَقْضِيَ عَنِّي دَيْنِي"
  },
  {
   "segment_id": 47,
   "arabic": "وَتُجِيـرَنِي مِنَ ٱلْفَقْرِ"
  },
  {
   "segment_id": 48,
   "arabic": "وَتُجِيـرَنِي مِنَ ٱلْفَاقَةِ"
  },
  {
   "segment_id": 49,
   "arabic": "وَتُغْنِيَنِي عَنِ ٱلْمَسْأَلَةِ إِلَىٰ ٱلْمَخْلُوقِينَ"
  },
  {
   "segment_id": 50,
   "arabic": "وَتَكْفِيَنِي هَمَّ مَنْ أَخَافُ هَمَّهُ"
  },
  {
   "segment_id": 51,
   "arabic": "وَعُسْرَ مَنْ أَخَافُ عُسْرَهُ"
  },
  {
   "segment_id": 52,
   "arabic": "وَحُزُونَةَ مَنْ أَخَافُ حُزُونَتَهُ"
  },
  {
   "segment_id": 53,
   "arabic": "وَشَرَّ مَنْ أَخَافُ شَرَّهُ"
  },
  {
   "segment_id": 54,
   "arabic": "وَمَكْرَ مَنْ أَخَافُ مَكْرَهُ"
  },
  {
   "segment_id": 55,
   "arabic": "وَبَغْيَ مَنْ أَخَافُ بَغْيَهُ"
  },
  {
   "segment_id": 56,
   "arabic": "وَجَوْرَ مَنْ أَخَافُ جَوْرَهُ"
  },
  {
   "segment_id": 57,
   "arabic": "وَسُلْطَانَ مَنْ أَخَافُ سُلْطَانَهُ"
  },
  {
   "segment_id": 58,
   "arabic": "وَكَيْدَ مَنْ أَخَافُ كَيْدَهُ"
  },
  {
   "segment_id": 59,
   "arabic": "وَمَقْدُرَةَ مَنْ أَخَافُ مَقْدُرَتَهُ عَلَيَّ"
  },
  {
   "segment_id": 60,
   "arabic": "وَتَرُدَّ عَنِّي كَيْدَ ٱلْكَيَدَةِ"
  },
  {
   "segment_id": 61,
   "arabic": "وَمَكْرَ ٱلْمَكَرَةِ"
  },
  {
   "segment_id": 62,
   "arabic": "اَللَّهُمَّ مَنْ أَرَادَنِي فَأَرِدْهُ"
  },
  {
   "segment_id": 63,
   "arabic": "وَمَنْ كَادَنِي فَكِدْهُ"
  },
  {
   "segment_id": 64,
   "arabic": "وَٱصْرِفْ عَنِّي كَيْدَهُ وَمَكْرَهُ"
  },
  {
   "segment_id": 65,
   "arabic": "وَبَأْسَهُ وَأَمَانِيَّهُ"
  },
  {
   "segment_id": 66,
   "arabic": "وَٱمْنَعْهُ عَنِّي كَيْفَ شِئْتَ وَأَنَّىٰ شِئْتَ"
  },
  {
   "segment_id": 67,
   "arabic": "اَللَّهُمَّ أَشْغِلْهُ عَنِّي"
  },
  {
   "segment_id": 68,
   "arabic": "بِفَقْرٍ لاَ تَجْبُرُهُ"
  },
  {
   "segment_id": 69,
   "arabic": "وَبِبَلاءٍ لاَ تَسْتُرُهُ"
  },
  {
   "segment_id": 70,
   "arabic": "وَبِفَاقَةٍ لاَ تَسُدُّهَا"
  },
  {
   "segment_id": 71,
   "arabic": "وَبِسُقْمٍ لاَ تُعَافِيهِ"
  },
  {
   "segment_id": 72,
   "arabic": "وَذُلٍّ لاَ تُعِزُّهُ"
  },
  {
   "segment_id": 73,
   "arabic": "وَبِمَسْكَنَةٍ لاَ تَجْبُرُهَا"
  },
  {
   "segment_id": 74,
   "arabic": "اَللَّهُمَّ ٱضْرِبْ بِٱلذُّلِّ نَصْبَ عَيْنَيْهِ"
  },
  {
   "segment_id": 75,
   "arabic": "وَأَدْخِلْ عَلَيْهِ ٱلْفَقْرَ فِي مَنْزِلِهِ"
  },
  {
   "segment_id": 76,
   "arabic": "وَٱلْعِلَّةَ وَٱلسُّقْمَ فِي بَدَنِهِ"
  },
  {
   "segment_id": 77,
   "arabic": "حَتَّىٰ تَشْغَلَهُ عَنِّي بِشُغْلٍ شَاغِلٍ لاَ فَرَاغَ لَهُ"
  },
  {
   "segment_id": 78,
   "arabic": "وَأَنْسِهِ ذِكْرِي كَمَا أَنْسَيْتَهُ ذِكْرَكَ"
  },
  {
   "segment_id": 79,
   "arabic": "وَخُذْ عَنِّي بِسَمْعِهِ وَبَصَرِهِ"
  },
  {
   "segment_id": 80,
   "arabic": "وَلِسَانِهِ وَيَدِهِ"
  },
  {
   "segment_id": 81,
   "arabic": "وَرِجْلِهِ وَقَلْبِهِ"
  },
  {
   "segment_id": 82,
   "arabic": "وَجَمِيعِ جَوَارِحِهِ"
  },
  {
   "segment_id": 83,
   "arabic": "وَأَدْخِلْ عَلَيْهِ فِي جَمِيعِ ذٰلِكَ ٱلسُّقْمَ"
  },
  {
   "segment_id": 84,
   "arabic": "وَلا تَشْفِهِ حَتَّىٰ تَجْعَلَ ذٰلِكَ لَهُ شُغْلاً شَاغِلاً بِهِ"
  },
  {
   "segment_id": 85,
   "arabic": "عَنِّي وَعَنْ ذِكْرِي"
  },
  {
   "segment_id": 86,
   "arabic": "وَٱكْفِنِي يَا كَافِي مَا لاَ يَكْفِي سِوَاكَ"
  },
  {
   "segment_id": 87,
   "arabic": "فَإِنَّكَ ٱلْكَافِي لاَ كَافِيَ سِوَاكَ"
  },
  {
   "segment_id": 88,
   "arabic": "وَمُفَرِّجٌ لاَ مُفَرِّجَ سِوَاكَ"
  },
  {
   "segment_id": 89,
   "arabic": "وَمُغِيثٌ لاَ مُغِيثَ سِوَاكَ"
  },
  {
   "segment_id": 90,
   "arabic": "وَجَارٌ لاَ جَارَ سِوَاكَ"
  },
  {
   "segment_id": 91,
   "arabic": "خَابَ مَنْ كَانَ جَارُهُ سِوَاكَ"
  },
  {
   "segment_id": 92,
   "arabic": "وَمُغِيثُهُ سِوَاكَ"
  },
  {
   "segment_id": 93,
   "arabic": "وَمَفْزَعُهُ إِلَىٰ سِوَاكَ"
  },
  {
   "segment_id": 94,
   "arabic": "وَمَهْرَبُهُ إِلَىٰ سِوَاكَ"
  },
  {
   "segment_id": 95,
   "arabic": "وَمَلْجَأُهُ إِلَىٰ غَيْرِكَ"
  },
  {
   "segment_id": 96,
   "arabic": "وَمَنْجَاهُ مِنْ مَخْلُوقٍ غَيْرِكَ"
  },
  {
   "segment_id": 97,
   "arabic": "فَأَنْتَ ثِقَتِي وَرَجَائِي"
  },
  {
   "segment_id": 98,
   "arabic": "وَمَفْزَعِي وَمَهْرَبِي"
  },
  {
   "segment_id": 99,
   "arabic": "وَمَلْجَإِي وَمَنْجَايَ"
  },
  {
   "segment_id": 100,
   "arabic": "فَبِكَ أَسْتَفْتِحُ"
  },
  {
   "segment_id": 101,
   "arabic": "وَبِكَ أَسْتَنْجِحُ"
  },
  {
   "segment_id": 102,
   "arabic": "وَبِمُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 103,
   "arabic": "أَتَوَجَّهُ إِلَيْكَ وَأَتَوَسَّلُ وَأَتَشَفَّعُ"
  },
  {
   "segment_id": 104,
   "arabic": "فَأَسْأَلُكَ يَا اللَّهُ يَا اللَّهُ يَا اللَّهُ"
  },
  {
   "segment_id": 105,
   "arabic": "فَلَكَ ٱلْحَمْدُ وَلَكَ ٱلشُّكْرُ"
  },
  {
   "segment_id": 106,
   "arabic": "وَإِلَيْكَ ٱلْمُشْتَكَىٰ وَأَنْتَ ٱلْمُسْتَعَانُ"
  },
  {
   "segment_id": 107,
   "arabic": "فَأَسْأَلُكَ يَا اللَّهُ يَا اللَّهُ يَا اللَّهُ"
  },
  {
   "segment_id": 108,
   "arabic": "بِحَقِّ مُحَمَّـدٍ وَآلِ مُحَمَّـدٍ"
  },
  {
   "segment_id": 109,
   "arabic": "أَنْ تُصَلِّيَ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 110,
   "arabic": "وَأَنْ تَكْشِفَ عَنِّي غَمِّي وَهَمِّي وَكَرْبِي"
  },
  {
   "segment_id": 111,
   "arabic": "فِي مَقَامِي هٰذَا"
  },
  {
   "segment_id": 112,
   "arabic": "كَمَا كَشَفْتَ عَنْ نَبِيِّكَ هَمَّهُ وَغَمَّهُ وَكَرْبَهُ"
  },
  {
   "segment_id": 113,
   "arabic": "وَكَفَيْتَهُ هَوْلَ عَدُوِّهِ"
  },
  {
   "segment_id": 114,
   "arabic": "فَٱكْشِفْ عَنِّي كَمَا كَشَفْتَ عَنْهُ"
  },
  {
   "segment_id": 115,
   "arabic": "وَفَرِّجْ عَنِّي كَمَا فَرَّجْتَ عَنْهُ"
  },
  {
   "segment_id": 116,
   "arabic": "وَٱكْفِنِي كَمَا كَفَيْتَهُ"
  },
  {
   "segment_id": 117,
   "arabic": "وَٱصْرِفْ عَنِّي هَوْلَ مَا أَخَافُ هَوْلَهُ"
  },
  {
