{
 "dua_id": "dua-allahuma-ya-man-yaml",
 "dua_name_en": "Dua Allahuma Ya Man Yamliku",
 "dua_name_ar": "اللّهُم يا مَن يملك",
 "source": "https://www.duaplayer.org/en/dua/allahuma-ya-man-yaml",
 "segments": [
  {
   "segment_id": 1,
   "arabic": ""
  },
  {
   "segment_id": 2,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 3,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 4,
   "arabic": "اللّهُمّ يَا مَنْ يَمْلِكُ التّدْبِيرَ"
  },
  {
   "segment_id": 5,
   "arabic": "وَهُوَ عَلَى كُلّ شَيْءٍ قَدِيرٌ،"
  },
  {
   "segment_id": 6,
   "arabic": "يَا مَنْ يَعْلَمُ خَائِنَةَ الأَعْيُنِ"
  },
  {
   "segment_id": 7,
   "arabic": "وَمَا تُخْفِي الصّدُورُ وَتُجِنّ الضّمِيرُ"
  },
  {
   "segment_id": 8,
   "arabic": "وَهُوَ اللّطِيفُ الخَبِيرُ."
  },
  {
   "segment_id": 9,
   "arabic": "اللّهُمّ اجْعَلْنَا مِمّنْ نَوَى فَعَمِلَ،"
  },
  {
   "segment_id": 10,
   "arabic": "وَلا تَجْعَلْنَا مِمّنْ شَقِيَ فَكَسِلَ،"
  },
  {
   "segment_id": 11,
   "arabic": "وَلا مِمّنْ هُوَ عَلَى غَيْرِ عَمَلٍ يَتّكِلُ."
  },
  {
   "segment_id": 12,
   "arabic": "اللّهُمّ صَحّحْ أَبْدَانَنَا مِنَ العِلَلِ،"
  },
  {
   "segment_id": 13,
   "arabic": "وَأَعِنَّا عَلَى مَا افْتَرَضْتَ عَلَيْنَا مِنَ العَمَلِ،"
  },
  {
   "segment_id": 14,
   "arabic": "حَتَّى يَنْقَضِيَ عَنَّا شَهْرُكَ هذَا وَقَدْ أَدّيْنَا مَفْرُوضَكَ فِيهِ عَلَيْنَا."
  },
  {
   "segment_id": 15,
   "arabic": "اللّهُمّ أَعِنَّا عَلَى صِيَامِهِ،"
  },
  {
   "segment_id": 16,
   "arabic": "وَوَفّقْنَا لِقِيَامِهِ،"
  },
  {
   "segment_id": 17,
   "arabic": "وَنَشّطْنَا فِيهِ لِلصّلاةِ،"
  },
  {
   "segment_id": 18,
   "arabic": "وَلا تَحْجُبْنَا مِنَ القِرَاءَةِ،"
  },
  {
   "segment_id": 19,
   "arabic": "وَسَهّلْ لَنَا فِيهِ إيتَاءَ الزّكَاةِ."
  },
  {
   "segment_id": 20,
   "arabic": "اللّهُمّ لا تُسَلّطْ عَلَيْنَا وَصَباً وَلا تَعَباً"
  },
  {
   "segment_id": 21,
   "arabic": "وَلا سَقَماً وَلا عَطَباً."
  },
  {
   "segment_id": 22,
   "arabic": "اللّهُمّ ارْزُقْنَا الإفْطَارَ مِنْ رِزْقِكَ الحَلالِ."
  },
  {
   "segment_id": 23,
   "arabic": "اللّهُمّ سَهّلْ لَنَا فِيهِ مَا قَسَمْتَهُ مِنْ رِزْقِكَ،"
  },
  {
   "segment_id": 24,
   "arabic": "وَيَسّرْ مَا قَدّرْتَهُ مِنْ أَمْرِكَ،"
  },
  {
   "segment_id": 25,
   "arabic": "وَاجْعَلْهُ حَلالاً طَيّباً نَقِيّاً مِنَ الآثَامِ،"
  },
  {
   "segment_id": 26,
   "arabic": "خَالِصاً مِنَ الآصَارِ وَالأَجْرَامِ."
  },
  {
   "segment_id": 27,
   "arabic": "اللّهُمّ لا تُطْعِمْنَا إلاَّ طَيّباً غَيْرَ خَبِيثٍ وَلا حَرَامٍ،"
  },
  {
   "segment_id": 28,
   "arabic": "وَاجْعَلْ رِزْقَكَ لَنَا حَلالاً لا يَشُوبُهُ دَنَسٌ وَلا أَسْقَامٌ،"
  },
  {
   "segment_id": 29,
   "arabic": "يَا مَنْ عِلْمُهُ بِالسّرّ كَعِلْمِهِ بِالإعْلانِ،"
  },
  {
   "segment_id": 30,
   "arabic": "يَا مُتَفَضّلاً عَلَى عِبَادِهِ بِالإحْسَانِ،"
  },
  {
   "segment_id": 31,
   "arabic": "يَا مَنْ هُوَ عَلَى كُلّ شَيْءٍ قَدِيرٌ،"
  },
  {
   "segment_id": 32,
   "arabic": "وَبِكُلّ شَيْءٍ عَلِيمٌ خَبِيرٌ،"
  },
  {
   "segment_id": 33,
   "arabic": "أَلْهِمْنَا ذِكْرَكَ،"
  },
  {
   "segment_id": 34,
   "arabic": "وَجَنّبْنَا عُسْرَكَ،"
  },
  {
   "segment_id": 35,
   "arabic": "وَأَنِلْنَا يُسْرَكَ،"
  },
  {
   "segment_id": 36,
   "arabic": "وَاهْدِنَا لِلرّشَادِ،"
  },
  {
   "segment_id": 37,
   "arabic": "وَوَفّقْنَا لِلسّدَادِ،"
  },
  {
   "segment_id": 38,
   "arabic": "وَاعْصِمْنَا مِنَ البَلايَا،"
  },
  {
   "segment_id": 39,
   "arabic": "وَصُنَّا مِنَ الأَوْزَارِ وَالخَطَايَا،"
  },
  {
   "segment_id": 40,
   "arabic": "يَا مَنْ لا يَغْفِرُ عَظِيمَ الذّنُوبِ غَيْرُهُ،"
  },
  {
   "segment_id": 41,
   "arabic": "وَلا يَكْشِفُ السّوءَ إلاَّ هُوَ،"
  },
  {
   "segment_id": 42,
   "arabic": "يَا أَرْحَمَ الرَّاحِمِينَ،"
  },
  {
   "segment_id": 43,
   "arabic": "وَأَكْرَمَ الأَكْرَمِينَ،"
  },
  {
   "segment_id": 44,
   "arabic": "صَلّ عَلَى مُحَمّدٍ وَأَهْلِ بَيْتِهِ الطّيّبِينَ،"
  },
  {
   "segment_id": 45,
   "arabic": "وَاجْعَلْ صِيَامَنَا مَقْبُولاً،"
  },
  {
   "segment_id": 46,
   "arabic": "وَبِالبِرّ وَالتّقْوَى مَوْصُولاً،"
  },
  {
   "segment_id": 47,
   "arabic": "وَكَذلِكَ فَاجْعَلْ سَعْيَنَا مَشْكُوراً،"
  },
  {
   "segment_id": 48,
   "arabic": "وَقِيَامَنَا مَبْرُوراً،"
  },
  {
   "segment_id": 49,
   "arabic": "وَقُرْآنَنَا مَرْفُوعاً،"
  },
  {
   "segment_id": 50,
   "arabic": "وَدُعَاءَنَا مَسْمُوعاً،"
  },
  {
   "segment_id": 51,
   "arabic": "وَاهْدِنَا لِلْحُسْنَى،"
  },
  {
   "segment_id": 52,
   "arabic": "وَجَنّبْنَا العُسْرَى،"
  },
  {
   "segment_id": 53,
   "arabic": "وَيَسّرْنَا لِلْيُسْرَى،"
  },
  {
   "segment_id": 54,
   "arabic": "وَأَعْلِ لَنَا الدّرَجَاتِ،"
  },
  {
   "segment_id": 55,
   "arabic": "وَضَاعِفْ لَنَا الحَسَنَاتِ،"
  },
  {
   "segment_id": 56,
   "arabic": "وَاقْبَلْ مِنَّا الصّوْمَ وَالصّلاةَ،"
  },
  {
   "segment_id": 57,
   "arabic": "وَاسْمَعْ مِنَّا الدّعَوَاتِ،"
  },
  {
   "segment_id": 58,
   "arabic": "وَاغْفِرْ لَنَا الخَطِيئَاتِ،"
  },
  {
   "segment_id": 59,
   "arabic": "وَتَجَاوَزْ عَنَّا السّيّئَاتِ،"
  },
  {
   "segment_id": 60,
   "arabic": "وَاجْعَلْنَا مِنَ العَامِلِينَ الفَائِزِينَ،"
  },
  {
   "segment_id": 61,
   "arabic": "وَلا تَجْعَلْنَا مِنَ المَغْضُوبِ عَلَيْهِمْ وَلا الضَّالّينَ،"
  },
  {
   "segment_id": 62,
   "arabic": "حَتَّى يَنْقَضِيَ شَهْرُ رَمَضَانَ عَنَّا"
  },
  {
   "segment_id": 63,
   "arabic": "وَقَدْ قَبِلْتَ فِيهِ صِيَامَنَا وَقِيَامَنَا،"
  },
  {
   "segment_id": 64,
   "arabic": "وَزَكّيْتَ فِيهِ أَعْمَالَنَا،"
  },
  {
   "segment_id": 65,
   "arabic": "وَغَفَرْتَ فِيهِ ذُنُوبَنَا،"
  },
  {
   "segment_id": 66,
   "arabic": "وَأَجْزَلْتَ فِيهِ مِنْ كُلّ خَيْرٍ نَصِيبَنَا،"
  },
  {
   "segment_id": 67,
   "arabic": "فَإنّكَ الإلهُ المُجِيبُ،"
  },
  {
   "segment_id": 68,
   "arabic": "وَالرّبّ القَرِيبُ،"
  },
  {
   "segment_id": 69,
   "arabic": "وَأَنْتَ بِكُلّ شَيْءٍ مُحِيطٌ."
  }
 ]
}