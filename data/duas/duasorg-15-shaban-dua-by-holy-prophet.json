{
 "dua_id": "duasorg-15-shaban-dua-by-holy-prophet",
 "dua_name_en": "Dua by Holy Prophet(sawa) - 15th Sha'aban",
 "dua_name_ar": "",
 "source": "https://www.duas.org/15-shaban-dua-by-holy-prophet.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللّهُمَّ اقْسِمْ لَنَا مِنْ خَشْيَتِكَ"
  },
  {
   "segment_id": 2,
   "arabic": "مَا يَحُولُ بَيْنَنَا وَبَيْنَ مَعْصِيَتِكَ،"
  },
  {
   "segment_id": 3,
   "arabic": "وَمِنْ طَاعَتِكَ مَا تُبَلِّغُنَا بِهِ رِضْوَانَكَ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَمِنَ الْيَقِينِ مَا يَهُونُ عَلَيْنَا بِهِ مُصِيبَاتُ الدُّنْيَا."
  },
  {
   "segment_id": 5,
   "arabic": "اللّهُمَّ أَمْتِعْنَا بِأَسْمَاعِنَا وَأَبْصَارِنَا وَقُوَّتِنَا"
  },
  {
   "segment_id": 6,
   "arabic": "مَا أَحْيَيْتَنَا وَاجْعَلْهُ الْوَارِثَ مِنَّا،"
  },
  {
   "segment_id": 7,
   "arabic": "وَاجْعَلْ ثأْرَنَا عَلَى مَنْ ظَلَمَنَا،"
  },
  {
   "segment_id": 8,
   "arabic": "وَانْصُرْنَا عَلَى مَنْ عَادَانَا،"
  },
  {
   "segment_id": 9,
   "arabic": "وَلا تَجْعَلْ مُصِيبَتَنَا فِي دِينِنَا،"
  },
  {
   "segment_id": 10,
   "arabic": "وَلا تَجْعَلِ الدُّنْيَا أَكْبَرَ هَمِّنَا وَلا مَبْلَغَ عِلْمِنَا،"
  },
  {
   "segment_id": 11,
   "arabic": "وَلا تُسَلِّطْ عَلَيْنَا مَنْ لا يَرْحَمُنَا،"
  },
  {
   "segment_id": 12,
   "arabic": "بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِينَ."
  }
 ]
}