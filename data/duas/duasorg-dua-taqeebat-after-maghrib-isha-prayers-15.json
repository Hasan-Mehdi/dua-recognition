{
 "dua_id": "duasorg-dua-taqeebat-after-maghrib-isha-prayers-15",
 "dua_name_en": "Dua Before Maghrib Salaat (between Adhan and Iqamah)",
 "dua_name_ar": "",
 "source": "https://www.duas.org/dua-taqeebat-after-maghrib-isha-prayers.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللَّهُمَّ إِنِّي اسْالُكَ بِإِقْبَالِ لَيْلِكَ"
  },
  {
   "segment_id": 2,
   "arabic": "وَإِدْبَارِ نَهَارِكَ"
  },
  {
   "segment_id": 3,
   "arabic": "وَحُضُورِ صَلَوَاتِكَ"
  },
  {
   "segment_id": 4,
   "arabic": "وَاصْوَاتِ دُعَاتِكَ"
  },
  {
   "segment_id": 5,
   "arabic": "وَتَسْبِيحِ مَلاَئِكَتِكَ"
  },
  {
   "segment_id": 6,
   "arabic": "انْ تُصَلِّيَ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 7,
   "arabic": "وَانْ تَتُوْبَ عَلَيَّ"
  },
  {
   "segment_id": 8,
   "arabic": "إِنَّكَ انْتَ ٱلتَّوَّابُ ٱلرَّحِيمُ"
  }
 ]
}