{
 "dua_id": "duasorg-rabi-al-akher-month-start-5",
 "dua_name_en": "Instruction Block",
 "dua_name_ar": "",
 "source": "https://www.duas.org/rabi-al-akher-month-start.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "فَهَلْ يَنْظُرُونَ إِلَّا السَّاعَةَ أَنْ تَأْتِيَهُمْ بَغْتَةً"
  },
  {
   "segment_id": 2,
   "arabic": "فَقَدْ جَاءَ أَشْرَاطُهَا ۚ فَأَنَّىٰ لَهُمْ إِذَا جَاءَتْهُمْ ذِكْرَاهُمْ"
  },
  {
   "segment_id": 3,
   "arabic": "فَاعْلَمْ أَنَّهُ لَا إِلَٰهَ إِلَّا اللَّهُ"
  },
  {
   "segment_id": 4,
   "arabic": "وَاسْتَغْفِرْ لِذَنْبِكَ وَلِلْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ"
  },
  {
   "segment_id": 5,
   "arabic": "وَاللَّهُ يَعْلَمُ مُتَقَلَّبَكُمْ وَمَثْوَاكُمْ"
  }
 ]
}