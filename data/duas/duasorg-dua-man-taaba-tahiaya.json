{
 "dua_id": "duasorg-dua-man-taaba-tahiaya",
 "dua_name_en": "Dua Man Taaba Tahiya",
 "dua_name_ar": "",
 "source": "https://www.duas.org/dua-man-taaba-tahiaya.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللَّهُمَّ مَنْ تَعَبَّا وَتَهَيَّا"
  },
  {
   "segment_id": 2,
   "arabic": "وَاعَدَّ وَٱسْتَعَدَّ"
  },
  {
   "segment_id": 3,
   "arabic": "لِوِفَادَةٍ إِلَىٰ مَخْلُوقٍ"
  },
  {
   "segment_id": 4,
   "arabic": "رَجَاءَ رِفْدِهِ"
  },
  {
   "segment_id": 5,
   "arabic": "وَطَلَبَ نَائِلِهِ وَجَائِزَتِهِ"
  },
  {
   "segment_id": 6,
   "arabic": "فَإلَيْكَ يَا رَبِّ تَعْبِيَتِي وَٱسْتِعْدَادِي"
  },
  {
   "segment_id": 7,
   "arabic": "رَجَاءَ عَفْوِكَ"
  },
  {
   "segment_id": 8,
   "arabic": "وَطَلَبَ نَائِلِكَ وَجَائِزَتِكَ"
  },
  {
   "segment_id": 9,
   "arabic": "فَلاَ تُخَيِّبْ دُعَائي"
  },
  {
   "segment_id": 10,
   "arabic": "يَا مَنْ لاَ يَخِيبُ عَلَيْهِ سَائِلٌ"
  },
  {
   "segment_id": 11,
   "arabic": "وَلاَ يَنْقُصُهُ نَائِلٌ"
  },
  {
   "segment_id": 12,
   "arabic": "فَإنّي لَمْ آتِكَ ثِقَةً بِعَمَلٍ صَالِحٍ عَمِلْتُهُ"
  },
  {
   "segment_id": 13,
   "arabic": "وَلاَ لِوِفَادَةِ مَخْلُوقٍ رَجَوْتُهُ"
  },
  {
   "segment_id": 14,
   "arabic": "اتَيْتُكَ مُقِرّاً عَلَىٰ نَفْسِي بِٱلإسَاءَةِ وَٱلظُّلْمِ"
  },
  {
   "segment_id": 15,
   "arabic": "مُعْتَرِفاً بِانْ لاَ حُجَّةَ لِي وَلاَ عُذْرَ"
  },
  {
   "segment_id": 16,
   "arabic": "اتَيْتُكَ ارْجُو عَظِيمَ عَفْوِكَ"
  },
  {
   "segment_id": 17,
   "arabic": "ٱلَّذِي عَفَوْتَ بِهِ عَنِ ٱلْخَاطِئينَ"
  },
  {
   "segment_id": 18,
   "arabic": "فَلَمْ يَمْنَعْكَ طُولُ عُكُوفِهِمْ عَلِي عَظِيمِ ٱلْجُرْمِ"
  },
  {
   "segment_id": 19,
   "arabic": "انْ عُدْتَ عَلَيْهِمْ بِٱلرَّحْمَةِ"
  },
  {
   "segment_id": 20,
   "arabic": "فَيَا مَنْ رَحْمَتُهُ وَاسِعَةٌ"
  },
  {
   "segment_id": 21,
   "arabic": "وَعَفْوُهُ عَظيمٌ"
  },
  {
   "segment_id": 22,
   "arabic": "يَا عَظيـمُ يَا عَظيـمُ يَا عَظيـمُ"
  },
  {
   "segment_id": 23,
   "arabic": "لاَ يَرُدُّ غَضَبَكَ إِلاَّ حِلْمُكَ"
  },
  {
   "segment_id": 24,
   "arabic": "وَلاَ يُنْجِي مِنْ سَخَطِكَ إِلاَّ ٱلتَّضَرُّعُ إِلَيْكَ"
  },
  {
   "segment_id": 25,
   "arabic": "فَهَبْ لِي يَا إِلٰهِي فَرَجاً"
  },
  {
   "segment_id": 26,
   "arabic": "بِٱلْقُدْرَةِ ٱلَّتِي تُحْيِي بِهَا مَيْتَ ٱلْبِلاَدِ"
  },
  {
   "segment_id": 27,
   "arabic": "وَلاَ تُهْلِكْنِي غَمّاً حَتَّىٰ تَسْتَجِيبَ لِي"
  },
  {
   "segment_id": 28,
   "arabic": "وَتُعَرِّفَنِي ٱلإِجَابَةَ فِي دُعَائِي"
  },
  {
   "segment_id": 29,
   "arabic": "وَاذِقْنِي طَعْمَ ٱلْعَافِيَةِ إلَىٰ مُنَتَهَىٰ اجَلِي"
  },
  {
   "segment_id": 30,
   "arabic": "وَلاَ تُشْمِتْ بِي عَدُوِّي"
  },
  {
   "segment_id": 31,
   "arabic": "وَلاَ تُسَلِّطْهُ عَلَيَّ"
  },
  {
   "segment_id": 32,
   "arabic": "وَلاَ تُمَكِّنْهُ مِنْ عُنُقِي"
  },
  {
   "segment_id": 33,
   "arabic": "اَللَّهُمَّ إِنْ وَضَعْتَنِي فَمَنْ ذَا ٱلَّذِي يَرْفَعُنِي"
  },
  {
   "segment_id": 34,
   "arabic": "وَإِنْ رَفَعْتَنِي فَمَنْ ذَا ٱلَّذِي يَضَعُنِي"
  },
  {
   "segment_id": 35,
   "arabic": "وَإِنْ اهْلَكْتَنِي فَمَنْ ذَا ٱلَّذِي يَعْرِضُ لَكَ فِي عَبْدِكَ"
  },
  {
   "segment_id": 36,
   "arabic": "اوْ يَسْالُكَ عَنْ امْرِهِ"
  },
  {
   "segment_id": 37,
   "arabic": "وَقَدْ عَلِمْتُ انَّهُ لَيْسَ فِي حُكْمِكَ ظُلْمٌ"
  },
  {
   "segment_id": 38,
   "arabic": "وَلاَ فِي نَقَمَتِكَ عَجَلَةٌ"
  },
  {
   "segment_id": 39,
   "arabic": "وَإِنَّمَا يَعْجَلُ مَنْ يَخَافُ ٱلْفَوْتَ"
  },
  {
   "segment_id": 40,
   "arabic": "وَإِنَّمَا يَحْتَاجُ إِلَىٰ ٱلظُّلْمِ ٱلضَّعِيفُ"
  },
  {
   "segment_id": 41,
   "arabic": "وَقَدْ تَعَالَيْتَ يَا إِلٰهِي عَنْ ذٰلِكَ عُلُوّاً كَبِيراً"
  },
  {
   "segment_id": 42,
   "arabic": "اَللَّهُمَّ إِنِّي اعُوذُ بِكَ فَاعِذْنِي"
  },
  {
   "segment_id": 43,
   "arabic": "وَاسْتَجيرُ بِكَ فَاجِرْنِي"
  },
  {
   "segment_id": 44,
   "arabic": "وَاسْتَرْزِقُكَ فَٱرْزُقْنِي"
  },
  {
   "segment_id": 45,
   "arabic": "وَاتَوَكَّلُ عَلَيْكَ فَٱكْفِنِي"
  },
  {
   "segment_id": 46,
   "arabic": "وَاستَنْصِرُكَ عَلَىٰ عَدُوِّي فَٱنْصُرْنِي"
  },
  {
   "segment_id": 47,
   "arabic": "وَاسْتَعينُ بِكَ فَاعِنِّي"
  },
  {
   "segment_id": 48,
   "arabic": "وَاسْتَغْفِرُكَ يَا إِلٰهِي فَٱغْفِرْ لِي"
  },
  {
   "segment_id": 49,
   "arabic": "آمِينَ آمِينَ آمِينَ"
  }
 ]
}