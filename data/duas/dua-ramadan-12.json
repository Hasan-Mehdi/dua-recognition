{
 "dua_id": "dua-ramadan-12",
 "dua_name_en": "Day 12",
 "dua_name_ar": " شهر رمضان ١٢  ",
 "source": "https://www.duaplayer.org/en/dua/ramadan-12",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "اللّهُمّ زَيّنّي فِيهِ بِالسّتْرِ وَالعَفَافِ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَاسْتُرْنِي فِيهِ بِلِبَاسِ القُنُوعِ وَالكَفَافِ،"
  },
  {
   "segment_id": 5,
   "arabic": "وَاحْمِلْنِي فِيهِ عَلَى العَدْلِ وَالإِنْصَافِ،"
  },
  {
   "segment_id": 6,
   "arabic": "وَآمِنّي فِيهِ مِنْ كُلّ مَا أَخَافُ،"
  },
  {
   "segment_id": 7,
   "arabic": "بِعِصْمَتِكَ يَا عِصْمَةَ الخَائِفِينَ."
  }
 ]
}