{
 "dua_id": "duasorg-rabi-al-akher-month-start-6",
 "dua_name_en": "Instruction Block",
 "dua_name_ar": "",
 "source": "https://www.duas.org/rabi-al-akher-month-start.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللَّهُمَّ إِنِّي أَسْأَلُكَ عَفْوًا لَيْسَ بَعْدَهُ عُقُوبَةٌ"
  },
  {
   "segment_id": 2,
   "arabic": "وَ رِضًا لَيْسَ بَعْدَهُ سَخَطٌ"
  },
  {
   "segment_id": 3,
   "arabic": "وَ عَافِيَةً لَيْسَ بَعْدَهَا بَلَاءٌ"
  },
  {
   "segment_id": 4,
   "arabic": "وَ سَعَادَةً لَيْسَ بَعْدَهَا شَقَاءٌ"
  },
  {
   "segment_id": 5,
   "arabic": "وَ هُدًى لَا يَكُونُ بَعْدَهُ ضَلَالَةٌ"
  },
  {
   "segment_id": 6,
   "arabic": "وَ إِيمَانًا لَا يُدَاخِلُهُ كُفْرٌ"
  },
  {
   "segment_id": 7,
   "arabic": "وَ قَلْبًا لَا يُدَاخِلُهُ فِتْنَةٌ"
  },
  {
   "segment_id": 8,
   "arabic": "اللَّهُمَّ إِنِّي أَسْأَلُكَ السَّعَةَ فِي الْقَبْرِ"
  },
  {
   "segment_id": 9,
   "arabic": "وَ الْحُجَّةَ الْبَالِغَةَ"
  },
  {
   "segment_id": 10,
   "arabic": "وَ الْقَوْلَ الثَّابِتَ فِي الْحَيَاةِ الدُّنْيَا وَ فِي الْآخِرَةِ"
  },
  {
   "segment_id": 11,
   "arabic": "وَ أَنْ تُنْزِلَ عَلَيَّ الْأَمَانَ وَ الْفَرَجَ"
  },
  {
   "segment_id": 12,
   "arabic": "وَ السُّرُورَ وَ نَضْرَةَ النَّعِيمِ"
  },
  {
   "segment_id": 13,
   "arabic": "اللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَ آلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 14,
   "arabic": "وَ عَرِّفْنِي بَرَكَةَ هَذَا الشَّهْرِ وَ يُمْنَهُ"
  },
  {
   "segment_id": 15,
   "arabic": "وَ ارْزُقْنِي خَيْرَهُ"
  },
  {
   "segment_id": 16,
   "arabic": "وَ اصْرِفْ عَنِّي شَرَّهُ"
  },
  {
   "segment_id": 17,
   "arabic": "وَ اجْعَلْنِي فِيهِ مِنَ الْفَائِزِينَ"
  },
  {
   "segment_id": 18,
   "arabic": "بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِينَ"
  },
  {
   "segment_id": 19,
   "arabic": "اللَّهُمَّ أَنْتَ وَهَّابُ الْخَيْرِ"
  },
  {
   "segment_id": 20,
   "arabic": "فَهَبْ لِي شَوْقًا إِلَى لِقَائِكَ"
  },
  {
   "segment_id": 21,
   "arabic": "وَ إِشْفَاقًا مِنْ عَذَابِكَ"
  },
  {
   "segment_id": 22,
   "arabic": "وَ حَيَاءً مِنْكَ وَ تَوْقِيرًا وَ إِجْلَالًا"
  },
  {
   "segment_id": 23,
   "arabic": "حَتَّى يَوْجَلَ مِنْ ذَلِكَ قَلْبِي"
  },
  {
   "segment_id": 24,
   "arabic": "وَ يَقْشَعِرَّ مِنْهُ جِلْدِي"
  },
  {
   "segment_id": 25,
   "arabic": "وَ يَتَجَافَى لَهُ جَنْبِي"
  },
  {
   "segment_id": 26,
   "arabic": "وَ تَدْمَعَ مِنْهُ عَيْنِي"
  },
  {
   "segment_id": 27,
   "arabic": "وَ لَا أَخْلُوَ مِنْ ذِكْرِكَ فِي لَيْلِي وَ نَهَارِي يَا أَرْحَمَ الرَّاحِمِينَ"
  },
  {
   "segment_id": 28,
   "arabic": "اللَّهُمَّ إِنِّي أُثْنِي عَلَيْكَ"
  },
  {
   "segment_id": 29,
   "arabic": "وَ مَا عَسَى أَنْ يَبْلُغَ مَدْحِي وَ ثَنَائِي"
  },
  {
   "segment_id": 30,
   "arabic": "مَعَ قِلَّةِ عَمَلِي وَ قِصَرِ رَأْيِي"
  },
  {
   "segment_id": 31,
   "arabic": "وَ أَنْتَ الْخَالِقُ وَ أَنَا الْمَخْلُوقُ"
  },
  {
   "segment_id": 32,
   "arabic": "وَ أَنْتَ الْمَالِكُ وَ أَنَا الْمَمْلُوكُ"
  },
  {
   "segment_id": 33,
   "arabic": "وَ أَنْتَ الرَّبُّ وَ أَنَا الْعَبْدُ"
  },
  {
   "segment_id": 34,
   "arabic": "وَ أَنْتَ الْعَزِيزُ وَ أَنَا الذَّلِيلُ"
  },
  {
   "segment_id": 35,
   "arabic": "وَ أَنْتَ الْقَوِيُّ وَ أَنَا الضَّعِيفُ"
  },
  {
   "segment_id": 36,
   "arabic": "وَ أَنْتَ الْغَنِيُّ وَ أَنَا الْفَقِيرُ"
  },
  {
   "segment_id": 37,
   "arabic": "وَ أَنْتَ الْمُعْطِي وَ أَنَا السَّائِلُ"
  },
  {
   "segment_id": 38,
   "arabic": "وَ أَنْتَ الْحَيُّ الَّذِي لَا يَمُوتُ"
  },
  {
   "segment_id": 39,
   "arabic": "وَ أَنَا خَلْقٌ أَمُوتُ"
  },
  {
   "segment_id": 40,
   "arabic": "فَاغْفِرْ لِي وَ ارْحَمْنِي"
  },
  {
   "segment_id": 41,
   "arabic": "وَ أَعْطِنِي سُؤْلِي فِي دُنْيَايَ وَ آخِرَتِي"
  },
  {
   "segment_id": 42,
   "arabic": "وَ تَجَاوَزْ عَنِّي وَ عَنْ جَمِيعِ الْمُؤْمِنِينَ وَ الْمُؤْمِنَاتِ"
  },
  {
   "segment_id": 43,
   "arabic": "وَ الْمُسْلِمِينَ وَ الْمُسْلِمَاتِ الْأَحْيَاءِ مِنْهُمْ وَ الْأَمْوَاتِ"
  },
  {
   "segment_id": 44,
   "arabic": "اللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ عَبْدِكَ وَ رَسُولِكَ وَ نَبِيِّكَ"
  },
  {
   "segment_id": 45,
   "arabic": "وَ صَفِيِّكَ وَ خِيَرَتِكَ مِنْ خَلْقِكَ"
  },
  {
   "segment_id": 46,
   "arabic": "اللَّهُمَّ ارْفَعْ دَرَجَتَهُ"
  },
  {
   "segment_id": 47,
   "arabic": "وَ كَرِّمْ مَقَامَهُ"
  },
  {
   "segment_id": 48,
   "arabic": "وَ أَجْزِلْ ثَوَابَهُ"
  },
  {
   "segment_id": 49,
   "arabic": "وَ أَفْلِجْ حُجَّتَهُ"
  },
  {
   "segment_id": 50,
   "arabic": "وَ أَظْهِرْ عُذْرَهُ"
  },
  {
   "segment_id": 51,
   "arabic": "وَ عَظِّمْ نُورَهُ"
  },
  {
   "segment_id": 52,
   "arabic": "وَ أَدِمْ كَرَامَتَهُ"
  },
  {
   "segment_id": 53,
   "arabic": "وَ أَلْحِقْ بِهِ أُمَّتَهُ وَ ذُرِّيَّتَهُ"
  },
  {
   "segment_id": 54,
   "arabic": "وَ أَقِرَّ بِذَلِكَ عَيْنَهُ"
  },
  {
   "segment_id": 55,
   "arabic": "اللَّهُمَّ اجْعَلْ مُحَمَّدًا أَكْرَمَ النَّبِيِّينَ تَبَعًا"
  },
  {
   "segment_id": 56,
   "arabic": "وَ أَعْظَمَهُمْ مَنْزِلَةً"
  },
  {
   "segment_id": 57,
   "arabic": "وَ أَشْرَفَهُمْ كَرَامَةً"
  },
  {
   "segment_id": 58,
   "arabic": "وَ أَعْلَاهُمْ دَرَجَةً"
  },
  {
   "segment_id": 59,
   "arabic": "وَ أَفْسَحَهُمْ فِي الْجَنَّةِ مَنْزِلًا"
  },
  {
   "segment_id": 60,
   "arabic": "اللَّهُمَّ بَلِّغْ مُحَمَّدًا الدَّرَجَةَ وَ الْوَسِيلَةَ"
  },
  {
   "segment_id": 61,
   "arabic": "وَ شَرِّفْ بُنْيَانَهُ"
  },
  {
   "segment_id": 62,
   "arabic": "وَ عَظِّمْ نُورَهُ وَ بُرْهَانَهُ"
  },
  {
   "segment_id": 63,
   "arabic": "وَ تَقَبَّلْ شَفَاعَتَهُ فِي أُمَّتِهِ"
  },
  {
   "segment_id": 64,
   "arabic": "وَ تَقَبَّلْ صَلَاةَ أُمَّتِهِ عَلَيْهِ"
  },
  {
   "segment_id": 65,
   "arabic": "اللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ كَمَا بَلَّغَ رِسَالَاتِكَ"
  },
  {
   "segment_id": 66,
   "arabic": "وَ تَلَا آيَاتِكَ"
  },
  {
   "segment_id": 67,
   "arabic": "وَ نَصَحَ لِعِبَادِكَ"
  },
  {
   "segment_id": 68,
   "arabic": "وَ جَاهَدَ فِي سَبِيلِكَ وَ عَبَدَكَ حَتَّى أَتَاهُ الْيَقِينُ"
  },
  {
   "segment_id": 69,
   "arabic": "اللَّهُمَّ زِدْ مُحَمَّدًا مَعَ كُلِّ شَرَفٍ شَرَفًا"
  },
  {
   "segment_id": 70,
   "arabic": "وَ مَعَ كُلِّ فَضْلٍ فَضْلًا"
  },
  {
   "segment_id": 71,
   "arabic": "وَ مَعَ كُلِّ كَرَامَةٍ كَرَامَةً"
  },
  {
   "segment_id": 72,
   "arabic": "وَ مَعَ كُلِّ سَعَادَةٍ سَعَادَةً"
  },
  {
   "segment_id": 73,
   "arabic": "حَتَّى تَجْعَلَ مُحَمَّدًا فِي الشَّرَفِ الْأَعْلَى مَعَ الدَّرَجَاتِ الْعُلَى"
  },
  {
   "segment_id": 74,
   "arabic": "اللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَ عَلَى آلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 75,
   "arabic": "وَ سَهِّلْ لِي مِحْنَتِي"
  },
  {
   "segment_id": 76,
   "arabic": "وَ بَلِّغْنِي أُمْنِيَّتِي"
  },
  {
   "segment_id": 77,
   "arabic": "وَ وَسِّعْ عَلَيَّ فِي رِزْقِي"
  },
  {
   "segment_id": 78,
   "arabic": "وَ اقْضِ عَنِّي دَيْنِي"
  },
  {
   "segment_id": 79,
   "arabic": "وَ فَرِّجْ عَنِّي هَمِّي وَ غَمِّي وَ كَرْبِي"
  },
  {
   "segment_id": 80,
   "arabic": "وَ يَسِّرْ لِي إِرَادَتِي"
  },
  {
   "segment_id": 81,
   "arabic": "وَ أَوْصِلْنِي إِلَى بُغْيَتِي سَرِيعًا عَاجِلًا"
  },
  {
   "segment_id": 82,
   "arabic": "يَا أَرْحَمَ الرَّاحِمِينَ"
  }
 ]
}