{
 "dua_id": "duasorg-ramadan-dua-daytime-daily-4",
 "dua_name_en": "Allahumma arina fihi",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-dua-daytime-daily.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللَّهُمَّ أَرِنا فِيهِ وَفِي أَهْلِ بَيْتِهِ وَشِیعَتِهِ وَرَعيّتِهِ وَعَامَّتِهِ"
  },
  {
   "segment_id": 2,
   "arabic": "ا مَا يَأمُلُ وَفِي أعْدائِهِ مَا يَحْذَرُوْنَ"
  },
  {
   "segment_id": 3,
   "arabic": "مُنَّ عَلَيْنَا بِطَاعَتِهِ وَرِضاهُ"
  },
  {
   "segment_id": 4,
   "arabic": "وَالحِقْنَا بَشيعَتِهِ المُقَرّبِيْنَ وَأوْلِيَائِهِ السابِقِيْنَ"
  },
  {
   "segment_id": 5,
   "arabic": "وَصَلَّ عَلَیْهِ وَعَلىَ آبَائِهِ الطاهِرِيْنَ"
  },
  {
   "segment_id": 6,
   "arabic": "بِجَميعِ صَلَوَاتِكَ يَا أَرْحَمَ الرَّاحِمِيْنَ"
  }
 ]
}