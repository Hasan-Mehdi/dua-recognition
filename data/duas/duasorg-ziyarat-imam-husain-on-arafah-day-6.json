{
 "dua_id": "duasorg-ziyarat-imam-husain-on-arafah-day-6",
 "dua_name_en": "Ziyarah of Abbas ibn Ali (as)",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ziyarat-imam-husain-on-arafah-day.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يا أَبَا ٱلْفَضْلِ"
  },
  {
   "segment_id": 2,
   "arabic": "ٱلْعَبَّاسَ بْنَ أَمِيرِ ٱلْمُؤْمِنِينَ"
  },
  {
   "segment_id": 3,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا بْنَ سَيِّدِ ٱلْوَصِيِّينَ"
  },
  {
   "segment_id": 4,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا بْنَ أَوَّلِ ٱلْقَوْمِ إِسْلاَماً"
  },
  {
   "segment_id": 5,
   "arabic": "وَأَقْدَمِهِمْ إِيـمَاناً"
  },
  {
   "segment_id": 6,
   "arabic": "وَأَقْوَمِهِمْ بِدِينِ ٱللَّهِ"
  },
  {
   "segment_id": 7,
   "arabic": "وَأَحْوَطِهِمْ عَلَىٰ ٱلإِسْلاَمِ"
  },
  {
   "segment_id": 8,
   "arabic": "أَشْهَدُ لَقَدْ نَصَحْتَ لِلَّهِ وَلِرَسُولِهِ وَلأَخِيكَ"
  },
  {
   "segment_id": 9,
   "arabic": "فَنِعْمَ ٱلأَخُ ٱلْمُوَاسِي"
  },
  {
   "segment_id": 10,
   "arabic": "فَلَعَنَ ٱللَّهُ أُمَّةً قَتَلَتْكَ"
  },
  {
   "segment_id": 11,
   "arabic": "وَلَعَنَ ٱللَّهُ أُمَّةً ظَلَمَتْكَ"
  },
  {
   "segment_id": 12,
   "arabic": "وَلَعَنَ ٱللَّهُ أُمَّةً ٱسْتَحَلَّتْ مِنْكَ ٱلْمَحَارِمَ"
  },
  {
   "segment_id": 13,
   "arabic": "وَٱنْتَهَكَتْ فِي قَتْلِكَ حُرْمَةَ ٱلإِسْلاَمِ"
  },
  {
   "segment_id": 14,
   "arabic": "فَنِعْمَ ٱلأَخُ ٱلصَّابِرُ ٱلْمُجَاهِدُ"
  },
  {
   "segment_id": 15,
   "arabic": "ٱلْمُحَامِي ٱلنَّاصِرُ"
  },
  {
   "segment_id": 16,
   "arabic": "وَٱلأَخُ ٱلدَّافِعُ عَنْ أَخِيهِ"
  },
  {
   "segment_id": 17,
   "arabic": "ٱلْمُجِيبُ إِلَىٰ طَاعَةِ رَبِّهِ"
  },
  {
   "segment_id": 18,
   "arabic": "ٱلرَّاغِبُ فِيمَا زَهِدَ فيهِ غَيْرُهُ"
  },
  {
   "segment_id": 19,
   "arabic": "مِنَ ٱلثَّوَابِ ٱلْجَزِيلِ وَٱلثَّنَاءِ ٱلْجَمِيلِ"
  },
  {
   "segment_id": 20,
   "arabic": "وَأَلْحَقَكَ ٱللَّهُ بِدَرَجَةِ آبَائِكَ"
  },
  {
   "segment_id": 21,
   "arabic": "فِي دَارِ ٱلنَّعِيمِ"
  }
 ]
}