{
 "dua_id": "duasorg-ramadan-laylat-ul-qadr-amaal-dua-23-1",
 "dua_name_en": "Dua Allahuma Imdud",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-laylat-ul-qadr-amaal-dua-23.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللَّهُمَّ ٱمْدُدْ لِي فِي عُمْرِي"
  },
  {
   "segment_id": 2,
   "arabic": "وَاوْسِعْ لِي فِي رِزْقِي"
  },
  {
   "segment_id": 3,
   "arabic": "وَاصِحَّ لِي جِسْمِي"
  },
  {
   "segment_id": 4,
   "arabic": "وَبَلِّغْنِي امَلِي"
  },
  {
   "segment_id": 5,
   "arabic": "وَإِنْ كُنْتُ مِنَ ٱلاشْقِيَاءِ فَٱمْحُنِي مِنَ ٱلاشْقِيَاءِ"
  },
  {
   "segment_id": 6,
   "arabic": "وَٱكْتُبْنِي مِنَ ٱلسُّعَدَاءِ"
  },
  {
   "segment_id": 7,
   "arabic": "فَإِنَّكَ قُلْتَ فِي كِتَابِكَ ٱلْمُنْزَلِ"
  },
  {
   "segment_id": 8,
   "arabic": "عَلَىٰ نَبِيِّكَ ٱلْمُرْسَلِ صَلَوَاتُكَ عَلَيْهِ وَآلِهِ:"
  },
  {
   "segment_id": 9,
   "arabic": "”يَمْحُو ٱللَّهُ مَا يَشَاءُ وَيُثْبِتُ وَعِنْدَهُ امُّ ٱلْكِتَابِ“"
  }
 ]
}