{
 "dua_id": "duasorg-dua-taqeebat-after-maghrib-isha-prayers-6",
 "dua_name_en": "Dua after Isha: Imam Jafar al-Sadiq (as)",
 "dua_name_ar": "",
 "source": "https://www.duas.org/dua-taqeebat-after-maghrib-isha-prayers.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللَّهُمَّ إِنَّهُ لَيْسَ لِي عِلْمٌ بِمَوْضِعِ رِزْقِي"
  },
  {
   "segment_id": 2,
   "arabic": "وَإِنَّمَا أَطْلُبُهُ بِخَطَرَاتٍ تَخْطُرُ عَلَىٰ قَلْبِي"
  },
  {
   "segment_id": 3,
   "arabic": "فَأَجُولُ فِي طَلَبِهِ ٱلْبُلْدَانَ"
  },
  {
   "segment_id": 4,
   "arabic": "فَأَنَا فِيمَا أَنَا طَالِبٌ كَٱلْحَيْرَانِ"
  },
  {
   "segment_id": 5,
   "arabic": "لاَ أَدْرِي أَفِي سَهْلٍ هَوُ أَمْ فِي جَبَلٍ"
  },
  {
   "segment_id": 6,
   "arabic": "أَمْ في أَرْضٍ أَمْ في سَمَاءٍ"
  },
  {
   "segment_id": 7,
   "arabic": "أَمْ فِي بَرٍّ أَمْ فِي بَحْرٍ"
  },
  {
   "segment_id": 8,
   "arabic": "وَعَلَىٰ يَدَيْ مَنْ"
  },
  {
   "segment_id": 9,
   "arabic": "وَمِنْ قِبَلِ مَنْ"
  },
  {
   "segment_id": 10,
   "arabic": "وَقَدْ عَلِمْتُ أَنَّ عِلْمَهُ عِنْدَكَ"
  },
  {
   "segment_id": 11,
   "arabic": "وَ أَسْبَابَهُ بِيَدِكَ"
  },
  {
   "segment_id": 12,
   "arabic": "وَ أَنْتَ ٱلَّذي تَقْسِمُهُ بِلُطْفِكَ"
  },
  {
   "segment_id": 13,
   "arabic": "وَتُسَبِّبُهُ بِرَحْمَتِكَ"
  },
  {
   "segment_id": 14,
   "arabic": "اَللَّهُمَّ فَصَلِّ عَلَىٰ مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 15,
   "arabic": "وَٱجْعَلْ يَا رَبِّ رِزْقَكَ لِي وَاسِعاً"
  },
  {
   "segment_id": 16,
   "arabic": "وَمَطْلَبَهُ سَهْلاً"
  },
  {
   "segment_id": 17,
   "arabic": "وَمَاْخَذَهُ قَرِيباً"
  },
  {
   "segment_id": 18,
   "arabic": "وَلاَ تُعَنِّنِي بِطَلَبِ مَا لَمْ تُقَدِّرْ لِي فيهِ رِزْقاً"
  },
  {
   "segment_id": 19,
   "arabic": "فَإِنَّكَ غَنِيٌّ عَنْ عَذَابِي"
  },
  {
   "segment_id": 20,
   "arabic": "وَ أَنَا فَقِيـرٌ إِلَىٰ رَحْمَتِكَ"
  },
  {
   "segment_id": 21,
   "arabic": "فَصَلِّ عَلَىٰ مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 22,
   "arabic": "وَجُدْ عَلَىٰ عَبْدِكَ بِفَضْلِكَ"
  },
  {
   "segment_id": 23,
   "arabic": "إِنَّكَ ذُو فَضْلٍ عَظيم"
  }
 ]
}