{
 "dua_id": "duasorg-ramadan-eid-4",
 "dua_name_en": "Repeat 10 times",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-eid.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "يَا دَائِمَ ٱلْفَضْلِ عَلَىٰ ٱلْبَريِّةِ"
  },
  {
   "segment_id": 2,
   "arabic": "يَا بَاسِطَ ٱلْيَدَيْنِ بِٱلْعَطِيَّةِ"
  },
  {
   "segment_id": 3,
   "arabic": "يَا صَاحِبَ ٱلْمَوَاهِبِ ٱلسَّنِيَّةِ"
  },
  {
   "segment_id": 4,
   "arabic": "صَلِّ عَلَىٰ مُحَمِّدٍ وَآلِهِ"
  },
  {
   "segment_id": 5,
   "arabic": "خَيْرِ ٱلْوَرَىٰ سَجِيَّةً"
  },
  {
   "segment_id": 6,
   "arabic": "وَٱغْفِرْ لَنَا يَا ذَٱ ٱلْعُلَىٰ"
  },
  {
   "segment_id": 7,
   "arabic": "فِي هٰذِهِ ٱلْعَشِيَّةِ"
  }
 ]
}