   "segment_id": 33,
   "arabic": "صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ"
  },
  {
   "segment_id": 34,
   "arabic": "لَعَنَ ٱللَّهُ أُمَّةً ٱسْتَحَلَّتْ دَمَكَ"
  },
  {
   "segment_id": 35,
   "arabic": "وَلَعَنَ ٱللَّهُ أُمَّةً قَتَلَتْكَ"
  },
  {
   "segment_id": 36,
   "arabic": "وَٱسْتَبَاحَتْ حَرِيـمَكَ"
  },
  {
   "segment_id": 37,
   "arabic": "وَلَعَنَ ٱللَّهُ أَشْيَاعَهُمْ وَأَتْبَاعَهُمْ"
