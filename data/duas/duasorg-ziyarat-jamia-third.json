 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا رَسُولَ ٱللَّهِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا نَبِيَّ ٱللَّهِ"
  },
  {
   "segment_id": 3,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا خِيَرَةَ ٱللَّهِ مِنْ خَلْقِهِ"
  },
  {
   "segment_id": 4,
   "arabic": "وَأَمِينَهُ عَلَىٰ وَحْيِهِ"
  },
  {
   "segment_id": 5,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا مَوْلاَيَ يَا أَمِيرَ ٱلْمُؤْمِنِينَ"
  },
  {
   "segment_id": 6,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا مَوْلاَيَ"
  },
  {
   "segment_id": 7,
   "arabic": "أَنْتَ حُجَّةُ ٱللَّهِ عَلَىٰ خَلْقِهِ"
  },
  {
   "segment_id": 8,
   "arabic": "وَبَابُ عِلْمِهِ"
  },
  {
   "segment_id": 9,
   "arabic": "وَوَصِيُّ نَبِيِّهِ"
  },
  {
   "segment_id": 10,
   "arabic": "وَٱلْخَلِيفَةُ مِنْ بَعْدِهِ فِي أُمَّتِهِ"
  },
  {
   "segment_id": 11,
   "arabic": "لَعَنَ ٱللَّهُ أُمَّةً غَصَبَتْكَ حَقَّكَ"
  },
  {
   "segment_id": 12,
   "arabic": "وَقَعَدَتْ مَقْعَدَكَ"
  },
  {
   "segment_id": 13,
   "arabic": "أَنَا بَرِيءٌ مِنْهُمْ"
  },
  {
   "segment_id": 14,
   "arabic": "وَمِنْ شِيعَتِهِمْ إِلَيْكَ"
  },
  {
   "segment_id": 15,
   "arabic": "اَلسَّلاَمُ عَلَيْكِ يَا فَاطِمَةُ ٱلْبَتُولُ"
  },
  {
   "segment_id": 16,
   "arabic": "اَلسَّلاَمُ عَلَيْكِ يَا زَيْنَ نِسَاءِ ٱلْعَالَمِينَ"
  },
  {
   "segment_id": 17,
   "arabic": "اَلسَّلاَمُ عَلَيْكِ يَا بِنْتَ رَسُولَ ٱللَّهِ رَبِّ ٱلْعَالَمِينَ"
  },
  {
   "segment_id": 18,
   "arabic": "صَلَّىٰ ٱللَّهُ عَلَيكِ وَعَلَيْهِ"
  },
  {
   "segment_id": 19,
   "arabic": "اَلسَّلاَمُ عَلَيْكِ يَا أُمَّ ٱلْحَسَنِ وَٱلْحُسَيْنِ"
  },
  {
   "segment_id": 20,
   "arabic": "لَعَنَ ٱللَّهُ أُمَّةً غَصَبَتْكِ حَقَّكِ"
  },
  {
   "segment_id": 21,
   "arabic": "وَمَنَعَتْكِ مَا جَعَلَهُ ٱللَّهُ لَكِ حَلاَلاًَ"
  },
  {
   "segment_id": 22,
   "arabic": "أَنَا بَريءٌٌ إِِلَيْكِ مِنْهُمْ وَمِنْ شِيعَتِهِمْ"
  },
  {
   "segment_id": 23,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا مَوْلاَيَ"
  },
  {
   "segment_id": 24,
   "arabic": "يَا أَبَا مُحَمَّدٍ ٱلْحَسَنُ ٱلزَّكِيُّ"
  },
  {
   "segment_id": 25,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا مَوْلاَيَ"
  },
  {
   "segment_id": 26,
   "arabic": "لَعَنَ ٱللَّهُ أُمَّةً قَتَلَتْكَ"
  },
  {
   "segment_id": 27,
   "arabic": "وَبَايَعَتْ فِي أَمْرِكَ وَشَايَعَتْ"
  },
  {
   "segment_id": 28,
   "arabic": "أَنَا بَرِيءٌ إِِلَيْكَ مِنْهُمْ وَمِنْ شِيعَتِهِمْ"
  },
  {
   "segment_id": 29,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا مَوْلاَيَ"
  },
  {
   "segment_id": 30,
   "arabic": "يَا أَبَا عَبْدِ ٱللَّهِ ٱلْحُسَيْنُ بْنَ عَلِيٍّ"
  },
  {
   "segment_id": 31,
   "arabic": "صَلَوَاتُ ٱللَّهِ عَلَيْكَ"
  },
  {
