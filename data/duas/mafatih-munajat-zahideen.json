{
 "dua_id": "mafatih-munajat-zahideen",
 "dua_name_en": "Munajat Zahideen",
 "dua_name_ar": "مناجاة الزاهدين",
 "source": "Mafatih al-Jinan (github.com/kazemcodes/MafatihDecoder); lines from reciters' pauses",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "إِلهي أَسْكَنْتَنا داراً حَفَرَتْ لَنا حُفَرَ مَكْرِها"
  },
  {
   "segment_id": 2,
   "arabic": "وَعَلَّقَتْنا بِأَيْدِي الْمَنايا في حَبائِلِ غَدْرِها"
  },
  {
   "segment_id": 3,
   "arabic": "فَإِلَيْكَ نَلْتَجِيءُ مِنْ مَكائِدِ خُدَعِها"
  },
  {
   "segment_id": 4,
   "arabic": "وَبِكَ نَعْتَصِمُ مِنَ الإِغْتِرارِ بِزَخارِفِ زينَتِها"
  },
  {
   "segment_id": 5,
   "arabic": "فَإِنَّهَا الْمُهْلِكَةُ طُلاّبَهَا الْمُتْلِفَةُ حُلاّلَهَا"
  },
  {
   "segment_id": 6,
   "arabic": "الْمَحْشُوَّةُ بِالآفاتِ الْمَشْحُونَةُ بِالنَّكَباتِ"
  },
  {
   "segment_id": 7,
   "arabic": "إِلهي فَزَهِّدْنا فيها"
  },
  {
   "segment_id": 8,
   "arabic": "وَسَلِّمْنا مِنْها بِتَوْفيقِكَ وَعِصْمَتِكَ"
  },
  {
   "segment_id": 9,
   "arabic": "وَانْزَعْ عَنّا جَلابيبَ مُخالَفَتِكَ"
  },
  {
   "segment_id": 10,
   "arabic": "وَتَوَلَّ أُمُورَنا بِحُسْنِ كِفايَتِكَ"
  },
  {
   "segment_id": 11,
   "arabic": "وَأَوْفِرْ مَزيدَنا مِنْ سَعَةِ رَحْمَتِكَ"
  },
  {
   "segment_id": 12,
   "arabic": "وَأَجْمِلْ صِلاتِنا مِنْ فَيْضِ مَواهِبِكَ"
  },
  {
   "segment_id": 13,
   "arabic": "وَاغْرِسْ في أَفْئِدَتِنا أَشْجارَ مَحَبَّتِكَ"
  },
  {
   "segment_id": 14,
   "arabic": "وَأَتْمِمْ لَنا أَنْوارَ مَعْرِفَتِكَ"
  },
  {
   "segment_id": 15,
   "arabic": "وَأَذِقْنا حَلاوَةَ عَفْوِكَ وَلَذَّةَ مَغْفِرَتِكَ"
  },
  {
   "segment_id": 16,
   "arabic": "وَأَقْرِرْ أَعْيُنَنا يَوْمَ لِقائِكَ بِرُؤْيَتِكَ"
  },
  {
   "segment_id": 17,
   "arabic": "وَأَخْرِجْ حُبَّ الدُّنْيا مِنْ قُلُوبِنا"
  },
  {
   "segment_id": 18,
   "arabic": "كَما فَعَلْتَ بِالصّالِحينَ مِنْ صَفْوَتِكَ وَالأَبْرارِ مِنْ خاصَّتِكَ"
  },
  {
   "segment_id": 19,
   "arabic": "بِرَحْمَتِكَ يا أَرْحَمَ الرّاحِمينَ وَيا أَكْرَمَ الأَكْرَمينَ"
  }
 ]
}