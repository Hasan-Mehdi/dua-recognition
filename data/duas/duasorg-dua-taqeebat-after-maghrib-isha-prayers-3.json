{
 "dua_id": "duasorg-dua-taqeebat-after-maghrib-isha-prayers-3",
 "dua_name_en": "Dua after Fajr and Maghrib Salaat: Imam Ja`far al-Sadiq (as)",
 "dua_name_ar": "",
 "source": "https://www.duas.org/dua-taqeebat-after-maghrib-isha-prayers.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللَّهُمَّ إِنِّي أَسْأَلُكَ بِحَقِّ مُحَمَّد وَآلِ مُحَمَّد عَلَيْكَ"
  },
  {
   "segment_id": 2,
   "arabic": "صَلِّ عَلَىٰ مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "وَٱجْعَلِ ٱلنُّورَ فِي بَصَرِي"
  },
  {
   "segment_id": 4,
   "arabic": "وَٱلْبَصِيـرَةَ فِي دِينِي"
  },
  {
   "segment_id": 5,
   "arabic": "وَٱلْيَقِيـنَ فِي قَلْبِي"
  },
  {
   "segment_id": 6,
   "arabic": "وَٱلإِخْلاَصَ فِي عَمَلِي"
  },
  {
   "segment_id": 7,
   "arabic": "وَٱلسَّلاَمَةَ فِي نَفْسِي"
  },
  {
   "segment_id": 8,
   "arabic": "وَٱلسَّعَةَ فِي رِزْقِي"
  },
  {
   "segment_id": 9,
   "arabic": "وَٱلشُّكْرَ لَكَ أَبَداً مَا أَبْقَيْتَنِي"
  }
 ]
}