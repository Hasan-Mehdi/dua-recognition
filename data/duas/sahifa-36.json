{
 "dua_id": "sahifa-36",
 "dua_name_en": "Sahifa 36: when he saw clouds and lightening and heard the thunder",
 "dua_name_ar": "ددُعَاؤُهُ إذا نَظَرَ الى السَّحابِ و البَرقِ و عِنْدَ سَمَاعِ الرَّعْدِ",
 "source": "https://duas.pro/36-when-he-saw-clouds-and-lightening-and-heard-the-thunder",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "أللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَآلِهِ،"
  },
  {
   "segment_id": 2,
   "arabic": "أَللَّهُمَّ إنَّ هذَيْن آيَتَانِ مِنْ آياتِكَ،"
  },
  {
   "segment_id": 3,
   "arabic": "وَهذَين عَوْنَانِ مِنْ أَعْوَانِكَ"
  },
  {
   "segment_id": 4,
   "arabic": "يَبْتَدِرَانِ طَاعَتَكَ بِرَحْمَةٍ نَافِعَةٍ أَوْ نِقْمَةٍ ضَارَّةٍ،"
  },
  {
   "segment_id": 5,
   "arabic": "فَلاَ تُمْطِرْنَا بِهِمَا مَطَرَ السَّوْءِ،"
  },
  {
   "segment_id": 6,
   "arabic": "وَلا تُلْبِسْنَا بِهِمَا لِبَاسَ الْبَلاَءِ."
  },
  {
   "segment_id": 7,
   "arabic": "صَلِّ عَلَى مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 8,
   "arabic": "وَأَنْزِلْ عَلَيْنَا نَفْعَ هَذِهِ السَّحَائِبِ وَبَرَكَتَهَا،"
  },
  {
   "segment_id": 9,
   "arabic": "وَاصْرِفْ عَنَّا أَذَاهَا وَمَضَرَّتَهَا،"
  },
  {
   "segment_id": 10,
   "arabic": "وَلا تُصِبْنَا فِيْهَا بآفَةٍ،"
  },
  {
   "segment_id": 11,
   "arabic": "وَلا تُرْسِلْ عَلَى مَعَايِشِنَا عَاهَةً."
  },
  {
   "segment_id": 12,
   "arabic": "أللَّهُمَّ وَإنْ كُنْتَ بَعَثْتَهَا نِقْمَةً وَأَرْسَلْتَهَا سَخْطَةً"
  },
  {
   "segment_id": 13,
   "arabic": "فَإنَّا نَسْتَجِيْرُكَ مِنْ غَضَبِكَ،"
  },
  {
   "segment_id": 14,
   "arabic": "وَنَبْتَهِلُ إلَيْكَ فِي سُؤَالِ عَفْوِكَ،"
  },
  {
   "segment_id": 15,
   "arabic": "فَمِلْ بِالْغَضَبِ إلَى الْمُشْرِكِينَ،"
  },
  {
   "segment_id": 16,
   "arabic": "وَأَدِرْ رَحَى نِقْمَتِكَ عَلَى الْمُلْحِدِينَ."
  },
  {
   "segment_id": 17,
   "arabic": "أللَّهُمَّ أَذْهِبْ مَحْلَ بِلَادِنَا بِسُقْيَاكَ،"
  },
  {
   "segment_id": 18,
   "arabic": "وَأَخْرِجْ وَحَرَ صُدُورِنَا بِرِزْقِكَ،"
  },
  {
   "segment_id": 19,
   "arabic": "وَلاَ تَشْغَلْنَا عَنْكَ بِغَيْرِكَ،"
  },
  {
   "segment_id": 20,
   "arabic": "وَلاَ تَقْطَعْ عَنْ كَافَّتِنَا مَادَّةَ بِرِّكَ،"
  },
  {
   "segment_id": 21,
   "arabic": "فَإنَّ الغَنِيَّ مَنْ أَغْنَيْتَ،"
  },
  {
   "segment_id": 22,
   "arabic": "وَإنَّ السَّالِمَ مَنْ وَقَيْتَ،"
  },
  {
   "segment_id": 23,
   "arabic": "مَا عِنْدَ أَحَدٍ دُونَكَ دِفَاعٌ،"
  },
  {
   "segment_id": 24,
   "arabic": "وَلاَ بِأَحَدٍ عَنْ سَطْوَتِكَ امْتِنَاعٌ،"
  },
  {
   "segment_id": 25,
   "arabic": "تَحْكُمُ بِمَا شِئْتَ عَلَى مَنْ شِئْتَ،"
  },
  {
   "segment_id": 26,
   "arabic": "وَتَقْضِي بِمَا أَرَدْتَ فِيمَنْ أَرَدْتَ."
  },
  {
   "segment_id": 27,
   "arabic": "فَلَكَ الْحَمْدُ عَلَى مَا وَقَيْتَنَا مِنَ الْبَلاءِ،"
  },
  {
   "segment_id": 28,
   "arabic": "وَلَكَ الشُّكْرُ عَلَى مَا خَوَّلْتَنَا مِنَ النِّعْمَاءِ"
  },
  {
   "segment_id": 29,
   "arabic": "حَمْداً يُخَلِّفُ حَمْدَ الْحَامِدِينَ وَرَاءَهُ،"
  },
  {
   "segment_id": 30,
   "arabic": "حَمْداً يَمْلأُ أَرْضَهُ وَسَمَاءَهُ"
  },
  {
   "segment_id": 31,
   "arabic": "إنَّكَ الْمَنَّانُ بِجَسِيمِ الْمِنَنِ،"
  },
  {
   "segment_id": 32,
   "arabic": "الْوَهَّابُ لِعَظِيمِ النِّعَمِ،"
  },
  {
   "segment_id": 33,
   "arabic": "القَابِلُ يَسِيْرَ الْحَمْدِ،"
  },
  {
   "segment_id": 34,
   "arabic": "الشَّاكِرُ قَلِيْلَ الشُّكْرِ،"
  },
  {
   "segment_id": 35,
   "arabic": "الْمُحْسِنُ الْمُجْمِلُ ذُو الطَّوْلِ"
  },
  {
   "segment_id": 36,
   "arabic": "لا إلهَ إلاّ أَنْتَ إلَيْكَ الْمَصِيرُ."
  }
 ]
}