  },
  {
   "segment_id": 177,
   "arabic": "وَٱغْفِرْ لِيَ ٱلذُّنُوبَ ٱلَّتِي تُورِثُ ٱلسَّقَمَ"
  },
  {
   "segment_id": 178,
   "arabic": "وَٱغْفِرْ لِيَ ٱلذُّنُوبَ ٱلَّتِي تَهْتِكُ ٱلْعِصَمَ"
