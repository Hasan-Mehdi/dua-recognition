   "arabic": "يَا فَارِجَ هَمِّ ٱلْمَهْمُومِينَ"
  },
  {
   "segment_id": 164,
   "arabic": "يَا بَدِيعَ ٱلسَّمَاوَاتِ وَٱلارَضِينَ"
  },
  {
