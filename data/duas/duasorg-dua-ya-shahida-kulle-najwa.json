   "segment_id": 207,
   "arabic": "وَاجِرْنِي مِنْ عَذَابِكَ وَنَارِكَ"
  },
  {
   "segment_id": 208,
   "arabic": "وَٱقْلِبْنِي إِذَا تَوَفَّيْتَنِي إِلَىٰ جَنَّتِكَ بِرَحْمَتِكَ"
  },
  {
   "segment_id": 209,
   "arabic": "اللَّهُمَّ إِنِّي اعُوذُ بِكَ مِنْ زَوَالِ نِعْمَتِكَ"
