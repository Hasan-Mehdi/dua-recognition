  {
   "segment_id": 118,
   "arabic": "فَوْقَ جَبَلِ طُورِ سَيْنَاءَ"
  },
  {
   "segment_id": 119,
   "arabic": "وَاسْالُكَ بِٱسْمِكَ ٱلَّذِي عَلَّمْتَهُ مَلَكَ ٱلْمَوْتِ لِقَبْضِ ٱلارْوَاحِ"
  },
  {
   "segment_id": 120,
   "arabic": "وَاسْالُكَ بِٱسْمِكَ ٱلَّذِي كُتِبَ عَلَىٰ وَرَقِ ٱلزَّيْتُونِ"
  },
  {
   "segment_id": 121,
   "arabic": "فَخَضَعتِ ٱلنِّيرَانُ لِتِلْكَ ٱلْوَرَقَةِ"
  },
  {
   "segment_id": 122,
   "arabic": "فَقُلْتَ: ”يَا نَارُ كُونِي بَرْداً وَسَلاَماً“"
