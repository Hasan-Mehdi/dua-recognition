{
 "dua_id": "duasorg-dua-ya-shahida-kulle-najwa",
 "dua_name_en": "Dua Ya Shaida Kulle Najwa",
 "dua_name_ar": "",
 "source": "https://www.duas.org/dua-ya-shahida-kulle-najwa.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللَّهُمَّ يَا شَاهِدَ كُلِّ نَجْوَىٰ"
  },
  {
   "segment_id": 2,
   "arabic": "وَمَوْضِعَ كُلِّ شَكْوَىٰ"
  },
  {
   "segment_id": 3,
   "arabic": "وَعَالِمَ كُلِّ خَفِيَّةٍ"
  },
  {
   "segment_id": 4,
   "arabic": "وَمُنْتَهَىٰ كُلِّ حَاجَةٍ"
  },
  {
   "segment_id": 5,
   "arabic": "يَا مُبْتَدِئاً بِٱلنِّعَمِ عَلَىٰ ٱلْعِبَادِ"
  },
  {
   "segment_id": 6,
   "arabic": "يَا كَرِيمَ ٱلْعَفْوِ"
  },
  {
   "segment_id": 7,
   "arabic": "يَا حَسَنَ ٱلتِّجَاوُزِ"
  },
  {
   "segment_id": 8,
   "arabic": "يَا جَوَادُ"
  },
  {
   "segment_id": 9,
   "arabic": "يَا مَنْ لا يُوَارِي مِنْهُ لَيْلٌ دَاجٍ"
  },
  {
   "segment_id": 10,
   "arabic": "وَلاَ بَحْرٌ عَجَّاجٌ"
  },
  {
   "segment_id": 11,
   "arabic": "وَلاَ سَمَاءٌ ذَاتُ ابْرَاجٍ"
  },
  {
   "segment_id": 12,
   "arabic": "وَلاَ ظُلَمٌ ذَاتُ ٱرْتِتَاجٍ"
  },
  {
   "segment_id": 13,
   "arabic": "يَا مَنِ ٱلظُّلْمَةُ عِنْدَهُ ضِيَاءٌ"
  },
  {
   "segment_id": 14,
   "arabic": "اسْالُكَ بِنُورِ وَجْهِكَ ٱلْكَرِيمِ"
  },
  {
   "segment_id": 15,
   "arabic": "ٱلَّذِي تَجَلَّيْتَ بِهِ لِلْجَبَلِ فَجَعَلْتَهُ دَكّاً"
  },
  {
   "segment_id": 16,
   "arabic": "وَخَرَّ مُوسَىٰ صَعِقاً"
  },
  {
   "segment_id": 17,
   "arabic": "وَبِٱسْمِكَ ٱلَّذِي رَفَعْتَ بِهِ ٱلسَّمَاوَاتِ بِلاَ عَمَدٍ"
  },
  {
   "segment_id": 18,
   "arabic": "وَسَطَحْتَ بِهِ ٱلارْضَ عَلَىٰ وَجْهِ مَاءٍ جَمَدٍ"
  },
  {
   "segment_id": 19,
   "arabic": "وَبِٱسْمِكَ ٱلْمَخْزُونِ ٱلْمَكْنُونِ"
  },
  {
   "segment_id": 20,
   "arabic": "ٱلْمَكْتُوبِ ٱلطَّاهِرِ"
  },
  {
   "segment_id": 21,
   "arabic": "ٱلَّذِي إِذَا دُعِيتَ بِهِ اجَبْتَ"
  },
  {
   "segment_id": 22,
   "arabic": "وَإِذَا سُئِلْتَ بِهِ اعْطَيْتَ"
  },
  {
   "segment_id": 23,
   "arabic": "وَبِٱسْمِكَ ٱلسُّبُّوحِ ٱلْقُدُّوسِ ٱلْبُرْهَانِ"
  },
  {
   "segment_id": 24,
   "arabic": "ٱلَّذِي هُوَ نُورٌ عَلَىٰ كُلِّ نُورٍ"
  },
  {
   "segment_id": 25,
   "arabic": "وَنُورٌ مِنْ نُورٍ"
  },
  {
   "segment_id": 26,
   "arabic": "يُضِيءُ مِنْهُ كُلُّ نُورٍ"
  },
  {
   "segment_id": 27,
   "arabic": "إِذَا بَلَغَ ٱلارْضَ ٱنْشَقَّتْ"
  },
  {
   "segment_id": 28,
   "arabic": "وَإِذَا بَلَغَ ٱلسَّمَاوَاتِ فُتِحَتْ"
  },
  {
   "segment_id": 29,
   "arabic": "وَإِذَا بَلَغَ ٱلعَرْشَ ٱهْتَزَّ"
  },
  {
   "segment_id": 30,
   "arabic": "وَبِٱسْمِكَ ٱلَّذِي تَرْتَعِدُ مِنْهُ فَرَائِصُ مَلائِكَتِكَ"
  },
  {
   "segment_id": 31,
   "arabic": "وَاسْالُكَ بِحَقِّ جَبْرَائِيلَ وَمِيكَائِيلَ وَإِسْرَافِيلَ"
  },
  {
   "segment_id": 32,
   "arabic": "وَبِحَقِّ مُحَمَّدٍ ٱلْمُصْطَفَىٰ"
  },
  {
   "segment_id": 33,
   "arabic": "صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ"
  },
  {
   "segment_id": 34,
   "arabic": "وَعَلَىٰ جَمِيعِ ٱلانْبِيَاءِ وَجَمِيعِ ٱلْمَلاَئِكَةِ"
  },
  {
   "segment_id": 35,
   "arabic": "وَبِٱلاِﹾسْمِ ٱلَّذِي مَشَىٰ بِهِ ٱلْخِضْرُ عَلَىٰ قُلَلِ ٱلْمَاءِ"
  },
  {
   "segment_id": 36,
   "arabic": "كَمَا مَشَىٰ بِهِ عَلَىٰ جَدَدِ ٱلارْضِ"
  },
  {
   "segment_id": 37,
   "arabic": "وَبِٱسْمِكَ ٱلَّذِي فَلَقْتَ بِهِ ٱلبَحْرَ لِمُوسَىٰ"
  },
  {
   "segment_id": 38,
   "arabic": "وَاغْرَقْتَ فِرْعَوْنَ وَقَوْمَهُ"
  },
  {
   "segment_id": 39,
   "arabic": "وَانْجَيْتَ بِهِ مُوسَىٰ بْنَ عِمْرَانَ وَمَنْ مَعَهُ"
  },
  {
   "segment_id": 40,
   "arabic": "وَبِٱسْمِكَ ٱلَّذِي دَعَاكَ بِهِ مُوسَىٰ بْنُ عِمْرَانَ"
  },
  {
   "segment_id": 41,
   "arabic": "مِنْ جَانِبِ ٱلطُّورِ ٱلايْمَنِ"
  },
  {
   "segment_id": 42,
   "arabic": "فَٱسْتَجَبْتَ لَهُ وَالْقَيْتَ عَلَيْهِ مَحَبَّةً مِنْكَ"
  },
  {
   "segment_id": 43,
   "arabic": "وَبِٱسْمِكَ ٱلَّذِي بِهِ احْيَا عِيسَىٰ بْنُ مَرْيَمَ ٱلْمَوْتَىٰ"
  },
  {
   "segment_id": 44,
   "arabic": "وَتَكَلَّمَ فِي ٱلْمَهْدِ صَبِيّاً"
  },
  {
   "segment_id": 45,
   "arabic": "وَابْرَا ٱلاكْمَهَ وَٱلابْرَصَ بِإِذْنِكَ"
  },
  {
   "segment_id": 46,
   "arabic": "وَبِٱسْمِكَ ٱلَّذِي دَعَاكَ بِهِ حَمَلَةُ عَرْشِكَ"
  },
  {
   "segment_id": 47,
   "arabic": "وَجَبْرَائِيلُ وَمِيكَائِيلُ وَإِسْرَافِيلُ"
  },
  {
   "segment_id": 48,
   "arabic": "وَحَبِيبُكَ مُحَمَّدٌ صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ"
  },
  {
   "segment_id": 49,
   "arabic": "وَمَلائِكَتُكَ ٱلْمُقَرَّبُونَ"
  },
  {
   "segment_id": 50,
   "arabic": "وَانْبِيَاؤُكَ ٱلْمُرْسَلُونَ"
  },
  {
   "segment_id": 51,
   "arabic": "وَعِبَادُكَ ٱلصَّالِحُونَ مِنْ اهْلِ ٱلسَّمَاوَاتِ وَٱلارَضِينَ"
  },
  {
   "segment_id": 52,
   "arabic": "وَبِٱسْمِكَ ٱلَّذِي دَعَاكَ بِهِ ذُو ٱلنُّونِ"
  },
  {
   "segment_id": 53,
   "arabic": "إِذْ ذَهَبَ مُغَاضِباً فَظَنَّ انْ لَنْ تَقْدِرَ عَلَيْهِ"
  },
  {
   "segment_id": 54,
   "arabic": "فَنَادَىٰ فِي ٱلظُّلُمَاتِ انْ لاَ إِلٰهَ إِلاَّ انْتَ سُبْحَانَكَ"
  },
  {
   "segment_id": 55,
   "arabic": "إِنِّي كُنْتُ مِنَ ٱلظَّالِمِينَ"
  },
  {
   "segment_id": 56,
   "arabic": "فَٱسْتَجَبْتَ لَهُ وَنَجَّيْتَهُ مِنَ ٱلغَمِّ"
  },
  {
   "segment_id": 57,
   "arabic": "وَكَذٰلِكَ تُنْجِي ٱلْمُؤْمِنِينَ"
  },
  {
   "segment_id": 58,
   "arabic": "وَبِٱسْمِكَ ٱلْعَظِيمِ ٱلَّذِي دَعَاكَ بِهِ دَاوُودُ"
  },
  {
   "segment_id": 59,
   "arabic": "وَخَرَّ لَكَ سَاجِداً فَغَفَرْتَ لَهُ ذَنْبَهُ"
  },
  {
   "segment_id": 60,
   "arabic": "وَبِٱسْمِكَ ٱلَّذِي دَعَتْكَ بِهِ آسِيَةُ ٱمْرَاةُ فِرْعَوْنَ"
  },
  {
   "segment_id": 61,
   "arabic": "إِذْ قَالَتْ: ”رَبِّ ٱبْنِ لِي عِنْدَكَ بَيْتاً فِي ٱلْجَنَّةِ"
  },
  {
   "segment_id": 62,
   "arabic": "وَنَجِّنِي مِنْ فِرْعَوْنَ وَعَمَلِهِ"
  },
  {
   "segment_id": 63,
   "arabic": "وَنَجِّنِي مِنَ ٱلْقَوْمِ ٱلظَّالِمِينَ“"
  },
  {
   "segment_id": 64,
   "arabic": "فَٱسْتَجَبْتَ لَهَا دُعَاءَهَا"
  },
  {
   "segment_id": 65,
   "arabic": "وَبِٱسْمِكَ ٱلَّذِي دَعَاكَ بِهِ ايُّوبُ إِذْ حَلَّ بِهِ ٱلْبَلاَءُ"
  },
  {
   "segment_id": 66,
   "arabic": "فَعَافَيْتَهُ وَآتَيْتَهُ اهْلَهُ وَمِثْلَهُمْ مَعَهُمْ"
  },
  {
   "segment_id": 67,
   "arabic": "رَحْمَةً مِنْ عِنْدِكَ وَذِكْرَىٰ لِلْعَابِدِينَ"
  },
  {
   "segment_id": 68,
   "arabic": "وَبِٱسْمِكَ ٱلَّذِي دَعَاكَ بِهِ يَعْقُوبُ"
  },
  {
   "segment_id": 69,
   "arabic": "فَرَدَدْتَ عَلَيْهِ بَصَرَهُ وَقُرَّةَ عَيْنِهِ يُوسُفَ وَجَمَعْتَ شَمْلَهُ"
  },
  {
   "segment_id": 70,
   "arabic": "وَبِٱسْمِكَ ٱلَّذِي دَعَاكَ بِهِ سُلَيْمَانُ"
  },
  {
   "segment_id": 71,
   "arabic": "فَوَهَبْتَ لَهُ مُلْكاً لاَ يَنْبَغِي لاحَدٍ مِنْ بَعْدِهِ"
  },
  {
   "segment_id": 72,
   "arabic": "إِنَّكَ انْتَ ٱلْوَهَّابُ"
  },
  {
   "segment_id": 73,
   "arabic": "وَبِٱسْمِكَ ٱلَّذِي سَخَّرْتَ بِهِ ٱلْبُرَاقَ لِمُحَمَّدٍ"
  },
  {
   "segment_id": 74,
   "arabic": "صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ وَسَلَّمَ"
  },
  {
   "segment_id": 75,
   "arabic": "إِذْ قَالَ تَعَالَىٰ: ”سُبْحَانَ ٱلَّذِي اسْرَىٰ بِعَبْدِهِ لَيْلاً"
  },
  {
   "segment_id": 76,
   "arabic": "مِنَ ٱلْمَسْجِدِ ٱلْحَرَامِ إِلَىٰ ٱلْمَسْجِدِ ٱلاقْصَىٰ“"
  },
  {
   "segment_id": 77,
   "arabic": "وَقَوْلُهُ: ”سُبْحَانَ ٱلَّذِي سَخَّرَ لَنَا هٰذَا وَمَا كُنَّا لَهُ مُقْرِنِينَ"
  },
  {
   "segment_id": 78,
   "arabic": "وَإِنَّا إِلَىٰ رَبِّنَا لَمُنْقَلِبُونَ“"
  },
  {
   "segment_id": 79,
   "arabic": "وَبِٱسْمِكَ ٱلَّذِي تَنَزَّلَ بِهِ جَبْرَائِيلُ عَلَىٰ مُحَمَّدٍ"
  },
  {
   "segment_id": 80,
   "arabic": "صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ"
  },
  {
   "segment_id": 81,
   "arabic": "وَبِٱسْمِكَ ٱلَّذِي دَعَاكَ بِهِ آدَمُ"
  },
  {
   "segment_id": 82,
   "arabic": "فَغَفَرْتَ لَهُ ذَنْبَهُ وَاسْكَنْتَهُ جَنَّتَكَ"
  },
  {
   "segment_id": 83,
   "arabic": "وَاسْالُكَ بِحَقِّ ٱلْقُرْآنِ ٱلْعَظِيمِ"
  },
  {
   "segment_id": 84,
   "arabic": "وَبِحَقِّ مُحَمَّدٍ خَاتَمِ ٱلنَّبِيِّينَ"
  },
  {
   "segment_id": 85,
   "arabic": "وَبِحَقِّ إِبْرَاهِيمَ"
  },
  {
   "segment_id": 86,
   "arabic": "وَبِحَقِّ فَصْلِكَ يَوْمَ ٱلْقَضَاءِ"
  },
  {
   "segment_id": 87,
   "arabic": "وَبِحَقِّ ٱلْمَوَازِينِ إِذَا نُصِبَتْ"
  },
  {
   "segment_id": 88,
   "arabic": "وَٱلصُّحُفِ إِذَا نُشِرَتْ"
  },
  {
   "segment_id": 89,
   "arabic": "وَبِحَقِّ ٱلْقَلَمِ وَمَا جَرَىٰ"
  },
  {
   "segment_id": 90,
   "arabic": "وَٱللَّوْحِ وَمَا احْصَىٰ"
  },
  {
   "segment_id": 91,
   "arabic": "وَبِحَقِّ ٱلاِﹾسْمِ ٱلَّذِي كَتَبْتَهُ عَلَىٰ سُرَادِقِ ٱلْعَرْشِ"
  },
  {
   "segment_id": 92,
   "arabic": "قَبْلَ خَلْقِكَ ٱلْخَلْقَ وَٱلدُّنْيَا"
  },
  {
   "segment_id": 93,
   "arabic": "وَٱلشَّمْسَ وَٱلْقَمَرَ بِالْفَيْ عَامٍ"
  },
  {
   "segment_id": 94,
   "arabic": "وَاشْهَدُ انْ لاَ إِلٰهَ إِلاَّ ٱللَّهُ"
  },
  {
   "segment_id": 95,
   "arabic": "وَحْدَهُ لاَ شَرِيكَ لَهُ"
  },
  {
   "segment_id": 96,
   "arabic": "وَانَّ مُحَمَّداً عَبْدُهُ وَرَسُولُهُ"
  },
  {
   "segment_id": 97,
   "arabic": "وَاسْالُكَ بِٱسْمِكَ ٱلْمَخْزُونِ فِي خَزَائِنِكَ"
  },
  {
   "segment_id": 98,
   "arabic": "ٱلَّذِي ٱسْتَاثَرْتَ بِهِ فِي عِلْمِ ٱلْغَيْبِ عِنْدَكَ"
  },
  {
   "segment_id": 99,
   "arabic": "لَمْ يَظْهَرْ عَلَيْهِ احَدٌ مِنْ خَلْقِكَ"
  },
  {
   "segment_id": 100,
   "arabic": "لاَ مَلَكٌ مُقَرَّبٌ"
  },
  {
   "segment_id": 101,
   "arabic": "وَلاَ نَبِيٌّ مُرْسَلٌ"
  },
  {
   "segment_id": 102,
   "arabic": "وَلاَ عَبْدٌ مُصْطَفَىٰ"
  },
  {
   "segment_id": 103,
   "arabic": "وَاسْالُكَ بِٱسْمِكَ ٱلَّذِي شَقَقْتَ بِهِ ٱلْبِحَارَ"
  },
  {
   "segment_id": 104,
   "arabic": "وَقَامَتْ بِهِ ٱلْجِبَالُ"
  },
  {
   "segment_id": 105,
   "arabic": "وَٱخْتَلَفَ بِهِ ٱللَّيْلُ وَٱلنَّهَارُ"
  },
  {
   "segment_id": 106,
   "arabic": "وَبِحَقِّ ٱلسَّبْعِ ٱلْمَثَانِي وَٱلْقُرْآنِ ٱلْعَظِيمِ"
  },
