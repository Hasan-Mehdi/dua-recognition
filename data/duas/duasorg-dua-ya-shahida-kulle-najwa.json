   "arabic": "وَٱقْلِبْنِي إِلَىٰ اهْلِي بِٱلفَلاَحِ وَٱلنَّجَاحِ"
  },
  {
   "segment_id": 202,
   "arabic": "مَحْبُوراً فِي ٱلْعَاجِلِ وَٱلآجِلِ"
