  {
   "segment_id": 123,
   "arabic": "وَاسْالُكَ بِٱسْمِكَ ٱلَّذِي كَتَبْتَهُ عَلَىٰ سُرَادِقِ ٱلْمَجْدِ وَٱلْكَرَامَةِ"
  },
  {
   "segment_id": 124,
   "arabic": "يَا مَنْ لاَ يُخْفِيهِ سَائِلٌ"
