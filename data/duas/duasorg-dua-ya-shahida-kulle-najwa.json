   "arabic": "اللَّهُمَّ لاَ تَجْعَلْنِي مِنَ ٱلاشْرَارِ"
  },
  {
   "segment_id": 220,
   "arabic": "وَلاَ مِنْ اصْحَابِ ٱلنَّارِ"
  },
  {
   "segment_id": 221,
   "arabic": "وَلاَ تَحْرِمْنِي صُحْبَةَ ٱلاخْيَارِ"
  },
  {
   "segment_id": 222,
   "arabic": "وَاحْيِنِي حَيَاةً طَيِّبَةً"
  },
  {
   "segment_id": 223,
   "arabic": "وَتَوَفَّنِي وَفَاةً طَيِّبَةً تُلْحِقُنِي بِٱلابْرَارِ"
  },
  {
   "segment_id": 224,
   "arabic": "وَٱرْزُقْنِي مُرَافَقَةَ ٱلانْبِيَاءِ"
  },
  {
   "segment_id": 225,
   "arabic": "فِي مَقْعَدِ صِدْقٍ عِنْدَ مَلِيكٍ مُقْتَدِرٍ"
  },
  {
   "segment_id": 226,
   "arabic": "اللَّهُمَّ لَكَ ٱلْحَمْدُ عَلَىٰ حُسْنِ بَلاَئِكَ وَصُنْعِكَ"
  },
  {
   "segment_id": 227,
   "arabic": "وَلَكَ ٱلْحَمْدُ عَلَىٰ ٱلإِسْلاَمِ وَٱتِّبَاعِ ٱلسُّنَّةِ"
  },
  {
   "segment_id": 228,
   "arabic": "يَا رَبِّ كَمَا هَدَيْتَهُمْ لِدِينِكَ"
  },
  {
   "segment_id": 229,
   "arabic": "وَعَلَّمْتَهُمْ كِتَابَكَ فَٱهْدِنَا وَعَلِّمْنَا"
  },
  {
   "segment_id": 230,
   "arabic": "وَلَكَ ٱلْحَمْدُ عَلَىٰ حُسْنِ بَلاَئِكَ وَصُنْعِكَ عِنْدِي خَاصَّةً"
  },
  {
   "segment_id": 231,
   "arabic": "كَمَا خَلَقْتَنِي فَاحْسَنْتَ خَلْقِي"
  },
  {
   "segment_id": 232,
   "arabic": "وَعَلَّمْتَنِي فَاحْسَنْتَ تَعْلِيمِي"
  },
  {
   "segment_id": 233,
   "arabic": "وَهَدَيْتَنِي فَاحْسَنْتَ هِدَايَتِي"
  },
  {
   "segment_id": 234,
   "arabic": "فَلَكَ ٱلْحَمْدُ عَلَىٰ إِنْعَامِكَ عَلَيَّ قَدِيماً وَحَدِيثاً"
  },
  {
   "segment_id": 235,
   "arabic": "فَكَمْ مِنْ كَرْبٍ يَا سَيِّدِي قَدْ فَرَّجْتَهُ"
  },
  {
   "segment_id": 236,
   "arabic": "وَكَمْ مِنْ غَمٍّ يَا سَيِّدِي قَدْ نَفَّسْتَهُ"
  },
  {
   "segment_id": 237,
   "arabic": "وَكَمْ مِنْ هَمٍّ يَا سَيِّدِي قَدْ كَشَفْتَهُ"
  },
  {
   "segment_id": 238,
   "arabic": "وَكَمْ مِنْ بَلاَءٍ يَا سَيِّدِي قَدْ صَرَفْتَهُ"
  },
  {
   "segment_id": 239,
   "arabic": "وَكَمْ مِنْ عَيْبٍ يَا سَيِّدِي قَدْ سَتَرْتَهُ"
  },
  {
   "segment_id": 240,
   "arabic": "فَلَكَ ٱلْحَمْدُ عَلَىٰ كُلِّ حَالٍ"
  },
  {
   "segment_id": 241,
   "arabic": "فِي كُلِّ مَثْوَىٰ وَزَمَانٍ"
  },
  {
   "segment_id": 242,
   "arabic": "وَمُنْقَلَبٍ وَمَقَامٍ"
  },
  {
   "segment_id": 243,
   "arabic": "وَعَلَىٰ هٰذِهِ ٱلْحَالِ وَكُلِّ حَالٍ"
  },
  {
   "segment_id": 244,
   "arabic": "اللَّهُمَّ ٱجْعَلْنِي مِنْ افْضَلِ عِبَادِكَ نَصِيباً"
  },
  {
   "segment_id": 245,
   "arabic": "فِي هٰذَا ٱلْيَوْمِ مِنْ خَيْرٍ تَقْسِمُهُ"
  },
  {
   "segment_id": 246,
   "arabic": "اوْ ضُرٍّ تَكْشِفُهُ"
  },
  {
   "segment_id": 247,
   "arabic": "اوْ سُوءٍ تَصْرِفُهُ"
  },
  {
   "segment_id": 248,
   "arabic": "اوْ بَلاَءٍ تَدْفَعُهُ"
  },
  {
   "segment_id": 249,
   "arabic": "اوْ خَيْرٍ تَسُوقُهُ"
  },
  {
   "segment_id": 250,
   "arabic": "اوْ رَحْمَةٍ تَنْشُرُهَا"
  },
  {
   "segment_id": 251,
   "arabic": "اوْ عَافِيَةٍ تُلْبِسُهَا"
  },
  {
   "segment_id": 252,
   "arabic": "فَإِنَّكَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ"
  },
  {
   "segment_id": 253,
   "arabic": "وَبِيَدِكَ خَزَائِنُ ٱلسَّمَاوَاتِ وَٱلارْضِ"
  },
  {
   "segment_id": 254,
   "arabic": "وَانْتَ ٱلْوَاحِدُ ٱلْكَرِيمُ ٱلْمُعْطِي"
  },
  {
   "segment_id": 255,
   "arabic": "ٱلَّذِي لاَ يُرَدُّ سَائِلُهُ"
  },
  {
   "segment_id": 256,
   "arabic": "وَلاَ يُخَيَّبُ آمِلُهُ"
  },
  {
   "segment_id": 257,
   "arabic": "وَلاَ يَنْقُصُ نَائِلُهُ"
  },
  {
   "segment_id": 258,
   "arabic": "وَلاَ يَنْفَدُ مَا عِنْدَهُ"
  },
  {
   "segment_id": 259,
   "arabic": "بَلْ يَزْدَادُ كَثْرَةً وَطِيباً"
  },
  {
   "segment_id": 260,
   "arabic": "وَعَطَاءً وَجُوداً"
  },
  {
   "segment_id": 261,
   "arabic": "وَٱرْزُقْنِي مِنْ خَزَائِنِكَ ٱلَّتِي لاَ تَفْنَىٰ"
  },
  {
   "segment_id": 262,
   "arabic": "وَمِنْ رَحْمَتِكَ ٱلْوَاسِعَةِ"
  },
  {
   "segment_id": 263,
   "arabic": "إِنَّ عَطَاءَكَ لَمْ يَكُنْ مَحْظُوراً"
  },
