{
 "dua_id": "dua-aahad",
 "dua_name_en": "Dua Ahd",
 "dua_name_ar": "دعاء عَهْد",
 "source": "https://www.duaplayer.org/en/dua/aahad",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "ِسْمِ ٱللَّهِ ٱلرَّحْمٰنِ ٱلرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اللّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 3,
   "arabic": "اَللَّهُمَّ رَبَّ ٱلنُّورِ ٱلْعَظِيمِ"
  },
  {
   "segment_id": 4,
   "arabic": "وَرَبَّ ٱلْكُرْسِيِّ ٱلرَّفِيعِ"
  },
  {
   "segment_id": 5,
   "arabic": "وَرَبَّ ٱلْبَحْرِ ٱلْمَسْجُورِ"
  },
  {
   "segment_id": 6,
   "arabic": "وَمُنْزِلَ ٱلتَّوْرَاةِ وَٱلإِنْجِيلِ وَٱلزَّبُورِ"
  },
  {
   "segment_id": 7,
   "arabic": "وَرَبَّ ٱلظِّلِّ وَٱلْحَرُورِ"
  },
  {
   "segment_id": 8,
   "arabic": "وَمُنْزِلَ ٱلْقُرْآنِ ٱلْعَظِيمِ"
  },
  {
   "segment_id": 9,
   "arabic": "وَرَبَّ ٱلْمَلاَئِكَةِ ٱلْمُقَرَّبِينَ"
  },
  {
   "segment_id": 10,
   "arabic": "وَٱلانْبِيَاءِ وَٱلْمُرْسَلِينَ"
  },
  {
   "segment_id": 11,
   "arabic": "اَللَّهُمَّ إِنِّي اسْالُكَ بِٱسْمِكَ ٱلْكَرِيـمِ"
  },
  {
   "segment_id": 12,
   "arabic": "وَبِنُورِ وَجْهِكَ ٱلْمُنِيرِ"
  },
  {
   "segment_id": 13,
   "arabic": "وَمُلْكِكَ ٱلْقَدِيمِ"
  },
  {
   "segment_id": 14,
   "arabic": "يَا حَيُّ يَا قَيُّومُ"
  },
  {
   "segment_id": 15,
   "arabic": "اسْالُكَ بِٱسْمِكَ ٱلَّذِي اشْرَقَتْ بِهِ ٱلسَّمَاوَاتُ وَٱلارَضُونَ"
  },
  {
   "segment_id": 16,
   "arabic": "وَبِٱسْمِكَ ٱلَّذِي يَصْلَحُ بِهِ ٱلاوَّلُونَ وَٱلآخِرُونَ"
  },
  {
   "segment_id": 17,
   "arabic": "يَا حَيّاً قَبْلَ كُلِّ حَيٍّ"
  },
  {
   "segment_id": 18,
   "arabic": "وَيَا حَيّاً بَعْدَ كُلِّ حَيٍّ"
  },
  {
   "segment_id": 19,
   "arabic": "وَيَا حَيّاً حِينَ لا حَيُّ"
  },
  {
   "segment_id": 20,
   "arabic": "يَا مُحْيِيَ ٱلْمَوْتَىٰ وَمُمِيتَ ٱلاحْيَاءِ"
  },
  {
   "segment_id": 21,
   "arabic": "يَا حَيُّ لا إِلٰهَ إِلاَّ انْتَ"
  },
  {
   "segment_id": 22,
   "arabic": "اَللَّهُمَّ بَلِّغْ مَوْلاَنَا ٱلإِمَامَ ٱلْهَادِيَ ٱلْمَهْدِيَّ ٱلْقَائِمَ بِامْرِكَ"
  },
  {
   "segment_id": 23,
   "arabic": "صَلَوَاتُ ٱللَّهِ عَلَيْهِ وَعَلَىٰ آبَائِهِ ٱلطَّاهِرِينَ"
  },
  {
   "segment_id": 24,
   "arabic": "عَنْ جَمِيعِ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَاتِ"
  },
  {
   "segment_id": 25,
   "arabic": "فِي مَشَارِقِ ٱلارْضِ وَمَغَارِبِهَا"
  },
  {
   "segment_id": 26,
   "arabic": "سَهْلِهَا وَجَبَلِهَا"
  },
  {
   "segment_id": 27,
   "arabic": "وَبَرِّهَا وَبَحْرِهَا"
  },
  {
   "segment_id": 28,
   "arabic": "وَعَنِّي وَعَنْ وَالِدَيَّ"
  },
  {
   "segment_id": 29,
   "arabic": "مِنَ ٱلصَّلَوَاتِ زِنَةَ عَرْشِ ٱللَّهِ"
  },
  {
   "segment_id": 30,
   "arabic": "وَمِدَادَ كَلِمَاتِهِ"
  },
  {
   "segment_id": 31,
   "arabic": "وَمَا احْصَاهُ عِلْمُهُ وَاحَاطَ بِهِ كِتَابُهُ"
  },
  {
   "segment_id": 32,
   "arabic": "اَللَّهُمَّ إِنِّي اجَدِّدُ لَهُ فِي صَبِيحَةِ يَوْمِي هٰذَا"
  },
  {
   "segment_id": 33,
   "arabic": "وَمَا عِشْتُ مِنْ ايَّامِي"
  },
  {
   "segment_id": 34,
   "arabic": "عَهْداً وَعَقْداً وَبَيْعَةً لَهُ فِي عُنُقِي"
  },
  {
   "segment_id": 35,
   "arabic": "لا احُولُ عَنْه وَلا ازُولُ ابَداً"
  },
  {
   "segment_id": 36,
   "arabic": "اَللَّهُمَّ ٱجْعَلْنِي مِنْ انْصَارِهِ"
  },
  {
   "segment_id": 37,
   "arabic": "وَاعْوَانِهِ وَٱلذَّابِّينَ عَنْهُ"
  },
  {
   "segment_id": 38,
   "arabic": "وَٱلْمُسَارِعِينَ إِلَيْهِ فِي قَضَاءِ حَوَائِجِهِ"
  },
  {
   "segment_id": 39,
   "arabic": "وَٱلْمُمْتَثِلِينَ لاِوَامِرِهِ"
  },
  {
   "segment_id": 40,
   "arabic": "وَٱلْمُحَامِينَ عَنْهُ"
  },
  {
   "segment_id": 41,
   "arabic": "وَٱلسَّابِقِينَ إِلَىٰ إِرَادَتِهِ"
  },
  {
   "segment_id": 42,
   "arabic": "وَٱلْمُسْتَشْهَدِينَ بَيْنَ يَدَيْهِ"
  },
  {
   "segment_id": 43,
   "arabic": "اَللَّهُمَّ إِنْ حَالَ بَيْنِي وَبَيْنَهُ ٱلْمَوْتُ ٱلَّذِي جَعَلْتَهُ عَلَىٰ عِبَادِكَ حَتْماً مَقْضِيّاً"
  },
  {
   "segment_id": 44,
   "arabic": "فَاخْرِجْنِي مِنْ قَبْرِي مُؤْتَزِراً كَفَنِي"
  },
  {
   "segment_id": 45,
   "arabic": "شَاهِراً سَيْفِي"
  },
  {
   "segment_id": 46,
   "arabic": "مُجَرِّداً قَنَاتِي"
  },
  {
   "segment_id": 47,
   "arabic": "مُلَبِّياً دَعْوَةَ ٱلدَّاعِي فِي ٱلْحَاضِرِ وَٱلْبَادِي"
  },
  {
   "segment_id": 48,
   "arabic": "اَللَّهُمَّ ارِنِي ٱلطَّلْعَةَ ٱلرَّشِيدَةَ"
  },
  {
   "segment_id": 49,
   "arabic": "وَٱلْغُرَّةَ ٱلْحَمِيدَةَ"
  },
  {
   "segment_id": 50,
   "arabic": "وَٱكْحُلْ نَاظِرِي بِنَظْرَةٍ مِنِّي إِلَيْهِ"
  },
  {
   "segment_id": 51,
   "arabic": "وَعَجِّلْ فَرَجَهُ"
  },
  {
   "segment_id": 52,
   "arabic": "وَسَهِّلْ مَخْرَجَهُ"
  },
  {
   "segment_id": 53,
   "arabic": "وَاوْسِعْ مَنْهَجَهُ"
  },
  {
   "segment_id": 54,
   "arabic": "وَٱسْلُكْ بِي مَحَجَّتَهُ"
  },
  {
   "segment_id": 55,
   "arabic": "وَانْفِذْ امْرَهُ"
  },
  {
   "segment_id": 56,
   "arabic": "وَٱشْدُدْ ازْرَهُ"
  },
  {
   "segment_id": 57,
   "arabic": "وَٱعْمُرِ ٱللَّهُمَّ بِهِ بِلادَكَ"
  },
  {
   "segment_id": 58,
   "arabic": "وَاحْيِ بِهِ عِبَادَكَ"
  },
  {
   "segment_id": 59,
   "arabic": "فَإِنَّكَ قُلْتَ وَقَوْلُكَ ٱلْحَقُّ:"
  },
  {
   "segment_id": 60,
   "arabic": "«ظَهَرَ ٱلْفَسَادُ فِي ٱلْبَرِّ وَٱلْبَحْرِ"
  },
  {
   "segment_id": 61,
   "arabic": "بِمَا كَسَبَتْ ايْدِي ٱلنَّاسِ.»"
  },
  {
   "segment_id": 62,
   "arabic": "فَاظْهِرِ ٱللَّهُمَّ لَنَا وَلِيَّكَ"
  },
  {
   "segment_id": 63,
   "arabic": "وَٱبْنَ بِنْتِ نَبِيِّكَ"
  },
  {
   "segment_id": 64,
   "arabic": "ٱلْمُسَمَّىٰ بِٱسْمِ رَسُولِكَ"
  },
  {
   "segment_id": 65,
   "arabic": "صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ"
  },
  {
   "segment_id": 66,
   "arabic": "حَتَّىٰ لا يَظْفَرَ بِشَيْءٍ مِنَ ٱلْبَاطِلِ إِلاَّ مَزَّقَهُ"
  },
  {
   "segment_id": 67,
   "arabic": "وَيُحِقُّ ٱلْحَقَّ وَيُحَقِّقَهُ"
  },
  {
   "segment_id": 68,
   "arabic": "وَٱجْعَلْهُ ٱللَّهُمَّ مَفْزَعاً لِمَظْلُومِ عِبَادِكَ"
  },
  {
   "segment_id": 69,
   "arabic": "وَنَاصِراً لِمَنْ لا يَجِدُ لَهُ نَاصِراً غَيْرَكَ"
  },
  {
   "segment_id": 70,
   "arabic": "وَمُجَدِّداً لِمَا عُطِّلَ مِنْ احْكَامِ كِتَابِكَ"
  },
  {
   "segment_id": 71,
   "arabic": "وَمُشَيِّداً لِمَا وَرَدَ مِنْ اعْلامِ دِينِكَ وَسُنَنِ نَبِيِّكَ"
  },
  {
   "segment_id": 72,
   "arabic": "صَلَّىٰ ٱللَّهُ عَلَيْهِ وآلِهِ"
  },
  {
   "segment_id": 73,
   "arabic": "وَٱجْعَلْهُ ٱللَّهُمَّ مِمَّنْ حَصَّنْتَهُ مِنْ بَاسِ ٱلْمُعْتَدِينَ"
  },
  {
   "segment_id": 74,
   "arabic": "اَللَّهُمَّ وَسُرَّ نَبِيَّكَ مُحَمَّداً"
  },
  {
   "segment_id": 75,
   "arabic": "صَلَّىٰ ٱللَّهُ عَلَيْهِ وآلِهِ"
  },
  {
   "segment_id": 76,
   "arabic": "بِرُؤْيَتِهِ وَمَنْ تَبِعَهُ عَلَىٰ دَعْوَتِهِ"
  },
  {
   "segment_id": 77,
   "arabic": "وَٱرْحَمِ ٱسْتِكَانَتَنَا بَعْدَهُ"
  },
  {
   "segment_id": 78,
   "arabic": "اَللَّهُمَّ ٱكْشِفْ هٰذِهِ ٱلْغُمَّةَ عَنْ هٰذِهِ ٱلامَّةِ بِحُضُورِهِ"
  },
  {
   "segment_id": 79,
   "arabic": "وَعَجِّلْ لَنَا ظُهُورَهُ"
  },
  {
   "segment_id": 80,
   "arabic": "«إِنَّهُمْ يَرَوْنَهُ بَعِيداً وَنَرَاهُ قَرِيباً.»"
  },
  {
   "segment_id": 81,
   "arabic": "بِرَحْمَتِكَ يَا ارْحَمَ ٱلرَّاحِمِينَ"
  },
  {
   "segment_id": 82,
   "arabic": ""
  },
  {
   "segment_id": 83,
   "arabic": "الْعَجَلَ ٱلْعَجَلَ يَامَوْلايَ يَا صَاحِبَ ٱلزَّمَانِ"
  }
 ]
}