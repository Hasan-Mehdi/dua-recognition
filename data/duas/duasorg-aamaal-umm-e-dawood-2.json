 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللَّهُمَّ لَكَ سَجَدْتُ"
  },
  {
   "segment_id": 2,
   "arabic": "وَبِكَ آمَنْتُ"
  },
  {
   "segment_id": 3,
   "arabic": "فَٱرْحَمْ ذُلِّي وَفَاقَتِي"
  },
  {
