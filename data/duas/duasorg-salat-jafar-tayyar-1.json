{
 "dua_id": "duasorg-salat-jafar-tayyar-1",
 "dua_name_en": "Salat Jafar e Tayyar",
 "dua_name_ar": "",
 "source": "https://www.duas.org/salat-jafar-tayyar.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "سُبْحَانَ مَنْ لَبِسَ ٱلْعِزَّ وَٱلْوَقَارَ"
  },
  {
   "segment_id": 2,
   "arabic": "سُبْحَانَ مَنْ تَعَطَّفَ بِٱلْمَجْدِ وَتَكَرَّمَ بِهِ"
  },
  {
   "segment_id": 3,
   "arabic": "سُبْحَانَ مَنْ لاَ يَنْبَغِي ٱلتَّسْبِيحُ إِلاَّ لَهُ"
  },
  {
   "segment_id": 4,
   "arabic": "سُبْحَانَ مَنْ احْصَىٰ كُلَّ شَيْءٍ عِلْمُهُ"
  },
  {
   "segment_id": 5,
   "arabic": "سُبْحَانَ ذِي ٱلْمَنِّ وَٱلنِّعَمِ"
  },
  {
   "segment_id": 6,
   "arabic": "سُبْحَانَ ذِي ٱلْقُدْرَةِ وَٱلْكَرَمِ"
  },
  {
   "segment_id": 7,
   "arabic": "اَللَّهُمَّ إِنِّي اسْالُكَ بِمَعَاقِدِ ٱلْعِزِّ مِنْ عَرْشِكَ"
  },
  {
   "segment_id": 8,
   "arabic": "وَمُنْتَهَىٰ ٱلرَّحْمَةِ مِنْ كِتَابِكَ"
  },
  {
   "segment_id": 9,
   "arabic": "وَٱسْمِكَ ٱلاعْظَمِ"
  },
  {
   "segment_id": 10,
   "arabic": "وَكَلِمَاتِكَ ٱلتَّامَّةِ"
  },
  {
   "segment_id": 11,
   "arabic": "ٱلَّتِي تَمَّتْ صِدْقاً وَعَدْلاًَ"
  },
  {
   "segment_id": 12,
   "arabic": "صَلِّ عَلَىٰ مُحَمَّدٍ وَاهْلِ بَيْتِهِ…"
  }
 ]
}