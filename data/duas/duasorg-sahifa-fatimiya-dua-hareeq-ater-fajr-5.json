{
 "dua_id": "duasorg-sahifa-fatimiya-dua-hareeq-ater-fajr-5",
 "dua_name_en": "Instruction Block",
 "dua_name_ar": "",
 "source": "https://www.duas.org/sahifa-fatimiya-dua-hareeq-ater-fajr.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "أَللَّهُمَّ رَبَّ النُّورِ الْعَظيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "وَرَبَّ الْكُرْسِيِّ الرَّفيعِ"
  },
  {
   "segment_id": 3,
   "arabic": "وَرَبَّ الْبَحْرِ الْمَسْجُورِ"
  },
  {
   "segment_id": 4,
   "arabic": "وَمُنْزِلَ التَّوْراةِ وَالْإِنْجيلِ"
  },
  {
   "segment_id": 5,
   "arabic": "وَرَبَّ الظِّلِّ وَالْحَرُورِ"
  },
  {
   "segment_id": 6,
   "arabic": "وَمُنْزِلَ الزَّبُورِ وَالْقُرْآنِ الْعَظيمِ"
  },
  {
   "segment_id": 7,
   "arabic": "وَرَبَّ الْمَلائِكَةِ الْمُقَرَّبينَ"
  },
  {
   "segment_id": 8,
   "arabic": "وَالْأَنْبِياءِ الْمُرْسَلينَ"
  },
  {
   "segment_id": 9,
   "arabic": "أَنْتَ إِلهُ مَنْ فِي السَّماءِ وَ إِلهُ مَنْ فِي الْأَرْضِ"
  },
  {
   "segment_id": 10,
   "arabic": "لا إِلهَ فيهِما غَيْرُكَ"
  },
  {
   "segment_id": 11,
   "arabic": "وَأَنْتَ جَبَّارُ مَنْ فِي السَّماءِ"
  },
  {
   "segment_id": 12,
   "arabic": "وَجَبَّارُ مَنْ فِي الْأَرْضِ"
  },
  {
   "segment_id": 13,
   "arabic": "لا جَبَّارَ فيهِما غَيْرُكَ"
  },
  {
   "segment_id": 14,
   "arabic": "وَأَنْتَ خالِقُ مَنْ فِى السَّماءِ"
  },
  {
   "segment_id": 15,
   "arabic": "وَخالِقُ مَنْ فِي الْأَرْضِ"
  },
  {
   "segment_id": 16,
   "arabic": "لا خالِقَ فيهِما غَيْرُكَ"
  },
  {
   "segment_id": 17,
   "arabic": "وَأَنْتَ حَكَمُ مَنْ فِي السَّماءِ"
  },
  {
   "segment_id": 18,
   "arabic": "وَحَكَمُ مَنْ فِي الْأَرْضِ لا حَكَمَ فيهِما غَيْرُكَ"
  },
  {
   "segment_id": 19,
   "arabic": "أَللَّهُمَّ إِنّي أَسْأَلُكَ بِوَجْهِكَ الْكَريمِ"
  },
  {
   "segment_id": 20,
   "arabic": "وَبِنُورِ وَجْهِكَ الْمُنيرِ وَمُلْكِكَ الْقَديمِ"
  },
  {
   "segment_id": 21,
   "arabic": "يا حَيُّ يا قَيُّومُ"
  },
  {
   "segment_id": 22,
   "arabic": "أَسْأَلُكَ بِاسْمِكَ الَّذي أَشْرَقَتْ بِهِ السَّماواتُ وَالْأَرَضُونَ"
  },
  {
   "segment_id": 23,
   "arabic": "وَبِاسْمِكَ الَّذي يَصْلُحُ بِهِ الْأَوَّلُونَ وَالْآخِرُونَ"
  },
  {
   "segment_id": 24,
   "arabic": "يا حَيّاً قَبْلَ كُلِّ حَيٍّ وَيا حَيّاً بَعْدَ كُلِّ حَيٍّ"
  },
  {
   "segment_id": 25,
   "arabic": "وَيا حَيّاً حينَ لا حَيَّ وَيا مُحْيِيَ الْمَوْتى"
  },
  {
   "segment_id": 26,
   "arabic": "وَيا حَيُّ لا إِلهَ إِلّا أَنْتَ يا حَيُّ يا قَيُّومُ"
  },
  {
   "segment_id": 27,
   "arabic": "أَسْأَلُكَ أَنْ تُصَلِّيَ عَلى مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 28,
   "arabic": "وَارْزُقْني مِنْ حَيْثُ أَحْتَسِبُ"
  },
  {
   "segment_id": 29,
   "arabic": "وَمِنْ حَيْثُ لا أَحْتَسِبُ"
  },
  {
   "segment_id": 30,
   "arabic": "رِزْقاً واسِعاً حَلالاً طَيِّباً"
  },
  {
   "segment_id": 31,
   "arabic": "وَأَنْ تُفَرِّجَ عَنِّي كُلَّ غَمٍّ وَهَمٍّ"
  },
  {
   "segment_id": 32,
   "arabic": "وَأَنْ تُعْطِيَني ما أَرْجُوهُ وَآمُلُهُ"
  },
  {
   "segment_id": 33,
   "arabic": "إِنَّكَ عَلى كُلِّ شَيْ‏ءٍ قَديرٌ"
  }
 ]
}