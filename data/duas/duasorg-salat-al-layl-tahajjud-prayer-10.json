{
 "dua_id": "duasorg-salat-al-layl-tahajjud-prayer-10",
 "dua_name_en": "Tahajjud Prayer - Salat al-Layl - Namaz e Shab · Ilāhī kayfa uṣduru ‘an…",
 "dua_name_ar": "",
 "source": "https://www.duas.org/salat-al-layl-tahajjud-prayer.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "إِلٰهِي كَيْفَ اصْدُرُ عَنْ بَابِكَ بِخَيْبَةٍ مِنْكَ"
  },
  {
   "segment_id": 2,
   "arabic": "وَقَدْ قَصَدْتُهُ عَلَىٰ ثِقَةٍ بِكَ"
  },
  {
   "segment_id": 3,
   "arabic": "إِلٰهِي كَيْفَ تُؤْيِسُنِي مِنْ عَطَائِكَ"
  },
  {
   "segment_id": 4,
   "arabic": "وَقَدْ امَرْتَنِي بِدُعَائِكَ"
  },
  {
   "segment_id": 5,
   "arabic": "صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 6,
   "arabic": "وَٱرْحَمْنِي إِذَا ٱشْتَدَّ ٱلانِينُ"
  },
  {
   "segment_id": 7,
   "arabic": "وَحُظِرَ عَلَيَّ ٱلْعَمَلُ"
  },
  {
   "segment_id": 8,
   "arabic": "وَٱنْقَطَعَ مِنِّي ٱلامَلُ"
  },
  {
   "segment_id": 9,
   "arabic": "وَافْضَيْتُ إِلَىٰ ٱلْمَنُونِ"
  },
  {
   "segment_id": 10,
   "arabic": "وَبَكَتْ عَلَيَّ ٱلْعُيُونُ"
  },
  {
   "segment_id": 11,
   "arabic": "وَوَدَّعَنِي ٱلاهْلُ وَٱلاحْبَابُ"
  },
  {
   "segment_id": 12,
   "arabic": "وَحُثِيَ عَلَيَّ ٱلتُّرَابُ"
  },
  {
   "segment_id": 13,
   "arabic": "وَنُسِيَ ٱسْمِي"
  },
  {
   "segment_id": 14,
   "arabic": "وَبَلِيَ جِسْمِي"
  },
  {
   "segment_id": 15,
   "arabic": "وَٱنْطَمَسَ ذِكْرِي"
  },
  {
   "segment_id": 16,
   "arabic": "وَهُجِرَ قَبْرِي"
  },
  {
   "segment_id": 17,
   "arabic": "فَلَمْ يَزُرْنِي زَائِرٌ"
  },
  {
   "segment_id": 18,
   "arabic": "وَلَمْ يَذْكُرْنِي ذَاكِرٌ"
  },
  {
   "segment_id": 19,
   "arabic": "وَظَهَرَتْ مِنِّي ٱلْمَآثِمُ"
  },
  {
   "segment_id": 20,
   "arabic": "وَٱسْتَوْلَتْ عَلَيَّ ٱلْمَظَالِمُ"
  },
  {
   "segment_id": 21,
   "arabic": "وَطَالَتْ شِكَايَةُ ٱلْخُصُومِ"
  },
  {
   "segment_id": 22,
   "arabic": "وَٱتَّصَلَتْ دَعْوَةُ ٱلْمَظْلُومِ"
  },
  {
   "segment_id": 23,
   "arabic": "صَلِّ ٱللَّهُمَّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 24,
   "arabic": "وَارْضِ خُصُومِي عَنِّي"
  },
  {
   "segment_id": 25,
   "arabic": "بِفَضْلِكَ وَإِحْسَانِكَ"
  },
  {
   "segment_id": 26,
   "arabic": "وَجُدْ عَلَيَّ بِعَفْوِكَ وَرِضْوَانِكَ"
  },
  {
   "segment_id": 27,
   "arabic": "إِلٰهِي ذَهَبَتْ ايَّامُ لَذَّاتِي"
  },
  {
   "segment_id": 28,
   "arabic": "وَبَقِيَتْ مَآثِمِي وَتَبِعَاتِي"
  },
  {
   "segment_id": 29,
   "arabic": "وَقَدْ اتَيْتُكَ مُنِيباً تَائِباً"
  },
  {
   "segment_id": 30,
   "arabic": "فَلاَ تَرُدَّنِي مَحْرُوماً وَلاَ خَائِباً"
  },
  {
   "segment_id": 31,
   "arabic": "اَللَّهُمَّ آمِنْ رَوْعَتِي"
  },
  {
   "segment_id": 32,
   "arabic": "وَٱغْفِرْ زَلَّتِي"
  },
  {
   "segment_id": 33,
   "arabic": "وَتُبْ عَلَيَّ"
  },
  {
   "segment_id": 34,
   "arabic": "إِنَّكَ انْتَ ٱلتَّوَّابُ ٱلرَّحِيمُ"
  }
 ]
}