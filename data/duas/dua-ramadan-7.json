{
 "dua_id": "dua-ramadan-7",
 "dua_name_en": "Day 7",
 "dua_name_ar": " شهر رمضان ٧ ",
 "source": "https://www.duaplayer.org/en/dua/ramadan-7",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "اللّهُمّ أَعِنّي فِيهِ عَلَى صِيَامِهِ وَقِيَامِهِ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَجَنّبْنِي فِيهِ مِنْ هَفَوَاتِهِ وَآثَامِهِ،"
  },
  {
   "segment_id": 5,
   "arabic": "وَارْزُقْنِي فِيهِ ذِكْرَكَ بِدَوَامِهِ،"
  },
  {
   "segment_id": 6,
   "arabic": "بِتَوْفِيقِكَ يَا هَادِيَ المُضِلّينَ."
  }
 ]
}