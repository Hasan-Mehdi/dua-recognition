{
 "dua_id": "duasorg-dua-faraj-dua-azumal-bala-imam-mahdi-1",
 "dua_name_en": "Dua Faraj - Azumal Bala - Imam Mahdi (ATFS)",
 "dua_name_ar": "",
 "source": "https://www.duas.org/dua-faraj-dua-azumal-bala-imam-mahdi.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "إِلَهِيْ عَظُمَ الْبَلَاءُ وَبَرِحَ الْخَفَاءُ"
  },
  {
   "segment_id": 2,
   "arabic": "وَانْكَشَفَ الْغِطَاءُ وَانْقَطَعَ الرَّجَاءُ ،"
  },
  {
   "segment_id": 3,
   "arabic": "وَضَاقَتِ الْأَرْضُ وَمُنِعَتِ السَّمَاءُ"
  },
  {
   "segment_id": 4,
   "arabic": "وَأَنْتَ الْمُسْتَعَانُ وَإِلَيْكَ الْمُشْتَكَي"
  },
  {
   "segment_id": 5,
   "arabic": "وَ عَلَيْكَ الْمُعَوَّلُ فِيْ الشِّدَّةِ وَالرَّخَاءِ،"
  },
  {
   "segment_id": 6,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَي مُحَمَّدٍ وَّآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 7,
   "arabic": "أُوْلِي الْأَمْرِ الَّذِيْنَ فَرَضْتَ عَلَيْنَا طَا عَتَهُمْ"
  },
  {
   "segment_id": 8,
   "arabic": "وَ عَرَّفْتَنَا بِذَالِكَ مَنْزِلَتَهُمْ ، فَفَّرِجْ عَنَّا بِحَقِّهِمْ فَرَجاً عَاجِلاً قَرِيْباً كَلَمْحِ الْبَصَرِ أَوْ هُوَ أَقْرَبُ"
  },
  {
   "segment_id": 9,
   "arabic": "يَامُحَمَّدُ يَاعَلِيُّ يَاعَلِيُّ يَامُحَمَّدُ"
  },
  {
   "segment_id": 10,
   "arabic": "ِكْفِيَانِيْ فَإِنَّكُمَا كَافِيَانِ وَ انْصُرَانِيْ فَإِنَّكُمَا نَاصِرَانِ"
  },
  {
   "segment_id": 11,
   "arabic": "يَامَوْلَانَا يَاصَاحِبَ الزَّمَانِ"
  },
  {
   "segment_id": 12,
   "arabic": "اَلْغَوْثَ اَلْغَوْثَ اَلْغَوْثَ"
  },
  {
   "segment_id": 13,
   "arabic": "أَدْرِكْنِيْ أَدْرِكْنِيْ أَدْرِكْنِيْ"
  },
  {
   "segment_id": 14,
   "arabic": "اَلسَّاعَةَ اَلسَّاعَةَ اَلسَّاعَةَ"
  }
 ]
}