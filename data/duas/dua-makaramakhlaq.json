{
 "dua_id": "dua-makaramakhlaq",
 "dua_name_en": "Dua Makaram al-Akhlaq",
 "dua_name_ar": "دعاء مكارم الأخلاق",
 "source": "https://www.duaplayer.org/en/dua/makaramakhlaq",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "أَللَّهمَّ صَلِّ عَلَى مُحَمَّد وَآلِهِ"
  },
  {
   "segment_id": 2,
   "arabic": "وَبَلِّغْ بِإيْمَانِي أكْمَلَ الإِيْمَانِ،"
  },
  {
   "segment_id": 3,
   "arabic": "وَاجْعَلْ يَقِينِي أَفْضَلَ الْيَقِينِ،"
  },
  {
   "segment_id": 4,
   "arabic": "و انتَهِ بِنِيَّتِي إلَى أَحْسَنِ النِّيَّـاتِ،"
  },
  {
   "segment_id": 5,
   "arabic": "وَبِعَمَلِي إلى أَحْسَنِ الأعْمَالِ."
  },
  {
   "segment_id": 6,
   "arabic": "أللَّهُمَّ وَفِّرْ بِلُطْفِكَ نِيَّتِي،"
  },
  {
   "segment_id": 7,
   "arabic": "وَصَحِّحْ بِمَـا عِنْدَكَ يَقِينِي،"
  },
  {
   "segment_id": 8,
   "arabic": "وَاسْتَصْلِحْ بِقُدْرَتِكَ مَا فَسَدَ مِنِّي."
  },
  {
   "segment_id": 9,
   "arabic": "أللَّهُمَّ صَلِّ عَلَى مُحَمَّد وَآلِهِ"
  },
  {
   "segment_id": 10,
   "arabic": "وَاكْفِنِي مَا يَشْغَلُنِي الاهْتِمَامُ بِهِ،"
  },
  {
   "segment_id": 11,
   "arabic": "وَاسْتَعْمِلْنِي بِمَا تَسْأَلُنِي غَداً عَنْهُ"
  },
  {
   "segment_id": 12,
   "arabic": "وَاسْتَفْرِغْ أَيَّامِي فِيمَا خَلَقْتَنِي لَهُ،"
  },
  {
   "segment_id": 13,
   "arabic": "وَأَغْنِنِي وَأَوْسِعْ عَلَىَّ فِي رِزْقِكَ،"
  },
  {
   "segment_id": 14,
   "arabic": "وَلاَ تَفْتِنِّي بِالبَطَرِ، وَأَعِزَّنِي، وَلا تَبْتَلِيَنِّي بِالْكِبْرِ،"
  },
  {
   "segment_id": 15,
   "arabic": "وَعَبِّدْنِي لَكَ وَلاَ تُفْسِدْ عِبَادَتِي بِالْعُجْبِ،"
  },
  {
   "segment_id": 16,
   "arabic": "وَأَجْرِ لِلنَّاسِ عَلَى يَدَيَّ الْخَيْرَ، وَلا تَمْحَقْهُ بِالْمَنِّ،"
  },
  {
   "segment_id": 17,
   "arabic": "وَهَبْ لِي مَعَالِيَ الأَخْلاَقِ، وَاعْصِمْنِي مِنَ الْفَخْرِ."
  },
  {
   "segment_id": 18,
   "arabic": "اللَّهُمَّ صَـلِّ عَلَى مُحَمَّد وَآلِهِ،"
  },
  {
   "segment_id": 19,
   "arabic": "وَلا تَـرْفَعْنِي فِيْ النَّاسِ دَرَجَـةً"
  },
  {
   "segment_id": 20,
   "arabic": "إلاّ حَطَطْتَنِي عِنْدَ نَفْسِي مِثْلَهَا،"
  },
  {
   "segment_id": 21,
   "arabic": "وَلا تُحْدِثْ لِي عِزّاً ظَاهِرَاً"
  },
  {
   "segment_id": 22,
   "arabic": "إلاّ أَحْدَثْتَ لِي  ذِلَّةً بَاطِنَةً عِنْدَ نَفْسِي بِقَدَرِهَا."
  },
  {
   "segment_id": 23,
   "arabic": "أللَّهُمَّ صَلِّ عَلَى مُحَمَّد وَآلِ مُحَمَّد،"
  },
  {
   "segment_id": 24,
   "arabic": "وَمَتِّعْنِي بِهُدىً صَالِح لا أَسْتَبْدِلُ بِهِ،"
  },
  {
   "segment_id": 25,
   "arabic": "وَطَرِيقَةِ حَقٍّ لا أَزِيْغُ عَنْهَا،"
  },
  {
   "segment_id": 26,
   "arabic": "وَنِيَّةِ رُشْد لاَ أَشُكُّ فِيْهَا"
  },
  {
   "segment_id": 27,
   "arabic": "وَعَمِّرْنِي مَا كَانَ عُمْرِيْ بِذْلَةً فِي طَاعَتِكَ،"
  },
  {
   "segment_id": 28,
   "arabic": "فَإذَا كَانَ عُمْرِي مَرْتَعَاً لِلشَّيْطَانِ"
  },
  {
   "segment_id": 29,
   "arabic": "فَـاقْبِضْنِي إلَيْـكَ قَبْـلَ أَنْ يَسْبِقَ مَقْتُـكَ إلَيَّ،"
  },
  {
   "segment_id": 30,
   "arabic": "أَوْ يَسْتَحْكِمَ غَضَبُكَ عَلَيَّ."
  },
  {
   "segment_id": 31,
   "arabic": "أللَّهُمَّ لا تَدَعْ خَصْلَةً تُعَابُ مِنِّي إلاّ أَصْلَحْتَهَا،"
  },
  {
   "segment_id": 32,
   "arabic": "وَلا عَآئِبَةً أُؤَنَّبُ بِهَا إلاّ حَسَّنْتَهَا،"
  },
  {
   "segment_id": 33,
   "arabic": "وَلاَ أُكْرُومَـةً فِيَّ نَاقِصَةً إلاّ أَتْمَمْتَهَا."
  },
  {
   "segment_id": 34,
   "arabic": "أللَّهُمَّ صَلِّ عَلَى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 35,
   "arabic": "وَأَبْدِلْنِي مِنْ بِغْضَةِ أَهْلِ الشَّنَئانِ الْمَحَبَّةَ"
  },
  {
   "segment_id": 36,
   "arabic": "وَمِنْ حَسَدِ أَهْلِ الْبَغْيِ الْمَوَدَّةَ،"
  },
  {
   "segment_id": 37,
   "arabic": "وَمِنْ  ظِنَّةِ أَهْلِ الصَّلاَحِ الثِّقَةَ،"
  },
  {
   "segment_id": 38,
   "arabic": "وَمِنْ عَدَاوَةِ الأَدْنَيْنَ الْوَلايَةَ،"
  },
  {
   "segment_id": 39,
   "arabic": "وَمِنْ عُقُوقِ ذَوِي الأَرْحَامِ الْمَبَرَّةَ،"
  },
  {
   "segment_id": 40,
   "arabic": "ومِنْ خِـذْلانِ الأَقْرَبِينَ النُّصْـرَةَ،"
  },
  {
   "segment_id": 41,
   "arabic": "وَمِنْ حُبِّ الْمُدَارِينَ تَصْحيحَ الْمِقَةِ،"
  },
  {
   "segment_id": 42,
   "arabic": "وَمِنْ رَدِّ الْمُلاَبِسِينَ َكَرَمَ الْعِشْرَةِ،"
  },
  {
   "segment_id": 43,
   "arabic": "وَمِنْ مَرَارَةِ خَوْفِ الظَّالِمِينَ حَلاَوَةَ الأَمَنَةِ."
  },
  {
   "segment_id": 44,
   "arabic": "أللَّهُمَّ صَلِّ عَلَى مُحَمَّد وَآلِهِ"
  },
  {
   "segment_id": 45,
   "arabic": "وَاجْعَلْ لِيْ يَداً عَلَى مَنْ ظَلَمَنِي"
  },
  {
   "segment_id": 46,
   "arabic": "وَلِسَـاناً عَلَى مَنْ خَـاصَمَنِي"
  },
  {
   "segment_id": 47,
   "arabic": "وَظَفَراً بِمَنْ عَانَدَنِي"
  },
  {
   "segment_id": 48,
   "arabic": "وَهَبْ  لِي مَكْراً عَلَى مَنْ كَايَدَنِي"
  },
  {
   "segment_id": 49,
   "arabic": "وَقُدْرَةً عَلَى مَنِ اضْطَهَدَنِي"
  },
  {
   "segment_id": 50,
   "arabic": "وَتَكْذِيباً لِمَنْ قَصَبَنِي"
  },
  {
   "segment_id": 51,
   "arabic": "وَسَلاَمَةً مِمَّنْ تَوَعِّدَنِي"
  },
  {
   "segment_id": 52,
   "arabic": "وَوَفِّقْنِي لِطَاعَةِ مَنْ سَدَّدَنِي"
  },
  {
   "segment_id": 53,
   "arabic": "وَمُتَابَعَةِ مَنْ أَرْشَدَنِي"
  },
  {
   "segment_id": 54,
   "arabic": "أللَّهُمَّ صَلِّ عَلَى مُحَمَّد وَآلِهِ،"
  },
  {
   "segment_id": 55,
   "arabic": "وَسَدِّدْنِي لاَِنْ أعَـارِضَ مَنْ غَشَّنِي بِالنُّصْـحِ،"
  },
  {
   "segment_id": 56,
   "arabic": "وَأَجْـزِيَ مَنْ هَجَرَنِي بِالْبِرِّ وَأُثِيبَ مَنْ حَرَمَنِي بِالْبَذْلِ"
  },
  {
   "segment_id": 57,
   "arabic": "وَأُكَافِيَ مَنْ قَطَعَنِي بِالصِّلَةِ"
  },
  {
   "segment_id": 58,
   "arabic": "وأُخَـالِفَ مَنِ اغْتَابَنِي إلَى حُسْنِ الذِّكْرِ،"
  },
  {
   "segment_id": 59,
   "arabic": "وَأَنْ أَشْكرَ الْحَسَنَةَ وَاُغْضِيَ عَنِ السَّيِّئَـةِ."
  },
  {
   "segment_id": 60,
   "arabic": "أللَّهُمَّ صَـلِّ عَلَى مُحَمَّـد وَآلِـهِ"
  },
  {
   "segment_id": 61,
   "arabic": "وَحَلِّنِي بِحِلْيَـةِ الصَّالِحِينَ،"
  },
  {
   "segment_id": 62,
   "arabic": "وَأَلْبِسْنِي زِينَةَ المُتَّقِينَ فِيْ بَسْطِ الْعَدْلِ"
  },
  {
   "segment_id": 63,
   "arabic": "وَكَظْمِ الْغَيْظِ وَإطْفَاءِ النَّائِرَةِ وَضَمِّ أَهْلِ الْفُرْقَةِ"
  },
  {
   "segment_id": 64,
   "arabic": "وَإصْلاَحِ ذَاتِ الْبَيْنِ وَإفْشَاءِ الْعَارِفَةِ،"
  },
  {
   "segment_id": 65,
   "arabic": "وَسَتْرِ الْعَائِبَةِ، وَلِينِ الْعَرِيكَةِ،"
  },
  {
   "segment_id": 66,
   "arabic": "وَخَفْضِ الْجَنَـاحِ، وَحُسْنِ السِّيرَةِ،"
  },
  {
   "segment_id": 67,
   "arabic": "وَسُكُونِ الرِّيـحِ، وَطِيْبِ الْمُخَالَقَـةِ،"
  },
  {
   "segment_id": 68,
   "arabic": "وَالسَّبْقِ إلَى الْفَضِيلَةِ، وإيْثَارِ التَّفَضُّلِ و تَركِ التَّعييرِ،"
  },
  {
   "segment_id": 69,
   "arabic": "وَالإفْضَالِ عَلَى غَيْرِ الْمُسْتَحِقِّ وَالـقَوْلِ بِالْحَقِّ وَإنْ عَـزَّ"
  },
  {
   "segment_id": 70,
   "arabic": "وَاسْتِقْلاَلِ الخَيْـرِ وَإنْ كَثُـرَ مِنْ قَـوْلِي وَفِعْلِي ،"
  },
  {
   "segment_id": 71,
   "arabic": "وَاسْتِكْثَارِ الشَّرِّ وَإنْ قَلَّ مِنْ قَوْلِي  وَفِعْلِي،"
  },
  {
   "segment_id": 72,
   "arabic": "وَأكْمِلْ ذَلِكَ لِي بِدَوَامِ الطَّاعَةِ وَلُزُومِ الْجَمَاعَةِ"
  },
  {
   "segment_id": 73,
   "arabic": "وَرَفْضِ أَهْلِ الْبِدَعِ وَمُسْتَعْمِلِ الرَّأي الْمُخْتَرَعِ."
  },
  {
   "segment_id": 74,
   "arabic": "أللَّهُمَّ صَلِّ عَلَى مُحَمَّد وَآلِهِ"
  },
  {
   "segment_id": 75,
   "arabic": "وَاجْعَلْ أَوْسَعَ رِزْقِكَ عَلَيَّ إذَا كَبُرتُ ،"
  },
  {
   "segment_id": 76,
   "arabic": "وَأَقْوَى قُوَّتِكَ فِيَّ إذَا نَصِبْتُ،"
  },
  {
   "segment_id": 77,
   "arabic": "وَلاَ تَبْتَلِيَنّي بِالكَسَلِ عَنْ عِبَادَتِكَ"
  },
  {
   "segment_id": 78,
   "arabic": "وَلا الْعَمَى عَنْ سَبِيلِكَ وَلاَ بِالتَّعَرُّضِ لِخِلاَفِ مَحَبَّتِكَ،"
  },
  {
   "segment_id": 79,
   "arabic": "وَلاَ مُجَامَعَةِ مَنْ تَفَرَّقَ عَنْكَ،"
  },
  {
   "segment_id": 80,
   "arabic": "وَلا مُفَارَقَةِ مَنِ اجْتَمَعَ إلَيْكَ."
  },
  {
   "segment_id": 81,
   "arabic": "أللَّهُمَّ اجْعَلْنِي أصُوْلُ بِكَ عِنْدَ الضَّرُورَةِ وَأَسْأَلُكَ عِنْدَ الْحَاجَةِ،"
  },
  {
   "segment_id": 82,
   "arabic": "وَأَتَضَرَّعُ إلَيْكَ عِنْدَ الْمَسْكَنَةِ ،"
  },
  {
   "segment_id": 83,
   "arabic": "وَلا تَفْتِنّي بِالاسْتِعَانَةِ بِغَيْرِكَ إذَا اضْطُرِرْتُ،"
  },
  {
   "segment_id": 84,
   "arabic": "وَلا بِالْخُضُوعِ لِسُؤالِ غَيْرِكَ إذَا افْتَقَـرْتُ ،"
  },
  {
   "segment_id": 85,
   "arabic": "وَلاَ بِـالتَّضَـرُّعِ إلَى مَنْ دُونَـكَ إذَا رَهِبْتُ"
  },
  {
   "segment_id": 86,
   "arabic": "فَأَسْتَحِقَّ بِذلِكَ خِذْلانَكَ"
  },
  {
   "segment_id": 87,
   "arabic": "وَمَنْعَكَ وَإعْرَاضَكَ يَا  أَرْحَمَ الرَّاحِمِينَ."
  },
  {
   "segment_id": 88,
   "arabic": "أللَّهُمَّ اجْعَلْ مَا يُلْقِي الشَّيْطَانُ فِي رَوْعِي مِنَ التَّمَنِّي وَالتَّظَنِّي وَالْحَسَـدِ"
  },
  {
   "segment_id": 89,
   "arabic": "ذِكْـراً لِعَظَمَتِكَ،"
  },
  {
   "segment_id": 90,
   "arabic": "وَتَفَكُّراً فِي قُدْرَتِكَ،"
  },
  {
   "segment_id": 91,
   "arabic": "وَتَدْبِيراً عَلَى عَدُوِّكَ،"
  },
  {
   "segment_id": 92,
   "arabic": "وَمَا أَجْرَى عَلَى لِسَانِي مِنْ  لَفْظَةِ فُحْش أَوْ هُجْر"
  },
  {
   "segment_id": 93,
   "arabic": "أَوْ شَتْمِ عِرْض أَوْ شَهَادَةِ بَاطِل"
  },
  {
   "segment_id": 94,
   "arabic": "أو اغْتِيَابِ مُؤْمِن غَائِبِ أَوْ سَبِّ حَاضِر،"
  },
  {
   "segment_id": 95,
   "arabic": "وَمَا أَشْبَهَ ذَلِكَ نُطْقاً بِالْحَمْدِ لَكَ"
  },
  {
   "segment_id": 96,
   "arabic": "وَإغْرَاقاً فِي الثَّنَاءِ عَلَيْكَ،"
  },
  {
   "segment_id": 97,
   "arabic": "وَذَهَاباً فِي تَمْجيدِكَ"
  },
  {
   "segment_id": 98,
   "arabic": "وَشُكْراً لِنِعْمَتِكَ"
  },
  {
   "segment_id": 99,
   "arabic": "وَاعْتِرَافاً بِإحْسَانِكَ"
  },
  {
   "segment_id": 100,
   "arabic": "وَإحْصَاءً لِمِنَنِكَ."
  },
  {
   "segment_id": 101,
   "arabic": "أللّهُمَّ صَـلِّ عَلَى مُحَمَّد وَآلِـهِ"
  },
  {
   "segment_id": 102,
   "arabic": "وَلاَ اُظْلَمَنَّ وَأَنْتَ مُطِيقٌ لِلدَّفْعِ عَنِّي،"
  },
  {
   "segment_id": 103,
   "arabic": "وَلا أَظْلِمَنَّ وَأَنْتَ القَادِرُ عَلَى الْقَبْضِ مِنِّي،"
  },
  {
   "segment_id": 104,
   "arabic": "وَلاَ أَضِلَّنَّ  وَقَدْ أَمْكَنَتْكَ هِدَايَتِي،"
  },
  {
   "segment_id": 105,
   "arabic": "وَلاَ أَفْتَقِرَنَّ وَمِنْ عِنْدِكَ وُسْعِي،"
  },
  {
   "segment_id": 106,
   "arabic": "وَلا أَطْغَيَنَّ وَمِنْ عِنْدِكَ وُجْدِي."
  },
  {
   "segment_id": 107,
   "arabic": "أللَّهُمَّ إلَى مَغْفِرَتِكَ وَفَدْتُ، وَإلَى عَفْوِكَ قَصَـدْتُ،"
  },
  {
   "segment_id": 108,
   "arabic": "وَإلَى تَجَـاوُزِكَ اشْتَقْتُ، وَبِفَضْلِكَ وَثِقْتُ،"
  },
  {
   "segment_id": 109,
   "arabic": "وَلَيْسَ عِنْدِي مَا يُوجِبُ لِي مَغْفِرَتَكَ،"
  },
  {
   "segment_id": 110,
   "arabic": "وَلاَ فِي عَمَلِي مَا أَسْتَحِقُّ بِهِ عَفْوَكَ،"
  },
  {
   "segment_id": 111,
   "arabic": "وَمَا لِي بَعْدَ أَنْ حَكَمْتُ عَلَى نَفْسِي إلاَّ فَضْلُكَ،"
  },
  {
   "segment_id": 112,
   "arabic": "فَصَلِّ عَلَى مُحَمَّد وَآلِهِ"
  },
  {
   "segment_id": 113,
   "arabic": "وَتَفَضَّلْ عَلَيَّ"
  },
  {
   "segment_id": 114,
   "arabic": "أللَّهُمَّ وَأَنْطِقْنِي بِالْهُدى،"
  },
  {
   "segment_id": 115,
   "arabic": "وَأَلْهِمْنِي ألتَّقْـوَى وَوَفِّقْنِي لِلَّتِيْ هِيَ أَزْكَى"
  },
  {
   "segment_id": 116,
   "arabic": "وَاسْتَعْمِلْنِي بِمَا هُوَ أَرْضَى."
  },
  {
   "segment_id": 117,
   "arabic": "أللَّهُمَّ اسْلُكْ بِيَ الطَّرِيقَـةَ الْمُثْلَى،"
  },
  {
   "segment_id": 118,
   "arabic": "وَاجْعَلْنِي عَلَى مِلَّتِكَ أَمُوتُ وَأَحْيَى."
  },
  {
   "segment_id": 119,
   "arabic": "أللَّهُمَّ صَلِّ عَلَى مُحَمَّد وَآلِهِ"
  },
  {
   "segment_id": 120,
   "arabic": "وَمَتِّعْنِي بِالاقْتِصَادِ، وَاجْعَلْنِي مِنْ أَهْلِ السَّدَادِ،"
  },
  {
   "segment_id": 121,
   "arabic": "وَمِنْ أَدِلَّةِ الرَّشَادِ، وَمِنْ صَالِحِي الْعِبَادِ،"
  },
  {
   "segment_id": 122,
   "arabic": "وَارْزُقْنِي  فَوْزَ الْمَعَادِ، وَسَلاَمَةَ الْمِرْصَادِ."
  },
  {
   "segment_id": 123,
   "arabic": "أللَّهُمَّ خُذْ لِنَفْسِكَ مِنْ نَفْسِي مَـا يُخَلِّصُهَا،"
  },
  {
   "segment_id": 124,
   "arabic": "وَأَبْق لِنَفْسِي مِنْ نَفْسِي مَـا يُصْلِحُهَا"
  },
  {
   "segment_id": 125,
   "arabic": "فَإنَّ نَفْسِي هَالِكَةٌ أَوْ تَعْصِمَهَا."
  },
  {
   "segment_id": 126,
   "arabic": "أَللَّهُمَّ أَنْتَ عُدَّتِي إنْ حَزِنْتُ،"
  },
  {
   "segment_id": 127,
   "arabic": "وَأَنْتَ مُنْتَجَعِي إنْ حُرِمْتُ،"
  },
  {
   "segment_id": 128,
   "arabic": "وَبِكَ استِغَاثَتِي إنْ كَرِثْتُ،"
  },
  {
   "segment_id": 129,
   "arabic": "وَعِنْدَكَ مِمَّا فَاتَ خَلَفٌ، وَلِمَا فَسَدَ صَلاَحٌ،"
  },
  {
   "segment_id": 130,
   "arabic": "وَفِيمَا أنْكَرْتَ تَغْييرٌ."
  },
  {
   "segment_id": 131,
   "arabic": "فَامْنُنْ عَلَيَّ قَبْلَ الْبَلاءِ بِالْعَافِيَةِ، وَقَبْلَ الطَّلَبِ بِالْجِدةِ،"
  },
  {
   "segment_id": 132,
   "arabic": "وَقَبْلَ الضَّلاَلِ بِالرَّشَادِ، وَاكْفِنِي مَؤُونَةَ مَعَرَّةِ الْعِبَادِ،"
  },
  {
   "segment_id": 133,
   "arabic": "وَقَبْلَ الضَّلاَلِ بِالرَّشَادِ، وَاكْفِنِي مَؤُونَةَ مَعَرَّةِ الْعِبَادِ،"
  },
  {
   "segment_id": 134,
   "arabic": "أللَّهُمَّ صَلِّ عَلَى مُحَمَّـد وَآلِـهِ"
  },
  {
   "segment_id": 135,
   "arabic": "وَادْرَأ عَنّي بِلُطْفِـكَ، وَاغْـذُنِي بِنِعْمَتِكَ،"
  },
  {
   "segment_id": 136,
   "arabic": "وَأَصْلِحْنِي بِكَرَمِـكَ، وَدَاوِنِي بصُنْعِـكَ،"
  },
  {
   "segment_id": 137,
   "arabic": "وَأَظِلَّنِيْ فِي ذَرَاكَ، وجَلِّلْنِي رِضَـاكَ،"
  },
  {
   "segment_id": 138,
   "arabic": "وَوَفِّقنِي إذَا اشْتَكَلَتْ عَلَيَّ الأمُـورُ لأِهْدَاهَـا،"
  },
  {
   "segment_id": 139,
   "arabic": "وَإذَا تَشَابَهَتِ الأعْمَالُ لأزْكَاهَا،"
  },
  {
   "segment_id": 140,
   "arabic": "وَإذَا تَنَاقَضَتِ الْمِلَلُ لأِرْضَاهَا."
  },
  {
   "segment_id": 141,
   "arabic": "أللَّهُمَّ صَلِّ عَلَى مُحَمَّد وَآلِهِ"
  },
  {
   "segment_id": 142,
   "arabic": "وَتَوِّجْنِي بِالْكِفَايَةِ، وَسُمْنِي حُسْنَ الْوِلايَةِ،"
  },
  {
   "segment_id": 143,
   "arabic": "وَهَبْ لِيْ صِدْقَ الْهِدَايَةِ، وَلا تَفْتِنِّي بِالسَّعَةِ،"
  },
  {
   "segment_id": 144,
   "arabic": "وَامْنَحْنِي حُسْنَ الدَّعَةِ، وَلا تَجْعَلْ عَيْشِي كَدّاً كَدّاً،"
  },
  {
   "segment_id": 145,
   "arabic": "وَلاَ تَرُدَّ دُعَائِي عَلَيَّ رَدّاً"
  },
  {
   "segment_id": 146,
   "arabic": "فَإنِّي لا أَجْعَلُ لَكَ ضِدّاً وَلا أَدْعُو مَعَكَ نِدّاً."
  },
  {
   "segment_id": 147,
   "arabic": "أللَّهُمَّ صَلِّ عَلَى مُحَمَّـد وَآلِـهِ"
  },
  {
   "segment_id": 148,
   "arabic": "وَامْنَعْنِي مِنَ السَّرَفِ وَحَصِّنْ رِزْقِي مِنَ التَّلَفِ،"
  },
  {
   "segment_id": 149,
   "arabic": "وَوَفِّرْ مَلَكَتِي بِالْبَرَكَةِ فِيهِ،"
  },
  {
   "segment_id": 150,
   "arabic": "وَأَصِبْ بِي سَبِيلَ الْهِدَايَةِ لِلْبِرِّ فِيمَا اُنْفِقُ مِنْهُ."
  },
  {
   "segment_id": 151,
   "arabic": "أللَّهُمَّ صَلِّ عَلَى مُحَمَّد وَآلِهِ"
  },
  {
   "segment_id": 152,
   "arabic": "وَاكْفِنِي مَؤُونَةَ الاكْتِسَابِ،"
  },
  {
   "segment_id": 153,
   "arabic": "وَارْزُقْنِي مِنْ غَيْرِ احْتِسَاب،"
  },
  {
   "segment_id": 154,
   "arabic": "فَلاَ أَشْتَغِلَ عَنْ عِبَادَتِكَ بِالطَّلَبِ"
  },
  {
   "segment_id": 155,
   "arabic": "وَلا أَحْتَمِلَ إصْرَ تَبِعَاتِ الْمَكْسَبِ."
  },
  {
   "segment_id": 156,
   "arabic": "أللَّهُمَّ فَأَطْلِبْنِي بِقُدْرَتِكَ مَا أَطْلُبُ،"
  },
  {
   "segment_id": 157,
   "arabic": "وَأَجِرْنِي بِعِزَّتِكَ مِمَّا أَرْهَبُ."
  },
  {
   "segment_id": 158,
   "arabic": "أللَّهُمَّ صَلِّ عَلَى مُحَمَّد وَآلِهِ وَصُنْ وَجْهِي بِالْيَسَارِ،"
  },
  {
   "segment_id": 159,
   "arabic": "وَلاَ تَبْتَذِلْ جَاهِي بِالإقْتارِ فَأَسْتَرْزِقَ أَهْلَ رِزْقِكَ،"
  },
  {
   "segment_id": 160,
   "arabic": "وَأَسْتَعْطِيَ شِرَارَ خَلْقِكَ، فَأفْتَتِنَ بِحَمْدِ مَنْ أَعْطَانِي،"
  },
  {
   "segment_id": 161,
   "arabic": "وَاُبْتَلَى بِـذَمِّ مَنْ مَنَعَنِي وَأَنْتَ مِنْ  دُونِهِمْ وَلِيُّ الإعْطَاءِ وَالْمَنْعِ."
  },
  {
   "segment_id": 162,
   "arabic": "أللَّهُمَّ صَلِّ عَلَى مُحَمَّد وَآلِـةِ"
  },
  {
   "segment_id": 163,
   "arabic": "وَارْزُقْنِي صِحَّةً فِيْ عِبَادَة،"
  },
  {
   "segment_id": 164,
   "arabic": "وَفَراغاً فِي زَهَادَة،"
  },
  {
   "segment_id": 165,
   "arabic": "وَعِلْماً فِي اسْتِعمَـال، وَوَرَعـاً فِي إجْمَال."
  },
  {
   "segment_id": 166,
   "arabic": "أللَّهُمَّ اخْتِمْ بِعَفْوِكَ أَجَلي،"
  },
  {
   "segment_id": 167,
   "arabic": "وَحَقِّقْ فِي رَجَاءِ رَحْمَتِكَ أَمَلِي،"
  },
  {
   "segment_id": 168,
   "arabic": "وَسَهِّلْ إلَى بُلُوغِ رِضَاكَ سُبُلِي،"
  },
  {
   "segment_id": 169,
   "arabic": "وَحَسِّن فِي جَمِيعِ أَحْوَالِيْ عَمَلِي."
  },
  {
   "segment_id": 170,
   "arabic": "أللَّهُمَّ صَلِّ عَلَى مُحَمَّد وَآلِهِ"
  },
  {
   "segment_id": 171,
   "arabic": "وَنَبِّهْنِي لِذِكْرِكَ فِي أَوْقَاتِ الْغَفْلَةِ،"
  },
  {
   "segment_id": 172,
   "arabic": "وَاسْتَعْمِلْنِي بِطَاعَتِـكَ فِي أَيَّامِ الْمُهْلَةِ،"
  },
  {
   "segment_id": 173,
   "arabic": "وَانْهَجْ لِي إلى مَحَبَّتِكَ سَبيلاً سَهْلَةً"
  },
  {
   "segment_id": 174,
   "arabic": "أكْمِلْ لِي بِهَا خَيْرَ الدُّنْيَا وَالآخِـرَةِ."
  },
  {
   "segment_id": 175,
   "arabic": "أللَّهُمَّ وَصَلِّ عَلَى مُحَمَّد وَآلِهِ"
  },
  {
   "segment_id": 176,
   "arabic": "كَأَفْضَلِ مَـا صَلَّيْتَ عَلَى أَحَد مِنْ خَلْقِكَ قَبْلَهُ،"
  },
  {
   "segment_id": 177,
   "arabic": "وَأَنْتَ مُصَلٍّ عَلَى أَحَد بَعْدَهُ،"
  },
  {
   "segment_id": 178,
   "arabic": "وَآتِنا فِي الدُّنْيَا حَسَنَةً وَفِي الآخِرَةِ حَسَنَةً ،"
  },
  {
   "segment_id": 179,
   "arabic": "وَقِنِي بِرَحْمَتِكَ عَذَابَ النَّارِ."
  }
 ]
}