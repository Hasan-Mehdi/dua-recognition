{
 "dua_id": "duasorg-salat-al-layl-tahajjud-prayer-1",
 "dua_name_en": "Namaz e Shab - Tahajjud Prayer - Salat al-Layl",
 "dua_name_ar": "",
 "source": "https://www.duas.org/salat-al-layl-tahajjud-prayer.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "لآ اِلَهَ اِلاَّ اللّهُ الْحَلِيْمُ الْكَرِيْمُ"
  },
  {
   "segment_id": 2,
   "arabic": "لآ اِلَهَ اِلاَّ اللّهُ الْعَلِيُّ الْعَظِيْمُ"
  },
  {
   "segment_id": 3,
   "arabic": "سُبْحَانَ اللّهِ رَبِّ السَّمَاوَاتِ السَّبْعِ"
  },
  {
   "segment_id": 4,
   "arabic": "وَ رَبِّ الاَرْضِيْنَ السَّبْعِ"
  },
  {
   "segment_id": 5,
   "arabic": "وَ مَا فِيْهِنَّ وَ مَا بَيْنَهُنَّ وَ"
  },
  {
   "segment_id": 6,
   "arabic": "رَبُّ الْعَرْشِ الْعَظِيْمِ"
  },
  {
   "segment_id": 7,
   "arabic": "وَ الْحَمْدُ لِلّهِ رَبِّ الْعَالَمِيْنَ"
  },
  {
   "segment_id": 8,
   "arabic": "..اَللّهُمَّ اغْفِرْ ل"
  },
  {
   "segment_id": 9,
   "arabic": "اَسْتَغْفِرُ اللّهَ رَبِّي وَ اَتُوْبُ اِلَيْهِ"
  },
  {
   "segment_id": 10,
   "arabic": "هذَا مَقَامُ الْعَآئِذِ بِكَ مِنَ النَّارِ"
  },
  {
   "segment_id": 11,
   "arabic": "اَلْعَفْوَ"
  },
  {
   "segment_id": 12,
   "arabic": "رَبِّ اغْفِرْ لِي وَ ارْحَمْنِي وَ تُبْ عَلَيَّ اِنَّكَ اَنْتَ التَّوَّابُ الرَّحِيْمُ"
  },
  {
   "segment_id": 13,
   "arabic": "سُبُّوحٌ قُدُّوسٌ رَبُّ الْمَلاَئِكَةِ وَالرُّوحِ"
  },
  {
   "segment_id": 14,
   "arabic": "سُبُّوحٌ قُدُّوسٌ رَبُّ الْمَلاَئِكَةِ وَالرُّوحِ"
  }
 ]
}