{
 "dua_id": "duasorg-ramadan-day-09-1",
 "dua_name_en": "Holy Prophet's Dua",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-day-09.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "يَا سَيِّدَاهُ وَيَا رَبَّاهُ"
  },
  {
   "segment_id": 2,
   "arabic": "وَيَا ذَا الْجَلاَلَ وَالإِكْرَامِ"
  },
  {
   "segment_id": 3,
   "arabic": "يَا ذَا الْعَرْشِ الَّذِي لاَ يَنَامُ"
  },
  {
   "segment_id": 4,
   "arabic": "وَيَا ذَا الْعِزِّ الَّذِي لاَ يُرَامُ"
  },
  {
   "segment_id": 5,
   "arabic": "يَا قَاضِي الأُمُورِ"
  },
  {
   "segment_id": 6,
   "arabic": "يَا شَافِيَ الصُّدُورِ"
  },
  {
   "segment_id": 7,
   "arabic": "اجْعَلْ لِي مِنْ أَمْرِي فَرَجاً وَمَخْرَجاً"
  },
  {
   "segment_id": 8,
   "arabic": "وَاقْذِفْ رَجَاءَكَ فِي قَلْبِي"
  },
  {
   "segment_id": 9,
   "arabic": "حَتّى لاَ أَرْجُوَ أَحَداً سِوَاكَ عَلَيْكَ"
  },
  {
   "segment_id": 10,
   "arabic": "سَيِّدِي تَوَكَّلْتُ وِإِلَيْكَ مَوْلاَيَ أَنَبْتُ فَارْحَمْنِي"
  },
  {
   "segment_id": 11,
   "arabic": "وَإِلَيْكَ الْمَصِيرُ"
  },
  {
   "segment_id": 12,
   "arabic": "أَسْأَلُكَ يَا إِلهَ الآلِهَةِ"
  },
  {
   "segment_id": 13,
   "arabic": "وَيَا جَبَّارَ الْجَبَابِرَةِ"
  },
  {
   "segment_id": 14,
   "arabic": "وَيَا كَبِيرَ الأَكَابِرِ (الَّذي من توكلَ عليه كفاهُ)"
  },
  {
   "segment_id": 15,
   "arabic": "وَكَانَ حَسْبَهُ وَبَالِغَ أَمْرِهِ عَلَيْكَ"
  },
  {
   "segment_id": 16,
   "arabic": "تَوَكَّلْتُ فَاكْفِنِي"
  },
  {
   "segment_id": 17,
   "arabic": "وِإِلَيْكَ أَنْبَتُ فَارْحَمْنِي وَإِلَيْكَ الْمَصِيرُ"
  },
  {
   "segment_id": 18,
   "arabic": "فَاغْفِرْ لِي وَ لَا تُسَوِّدْ وَجْهِي يَوْمَ تَسْوَدُّ وُجُوهٌ وَ تَبْيَضُّ وُجُوهٌ‌"
  },
  {
   "segment_id": 19,
   "arabic": "إِنَّكَ أَنْتَ الْعَزِيزُ الْحَكِيمُ‌"
  },
  {
   "segment_id": 20,
   "arabic": "وَ صَلِّ اللَّهُمَّ عَلَى مُحَمَّدٍ وَ آلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 21,
   "arabic": "وَ ارْحَمْنِي وَ تَجَاوَزْ عَنِّي"
  },
  {
   "segment_id": 22,
   "arabic": "إِنَّكَ أَنْتَ الْغَفُورُ الرَّحِيمُ."
  }
 ]
}