   "segment_id": 151,
   "arabic": "وَبِٱلْحَسَنِ وَٱلْحُسَيْنِ"
  },
  {
   "segment_id": 152,
   "arabic": "وَعَلِيٍّ وَمُحَمَّدٍ"
  },
