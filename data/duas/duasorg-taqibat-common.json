   "arabic": "رَضِيتُ بِٱللَّهِ رَبّاً"
  },
  {
   "segment_id": 148,
   "arabic": "وَبِٱلإِسْلاَمِ ديناً"
  },
  {
   "segment_id": 149,
   "arabic": "وَبِمُحَمَّدٍ صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ نَبِيّاً"
  },
  {
   "segment_id": 150,
   "arabic": "وَبِعَلِيٍّ إِمَامَاً"
  },
