{
 "dua_id": "duasorg-taqibat-common",
 "dua_name_en": "Common Ta'qibat (after every prayer)",
 "dua_name_ar": "التعقيبات المشتركة",
 "source": "https://www.duas.org/regular-after-salaat-taqibat.html (its ta'qibat pages, in Mafatih al-Jinan's order; scripts/taqibat_corpus.py)",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "أَسْتَغْفِرُ ٱللَّهَ ٱلَّذِي لاَ إِلٰهَ إِلاَّ هُوَ ٱلْحَيُّ ٱلْقَيُّومُ وَأَتُوبُ إِلَيْهِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللَّهُمَّ ٱهْدِنِي مِنْ عِنْدِكَ"
  },
  {
   "segment_id": 3,
   "arabic": "وَأَفِضْ عَلَيَّ مِنْ فَضْلِكَ"
  },
  {
   "segment_id": 4,
   "arabic": "وَٱنْشُرْ عَلَيَّ مِنْ رَحْمَتِكَ"
  },
  {
   "segment_id": 5,
   "arabic": "وَأَنْزِلْ عَلَيَّ مِنْ بَرَكاتِكَ"
  },
  {
   "segment_id": 6,
   "arabic": "سُبْحَانَكَ لاَ إِلٰهَ إِلاَّ أَنْتَ"
  },
  {
   "segment_id": 7,
   "arabic": "ٱغْفِرْ لِي ذُنُوبِي كُلَّهَا جَمِيعاً"
  },
  {
   "segment_id": 8,
   "arabic": "فَإِنَّهُ لاَ يَغْفِرُ ٱلذُّنُوبَ كُلَّهَا جَمِيعاً إِلاَّ أَنْتَ"
  },
  {
   "segment_id": 9,
   "arabic": "اَللَّهُمَّ إِنِّي أَسْأَلُكَ مِنْ كُلِّ خَيْرٍ أَحَاطَ بِهِ عِلْمُكَ"
  },
  {
   "segment_id": 10,
   "arabic": "وَأَعُوذُ بِكَ مِنْ كُلِّ شَرٍّ أَحَاطَ بِهِ عِلْمُكَ"
  },
  {
   "segment_id": 11,
   "arabic": "اَللَّهُمَّ إِنِّي أَسْأَلُكَ عَافِيَتَكَ في أُمُوري كُلِّهَا"
  },
  {
   "segment_id": 12,
   "arabic": "وَأَعُوذُ بِكَ مِنْ خِزْيِ ٱلدُّنْيَا وَعَذَابِ ٱلآخَرَةِ"
  },
  {
   "segment_id": 13,
   "arabic": "وَأَعوُذُ بِوَجْهِكَ ٱلْكَرِيـمِ"
  },
  {
   "segment_id": 14,
   "arabic": "وَعِزَّتِكَ ٱلَّتِي لاَ تُرَامُ"
  },
  {
   "segment_id": 15,
   "arabic": "وَقُدْرَتِكَ ٱلَّتِي لاَ يَمْتَنِعُ مِنْهَا شَيْءٌ"
  },
  {
   "segment_id": 16,
   "arabic": "مِنْ شَرِّ ٱلدُّنْيَا وَٱلآخِرَةِ"
  },
  {
   "segment_id": 17,
   "arabic": "وَمِنْ شَرِّ ٱلأَوْجَاعِ كُلِّهَا"
  },
  {
   "segment_id": 18,
   "arabic": "وَمِنْ شَرِّ كُلِّ دَابَّةٍ أَنْتَ آخِذٌ بِنَاصِيَتِهَا"
  },
  {
   "segment_id": 19,
   "arabic": "إنَّ رَبِّي عَلَىٰ صِرَاطٍ مُسْتَقِيمٍ"
  },
  {
   "segment_id": 20,
   "arabic": "وَلاَ حَوْلَ وَلاَ قُوَّةَ إِلاَّ بِٱللَّهِ ٱلْعَلِيِّ ٱلْعَظِيمِ"
  },
  {
   "segment_id": 21,
   "arabic": "تَوَكَّلْتُ عَلَىٰ ٱلْحَيِّ ٱلَّذِي لاَ يَمُوتُ"
  },
  {
   "segment_id": 22,
   "arabic": "وَٱلْحَمْدُ لِلَّهِ ٱلَّذِي لَمْ يَتَّخِذْ وَلَداً"
  },
  {
   "segment_id": 23,
   "arabic": "وَلَمْ يَكُنْ لَهُ شَريكٌ فِي ٱلْمُلْكِ"
  },
  {
   "segment_id": 24,
   "arabic": "وَلَمْ يَكُنْ لَهُ وَلِيٌّ مِنَ ٱلذُّلِّ"
  },
  {
   "segment_id": 25,
   "arabic": "وَكَبِّرْهُ تَكْبيراً"
  },
  {
   "segment_id": 26,
   "arabic": "أَشْهَدُ أَنْ لاَ إِلٰهَ إِلاَّ ٱللَّهُ"
  },
  {
   "segment_id": 27,
   "arabic": "وَحْدَهُ لاَ شَريكَ لَهُ"
  },
  {
   "segment_id": 28,
   "arabic": "إِلَهاً وَاحِداً"
  },
  {
   "segment_id": 29,
   "arabic": "أَحَداً فَرْداً صَمَداً"
  },
  {
   "segment_id": 30,
   "arabic": "لَمْ يَتَّخِذْ صَاحِبَةً وَلاَ وَلَداً"
  },
  {
   "segment_id": 31,
   "arabic": "سُبْحَانَ ٱللَّهِ كُلَّما سَبَّحَ ٱللَّهَ شَيءٌ"
  },
  {
   "segment_id": 32,
   "arabic": "وَكَمَا يُحِبُّ ٱللَّهُ أَنْ يُسَبَّحَ"
  },
  {
   "segment_id": 33,
   "arabic": "وَكَمَا هُوَ أَهْلُهُ"
  },
  {
   "segment_id": 34,
   "arabic": "وَكمَا يَنْبَغِي لِكَرَمِ وَجْهِهِ وَعِزِّ جَلاَلِهِ"
  },
  {
   "segment_id": 35,
   "arabic": "وَٱلْحَمْدُ لِلَّهِ كُلَّمَا حَمِدَ ٱللَّهَ شَيءٌ"
  },
  {
   "segment_id": 36,
   "arabic": "وَكَمَا يُحِبُّ ٱللَّهُ أَنْ يُحْمَدَ"
  },
  {
   "segment_id": 37,
   "arabic": "وَكَمَا هُوَ أَهْلُهُ"
  },
  {
   "segment_id": 38,
   "arabic": "وَكَمَا يَنْبَغِي لِكَرَمِ وَجْهِهِ وَعِزِّ جَلاَلِهِ"
  },
  {
   "segment_id": 39,
   "arabic": "وَلاَ إِلٰهَ إِلاَّ ٱللَّهُ كُلَّمَا هَلَّلَ ٱللَّهَ شَيءٌ"
  },
  {
   "segment_id": 40,
   "arabic": "وَكَمَا يُحِبُّ ٱللَّهُ أَنْ يُهَلَّلَ"
  },
  {
   "segment_id": 41,
   "arabic": "وَكَمَا هُوَ أَهْلُهُ"
  },
  {
   "segment_id": 42,
   "arabic": "وَكَمَا يَنْبَغِي لِكَرَمِ وَجْهِهِ وَعِزِّ جَلاَلِهِ"
  },
  {
   "segment_id": 43,
   "arabic": "وَٱللَّهُ أَكْبَرُ كُلَّمَا كَبَّرَ ٱللَّهَ شَيءٌ"
  },
  {
   "segment_id": 44,
   "arabic": "وَكَمَا يُحِبُّ ٱللَّهُ أَنْ يُكَبَّرَ"
  },
  {
   "segment_id": 45,
   "arabic": "وَكَمَا هُوَ أَهْلُهُ"
  },
  {
   "segment_id": 46,
   "arabic": "وَكَمَا يَنْبَغِي لِكَرَمِ وَجْهِهِ وَعِزِّ جَلاَلِهِ"
  },
  {
   "segment_id": 47,
   "arabic": "سُبْحَانَ ٱللَّهِ"
  },
  {
   "segment_id": 48,
   "arabic": "وَٱلْحَمْدُ لِلَّهِ"
  },
  {
   "segment_id": 49,
   "arabic": "وَلاَ إِلٰهَ إِلاَّ ٱللَّهُ"
  },
  {
   "segment_id": 50,
   "arabic": "وَٱللَّهُ أَكْبَرُ"
  },
  {
   "segment_id": 51,
   "arabic": "عَلَىٰ كُلِّ نِعْمَة أَنْعَمَ بِهَا عَلَيَّ"
  },
  {
   "segment_id": 52,
   "arabic": "وَعَلىٰ كُلِّ أَحَدٍ مِنْ خَلْقِهِ"
  },
  {
   "segment_id": 53,
   "arabic": "مِمَّنْ كَانَ أَوْ يَكُونُ إِلَىٰ يَوْمِ ٱلْقِيَامَةِ"
  },
  {
   "segment_id": 54,
   "arabic": "اَللَّهُمَّ إِنِّي أَسْأَلُكَ أَنْ تُصَلِّيَ عَلَىٰ مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 55,
   "arabic": "وَ أَسْأَلُكَ مِنْ خَيْرِ مَا أَرْجُو"
  },
  {
   "segment_id": 56,
   "arabic": "وَخَيْرِ مَا لاَ أَرْجُو"
  },
  {
   "segment_id": 57,
   "arabic": "وَ أَعُوذُ بِكَ مِنْ شَرِّ مَا أَحْذَرُ"
  },
  {
   "segment_id": 58,
   "arabic": "وَمِنْ شَرِّ مَا لاَ أَحْذَرُ"
  },
  {
   "segment_id": 59,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 60,
   "arabic": "وَٱجْعَلْ لِي مِنْ أَمْرِي فَرَجاً وَمَخْرَجاً"
  },
  {
   "segment_id": 61,
   "arabic": "وَٱرْزُقْنِي مِنْ حَيْثُ أَحْتَسِبُ وَمِنْ حَيْثُ لاَ أَحْتَسِبُ"
  },
  {
   "segment_id": 62,
   "arabic": "يَا رَبَّ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 63,
   "arabic": "صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 64,
   "arabic": "وَعَجِّلْ فَرَجَ آلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 65,
   "arabic": "يَا ذَا ٱلْجَلاَلِ وَٱلإِكْرَامِ"
  },
  {
   "segment_id": 66,
   "arabic": "صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 67,
   "arabic": "وَٱرْحَمْنِي وَ أَجِرْنِي مِنَ ٱلنَّارِ"
  },
  {
   "segment_id": 68,
   "arabic": "اَللَّهُمَّ إِنِّي أَسْأَلُكَ بِٱسْمِكَ ٱلْمَكْنُونِ ٱلْمَخْزُونِ"
  },
  {
   "segment_id": 69,
   "arabic": "ٱلطَّاهِرِ ٱلطُّهْرِ ٱلْمُبَارَكِ"
  },
  {
   "segment_id": 70,
   "arabic": "وَ أَسْأَلُكَ بِٱسْمِكَ ٱلْعَظِيمِ"
  },
  {
   "segment_id": 71,
   "arabic": "وَسُلْطَانِكَ ٱلْقَدِيـمِ"
  },
  {
   "segment_id": 72,
   "arabic": "يَا وَاهِبَ ٱلْعَطَايَا"
  },
  {
   "segment_id": 73,
   "arabic": "وَيَا مُطْلِقَ ٱلأُسَارَىٰ"
  },
  {
   "segment_id": 74,
   "arabic": "وَيَا فَكَّاكَ ٱلرِّقَابِ مِنَ ٱلنَّارِ"
  },
  {
   "segment_id": 75,
   "arabic": "أَسْأَلُكَ أَنْ تُصَلِّيَ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 76,
   "arabic": "وَ أَنْ تُعْتِقَ رَقَبَتِي مِنَ ٱلنَّارِ"
  },
  {
   "segment_id": 77,
   "arabic": "وَ أَنْ تُخْرِجَنِي مِنَ ٱلدُّنْيَا سَالِماً"
  },
  {
   "segment_id": 78,
   "arabic": "وَتُدْخِلَنِي ٱلْجَنَّةَ آمِناً"
  },
  {
   "segment_id": 79,
   "arabic": "وَ أَنْ تَجْعَلَ دُعَائِي أَوَّلَهُ فَلاَحاً"
  },
  {
   "segment_id": 80,
   "arabic": "وَ أَوْسَطَهُ نَجَاحاً"
  },
  {
   "segment_id": 81,
   "arabic": "وَآخِرَهُ صَلاَحاً"
  },
  {
   "segment_id": 82,
   "arabic": "إِنَّكَ أَنْتَ عَلاَّمُ الْغُيُوبِ"
  },
  {
   "segment_id": 83,
   "arabic": "يَا مَنْ لاَ يَشْغَلُهُ سَمْعٌ عَنْ سَمْعٍ"
  },
  {
   "segment_id": 84,
   "arabic": "وَيَا مَنْ لاَ يُغَلِّطُهُ ٱلسَّائِلُونَ"
  },
  {
   "segment_id": 85,
   "arabic": "وَيَا مَنْ لاَ يُبْرِمُهُ إِلْحَاحُ ٱلْمُلِحِّينَ"
  },
  {
   "segment_id": 86,
   "arabic": "أَذِقْنِي بَرْدَ عَفْوِكَ"
  },
  {
   "segment_id": 87,
   "arabic": "وَحَلاَوَةَ رَحْمَتِكَ وَمَغْفِرَتِكَ"
  },
  {
   "segment_id": 88,
   "arabic": "سُبْحَانَ مَنْ لاَ يَعْتَدي عَلَىٰ أَهْلِ مَمْلَكَتِهِ"
  },
  {
   "segment_id": 89,
   "arabic": "سُبْحَانَ مَنْ لاَ يَأْخُذُ أَهْلَ ٱلأَرْضِ بِأَلْوَانِ الْعَذَابِ"
  },
  {
   "segment_id": 90,
   "arabic": "سُبْحَانَ ٱلرَّؤوُفِ ٱلرَّحِيمِ"
  },
  {
   "segment_id": 91,
   "arabic": "اَللَّهُمَّ ٱجَعلْ لِي فِي قَلْبِي نُوراً وَبَصَراً"
  },
  {
   "segment_id": 92,
   "arabic": "وَفَهْمَاً وَعِلْمَاً"
  },
  {
   "segment_id": 93,
   "arabic": "إِنَّكَ عَلَىٰ كُلِّ شَيْءٍ قَديرٌ"
  },
  {
   "segment_id": 94,
   "arabic": "أُعِيذُ نَفْسي وَدِينِي"
  },
  {
   "segment_id": 95,
   "arabic": "وَ أَهْلِي وَمَالِي"
  },
  {
   "segment_id": 96,
   "arabic": "وَوَلَدِي وَإِخْوَانِي فِي دِينِي"
  },
  {
   "segment_id": 97,
   "arabic": "وَمَا رَزَقَنِي رَبِّي وَخَوَاتِيمَ عَمَلِي"
  },
  {
   "segment_id": 98,
   "arabic": "وَمَنْ يَعْنِينِي أَمْرُهُ"
  },
  {
   "segment_id": 99,
   "arabic": "بِٱللَّهِ ٱلْوَاحِدِ"
  },
  {
   "segment_id": 100,
   "arabic": "ٱلأَحَدِ ٱلصَّمَدِ"
  },
  {
   "segment_id": 101,
   "arabic": "ٱلَّذِي لَمْ يَلِدْ وَلَمْ يُولَدْ"
  },
  {
   "segment_id": 102,
   "arabic": "وَلَمْ يَكُنْ لَهُ كُفُواً أَحَدٌ"
  },
  {
   "segment_id": 103,
   "arabic": "وَبِرَبِّ ٱلْفَلَقِ"
  },
  {
   "segment_id": 104,
   "arabic": "مِنْ شَرِّ مَا خَلَقَ"
  },
  {
   "segment_id": 105,
   "arabic": "وَمِنْ شَرِّ غَاسِقٍ إِذَا وَقَبَ"
  },
  {
   "segment_id": 106,
   "arabic": "وَمِنْ شَرِّ ٱلنَّفَّاثَاتِ فِي ٱلْعُقَدِ"
  },
  {
   "segment_id": 107,
   "arabic": "وَمِنْ شَرِّ حَاسِدٍ إِذَا حَسَدَ"
  },
  {
   "segment_id": 108,
   "arabic": "وَبِرَبِّ ٱلنَّاسِ"
  },
  {
   "segment_id": 109,
   "arabic": "مَلِكِ ٱلنَّاسِ"
  },
  {
   "segment_id": 110,
   "arabic": "إِلٰهِ ٱلنَّاسِ"
  },
  {
   "segment_id": 111,
   "arabic": "مِنْ شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ"
  },
  {
   "segment_id": 112,
   "arabic": "ٱلَّذِي يُوَسْوِسُ فِي صُدُورِ ٱلنَّاسِ"
  },
  {
   "segment_id": 113,
   "arabic": "مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ"
  },
  {
   "segment_id": 114,
   "arabic": "اَللَّهُمَّ إِنَّ مَغْفِرَتَكَ أَرْجَىٰ مِنْ عَمَلِي"
  },
  {
   "segment_id": 115,
   "arabic": "وَإِنَّ رَحْمَتِكَ أَوْسَعُ مِنْ ذَنْبِي"
  },
  {
   "segment_id": 116,
   "arabic": "اَللَّهُمَّ إنْ كَانَ ذَنبِي عِنْدَكَ عَظِيماً"
  },
  {
   "segment_id": 117,
   "arabic": "فَعَفْوُكَ أَعْظَمُ مِنْ ذَنْبِي"
  },
  {
   "segment_id": 118,
   "arabic": "اَللَّهُمَّ إِنْ لَمْ أَكُنْ أَهْلاً أَنْ أَبْلُغَ رَحْمَتَكَ"
  },
  {
   "segment_id": 119,
   "arabic": "فَرَحْمَتُكَ أَهْلٌ أَنْ تَبْلُغَنِي وَتَسَعَنِي"
  },
  {
   "segment_id": 120,
   "arabic": "لِأَنَّهَا وَسِعَتْ كُلَّ شَيْءٍ"
  },
  {
   "segment_id": 121,
   "arabic": "بِرَحْمَتِكَ يَا أَرْحَمَ ٱلرَّاحِمينَ"
  },
  {
   "segment_id": 122,
   "arabic": "اَللَّهُمَّ أَنْتَ ٱلسَّلاَمُ"
  },
  {
   "segment_id": 123,
   "arabic": "وَمِنْكَ ٱلسَّلاَمُ"
  },
  {
   "segment_id": 124,
   "arabic": "وَلَكَ ٱلسَّلاَمُ"
  },
  {
   "segment_id": 125,
   "arabic": "وَإِلَيْكَ يَعُودُ ٱلسَّلاَمُ"
