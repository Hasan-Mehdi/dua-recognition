{
 "dua_id": "duasorg-dua-taqeebat-after-maghrib-isha-prayers-16",
 "dua_name_en": "Dua after Maghrib Nafilah",
 "dua_name_ar": "",
 "source": "https://www.duas.org/dua-taqeebat-after-maghrib-isha-prayers.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللَّهُمَّ إِنِّي اسْالُكَ بِوَجْهِكَ ٱلْكَرِيـمِ"
  },
  {
   "segment_id": 2,
   "arabic": "وَٱسْمِكَ ٱلْعَظِيمِ"
  },
  {
   "segment_id": 3,
   "arabic": "وَمُلْكِكَ ٱلْقَدِيـمِ"
  },
  {
   "segment_id": 4,
   "arabic": "انْ تُصَلِّيَ عَلَىٰ مُحَمَّد وَآلِهِ"
  },
  {
   "segment_id": 5,
   "arabic": "وَ انْ تَغْفِرَ لِي ذَنْبِيَ ٱلْعَظِيمَ"
  },
  {
   "segment_id": 6,
   "arabic": "إِنَّهُ لاَ يَغْفِرُ ٱلْعَظِيمَ إِلاَّ ٱلْعَظِيمُ"
  },
  {
   "segment_id": 7,
   "arabic": "مَا شَاءَ ٱللَّهُ"
  },
  {
   "segment_id": 8,
   "arabic": "لاَ قُوَّةَ إِلاَّ بِٱللَّهِ"
  },
  {
   "segment_id": 9,
   "arabic": "اَسْتَغْفِرُ ٱللَّهَ"
  }
 ]
}