{
 "dua_id": "duasorg-15-shaban-dua-by-imam-sadiq",
 "dua_name_en": "Dua by Imam Sadiq - 15th Sha'aban",
 "dua_name_ar": "",
 "source": "https://www.duas.org/15-shaban-dua-by-imam-sadiq.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللّهُمَّ أَنْتَ الْحَيُّ الْقَيُّومُ"
  },
  {
   "segment_id": 2,
   "arabic": "الْعَلِيُّ الْعَظِيمُ"
  },
  {
   "segment_id": 3,
   "arabic": "الْخَالِقُ الرَّازِقُ"
  },
  {
   "segment_id": 4,
   "arabic": "الْمُحْيِي الْمُمِيتُ"
  },
  {
   "segment_id": 5,
   "arabic": "الْبَدِيءُ الْبَدِيعُ،"
  },
  {
   "segment_id": 6,
   "arabic": "لَكَ الْجَلالُ،"
  },
  {
   "segment_id": 7,
   "arabic": "وَلَكَ الْفَضْلُ،"
  },
  {
   "segment_id": 8,
   "arabic": "وَلَكَ الْحَمْدُ،"
  },
  {
   "segment_id": 9,
   "arabic": "وَلَكَ الْمَنُّ،"
  },
  {
   "segment_id": 10,
   "arabic": "وَلَكَ الْجُودُ،"
  },
  {
   "segment_id": 11,
   "arabic": "وَلَكَ الْكَرَمُ،"
  },
  {
   "segment_id": 12,
   "arabic": "وَلَكَ الأَمْرُ،"
  },
  {
   "segment_id": 13,
   "arabic": "وَلَكَ الْمَجْدُ،"
  },
  {
   "segment_id": 14,
   "arabic": "وَلَكَ الشُّكْرُ،"
  },
  {
   "segment_id": 15,
   "arabic": "وَحْدَكَ لا شَرِيكَ لَكَ،"
  },
  {
   "segment_id": 16,
   "arabic": "يَا وَاحِدُ يَا أَحَدُ يَا صَمَدُ"
  },
  {
   "segment_id": 17,
   "arabic": "يَا مَنْ لَمْ يَلِدْ وَلَمْ يُولَدْ"
  },
  {
   "segment_id": 18,
   "arabic": "وَلَمْ يَكُنْ لَهُ كُفُواً أَحَدٌ،"
  },
  {
   "segment_id": 19,
   "arabic": "صَلِّ عَلَى مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 20,
   "arabic": "وَاغْفِرْ لِي وَارْحَمْنِي"
  },
  {
   "segment_id": 21,
   "arabic": "وَاكْفِنِي مَا أَهَمَّنِي"
  },
  {
   "segment_id": 22,
   "arabic": "وَاقْضِ دَيْنِي،"
  },
  {
   "segment_id": 23,
   "arabic": "وَوَسِّعْ عَلَيَّ فِي رِزْقِي،"
  },
  {
   "segment_id": 24,
   "arabic": "فَإنَّكَ فِي هذِهِ اللَّيْلَةِ كُلَّ أَمْرٍ حَكِيمٍ تَفْرُقُ،"
  },
  {
   "segment_id": 25,
   "arabic": "وَمَنْ تَشَاءُ مِنْ خَلْقِكَ تَرْزُقُ،"
  },
  {
   "segment_id": 26,
   "arabic": "فَارْزُقْنِي وَأَنْتَ خَيْرُ الرَّازِقِينَ،"
  },
  {
   "segment_id": 27,
   "arabic": "فَإنَّكَ قُلْتَ وَأَنْتَ خَيْرُ الْقَائِلِينَ النَّاطِقِينَ:"
  },
  {
   "segment_id": 28,
   "arabic": "(وَاسْأَلُوَا اللّهَ مِنْ فَضْلِهِ)"
  },
  {
   "segment_id": 29,
   "arabic": "فَمِنْ فَضْلِكَ أَسْأَلُ،"
  },
  {
   "segment_id": 30,
   "arabic": "وَإيَّاكَ قَصَدْتُ،"
  },
  {
   "segment_id": 31,
   "arabic": "وَابْنَ نَبِيِّكَ اعْتَمَدْتُ،"
  },
  {
   "segment_id": 32,
   "arabic": "وَلَكَ رَجَوْتُ،"
  },
  {
   "segment_id": 33,
   "arabic": "فَارْحَمْنِي يَا أَرْحَمَ الرَّاحِمِينَ."
  }
 ]
}