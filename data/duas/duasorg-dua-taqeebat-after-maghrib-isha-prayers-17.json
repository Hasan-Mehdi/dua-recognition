{
 "dua_id": "duasorg-dua-taqeebat-after-maghrib-isha-prayers-17",
 "dua_name_en": "Maghrib and Isha Taqeebat · Sabbaḥa lillāhi mā fī…",
 "dua_name_ar": "",
 "source": "https://www.duas.org/dua-taqeebat-after-maghrib-isha-prayers.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "سَبَّحَ لِلَّهِ مَا فِي ٱلسَّمَاوَاتِ وَٱلارْضِ"
  },
  {
   "segment_id": 2,
   "arabic": "وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ."
  },
  {
   "segment_id": 3,
   "arabic": "لَهُ مُلْكُ ٱلسَّمَاوَاتِ وَٱلارْضِ"
  },
  {
   "segment_id": 4,
   "arabic": "يُحْيِي وَيُمِيتُ"
  },
  {
   "segment_id": 5,
   "arabic": "وَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ."
  },
  {
   "segment_id": 6,
   "arabic": "هُوَ ٱلاوَّلُ وَٱلآخِرُ"
  },
  {
   "segment_id": 7,
   "arabic": "وَٱلظَّاهِرُ وَٱلْبَاطِنُ"
  },
  {
   "segment_id": 8,
   "arabic": "وَهُوَ بِكُلِّ شَيْءٍ عَلِيمٌ."
  },
  {
   "segment_id": 9,
   "arabic": "هُوَ ٱلَّذِي خَلَقَ ٱلسَّمَاوَاتِ وَٱلارْضَ"
  },
  {
   "segment_id": 10,
   "arabic": "فِي سِتَّةِ ايَّامٍ"
  },
  {
   "segment_id": 11,
   "arabic": "ثُمَّ ٱسْتَوَىٰ عَلَىٰ ٱلْعَرْشِ"
  },
  {
   "segment_id": 12,
   "arabic": "يَعْلَمُ مَا يَلِجُ فِي ٱلارْضِ"
  },
  {
   "segment_id": 13,
   "arabic": "وَمَا يَخْرُجُ مِنْهَا"
  },
  {
   "segment_id": 14,
   "arabic": "وَمَا يَنْزِلُ مِنْ ٱلسَّمَاءِ"
  },
  {
   "segment_id": 15,
   "arabic": "وَمَا يَعْرُجُ فِيهَا"
  },
  {
   "segment_id": 16,
   "arabic": "وَهُوَ مَعَكُمْ ايْنَ مَا كُنْتُمْ"
  },
  {
   "segment_id": 17,
   "arabic": "وَٱللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ."
  },
  {
   "segment_id": 18,
   "arabic": "لَهُ مُلْكُ ٱلسَّمَاوَاتِ وَٱلارْضِ"
  },
  {
   "segment_id": 19,
   "arabic": "وَإِلَىٰ اللَّهِ تُرْجَعُ ٱلامُورُ."
  },
  {
   "segment_id": 20,
   "arabic": "يُولِجُ ٱللَّيْلَ فِي ٱلنَّهَارِ"
  },
  {
   "segment_id": 21,
   "arabic": "وَيُولِجُ ٱلنَّهَارَ فِي ٱللَّيْلِ"
  },
  {
   "segment_id": 22,
   "arabic": "وَهُوَ عَلِيمٌ بِذَاتِ ٱلصُّدُورِ."
  }
 ]
}