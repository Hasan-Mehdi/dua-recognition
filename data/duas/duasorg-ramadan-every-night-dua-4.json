{
 "dua_id": "duasorg-ramadan-every-night-dua-4",
 "dua_name_en": "Elahi waqafis Saaeloon",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-every-night-dua.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "إِلٰهِي وَقَفَ ٱلسَّائِلُونَ بِبَابِكَ"
  },
  {
   "segment_id": 2,
   "arabic": "وَلاذَ ٱلفُقَراءُ بِجَنابِكَ"
  },
  {
   "segment_id": 3,
   "arabic": "وَوَقَفَتْ سَفِينَةُ ٱلمسَاكِينِ عَلَىٰ سَاحِلِ بَحْرِ جُودِكَ وَكَرَمِكَ"
  },
  {
   "segment_id": 4,
   "arabic": "يَرْجُونَ ٱلجَوَازَ إِلَىٰ سَاحَةِ رَحْمَتِكَ وَنِعْمَتِكَ"
  },
  {
   "segment_id": 5,
   "arabic": "إِلٰهِي إِنْ كُنْتَ لاَ تَرْحَم فِي هٰذَا ٱلشَّهْرِ ٱلشَّرِيفِ"
  },
  {
   "segment_id": 6,
   "arabic": "إِلاَّ مَنْ أَخْلَصَ لَكَ فِي صِيَامِهِ وَقِيَامِهِ"
  },
  {
   "segment_id": 7,
   "arabic": "فَمَنْ لِلْمُذْنِبِ ٱلْمُقَصِّرِ"
  },
  {
   "segment_id": 8,
   "arabic": "إِذَا غَرِقَ فِي بَحْرِ ذُنُوبِهِ وَآثَامِهِ"
  },
  {
   "segment_id": 9,
   "arabic": "إِلٰهِي إِنْ كُنْتَ لاَ تَرْحَم إِلاَّ ٱلْمُطِيعِينَ"
  },
  {
   "segment_id": 10,
   "arabic": "فَمَنْ لِلْعَاصِينَ"
  },
  {
   "segment_id": 11,
   "arabic": "وَإِنْ كُنْتَ لاَ تَقْبَل إِلاَّ مِنَ ٱلعَامِلِينَ"
  },
  {
   "segment_id": 12,
   "arabic": "فَمَنْ للْمُقَصِّرِينَ"
  },
  {
   "segment_id": 13,
   "arabic": "إِلٰهِي رَبِحَ ٱلصَّائِمُونَ"
  },
  {
   "segment_id": 14,
   "arabic": "وَفَازَ ٱلقَائِمُونَ"
  },
  {
   "segment_id": 15,
   "arabic": "وَنَجَا ٱلُمخْلِصُونَ"
  },
  {
   "segment_id": 16,
   "arabic": "وَنَحْنُ عَبِيدُكَ ٱلْمُذْنِبُونَ"
  },
  {
   "segment_id": 17,
   "arabic": "فَٱرْحَمْنَا بِرَحْمَتِكَ"
  },
  {
   "segment_id": 18,
   "arabic": "وَأَعْتِقْنَا مِنَ ٱلنَّارِ بَعَفْوِك"
  },
  {
   "segment_id": 19,
   "arabic": "وَٱغْفِرْ لَنَا ذُنُوبَنَا"
  },
  {
   "segment_id": 20,
   "arabic": "بِرَحْمَتِكَ يا أَرْحَمَ ٱلرَّاحِمِينَ"
  }
 ]
}