{
 "dua_id": "mafatih-munajat-shakeen",
 "dua_name_en": "Munajat Shakeen",
 "dua_name_ar": "مناجاة الشاكين",
 "source": "Mafatih al-Jinan (github.com/kazemcodes/MafatihDecoder); lines from reciters' pauses",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "إِلهي إِلَيْكَ أَشْكُو نَفْساً بِالسُّوءِ أَمّارَةً"
  },
  {
   "segment_id": 2,
   "arabic": "وَإِلى الْخَطيئَةِ مُبادِرَةً"
  },
  {
   "segment_id": 3,
   "arabic": "وَبِمَعاصيكَ مُولَعَةً"
  },
  {
   "segment_id": 4,
   "arabic": "وَلِسَخَطِكَ مُتَعَرِّضَةً"
  },
  {
   "segment_id": 5,
   "arabic": "تَسْلُكُ بي مَسالِكَ الْمَهالِكِ"
  },
  {
   "segment_id": 6,
   "arabic": "وَتَجْعَلُني عِنْدَكَ أَهْوَنَ هالِكٍ"
  },
  {
   "segment_id": 7,
   "arabic": "كَثيرَةَ الْعِلَلِ طَويلَةَ الأَمَلِ"
  },
  {
   "segment_id": 8,
   "arabic": "إِنْ مَسَّهَا الشَّرُّ تَجْزَعُ وَإِنْ مَسَّهَا الْخَيْرُ تَمْنَعُ"
  },
  {
   "segment_id": 9,
   "arabic": "مَيّالَةً إِلَى اللَّعِبِ وَاللَّهْوِ"
  },
  {
   "segment_id": 10,
   "arabic": "مَمْلُوَّةً بِالْغَفْلَةِ وَالسَّهْوِ"
  },
  {
   "segment_id": 11,
   "arabic": "تُسْرِعُ بي إِلى الْحَوْبَةِ وَتُسَوِّفُني بِالتَّوْبَةِ"
  },
  {
   "segment_id": 12,
   "arabic": "إِلهي أَشْكُو إِلَيْكَ عَدُوّاً يُضِلُّني"
  },
  {
   "segment_id": 13,
   "arabic": "وَشَيْطاناً يُغْويني"
  },
  {
   "segment_id": 14,
   "arabic": "قَدْ مَلَأَ بِالْوَسْواسِ صَدْري"
  },
  {
   "segment_id": 15,
   "arabic": "وَأَحاطَتْ هَواجِسُهُ بِقَلْبي"
  },
  {
   "segment_id": 16,
   "arabic": "يُعاضِدُ لِيَ الْهَوى"
  },
  {
   "segment_id": 17,
   "arabic": "وَيُزَيِّنُ لي حُبَّ الدُّنْيا"
  },
  {
   "segment_id": 18,
   "arabic": "وَيَحُولُ بَيْني وَبَيْنَ الطّاعَةِ وَالزُّلْفى"
  },
  {
   "segment_id": 19,
   "arabic": "إِلهي إِلَيْكَ أَشْكُو قَلْباً قاسِياً مَعَ الْوَسْواسِ مُتَقَلِّباً"
  },
  {
   "segment_id": 20,
   "arabic": "وَبِالرَّيْنِ وَالطَّبْعِ مُتَلَبِّساً"
  },
  {
   "segment_id": 21,
   "arabic": "وَعَيْناً عَنِ الْبُكاءِ مِنْ خَوْفِكَ جامِدَةً"
  },
  {
   "segment_id": 22,
   "arabic": "وَإِلى ما تَسُرُّها طامِحَةً"
  },
  {
   "segment_id": 23,
   "arabic": "إِلهي لا حَوْلَ لي وَلا قُوَّةَ إِلاّ بِقُدْرَتِكَ"
  },
  {
   "segment_id": 24,
   "arabic": "وَلا نَجاةَ لي مِنْ مَكارِهِ الدُّنْيا إِلاّ بِعِصْمَتِكَ"
  },
  {
   "segment_id": 25,
   "arabic": "فَأَسْئَلُكَ بِبَلاغَةِ حِكْمَتِكَ وَنَفاذِ مَشِيَّتِكَ"
  },
  {
   "segment_id": 26,
   "arabic": "أَنْ لا تَجْعَلَني لِغَيْرِ جُوْدِكَ مُتَعَرِّضاً"
  },
  {
   "segment_id": 27,
   "arabic": "وَلا تُصَيِّرَني لِلْفِتَنِ غَرَضاً"
  },
  {
   "segment_id": 28,
   "arabic": "وَكُنْ لي عَلَى الأَعْداءِ ناصِراً"
  },
  {
   "segment_id": 29,
   "arabic": "وَعَلَى الْمَخازي وَالْعُيُوبِ ساتِراً"
  },
  {
   "segment_id": 30,
   "arabic": "وَمِنَ الْبَلاءِ وَاقِياً وَعَنِ الْمَعاصي عاصِماً"
  },
  {
   "segment_id": 31,
   "arabic": "بِرَأْفَتِكَ وَرَحْمَتِكَ يا أَرْحَمَ الرّاحِمينَ"
  }
 ]
}