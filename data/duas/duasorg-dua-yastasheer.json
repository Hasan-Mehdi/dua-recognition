{
 "dua_id": "duasorg-dua-yastasheer",
 "dua_name_en": "Dua Yastasheer",
 "dua_name_ar": "",
 "source": "https://www.duas.org/dua-yastasheer.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "الْحَمْدُ لِلَّهِ ٱلَّذِي"
  },
  {
   "segment_id": 2,
   "arabic": "لاَ إِلٰهَ إِلاَّ هُوَ"
  },
  {
   "segment_id": 3,
   "arabic": "ٱلْمَلِكُ ٱلْحَقُّ ٱلْمُبِينُ"
  },
  {
   "segment_id": 4,
   "arabic": "ٱلْمُدَبِّرُ بِلاَ وَزِيرٍ"
  },
  {
   "segment_id": 5,
   "arabic": "وَلاَ خَلْقٍ مِنْ عِبَادِهِ يَسْتَشِيرُ"
  },
  {
   "segment_id": 6,
   "arabic": "ٱلاوَّلُ غَيْرُ مَوْصُوفٍ"
  },
  {
   "segment_id": 7,
   "arabic": "وَٱلْبَاقِي بَعْدَ فَنَاءِ ٱلْخَلْقِ"
  },
  {
   "segment_id": 8,
   "arabic": "ٱلْعَظِيمُ ٱلرُّبُوبِيَّةِ"
  },
  {
   "segment_id": 9,
   "arabic": "نُورُ ٱلسَّمَاوَاتِ وَٱلارَضِينَ"
  },
  {
   "segment_id": 10,
   "arabic": "وَفَاطِرُهُمَا وَمُبْتَدِعُهُمَا"
  },
  {
   "segment_id": 11,
   "arabic": "بِغَيْرِ عَمَدٍ خَلَقَهُمَا وَفَتَقَهُمَا فَتْقاً"
  },
  {
   "segment_id": 12,
   "arabic": "فَقَامَتِ ٱلسَّمَاوَاتِ طَائِعَاتٍ بِامْرِهِ"
  },
  {
   "segment_id": 13,
   "arabic": "وَٱسْتَقَرَّتِ ٱلارَضُونَ بِاوْتَادِهَا فَوْقَ ٱلْمَاءِ"
  },
  {
   "segment_id": 14,
   "arabic": "ثُمَّ عَلاَ رَبُّنَا فِي ٱلسَّمَاوَاتِ ٱلْعُلَىٰ"
  },
  {
   "segment_id": 15,
   "arabic": "ٱلرَحْمٰنُ عَلىٰ ٱلْعَرْشِ ٱسْتَوَىٰ"
  },
  {
   "segment_id": 16,
   "arabic": "لَهُ مَا فِي ٱلسَّمَاوَاتِ وَٱلارْضِ"
  },
  {
   "segment_id": 17,
   "arabic": "وَمَا بَيْنَهُمَا وَمَا تَحْتَ ٱلثَّرَىٰ"
  },
  {
   "segment_id": 18,
   "arabic": "فَانَاْ اشْهَدُ بِانَّكَ انتَ ٱللَّهُ"
  },
  {
   "segment_id": 19,
   "arabic": "لاَ رَافِعَ لِمَا وَضَعْتَ"
  },
  {
   "segment_id": 20,
   "arabic": "وَلاَ وَاضِعَ لِمَا رَفَعْتَ"
  },
  {
   "segment_id": 21,
   "arabic": "وَلاَ مُعِزَّ لِمَنْ اذْلَلْتَ"
  },
  {
   "segment_id": 22,
   "arabic": "وَلاَ مُذِلَّ لِمَنْ اعْزَزْتَ"
  },
  {
   "segment_id": 23,
   "arabic": "وَلاَ مَانِعَ لِمَا اعْطَيْتَ"
  },
  {
   "segment_id": 24,
   "arabic": "وَلاَ مُعْطِيَ لِمَا مَنَعْتَ"
  },
  {
   "segment_id": 25,
   "arabic": "وَانتَ ٱللَّهُ لاَ إِلٰهَ إِلاَّ انتَ"
  },
  {
   "segment_id": 26,
   "arabic": "إِذْ لَمْ تَكُنْ سَمَاءٌ مَبْنِيَّةً"
  },
  {
   "segment_id": 27,
   "arabic": "وَلاَ ارْضٌ مَدْحِيَّةً"
  },
  {
   "segment_id": 28,
   "arabic": "وَلاَ شَمْسٌ مُضِيئَةً"
  },
  {
   "segment_id": 29,
   "arabic": "وَلاَ لَيْلٌ مَظْلِمٌ"
  },
  {
   "segment_id": 30,
   "arabic": "وَلاَ نَهَارٌ مُضِيءٌ"
  },
  {
   "segment_id": 31,
   "arabic": "وَلاَ بَحْرٌ لُجِّيٌّ"
  },
  {
   "segment_id": 32,
   "arabic": "وَلاَ جَبَلٌ رَاسٍ"
  },
  {
   "segment_id": 33,
   "arabic": "وَلاَ نَجْمٌ سَارٍ"
  },
  {
   "segment_id": 34,
   "arabic": "وَلاَ قَمَرٌ مُنِيرٌ"
  },
  {
   "segment_id": 35,
   "arabic": "وَلاَ رِيحٌ تَهُبُّ"
  },
  {
   "segment_id": 36,
   "arabic": "وَلاَ سَحَابٌ يَسْكُبُ"
  },
  {
   "segment_id": 37,
   "arabic": "وَلاَ بَرْقٌ يَلْمَعُ"
  },
  {
   "segment_id": 38,
   "arabic": "وَلاَ رَعْدٌ يُسَبِّحُ"
  },
  {
   "segment_id": 39,
   "arabic": "وَلاَ رُوحٌ تَنَفَّسُ"
  },
  {
   "segment_id": 40,
   "arabic": "وَلاَ طَائِرٌ يَطِيرُ"
  },
  {
   "segment_id": 41,
   "arabic": "وَلاَ نَارٌ تَتَوَقَّدُ"
  },
  {
   "segment_id": 42,
   "arabic": "وَلاَ مَاءٌ يَطَّرِدُ"
  },
  {
   "segment_id": 43,
   "arabic": "كُنتَ قَبْلَ كُلِّ شَيْءٍ"
  },
  {
   "segment_id": 44,
   "arabic": "وَكَوَّنتَ كُلَّ شَيْءٍ"
  },
  {
   "segment_id": 45,
   "arabic": "وَقَدَرْتَ عَلَىٰ كُلِّ شَيْءٍ"
  },
  {
   "segment_id": 46,
   "arabic": "وَٱبْتَدَعْتَ كُلَّ شَيْءٍ"
  },
  {
   "segment_id": 47,
   "arabic": "وَاغْنَيْتَ وَافْقَرْتَ"
  },
  {
   "segment_id": 48,
   "arabic": "وَامَتَّ وَاحْيَيْتَ"
  },
  {
   "segment_id": 49,
   "arabic": "وَاضْحَكْتَ وَابْكَيْتَ"
  },
  {
   "segment_id": 50,
   "arabic": "وَعَلَىٰ ٱلْعَرْشِ ٱستَوَيْتَ"
  },
  {
   "segment_id": 51,
   "arabic": "فَتَبَارَكْتَ يَا اللَّهُ وَتَعَالَيْتَ"
  },
  {
   "segment_id": 52,
   "arabic": "انتَ ٱللَّهُ ٱلَّذِي لاَ إِلٰهَ إِلاَّ انتَ"
  },
  {
   "segment_id": 53,
   "arabic": "ٱلْخَلاَّقُ ٱلْمُعِينُ"
  },
  {
   "segment_id": 54,
   "arabic": "امْرُكَ غَاِلبٌ"
  },
  {
   "segment_id": 55,
   "arabic": "وَعِلْمُكَ نَافِذً"
  },
  {
   "segment_id": 56,
   "arabic": "وَكَيْدُكَ غَرِيبٌ"
  },
  {
   "segment_id": 57,
   "arabic": "وَوَعْدُكَ صَادِقٌ"
  },
  {
   "segment_id": 58,
   "arabic": "وَقَوْلُكَ حَقٌّ"
  },
  {
   "segment_id": 59,
   "arabic": "وَحُكْمُكَ عَدْلٌ"
  },
  {
   "segment_id": 60,
   "arabic": "وَكَلاَمُكَ هُدىٰ"
  },
  {
   "segment_id": 61,
   "arabic": "وَوَحْيُكَ نُورٌ"
  },
  {
   "segment_id": 62,
   "arabic": "وَرَحْمَتُكَ وَاسِعَةً"
  },
  {
   "segment_id": 63,
   "arabic": "وَعَفْوُكَ عَظِيمٌ"
  },
  {
   "segment_id": 64,
   "arabic": "وَفَضْلُكَ كَثِيرٌ"
  },
  {
   "segment_id": 65,
   "arabic": "وَعَطَاؤُكَ جَزِيلٌ"
  },
  {
   "segment_id": 66,
   "arabic": "وَحَبْلُكَ مَتِينٌ"
  },
  {
   "segment_id": 67,
   "arabic": "وَإِمْكَانُكَ عَتِيدٌ"
  },
  {
   "segment_id": 68,
   "arabic": "وَجَارُكَ عَزِيزٌ"
  },
  {
   "segment_id": 69,
   "arabic": "وَبَاسُكَ شَدِيدٌ"
  },
  {
   "segment_id": 70,
   "arabic": "وَمَكْرُكَ مَكِيدٌ"
  },
  {
   "segment_id": 71,
   "arabic": "انتَ يَارَبِّ مَوْضِعُ كُلِّ شَكْوَىٰ"
  },
  {
   "segment_id": 72,
   "arabic": "وَحَاضِرُ كُلِّ مَلإٍ"
  },
  {
   "segment_id": 73,
   "arabic": "وَشَاهِدُ كُلِّ نَجْوَىٰ"
  },
  {
   "segment_id": 74,
   "arabic": "مُنتَهَىٰ كُلِّ حَاجَةٍ"
  },
  {
   "segment_id": 75,
   "arabic": "مُفَرِّجُ كُلِّ حُزْنٍ"
  },
  {
   "segment_id": 76,
   "arabic": "غِنَىٰ كُلِّ مِسْكِينٍ"
  },
  {
   "segment_id": 77,
   "arabic": "حِصْنُ كُلِّ هَارِبٍ"
  },
  {
   "segment_id": 78,
   "arabic": "امَانُ كُلِّ خَائِفٍ"
  },
  {
   "segment_id": 79,
   "arabic": "حِرْزُ ٱلضُّعَفَاءِ"
  },
  {
   "segment_id": 80,
   "arabic": "كَنْزُ ٱلْفُقَرَاءِ"
  },
  {
   "segment_id": 81,
   "arabic": "مُفَرِّجُ ٱلْغَمَّاءِ"
  },
  {
   "segment_id": 82,
   "arabic": "مُعِينُ ٱلصَّالِحِينَ"
  },
  {
   "segment_id": 83,
   "arabic": "ذٰلِكَ ٱللَّهُ رَبُّنَا لاَ إِلٰهَ إِلاَّ هُوَ"
  },
  {
   "segment_id": 84,
   "arabic": "تَكْفِي مِنْ عِبَادِكَ مَنْ تَوَكَّلَ عَلَيْكَ"
  },
  {
   "segment_id": 85,
   "arabic": "وَانتَ جَارُ مَنْ لاَذَ بِكَ وَتَضَرَّعَ إِلَيْكَ"
  },
  {
   "segment_id": 86,
   "arabic": "عِصْمَةُ مَنِ ٱعْتَصَمَ بِكَ"
  },
  {
   "segment_id": 87,
   "arabic": "نَاصِرُ مَنِ ٱنتَصَرَ بِكَ"
  },
  {
   "segment_id": 88,
   "arabic": "تَغْفِرُ ٱلذُّنُوبُ لِمَنِ ٱسْتَغْفَرَكَ"
  },
  {
   "segment_id": 89,
   "arabic": "جَبَّارُ ٱلْجَبَابِرَةِ"
  },
  {
   "segment_id": 90,
   "arabic": "عَظِيمُ ٱلْعُظَمَاءِ"
  },
  {
   "segment_id": 91,
   "arabic": "كَبِيرُ ٱلْكُبَرَاءِ"
  },
  {
   "segment_id": 92,
   "arabic": "سَيِّدُ ٱلسَّادَاتِ"
  },
  {
   "segment_id": 93,
   "arabic": "مَوْلَىٰ ٱلْمَوَالِي"
  },
  {
   "segment_id": 94,
   "arabic": "صَرِيخُ ٱلْمُسْتَصْرِخِينَ"
  },
  {
   "segment_id": 95,
   "arabic": "مُنَفِّسٌ عَنِ ٱلْمَكْرُوبِينَ"
  },
  {
   "segment_id": 96,
   "arabic": "مُجِيبُ دَعْوَةِ ٱلْمُضْطَرِّينَ"
  },
  {
   "segment_id": 97,
   "arabic": "اسْمَعُ ٱلسَّامِعِينَ"
  },
  {
   "segment_id": 98,
   "arabic": "ابْصَرُ ٱلنَّاظِرِينَ"
  },
  {
   "segment_id": 99,
   "arabic": "احْكَمُ ٱلْحَاكِمِينَ"
  },
  {
   "segment_id": 100,
   "arabic": "اسْرَعُ ٱلَحَاسِبِينَ"
  },
  {
   "segment_id": 101,
   "arabic": "ارْحَمُ ٱلرَّاحِمِينَ"
  },
  {
   "segment_id": 102,
   "arabic": "خَيْرُ ٱلْغَافِرِينَ"
  },
  {
   "segment_id": 103,
   "arabic": "قَاضِي حَوَائِجِ ٱلْمُؤْمِنِينَ"
  },
  {
   "segment_id": 104,
   "arabic": "مُغِيثُ ٱلصَّالِحِينَ"
  },
  {
   "segment_id": 105,
   "arabic": "انتَ ٱللَّهُ لاَ إِلٰهَ إِلاَّ انتَ"
  },
  {
   "segment_id": 106,
   "arabic": "رَبُّ ٱلْعَالَمِينَ"
  },
  {
   "segment_id": 107,
   "arabic": "انتَ ٱلْخَاِلقُ وَانَا ٱلْمَخْلُوقُ"
  },
  {
   "segment_id": 108,
   "arabic": "وَانتَ ٱلْمَاِلكُ وَانَا ٱلْمَمْلُوكُ"
  },
  {
   "segment_id": 109,
   "arabic": "وَانتَ ٱلرَّبُّ وَانَا ٱلْعَبْدُ"
  },
  {
   "segment_id": 110,
   "arabic": "وَانتَ ٱلرَّازِقُ وَانَا ٱلْمَرْزُوقُ"
  },
  {
   "segment_id": 111,
   "arabic": "وَانتَ ٱلْمُعْطِي وَانَا ٱلسَّائِلُ"
  },
  {
   "segment_id": 112,
   "arabic": "وَانتَ ٱلْجَوَادُ وَانَا ٱلْبَخِيلُ"
  },
  {
   "segment_id": 113,
   "arabic": "وَانتَ ٱلْقَوِيُّ وَانَا ٱلضَّعِيفُ"
  },
  {
   "segment_id": 114,
   "arabic": "وَانتَ ٱلْعَزِيزُ وَانَا ٱلذَّلِيلُ"
  },
  {
   "segment_id": 115,
   "arabic": "وَانتَ ٱلْغَنِيُّ وَانَا ٱلْفَقِيـرُ"
  },
  {
   "segment_id": 116,
   "arabic": "وَانتَ ٱلسَّيِّدُ وَانَا ٱلْعَبْدُ"
  },
  {
   "segment_id": 117,
   "arabic": "وَانتَ ٱلْغَافِرُ وَانَا ٱلْمُسِيْءُ"
  },
  {
   "segment_id": 118,
   "arabic": "وَانتَ ٱلْعَالِمُ وَانَا ٱلْجَاهِلُ"
  },
  {
   "segment_id": 119,
   "arabic": "وَانتَ ٱلْحَلِيمُ وَانَا ٱلْعَجُولُ"
  },
  {
   "segment_id": 120,
   "arabic": "وَانتَ ٱلرَّحْمٰنُ وَانَا ٱلْمَرْحُومُ"
  },
  {
   "segment_id": 121,
   "arabic": "وَانتَ ٱلْمُعَافِي وَانَا ٱلْمُبْتَلَىٰ"
  },
  {
   "segment_id": 122,
   "arabic": "وَانتَ ٱلْمُجِيبُ وَانَا ٱلْمُضْطَرُّ"
  },
  {
   "segment_id": 123,
   "arabic": "وَانَا اشْهَدُ بِانَّكَ انتَ ٱللَّهُ"
  },
  {
   "segment_id": 124,
   "arabic": "لاَ إِلٰهَ إِلاَّ انتَ"
  },
  {
   "segment_id": 125,
   "arabic": "ٱلْمُعْطِي عِبَادَكَ بِلاَ سُؤَالٍ"
  },
  {
   "segment_id": 126,
   "arabic": "وَاشْهَدُ بِانَّكَ انتَ ٱللَّهُ"
  },
  {
   "segment_id": 127,
   "arabic": "ٱلْوَاحِدُ ٱلاحَدُ ٱلْمُتَفَرِّدُ ٱلصَّمَدُ ٱلْفَرْدُ"
  },
  {
   "segment_id": 128,
   "arabic": "وَإِلَيْكَ ٱلْمَصِيرُ"
  },
  {
   "segment_id": 129,
   "arabic": "وَصَلَّىٰ ٱللَّهُ عَلَىٰ مُحَمَّدٍ وَاهْلِ بَيْتِهِ ٱلطَّيِّبِينَ ٱلطَّاهِرِينَ"
  },
  {
   "segment_id": 130,
   "arabic": "وَٱغْفِرْ لِي ذُنُوبِي"
  },
  {
   "segment_id": 131,
   "arabic": "وَٱسْتُرْ عَلَيَّ عُيُوبِي"
  },
  {
   "segment_id": 132,
   "arabic": "وَٱفْتَحْ لِي مِنْ لَدُنْكَ رَحْمَةً وَرِزْقاً وَاسِعاً"
  },
  {
   "segment_id": 133,
   "arabic": "يَا ارْحَمَ ٱلرَّاحِمِينَ"
  },
