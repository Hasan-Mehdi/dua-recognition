 "segments": [
  {
   "segment_id": 1,
   "arabic": "يَا رَبِّ يَا رَبِّ"
  },
  {
   "segment_id": 2,
   "arabic": "يَا رَبَّاهُ يَا رَبَّاهُ"
  },
  {
   "segment_id": 3,
   "arabic": "رَبِّ رَبِّ"
  },
  {
   "segment_id": 4,
   "arabic": "يَا اللَّهُ يَا اللَّهُ"
  },
  {
   "segment_id": 5,
   "arabic": "يَا حَيُّ يَا حَيُّ"
  },
  {
   "segment_id": 6,
   "arabic": "يَا رَحِيمُ يَا رَحِيمُ"
  },
  {
   "segment_id": 7,
   "arabic": "THEN Repeat seven times."
  },
  {
   "segment_id": 8,
   "arabic": "يَا رَحْمٰنُ يَا رَحْمٰنُ"
  },
  {
   "segment_id": 9,
   "arabic": "THEN Repeat seven times."
  },
  {
   "segment_id": 10,
   "arabic": "يَا ارْحَمَ ٱلرَّاحِمِينَ"
  }
 ]
