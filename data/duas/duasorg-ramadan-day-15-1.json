{
 "dua_id": "duasorg-ramadan-day-15-1",
 "dua_name_en": "Holy Prophet's Dua",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-day-15.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "الْحَنَّانُ أَنْتَ سَيِّدِي"
  },
  {
   "segment_id": 2,
   "arabic": "الْمَنَّانُ أَنْتَ مَوْلَايَ الْكَرِيمُ"
  },
  {
   "segment_id": 3,
   "arabic": "أَنْتَ سَيِّدِي الْغَفُورُ [الْعَفُوُّ] الرَّحِيمُ"
  },
  {
   "segment_id": 4,
   "arabic": "أَنْتَ مَوْلَايَ الْحَلِيمُ"
  },
  {
   "segment_id": 5,
   "arabic": "أَنْتَ سَيِّدِي الْوَهَّابُ أَنْتَ مَوْلَايَ الْعَزِيزُ"
  },
  {
   "segment_id": 6,
   "arabic": "أَنْتَ سَيِّدِي الْقَرِيبُ أَنْتَ مَوْلَايَ الْوَاحِدُ"
  },
  {
   "segment_id": 7,
   "arabic": "أَنْتَ سَيِّدِي الْقَاهِرُ أَنْتَ مَوْلَايَ الصَّمَدُ"
  },
  {
   "segment_id": 8,
   "arabic": "أَنْتَ سَيِّدِي الْعَزِيزُ أَنْتَ مَوْلَايَ الْبَارِي"
  },
  {
   "segment_id": 9,
   "arabic": "صَلِّ عَلَى مُحَمَّدٍ وَ آلِهِ"
  },
  {
   "segment_id": 10,
   "arabic": "وَ اغْفِرْ لِي وَ ارْحَمْنِي وَ تَجَاوَزْ عَنِّي"
  },
  {
   "segment_id": 11,
   "arabic": "إِنَّكَ أَنْتَ الْأَجَلُّ الْأَعْظَمُ"
  }
 ]
}