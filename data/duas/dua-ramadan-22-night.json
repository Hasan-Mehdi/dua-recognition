{
 "dua_id": "dua-ramadan-22-night",
 "dua_name_en": "Dua Night 22",
 "dua_name_ar": "",
 "source": "https://www.duaplayer.org/en/dua/ramadan-22-night",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "يَا سَالِخَ ٱلنَّهَارِ مِنَ ٱللَّيْلِ فَإِذَا نَحْنُ مُظْلِمُونَ"
  },
  {
   "segment_id": 4,
   "arabic": "وَمُجْرِيَ ٱلشَّمْسِ لِمُسْتَقَرِّهَا بِتَقْدِيرِكَ يَا عَزِيزُ يَا عَلِيمُ"
  },
  {
   "segment_id": 5,
   "arabic": "وَمُقَدِّرَ ٱلْقَمَرِ مَنَازِلَ حَتَّىٰ عَادَ كَٱلْعُرْجُونِ ٱلْقَدِيمِ"
  },
  {
   "segment_id": 6,
   "arabic": "يَا نُورَ كُلِّ نُورٍ"
  },
  {
   "segment_id": 7,
   "arabic": "وَمُنْتَهَىٰ كُلِّ رَغْبَةٍ"
  },
  {
   "segment_id": 8,
   "arabic": "وَوَلِيَّ كُلِّ نِعْمَةٍ"
  },
  {
   "segment_id": 9,
   "arabic": "يَا اللَّهُ يَا رَحْمٰنُ"
  },
  {
   "segment_id": 10,
   "arabic": "يَا اللَّهُ يَا قُدُّوسُ"
  },
  {
   "segment_id": 11,
   "arabic": "يَا احَدُ يَا وَاحِدُ يَا فَرْدُ"
  },
  {
   "segment_id": 12,
   "arabic": "يَا اللَّهُ يَا اللَّهُ يَا اللَّهُ"
  },
  {
   "segment_id": 13,
   "arabic": "لَكَ ٱلاسْمَاءُ ٱلْحُسْنَىٰ"
  },
  {
   "segment_id": 14,
   "arabic": "وَٱلامْثَالُ ٱلْعُلْيَا"
  },
  {
   "segment_id": 15,
   "arabic": "وَٱلْكِبْرِيَاءُ وَٱلآلاَءُ"
  },
  {
   "segment_id": 16,
   "arabic": "اسْالُكَ انْ تُصَلِّيَ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 17,
   "arabic": "وَانْ تَجْعَلَ ٱسْمِي فِي هٰذِهِ ٱللَّيْلَةِ فِي ٱلسُّعَدَاءِ"
  },
  {
   "segment_id": 18,
   "arabic": "وَرُوحِي مَعَ ٱلشُّهَدَاءِ"
  },
  {
   "segment_id": 19,
   "arabic": "وَإِحْسَانِي فِي عِلِّيِّينَ"
  },
  {
   "segment_id": 20,
   "arabic": "وَإِسَاءَتِي مَغْفُورَةً"
  },
  {
   "segment_id": 21,
   "arabic": "وَانْ تَهَبَ لِي يَقِيناً تُبَاشِرُ بِهِ قَلْبِي"
  },
  {
   "segment_id": 22,
   "arabic": "وَإِيـمَاناً يُذْهِبُ ٱلشَّكَّ عَنِّي"
  },
  {
   "segment_id": 23,
   "arabic": "وَتُرْضِيَنِي بِمَا قَسَمْتَ لِي"
  },
  {
   "segment_id": 24,
   "arabic": "وَآتِنَا فِي ٱلدُّنْيَا حَسَنَةً"
  },
  {
   "segment_id": 25,
   "arabic": "وَفِي ٱلآخِرَةِ حَسَنَةً"
  },
  {
   "segment_id": 26,
   "arabic": "وَقِنَا عَذَابَ ٱلنَّارِ ٱلْحَرِيقِ"
  },
  {
   "segment_id": 27,
   "arabic": "وَٱرْزُقْنِي فِيهَا ذِكْرَكَ وَشُكْرَكَ وَٱلرَّغْبَةَ إِلَيْكَ"
  },
  {
   "segment_id": 28,
   "arabic": "وَالإِنَابَةَ وَالتَّوْفِيقَ لِمَا وَفَّقْتَ لَهُ مُحَمَّداً وَآلَ مُحَمَّدٍ عَلَيْهِ وَعَلَيْهِمُ ٱلسَّلاَمُ"
  }
 ]
}