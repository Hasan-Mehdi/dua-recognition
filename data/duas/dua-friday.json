{
 "dua_id": "dua-friday",
 "dua_name_en": "Dua Jummah",
 "dua_name_ar": "دعاء الجمعة",
 "source": "https://www.duaplayer.org/en/dua/friday",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمٰنِ ٱلرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "الْحَمْدُ لِلَّهِ ٱلاوَّلِ قَبْلَ ٱلإِنْشَاءِ وَٱلإِحْيَاءِ"
  },
  {
   "segment_id": 3,
   "arabic": "وَٱلآخِرِ بَعْدَ فَنَاءِ ٱلاشْيَاءِ"
  },
  {
   "segment_id": 4,
   "arabic": "ٱلْعَلِيمِ ٱلَّذِي لاَ يَنْسَىٰ مَنْ ذَكَرَهُ"
  },
  {
   "segment_id": 5,
   "arabic": "وَلاَ يَنْقُصُ مَنْ شَكَرَهُ"
  },
  {
   "segment_id": 6,
   "arabic": "وَلاَ يُخَيِّبُ مَنْ دَعَاهُ"
  },
  {
   "segment_id": 7,
   "arabic": "وَلاَ يَقْطَعُ رَجَاءَ مَنْ رَجَاهُ"
  },
  {
   "segment_id": 8,
   "arabic": "اَللَّهُمَّ إِنِّي اشْهِدُكَ"
  },
  {
   "segment_id": 9,
   "arabic": "وَكَفَىٰ بِكَ شَهيداً"
  },
  {
   "segment_id": 10,
   "arabic": "وَاشْهِدُ جَمِيعَ مَلائِكَتِكَ"
  },
  {
   "segment_id": 11,
   "arabic": "وَسُكَّانَ سَموَاتِكَ"
  },
  {
   "segment_id": 12,
   "arabic": "وَحَمَلَةَ عَرْشِكَ"
  },
  {
   "segment_id": 13,
   "arabic": "وَمَنْ بَعَثْتَ مِنْ انْبيَائِكَ وَرُسُلِكَ"
  },
  {
   "segment_id": 14,
   "arabic": "وَ انْشَاْتَ مِنْ اصْنَافِ خَلْقِكَ"
  },
  {
   "segment_id": 15,
   "arabic": "انِّي اشْهَدُ انَّكَ انْتَ ٱللَّهُ"
  },
  {
   "segment_id": 16,
   "arabic": "لاَ إِلٰهَ إِلاَّ انْتَ وَحْدَكَ"
  },
  {
   "segment_id": 17,
   "arabic": "لاَ شَرِيكَ لَكَ وَلاَ عَدِيلَ"
  },
  {
   "segment_id": 18,
   "arabic": "وَلاَ خُلْفَ لِقَوْلِكَ وَلاَ تَبْدِيلَ"
  },
  {
   "segment_id": 19,
   "arabic": "وَ انَّ مُحَمَّداً صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ عَبْدُكَ وَرَسُولُكَ"
  },
  {
   "segment_id": 20,
   "arabic": "ادَّىٰ مَا حَمَّلْتَهُ إِلَىٰ ٱلْعِبَادِ"
  },
  {
   "segment_id": 21,
   "arabic": "وَجَاهَدَ فِي ٱللَّهِ عَزَّ وَجَلَّ حَقَّ ٱلْجِهَادِ"
  },
  {
   "segment_id": 22,
   "arabic": "وَ انَّهُ بَشَّرَ بِما هُوَ حَقُّ مِنَ ٱلثَّوابِ"
  },
  {
   "segment_id": 23,
   "arabic": "وَ انْذَرَ بِما هُوَ صِدْقٌ مِنَ ٱلعِقَابِ"
  },
  {
   "segment_id": 24,
   "arabic": "اَللَّهُمَّ ثَبِّتْنِي عَلَىٰ دِينِكَ مَا احْيَيْتَنِي"
  },
  {
   "segment_id": 25,
   "arabic": "وَلاَ تُزِغْ قَلْبِي بَعْدَ إِذْ هَدَيْتَنِي"
  },
  {
   "segment_id": 26,
   "arabic": "وَهَبْ لِي مِنْ لَدُنْكَ رَحْمَةً"
  },
  {
   "segment_id": 27,
   "arabic": "إِنَّكَ انْتَ ٱلْوَهَّابُ"
  },
  {
   "segment_id": 28,
   "arabic": "صَلِّ عَلَىٰ مُحَمَّدٍ وآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 29,
   "arabic": "وَٱجْعَلْنِي مِنْ اتْبَاعِهِ وَشِيعَتِهِ"
  },
  {
   "segment_id": 30,
   "arabic": "وَٱحْشُرْنِي فِي زُمْرَتِهِ"
  },
  {
   "segment_id": 31,
   "arabic": "وَوَفِّقْنِي لادَاءِ فَرْضِ ٱلْجُمُعَاتِ"
  },
  {
   "segment_id": 32,
   "arabic": "وَمَا اوْجَبْتَ عَلَيَّ فِيهَا مِنَ ٱلطَّاعَاتِ"
  },
  {
   "segment_id": 33,
   "arabic": "وَقَسَمْتَ لاهْلِهَا مِنَ ٱلعَطَاءِ"
  },
  {
   "segment_id": 34,
   "arabic": "فِي يَوْمِ ٱلْجزَاءِ"
  },
  {
   "segment_id": 35,
   "arabic": "إِنَّكَ انْتَ ٱلْعَزِيزُ ٱلْحَكِيمُ"
  }
 ]
}