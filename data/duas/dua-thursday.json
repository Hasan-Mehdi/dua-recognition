{
 "dua_id": "dua-thursday",
 "dua_name_en": "Dua al-Khamis",
 "dua_name_ar": "دعاء الخميس",
 "source": "https://www.duaplayer.org/en/dua/thursday",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمٰنِ ٱلرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَلْحَمْدُ لِلَّهِ ٱلَّذِي اذْهَبَ ٱللَّيْلَ مُظْلِماً بِقُدْرَتِهِ"
  },
  {
   "segment_id": 3,
   "arabic": "وَجَاءَ بِٱلنَّهَارِ مُبْصِراً بِرَحْمَتِهِ"
  },
  {
   "segment_id": 4,
   "arabic": "وَكَسَانِي ضِيَاءَهُ وَآتَانِي نِعْمَتَهُ"
  },
  {
   "segment_id": 5,
   "arabic": "اللَّهُمَّ فَكَمَا ابْقَيْتَنِي لَهُ فَ ابْقِنِي لامْثَالِهِ"
  },
  {
   "segment_id": 6,
   "arabic": "وَصَلِّ عَلَىٰ ٱلنَّبِيِّ مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 7,
   "arabic": "وَلاَ تَفْجَعْنِي فِيهِ وَفِي غَيْرِهِ"
  },
  {
   "segment_id": 8,
   "arabic": "مِنَ ٱللَّيَالِي وَٱلايَّامِ"
  },
  {
   "segment_id": 9,
   "arabic": "بِٱرْتِكَابِ ٱلْمَحَارِمِ"
  },
  {
   "segment_id": 10,
   "arabic": "وَٱكْتِسَابِ ٱلْمَآثِمِ"
  },
  {
   "segment_id": 11,
   "arabic": "وَٱرْزُقْنِي خَيْرَهُ"
  },
  {
   "segment_id": 12,
   "arabic": "وَخَيْرَ مَا فِيهِ"
  },
  {
   "segment_id": 13,
   "arabic": "وَخَيْرَ مَا بَعْدَهُ"
  },
  {
   "segment_id": 14,
   "arabic": "وَٱصْرِفْ عَنِّي شَرَّهُ"
  },
  {
   "segment_id": 15,
   "arabic": "وَشَرَّ مَا فِيهِ"
  },
  {
   "segment_id": 16,
   "arabic": "وَشَرَّ مَا بَعْدَهُ"
  },
  {
   "segment_id": 17,
   "arabic": "اَللَّهُمَّ إِنِّي بِذِمَّةِ ٱلإِسْلامِ اتَوَسَّلُ إِلَيْكَ"
  },
  {
   "segment_id": 18,
   "arabic": "وَبِحُرْمَةِ ٱلْقُرآنِ اعْتَمِدُ عَلَيْكَ"
  },
  {
   "segment_id": 19,
   "arabic": "وَبِمُحَمَّدٍ ٱلْمُصْطَفَىٰ"
  },
  {
   "segment_id": 20,
   "arabic": "صَلَّىٰ ٱللَّهُ عَلَيْه وَآلِهِ"
  },
  {
   "segment_id": 21,
   "arabic": "اسْتَشْفِعُ لَدَيْكَ"
  },
  {
   "segment_id": 22,
   "arabic": "فَٱعْرِفِ ٱللَّهُمَّ ذِمَّتِي"
  },
  {
   "segment_id": 23,
   "arabic": "ٱلَّتِي رَجَوْتُ بِهَا قَضَاءَ حَاجَتِي"
  },
  {
   "segment_id": 24,
   "arabic": "يَا ارْحَمَ ٱلرَّاحِمِينَ"
  },
  {
   "segment_id": 25,
   "arabic": "اَللَّهُمَّ ٱقْضِ لِي فِي ٱلْخَمِيسِ خَمْساً"
  },
  {
   "segment_id": 26,
   "arabic": "لاَ يَتَّسِعُ لَهَا إِلاَّ كَرَمُكَ"
  },
  {
   "segment_id": 27,
   "arabic": "وَلاَ يُطِيقُهَا إِلاَّ نِعَمُكَ"
  },
  {
   "segment_id": 28,
   "arabic": "سَلامَةً اقْوَىٰ بِهَا عَلَىٰ طَاعَتِكَ"
  },
  {
   "segment_id": 29,
   "arabic": "وَعِبَادَةً اسْتَحِقُّ بِهَا جَزِيلَ مَثُوبَتِكَ"
  },
  {
   "segment_id": 30,
   "arabic": "وَسَعَةً فِي ٱلْحَالِ مِنَ ٱلرِّزْقِ ٱلْحَلالِ"
  },
  {
   "segment_id": 31,
   "arabic": "وَ انْ تُؤْمِنَنِي فِي مَوَاقِفِ ٱلْخَوْفِ بِامْنِكَ"
  },
  {
   "segment_id": 32,
   "arabic": "وَتَجْعَلَنِي مِنْ طَوَارِقِ ٱلْهُمُومِ وَٱلْغُمُومِ فِي حِصْنِكَ"
  },
  {
   "segment_id": 33,
   "arabic": "صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 34,
   "arabic": "وَٱجْعَلْ تَوَسُّلِي بِهِ شَافِعاً"
  },
  {
   "segment_id": 35,
   "arabic": "يَوْمَ ٱلْقِيَامَةِ نَافِعاً"
  },
  {
   "segment_id": 36,
   "arabic": "إِنَّكَ انْتَ ارْحَمُ ٱلرَّاحِمِينَ"
  }
 ]
}