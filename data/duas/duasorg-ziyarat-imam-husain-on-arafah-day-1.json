{
 "dua_id": "duasorg-ziyarat-imam-husain-on-arafah-day-1",
 "dua_name_en": "Ziyarat of Imam Husain(as) on the Day of Arafah",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ziyarat-imam-husain-on-arafah-day.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللَّهُ أَكْبَرُ كَبِيراً"
  },
  {
   "segment_id": 2,
   "arabic": "وَٱلْحَمْدُ لِلَّهِ كَثِيراً"
  },
  {
   "segment_id": 3,
   "arabic": "وَسُبْحَانَ ٱللَّهِ بُكْرَةً وَأَصِيلاً"
  },
  {
   "segment_id": 4,
   "arabic": "وَٱلْحَمْدُ لِلَّهِ ٱلَّذِي هَدَانَا لِهٰذَا"
  },
  {
   "segment_id": 5,
   "arabic": "وَمَا كُنَّا لِنَهْتَدِيَ لَوْلاَ أَنْ هَدَانَا ٱللَّهُ"
  },
  {
   "segment_id": 6,
   "arabic": "لَقَدْ جَاءَتْ رُسُلُ رَبِّنَا بِٱلْحَقِّ"
  },
  {
   "segment_id": 7,
   "arabic": "السَّلاَمُ عَلَىٰ رَسُولِ ٱللَّهِ صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ"
  },
  {
   "segment_id": 8,
   "arabic": "السَّلاَمُ عَلَىٰ أَمِيرِ ٱلْمُؤْمِنِينَ"
  },
  {
   "segment_id": 9,
   "arabic": "السَّلاَمُ عَلَىٰ فَاطِمَةَ ٱلزَّهْرَاءِ سَيِّدَةِ نِسَاءِ ٱلْعَالَمِينَ"
  },
  {
   "segment_id": 10,
   "arabic": "السَّلاَمُ عَلَىٰ ٱلْحَسَنِ وَٱلْحُسَيْنِ"
  },
  {
   "segment_id": 11,
   "arabic": "السَّلاَمُ عَلَىٰ عَلِيِّ بْنِ ٱلْحُسَيْنِ"
  },
  {
   "segment_id": 12,
   "arabic": "السَّلاَمُ عَلَىٰ مُحَمَّدِ بْنِ عَلِيٍّ"
  },
  {
   "segment_id": 13,
   "arabic": "السَّلاَمُ عَلَىٰ جَعْفَرِ بْنِ مُحَمَّدٍ"
  },
  {
   "segment_id": 14,
   "arabic": "السَّلاَمُ عَلَىٰ مُوسَىٰ بْنِ جَعْفَرٍ"
  },
  {
   "segment_id": 15,
   "arabic": "السَّلاَمُ عَلَىٰ عَلِيِّ بْنِ مُوسَىٰ"
  },
  {
   "segment_id": 16,
   "arabic": "السَّلاَمُ عَلَىٰ مُحَمَّدِ بْنِ عَلِيٍّ"
  },
  {
   "segment_id": 17,
   "arabic": "السَّلاَمُ عَلَىٰ عَلِيِّ بْنِ مُحَمَّدٍ"
  },
  {
   "segment_id": 18,
   "arabic": "السَّلاَمُ عَلَىٰ ٱلْحَسَنِ بْنِ عَلِيٍّ"
  },
  {
   "segment_id": 19,
   "arabic": "السَّلاَمُ عَلَىٰ ٱلْخَلَفِ ٱلصَّالِحِ ٱلْمُنْتَظَرِ"
  },
  {
   "segment_id": 20,
   "arabic": "السَّلاَمُ عَلَيْكَ يَا أَبَا عَبْدِ ٱللَّهِ"
  },
  {
   "segment_id": 21,
   "arabic": "السَّلاَمُ عَلَيْكَ يَا بْنَ رَسُولِ ٱللَّهِ"
  },
  {
   "segment_id": 22,
   "arabic": "عَبْدُكَ وَٱبْنُ عَبْدِكَ وَٱبْنُ أَمَتِكَ"
  },
  {
   "segment_id": 23,
   "arabic": "ٱلْمُوَالِي لِوَلِيِّكَ"
  },
  {
   "segment_id": 24,
   "arabic": "ٱلْمُعَادِي لِعَدُوِّكَ"
  },
  {
   "segment_id": 25,
   "arabic": "ٱسْتَجَارَ بِمَشْهَدِكَ"
  },
  {
   "segment_id": 26,
   "arabic": "وَتَقَرَّبَ إِلَىٰ ٱللَّهِ بِقَصْدِكَ"
  },
  {
   "segment_id": 27,
   "arabic": "الْحَمْدُ لِلَّهِ ٱلَّذِي هَدَانِي لِوِلايَتِكَ"
  },
  {
   "segment_id": 28,
   "arabic": "وَخَصَّنِي بِزِيَارَتِكَ"
  },
  {
   "segment_id": 29,
   "arabic": "وَسَهَّلَ لِي قَصْدَكَ"
  }
 ]
}