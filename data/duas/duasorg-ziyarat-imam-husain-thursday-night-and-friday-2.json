{
 "dua_id": "duasorg-ziyarat-imam-husain-thursday-night-and-friday-2",
 "dua_name_en": "Ziyarat of Imam Husain on Thursday Night and Friday · As-salāmu ‘alayka yā mawlāya…",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ziyarat-imam-husain-thursday-night-and-friday.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "السَّلامُ عَلَيْكَ يَا مَوْلايَ وَسَيِّدِي وَابْنَ سَيِّدِي ،"
  },
  {
   "segment_id": 2,
   "arabic": "السَّلامُ عَلَيْكَ يَا مَوْلايَ وَابْنَ مَوْلايَ ،"
  },
  {
   "segment_id": 3,
   "arabic": "يَا قَتِيلَ بْنَ الْقَتِيلِ ،"
  },
  {
   "segment_id": 4,
   "arabic": "الشَّهِيدَ بْنَ الشَّهِيدِ ،"
  },
  {
   "segment_id": 5,
   "arabic": "السَّلامُ عَلَيْكَ وَرَحْمَةُ اللّهِ وَبَرَكَاتُهُ ،"
  },
  {
   "segment_id": 6,
   "arabic": "أَنَا زَائِرُكَ يَابْنَ رَسُولِ اللّهِ ،"
  },
  {
   "segment_id": 7,
   "arabic": "بِقَلْبِي وَلِسانِي وَجَوَارِحِي ،"
  },
  {
   "segment_id": 8,
   "arabic": "وَإِنْ لَمْ أَزُرْكَ بِنَفْسِي وَالْمُشَاهَدَةِ لِقُبَّتِكَ ،"
  },
  {
   "segment_id": 9,
   "arabic": "السَّلامُ عَلَيْكَ يَا وَارِثَ آدَمَ صَفْوَةِ اللّهِ ،"
  },
  {
   "segment_id": 10,
   "arabic": "وَوارِثَ نُوحٍ نَبِيِّ اللّهِ ،"
  },
  {
   "segment_id": 11,
   "arabic": "وَوارِثَ إِبْرَاهِيمَ خَلِيلِ اللّهِ ،"
  },
  {
   "segment_id": 12,
   "arabic": "وَوارِثَ مُوسى كَلِيمِ اللّهِ ،"
  },
  {
   "segment_id": 13,
   "arabic": "وَوارِثَ عِيسى رُوحِ اللّهِ ،"
  },
  {
   "segment_id": 14,
   "arabic": "وَوارِثَ مُحَمَّدٍ حَبِيبِ اللّهِ وَنَبِيِّهِ وَرَسُولِهِ ،"
  },
  {
   "segment_id": 15,
   "arabic": "وَوارِثَ عَلِيٍّ أَمِيرِ الْمُؤْمِنِينَ ،"
  },
  {
   "segment_id": 16,
   "arabic": "وَوَصِيِّ رَسُولِ اللّهِ وَخَلِيفَتِهِ ،"
  },
  {
   "segment_id": 17,
   "arabic": "وَوَارِثَ الْحَسَنِ بْنِ عَلِيٍّ وَصِيِّ أَمِيرِ الْمُؤْمِنِينَ ،"
  },
  {
   "segment_id": 18,
   "arabic": "لَعَنَ اللّهُ قَاتِلَكَ وَجَدَّدَ عَلَيْهِمُ الْعَذَابَ فِي هذِهِ السَّاعَةِ وَفِي كُلِّ سَاعَةٍ ،"
  },
  {
   "segment_id": 19,
   "arabic": "أَنَا يَا سَيِّدِي مُتَقَرِّبٌ إِلى اللّهِ تَعَالى ،"
  },
  {
   "segment_id": 20,
   "arabic": "وَاِلى جَدِّكَ رَسُولِ اللّهِ ،"
  },
  {
   "segment_id": 21,
   "arabic": "وَإِلى أَبِيكَ أَمِيرِ الْمُؤْمِنِينَ ،"
  },
  {
   "segment_id": 22,
   "arabic": "وَإِلى أَخِيكَ الْحَسَنِ ،"
  },
  {
   "segment_id": 23,
   "arabic": "وَإِلَيْكَ يَا مَوْلايَ ،"
  },
  {
   "segment_id": 24,
   "arabic": "عَلَيْكَ سَلامُ اللّهُ وَرَحْمَتُهُ ،"
  },
  {
   "segment_id": 25,
   "arabic": "بِزِيَارَتِي لَكَ بِقَلْبِي وَلِسَانِي وَجَمِيعِ جَوَارِحِي ،"
  },
  {
   "segment_id": 26,
   "arabic": "فَكُنْ يَا سَيِّدِي شَفِيعِي لِقَبُولِ ذلِكَ مِنّي ،"
  },
  {
   "segment_id": 27,
   "arabic": "وَأَنَا بِالْبَرَاءَةِ مِنْ أَعْدَائِكَ وَاللَّعْنَةِ لَهُمْ وَعَلَيْهِمْ ،"
  },
  {
   "segment_id": 28,
   "arabic": "أَتَقَرَّبُ بِذلِكَ إِلى اللّهِ تَعَالى وَإِلَيْكُمْ أَجْمَعِينَ ،"
  },
  {
   "segment_id": 29,
   "arabic": "فَعَلَيْكَ صَلَوَاتُ اللّهِ وَرِضْوَانُهُ وَرَحْمَتُهُ ."
  }
 ]
}