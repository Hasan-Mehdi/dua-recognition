{
 "dua_id": "duasorg-sahifa-fatimiya-dua-3rd-of-every-month",
 "dua_name_en": "Dua of Sayeda Fatima (sa) on 3rd day of every month",
 "dua_name_ar": "",
 "source": "https://www.duas.org/sahifa-fatimiya-dua-3rd-of-every-month.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "سُبْحَانَ مَنِ اسْتَنَارَ بِالْحَوْلِ وَ الْقُوَّةِ"
  },
  {
   "segment_id": 2,
   "arabic": "سُبْحَانَ مَنِ احْتَجَبَ فِيْ سَبْعِ سَمَاوَاتٍ"
  },
  {
   "segment_id": 3,
   "arabic": "فَلَا عَيْنُ تَرَاهُ"
  },
  {
   "segment_id": 4,
   "arabic": "سُبْحَانَ مَنْ اَذَلَّ الْخَلَائِقَ بِالْمَوْتِ"
  },
  {
   "segment_id": 5,
   "arabic": "وَ اَعَزَّ نَفْسَهٗ بِالْحَيَاةِ"
  },
  {
   "segment_id": 6,
   "arabic": "سُبْحَانَ مَنْ يَبْقٰى وَ يَفْنٰى كُلُّ شَيْ‏ءٍ سِوَاهُ"
  },
  {
   "segment_id": 7,
   "arabic": "سُبْحَانَ مَنِ اسْتَخْلَصَ الْحَمْدَ لِنَفْسِهٖ وَ ارْتَضَاهُ"
  },
  {
   "segment_id": 8,
   "arabic": "سُبْحَانَ الْحَيِّ الْعَلِيْمِ"
  },
  {
   "segment_id": 9,
   "arabic": "سُبْحَانَ الْحَلِيْمِ الْكَرِيْمِ"
  },
  {
   "segment_id": 10,
   "arabic": "سُبْحَانَ الْمَلِكِ الْقُدُّوْسِ"
  },
  {
   "segment_id": 11,
   "arabic": "سُبْحَانَ [الْعَلِيِّ‏] الْعَظِيْمِ"
  },
  {
   "segment_id": 12,
   "arabic": "سُبْحَانَ اللهِ وَ بِحَمْدِهٖ‏"
  }
 ]
}