{
 "dua_id": "duasorg-ramadan-shaaban-dua-first-night",
 "dua_name_en": "Dua on Last night Shaaban - 1st eve of Ramadan",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-shaaban-dua-first-night.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللَّهُمَّ إِنَّ هٰذَا ٱلشَّهْرَ ٱلْمُبَارَكَ"
  },
  {
   "segment_id": 2,
   "arabic": "ٱلَّذِي أُنْزِلَ فِيهِ ٱلْقُرْآنُ"
  },
  {
   "segment_id": 3,
   "arabic": "وَجُعِلَ هُدَىً لِلنَّاسِ"
  },
  {
   "segment_id": 4,
   "arabic": "وَبَيِّنَاتٍ مِنَ ٱلْهُدَىٰ وَٱلْفُرْقَانِ"
  },
  {
   "segment_id": 5,
   "arabic": "قَدْ حَضَرَ"
  },
  {
   "segment_id": 6,
   "arabic": "فَسَلِّمْنَا فِيهِ"
  },
  {
   "segment_id": 7,
   "arabic": "وَسَلَّمْهُ لَنَا"
  },
  {
   "segment_id": 8,
   "arabic": "وَتَسَلَّمْهُ مِنَّا فِي يُسْرٍ مِنْكَ وَعَافِيَةٍ"
  },
  {
   "segment_id": 9,
   "arabic": "يَا مَنْ أَخَذَ ٱلْقَلِيلَ وَشَكَرَ ٱلْكَثِيرَ"
  },
  {
   "segment_id": 10,
   "arabic": "ٱقْبَلْ مِنِّي ٱلْيَسِيرَ"
  },
  {
   "segment_id": 11,
   "arabic": "اَللَّهُمَّ إِنِّي أَسْأَلُكَ"
  },
  {
   "segment_id": 12,
   "arabic": "أَنْ تَجْعَلَ لِي إِلَىٰ كُلِّ خَيْرٍ سَبِيلاً"
  },
  {
   "segment_id": 13,
   "arabic": "وَمِنْ كُلِّ مَا لاَ تُحِبُّ مَانِعاً"
  },
  {
   "segment_id": 14,
   "arabic": "يَا أَرْحَمَ ٱلرَّاحِمِينَ"
  },
  {
   "segment_id": 15,
   "arabic": "يَا مَنْ عَفَا عَنِّي وَعَمَّا خَلَوْتُ بِهِ مِنَ ٱلسَّيِّئَاتِ"
  },
  {
   "segment_id": 16,
   "arabic": "يَا مَنْ لَمْ يُؤَاخِذْنِي بِٱرْتِكَابِ ٱلْمَعَاصِي"
  },
  {
   "segment_id": 17,
   "arabic": "عَفْوَكَ عَفْوَكَ عَفْوَكَ يَا كَرِيمُ"
  },
  {
   "segment_id": 18,
   "arabic": "إِلٰهِي وَعَظْتَنِي فَلَمْ أَتَّعِظْ"
  },
  {
   "segment_id": 19,
   "arabic": "وَزَجَرْتَنِي عَنْ مَحَارِمِكَ فَلَمْ أَنْزَجِرْ"
  },
  {
   "segment_id": 20,
   "arabic": "فَمَا عُذْرِي"
  },
  {
   "segment_id": 21,
   "arabic": "فَٱعْفُ عَنِّي يَا كَرِيمُ"
  },
  {
   "segment_id": 22,
   "arabic": "عَفْوَكَ عَفْوَكَ"
  },
  {
   "segment_id": 23,
   "arabic": "اَللَّهُمَّ إِنّي أَسْأَلُكَ"
  },
  {
   "segment_id": 24,
   "arabic": "ٱلرَّاحَةَ عِنْدَ ٱلْمَوْتِ"
  },
  {
   "segment_id": 25,
   "arabic": "وَٱلْعَفْوَ عِنْدَ ٱلْحِسَابِ"
  },
  {
   "segment_id": 26,
   "arabic": "عَظُمَ ٱلذَّنْبُ مِنْ عَبْدِكَ"
  },
  {
   "segment_id": 27,
   "arabic": "فَلْيَحْسُنِ ٱلتَّجَاوُزُ مِنْ عِنْدِكَ"
  },
  {
   "segment_id": 28,
   "arabic": "يَا أَهْلَ ٱلتَّقْوَىٰ وَيَا أَهْلَ ٱلْمَغْفِرَةِ"
  },
  {
   "segment_id": 29,
   "arabic": "عَفْوَكَ عَفْوَكَ"
  },
  {
   "segment_id": 30,
   "arabic": "اَللَّهُمَّ إِنِّي عَبْدُكَ ٱبْنُ عَبْدِكَ ٱبْنُ أَمَتِكَ"
  },
  {
   "segment_id": 31,
   "arabic": "ضَعِيفٌ فَقِيرٌ إِلَىٰ رَحْمَتِكَ"
  },
  {
   "segment_id": 32,
   "arabic": "وَأَنْتَ مُنْزِلُ ٱلْغِنَىٰ وَٱلْبَرَكَةِ عَلَىٰ ٱلْعِبَادِ"
  },
  {
   "segment_id": 33,
   "arabic": "قَاهِرٌ مُقْتَدِرٌ"
  },
  {
   "segment_id": 34,
   "arabic": "أَحْصَيْتَ أَعْمَالَهُمْ"
  },
  {
   "segment_id": 35,
   "arabic": "وَقَسَمْتَ أَرْزَاقَهُمْ"
  },
  {
   "segment_id": 36,
   "arabic": "وَجَعَلْتَهُمْ مُخْتَلِفَةً أَلْسِنَتُهُمْ وَأَلْوَانُهُمْ"
  },
  {
   "segment_id": 37,
   "arabic": "خَلْقاً مِنْ بَعْدِ خَلْقٍ"
  },
  {
   "segment_id": 38,
   "arabic": "وَلاَ يَعْلَمُ ٱلْعِبَادُ عِلْمَكَ"
  },
  {
   "segment_id": 39,
   "arabic": "وَلاَ يَقْدِرُ ٱلْعِبَادُ قَدْرَكَ"
  },
  {
   "segment_id": 40,
   "arabic": "وَكُلُّنَا فَقِيرٌ إِلَىٰ رَحْمَتِكَ"
  },
  {
   "segment_id": 41,
   "arabic": "فَلاَ تَصْرِفْ عَنِّي وَجْهَكَ"
  },
  {
   "segment_id": 42,
   "arabic": "وَٱجْعَلْنِي مِنْ صَالِحِي خَلْقِكَ"
  },
  {
   "segment_id": 43,
   "arabic": "فِي ٱلْعَمَلِ وَٱلأَمَلِ"
  },
  {
   "segment_id": 44,
   "arabic": "وَٱلْقَضَاءِ وَٱلْقَدَرِ"
  },
  {
   "segment_id": 45,
   "arabic": "اَللَّهُمَّ أَبْقِنِي خَيْرَ ٱلْبَقَاءِ"
  },
  {
   "segment_id": 46,
   "arabic": "وَأَفْنِنِي خَيْرَ ٱلْفَنَاءِ عَلَىٰ مُوَالاةِ أَوْلِيَائِكَ"
  },
  {
   "segment_id": 47,
   "arabic": "وَمُعَادَاةِ أَعْدَائِكَ"
  },
  {
   "segment_id": 48,
   "arabic": "وَٱلرَّغْبَةِ إِلَيْكَ وَٱلرَّهْبَةِ مِنْكَ"
  },
  {
   "segment_id": 49,
   "arabic": "وَٱلْخُشُوعِ وَٱلْوَفَاءِ وَٱلتَّسْلِيمِ لَكَ"
  },
  {
   "segment_id": 50,
   "arabic": "وَٱلتَّصْدِيقِ بِكِتَابِكَ"
  },
  {
   "segment_id": 51,
   "arabic": "وَٱتِّبَاعِ سُنَّةِ رَسُولِكَ"
  },
  {
   "segment_id": 52,
   "arabic": "اَللَّهُمَّ مَا كَانَ فِي قَلْبِي"
  },
  {
   "segment_id": 53,
   "arabic": "مِنْ شَكٍّ أَوْ رِيبَةٍ"
  },
  {
   "segment_id": 54,
   "arabic": "أَوْ جُحُودٍ أَوْ قُنُوطٍ"
  },
  {
   "segment_id": 55,
   "arabic": "أَوْ فَرَحٍ أَوْ بَذَخٍ أَوْ بَطَرٍ"
  },
  {
   "segment_id": 56,
   "arabic": "أَوْ خُيَلاءَ أَوْ رِيَاءٍ أَوْ سُمْعَةٍ"
  },
  {
   "segment_id": 57,
   "arabic": "أَوْ شِقَاقٍ أَوْ نِفَاقٍ"
  },
  {
   "segment_id": 58,
   "arabic": "أَوْ كُفْرٍ أَوْ فُسُوقٍ أَوْ عِصْيَانٍ"
  },
  {
   "segment_id": 59,
   "arabic": "أَوْ عَظَمَةٍ أَوْ شَيْءٍ لاَ تُحِبُّ"
  },
  {
   "segment_id": 60,
   "arabic": "فَأَسْأَلُكَ يَا رَبِّ أَنْ تُبَدِّلَنِي مَكَانَهُ إِيـمَاناً بِوَعْدِكَ"
  },
  {
   "segment_id": 61,
   "arabic": "وَوَفَاءً بِعَهْدِكَ"
  },
  {
   "segment_id": 62,
   "arabic": "وَرِضاً بِقَضَائِكَ"
  },
  {
   "segment_id": 63,
   "arabic": "وَزُهْداً فِي ٱلدُّنْيَا"
  },
  {
   "segment_id": 64,
   "arabic": "وَرَغْبَةً فِيمَا عِنْدَكَ"
  },
  {
   "segment_id": 65,
   "arabic": "وَأَثَرَةً وَطُمَأْنِينَةً"
  },
  {
   "segment_id": 66,
   "arabic": "وَتَوْبَةً نَصُوحاً"
  },
  {
   "segment_id": 67,
   "arabic": "أَسْأَلُكَ ذٰلِكَ يَا رَبَّ ٱلْعَالَمِينَ"
  },
  {
   "segment_id": 68,
   "arabic": "إِلٰهِي أَنْتَ مِنْ حِلْمِكَ تُعْصَىٰ فَكَأَنَّكَ لَمْ تُرَ"
  },
  {
   "segment_id": 69,
   "arabic": "وَمِنْ كَرَمِكَ وَجُودِكَ تُطَاعُ فَكَأَنَّكَ لَمْ تُعْصَ"
  },
  {
   "segment_id": 70,
   "arabic": "وَأَنَا وَمَنْ لَمْ يَعْصِكَ سُكَّانُ أَرْضِكَ"
  },
  {
   "segment_id": 71,
   "arabic": "فَكُنْ عَلَيْنَا بِٱلْفَضْلِ جَوَاداً"
  },
  {
   "segment_id": 72,
   "arabic": "وَبِٱلْخَيْرِ عَوَّاداً"
  },
  {
   "segment_id": 73,
   "arabic": "يَا أَرْحَمَ ٱلرَّاحِمِينَ"
  },
  {
   "segment_id": 74,
   "arabic": "وَصَلَّىٰ ٱللَّهُ عَلَىٰ مُحَمَّدٍ وَآلِهِ صَلاةً دَائِمَةً"
  },
  {
   "segment_id": 75,
   "arabic": "لاَ تُحْصَىٰ وَلاَ تُعَدُّ"
  },
  {
   "segment_id": 76,
   "arabic": "وَلاَ يَقْدِرُ قَدْرَهَا غَيْرُكَ"
  },
  {
   "segment_id": 77,
   "arabic": "يَا أَرْحَمَ ٱلرَّاحِمِينَ"
  }
 ]
}