{
 "dua_id": "duasorg-ziyarat-muslim-ibn-aqeel-hani-e-urwa-1",
 "dua_name_en": "Ziyarat of Muslim ibn Aqeel",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ziyarat-muslim-ibn-aqeel-hani-e-urwa.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "الْحَمْدُ لِلَّهِ ٱلْمَلِكِ ٱلْحَقِّ ٱلْمُبِينِ"
  },
  {
   "segment_id": 2,
   "arabic": "ٱلْمُتَصَاغِرِ لِعَظَمَتِهِ جَبَابِرَةُ ٱلطَّاغِينَ"
  },
  {
   "segment_id": 3,
   "arabic": "ٱلْمُعْتَرِفِ بِرُبُوبِيَّتِهِ جَمِيعُ أَهْلِ ٱلسَّمَاوَاتِ وَٱلأَرَضِينَ"
  },
  {
   "segment_id": 4,
   "arabic": "ٱلْمُقِرِّ بِتَوْحِيدِهِ سَائِرُ ٱلْخَلْقِ أَجْمَعِينَ"
  },
  {
   "segment_id": 5,
   "arabic": "وَصَلَّىٰ ٱللَّهُ عَلَىٰ سَيِّـدِ ٱلأَنَامِ"
  },
  {
   "segment_id": 6,
   "arabic": "وَأَهْلِ بَيْتِهِ ٱلْكِرَامِ"
  },
  {
   "segment_id": 7,
   "arabic": "صَلاةً تَقَرُّ بِهَا أَعْيُنُهُمْ"
  },
  {
   "segment_id": 8,
   "arabic": "وَيَرْغَمُ بِهَا أَنْفُ شَانِئِهِمْ"
  },
  {
   "segment_id": 9,
   "arabic": "مِنَ ٱلْجِنِّ وَٱلإِنْسِ أَجْمَعِينَ"
  },
  {
   "segment_id": 10,
   "arabic": "سَلامُ ٱللَّهِ ٱلْعَلِيِّ ٱلْعَظِيمِ"
  },
  {
   "segment_id": 11,
   "arabic": "وَسَلاَمُ مَلاَئِكَتِهِ ٱلْمُقَرَّبِينَ"
  },
  {
   "segment_id": 12,
   "arabic": "وَأَنْبِيَائِهِ ٱلْمُرْسَلِينَ"
  },
  {
   "segment_id": 13,
   "arabic": "وَأَئِمَّتِهِ ٱلْمُنْتَجَبِينَ"
  },
  {
   "segment_id": 14,
   "arabic": "وَعِبَادِهِ ٱلصَّالِحِينَ"
  },
  {
   "segment_id": 15,
   "arabic": "وَجَمِيعِ ٱلشُّهَدَاءِ وَٱلصِّدِّيقِينَ"
  },
  {
   "segment_id": 16,
   "arabic": "وَٱلزَّاكِيَاتُ ٱلطَّيِّبَاتُ"
  },
  {
   "segment_id": 17,
   "arabic": "فِيمَا تَغْتَدِي وَتَرُوحُ"
  },
  {
   "segment_id": 18,
   "arabic": "عَلَيْكَ يَا مُسْلِمُ بْنَ عَقِيلِ بْنِ أَبِي طَالِبٍ"
  },
  {
   "segment_id": 19,
   "arabic": "وَرَحْمَةُ ٱللَّهِ وَبَرَكَاتُهُ"
  },
  {
   "segment_id": 20,
   "arabic": "أَشْهَدُ أَنَّكَ أَقَمْتَ ٱلصَّلاَةَ"
  },
  {
   "segment_id": 21,
   "arabic": "وَآتَيْتَ ٱلزَّكَاةَ"
  },
  {
   "segment_id": 22,
   "arabic": "وَأَمَرْتَ بِٱلْمَعْرُوفِ"
  },
  {
   "segment_id": 23,
   "arabic": "وَنَهَيْتَ عَنِ ٱلْمُنْكَرِ"
  },
  {
   "segment_id": 24,
   "arabic": "وَجَاهَدْتَ فِي ٱللَّهِ حَقَّ جِهَادِهِ"
  },
  {
   "segment_id": 25,
   "arabic": "وَقُتِلْتَ عَلَىٰ مِنْهَاجِ ٱلْمُجَاهِدِينَ فِي سَبِيلِهِ"
  },
  {
   "segment_id": 26,
   "arabic": "حَتَّىٰ لَقِيتَ ٱللَّهَ عَزَّ وَجَلَّ وَهُوَ عَنْكَ رَاضٍ"
  },
  {
   "segment_id": 27,
   "arabic": "وَأَشْهَدُ أَنَّكَ وَفَيْتَ بِعَهْدِ ٱللَّهِ"
  },
  {
   "segment_id": 28,
   "arabic": "وَبَذَلْتَ نَفْسَكَ فِي نُصْرَةِ حُجَّةِ ٱللَّهِ وَٱبْنِ حُجَّتِهِ"
  },
  {
   "segment_id": 29,
   "arabic": "حَتَّىٰ أَتَاكَ ٱلْيَقِينُ"
  },
  {
   "segment_id": 30,
   "arabic": "أَشْهَدُ لَكَ بِٱلتَّسْلِيمِ وَٱلْوَفَاءِ"
  },
  {
   "segment_id": 31,
   "arabic": "وَٱلنَّصِيحَةِ لِخَلَفِ ٱلنَّبِيِّ ٱلْمُرْسَلِ"
  },
  {
   "segment_id": 32,
   "arabic": "وَٱلسِّبْطِ ٱلْمُنْتَجَبِ"
  },
  {
   "segment_id": 33,
   "arabic": "وَٱلدَّلِيلِ ٱلْعَالِمِ"
  },
  {
   "segment_id": 34,
   "arabic": "وَٱلْوَصِيِّ ٱلْمُبَلِّغِ"
  },
  {
   "segment_id": 35,
   "arabic": "وَٱلْمَظْلُومِ ٱلْمُهْتَضَمِ"
  },
  {
   "segment_id": 36,
   "arabic": "فَجَزَاكَ ٱللَّهُ عَنْ رَسُولِهِ"
  },
  {
   "segment_id": 37,
   "arabic": "وَعَنْ أَمِيرِ ٱلْمُؤْمِنِينَ"
  },
  {
   "segment_id": 38,
   "arabic": "وَعَنِ ٱلْحَسَنِ وَٱلْحُسَيْنِ"
  },
  {
   "segment_id": 39,
   "arabic": "أَفْضَلَ ٱلْجَزَاءِ"
  },
  {
   "segment_id": 40,
   "arabic": "بِمَا صَبَرْتَ وَٱحْتَسَبْتَ وَأَعَنْتَ"
  },
  {
   "segment_id": 41,
   "arabic": "فَنِعْمَ عُقْبَىٰ ٱلدَّارِ"
  },
  {
   "segment_id": 42,
   "arabic": "لَعَنَ ٱللَّهُ مَنْ قَتَلَكَ"
  },
  {
   "segment_id": 43,
   "arabic": "وَلَعَنَ ٱللَّهُ مَنْ أَمَرَ بِقَتْلِكَ"
  },
  {
   "segment_id": 44,
   "arabic": "وَلَعَنَ ٱللَّهُ مَنْ ظَلَمَكَ"
  },
  {
   "segment_id": 45,
   "arabic": "وَلَعَنَ ٱللَّهُ مَنِ ٱفْتَرَىٰ عَلَيْكَ"
  },
  {
   "segment_id": 46,
   "arabic": "وَلَعَنَ ٱللَّهُ مَنْ جَهِلَ حَقَّكَ"
  },
  {
   "segment_id": 47,
   "arabic": "وَٱسْتَخَفَّ بِحُرْمَتِكَ"
  },
  {
   "segment_id": 48,
   "arabic": "وَلَعَنَ ٱللَّهُ مَنْ بَايَعَكَ وَغَشَّكَ"
  },
  {
   "segment_id": 49,
   "arabic": "وَخَذَلَكَ وَأَسْلَمَكَ"
  },
  {
   "segment_id": 50,
   "arabic": "وَمَنْ أَلَّبَ عَلَيْكَ وَلَمْ يُعِنْكَ"
  },
  {
   "segment_id": 51,
   "arabic": "الْحَمْدُ لِلَّهِ ٱلَّذِي جَعَلَ ٱلنَّارَ مَثْوَاهُمْ"
  },
  {
   "segment_id": 52,
   "arabic": "وَبِئْسَ ٱلْوِرْدُ ٱلْمَوْرُودُ"
  },
  {
   "segment_id": 53,
   "arabic": "أَشْهَدُ أَنَّكَ قُتِلْتَ مَظْلُوماً"
  },
  {
   "segment_id": 54,
   "arabic": "وَأَنَّ ٱللَّهَ مُنْجِزٌ لَكُمْ مَا وَعَدَكُمْ"
  },
  {
   "segment_id": 55,
   "arabic": "جِئْتُكَ زَائِراً عَارِفاً بِحَقِّكُمْ"
  },
  {
   "segment_id": 56,
   "arabic": "مُسَلِّماً لَكُمْ"
  },
  {
   "segment_id": 57,
   "arabic": "تَابِعاً لِسُنَّتِكُمْ"
  },
  {
   "segment_id": 58,
   "arabic": "وَنُصْرَتِي لَكُمْ مُعَدَّةٌ"
  },
  {
   "segment_id": 59,
   "arabic": "حَتَّىٰ يَحْكُمَ ٱللَّهُ وَهُوَ خَيْرُ ٱلْحَاكِمِينَ"
  },
  {
   "segment_id": 60,
   "arabic": "فَمَعَكُمْ مَعَكُمْ"
  },
  {
   "segment_id": 61,
   "arabic": "لاَ مَعَ عَدُوِّكُمْ"
  },
  {
   "segment_id": 62,
   "arabic": "صَلوَاتُ ٱللَّهِ عَلَيْكُمْ"
  },
  {
   "segment_id": 63,
   "arabic": "وَعَلَىٰ أَرْوَاحِكُمْ وَأَجْسَادِكُمْ"
  },
  {
   "segment_id": 64,
   "arabic": "وَشَاهِدِكُمْ وَغَائِبِكُمْ"
  },
  {
   "segment_id": 65,
   "arabic": "وَٱلسَّلاَمُ عَلَيْكُمْ وَرَحْمَةُ ٱللَّهِ وَبَرَكَاتُهُ"
  },
  {
   "segment_id": 66,
   "arabic": "قَتَلَ ٱللَّهُ أُمَّةً قَتَلَتْكُمْ بِٱلأَيْدِي وَٱلأَلْسُنِ"
  }
 ]
}