{
 "dua_id": "ziyarat-aminallah-imam-ali",
 "dua_name_en": "Ziyarat Aminallah",
 "dua_name_ar": "زيارة أمين الله",
 "source": "https://www.duaplayer.org/en/ziyarat/aminallah-imam-ali",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا امِينَ ٱللَّهِ فِي ارْضِهِ"
  },
  {
   "segment_id": 2,
   "arabic": "وَحُجَّتَهُ عَلَىٰ عِبَادِهِ"
  },
  {
   "segment_id": 3,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا امِيرَ ٱلْمُؤْمِنِينَ"
  },
  {
   "segment_id": 4,
   "arabic": "اشْهَدُ انَّكَ جَاهَدْتَ فِي ٱللَّهِ حَقَّ جِهَادِهِ"
  },
  {
   "segment_id": 5,
   "arabic": "وَعَمِلْتَ بِكِتَابِهِ"
  },
  {
   "segment_id": 6,
   "arabic": "وَٱتَّبَعْتَ سُنَنَ نَبِيِّهِ"
  },
  {
   "segment_id": 7,
   "arabic": "صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ"
  },
  {
   "segment_id": 8,
   "arabic": "حَتّىٰ دَعَاكَ ٱللَّهُ إِلَىٰ جِوَارِهِ"
  },
  {
   "segment_id": 9,
   "arabic": "فَقَبَضَكَ إِلَيْهِ بِٱخْتِيَارِهِ"
  },
  {
   "segment_id": 10,
   "arabic": "وَالْزَمَ اعْدَائَكَ ٱلْحُجَّةَ"
  },
  {
   "segment_id": 11,
   "arabic": "مَعَ مَا لَكَ مِنَ ٱلْحُجَجِ ٱلْبَالِغَةِ عَلَىٰ جَمِيعِ خَلْقِهِ"
  },
  {
   "segment_id": 12,
   "arabic": "اَللَّهُمَّ فَٱجْعَلْ نَفْسِي مُطْمَئِنَّةً بِقَدَرِكَ"
  },
  {
   "segment_id": 13,
   "arabic": "رَاضِيَةً بِقَضَائِكَ"
  },
  {
   "segment_id": 14,
   "arabic": "مُولَعَةً بِذِكْرِكَ وَدُعَائِكَ"
  },
  {
   "segment_id": 15,
   "arabic": "مُحِبَّةً لِصَفْوَةِ اوْلِيَائِكَ"
  },
  {
   "segment_id": 16,
   "arabic": "مَحْبُوبَةً فِي ارْضِكَ وَسَمَائِكَ"
  },
  {
   "segment_id": 17,
   "arabic": "صَابِرَةً عَلَىٰ نُزُولِ بَلاَئِكَ"
  },
  {
   "segment_id": 18,
   "arabic": "شَاكِرَةً لِفَوَاضِلِ نَعْمَائِكَ"
  },
  {
   "segment_id": 19,
   "arabic": "ذَاكِرَةً لِسَوَابِغِ آلاَئِكَ"
  },
  {
   "segment_id": 20,
   "arabic": "مُشْتَاقَةً إِلَىٰ فَرْحَةِ لِقَائِكَ"
  },
  {
   "segment_id": 21,
   "arabic": "مُتَزَوِّدَةً ٱلتَّقْوَىٰ لِيَوْمِ جَزَائِكَ"
  },
  {
   "segment_id": 22,
   "arabic": "مُسْتَنَّةً بِسُنَنِ اوْلِيَائِكَ"
  },
  {
   "segment_id": 23,
   "arabic": "مُفَارِقَةً لاِخْلاَقِ اعْدَائِكَ"
  },
  {
   "segment_id": 24,
   "arabic": "مَشْغُولَةً عَنِ ٱلدُّنْيَا بِحَمْدِكَ وَثَنَائِكَ"
  },
  {
   "segment_id": 25,
   "arabic": "اَللَّهُمَّ إِنَّ قُلُوبَ الْمُخْبِتِينَ إِلَيْكَ وَالِهَةٌ"
  },
  {
   "segment_id": 26,
   "arabic": "وَسُبُلَ ٱلرَّاغِبِينَ إِلَيْكَ شَارِعَةٌ"
  },
  {
   "segment_id": 27,
   "arabic": "وَاعْلاَمَ ٱلْقَاصِدِينَ إِلَيْكَ وَاضِحَةٌ"
  },
  {
   "segment_id": 28,
   "arabic": "وَافْئِدَةَ ٱلْعَارِفِينَ مِنْكَ فَازِعَةٌ"
  },
  {
   "segment_id": 29,
   "arabic": "وَاصْوَاتَ ٱلدَّاعِينَ إِلَيْكَ صَاعِدَةٌ"
  },
  {
   "segment_id": 30,
   "arabic": "وَابْوَابَ ٱلإِجَابَةِ لَهُمْ مُفَتَّحَةٌ"
  },
  {
   "segment_id": 31,
   "arabic": "وَدَعْوَةَ مَنْ نَاجَاكَ مُسْتَجَابَةٌ"
  },
  {
   "segment_id": 32,
   "arabic": "وَتَوْبَةَ مَنْ انَابَ إِلَيْكَ مَقْبُولَةٌ"
  },
  {
   "segment_id": 33,
   "arabic": "وَعَبْرَةَ مَنْ بَكَىٰ مِنْ خَوْفِكَ مَرْحُومَةٌ"
  },
  {
   "segment_id": 34,
   "arabic": "وَٱلإِغَاثَهَ لِمَنِ ٱسْتَغَاثَ بِكَ مَوْجُودةٌ"
  },
  {
   "segment_id": 35,
   "arabic": "وَٱلإِعَانَةَ لِمَنِ ٱسْتَعَانَ بِكَ مَبْذُولَةٌ"
  },
  {
   "segment_id": 36,
   "arabic": "وَعِدَاتِكَ لِعِبَادِكَ مُنْجَزَةٌ"
  },
  {
   "segment_id": 37,
   "arabic": "وَزَلَلَ مَنِ ٱسْتَقَالَكَ مُقَالَةٌ"
  },
  {
   "segment_id": 38,
   "arabic": "وَاعْمَالَ ٱلْعَامِلِينَ لَدَيْكَ مَحْفُوظَةٌ"
  },
  {
   "segment_id": 39,
   "arabic": "وَارْزَاقَكَ إِلَىٰ ٱلْخَلاَئِقِ مِنْ لَدُنْكَ نَازِلَةٌ"
  },
  {
   "segment_id": 40,
   "arabic": "وَعَوَائِدَ ٱلْمَزِيدِ إِلَيْهِمْ وَاصِلَةٌ"
  },
  {
   "segment_id": 41,
   "arabic": "وَذُنُوبَ ٱلْمُسْتَغْفِرِينَ مَغْفُورَةٌ"
  },
  {
   "segment_id": 42,
   "arabic": "وَحَوَائِجَ خَلْقِكَ عِنْدَكَ مَقْضِيَّةٌ"
  },
  {
   "segment_id": 43,
   "arabic": "وَجَوَائِزَ ٱلسَّائِلِينَ عِنْدَكَ مُوَفَّرَةٌ"
  },
  {
   "segment_id": 44,
   "arabic": "وَعَوَائِدَ ٱلْمَزِيدِ مُتَوَاتِرَةٌ"
  },
  {
   "segment_id": 45,
   "arabic": "وَمَوَٱئِدَ ٱلْمُسْتَطْعِمِينَ مُعَدَّةٌ"
  },
  {
   "segment_id": 46,
   "arabic": "وَمَنَاهِلَ ٱلظِّمَاءِ مُتْرَعَةٌ"
  },
  {
   "segment_id": 47,
   "arabic": "اَللَّهُمَّ فَٱسْتَجِبْ دُعَائِي"
  },
  {
   "segment_id": 48,
   "arabic": "وَٱقْبَلْ ثَنَائِي"
  },
  {
   "segment_id": 49,
   "arabic": "وَٱجْمَعْ بَيْنِي وَبَيْنَ اوْلِيَائِي"
  },
  {
   "segment_id": 50,
   "arabic": "بِحَقِّ مُحَمَّدٍ وَعَلِيٍّ"
  },
  {
   "segment_id": 51,
   "arabic": "وَفَاطِمَةَ وَٱلْحَسَنِ وَٱلْحُسَيْنِ"
  },
  {
   "segment_id": 52,
   "arabic": "إِنَّكَ وَلِيُّ نَعْمَائِي"
  },
  {
   "segment_id": 53,
   "arabic": "وَمُنْتَهَىٰ مُنَايَ"
  },
  {
   "segment_id": 54,
   "arabic": "وَغَايَةُ رَجَائِي فِي مُنْقَلَبِي وَمَثْوَايَ"
  },
  {
   "segment_id": 55,
   "arabic": ""
  },
  {
   "segment_id": 56,
   "arabic": "انْتَ إِلٰهِي وَسَيِّدِي وَمَوْلاَيَ"
  },
  {
   "segment_id": 57,
   "arabic": "ٱغْفِرْ لاِوْلِيَائِنَا"
  },
  {
   "segment_id": 58,
   "arabic": "وَكُفَّ عَنَّا اعْدَائَنَا"
  },
  {
   "segment_id": 59,
   "arabic": "وَاشْغِلْهُمْ عَنْ اذَانَا"
  },
  {
   "segment_id": 60,
   "arabic": "وَاظْهِرْ كَلِمَةَ ﭐلْحَقِّ"
  },
  {
   "segment_id": 61,
   "arabic": "وَﭐجْعَلْهَا ﭐلْعُلْيَا"
  },
  {
   "segment_id": 62,
   "arabic": "وَادْحِضْ كَلِمَةَ ﭐلْبَاطِلِ"
  },
  {
   "segment_id": 63,
   "arabic": "وَﭐجْعَلْهَا ﭐلسُّفْلَىٰ"
  },
  {
   "segment_id": 64,
   "arabic": "إِنَّكَ عَلَىٰ كُلِّ شَىٰءٍ قَدِيرٌ"
  }
 ]
}