{
 "dua_id": "sahifa-19",
 "dua_name_en": "Sahifa 19: his supplication in asking for water during a drought",
 "dua_name_ar": "دُعَاؤُهُ فِي الِاسْتِسْقَاءِ",
 "source": "https://duas.pro/19-his-supplication-in-asking-for-water-during-a-drought",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "أَللَّهُمَّ اسْقِنَا الْغَيْثَ،"
  },
  {
   "segment_id": 2,
   "arabic": "وَانْشُرْ عَلَيْنَا رَحْمَتَكَ بِغَيْثِكَ الْمُغْدِقِ"
  },
  {
   "segment_id": 3,
   "arabic": "مِنَ السَّحَابِ الْمُنْسَاقِ لِنَبَاتِ أَرْضِكَ الْمُونِقِ فِي جَمِيعِ الآفَاقِ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَامْنُنْ عَلَى عِبَادِكَ بِإينَاعِ الثَّمَرَةِ،"
  },
  {
   "segment_id": 5,
   "arabic": "وَأَحْيِ بِلاَدَكَ بِبُلُوغِ الزَّهَرَةِ."
  },
  {
   "segment_id": 6,
   "arabic": "وَأَشْهِدْ مَلائِكَتَكَ الْكِرَامَ السَّفَرَةَ"
  },
  {
   "segment_id": 7,
   "arabic": "بِسَقْيٍ مِنْكَ نَافِعٍ دَائِمٍ غُزْرُهُ"
  },
  {
   "segment_id": 8,
   "arabic": "واسِعٌ دِرَرُهُ وَابِلٌ سَرِيعٌ عَاجِلٌ"
  },
  {
   "segment_id": 9,
   "arabic": "تُحْيِي بِهِ مَا قَدْ مَاتَ، وَتَرُدُّ بِهِ مَا قَدْ فَاتَ،"
  },
  {
   "segment_id": 10,
   "arabic": "وَتُخْرِجُ بِهِ مَا هُوَ آتٍ،"
  },
  {
   "segment_id": 11,
   "arabic": "وَتُوَسِّعُ بِهِ فِي الأَقْوَاتِ،"
  },
  {
   "segment_id": 12,
   "arabic": "سَحَابًا مُتَرَاكِمًا هَنِيئًا مَرِيئًا طَبَقًا"
  },
  {
   "segment_id": 13,
   "arabic": "مُجَلْجَلًا غَيْرَ مُلِثٍّ وَدِقُّهُ،"
  },
  {
   "segment_id": 14,
   "arabic": "وَلَا خُلَّابَ بَرْقُهُ."
  },
  {
   "segment_id": 15,
   "arabic": "أَللَّهُمَّ اسْقِنَا غَيْثًا مَغِيثًا مَرِيعًا مُمْرِعًا عَرِيْضًا،"
  },
  {
   "segment_id": 16,
   "arabic": "وَاسِعًا غَزِيرًا تَرُدُّ بِهِ النَّهِيضَ وَتَجْبُرُ بِهِ الْمَهِيضَ."
  },
  {
   "segment_id": 17,
   "arabic": "أَللَّهُمَّ اسْقِنَا سَقْيًا تُسِيلُ مِنْهُ الظِّرَابَ،"
  },
  {
   "segment_id": 18,
   "arabic": "وَتَمْلَأُ مِنْهُ الْجِبَابَ،"
  },
  {
   "segment_id": 19,
   "arabic": "وَتُفَجِّرُ بِهِ الأَنْهَارَ،"
  },
  {
   "segment_id": 20,
   "arabic": "وَتُنْبِتُ بِهِ الأَشْجَارَ،"
  },
  {
   "segment_id": 21,
   "arabic": "وَتُرْخِصُ بِهِ الأَسْعَارَ فِي جَمِيعِ الأَمْصَارِ،"
  },
  {
   "segment_id": 22,
   "arabic": "وَتَنْعَشُ بِهِ الْبَهَائِمَ وَالْخَلْقَ،"
  },
  {
   "segment_id": 23,
   "arabic": "وَتُكْمِلُ لَنَا بِهِ طَيِّبَاتِ الرِّزْقِ،"
  },
  {
   "segment_id": 24,
   "arabic": "وَتُنْبِتُ لَنَا بِهِ الزَّرْعَ،"
  },
  {
   "segment_id": 25,
   "arabic": "وَتُدِرُّ بِهِ الضَّرْعَ،"
  },
  {
   "segment_id": 26,
   "arabic": "وَتَزِيدُنَا بِهِ قُوَّةً إِلَى قُوَّتِنَا."
  },
  {
   "segment_id": 27,
   "arabic": "أَللَّهُمَّ لا تَجْعَلْ ظِلَّهُ عَلَيْنَا سَمُومًا"
  },
  {
   "segment_id": 28,
   "arabic": "وَلَا تَجْعَلْ بَرْدَهُ عَلَيْنَا حُسُومًا،"
  },
  {
   "segment_id": 29,
   "arabic": "وَلَا تَجْعَلْ صَوْبَهُ عَلَيْنَا رُجُومًا،"
  },
  {
   "segment_id": 30,
   "arabic": "وَلَا تَجْعَلْ مَاءَهُ عَلَيْنَا أُجَاجًا."
  },
  {
   "segment_id": 31,
   "arabic": "أَللَّهُمَّ صَلِّ عَلَى مُحَمَّد وَآلِ مُحَمَّد،"
  },
  {
   "segment_id": 32,
   "arabic": "وَارْزُقْنَا مِنْ بَرَكَاتِ السَّمَاوَاتِ وَالأَرْضِ،"
  },
  {
   "segment_id": 33,
   "arabic": "إِنَّكَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ."
  }
 ]
}