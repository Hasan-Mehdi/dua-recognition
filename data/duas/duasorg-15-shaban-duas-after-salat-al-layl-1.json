{
 "dua_id": "duasorg-15-shaban-duas-after-salat-al-layl-1",
 "dua_name_en": "Duas After Salat al-Layl (namaz-e-shab) on 15th Shaban",
 "dua_name_ar": "",
 "source": "https://www.duas.org/15-shaban-duas-after-salat-al-layl.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "إلهِي تَعَرَّضَ لَكَ فِي هذَا اللَّيْلِ الْمُتَعَرِّضُونَ،"
  },
  {
   "segment_id": 2,
   "arabic": "وَقَصَدَكَ الْقَاصِدُونَ،"
  },
  {
   "segment_id": 3,
   "arabic": "وَأَمَّلَ فَضْلَكَ وَمَعْرُوفَكَ الطَّالِبُونَ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَلَكَ فِي هذَا اللَّيْلِ نَفَحَاتٌ وَجَوَائِزُ"
  },
  {
   "segment_id": 5,
   "arabic": "وَعَطَايَا وَمَوَاهِبُ"
  },
  {
   "segment_id": 6,
   "arabic": "تَمُنُّ بِهَا عَلَى مَنْ تَشَاءُ مِنْ عِبَادِكَ،"
  },
  {
   "segment_id": 7,
   "arabic": "وَتَمْنَعُهَا مَنْ لَمْ تَسْبِقْ لَهُ الْعِنَايَةُ مِنْكَ،"
  },
  {
   "segment_id": 8,
   "arabic": "وَهَا أَنَا ذَا عُبَيْدُكَ الْفَقِيرُ إلَيْكَ"
  },
  {
   "segment_id": 9,
   "arabic": "الْمُؤَمِّلُ فَضْلَكَ وَمَعْرُوفَكَ،"
  },
  {
   "segment_id": 10,
   "arabic": "فَإنْ كُنْتَ يَا مَوْلايَ تَفَضَّلْتَ فِي هذِهِ اللَّيْلَةِ عَلَى أَحَدٍ مِنْ خَلْقِكَ"
  },
  {
   "segment_id": 11,
   "arabic": "وَعُدْتَ عَلَيْهِ بِعَائِدَةٍ مِنْ عَطْفِكَ"
  },
  {
   "segment_id": 12,
   "arabic": "فَصَلِّ عَلَى مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 13,
   "arabic": "الطَّيِّبِينَ الطَّاهِرِينَ الْخَيِّرِينَ الْفَاضِلِينَ،"
  },
  {
   "segment_id": 14,
   "arabic": "وَجُدْ عَلَيَّ بِطَوْلِكَ وَمَعْرُوفِكَ"
  },
  {
   "segment_id": 15,
   "arabic": "يَا رَبَّ الْعَالَمِينَ،"
  },
  {
   "segment_id": 16,
   "arabic": "وَصَلَّى اللّهُ عَلَى مُحَمَّدٍ خَاتَمِ النَّبِيِّينَ"
  },
  {
   "segment_id": 17,
   "arabic": "وَآلِهِ الطَّاهِرِينَ"
  },
  {
   "segment_id": 18,
   "arabic": "وَسَلَّمَ تَسْلِيماً"
  },
  {
   "segment_id": 19,
   "arabic": "إنَّ اللّهَ حَمِيدٌ مَجِيدٌ."
  },
  {
   "segment_id": 20,
   "arabic": "اللّهُمَّ إنِّي أَدْعُوكَ كَمَا أَمَرْتَ"
  },
  {
   "segment_id": 21,
   "arabic": "فَاسْتَجِبْ لِي كَمَا وَعَدْتَ"
  },
  {
   "segment_id": 22,
   "arabic": "إنَّكَ لا تُخْلِفُ الْمِيعَادَ."
  }
 ]
}