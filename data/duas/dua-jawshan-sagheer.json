{
 "dua_id": "dua-jawshan-sagheer",
 "dua_name_en": "Dua Jawshan Sagheer",
 "dua_name_ar": "دعاء الجوشن الصغىير",
 "source": "https://www.duaplayer.org/en/dua/jawshan-sagheer",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمٰنِ ٱلرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "إِلٰهِي كَم مِنْ عَدُوٍّ"
  },
  {
   "segment_id": 3,
   "arabic": "ٱنتَضَىٰ عَلَيَّ سَيْفَ عَدَاوَتِهِ"
  },
  {
   "segment_id": 4,
   "arabic": "وَشَحَذَ لِي ظُبَّةَ مُدْيَتِهِ"
  },
  {
   "segment_id": 5,
   "arabic": "وَارْهَفَ لِي شَبَا حَدِّهُ"
  },
  {
   "segment_id": 6,
   "arabic": "وَدَافَ لِي قَوَاتِلَ سُمُومِهِ"
  },
  {
   "segment_id": 7,
   "arabic": "وَسَدَّدَ إِلَيَّ صَوَائِبَ سِهَامِهِ"
  },
  {
   "segment_id": 8,
   "arabic": "وَلَمْ تَنَمْ عَنِّي عَيْنُ حِرَاسَتِهِ"
  },
  {
   "segment_id": 9,
   "arabic": "وَاضْمَرَ انْ يَسُومَنِي ٱلْمَكْرُوهَ"
  },
  {
   "segment_id": 10,
   "arabic": "وَيُجَرِّعَنِي ذُعَافَ مَرَارَتِهِ"
  },
  {
   "segment_id": 11,
   "arabic": "نَظَرْتَ إِلَىٰ ضَعْفِي عَنِ ٱحْتِمَاِل ٱلْفَوَاِدحِ"
  },
  {
   "segment_id": 12,
   "arabic": "وَعَجْزِي عَنِ ٱلإِنتِصَارِ مِمَّن قَصَدَنِي بِمُحَارَبَتِهِ"
  },
  {
   "segment_id": 13,
   "arabic": "وَوَحْدَتِي فِي كَثِيرٍ مِمَّنْ نَاوَانِي وَارْصَدَ لِي"
  },
  {
   "segment_id": 14,
   "arabic": "فِيمَا لَمْ اعْمِلْ فِكْرِي فِي ٱلإِرْصَادِ لَهُم بِمِثْلِهِ"
  },
  {
   "segment_id": 15,
   "arabic": "فَايَّدْتَنِي بِقُوَّتِكَ"
  },
  {
   "segment_id": 16,
   "arabic": "وَشَدَدْتَ ازْرِي بِنُصْرَتِكَ"
  },
  {
   "segment_id": 17,
   "arabic": "وَفَلَلْتَ لِي حَدَّهُ"
  },
  {
   "segment_id": 18,
   "arabic": "وَخَذَلْتَهُ بَعْدَ جَمْعِ عَدِيدِهِ وَحَشْدِهِ"
  },
  {
   "segment_id": 19,
   "arabic": "وَاعْلَيْتَ كَعْبِي عَلَيْهِ"
  },
  {
   "segment_id": 20,
   "arabic": "وَوَجَّهْتَ مَا سَدَّدَ إِلَيَّ مِنْ مَكَائِدِهِ إِلَيْهِ"
  },
  {
   "segment_id": 21,
   "arabic": "وَرَدَدْتَهُ عَلَيْهِ"
  },
  {
   "segment_id": 22,
   "arabic": "وَلَمْ يَشْفِ غَلِيلَهُ"
  },
  {
   "segment_id": 23,
   "arabic": "وَلَمْ تَبْرُدْ حَزَازَاتُ غَيْظِهِ"
  },
  {
   "segment_id": 24,
   "arabic": "وَقَدْ عَضَّ عَلَيَّ انَامِلَهُ"
  },
  {
   "segment_id": 25,
   "arabic": "وَادْبَرَ مُوَلِّياً قَدْ اخْفَقَتْ سَرَايَاهُ"
  },
  {
   "segment_id": 26,
   "arabic": "فَلَكَ ٱلْحَمْدُ يَا رَبِّ"
  },
  {
   "segment_id": 27,
   "arabic": "مِنْ مُقْتَدِرٍ لاَ يُغْلَبُ"
  },
  {
   "segment_id": 28,
   "arabic": "وَذِي انَاةٍ لاَ يَعْجَلُ"
  },
  {
   "segment_id": 29,
   "arabic": "صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 30,
   "arabic": "وَٱجْعَلْنِي لِنَعْمَائِكَ مِنَ ٱلشَّاكِرِينَ"
  },
  {
   "segment_id": 31,
   "arabic": "وَلآلاَئِكَ مِنَ ٱلذَّاكِرِينَ"
  },
  {
   "segment_id": 32,
   "arabic": "إِلٰهِي وَكَمْ مِنْ بَاغٍ"
  },
  {
   "segment_id": 33,
   "arabic": "بَغَانِي بِمَكَائِدِهِ"
  },
  {
   "segment_id": 34,
   "arabic": "وَنَصَبَ لِي اشْرَاكَ مَصَائِدِهِ"
  },
  {
   "segment_id": 35,
   "arabic": "وَوَكَّلَ بِي تَفَقُّدَ رِعَايَتِهِ"
  },
  {
   "segment_id": 36,
   "arabic": "وَاضْبَا إِلَيَّ إِضْبَاءَ ٱلسَّبْعِ لِطَرِيدَتِهِ"
  },
  {
   "segment_id": 37,
   "arabic": "إنتِظَاراً لاِنْتِهَازِ فُرْصَتِهِ"
  },
  {
   "segment_id": 38,
   "arabic": "وَهُوَ يُظْهِرُ بَشَاشَةَ ٱلْمَلَقِ"
  },
  {
   "segment_id": 39,
   "arabic": "وَيَبْسُطُ وَجْهاً غَيْرَ طَلِقٍ"
  },
  {
   "segment_id": 40,
   "arabic": "فَلَمَّا رَايْتَ دَغَلَ سَرِيرَتِهِ"
  },
  {
   "segment_id": 41,
   "arabic": "وَقُبْحَ مَا ٱنطَوَىٰ عَلَيْهِ لِشَرِيكِهِ فِي مِلَّتِهِ"
  },
  {
   "segment_id": 42,
   "arabic": "وَاصْبَحَ مُجْلِباً لِي فِي بَغْيِهِ"
  },
  {
   "segment_id": 43,
   "arabic": "ارْكَسْتَهُ لاِمِّ رَاسِهِ"
  },
  {
   "segment_id": 44,
   "arabic": "وَاتَيْتَ بُنيَانَهُ مِنْ اسَاسِهِ"
  },
  {
   "segment_id": 45,
   "arabic": "فَصَرَعْتَهُ فِي زُبْيَتِهِ"
  },
  {
   "segment_id": 46,
   "arabic": "وَرَدَّيْتَهُ فِي مَهْوَىٰ حُفْرَتِهِ"
  },
  {
   "segment_id": 47,
   "arabic": "وَجَعَلْتَ خَدَّهُ طَبَقاً لِتُرَابِ رِجْلِهِ"
  },
  {
   "segment_id": 48,
   "arabic": "وَشَغَلْتَهُ فِي بَدَنِهِ وَرِزْقِهِ"
  },
  {
   "segment_id": 49,
   "arabic": "وَرَمَيْتَهُ بِحَجَرِهِ"
  },
  {
   "segment_id": 50,
   "arabic": "وَخَنَقْتَهُ بِوَتَرِهِ"
  },
  {
   "segment_id": 51,
   "arabic": "وَذَكَّيْتَهُ بِمَشَاقِصِهِ"
  },
  {
   "segment_id": 52,
   "arabic": "وَكَبَبْتَهُ لِمِنْخَرِهِ"
  },
  {
   "segment_id": 53,
   "arabic": "وَرَدَدْتَ كَيْدَهُ فِي نَحْرِهِ"
  },
  {
   "segment_id": 54,
   "arabic": "وَرَبَقْتَهُ بِنَدَامَتِهِ"
  },
  {
   "segment_id": 55,
   "arabic": "وَفَسَاتَهُ بِحَسْرَتِهِ"
  },
  {
   "segment_id": 56,
   "arabic": "فَٱسْتَخْذَا وَتَضَاءَلَ بَعْدَ نَخْوَتِهِ"
  },
  {
   "segment_id": 57,
   "arabic": "وَٱنقَمَعَ بَعْدَ ٱسْتِطَالَتِهِ"
  },
  {
   "segment_id": 58,
   "arabic": "ذَلِيلاً مَاسُوراً فِي رِبْقِ حِبَالَتِهِ"
  },
  {
   "segment_id": 59,
   "arabic": "ٱلَّتِي كَانَ يُؤَمِّلُ انْ يَرَانِي فِيهَا يَوْمَ سَطْوَتِهِ"
  },
  {
   "segment_id": 60,
   "arabic": "وَقَدْ كِدْتُ يَا رَبِّ لَوْلاَ رَحْمَتُكَ"
  },
  {
   "segment_id": 61,
   "arabic": "انْ يَحِلَّ بِي مَا حَلَّ بِسَاحَتِهِ"
  },
  {
   "segment_id": 62,
   "arabic": "فَلَكَ ٱلْحَمْدُ يَا رَبِّ"
  },
  {
   "segment_id": 63,
   "arabic": "مِنْ مُقْتَدِرٍ لاَ يُغْلَبُ"
  },
  {
   "segment_id": 64,
   "arabic": "وَذِي انَاةٍ لاَ يَعْجَلُ"
  },
  {
   "segment_id": 65,
   "arabic": "صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 66,
   "arabic": "وَٱجْعَلْنِي لِنَعْمَائِكَ مِنَ ٱلشَّاكِرِينَ"
  },
  {
   "segment_id": 67,
   "arabic": "وَلآِلاَئِكَ مِنَ ٱلذَّاكِرِينَ"
  },
  {
   "segment_id": 68,
   "arabic": "إِلٰهِي وَكَمْ مِنْ حَاسِدٍ شَرِقَ بِحَسْرَتِهِ"
  },
  {
   "segment_id": 69,
   "arabic": "وَعَدُوٍّ شَجِيَ بِغَيْظِهِ"
  },
  {
   "segment_id": 70,
   "arabic": "وَسَلَقَنِي بِحَدِّ لِسَانِهِ"
  },
  {
   "segment_id": 71,
   "arabic": "وَوَخَزَنِي بِمُوقِ عَيْنِهِ"
  },
  {
   "segment_id": 72,
   "arabic": "وَجَعَلَنِي غَرَضاً لِمَرَامِيهِ"
  },
  {
   "segment_id": 73,
   "arabic": "وَقَلَّدَنِي خِلاَلاً لَمْ تَزَلْ فِيهِ"
  },
  {
   "segment_id": 74,
   "arabic": "نَاديْتُكَ يَا رَبِّ مُسْتَجِيراً بِكَ"
  },
  {
   "segment_id": 75,
   "arabic": "وَاثِقاً بِسُرْعَةِ إِجَابَتِكَ"
  },
  {
   "segment_id": 76,
   "arabic": "مُتَوَكِّلاً عَلَىٰ مَا لَمْ ازَلْ اتَعَرَّفُهُ"
  },
  {
   "segment_id": 77,
   "arabic": "مِن حُسْنِ دِفَاعِكَ"
  },
  {
   "segment_id": 78,
   "arabic": "عَالِماً انَّهُ لاَ يُضْطَهَدُ مَنْ اوَىٰ إِلَىٰ ظِلِّ كَنَفِكَ"
  },
  {
   "segment_id": 79,
   "arabic": "وَلَن تَقْرَعَ ٱلْحَوَادِثُ مَنْ لَجَا إِلَىٰ مَعْقِلِ ٱلاِنْتِصَارِ بِكَ"
  },
  {
   "segment_id": 80,
   "arabic": "فَحَصَّنْتَنِي مِنْ بَاسِهِ بِقُدْرَتِكَ"
  },
  {
   "segment_id": 81,
   "arabic": "فَلَكَ ٱلْحَمْدُ يَا رَبِّ"
  },
  {
   "segment_id": 82,
   "arabic": "مِنْ مُقْتَدِرٍ لاَ يُغْلَبُ"
  },
  {
   "segment_id": 83,
   "arabic": "وَذِي انَاةٍ لاَ يَعْجَلُ"
  },
  {
   "segment_id": 84,
   "arabic": "صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 85,
   "arabic": "وَٱجْعَلْنِي لِنَعْمَائِكَ مِنَ ٱلشَّاكِرِينَ"
  },
  {
   "segment_id": 86,
   "arabic": "وَلآِلاَئِكَ مِنَ ٱلذَّاكِرِينَ"
  },
  {
   "segment_id": 87,
   "arabic": "إِلٰهِي وَكَمْ مِنْ سَحَائِبِ مَكْرُوهٍ جَلَّيْتَهَا"
  },
  {
   "segment_id": 88,
   "arabic": "وَسَمَاءِ نِعْمَةٍ مَطَرْتَهَا"
  },
  {
   "segment_id": 89,
   "arabic": "وَجَدَاوِلِ كَرَامَةٍ اجْرَيْتَهَا"
  },
  {
   "segment_id": 90,
   "arabic": "وَاعْيُنِ احْدَاثٍ طَمَسْتَهَا"
  },
  {
   "segment_id": 91,
   "arabic": "وَنَاشِئَةِ رَحْمَةٍ نشَرْتَهَا"
  },
  {
   "segment_id": 92,
   "arabic": "وَجُنَّةِ عَافِيَةٍ الْبَسْتَهَا"
  },
  {
   "segment_id": 93,
   "arabic": "وَغَوَامِرِ كُرُبَاتٍ كَشَفْتَهَا"
  },
  {
   "segment_id": 94,
   "arabic": "وَامُورٍ جَارِيَةٍ قَدَّرْتَهَا"
  },
  {
   "segment_id": 95,
   "arabic": "لَمْ تُعْجِزْكَ إِذْ طَلَبْتَهَا"
  },
  {
   "segment_id": 96,
   "arabic": "وَلَمْ تَمْتَنِعْ مِنْكَ إِذْ ارَدْتَهَا"
  },
  {
   "segment_id": 97,
   "arabic": "فَلَكَ ٱلْحَمْدُ يَا رَبِّ"
  },
  {
   "segment_id": 98,
   "arabic": "مِنْ مُقْتَدِرٍ لاَ يُغْلَبُ"
  },
  {
   "segment_id": 99,
   "arabic": "وَذِي انَاةٍ لاَ يَعْجَلُ"
  },
  {
   "segment_id": 100,
   "arabic": "صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 101,
   "arabic": "وَٱجْعَلْنِي لِنَعْمَائِكَ مِنَ ٱلشَّاكِرِينَ"
  },
  {
   "segment_id": 102,
   "arabic": "وَلآِلاَئِكَ مِنَ ٱلذَّاكِرِينَ"
  },
  {
   "segment_id": 103,
   "arabic": "إِلٰهِي وَكَمْ مِنْ ظَنٍّ حَسَنٍ حَقَّقْتَ"
  },
  {
   "segment_id": 104,
   "arabic": "وَمِن كَسْرِ إِمْلاَقٍ جَبَرْتَ"
  },
  {
   "segment_id": 105,
   "arabic": "وَمِن مَسْكَنَةٍ فَادِحَةٍ حَوَّلْتَ"
  },
  {
   "segment_id": 106,
   "arabic": "وَمِن صَرْعَةٍ مُهْلِكَةٍ نعَشْتَ"
  },
  {
   "segment_id": 107,
   "arabic": "وَمِن مَشَقَّةٍ ارَحْتَ"
  },
  {
   "segment_id": 108,
   "arabic": "لاَ تُسْالُ عَمَّا تَفْعَلُ"
  },
  {
   "segment_id": 109,
   "arabic": "وَهُمْ يُسْالُونَ"
  },
  {
   "segment_id": 110,
   "arabic": "وَلاَ يَنقُصُكَ مَا انفَقْتَ"
  },
  {
   "segment_id": 111,
   "arabic": "وَلَقَدْ سُئِلْتَ فَاعْطَيْتَ"
  },
  {
   "segment_id": 112,
   "arabic": "وَلَمْ تُسْالْ فَٱبْتَدَاتَ"
  },
  {
   "segment_id": 113,
   "arabic": "وَٱسْتُمِيحَ بَابُ فَضْلِكَ فَمَا اكْديْتَ"
  },
  {
   "segment_id": 114,
   "arabic": "ابَيْتَ إِلاَّ إِنْعَاماً وَامْتِنَاناً"
  },
  {
   "segment_id": 115,
   "arabic": "وَابَيْتَ إِلاَّ تَطَوُّلاً يَا رَبِّ وَإِحْسَاناً"
  },
  {
   "segment_id": 116,
   "arabic": "وَابَيْتُ إِلاَّ ٱنتِهَاكاً لِحُرُمَاتِكَ"
  },
  {
   "segment_id": 117,
   "arabic": "وَٱجْتِرَاءاً عَلَىٰ مَعَاصِيكَ"
  },
  {
   "segment_id": 118,
   "arabic": "وَتَعَدِّياً لِحُدُودِكَ"
  },
  {
   "segment_id": 119,
   "arabic": "وَغَفْلَةً عَنْ وَعِيدِكَ"
  },
  {
