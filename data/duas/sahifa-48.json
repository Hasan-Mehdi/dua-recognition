{
 "dua_id": "sahifa-48",
 "dua_name_en": "Sahifa 48: his supplication on the day of sacrifice and friday",
 "dua_name_ar": "دُعَاؤُهُ فِي يَوْمِ الْأَضْحَى وَ الْجُمُعَةِ",
 "source": "https://duas.pro/48-his-supplication-on-the-day-of-sacrifice-and-friday",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللَّهُمَّ هَذَا يَوْمٌ مُبَارَكٌ مَيْمُونٌ"
  },
  {
   "segment_id": 2,
   "arabic": "وَ الْمُسْلِمُونَ فِيهِ مُجْتَمِعُونَ فِي أَقْطَارِ أَرْضِكَ،"
  },
  {
   "segment_id": 3,
   "arabic": "يَشْهَدُ السَّائِلُ مِنْهُمْ وَ الطَّالِبُ وَ الرَّاغِبُ وَ الرَّاهِبُ"
  },
  {
   "segment_id": 4,
   "arabic": "وَ أَنْتَ النَّاظِرُ فِي حَوَائِجِهِمْ"
  },
  {
   "segment_id": 5,
   "arabic": "فَأَسْأَلُكَ بِجُودِكَ وَ كَرَمِكَ وَ هَوَانِ مَا سَأَلْتُكَ عَلَيْكَ"
  },
  {
   "segment_id": 6,
   "arabic": "أَنْ تُصَلِّيَ عَلَى مُحَمَّدٍ وَ آلِهِ"
  },
  {
   "segment_id": 7,
   "arabic": "وَ أَسْأَلُكَ اللَّهُمَّ رَبَّنَا بِأَنَّْ لَكَ الْمُلْكَ وَ لَكَ الْحَمْدَ،"
  },
  {
   "segment_id": 8,
   "arabic": "لَا إِلَهَ إِلَّا أَنْتَ، الْحَلِيمُ الْكَرِيمُ الْحَنَّانُ الْمَنَّانُ"
  },
  {
   "segment_id": 9,
   "arabic": "ذُو الْجَلَالِ وَ الْإِكْرَامِ، بَدِيعُ السَّمَاوَاتِ وَ الْأَرْضِ،"
  },
  {
   "segment_id": 10,
   "arabic": "مَهْمَا قَسَمْتَ بَيْنَ عِبَادِكَ الْمُؤْمِنِينَ"
  },
  {
   "segment_id": 11,
   "arabic": "مِنْ خَيْرٍ أَوْ عَافِيَةٍ أَوْ بَرَكَةٍ أَوْ هُدًى أَوْ عَمَلٍ بِطَاعَتِكَ"
  },
  {
   "segment_id": 12,
   "arabic": "أَوْ خَيْرٍ تَمُنُّ بِهِ عَلَيْهِمْ تَهْدِيهِمْ بِهِ إِلَيْكَ"
  },
  {
   "segment_id": 13,
   "arabic": "أَوْ تَرْفَعُ لَهُمْ عِنْدَكَ دَرَجَةً"
  },
  {
   "segment_id": 14,
   "arabic": "أَوْ تُعْطِيهِمْ بِهِ خَيْراً مِنْ خَيْرِ الدُّنْيَا وَ الْآخِرَةِ"
  },
  {
   "segment_id": 15,
   "arabic": "أَنْ تُوَفِّرَ حَظِّي وَ نَصِيبِي مِنْهُ."
  },
  {
   "segment_id": 16,
   "arabic": "وَ أَسْأَلُكَ اللَّهُمَّ بِأَنَّ"
  },
  {
   "segment_id": 17,
   "arabic": "لَكَ الْمُلْكَ وَ الْحَمْدَ"
  },
  {
   "segment_id": 18,
   "arabic": "لَا إِلَهَ إِلَّا أَنْتَ"
  },
  {
   "segment_id": 19,
   "arabic": "أَنْ تُصَلِّيَ عَلَى مُحَمَّدٍ"
  },
  {
   "segment_id": 20,
   "arabic": "عَبْدِكَ وَ رَسُولِكَ"
  },
  {
   "segment_id": 21,
   "arabic": "وَ حَبِيبِكَ وَ صِفْوَتِكَ"
  },
  {
   "segment_id": 22,
   "arabic": "وَ خِيَرَتِكَ مِنْ خَلْقِكَ"
  },
  {
   "segment_id": 23,
   "arabic": "وَ عَلَى آلِ مُحَمَّدٍ الْأَبْرَارِ الطَّاهِرِينَ الْأَخْيَارِ"
  },
  {
   "segment_id": 24,
   "arabic": "صَلَاةً لَا يَقْوَى عَلَى إِحْصَائِهَا إِلَّا أَنْتَ"
  },
  {
   "segment_id": 25,
   "arabic": "وَ أَنْ تُشْرِكَنَا فِي"
  },
  {
   "segment_id": 26,
   "arabic": "صَالِحِ مَنْ دَعَاكَ فِي هَذَا الْيَوْمِ"
  },
  {
   "segment_id": 27,
   "arabic": "مِنْ عِبَادِكَ الْمُؤْمِنِينَ"
  },
  {
   "segment_id": 28,
   "arabic": "يَا رَبَّ الْعَالَمِينَ"
  },
  {
   "segment_id": 29,
   "arabic": "وَ أَنْ تَغْفِرَ لَنَا وَ لَهُمْ"
  },
  {
   "segment_id": 30,
   "arabic": "إِنَّكَ عَلَى كُلِّ شَيْ‏ءٍ قَدِيرٌ."
  },
  {
   "segment_id": 31,
   "arabic": "اللَّهُمَّ إِلَيْكَ تَعَمَّدْتُ بِحَاجَتِي"
  },
  {
   "segment_id": 32,
   "arabic": "وَ بِكَ أَنْزَلْتُ الْيَوْمَ فَقْرِي"
  },
  {
   "segment_id": 33,
   "arabic": "وَ فَاقَتِي وَ مَسْكَنَتِي"
  },
  {
   "segment_id": 34,
   "arabic": "وَ إِنِّي بِمَغْفِرَتِكَ وَ رَحْمَتِكَ أَوْثَقُ مِنِّي بِعَمَلِي"
  },
  {
   "segment_id": 35,
   "arabic": "وَ لَمَغْفِرَتُكَ وَ رَحْمَتُكَ أَوْسَعُ مِنْ ذُنُوبِي"
  },
  {
   "segment_id": 36,
   "arabic": "فَصَلِّ عَلَى مُحَمَّدٍ وَ آلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 37,
   "arabic": "وَ تَوَلَّ قَضَاءَ كُلِّ حَاجَةٍ هِيَ لِي"
  },
  {
   "segment_id": 38,
   "arabic": "بِقُدْرَتِكَ عَلَيْهَا"
  },
  {
   "segment_id": 39,
   "arabic": "وَ تَيْسِيرِ ذَلِكَ عَلَيْكَ"
  },
  {
   "segment_id": 40,
   "arabic": "وَ بِفَقْرِي إِلَيْكَ"
  },
  {
   "segment_id": 41,
   "arabic": "وَ غِنَاكَ عَنِّي"
  },
  {
   "segment_id": 42,
   "arabic": "فَإِنِّي لَمْ أُصِبْ خَيْراً قَطُّ إِلَّا مِنْكَ"
  },
  {
   "segment_id": 43,
   "arabic": "وَ لَمْ يَصْرِفْ عَنِّي سُوءاً قَطُّ أَحَدٌ غَيْرُكَ"
  },
  {
   "segment_id": 44,
   "arabic": "وَ لَا أَرْجُو لِأَمْرِ"
  },
  {
   "segment_id": 45,
   "arabic": "آخِرَتِي وَ دُنْيَايَ سِوَاكَ"
  },
  {
   "segment_id": 46,
   "arabic": "اللَّهُمَّ مَنْ تَهَيَّأَ وَ تَعَبَّأَ"
  },
  {
   "segment_id": 47,
   "arabic": "وَ أَعَدَّ وَ اسْتَعَدَّ"
  },
  {
   "segment_id": 48,
   "arabic": "لِوِفَادَةٍ إِلَى مَخْلُوقٍ"
  },
  {
   "segment_id": 49,
   "arabic": "رَجَاءَ رِفْدِهِ وَ نَوَافِلِهِ وَ طَلَبَ نَيْلِهِ وَ جَائِزَتِهِ"
  },
  {
   "segment_id": 50,
   "arabic": "فَإِلَيْكَ يَا مَوْلَايَ كَانَتِ الْيَوْمَ"
  },
  {
   "segment_id": 51,
   "arabic": "تَهْيِئَتِي وَ تَعْبِئَتِي"
  },
  {
   "segment_id": 52,
   "arabic": "وَ إِعْدَادِي وَ اسْتِعْدَادِي"
  },
  {
   "segment_id": 53,
   "arabic": "رَجَاءَ عَفْوِكَ وَ رِفْدِكَ"
  },
  {
   "segment_id": 54,
   "arabic": "وَ طَلَبَ نَيْلِكَ وَ جَائِزَتِكَ"
  },
  {
   "segment_id": 55,
   "arabic": "اللَّهُمَّ فَصَلِّ عَلَى مُحَمَّدٍ وَ آلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 56,
   "arabic": "وَ لَا تُخَيِّبِ الْيَوْمَ ذَلِكَ مِنْ رَجَائِي"
  },
  {
   "segment_id": 57,
   "arabic": "يَا مَنْ لَا يُحْفِيهِ سَائِلٌ"
  },
  {
   "segment_id": 58,
   "arabic": "وَ لَا يَنْقُصُهُ نَائِلٌ"
  },
  {
   "segment_id": 59,
   "arabic": "فَإِنِّي لَمْ آتِكَ ثِقَةً"
  },
  {
   "segment_id": 60,
   "arabic": "مِنِّي بِعَمَلٍ صَالِحٍ قَدَّمْتُهُ"
  },
  {
   "segment_id": 61,
   "arabic": "وَ لَا شَفَاعَةِ مَخْلُوقٍ رَجَوْتُهُ"
  },
  {
   "segment_id": 62,
   "arabic": "إِلَّا شَفَاعَةَ مُحَمَّدٍ وَ أَهْلِ بَيْتِهِ"
  },
  {
   "segment_id": 63,
   "arabic": "عَلَيْهِ وَ عَلَيْهِمْ سَلَامُكَ"
  },
  {
   "segment_id": 64,
   "arabic": "أَتَيْتُكَ مُقِرّاً بِالْجُرْمِ وَ الْإِسَاءَةِ إِلَى نَفْسِي"
  },
  {
   "segment_id": 65,
   "arabic": "أَتَيْتُكَ أَرْجُو عَظِيمَ عَفْوِكَ"
  },
  {
   "segment_id": 66,
   "arabic": "الَّذِي عَفَوْتَ بِهِ عَنِ الْخَاطِئِينَ"
  },
  {
   "segment_id": 67,
   "arabic": "ثُمَّ لَمْ يَمْنَعْكَ طُولُ عُكُوفِهِمْ عَلَى عَظِيمِ الْجُرْمِ"
  },
  {
   "segment_id": 68,
   "arabic": "أَنْ عُدْتَ عَلَيْهِمْ بِالرَّحْمَةِ وَ الْمَغْفِرَةِ"
  },
  {
   "segment_id": 69,
   "arabic": "فَيَا مَنْ رَحْمَتُهُ وَاسِعَةٌ"
  },
  {
   "segment_id": 70,
   "arabic": "وَ عَفْوُهُ عَظِيمٌ"
  },
  {
   "segment_id": 71,
   "arabic": "يَا عَظِيمُ يَا عَظِيمُ"
  },
  {
   "segment_id": 72,
   "arabic": "يَا كَرِيمُ يَا كَرِيمُ"
  },
  {
   "segment_id": 73,
   "arabic": "صَلِّ عَلَى مُحَمَّدٍ وَ آلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 74,
   "arabic": "وَ عُدْ عَلَيَّ بِرَحْمَتِكَ"
  },
  {
   "segment_id": 75,
   "arabic": "وَ تَعَطَّفْ عَلَيَّ بِفَضْلِكَ"
  },
  {
   "segment_id": 76,
   "arabic": "وَ تَوَسَّعْ عَلَيَّ بِمَغْفِرَتِكَ."
  },
  {
   "segment_id": 77,
   "arabic": "اللَّهُمَّ إِنَّ هَذَا الْمَقَامَ لِخُلَفَائِكَ وَ أَصْفِيَائِكَ"
  },
  {
   "segment_id": 78,
   "arabic": "وَ مَوَاضِعَ أُمَنَائِكَ"
  },
  {
   "segment_id": 79,
   "arabic": "فِي الدَّرَجَةِ الرَّفِيعَةِ الَّتِي اخْتَصَصْتَهُمْ بِهَا"
  },
  {
   "segment_id": 80,
   "arabic": "قَدِ ابْتَزُّوهَا"
  },
  {
   "segment_id": 81,
   "arabic": "وَ أَنْتَ الْمُقَدِّرُ لِذَلِكَ"
  },
  {
   "segment_id": 82,
   "arabic": "لَا يُغَالَبُ أَمْرُكَ"
  },
  {
   "segment_id": 83,
   "arabic": "وَ لَا يُجَاوَزُ الْمَحْتُومُ مِنْ تَدْبِيرِكَ"
  },
  {
   "segment_id": 84,
   "arabic": "كَيْفَ شِئْتَ وَ أَنَّى شِئْتَ"
  },
  {
   "segment_id": 85,
   "arabic": "وَ لِمَا أَنْتَ أَعْلَمُ بِهِ"
  },
  {
   "segment_id": 86,
   "arabic": "غَيْرُ مُتَّهَمٍ عَلَى خَلْقِكَ وَ لَا لِإِرَادَتِكَ"
  },
  {
   "segment_id": 87,
   "arabic": "حَتَّى عَادَ صِفْوَتُكَ وَ خُلَفَاؤُكَ"
  },
  {
   "segment_id": 88,
   "arabic": "مَغْلُوبِينَ مَقْهُورِينَ مُبْتَزِّينَ"
  },
  {
   "segment_id": 89,
   "arabic": "يَرَوْنَ حُكْمَكَ مُبَدَّلًا"
  },
  {
   "segment_id": 90,
   "arabic": "وَ كِتَابَكَ مَنْبُوذاً"
  },
  {
   "segment_id": 91,
   "arabic": "وَ فَرَائِضَكَ مُحَرَّفَةً عَنْ جِهَاتِ أَشْرَاعِكَ"
  },
  {
   "segment_id": 92,
   "arabic": "وَ سُنَنَ نَبِيِّكَ مَتْرُوكَةً"
  },
  {
   "segment_id": 93,
   "arabic": "اللَّهُمَّ الْعَنْ أَعْدَاءَهُمْ مِنَ الْأَوَّلِينَ وَ الْآخِرِينَ"
  },
  {
   "segment_id": 94,
   "arabic": "وَ مَنْ رَضِيَ بِفِعَالِهِمْ"
  },
  {
   "segment_id": 95,
   "arabic": "وَ أَشْيَاعَهُمْ وَ أَتْبَاعَهُمْ"
  },
  {
   "segment_id": 96,
   "arabic": "اللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَ آلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 97,
   "arabic": "إِنَّكَ حَمِيدٌ مَجِيدٌ"
  },
  {
   "segment_id": 98,
   "arabic": "كَصَلَوَاتِكَ وَ بَرَكَاتِكَ وَ تَحِيَّاتِكَ"
  },
  {
   "segment_id": 99,
   "arabic": "عَلَى أَصْفِيَائِكَ إِبْرَاهِيمَ وَ آلِ إِبْرَاهِيمَ"
  },
  {
   "segment_id": 100,
   "arabic": "وَ عَجِّلِ الْفَرَجَ"
  },
  {
   "segment_id": 101,
   "arabic": "وَ الرَّوْحَ وَ النُّصْرَةَ وَ التَّمْكِينَ وَ التَّأْيِيدَ لَهُمْ"
  },
  {
   "segment_id": 102,
   "arabic": "اللَّهُمَّ وَ اجْعَلْنِي"
  },
  {
   "segment_id": 103,
   "arabic": "مِنْ أَهْلِ التَّوْحِيدِ"
  },
  {
   "segment_id": 104,
   "arabic": "وَ الْإِيمَانِ بِكَ"
  },
  {
   "segment_id": 105,
   "arabic": "وَ التَّصْدِيقِ بِرَسُولِكَ"
  },
  {
   "segment_id": 106,
   "arabic": "وَ الْأَئِمَّةِ الَّذِينَ حَتَمْتَ طَاعَتَهُمْ"
  },
  {
   "segment_id": 107,
   "arabic": "مِمَّنْ يَجْرِي ذَلِكَ بِهِ وَ عَلَى يَدَيْهِ"
  },
  {
   "segment_id": 108,
   "arabic": "آمِينَ رَبَّ الْعَالَمِينَ"
  },
  {
   "segment_id": 109,
   "arabic": "اللَّهُمَّ لَيْسَ يَرُدُّ غَضَبَكَ إِلَّا حِلْمُكَ"
  },
  {
   "segment_id": 110,
   "arabic": "وَ لَا يَرُدُّ سَخَطَكَ إِلَّا عَفْوُكَ"
  },
  {
   "segment_id": 111,
   "arabic": "وَ لا يُجِيرُ مِنْ عِقَابِكَ إِلَّا رَحْمَتُكَ"
  },
  {
   "segment_id": 112,
   "arabic": "وَ لَا يُنْجِينِي مِنْكَ"
  },
  {
   "segment_id": 113,
   "arabic": "إِلَّا التَّضَرُّعُ إِلَيْكَ وَ بَيْنَ يَدَيْكَ"
  },
  {
   "segment_id": 114,
   "arabic": "فَصَلِّ عَلَى مُحَمَّدٍ وَ آلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 115,
   "arabic": "وَ هَبْ لَنَا يَا إِلَهِي مِنْ لَدُنْكَ فَرَجاً"
  },
  {
   "segment_id": 116,
   "arabic": "بِالْقُدْرَةِ الَّتِي بِهَا تُحْيِي أَمْوَاتَ الْعِبَادِ"
  },
  {
   "segment_id": 117,
   "arabic": "وَ بِهَا تَنْشُرُ مَيْتَ الْبِلَادِ"
  },
  {
   "segment_id": 118,
   "arabic": "وَ لَا تُهْلِكْنِي يَا إِلَهِي غَمّاً"
  },
  {
   "segment_id": 119,
   "arabic": "حَتَّى تَسْتَجِيبَ لِي"
  },
  {
   "segment_id": 120,
   "arabic": "وَ تُعَرِّفَنِي الْإِجَابَةَ فِي دُعَائِي"
  },
  {
   "segment_id": 121,
   "arabic": "وَ أَذِقْنِي طَعْمَ الْعَافِيَةِ إِلَى مُنْتَهَى أَجَلِي"
  },
  {
   "segment_id": 122,
   "arabic": "وَ لَا تُشْمِتْ بِي عَدُوِّي"
  },
  {
   "segment_id": 123,
   "arabic": "وَ لَا تُمَكِّنْهُ مِنْ عُنُقِي"
  },
  {
   "segment_id": 124,
   "arabic": "وَ لَا تُسَلِّطْهُ عَلَيَّ"
  },
  {
   "segment_id": 125,
   "arabic": "إِلَهِي إِنْ رَفَعْتَنِي"
  },
  {
   "segment_id": 126,
   "arabic": "فَمَنْ ذَا الَّذِي يَضَعُنِي"
  },
  {
   "segment_id": 127,
   "arabic": "وَ إِنْ وَضَعْتَنِي"
  },
  {
   "segment_id": 128,
   "arabic": "فَمَنْ ذَا الَّذِي يَرْفَعُنِي"
  },
  {
   "segment_id": 129,
   "arabic": "وَ إِنْ أَكْرَمْتَنِي"
  },
  {
   "segment_id": 130,
   "arabic": "فَمَنْ ذَا الَّذِي يُهِينُنِي"
  },
  {
   "segment_id": 131,
   "arabic": "وَ إِنْ أَهَنْتَنِي"
  },
  {
   "segment_id": 132,
   "arabic": "فَمَنْ ذَا الَّذِي يُكْرِمُنِي"
  },
  {
   "segment_id": 133,
   "arabic": "وَ إِنْ عَذَّبْتَنِي"
  },
  {
   "segment_id": 134,
   "arabic": "فَمَنْ ذَا الَّذِي يَرْحَمُنِي"
  },
  {
   "segment_id": 135,
   "arabic": "وَ إِنْ أَهْلَكْتَنِي"
  },
  {
   "segment_id": 136,
   "arabic": "فَمَنْ ذَا الَّذِي يَعْرِضُ لَكَ فِي عَبْدِكَ"
  },
  {
   "segment_id": 137,
   "arabic": "أَوْ يَسْأَلُكَ عَنْ أَمْرِهِ"
  },
  {
   "segment_id": 138,
   "arabic": "وَ قَدْ عَلِمْتُ أَنَّهُ لَيْسَ فِي حُكْمِكَ ظُلْمٌ"
  },
  {
   "segment_id": 139,
   "arabic": "وَ لَا فِي نَقِمَتِكَ عَجَلَةٌ"
  },
  {
   "segment_id": 140,
   "arabic": "وَ إِنَّمَا يَعْجَلُ مَنْ يَخَافُ الْفَوْتَ"
  },
  {
   "segment_id": 141,
   "arabic": "وَ إِنَّمَا يَحْتَاجُ إِلَى الظُّلْمِ الضَّعِيفُ"
  },
  {
   "segment_id": 142,
   "arabic": "وَ قَدْ تَعَالَيْتَ يَا إِلَهِي"
  },
  {
   "segment_id": 143,
   "arabic": "عَنْ ذَلِكَ عُلُوّاً كَبِيراً"
  },
  {
   "segment_id": 144,
   "arabic": "اللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَ آلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 145,
   "arabic": "وَ لَا تَجْعَلْنِي لِلْبَلَاءِ غَرَضاً"
  },
  {
   "segment_id": 146,
   "arabic": "وَ لَا لِنَقِمَتِكَ نَصَباً"
  },
  {
   "segment_id": 147,
   "arabic": "وَ مَهِّلْنِي، وَ نَفِّسْنِي"
  },
  {
   "segment_id": 148,
   "arabic": "وَ أَقِلْنِي عَثْرَتِي"
  },
  {
   "segment_id": 149,
   "arabic": "وَ لَا تَبْتَلِيَنِّي بِبَلَاءٍ"
  },
  {
   "segment_id": 150,
   "arabic": "عَلَى أَثَرِ بَلَاءٍ"
  },
  {
   "segment_id": 151,
   "arabic": "فَقَدْ تَرَى ضَعْفِي"
  },
  {
   "segment_id": 152,
   "arabic": "وَ قِلَّةَ حِيلَتِي"
  },
  {
   "segment_id": 153,
   "arabic": "وَ تَضَرُّعِي إِلَيْكَ"
  },
  {
   "segment_id": 154,
   "arabic": "أَعُوذُ بِكَ اللَّهُمَّ الْيَوْمَ مِنْ غَضَبِكَ"
  },
  {
   "segment_id": 155,
   "arabic": "فَصَلِّ عَلَى مُحَمَّدٍ وَ آلِهِ وَ أَعِذْنِي."
  },
  {
   "segment_id": 156,
   "arabic": "وَ أَسْتَجِيرُ بِكَ الْيَوْمَ مِنْ سَخَطِكَ"
  },
  {
   "segment_id": 157,
   "arabic": "فَصَلِّ عَلَى مُحَمَّدٍ وَ آلِهِ وَ أَجِرْنِي"
  },
  {
   "segment_id": 158,
   "arabic": "وَ أَسْأَلُكَ أَمْناً مِنْ عَذَابِكَ"
  },
  {
   "segment_id": 159,
   "arabic": "فَصَلِّ عَلَى مُحَمَّدٍ وَ آلِهِ، وَ آمِنِّي"
  },
  {
   "segment_id": 160,
   "arabic": "وَ أَسْتَهْدِيكَ"
  },
  {
   "segment_id": 161,
   "arabic": "فَصَلِّ عَلَى مُحَمَّدٍ وَ آلِهِ وَ اهْدِنِي"
  },
  {
   "segment_id": 162,
   "arabic": "وَ أَسْتَنْصِرُكَ"
  },
  {
   "segment_id": 163,
   "arabic": "فَصَلِّ عَلَى مُحَمَّدٍ وَ آلِهِ، وَ انْصُرْنِي"
  },
  {
   "segment_id": 164,
   "arabic": "وَ أَسْتَرْحِمُكَ"
  },
  {
   "segment_id": 165,
   "arabic": "فَصَلِّ عَلَى مُحَمَّدٍ وَ آلِهِ، وَ ارْحَمْنِي"
  },
  {
   "segment_id": 166,
   "arabic": "وَ أَسْتَكْفِيكَ"
  },
  {
   "segment_id": 167,
   "arabic": "فَصَلِّ عَلَى مُحَمَّدٍ وَ آلِهِ، وَ اكْفِنِي"
  },
  {
   "segment_id": 168,
   "arabic": "وَ أَسْتَرْزِقُكَ"
  },
  {
   "segment_id": 169,
   "arabic": "فَصَلِّ عَلَى مُحَمَّدٍ وَ آلِهِ، وَ ارْزُقْنِي"
  },
  {
   "segment_id": 170,
   "arabic": "وَ أَسْتَعِينُكَ"
  },
  {
   "segment_id": 171,
   "arabic": "فَصَلِّ عَلَى مُحَمَّدٍ وَ آلِهِ وَ أَعِنِّي"
  },
  {
   "segment_id": 172,
   "arabic": "وَ أَسْتَغْفِرُكَ لِمَا سَلَفَ مِنْ ذُنُوبِي"
  },
  {
   "segment_id": 173,
   "arabic": "فَصَلِّ عَلَى مُحَمَّدٍ وَ آلِهِ، وَ اغْفِرْ لِي"
  },
  {
   "segment_id": 174,
   "arabic": "وَ أَسْتَعْصِمُكَ"
  },
  {
   "segment_id": 175,
   "arabic": "فَصَلِّ عَلَى مُحَمَّدٍ وَ آلِهِ، وَ اعْصِمْنِي"
  },
  {
   "segment_id": 176,
   "arabic": "فَإِنِّي لَنْ أَعُودَ لِشَيْ‏ءٍ كَرِهْتَهُ مِنِّي إِنْ شِئْتَ ذَلِكَ"
  },
  {
   "segment_id": 177,
   "arabic": "يَا رَبِّ يَا رَبِّ، يَا حَنَّانُ يَا مَنَّانُ"
  },
  {
   "segment_id": 178,
   "arabic": "يَا ذَا الْجَلَالِ وَ الْإِكْرَامِ"
  },
  {
   "segment_id": 179,
   "arabic": "صَلِّ عَلَى مُحَمَّدٍ وَ آلِهِ"
  },
  {
   "segment_id": 180,
   "arabic": "وَ اسْتَجِبْ لِي جَمِيعَ"
  },
  {
   "segment_id": 181,
   "arabic": "مَا سَأَلْتُكَ وَ طَلَبْتُ إِلَيْكَ"
  },
  {
   "segment_id": 182,
   "arabic": "وَ رَغِبْتُ فِيهِ إِلَيْكَ"
  },
  {
   "segment_id": 183,
   "arabic": "وَ أَرِدْهُ وَ قَدِّرْهُ وَ اقْضِهِ وَ أَمْضِهِ"
  },
  {
   "segment_id": 184,
   "arabic": "وَ خِرْ لِي فِيمَا تَقْضِي مِنْه"
  },
  {
   "segment_id": 185,
   "arabic": "وَ بَارِكْ لِي فِي ذَلِكَ"
  },
  {
   "segment_id": 186,
   "arabic": "وَ تَفَضَّلْ عَلَيَّ بِهِ"
  },
  {
   "segment_id": 187,
   "arabic": "وَ أَسْعِدْنِي بِمَا تُعْطِينِي مِنْهُ"
  },
  {
   "segment_id": 188,
   "arabic": "وَ زِدْنِي مِنْ فَضْلِكَ"
  },
  {
   "segment_id": 189,
   "arabic": "وَ سَعَةِ مَا عِنْدَكَ"
  },
  {
   "segment_id": 190,
   "arabic": "فَإِنَّكَ وَاسِعٌ كَرِيمٌ"
  },
  {
   "segment_id": 191,
   "arabic": "وَ صِلْ ذَلِكَ بِخَيْرِ الْآخِرَةِ وَ نَعِيمِهَا"
  },
  {
   "segment_id": 192,
   "arabic": "يَا أَرْحَمَ الرَّاحِمِينَ"
  },
  {
   "segment_id": 193,
   "arabic": "تَدْعُو بِمَا بَدَا لَكَ، وَ تُصَلِّي عَلَى مُحَمَّدٍ وَ آلِهِ أَلْفَ مَرَّةٍ هَكَذَا كَانَ يَفْعَلُ عَلَيْهِ السَّلَامُ"
  }
 ]
}