{
 "dua_id": "sahifa-40",
 "dua_name_en": "Sahifa 40: When he remembered death",
 "dua_name_ar": "دُعَاؤُهُ إذا ذَكَرَ الْمَوْتِ",
 "source": "https://duas.pro/40-when-he-remembered-death",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "أَللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 2,
   "arabic": "وَاكْفِنَا طُولَ الْأَمَلِ وَقَصِّرْهُ عَنَّا بِصِدْقِ الْعَمَلِ"
  },
  {
   "segment_id": 3,
   "arabic": "حَتَّى لَا نُؤَمِّلَ اسْتِتْمَامَ سَاعَةٍ بَعْدَ سَاعَةٍ"
  },
  {
   "segment_id": 4,
   "arabic": "وَلَا اسْتِيفَاءَ يَوْمٍ بَعْدَ يَوْمٍ"
  },
  {
   "segment_id": 5,
   "arabic": "وَلَا اتِّصَالَ نَفَسٍ بِنَفَسٍ"
  },
  {
   "segment_id": 6,
   "arabic": "وَلَا لُحُوقَ قَدَمٍ بِقَدَمٍ"
  },
  {
   "segment_id": 7,
   "arabic": "وَسَلِّمْنَا مِنْ غُرُورِهِ وَآمِنَّا مِنْ شُرُورِهِ"
  },
  {
   "segment_id": 8,
   "arabic": "وَانْصِبِ الْمَوْتَ بَيْنَ أَيْدِينَا نَصْبًا"
  },
  {
   "segment_id": 9,
   "arabic": "وَلَا تَجْعَلْ ذِكْرَنَا لَهُ غِبًّا"
  },
  {
   "segment_id": 10,
   "arabic": "وَاجْعَلْ لَنَا مِنْ صَالِحِ الْأَعْمَالِ"
  },
  {
   "segment_id": 11,
   "arabic": "عَمَلًا نَسْتَبْطِئُ مَعَهُ الْمَصِيرَ إِلَيْكَ"
  },
  {
   "segment_id": 12,
   "arabic": "وَنَحْرِصُ لَهُ عَلَى وَشْكِ اللِّحَاقِ بِكَ"
  },
  {
   "segment_id": 13,
   "arabic": "حَتَّى يَكُونَ الْمَوْتُ مَأْنَسَنَا الَّذِي نَأْنَسُ بِهِ"
  },
  {
   "segment_id": 14,
   "arabic": "وَمَأْلَفَنَا الَّذِي نَشْتَاقُ إِلَيْهِ"
  },
  {
   "segment_id": 15,
   "arabic": "وَحَامَّتَنَا الَّتِي نُحِبُّ الدُّنُوَّ مِنْهَا"
  },
  {
   "segment_id": 16,
   "arabic": "فَإِذَا أَوْرَدْتَهُ عَلَيْنَا وَأَنْزَلْتَهُ بِنَا"
  },
  {
   "segment_id": 17,
   "arabic": "فَأَسْعِدْنَا بِهِ زَائِرًا وَآنِسْنَا بِهِ قَادِمًا"
  },
  {
   "segment_id": 18,
   "arabic": "وَلَا تُشْقِنَا بِضِيَافَتِهِ وَلَا تُخْزِنَا بِزِيَارَتِهِ"
  },
  {
   "segment_id": 19,
   "arabic": "وَاجْعَلْهُ بَابًا مِنْ أَبْوَابِ مَغْفِرَتِكَ"
  },
  {
   "segment_id": 20,
   "arabic": "وَمِفْتَاحًا مِنْ مَفَاتِيحِ رَحْمَتِكَ"
  },
  {
   "segment_id": 21,
   "arabic": "أَمِتْنَا مُهْتَدِينَ غَيْرَ ضَالِّينَ"
  },
  {
   "segment_id": 22,
   "arabic": "طَائِعِينَ غَيْرَ مُسْتَكْرِهِينَ"
  },
  {
   "segment_id": 23,
   "arabic": "تَائِبِينَ غَيْرَ عَاصِينَ وَلَا مُصِرِّينَ"
  },
  {
   "segment_id": 24,
   "arabic": "يَا ضَامِنَ جَزَاءِ الْمُحْسِنِينَ"
  },
  {
   "segment_id": 25,
   "arabic": "وَمُسْتَصْلِحَ عَمَلِ الْمُفْسِدِينَ"
  }
 ]
}