{
 "dua_id": "duasorg-sahifa-fatimiya-dua-for-hereafter",
 "dua_name_en": "Dua of Sayeda Fatima (sa) for the hereafter",
 "dua_name_ar": "",
 "source": "https://www.duas.org/sahifa-fatimiya-dua-for-hereafter.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللَّهُمَّ قَنِّعْنِي بِمَا رَزَقْتَنِي"
  },
  {
   "segment_id": 2,
   "arabic": "وَ اسْتُرْنِي وَ عَافِنِي أَبَدًا مَا أَبْقَيْتَنِي"
  },
  {
   "segment_id": 3,
   "arabic": "وَ اغْفِرْ لِي وَ ارْحَمْنِي إِذَا تَوَفَّيْتَنِي"
  },
  {
   "segment_id": 4,
   "arabic": "اَللَّهُمَّ لَا تُعْيِنِي فِي طَلَبِ مَا لَمْ تُقَدِّرْ لِي"
  },
  {
   "segment_id": 5,
   "arabic": "وَ مَا قَدَّرْتَهُ فَاجْعَلْهُ مُيَسَّرًا سَهْلًا"
  },
  {
   "segment_id": 6,
   "arabic": "اَللَّهُمَّ كَافِ عَنِّي وَالِدَيَّ"
  },
  {
   "segment_id": 7,
   "arabic": "وَ كُلَّ مَنْ لَهُ نِعْمَةٌ عَلَيَّ خَيْرَ مُكَافَأَةٍ"
  },
  {
   "segment_id": 8,
   "arabic": "اَللَّهُمَّ فَرِّغْنِي لِمَا خَلَقْتَنِي لَهُ"
  },
  {
   "segment_id": 9,
   "arabic": "وَ لَا تَشْغَلْنِي بِمَا تَكَفَّلْتَ لِي بِهِ"
  },
  {
   "segment_id": 10,
   "arabic": "وَ لَا تُعَذِّبْنِي وَ أَنَا أَسْتَغْفِرُكَ"
  },
  {
   "segment_id": 11,
   "arabic": "وَ لَا تَحْرِمْنِي وَ أَنَا أَسْأَلُكَ"
  },
  {
   "segment_id": 12,
   "arabic": "اَللَّهُمَّ ذَلِّلْ نَفْسِي فِي نَفْسِي"
  },
  {
   "segment_id": 13,
   "arabic": "وَ عَظِّمْ شَأْنَكَ فِي نَفْسِي"
  },
  {
   "segment_id": 14,
   "arabic": "وَ أَلْهِمْنِي طَاعَتَكَ"
  },
  {
   "segment_id": 15,
   "arabic": "وَ الْعَمَلَ بِمَا يُرْضِيكَ"
  },
  {
   "segment_id": 16,
   "arabic": "وَ التَّجَنُّبَ لِمَا يُسْخِطُكَ"
  },
  {
   "segment_id": 17,
   "arabic": "يَا أَرْحَمَ الرَّاحِمِينَ"
  }
 ]
}