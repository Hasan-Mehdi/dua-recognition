{
 "dua_id": "sahifa-14",
 "dua_name_en": "Sahifa 14: When hostility was shown to him",
 "dua_name_ar": "دُعَاؤُهُ فِي الظُّلَامَاتِ",
 "source": "https://duas.pro/14-when-hostility-was-shown-to-him",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "يَا مَنْ لَا يَخْفَى عَلَيْهِ أَنْبَاءُ الْمُتَظَلِّمِينَ"
  },
  {
   "segment_id": 2,
   "arabic": "وَيَا مَنْ لَا يَحْتَاجُ فِي قِصَصِهِمْ"
  },
  {
   "segment_id": 3,
   "arabic": "إِلَى شَهَادَاتِ الشَّاهِدِينَ"
  },
  {
   "segment_id": 4,
   "arabic": "وَيَا مَنْ قَرُبَتْ نُصْرَتُهُ مِنَ الْمَظْلُومِينَ"
  },
  {
   "segment_id": 5,
   "arabic": "وَيَا مَنْ بَعُدَ عَوْنُهُ عَنِ الظَّالِمِينَ"
  },
  {
   "segment_id": 6,
   "arabic": "قَدْ عَلِمْتَ يَا إِلَهِي مَا نَالَنِي"
  },
  {
   "segment_id": 7,
   "arabic": "مِنْ فُلَانٍ بْنِ فُلَانٍ مِمَّا حَظَرْتَ"
  },
  {
   "segment_id": 8,
   "arabic": "وَانْتَهَكَهُ مِنِّي مِمَّا حَجَزْتَ عَلَيْهِ"
  },
  {
   "segment_id": 9,
   "arabic": "بَطَرًا فِي نِعْمَتِكَ عِنْدَهُ"
  },
  {
   "segment_id": 10,
   "arabic": "وَاغْتِرَارًا بِنَكِيرِكَ عَلَيْهِ"
  },
  {
   "segment_id": 11,
   "arabic": "أَللَّهُمَّ فَصَلِّ عَلَى مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 12,
   "arabic": "وَخُذْ ظَالِمِي وَعَدُوِّي عَنْ ظُلْمِي"
  },
  {
   "segment_id": 13,
   "arabic": "بِقُوَّتِكَ وَافْلُلْ حَدَّهُ عَنِّْي"
  },
  {
   "segment_id": 14,
   "arabic": "بِقُدْرَتِكَ وَاجْعَلْ لَهُ شُغْلًا"
  },
  {
   "segment_id": 15,
   "arabic": "فِيمَا يَلِيهِ وَعَجْزًا عَمَّا يُنَاوِيهِ"
  },
  {
   "segment_id": 16,
   "arabic": "أَللَّهُمَّ وَصَلِّ عَلَى مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 17,
   "arabic": "وَلَا تُسَوِّغْ لَهُ ظُلْمِي"
  },
  {
   "segment_id": 18,
   "arabic": "وَأَحْسِنْ عَلَيْهِ عَوْنِي"
  },
  {
   "segment_id": 19,
   "arabic": "وَاعْصِمْنِي مِنْ مِثْلِ أَفْعَالِهِ"
  },
  {
   "segment_id": 20,
   "arabic": "وَلَا تَجْعَلْنِي فِي مِثْلِ حَالِهِ"
  },
  {
   "segment_id": 21,
   "arabic": "أَللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 22,
   "arabic": "وَأَعِدْنِي عَلَيْهِ عَدْوَى حَاضِرَةً"
  },
  {
   "segment_id": 23,
   "arabic": "تَكُونُ مِنْ غَيْظِي بِهِ شِفَاءً"
  },
  {
   "segment_id": 24,
   "arabic": "وَمِنْ حَنَقِي عَلَيْهِ وَفَاءً"
  },
  {
   "segment_id": 25,
   "arabic": "أَللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 26,
   "arabic": "وَعَوِّضْنِي مِنْ ظُلْمِهِ لِي عَفْوَكَ"
  },
  {
   "segment_id": 27,
   "arabic": "وَأَبْدِلْنِي بِسُوءِ صَنِيعِهِ بِي"
  },
  {
   "segment_id": 28,
   "arabic": "رَحْمَتَكَ فَكُلُّ مَكْرُوهٍ جَلَلٌ"
  },
  {
   "segment_id": 29,
   "arabic": "دُونَ سَخَطِكَ وَكُلُّ مُرْزِئَةٍ"
  },
  {
   "segment_id": 30,
   "arabic": "سَوَاءٌ مَعَ مَوْجِدَتِكَ"
  },
  {
   "segment_id": 31,
   "arabic": "أَللَّهُمَّ فَكَمَا كَرَّهْتَ إِلَيَّ أَنْ أَظْلِمَ"
  },
  {
   "segment_id": 32,
   "arabic": "فَقِنِي مِنْ أَنْ أُظْلَمَ"
  },
  {
   "segment_id": 33,
   "arabic": "أَللَّهُمَّ لَا أَشْكُو إِلَى أَحَدٍ سِوَاكَ"
  },
  {
   "segment_id": 34,
   "arabic": "وَلَا أَسْتَعِينُ بِحَاكِمٍ غَيْرِكَ حَاشَاكَ"
  },
  {
   "segment_id": 35,
   "arabic": "فَصَلِّ عَلَى مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 36,
   "arabic": "وَصِلْ دُعَائِي بِالْإِجَابَةِ"
  },
  {
   "segment_id": 37,
   "arabic": "وَأَقْرِنْ شِكَايَتِي بِالتَّغْيِيرِ"
  },
  {
   "segment_id": 38,
   "arabic": "أَللَّهُمَّ لَا تَفْتِنِّي بِالْقُنُوطِ"
  },
  {
   "segment_id": 39,
   "arabic": "مِنْ إِنْصَافِكَ وَلَا تَفْتِنْهُ"
  },
  {
   "segment_id": 40,
   "arabic": "بِالْأَمْنِ مِنْ إِنْكَارِكَ"
  },
  {
   "segment_id": 41,
   "arabic": "فَيُصِرَّ عَلَى ظُلْمِي"
  },
  {
   "segment_id": 42,
   "arabic": "وَيُحَاضِرَنِي بِحَقِّي"
  },
  {
   "segment_id": 43,
   "arabic": "وَعَرِّفْهُ عَمَّا قَلِيلٍ مَا"
  },
  {
   "segment_id": 44,
   "arabic": "أَوْعَدْتَ الظَّالِمِينَ"
  },
  {
   "segment_id": 45,
   "arabic": "وَعَرِّفْنِي مَا وَعَدْتَ مِنْ"
  },
  {
   "segment_id": 46,
   "arabic": "إِجَابَةِ الْمُضْطَرِّينَ"
  },
  {
   "segment_id": 47,
   "arabic": "أَللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 48,
   "arabic": "وَوَفِّقْنِي لِقَبُولِ مَا قَضَيْتَ"
  },
  {
   "segment_id": 49,
   "arabic": "لِي وَعَلَيَّ وَرَضِّنِي"
  },
  {
   "segment_id": 50,
   "arabic": "بِمَا أَخَذْتَ لِي وَمِنِّي"
  },
  {
   "segment_id": 51,
   "arabic": "وَاهْدِنِي لِلَّتِي هِيَ أَقْوَمُ"
  },
  {
   "segment_id": 52,
   "arabic": "وَاسْتَعْمِلْنِي بِمَا هُوَ أَسْلَمُ"
  },
  {
   "segment_id": 53,
   "arabic": "أَللَّهُمَّ وَإِنْ كَانَتِ الْخِيَرَةُ لِي"
  },
  {
   "segment_id": 54,
   "arabic": "عِنْدَكَ فِي تَأْخِيرِ الْأَخْذِ"
  },
  {
   "segment_id": 55,
   "arabic": "لِي وَتَرْكِ الِانْتِقَامِ مِمَّنْ"
  },
  {
   "segment_id": 56,
   "arabic": "ظَلَمَنِي إِلَى يَوْمِ الْفَصْلِ"
  },
  {
   "segment_id": 57,
   "arabic": "وَمَجْمَعِ الْخَصْمِ"
  },
  {
   "segment_id": 58,
   "arabic": "فَصَلِّ عَلَى مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 59,
   "arabic": "وَأَيِّدْنِي مِنْكَ بِنِيَّةٍ صَادِقَةٍ"
  },
  {
   "segment_id": 60,
   "arabic": "وَصَبْرٍ دَائِمٍ"
  },
  {
   "segment_id": 61,
   "arabic": "وَأَعِذْنِي مِنْ سُوءِ الرَّغْبَةِ"
  },
  {
   "segment_id": 62,
   "arabic": "وَهَلَعِ أَهْلِ الْحِرْصِ"
  },
  {
   "segment_id": 63,
   "arabic": "وَصَوِّرْ فِي قَلْبِي مِثَالَ"
  },
  {
   "segment_id": 64,
   "arabic": "مَا ادَّخَرْتَ لِي مِنْ ثَوَابِكَ"
  },
  {
   "segment_id": 65,
   "arabic": "وَأَعْدَدْتَ لِخَصْمِي مِنْ جَزَائِكَ"
  },
  {
   "segment_id": 66,
   "arabic": "وَعِقَابِكَ وَاجْعَلْ ذَلِكَ"
  },
  {
   "segment_id": 67,
   "arabic": "سَبَبًا لِقَنَاعَتِي بِمَا قَضَيْتَ"
  },
  {
   "segment_id": 68,
   "arabic": "وَثِقَتِي بِمَا تَخَيَّرْتَ"
  },
  {
   "segment_id": 69,
   "arabic": "آمِينَ رَبَّ الْعَالَمِينَ"
  },
  {
   "segment_id": 70,
   "arabic": "إِنَّكَ ذُو الْفَضْلِ الْعَظِيمِ"
  },
  {
   "segment_id": 71,
   "arabic": "وَأَنْتَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ"
  }
 ]
