{
 "dua_id": "mafatih-munajat-dhakireen",
 "dua_name_en": "Munajat Dhakireen",
 "dua_name_ar": "مناجاة الذاكرين",
 "source": "Mafatih al-Jinan (github.com/kazemcodes/MafatihDecoder); lines from reciters' pauses",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "إِلهي لَوْ لاَ الْواجِبُ مِنْ قَبُولِ أَمْرِكَ"
  },
  {
   "segment_id": 2,
   "arabic": "لَنَزَّهْتُكَ مِنْ ذِكْري إِيّاكَ"
  },
  {
   "segment_id": 3,
   "arabic": "عَلى أَنَّ ذِكْري لَكَ بِقَدْري لا بِقَدْرِكَ"
  },
  {
   "segment_id": 4,
   "arabic": "وَما عَسى أَنْ يَبْلُغَ مِقْداري حَتّى أُجْعَلَ مَحَلاًّ لِتَقْديسِكَ"
  },
  {
   "segment_id": 5,
   "arabic": "وَمِنْ أَعْظَمِ النِّعَمِ عَلَيْنا"
  },
  {
   "segment_id": 6,
   "arabic": "جَرَيانُ ذِكْرِكَ عَلى أَلْسِنَتِنا"
  },
  {
   "segment_id": 7,
   "arabic": "وَإِذْنُكَ لَنا بِدُعائِكَ وَتَنْزيهِكَ وَتَسْبيحِكَ"
  },
  {
   "segment_id": 8,
   "arabic": "إِلهي فَأَلْهِمْنا ذِكْرَكَ فِي الْخَلاءِ وَالْمَلاءِ"
  },
  {
   "segment_id": 9,
   "arabic": "وَاللَّيْلِ وَالنَّهارِ وَالإِعْلانِ وَالإِسْرارِ"
  },
  {
   "segment_id": 10,
   "arabic": "وَفِي السَّرّاءِ وَالضَّرّاءِ"
  },
  {
   "segment_id": 11,
   "arabic": "وَآنِسْنا بِالذِّكْرِ الْخَفِيِّ"
  },
  {
   "segment_id": 12,
   "arabic": "وَاسْتَعْمِلْنا بِالْعَمَلِ الزَّكِيِّ وَالسَّعْيِ الْمَرْضِيِّ"
  },
  {
   "segment_id": 13,
   "arabic": "وَجازِنا بِالْميزانِ الْوَفِيِّ"
  },
  {
   "segment_id": 14,
   "arabic": "إِلهي بِكَ هامَتِ الْقُلُوبُ الْوالِهَةُ"
  },
  {
   "segment_id": 15,
   "arabic": "وَعَلى مَعْرِفَتِكَ جُمِعَتِ الْعُقُولُ الْمُتَبايِنَةُ"
  },
  {
   "segment_id": 16,
   "arabic": "فَلا تَطْمَئِنُّ الْقُلُوبُ إِلاّ بِذِكْراكَ"
  },
  {
   "segment_id": 17,
   "arabic": "وَلا تَسْكُنُ النُّفُوسُ إِلاّ عِنْدَ رُؤْياكَ"
  },
  {
   "segment_id": 18,
   "arabic": "أَنْتَ الْمُسَبَّحُ في كُلِّ مَكانٍ"
  },
  {
   "segment_id": 19,
   "arabic": "وَالْمَعْبُودُ في كُلِّ زَمانٍ"
  },
  {
   "segment_id": 20,
   "arabic": "وَالْمَوْجُودُ في كُلِّ أَوانٍ"
  },
  {
   "segment_id": 21,
   "arabic": "وَالْمَدْعُوُّ بِكُلِّ لِسانٍ"
  },
  {
   "segment_id": 22,
   "arabic": "وَالْمُعَظَّمُ في كُلِّ جَنانٍ"
  },
  {
   "segment_id": 23,
   "arabic": "وَأَسْتَغْفِرُكَ مِنْ كُلِّ لَذَّةٍ بِغَيْرِ ذِكْرِكَ"
  },
  {
   "segment_id": 24,
   "arabic": "وَمِنْ كُلِّ راحَةٍ بِغَيْرِ أُنْسِكَ"
  },
  {
   "segment_id": 25,
   "arabic": "وَمِنْ كُلِّ سُرُورٍ بِغَيْرِ قُرْبِكَ"
  },
  {
   "segment_id": 26,
   "arabic": "وَمِنْ كُلِّ شُغْلٍ بِغَيْرِ طاعَتِكَ"
  },
  {
   "segment_id": 27,
   "arabic": "إِلهي أَنْتَ قُلْتَ وَقَوْلُكَ الْحَقُّ"
  },
  {
   "segment_id": 28,
   "arabic": "يا أَيُّهَا الَّذينَ آمَنُوا اذْكُرُوا اللّهَ ذِكْراً كَثيراً"
  },
  {
   "segment_id": 29,
   "arabic": "وَسَبِّحُوهُ بُكْرَةً وَأَصيلاً"
  },
  {
   "segment_id": 30,
   "arabic": "وَقُلْتَ وَقَوْلُكَ الْحَقُّ فَاذْكُرُوني أَذْكُرْكُمْ"
  },
  {
   "segment_id": 31,
   "arabic": "فَأَمَرْتَنا بِذِكْرِكَ وَوَعَدْتَنا عَلَيْهِ أَنْ تَذْكُرَنا"
  },
  {
   "segment_id": 32,
   "arabic": "تَشْريفاً لَنا وَتَفْخيماً وَإِعْظاماً"
  },
  {
   "segment_id": 33,
   "arabic": "وَها نَحْنُ ذاكِرُوكَ كَما أَمَرْتَنا"
  },
  {
   "segment_id": 34,
   "arabic": "فَأَنْجِزْ لَنا ما وَعَدْتَنا"
  },
  {
   "segment_id": 35,
   "arabic": "يا ذاكِرَ الذّاكِرينَ وَيا أَرْحَمَ الرّاحِمينَ"
  }
 ]
}