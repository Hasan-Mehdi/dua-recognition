{
 "dua_id": "duasorg-imam-mohammed-baqir-as-1",
 "dua_name_en": "Ziyarat of Imam Mohammed Baqer (as)",
 "dua_name_ar": "",
 "source": "https://www.duas.org/imam-mohammed-baqir-as.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "السَّلَامُ عَلَيْكَ أَيُّهَا الْبَاقِرُ لِعِلْمِ اللَّهِ"
  },
  {
   "segment_id": 2,
   "arabic": "السَّلَامُ عَلَيْكَ أَيُّهَا الْفَاحِصُ عَنْ دِينِ اللَّهِ"
  },
  {
   "segment_id": 3,
   "arabic": "السَّلَامُ عَلَيْكَ أَيُّهَا الْمُبَيِّنُ لِحُكْمِ اللَّهِ"
  },
  {
   "segment_id": 4,
   "arabic": "السَّلَامُ عَلَيْكَ أَيُّهَا الْقَائِمُ بِقِسْطِ اللَّهِ"
  },
  {
   "segment_id": 5,
   "arabic": "السَّلَامُ عَلَيْكَ أَيُّهَا النَّاصِحُ لِعِبَادِ اللَّهِ"
  },
  {
   "segment_id": 6,
   "arabic": "السَّلَامُ عَلَيْكَ أَيُّهَا الدَّاعِي إِلَى اللَّهِ"
  },
  {
   "segment_id": 7,
   "arabic": "السَّلَامُ عَلَيْكَ أَيُّهَا الدَّلِيلُ إِلَى اللَّهِ"
  },
  {
   "segment_id": 8,
   "arabic": "السَّلَامُ عَلَيْكَ أَيُّهَا الْفَضْلُ الْمُبِينُ"
  },
  {
   "segment_id": 9,
   "arabic": "السَّلَامُ عَلَيْكَ أَيُّهَا النُّورُ السَّاطِعُ"
  },
  {
   "segment_id": 10,
   "arabic": "السَّلَامُ عَلَيْكَ أَيُّهَا الْبَدْرُ اللَّامِعُ"
  },
  {
   "segment_id": 11,
   "arabic": "السَّلَامُ عَلَيْكَ أَيُّهَا الْحَقُّ الْأَبْلَجُ"
  },
  {
   "segment_id": 12,
   "arabic": "السَّلَامُ عَلَيْكَ أَيُّهَا السِّرَاجُ الْأَسْرَجُ"
  },
  {
   "segment_id": 13,
   "arabic": "السَّلَامُ عَلَيْكَ أَيُّهَا النَّجْمُ الْأَزْهَرُ"
  },
  {
   "segment_id": 14,
   "arabic": "السَّلَامُ عَلَيْكَ أَيُّهَا الْكَوْكَبُ الْأَبْهَرُ"
  },
  {
   "segment_id": 15,
   "arabic": "السَّلَامُ عَلَيْكَ أَيُّهَا الْمُنَزَّهُ عَنِ الْمُعْضِلَاتِ"
  },
  {
   "segment_id": 16,
   "arabic": "السَّلَامُ عَلَيْكَ أَيُّهَا الْمَعْصُومُ مِنَ الزَّلَّاتِ"
  },
  {
   "segment_id": 17,
   "arabic": "السَّلَامُ عَلَيْكَ أَيُّهَا الزَّكِيُّ فِي الْحَسَبِ"
  },
  {
   "segment_id": 18,
   "arabic": "السَّلَامُ عَلَيْكَ أَيُّهَا الرَّفِيعُ فِي النَّسَبِ"
  },
  {
   "segment_id": 19,
   "arabic": "السَّلَامُ عَلَيْكَ أَيُّهَا الْإِمَامُ الشَّفِيقُ"
  },
  {
   "segment_id": 20,
   "arabic": "السَّلَامُ عَلَيْكَ أَيُّهَا الْقَصْرُ الْمَشِيدُ"
  },
  {
   "segment_id": 21,
   "arabic": "السَّلَامُ عَلَيْكَ يَا حُجَّةَ اللَّهِ عَلَى الْخَلْقِ أَجْمَعِينَ"
  },
  {
   "segment_id": 22,
   "arabic": "أَشْهَدُ يَا مَوْلَايَ أَنَّكَ قَدْ صَدَعْتَ الْحَقَّ صَدْعاً"
  },
  {
   "segment_id": 23,
   "arabic": "وَبَقَرْتَ الْعِلْمَ بَقْراً"
  },
  {
   "segment_id": 24,
   "arabic": "وَنَثَرْتَهُ نَثْراً"
  },
  {
   "segment_id": 25,
   "arabic": "لَمْ تَأْخُذْكَ فِي اللَّهِ لَوْمَةُ لَائِمٍ"
  },
  {
   "segment_id": 26,
   "arabic": "وَكُنْتَ لِدِينِ اللَّهِ مُكَاتِماً"
  },
  {
   "segment_id": 27,
   "arabic": "وَقَضَيْتَ مَا كَانَ عَلَيْكَ"
  },
  {
   "segment_id": 28,
   "arabic": "أَخْرَجْتَ أَوْلِيَاءَكَ مِنْ وِلَايَةِ غَيْرِ اللَّهِ إِلَى وِلَايَةِ اللَّهِ"
  },
  {
   "segment_id": 29,
   "arabic": "وَأَمَرْتَ بِطَاعَةِ اللَّهِ"
  },
  {
   "segment_id": 30,
   "arabic": "وَنَهَيْتَ عَنْ مَعْصِيَةِ اللَّهِ"
  },
  {
   "segment_id": 31,
   "arabic": "حَتَّى قَبَضَكَ اللَّهُ إِلَى رِضْوَانِهِ"
  },
  {
   "segment_id": 32,
   "arabic": "وَذَهَبَ بِكَ إِلَى دَارِ كَرَامَتِهِ"
  },
  {
   "segment_id": 33,
   "arabic": "وَإِلَى مَسَاكِنِ أَصْفِيَائِهِ"
  },
  {
   "segment_id": 34,
   "arabic": "وَمُجَاوَرَةِ أَوْلِيَائِهِ"
  },
  {
   "segment_id": 35,
   "arabic": "وَالسَّلَامُ عَلَيْكَ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ"
  }
 ]
}