{
 "dua_id": "duasorg-ramadan-dua-daytime-daily-8",
 "dua_name_en": "Salawat",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-dua-daytime-daily.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "إِنَّ ٱللَّهَ وَمَلاَئِكَتَهُ يُصَلُّونَ عَلَىٰ ٱلنَّبِيِّ"
  },
  {
   "segment_id": 2,
   "arabic": "يَا أَيُّهَا ٱلَّذِينَ آمَنُوٱ صَلُّوٱ عَلَيْهِ وَسَلِّمُوٱ تَسْلِيماً"
  },
  {
   "segment_id": 3,
   "arabic": "لَبَّيْكَ يَا رَبِّ وَسَعْدَيْكَ وَسُبْحَانَكَ"
  },
  {
   "segment_id": 4,
   "arabic": "اللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 5,
   "arabic": "وَبَارِكْ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 6,
   "arabic": "كَمَا صَلَّيْتَ وَبَارَكْتَ عَلَىٰ إِبْرَاهِيمَ وَآلِ إِبْرَاهِيمَ"
  },
  {
   "segment_id": 7,
   "arabic": "إِنَّكَ حَمِيدٌ مَجِيدٌ"
  },
  {
   "segment_id": 8,
   "arabic": "اللَّهُمَّ ٱرْحَمْ مُحَمَّداً وَآلَ مُحَمَّدٍ"
  },
  {
   "segment_id": 9,
   "arabic": "كَمَا رَحِمْتَ إِبْرَاهِيمَ وَآلَ إِبْرَاهِيمَ"
  },
  {
   "segment_id": 10,
   "arabic": "إِنَّكَ حَمِيدٌ مَجِيدٌ"
  },
  {
   "segment_id": 11,
   "arabic": "اللَّهُمَّ سَلِّمْ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 12,
   "arabic": "كَمَا سَلَّمْتَ عَلَىٰ نُوحٍ فِي ٱلْعَالَمِينَ"
  },
  {
   "segment_id": 13,
   "arabic": "اللَّهُمَّ ٱمْنُنْ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 14,
   "arabic": "كَمَا مَنَنْتَ عَلَىٰ مُوسَىٰ وَهَارُونَ"
  },
  {
   "segment_id": 15,
   "arabic": "اللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ كَمَا شَرَّفْتَنَا بِهِ"
  },
  {
   "segment_id": 16,
   "arabic": "اللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ كَمَا هَدَيْتَنَا بِهِ"
  },
  {
   "segment_id": 17,
   "arabic": "اللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 18,
   "arabic": "وَٱبْعَثْهُ مَقَاماً مَحْمُوداً يَغْبِطُهُ بِهِ ٱلأَوَّلُونَ وَٱلآخِرُونَ"
  },
  {
   "segment_id": 19,
   "arabic": "عَلَىٰ مُحَمَّدٍ وَآلِهِ ٱلسَّلاَمُ كُلَّمَا طَلَعَتْ شَمْسٌ أَوْ غَرَبَتْ"
  },
  {
   "segment_id": 20,
   "arabic": "عَلَىٰ مُحَمَّدٍ وَآلِهِ ٱلسَّلاَمُ كُلَّمَا طَرَفَتْ عَيْنٌ أَوْ بَرَقَتْ"
  },
  {
   "segment_id": 21,
   "arabic": "عَلَىٰ مُحَمَّدٍ وَآلِهِ ٱلسَّلاَمُ كُلَّمَا ذُكِرَ ٱلسَّلاَمُ"
  },
  {
   "segment_id": 22,
   "arabic": "عَلَىٰ مُحَمَّدٍ وَآلِهِ ٱلسَّلاَمُ كُلَّمَا سَبَّحَ ٱللَّهَ مَلَكٌ أَوْ قَدَّسَهُ"
  },
  {
   "segment_id": 23,
   "arabic": "السَّلاَمُ عَلَىٰ مُحَمَّدٍ وَآلِهِ فِي ٱلأَوَّلِينَ"
  },
  {
   "segment_id": 24,
   "arabic": "وَٱلسَّلاَمُ عَلَىٰ مُحَمَّدٍ وَآلِهِ فِي ٱلآخِرِينَ"
  },
  {
   "segment_id": 25,
   "arabic": "وَٱلسَّلاَمُ عَلَىٰ مُحَمَّدٍ وَآلِهِ فِي ٱلدُّنْيَا وَٱلآخِرَةِ"
  },
  {
   "segment_id": 26,
   "arabic": "اللَّهُمَّ رَبَّ ٱلْبَلَدِ ٱلْحَرَامِ"
  },
  {
   "segment_id": 27,
   "arabic": "وَرَبَّ ٱلرُّكْنِ وَٱلْمَقَامِ"
  },
  {
   "segment_id": 28,
   "arabic": "وَرَبَّ ٱلْحِلِّ وَٱلْحَرَامِ"
  },
  {
   "segment_id": 29,
   "arabic": "أَبْلِغْ مُحَمَّداً نَبِيَّكَ عَنَّا ٱلسَّلاَمَ"
  },
  {
   "segment_id": 30,
   "arabic": "اللَّهُمَّ أَعْطِ مُحَمَّداً مِنَ ٱلْبَهَاءِ وَٱلنَّضْرَةِ"
  },
  {
   "segment_id": 31,
   "arabic": "وَٱلسُّرُورِ وَٱلْكَرَامَةِ وَٱلْغِبْطَةِ وَٱلْوَسِيلَةِ"
  },
  {
   "segment_id": 32,
   "arabic": "وَٱلْمَنْزِلَةِ وَٱلْمَقَامِ وَٱلشَّرَفِ وَٱلرِّفْعَةِ"
  },
  {
   "segment_id": 33,
   "arabic": "وَٱلشَّفَاعَةِ عِنْدَكَ يَوْمَ ٱلْقِيَامَةِ"
  },
  {
   "segment_id": 34,
   "arabic": "أَفْضَلَ مَا تُعْطِي أَحَداً مِنْ خَلْقِكَ"
  },
  {
   "segment_id": 35,
   "arabic": "وَأَعْطِ مُحَمَّداً فَوْقَ مَا تُعْطِي ٱلْخَلاَئِقَ"
  },
  {
   "segment_id": 36,
   "arabic": "مِنَ ٱلْخَيْرِ أَضْعَافاً كَثِيرَةً لاَ يُحْصِيهَا غَيْرُكَ"
  },
  {
   "segment_id": 37,
   "arabic": "اللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 38,
   "arabic": "أَطْيَبَ وَأَطْهَرَ وَأَزْكَىٰ وَأَنْمَىٰ"
  },
  {
   "segment_id": 39,
   "arabic": "وَأَفْضَلَ مَا صَلَّيْتَ عَلَىٰ أَحَدٍ مِنَ ٱلأَوَّلِينَ وَٱلآخِرِينَ"
  },
  {
   "segment_id": 40,
   "arabic": "وَعَلَىٰ أَحَدٍ مِنْ خَلْقِكَ يَا أَرْحَمَ ٱلرَّاحِمِينَ"
  },
  {
   "segment_id": 41,
   "arabic": "اللَّهُمَّ صَلِّ عَلَىٰ عَلِيٍّ أَمِيرِ ٱلْمُؤْمِنِينَ"
  },
  {
   "segment_id": 42,
   "arabic": "وَوَالِ مَنْ وَالاَهُ"
  },
  {
   "segment_id": 43,
   "arabic": "وَعَادِ مَنْ عَادَاهُ"
  },
  {
   "segment_id": 44,
   "arabic": "وَضَاعِفِ ٱلعَذَابَ عَلَىٰ مَنْ شَرِكَ فِي دَمِهِ"
  },
  {
   "segment_id": 45,
   "arabic": "اللَّهُمَّ صَلِّ عَلَىٰ فَاطِمَةَ بِنْتِ نَبِيِّكَ مُحَمَّدٍ عَلَيْهِ وَآلِهِ ٱلسَّلاَمُ"
  },
  {
   "segment_id": 46,
   "arabic": "وَوَالِ مَنْ وَالاَهَا"
  },
  {
   "segment_id": 47,
   "arabic": "وَعَادِ مَنْ عَادَاهَا"
  },
  {
   "segment_id": 48,
   "arabic": "وَضَاعِفِ ٱلْعَذَابَ عَلَىٰ مَنْ ظَلَمَهَا"
  },
  {
   "segment_id": 49,
   "arabic": "وَٱلعَنْ مَنْ آذَىٰ نَبِيَّكَ فِيهَا"
  },
  {
   "segment_id": 50,
   "arabic": "اللَّهُمَّ صَلِّ عَلَىٰ ٱلْحَسَنِ وَٱلْحُسَيْنِ إِمَامَيِ ٱلْمُسْلِمِينَ"
  },
  {
   "segment_id": 51,
   "arabic": "وَوَالِ مَنْ وَالاَهُمَا"
  },
  {
   "segment_id": 52,
   "arabic": "وَعَادِ مَنْ عَادَاهُمَا"
  },
  {
   "segment_id": 53,
   "arabic": "وَضَاعِفِ ٱلْعَذَابَ عَلَىٰ مَنْ شَرِكَ فِي دِمَائِهِمَا"
  },
  {
   "segment_id": 54,
   "arabic": "اللَّهُمَّ صَلِّ عَلَىٰ عَلِيِّ بْنِ ٱلْحُسَيْنِ إِمَامِ ٱلْمُسْلِمِينَ"
  },
  {
   "segment_id": 55,
   "arabic": "وَوَالِ مَنْ وَالاَهُ"
  },
  {
   "segment_id": 56,
   "arabic": "وَعَادِ مَنْ عَادَاهُ"
  },
  {
   "segment_id": 57,
   "arabic": "وَضَاعِفِ ٱلْعَذَابَ عَلَىٰ مَنْ ظَلَمَهُ"
  },
  {
