  },
  {
   "segment_id": 89,
   "arabic": "وَعَجِّلْ فَرَجَهُ"
  },
  {
   "segment_id": 90,
   "arabic": "اللَّهُمَّ صَلِّ عَلَىٰ ٱلْقَاسِمِ وَٱلطَّاهِرِ ٱبْنَيْ نَبِيِّكَ"
  },
  {
   "segment_id": 91,
   "arabic": "اللَّهُمَّ صَلِّ عَلَىٰ رُقَيَّةَ بِنْتِ نَبِيِّكَ"
  },
  {
   "segment_id": 92,
   "arabic": "وَٱلعَنْ مَنْ آذَىٰ نَبِيَّكَ فِيهَا"
  },
  {
   "segment_id": 93,
   "arabic": "اللَّهُمَّ صَلِّ عَلَىٰ أُمِّ كُلْثُومَ بِنْتِ نَبِيِّكَ"
  },
  {
   "segment_id": 94,
   "arabic": "وَٱلعَنْ مَنْ آذَىٰ نَبِيَّكَ فِيهَا"
  },
  {
   "segment_id": 95,
   "arabic": "اللَّهُمَّ صَلِّ عَلَىٰ ذُرِّيَّةِ نَبِيِّكَ"
  },
  {
   "segment_id": 96,
   "arabic": "اللَّهُمَّ ٱخْلُفْ نَبِيَّكَ فِي أَهْلِ بَيْتِهِ"
  },
  {
   "segment_id": 97,
   "arabic": "اللَّهُمَّ مَكِّنْ لَهُمْ فِي ٱلأَرْضِ"
  },
  {
   "segment_id": 98,
   "arabic": "اللَّهُمَّ ٱجْعَلْنَا مِنْ عَدَدِهِمْ وَمَدَدِهِمْ"
  },
  {
   "segment_id": 99,
   "arabic": "وَأَنْصَارِهِمْ عَلَىٰ ٱلْحَقِّ فِي ٱلسِّرِّ وَٱلْعَلانِيَةِ"
  },
  {
   "segment_id": 100,
   "arabic": "اللَّهُمَّ ٱطْلُبْ بِذَحْلِهِمْ وَوِتْرِهِمْ وَدِمَائِهِمْ"
  },
  {
   "segment_id": 101,
   "arabic": "وَكُفَّ عَنَّا وَعَنْهُمْ وَعَنْ كُلِّ مُؤْمِنٍ وَمُؤْمِنَةٍ"
  },
  {
   "segment_id": 102,
   "arabic": "بَأْسَ كُلِّ بَاغٍ وَطَاغٍ"
  },
  {
   "segment_id": 103,
   "arabic": "وَكُلِّ دَابَّةٍ أَنْتَ آخِذٌ بِنَاصِيَتِهَا"
  },
  {
   "segment_id": 104,
   "arabic": "إِنَّكَ أَشَدُّ بَأْساً وَأَشَدُّ تَنْكِيلاً"
  },
  {
   "segment_id": 105,
   "arabic": "يَا عُدَّتِي فِي كُرْبَتِي"
  },
  {
   "segment_id": 106,
   "arabic": "وَيَا صَاحِبِي فِي شِدَّتِي"
  },
  {
   "segment_id": 107,
   "arabic": "وَيَا وَلِيِّي فِي نِعْمَتِي"
  },
  {
   "segment_id": 108,
   "arabic": "وَيَا غَايَتِي فِي رَغْبَتِي"
  },
  {
   "segment_id": 109,
   "arabic": "أَنْتَ ٱلسَّاتِرُ عَوْرَتِي"
  },
  {
   "segment_id": 110,
   "arabic": "وَٱلْمُؤْمِنُ رَوْعَتِي"
  },
  {
   "segment_id": 111,
   "arabic": "وَٱلْمُقِيلُ عَثْرَتِي"
  },
  {
   "segment_id": 112,
   "arabic": "فَٱغْفِرْ لِي خَطِيئَتِي"
  },
  {
   "segment_id": 113,
   "arabic": "يَا أَرْحَمَ ٱلرَّاحِمِينَ"
  },
  {
   "segment_id": 114,
   "arabic": "اللَّهُمَّ إِنِّي أَدْعُوكَ لِهَمٍّ لاَ يُفَرِّجُهُ غَيْرُكَ"
  },
  {
   "segment_id": 115,
   "arabic": "وَلِرَحْمَةٍ لاَ تُنَالُ إِلاَّ بِكَ"
  },
  {
   "segment_id": 116,
   "arabic": "وَلِكَرْبٍ لاَ يَكْشِفُهُ إِلاَّ أَنْتَ"
  },
  {
   "segment_id": 117,
   "arabic": "وَلِرَغْبَةٍ لاَ تُبْلَغُ إِلاَّ بِكَ"
  },
  {
   "segment_id": 118,
   "arabic": "وَلِحَاجَةٍ لاَ يَقْضِيهَا إِلاَّ أَنْتَ"
  },
  {
   "segment_id": 119,
   "arabic": "اللَّهُمَّ فَكَمَا كَانَ مِنْ شَأْنِكَ مَا أَذِنْتَ لِي بِهِ مِنْ مَسْأَلَتِكَ"
  },
  {
   "segment_id": 120,
   "arabic": "وَرَحِمْتَنِي بِهِ مِنْ ذِكْرِكَ"
  },
  {
   "segment_id": 121,
   "arabic": "فَلْيَكُنْ مِنْ شَأْنِكَ سَيِّدِي ٱلإِجَابَةُ لِي فِيمَا دَعَوْتُكَ"
  },
  {
   "segment_id": 122,
   "arabic": "وَعَوَائِدُ ٱلإِفْضَالِ فِيمَا رَجَوْتُكَ"
  },
  {
   "segment_id": 123,
   "arabic": "وَٱلنَّجَاةُ مِمَّا فَزِعْتُ إِلَيْكَ فِيهِ"
  },
  {
   "segment_id": 124,
   "arabic": "فَإِنْ لَمْ أَكُنْ أَهْلاً أَنْ أَبْلُغَ رَحْمَتَكَ"
  },
  {
   "segment_id": 125,
   "arabic": "فَإِنَّ رَحْمَتَكَ أَهْلٌ أَنْ تَبْلُغَنِي وَتَسَعَنِي"
  },
  {
   "segment_id": 126,
   "arabic": "وَإِنْ لَمْ أَكُنْ لِلإِجَابَةِ أَهْلاً"
  },
  {
   "segment_id": 127,
   "arabic": "فَأَنْتَ أَهْلُ ٱلفَضْلِ"
  },
  {
   "segment_id": 128,
   "arabic": "وَرَحْمَتُكَ وَسِعَتْ كُلَّ شَيْءٍ"
  },
  {
   "segment_id": 129,
   "arabic": "فَلْتَسَعْنِي رَحْمَتُكَ يَا إِلٰهِي"
  },
  {
   "segment_id": 130,
   "arabic": "يَا كَرِيمُ أَسْأَلُكَ بِوَجْهِكَ ٱلْكَرِيمِ"
  },
  {
   "segment_id": 131,
   "arabic": "أَنْ تُصَلِّيَ عَلَىٰ مُحَمَّدٍ وَأَهْلِ بَيْتِهِ"
  },
  {
   "segment_id": 132,
   "arabic": "وَأَنْ تُفَرِّجَ هَمِّي"
  },
  {
   "segment_id": 133,
   "arabic": "وَتَكْشِفَ كَرْبِي وَغَمِّي"
  },
  {
   "segment_id": 134,
   "arabic": "وَتَرْحَمَنِي بِرَحْمَتِكَ"
  },
  {
   "segment_id": 135,
   "arabic": "وَتَرْزُقَنِي مِنْ فَضْلِكَ"
  },
  {
   "segment_id": 136,
   "arabic": "إِنَّكَ سَمِيعُ ٱلدُّعَاءِ قَرِيبٌ مُجِيبٌ"
  }
 ]
}