{
 "dua_id": "duasorg-dua-after-ziyarat-ashura-imam-husain",
 "dua_name_en": "Dua after Ziyarat Ashura",
 "dua_name_ar": "",
 "source": "https://www.duas.org/dua-after-ziyarat-ashura-imam-husain.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللَّهُمَّ إِنِّي لَكَ صَلَّيْتُ"
  },
  {
   "segment_id": 2,
   "arabic": "وَلَكَ رَكَعْتُ وَلَكَ سَجَدْتُ"
  },
  {
   "segment_id": 3,
   "arabic": "وَحْدَكَ لاََ شَرِيكَ لَكَ"
  },
  {
   "segment_id": 4,
   "arabic": "فَإِنَّهُ لاََ تَجُوزُ ٱلصَّلاَةُ"
  },
  {
   "segment_id": 5,
   "arabic": "وَٱلرُّكُوعُ وَٱلسُّجُودُ إِلاَّ لَكَ"
  },
  {
   "segment_id": 6,
   "arabic": "لاِنَّكَ انْتَ ٱللَّهُ لاََ إِلٰهَ إِلاَّ انْتَ"
  },
  {
   "segment_id": 7,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍٍ"
  },
  {
   "segment_id": 8,
   "arabic": "وَابْلِغْهُمْ عَنِّي افْضَلَ ٱلسَّلاَمِ وَٱلتَّحِيَّةِ"
  },
  {
   "segment_id": 9,
   "arabic": "وَٱرْدُدْ عَلَيَّ مِنْهُمُ ٱلسَّلاَمَ"
  },
  {
   "segment_id": 10,
   "arabic": "اَللَّهُمَّ وَهَاتَانِ ٱلرَّكْعَتَانِ هَدِيَّةٌ مِنِّي"
  },
  {
   "segment_id": 11,
   "arabic": "إِلَىٰ سَيِّدِي ٱلْحُسَيْنِ بْنِ عَلِيِّ"
  },
  {
   "segment_id": 12,
   "arabic": "عَلَيْهِمَا ٱلسَّلاَمُ"
  },
  {
   "segment_id": 13,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَعَلَيْهِ"
  },
  {
   "segment_id": 14,
   "arabic": "وَتَقَبَّلْهُمَا مِنِّي وَٱجْزِنِي عَليْهِمَا"
  },
  {
   "segment_id": 15,
   "arabic": "افْضَلَ امَلِي وَرَجَائِي فِيكَ وَفِي وَلِيِّكَ"
  },
  {
   "segment_id": 16,
   "arabic": "يَا وَلِيَّ ٱلْمُؤْمِنِينَ"
  },
  {
   "segment_id": 17,
   "arabic": "اَلسَّلاَمُ عَلَىٰ ٱلْحُسَيْنِ بْنِ عَلِيٍّ"
  },
  {
   "segment_id": 18,
   "arabic": "ٱلْمَظْلُومِ ٱلشَّهِيدِ"
  },
  {
   "segment_id": 19,
   "arabic": "قَتِيلِ ٱلْعَبَرَاتِ"
  },
  {
   "segment_id": 20,
   "arabic": "وَاسِيرِ ٱلْكُرُبَاتِ"
  },
  {
   "segment_id": 21,
   "arabic": "اَللَّهُمَّ إِنِّي اشْهَدُ انَّهُ وَلِيُّكَ وَٱبْنُ وَلِيِّكَ"
  },
  {
   "segment_id": 22,
   "arabic": "وَصَفِيُّكَ ٱلثَّائِرُ بِحَقِّكَ"
  },
  {
   "segment_id": 23,
   "arabic": "اكْرَمْتَهُ بِكَرَامَتِكَ"
  },
  {
   "segment_id": 24,
   "arabic": "وَخَتَمْتَ لَهُ بِٱلشَّهَادَةِ"
  },
  {
   "segment_id": 25,
   "arabic": "وَجَعَلْتَهُ سَيِّداً مِنَ ٱلسَّادَةِ"
  },
  {
   "segment_id": 26,
   "arabic": "وَقَائِداً مِنَ ٱلْقَادَةِ"
  },
  {
   "segment_id": 27,
   "arabic": "وَاكْرَمْتَهُ بِطِيبِ ٱلْوِلاَدَةِ"
  },
  {
   "segment_id": 28,
   "arabic": "وَاعْطَيْتَهُ مَوَاريثَ ٱلانْبِيَاءِ"
  },
  {
   "segment_id": 29,
   "arabic": "وَجَعَلْتَهُ حُجَّةً عَلَىٰ خَلْقِكَ مِنَ ٱلاوْصِيَاءِ"
  },
  {
   "segment_id": 30,
   "arabic": "فَاعْذَرَ فِي ٱلدُّعَاءِ"
  },
  {
   "segment_id": 31,
   "arabic": "وَمَنَحَ ٱلنَّصِيحَةَ"
  },
  {
   "segment_id": 32,
   "arabic": "وَبَذَلَ مُهْجَتَهُ فِيكَ"
  },
  {
   "segment_id": 33,
   "arabic": "حَتَّىٰ ٱسْتَنْقَذَ عِبَادَكَ مِنَ ٱلْجَهَالَةِ وَحَيْرَةِ ٱلضَّلاَلَةِ"
  },
  {
   "segment_id": 34,
   "arabic": "وَقَدْ تَوَازَرَ عَلَيْهِ مَنْ غَرَّتْهُ ٱلدُّنْيَا"
  },
  {
   "segment_id": 35,
   "arabic": "وَبَاعَ حَظَّهُ مِنَ ٱلآخِرَةِ بِٱلادْنَىٰ"
  },
  {
   "segment_id": 36,
   "arabic": "وَتَرَدَّىٰ فِي هَوَاهُ"
  },
  {
   "segment_id": 37,
   "arabic": "وَاسْخَطَكَ وَاسْخَطَ نَبِيَّكَ"
  },
  {
   "segment_id": 38,
   "arabic": "وَاطَاعَ مِنْ عِبَادِكَ اوْلِي ٱلشِّقَاقِ وَٱلنِّفَاقِ"
  },
  {
   "segment_id": 39,
   "arabic": "وَحَمَلَةَ ٱلاوْزَارِ ٱلْمُسْتَوْجِبِينَ ٱلنَّارَ"
  },
  {
   "segment_id": 40,
   "arabic": "فَجَاهَدَهُمْ فِيكَ صَابِراً مُحْتَسِباً"
  },
  {
   "segment_id": 41,
   "arabic": "مُقْبِلاًَ غَيْرَ مُدْبِرٍ"
  },
  {
   "segment_id": 42,
   "arabic": "لاََ تَاخُذُهُ فِي ٱللَّهِ لَوْمَةُ لاَئِمٍ"
  },
  {
   "segment_id": 43,
   "arabic": "حَتَّىٰ سُفِكَ فِي طَاعَتِكَ دَمُهُ"
  },
  {
   "segment_id": 44,
   "arabic": "وَٱسْتُبيحَ حَرِيـمُهُ"
  },
  {
   "segment_id": 45,
   "arabic": "اَللَّهُمَّ ٱلْعَنْهُمْ لَعْناً وَبِيلاًَ"
  },
  {
   "segment_id": 46,
   "arabic": "وَعَذِّبْهُمْ عَذَاباً الِيماً"
  }
 ]
}