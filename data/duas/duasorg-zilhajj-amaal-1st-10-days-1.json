{
 "dua_id": "duasorg-zilhajj-amaal-1st-10-days-1",
 "dua_name_en": "Salaat between Maghrib and Isha",
 "dua_name_ar": "",
 "source": "https://www.duas.org/zilhajj-amaal-1st-10-days.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "وَوَاعَدْنَا مُوسَىٰ ثَلَاثينَ لَيْلَةً"
  },
  {
   "segment_id": 2,
   "arabic": "وَأَتْمَمْنَاهَا بِعَشْرٍ"
  },
  {
   "segment_id": 3,
   "arabic": "فَتَمَّ مِيقَاتُ رَبِّهِ أَرْبَعينَ لَيْلَةً"
  },
  {
   "segment_id": 4,
   "arabic": "وَقَالَ مُوسَىٰ لِأَخِيهِ هَارُونَ ٱخْلُفْنِي فِي قَوْمِي"
  },
  {
   "segment_id": 5,
   "arabic": "وَأَصْلِحْ وَلَا تَتَّبِعْ سَبِيلَ ٱلْمُفْسِدِينَ"
  }
 ]
}