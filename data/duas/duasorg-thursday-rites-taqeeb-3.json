{
 "dua_id": "duasorg-thursday-rites-taqeeb-3",
 "dua_name_en": "Thursday Tasbih",
 "dua_name_ar": "",
 "source": "https://www.duas.org/thursday-rites-taqeeb.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "سُبْحَانَكَ لَا إِلَهَ إِلَّا أَنْتَ الْوَاسِعُ الَّذِي لَا يَضِيقُ"
  },
  {
   "segment_id": 2,
   "arabic": "الْبَصِيرُ الَّذِي لَا يَضِلُّ النُّورُ الَّذِي لَا يُخْمَدُ"
  },
  {
   "segment_id": 3,
   "arabic": "سُبْحَانَكَ لَا إِلَهَ إِلَّا أَنْتَ الْحَيُّ الَّذِي لَا يَمُوتُ"
  },
  {
   "segment_id": 4,
   "arabic": "الْقَيُّومُ الَّذِي لَا يَهِنُ الصَّمَدُ الَّذِي لَا يُطْعَمُ"
  },
  {
   "segment_id": 5,
   "arabic": "سُبْحَانَكَ لَا إِلَهَ إِلَّا أَنْتَ مَا أَعْظَمَ شَأْنَكَ"
  },
  {
   "segment_id": 6,
   "arabic": "[وَ أَعَزَّ سُلْطَانَكَ وَ أَعْلَى مَكَانَكَ [وَ أَشْمَخَ مُلْكَكَ‏"
  },
  {
   "segment_id": 7,
   "arabic": "سُبْحَانَكَ لَا إِلَهَ إِلَّا أَنْتَ مَا أَبَرَّكَ وَ أَرْحَمَكَ"
  },
  {
   "segment_id": 8,
   "arabic": "وَ أَحْلَمَكَ وَ أَعْظَمَكَ وَ أَسْمَحَكَ وَ أَجَلَّكَ"
  },
  {
   "segment_id": 9,
   "arabic": "وَ أَكْرَمَكَ وَ أَعْلَمَكَ وَ أَعَزَّكَ وَ أَعْلَاكَ"
  },
  {
   "segment_id": 10,
   "arabic": "وَ أَقْوَاكَ وَ أَسْمَعَكَ وَ أَبْصَرَكَ"
  },
  {
   "segment_id": 11,
   "arabic": "سُبْحَانَكَ لَا إِلَهَ إِلَّا أَنْتَ"
  },
  {
   "segment_id": 12,
   "arabic": "مَا أَكْرَمَ عَفْوَكَ وَ أَعْظَمَ تَجَاوُزَكَ"
  },
  {
   "segment_id": 13,
   "arabic": "سُبْحَانَكَ لَا إِلَهَ إِلَّا أَنْتَ"
  },
  {
   "segment_id": 14,
   "arabic": "مَا أَوْسَعَ رَحْمَتَكَ وَ أَكْثَرَ فَضْلَكَ"
  },
  {
   "segment_id": 15,
   "arabic": "سُبْحَانَكَ لَا إِلَهَ إِلَّا أَنْتَ"
  },
  {
   "segment_id": 16,
   "arabic": "مَا أَنْعَمَ آلَاءَكَ وَ أَسْبَغَ نَعْمَاءَكَ"
  },
  {
   "segment_id": 17,
   "arabic": "سُبْحَانَكَ لَا إِلَهَ إِلَّا أَنْتَ"
  },
  {
   "segment_id": 18,
   "arabic": "مَا أَفْضَلَ ثَوَابَكَ وَ أَجْزَلَ عَطَاءَكَ"
  },
  {
   "segment_id": 19,
   "arabic": "سُبْحَانَكَ لَا إِلَهَ إِلَّا أَنْتَ"
  },
  {
   "segment_id": 20,
   "arabic": "مَا أَوْسَعَ حُجَّتَكَ وَ أَوْضَحَ بُرْهَانَكَ"
  },
  {
   "segment_id": 21,
   "arabic": "سُبْحَانَكَ لَا إِلَهَ إِلَّا أَنْتَ"
  },
  {
   "segment_id": 22,
   "arabic": "مَا أَشَدَّ أَخْذَكَ وَ أَوْجَعَ عِقَابَكَ"
  },
  {
   "segment_id": 23,
   "arabic": "سُبْحَانَكَ لَا إِلَهَ إِلَّا أَنْتَ"
  },
  {
   "segment_id": 24,
   "arabic": "مَا أَشَدَّ مَكْرَكَ وَ أَمْتَنَ كَيْدَكَ"
  },
  {
   "segment_id": 25,
   "arabic": "سُبْحَانَكَ لَا إِلَهَ إِلَّا أَنْتَ"
  },
  {
   "segment_id": 26,
   "arabic": "تُسَبِّحُ لَكَ السَّمَاوَاتُ السَّبْعُ وَ الْأَرَضُونَ السَّبْعُ"
  },
  {
   "segment_id": 27,
   "arabic": "سُبْحَانَكَ لَا إِلَهَ إِلَّا أَنْتَ"
  },
  {
   "segment_id": 28,
   "arabic": "الْقَرِيبُ فِي عُلُوِّكَ الْمُتَعَالِي فِي دُنُوِّكَ الْمُتَدَانِي دُونَ كُلِّ شَيْ‏ءٍ مِنْ خَلْقِكَ"
  },
  {
   "segment_id": 29,
   "arabic": "سُبْحَانَكَ لَا إِلَهَ إِلَّا أَنْتَ"
  },
  {
   "segment_id": 30,
   "arabic": "الْقَرِيبُ قَبْلَ كُلِّ شَيْءٍ"
  },
  {
   "segment_id": 31,
   "arabic": "وَ الدَّائِمُ مَعَ كُلِّ شَيْ‏ءٍ"
  },
  {
   "segment_id": 32,
   "arabic": "وَ الْبَاقِي بَعْدَ فَنَاءِ كُلِّ شَيْءٍ"
  },
  {
   "segment_id": 33,
   "arabic": "سُبْحَانَكَ لَا إِلَهَ إِلَّا أَنْتَ"
  },
  {
   "segment_id": 34,
   "arabic": "تَصَاغَرَ كُلُّ شَيْ‏ءٍ لِجَبَرُوتِكَ"
  },
  {
   "segment_id": 35,
   "arabic": "وَ انْقَادَ كُلُّ شَيْ‏ءٍ لِسُلْطَانِكَ"
  },
  {
   "segment_id": 36,
   "arabic": "وَ ذَلَّ كُلُّ شَيْ‏ءٍ لِعِزَّتِكَ"
  },
  {
   "segment_id": 37,
   "arabic": "وَ خَضَعَ كُلُّ شَيْءٍ لِمُلْكِكَ"
  },
  {
   "segment_id": 38,
   "arabic": "وَ اسْتَسْلَمَ كُلُّ شَيْ‏ءٍ لِقُدْرَتِكَ"
  },
  {
   "segment_id": 39,
   "arabic": "سُبْحَانَكَ لَا إِلَهَ إِلَّا أَنْتَ"
  },
  {
   "segment_id": 40,
   "arabic": "مَلَكْتَ الْمُلُوكَ بِعَظَمَتِكَ"
  },
  {
   "segment_id": 41,
   "arabic": "وَ قَهَرْتَ الْجَبَابِرَةَ بِقُدْرَتِكَ"
  },
  {
   "segment_id": 42,
   "arabic": "وَ ذَلَّلْتَ الْعُظَمَاءَ بِعِزَّتِكَ"
  },
  {
   "segment_id": 43,
   "arabic": "سُبْحَانَكَ لَا إِلَهَ إِلَّا أَنْتَ"
  },
  {
   "segment_id": 44,
   "arabic": "تَسْبِيحاً يَفْضُلُ عَلَى تَسْبِيحِ الْمُسَبِّحِينَ"
  },
  {
   "segment_id": 45,
   "arabic": "كُلِّهِمْ مِنْ أَوَّلِ الدَّهْرِ إِلَى آخِرِهِ"
  },
  {
   "segment_id": 46,
   "arabic": "وَ مِلْ‏ءَ السَّمَاوَاتِ وَ الْأَرَضِينَ وَ مِلْ‏ءَ مَا خَلَقْتَ وَ مِلْ‏ءَ مَا قَدَّرْتَ"
  },
  {
   "segment_id": 47,
   "arabic": "سُبْحَانَكَ لَا إِلَهَ إِلَّا أَنْتَ"
  },
  {
   "segment_id": 48,
   "arabic": "تُسَبِّحُ لَكَ السَّمَاوَاتُ بِأَقْطَارِهَا"
  },
  {
   "segment_id": 49,
   "arabic": "وَ الشَّمْسُ فِي مَجَارِيهَا"
  },
  {
   "segment_id": 50,
   "arabic": "وَ الْقَمَرُ فِي مَنَازِلِهِ وَ النُّجُومُ فِي سَيَرَانِهَا"
  },
  {
   "segment_id": 51,
   "arabic": "وَ الْفَلَكُ فِي مَعَارِجِهِ"
  },
  {
   "segment_id": 52,
   "arabic": "سُبْحَانَكَ لَا إِلَهَ إِلَّا أَنْتَ"
  },
  {
   "segment_id": 53,
   "arabic": "يُسَبِّحُ لَكَ النَّهَارُ بِضَوْئِهِ وَ اللَّيْلُ بِدُجَائِهِ"
  },
  {
   "segment_id": 54,
   "arabic": "وَ النُّورُ بِشُعَاعِهِ وَ الظُّلْمَةُ بِغُمُوضِهَا"
  },
  {
   "segment_id": 55,
   "arabic": "سُبْحَانَكَ لَا إِلَهَ إِلَّا أَنْتَ"
  },
  {
   "segment_id": 56,
   "arabic": "تُسَبِّحُ لَكَ الرِّيَاحُ فِي مَهَبِّهَا"
  },
  {
   "segment_id": 57,
   "arabic": "وَ السَّحَابُ بِأَمْطَارِهَا"
  },
  {
   "segment_id": 58,
   "arabic": "وَ الْبَرْقُ بِأَخْطَافِهِ وَ الرَّعْدُ بِأَرْزَامِهِ"
  },
  {
   "segment_id": 59,
   "arabic": "سُبْحَانَكَ لَا إِلَهَ إِلَّا أَنْتَ"
  },
  {
   "segment_id": 60,
   "arabic": "تُسَبِّحُ لَكَ الْأَرْضُ بِأَقْوَاتِهَا"
  },
  {
   "segment_id": 61,
   "arabic": "وَ الْجِبَالُ بِأَطْوَادِهَا وَ الْأَشْجَارُ بِأَوْرَاقِهَا"
  },
  {
   "segment_id": 62,
   "arabic": "وَ الْمَرَاعِي فِي مَنَابِتِهَا"
  },
  {
   "segment_id": 63,
   "arabic": "سُبْحَانَكَ وَ بِحَمْدِكَ لَا إِلَهَ إِلَّا أَنْتَ وَحْدَكَ لَا شَرِيكَ لَكَ"
  },
  {
   "segment_id": 64,
   "arabic": "عَدَدَ مَا سَبَّحَكَ مِنْ شَيْ‏ءٍ"
  },
  {
   "segment_id": 65,
   "arabic": "وَ كَمَا تُحِبُّ يَا رَبِّ أَنْ تُحْمَدَ"
  },
  {
   "segment_id": 66,
   "arabic": "[ وَ كَمَا يَنْبَغِي لِعَظَمَتِكَ وَ كِبْرِيَائِكَ [وَ عِزِّكَ‏"
  },
  {
   "segment_id": 67,
   "arabic": "وَ عِزَّتِكَ وَ قُوَّتِكَ وَ قُدْرَتِكَ"
  },
  {
   "segment_id": 68,
   "arabic": "وَ صَلَّى اللهُ عَلَى رَسُولِهِ مُحَمَّدٍ خَاتَمِ النَّبِيِّينَ وَ آلِهِ أَجْمَعِينَ‏"
  }
 ]
}