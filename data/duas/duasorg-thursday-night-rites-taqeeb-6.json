{
 "dua_id": "duasorg-thursday-night-rites-taqeeb-6",
 "dua_name_en": "Friday Dua just Before Dawn",
 "dua_name_ar": "",
 "source": "https://www.duas.org/thursday-night-rites-taqeeb.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وآلِهِ"
  },
  {
   "segment_id": 2,
   "arabic": "وَهَبْ لِيَ ٱلْغَدَاةَ رِضَاكَ"
  },
  {
   "segment_id": 3,
   "arabic": "وَأَسْكِنْ قَلْبِي خَوْفَكَ"
  },
  {
   "segment_id": 4,
   "arabic": "وَٱقْطَعْهُ عَمَّنْ سِوَاكَ"
  },
  {
   "segment_id": 5,
   "arabic": "حَتَّىٰ لاَ أَرْجُوَ وَلاَ أَخَافَ إِلاَّ إِيَّاكَ"
  },
  {
   "segment_id": 6,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وآلِهِ"
  },
  {
   "segment_id": 7,
   "arabic": "وَهَبْ لِي ثَبَاتَ ٱلْيَقينِ"
  },
  {
   "segment_id": 8,
   "arabic": "وَمَحْضَ ٱلإِخْلاَصِ"
  },
  {
   "segment_id": 9,
   "arabic": "وَشَرَفَ ٱلتَّوْحيدِ"
  },
  {
   "segment_id": 10,
   "arabic": "وَدَوَامَ ٱلاِسْتِقَامَةِ"
  },
  {
   "segment_id": 11,
   "arabic": "وَمَعْدِنَ ٱلصِّبْرِ"
  },
  {
   "segment_id": 12,
   "arabic": "وَٱلرِّضَا بِٱلْقَضَاءِ وَٱلْقَدَرِ"
  },
  {
   "segment_id": 13,
   "arabic": "يَا قَاضِيَ حَوَائِجِ ٱلسَّائِلينَ"
  },
  {
   "segment_id": 14,
   "arabic": "يَا مَنْ يَعْلَمُ مَا فِي ضَمِيرِ ٱلصَّامِتِينَ"
  },
  {
   "segment_id": 15,
   "arabic": "صَلِّ عَلَىٰ مُحَمَّدٍ وآلِهِ"
  },
  {
   "segment_id": 16,
   "arabic": "وَٱسْتَجِبْ دُعَائِي"
  },
  {
   "segment_id": 17,
   "arabic": "وَٱغْفِرْ ذَنْبِي"
  },
  {
   "segment_id": 18,
   "arabic": "وَأَوْسِعْ رِزْقِي"
  },
  {
   "segment_id": 19,
   "arabic": "وَٱقْضِ حَوَائِجِي فِي نَفْسِي"
  },
  {
   "segment_id": 20,
   "arabic": "وَإِخْوَانِي فِي دِينِي وَأَهْلِي"
  },
  {
   "segment_id": 21,
   "arabic": "إِلٰهِي طُمُوحُ ٱلآمَالِ قَدْ خَابَتْ إِلاَّ لَدَيْكَ"
  },
  {
   "segment_id": 22,
   "arabic": "وَمَعَاكِفُ ٱلْهِمَمِ قَدْ تَعَطَّلَتْ إِلاَّ عَلَيْكَ"
  },
  {
   "segment_id": 23,
   "arabic": "وَمَذَاهِبُ ٱلْعُقُولِ قَدْ سَمَتْ إِلاَّ إِلَيْكَ"
  },
  {
   "segment_id": 24,
   "arabic": "فَأَنْتَ الَّرجَاءُ وَإِلَيْكَ الْمُلْتَجَأُ"
  },
  {
   "segment_id": 25,
   "arabic": "يَا أَكْرَمَ مَقْصُودٍ وَأَجْوَدَ مَسْؤُولٍ"
  },
  {
   "segment_id": 26,
   "arabic": "هَرَبْتُ إِلَيْكَ بِنَفْسِي"
  },
  {
   "segment_id": 27,
   "arabic": "يَا مَلْجَأَ ٱلْهَارِبِينَ بِأَثْقَالِ ٱلذُّنُوبِ"
  },
  {
   "segment_id": 28,
   "arabic": "أَحْمِلُهَا عَلَىٰ ظَهْرِي"
  },
  {
   "segment_id": 29,
   "arabic": "لاَ أَجِدُ لِي إِلَيْكَ شَافِعاً"
  },
  {
   "segment_id": 30,
   "arabic": "سِوَىٰ مَعْرِفَتِي بِأَنَّكَ أَقْرَبُ مَنْ رَجَاهُ ٱلطَّالِبُونَ"
  },
  {
   "segment_id": 31,
   "arabic": "وَأَمَّلَ مَا لَدَيْهِ ٱلرَّاغِبُونَ"
  },
  {
   "segment_id": 32,
   "arabic": "يَا مَنْ فَتَقَ ٱلْعُقُولَ بِمَعْرِفَتِهِ"
  },
  {
   "segment_id": 33,
   "arabic": "وَأَطْلَقَ ٱلأَلْسُنَ بِحَمْدِهِ"
  },
  {
   "segment_id": 34,
   "arabic": "وَجَعَلَ مَا ٱمْتَنَّ بِهِ عَلَىٰ عِبَادِهِ فِي كِفَاءٍ لِتَاْدِيَةِ حَقِّهِ"
  },
  {
   "segment_id": 35,
   "arabic": "صَلِّ عَلَىٰ مُحَمَّدٍ وآلِهِ"
  },
  {
   "segment_id": 36,
   "arabic": "وَلاَ تَجْعَلْ لِلشَّيْطَانِ عَلَىٰ عَقْلِي سَبيلاًَ"
  },
  {
   "segment_id": 37,
   "arabic": "وَلاَ لِلْبَاطِلِ عَلَىٰ عَمَلِي دَلِيلاً"
  }
 ]
}