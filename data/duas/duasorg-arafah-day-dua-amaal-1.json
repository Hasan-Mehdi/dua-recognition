{
 "dua_id": "duasorg-arafah-day-dua-amaal-1",
 "dua_name_en": "1. Tasbeeh from Holy Prophet (sawa)",
 "dua_name_ar": "",
 "source": "https://www.duas.org/arafah-day-dua-amaal.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "سُبْحَانَ ٱلَّذِي فِي ٱلسَّمَاءِ عَرْشُهُ"
  },
  {
   "segment_id": 2,
   "arabic": "سُبْحَانَ ٱلَّذِي فِي ٱلأَرْضِ حُكْمُهُ"
  },
  {
   "segment_id": 3,
   "arabic": "سُبْحَانَ ٱلَّذِي فِي ٱلْقُبوُرِ قَضَاؤُهُ"
  },
  {
   "segment_id": 4,
   "arabic": "سُبْحَانَ ٱلَّذِي فِي ٱلْبَحْرِ سَبيلُهُ"
  },
  {
   "segment_id": 5,
   "arabic": "سُبْحَانَ ٱلَّذِي فِي ٱلنَّارِ سُلْطَانُهُ"
  },
  {
   "segment_id": 6,
   "arabic": "سُبْحَانَ ٱلَّذِي فِي ٱلْجَنَّةِ رَحْمَتُهُ"
  },
  {
   "segment_id": 7,
   "arabic": "سُبْحَانَ ٱلَّذِي فِي ٱلْقِيَامَةِ عَدْلُهُ"
  },
  {
   "segment_id": 8,
   "arabic": "سُبْحَانَ ٱلَّذِي رَفَعَ ٱلسَّمَاءِ"
  },
  {
   "segment_id": 9,
   "arabic": "سُبْحَانَ ٱلَّذِي بَسَطَ ٱلأَرْضَ"
  },
  {
   "segment_id": 10,
   "arabic": "سُبْحَانَ ٱلَّذِي لاَ مَلْجَأَ وَلاَ مَنْجَىً مِنْهُ إِلاَّ إِلَيْهِ"
  }
 ]
}