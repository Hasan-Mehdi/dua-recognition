{
 "dua_id": "duasorg-ziyarat-imam-husain-on-arafah-day-3",
 "dua_name_en": "Instruction Block",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ziyarat-imam-husain-on-arafah-day.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللَّهُمَّ إِنِّي صَلَّيْتُ وَرَكَعْتُ وَسَجَدْتُ"
  },
  {
   "segment_id": 2,
   "arabic": "لَكَ وَحْدَكَ لاَ شَرِيكَ لَكَ"
  },
  {
   "segment_id": 3,
   "arabic": "لأَنَّ ٱلصَّلاَةَ وَٱلرُّكُوعَ وَٱلسُّجُودَ"
  },
  {
   "segment_id": 4,
   "arabic": "لاَ تَكُونُ إِلاَّ لَكَ"
  },
  {
   "segment_id": 5,
   "arabic": "لِأَنَّكَ أَنْتَ ٱللَّهُ لاَ إِلٰهَ إِلاَّ أَنْتَ"
  },
  {
   "segment_id": 6,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 7,
   "arabic": "وَأَبْلِغْهُمْ عَنِّي أَفْضَلَ ٱلتَّحِيَّةِ وَٱلسَّلاَمِ"
  },
  {
   "segment_id": 8,
   "arabic": "وَٱرْدُدْ عَلَيَّ مِنْهُمُ ٱلتَّحِيَّةَ وَٱلسَّلاَمَ"
  },
  {
   "segment_id": 9,
   "arabic": "اَللَّهُمَّ وَهَاتَانِ ٱلرَّكْعَتَانِ"
  },
  {
   "segment_id": 10,
   "arabic": "هَدِيَّةٌ مِنِّي إِلَىٰ مَوْلاَيَ وَسَيِّدِي وَإِمَامِي"
  },
  {
   "segment_id": 11,
   "arabic": "ٱلْحُسَيْنِ بْنِ عَلِيٍّ عَلَيْهِمَا ٱلسَّلاَمُ"
  },
  {
   "segment_id": 12,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 13,
   "arabic": "وَتَقَبَّلْ ذٰلِكَ مِنِّي وَٱجْزِنِي عَلَىٰ ذٰلِكَ"
  },
  {
   "segment_id": 14,
   "arabic": "أَفْضَلَ أَمَلِي وَرَجَائِي فِيكَ وَفِي وَلِيِّكَ"
  },
  {
   "segment_id": 15,
   "arabic": "يَا أَرْحَمَ ٱلرَّاحِمِينَ"
  }
 ]
}