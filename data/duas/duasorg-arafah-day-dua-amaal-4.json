{
 "dua_id": "duasorg-arafah-day-dua-amaal-4",
 "dua_name_en": "Salawat - Day of Arafah",
 "dua_name_ar": "",
 "source": "https://www.duas.org/arafah-day-dua-amaal.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللَّهُمَّ يَا أَجْوَدَ مَنْ أَعْطَىٰ"
  },
  {
   "segment_id": 2,
   "arabic": "وَيَا خَيْرَ مَنْ سُئِلَ"
  },
  {
   "segment_id": 3,
   "arabic": "وَيَا أَرْحَمَ مَنِ ٱسْتُرْحِمَ"
  },
  {
   "segment_id": 4,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِهِ فِي ٱلأَوَّلِينَ"
  },
  {
   "segment_id": 5,
   "arabic": "وَصَلِّ عَلَىٰ مُحَمَّدٍ وَآلِهِ فِي ٱلآخِرِينَ"
  },
  {
   "segment_id": 6,
   "arabic": "وَصَلِّ عَلَىٰ مُحَمَّدٍ وَآلِهِ فِي ٱلْمَلأِ ٱلأَعْلَىٰ"
  },
  {
   "segment_id": 7,
   "arabic": "وَصَلِّ عَلَىٰ مُحَمَّدٍ وَآلِهِ فِي ٱلْمُرْسَلِينَ"
  },
  {
   "segment_id": 8,
   "arabic": "اَللَّهُمَّ أَعْطِ مُحَمَّداً وَآلَهُ"
  },
  {
   "segment_id": 9,
   "arabic": "ٱلْوَسِيلَةَ وَٱلْفَضِيلَةَ"
  },
  {
   "segment_id": 10,
   "arabic": "وَٱلشَّرَفَ وَٱلرِّفْعَةَ"
  },
  {
   "segment_id": 11,
   "arabic": "وَٱلدَّرَجَةَ ٱلْكَبيرَةَ"
  },
  {
   "segment_id": 12,
   "arabic": "اَللَّهُمَّ إِنِّي آمَنْتُ بِمُحَمَّدٍ"
  },
  {
   "segment_id": 13,
   "arabic": "صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ وَلَمْ أَرَهُ"
  },
  {
   "segment_id": 14,
   "arabic": "فَلاَ تَحْرِمْنِي فِي ٱلْقِيَامَةِ رُؤْيَتَهُ"
  },
  {
   "segment_id": 15,
   "arabic": "وَٱرْزُقْنِي صُحْبَتَهُ"
  },
  {
   "segment_id": 16,
   "arabic": "وَتَوَفَّنِي عَلَىٰ مِلَّتِهِ"
  },
  {
   "segment_id": 17,
   "arabic": "وَٱسْقِنِي مِنْ حَوْضِهِ"
  },
  {
   "segment_id": 18,
   "arabic": "مَشْرَباً رَوِيّاً"
  },
  {
   "segment_id": 19,
   "arabic": "سَائِغاً هَنِيئاً"
  },
  {
   "segment_id": 20,
   "arabic": "لاَ أَظْمَأُ بَعْدَهُ أَبَداً"
  },
  {
   "segment_id": 21,
   "arabic": "إِنَّكَ عَلَىٰ كُلِّ شَيْءٍ قَديرٌ"
  },
  {
   "segment_id": 22,
   "arabic": "اَللَّهُمَّ إِنِّي آمَنْتُ بِمُحَمَّدٍ"
  },
  {
   "segment_id": 23,
   "arabic": "صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ وَلَمْ أَرَهُ"
  },
  {
   "segment_id": 24,
   "arabic": "فَعَرَِّفْنِي فِي ٱلْجِنَانِ وَجْهَهُ"
  },
  {
   "segment_id": 25,
   "arabic": "اَللَّهُمَّ بَلِّغْ مُحَمَّداً"
  },
  {
   "segment_id": 26,
   "arabic": "صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ"
  },
  {
   "segment_id": 27,
   "arabic": "مِنِّي تَحِيَّةً كَثيرَةً وَسَلاَماً"
  }
 ]
}