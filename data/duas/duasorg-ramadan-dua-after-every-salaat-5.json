{
 "dua_id": "duasorg-ramadan-dua-after-every-salaat-5",
 "dua_name_en": "During the last 10 Days",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-dua-after-every-salaat.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللّهُمّ أَدِّ عَنَّا حَقَّ مَا مَضَى مِنْ شَهْرِ رَمَضَانَ،"
  },
  {
   "segment_id": 2,
   "arabic": "وَاغْفِرْ لَنَا تَقْصِيرَنَا فِيهِ"
  },
  {
   "segment_id": 3,
   "arabic": "وَتَسَلَّمْهُ مِنَّا مَقْبُولاً،"
  },
  {
   "segment_id": 4,
   "arabic": "وَلا تُؤَاخِذْنَا بِإِسْرَافِنَا عَلَى أَنْفُسِنَا،"
  },
  {
   "segment_id": 5,
   "arabic": "وَاجْعَلْنَا مِنَ المَرْحُومِينَ"
  },
  {
   "segment_id": 6,
   "arabic": "وَلا تَجْعَلْنَا مِنَ المَحْرُومِينَ."
  }
 ]
}