{
 "dua_id": "duasorg-thursday-night-rites-taqeeb-4",
 "dua_name_en": "Thursday Night Dua - Allhumma Anta awalo",
 "dua_name_ar": "",
 "source": "https://www.duas.org/thursday-night-rites-taqeeb.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللّهُمَّ أَنْتَ الأَوَّلُ فَلا شَيْ‏ءَ قَبْلَكَ"
  },
  {
   "segment_id": 2,
   "arabic": "وَأَنْتَ الآخِرُ الَّذي لاَ يَهْلَكُ"
  },
  {
   "segment_id": 3,
   "arabic": "وَأَنْتَ الحيُّ الَّذي لا يَمُوتُ"
  },
  {
   "segment_id": 4,
   "arabic": "وَالخَالِقُ الَّذي لا يَعْجِزُ"
  },
  {
   "segment_id": 5,
   "arabic": "وَأَنْتَ البَصِيرُ الَّذي لاَ يَرْتَابُ"
  },
  {
   "segment_id": 6,
   "arabic": "وَأَنْتَ الصَادِقُ الَّذي لاَ يَكْذِبُ"
  },
  {
   "segment_id": 7,
   "arabic": "القَاهِرُ الَّذي لا يُغْلَبُ"
  },
  {
   "segment_id": 8,
   "arabic": "الْبَدِي‏ءُ لا يَنْفَدُ"
  },
  {
   "segment_id": 9,
   "arabic": "الْقَرِيبُ لاَ يَبْعُدُ"
  },
  {
   "segment_id": 10,
   "arabic": "القَادِرُ لاَ يُضَامُ"
  },
  {
   "segment_id": 11,
   "arabic": "الْغَافِرُ لاَ يُظْلَمُ"
  },
  {
   "segment_id": 12,
   "arabic": "الصَّمَدُ لاَ يُطْعَمُ"
  },
  {
   "segment_id": 13,
   "arabic": "الْقَيَّومُ لاَ يَنْامُ"
  },
  {
   "segment_id": 14,
   "arabic": "الْمُجِيبُ لاَ يَسْأَمُ"
  },
  {
   "segment_id": 15,
   "arabic": "الْحَنَّانُ لاَ يُرَامُ"
  },
  {
   "segment_id": 16,
   "arabic": "الْعالِمُ لاَ يُعَلَّمُ"
  },
  {
   "segment_id": 17,
   "arabic": "القويُّ لاَ يَضْعُفْ"
  },
  {
   "segment_id": 18,
   "arabic": "الْعَظِيمُ لاَ يُوصَفُ"
  },
  {
   "segment_id": 19,
   "arabic": "الْوَفِيُّ لاَ يُخْلِفُ"
  },
  {
   "segment_id": 20,
   "arabic": "الْعَدْلُ لاَ يَحِيفُ"
  },
  {
   "segment_id": 21,
   "arabic": "الْغَنِيُّ لاَ يَفْتَقِرُ"
  },
  {
   "segment_id": 22,
   "arabic": "الْكَبِيرُ لاَ يَصْغُرُ"
  },
  {
   "segment_id": 23,
   "arabic": "الْمَنِيعُ لاَ يُقْهَرُ"
  },
  {
   "segment_id": 24,
   "arabic": "الْمَعْرُوفُ لاَ يُنْكَرُ"
  },
  {
   "segment_id": 25,
   "arabic": "الْغَالِبُ لاَ يُغْلَبُ"
  },
  {
   "segment_id": 26,
   "arabic": "الْوِتْرُ لاَ يَسْتَأَنِسُ"
  },
  {
   "segment_id": 27,
   "arabic": "الْفَرْدُ لاَ يَسْتَشِيرُ"
  },
  {
   "segment_id": 28,
   "arabic": "الْوَهَّابُ لاَ يَمَلُّ"
  },
  {
   "segment_id": 29,
   "arabic": "الْجَوَادُ لاَ يَبْخَلُ"
  },
  {
   "segment_id": 30,
   "arabic": "الْعَزِيزُ لاَ يَذِلُّ"
  },
  {
   "segment_id": 31,
   "arabic": "الْحَافِظُ لاَ يَغْفَلُ"
  },
  {
   "segment_id": 32,
   "arabic": "الْقَائِمُ لاَ يَنْامُ"
  },
  {
   "segment_id": 33,
   "arabic": "الْمُحْتَجِبُ لاَ يُرى"
  },
  {
   "segment_id": 34,
   "arabic": "الدَّائِمُ لاَ يَفْنَى"
  },
  {
   "segment_id": 35,
   "arabic": "الْبَاقِي لاَ يَبْلَى"
  },
  {
   "segment_id": 36,
   "arabic": "الْمُقْتَدِرُ لاَ يُنَازَعُ"
  },
  {
   "segment_id": 37,
   "arabic": "الْوَاحِدُ لاَ يُشَبَّهُ"
  },
  {
   "segment_id": 38,
   "arabic": "لاَ إلهَ إلاَّ أَنْتَ"
  },
  {
   "segment_id": 39,
   "arabic": "الْحَقُّ الَّذي لا تُغَيِّرُكَ الأَزْمِنَةُ"
  },
  {
   "segment_id": 40,
   "arabic": "وَلاَ تُحِيطُ بِكَ الأَمْكِنَةُ"
  },
  {
   "segment_id": 41,
   "arabic": "وَلاَ يأخُذُكَ نَوْمٌ وَلاَ سِنَةٌ"
  },
  {
   "segment_id": 42,
   "arabic": "وَلاَ يَشْبَهُكَ شَي‏ءٌ"
  },
  {
   "segment_id": 43,
   "arabic": "وَكَيْفَ لاَ تَكُونُ كَذلِكَ"
  },
  {
   "segment_id": 44,
   "arabic": "وَأَنْتَ خَالِقُ كُلَِّ شَي‏ءٍ"
  },
  {
   "segment_id": 45,
   "arabic": "لاَ إلهَ إلاّ أَنْتَ"
  },
  {
   "segment_id": 46,
   "arabic": "كُلُّ شَي‏ءٍ هَالِكٌ إلاّ وَجْهَكَ الْكَرِيمَ"
  },
  {
   "segment_id": 47,
   "arabic": "أَكْرَمَ الْوُجُوهِ"
  },
  {
   "segment_id": 48,
   "arabic": "أمَانُ الْخَائِفِينَ وَجَارُ الْمُسْتَجِيرِينَ"
  },
  {
   "segment_id": 49,
   "arabic": "أَسْأَلُكَ وَلاَ أَسْألُ غَيْرَكَ"
  },
  {
   "segment_id": 50,
   "arabic": "وَأَرْغَبُ إليكَ وَلاَ أَرْغَبُ إلى غَيْرِكَ"
  },
  {
   "segment_id": 51,
   "arabic": "أَسْأَلُكَ بَأَفْضَلِ الْمَسَائِلِ كُلِّهِا"
  },
  {
   "segment_id": 52,
   "arabic": "وَأَنْجَحِها الَّتِي لاَ يَنْبَغِي لِلِعِبَادِ"
  },
  {
   "segment_id": 53,
   "arabic": "أَنْ يَسْأَلُوكَ إلاَّ بِهَا"
  },
  {
   "segment_id": 54,
   "arabic": "أَنْتَ الْفَتَّاحُ الْنَّفَاحُ"
  },
  {
   "segment_id": 55,
   "arabic": "ذُو الْخَيْرَاتِ مُقِيلُ الْعَثَرَاتِ"
  },
  {
   "segment_id": 56,
   "arabic": "كَاتِبُ الْحَسَنَاتِ مَاحِي الْسَيئاتِ"
  },
  {
   "segment_id": 57,
   "arabic": "رَافِعُ الْدَرَجَاتِ"
  },
  {
   "segment_id": 58,
   "arabic": "أَسْأَلُكَ يَا أَللهُ يَا رَحْمَانُ"
  },
  {
   "segment_id": 59,
   "arabic": "بِأَسْمَائِكَ الحُسْنى كُلِّهِا"
  },
  {
   "segment_id": 60,
   "arabic": "وَكَلِمَاتِكَ الْعُليا وَنِعَمِكَ الَّتي لا تُحْصَى"
  },
  {
   "segment_id": 61,
   "arabic": "وَأَسْأَلُكَ بَأَكْرَمَ أَسْمَائِكَ عَلَيْكَ"
  },
  {
   "segment_id": 62,
   "arabic": "وَأَحَبِّهَا إليكَ وَأَشْرَفِها عِنْدَكَ"
  },
  {
   "segment_id": 63,
   "arabic": "مَنْزِلَةً وَأَقْرَبِهَا مِنْكَ وَسِيِلَةً"
  },
  {
   "segment_id": 64,
   "arabic": "وَأَسْرَعِهَا مِنْكَ إِجَابَةً"
  },
  {
   "segment_id": 65,
   "arabic": "وَبِاسْمِكَ الْمَكْنِونِ الْمَخْزُونِ"
  },
  {
   "segment_id": 66,
   "arabic": "الْجَلِيلِ الأجلِ الْعَظِيمِ"
  },
  {
   "segment_id": 67,
   "arabic": "الَّذي تُحِبُّهُ وَتَرضَى عَمَّنْ دَعَاكَ بِهِ"
  },
  {
   "segment_id": 68,
   "arabic": "وَتَسْتَجِيبُ لَهُ دُعَاءَهُ"
  },
  {
   "segment_id": 69,
   "arabic": "وَحَقٌّ عَلَيْكَ ألاّ تَحْرِمَ سَائِلَكَ"
  },
  {
   "segment_id": 70,
   "arabic": "وَبُكُلِّ اسْمٍ هُوَ لَكَ فِي التَوْرَاةِ وَالإِنْجيلِ"
  },
  {
   "segment_id": 71,
   "arabic": "وَالزَّبُورِ وَالفُرْقَانِ الْعَظِيمِ"
  },
  {
   "segment_id": 72,
   "arabic": "وَبِكُلِّ اسمٍ هُوَ لَكَ عَلَّمْتَهُ أَحَداً مِنْ خَلْقِكَ"
  },
  {
   "segment_id": 73,
   "arabic": "أَوْ لَمْ تُعَلِّمْهُ أَحَداً"
  },
  {
   "segment_id": 74,
   "arabic": "أَوْ اسْتَأثَرْتَ بِهِ فِي عِلْمِ الْغَيِبِ عِنْدَكَ"
  },
  {
   "segment_id": 75,
   "arabic": "وَبِكُلِّ اسْمٍ دَعَاكَ بِهِ حَمَلَةُ عَرْشِكَ"
  },
  {
   "segment_id": 76,
   "arabic": "وَمَلائِكَتُكَ وَأَصْفِياؤُكَ مِنْ خَلْقِكَ"
  },
  {
   "segment_id": 77,
   "arabic": "وَبِحَقِّ الْسَائِلِينَ لَكَ وَالْرَاغِبِينَ إلَيْكَ"
  },
  {
   "segment_id": 78,
   "arabic": "وَالْمُتَعَوِّذِينَ بِكَ وَالْمُتَضَرِّعِينَ إِلَيْكَ"
  },
  {
   "segment_id": 79,
   "arabic": "أَدْعُوكَ يَا أَللهُ دُعَاءَ مَنْ قَدْ اشْتَدَّتْ فَاقَتُهُ"
  },
  {
   "segment_id": 80,
   "arabic": "وَعَظُمَ جُرْمُهُ وَأَشْرَفَ عَلى الهَلَكَةِ نَفْسُهُ"
  },
  {
   "segment_id": 81,
   "arabic": "وَضَعُفَتْ قُوَّتُهُ وَمَنْ لاَ يَثِقُ بِشَي‏ءٍ مِنْ عَمَلِهِ"
  },
  {
   "segment_id": 82,
   "arabic": "وَلاَ يَجِدُ لِفَاقَتَهِ سَادَّاً غَيْرَكَ."
  },
  {
   "segment_id": 83,
   "arabic": "فَقَدْ هَرَبتُ مِنْها إِلَيْكَ."
  },
  {
   "segment_id": 84,
   "arabic": "غيرَ مُستنكِفٍ وَلاَ مُسْتَكبِرٍ عَنْ عِبَادَتِكَ."
  },
  {
   "segment_id": 85,
   "arabic": "يَا أَنَسَ كُلِّ مُسْتَجِيرٍ."
  },
  {
   "segment_id": 86,
   "arabic": "يَا سَنَدَ كُلِّ فَقِيرٍ."
  },
  {
   "segment_id": 87,
   "arabic": "أَسْأَلُكَ بَأَنَّكَ أَنْتَ اللهُ."
  },
  {
   "segment_id": 88,
   "arabic": "الْحَنَّانُ الْمَنَّانُ."
  },
  {
   "segment_id": 89,
   "arabic": "لاَ إلهَ إلاّ أَنْتَ."
  },
  {
   "segment_id": 90,
   "arabic": "بَديِعُ الْسَمَاواتِ وَالأَرْضِ."
  },
  {
   "segment_id": 91,
   "arabic": "ذُو الْجَلالِ وَالإِكْرامِ."
  },
  {
   "segment_id": 92,
   "arabic": "عالِمُ الغيبِ وَالْشَهَادَةِ."
  },
  {
   "segment_id": 93,
   "arabic": "الْرَحْمنُ الْرَّحِيمُ."
  },
  {
   "segment_id": 94,
   "arabic": "أَنْتَ الْرَّبُّ وَأَنَا الْعَبْدُ."
  },
  {
   "segment_id": 95,
   "arabic": "أَنْتَ الْمَالِكُ وَأَنَا الْمَمْلُوكُ."
  },
  {
   "segment_id": 96,
   "arabic": "أَنْتَ الْعَزِيزُ وَأَنَا الْذَلِيلُ."
  },
  {
   "segment_id": 97,
   "arabic": "أَنْتَ الْغَنِيُّ وَأَنَا الْفَقِيرُ."
  },
  {
   "segment_id": 98,
   "arabic": "أَنْتَ الْحَيُّ وَأَنَا الْمَيِّتُ."
  },
  {
   "segment_id": 99,
   "arabic": "أَنْتَ الْبَاقِي وَأَنَا الْفَانِي."
  },
  {
   "segment_id": 100,
   "arabic": "أَنْتَ الْمُحْسِنُ وَأَنَا الْمُسي‏ءُ."
  },
  {
   "segment_id": 101,
   "arabic": "أَنْتَ الْغَفُورُ وَأَنَا الْمُذْنِبُ."
  },
  {
   "segment_id": 102,
   "arabic": "أَنْتَ الرَّحِيْمُ وَأَنَا الْخَاطِئُ."
  },
  {
   "segment_id": 103,
   "arabic": "أَنْتَ الْخَالِقُ وَأَنَا الْمَخْلُوقُ."
  },
  {
   "segment_id": 104,
   "arabic": "أَنْتَ الْقَوِيُّ وَأَنَا الضَّعِيْفُ."
  },
  {
   "segment_id": 105,
   "arabic": "أَنْتَ المُعْطِي وَأَنَا الْسَائِلُ."
  },
  {
   "segment_id": 106,
   "arabic": "أَنْتَ الْرَازِقُ وَأَنَا الْمَرْزُوقُ."
  },
  {
   "segment_id": 107,
   "arabic": "أَنْتَ أَحقُّ مَنْ شَكَوْتُ إلَيهِ."
  },
  {
   "segment_id": 108,
   "arabic": "وَاسْتَعَنْتُ بِهِ وَرَجَوْتُهُ."
  },
  {
   "segment_id": 109,
   "arabic": "إِلهي كَمْ مِنْ مُذْنِبٍ قَدْ غَفَرْتَ لَهُ."
  },
  {
   "segment_id": 110,
   "arabic": "وَكَمْ مِنْ مُسي‏ءٍ قَدْ تَجَاوَزْتَ عَنْهُ."
  },
  {
   "segment_id": 111,
   "arabic": "فَصَلِّ عَلى مُحَمَّدٍ وَآلِهِ."
  },
  {
   "segment_id": 112,
   "arabic": "واغفِرْ لِي وَارحَمْنِي وَاعْفُ عَنِّي."
  },
  {
   "segment_id": 113,
   "arabic": "وَعَافِنِي وَافْتَحْ لِي مِنْ فَضْلِكَ."
  },
  {
   "segment_id": 114,
   "arabic": "سُبُّوحٌ ذِكْرُكَ قُدُّوسُ أَمْرُكَ."
  },
  {
   "segment_id": 115,
   "arabic": "نَافِذٌ قَضَاؤُكَ."
  },
  {
   "segment_id": 116,
   "arabic": "يَسِّرْ لِي مِنْ أَمْرِي مَا أَخَافُ عُسْرَهُ."
  },
  {
   "segment_id": 117,
   "arabic": "وَفَرِّجْ عَنِّي وَعَنْ كُلِّ مُؤْمِنٍ وَمُؤْمِنَةٍ."
  },
  {
   "segment_id": 118,
   "arabic": "وَاكِفِنِي مَا أَخَافُ ضَرُورَتُهُ."
  },
  {
   "segment_id": 119,
   "arabic": "وَادْرَأْ عَنِّي مَا أَخَافُ حُزُونَتَهُ."
  },
  {
   "segment_id": 120,
   "arabic": "وَسَهِّلْ لِي وَلِكُلِّ مُؤمِنٍ مَا أَرْجُوهُ."
  },
  {
   "segment_id": 121,
   "arabic": "لاَ إلهَ إلاّ أَنْتَ."
  },
  {
   "segment_id": 122,
   "arabic": "سُبْحَانَكَ إنِّي كُنْتُ مِنَ الظَالمِين"
  }
 ]
}