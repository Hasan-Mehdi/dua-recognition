{
 "dua_id": "duasorg-ramadan-amaal-dua-first-day-3",
 "dua_name_en": "Dua by Imam Musa Al Kadhim",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-amaal-dua-first-day.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللَّهُمَّ إِنِّي أَسْأَلُكَ بِٱسْمِكَ ٱلَّذِي دَانَ لَهُ كُلُّ شَيْءٍ"
  },
  {
   "segment_id": 2,
   "arabic": "وَبِرَحْمَتِكَ ٱلَّتِي وَسِعَتْ كُلَّ شَيْءٍ"
  },
  {
   "segment_id": 3,
   "arabic": "وَبِعَظَمَتِكَ ٱلَّتِي تَوَاضَعَ لَهَا كُلُّ شَيْءٍ"
  },
  {
   "segment_id": 4,
   "arabic": "وَبِعِزَّتِكَ ٱلَّتِي قَهَرَتْ كُلَّ شَيْءٍ"
  },
  {
   "segment_id": 5,
   "arabic": "وَبِقُوَّتِكَ ٱلَّتِي خَضَعَ لَهَا كُلُّ شَيْءٍ"
  },
  {
   "segment_id": 6,
   "arabic": "وَبِجَبَرُوتِكَ ٱلَّتِي غَلَبَتْ كُلَّ شَيْءٍ"
  },
  {
   "segment_id": 7,
   "arabic": "وَبِعِلْمِكَ ٱلَّذِي أَحَاطَ بِكُلِّ شَيْءٍ"
  },
  {
   "segment_id": 8,
   "arabic": "يَا نُورُ يَا قُدُّوسُ"
  },
  {
   "segment_id": 9,
   "arabic": "يَا أَوَّلُ قَبْلَ كُلِّ شَيْءٍ"
  },
  {
   "segment_id": 10,
   "arabic": "وَيَا بَاقِياً بَعْدَ كُلِّ شَيْءٍ"
  },
  {
   "segment_id": 11,
   "arabic": "يَا اللَّهُ يَا رَحْمٰنُ"
  },
  {
   "segment_id": 12,
   "arabic": "صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 13,
   "arabic": "وَٱغْفِرْ لِيَ ٱلذُّنُوبَ ٱلَّتِي تُغَيِّرُ ٱلنِّعَمَ"
  },
  {
   "segment_id": 14,
   "arabic": "وَاغْفِرْ لِيَ ٱلذُّنُوبَ ٱلَّتِي تُنْزِلُ ٱلنِّقَمَ"
  },
  {
   "segment_id": 15,
   "arabic": "وَٱغْفِرْ لِيَ ٱلذُّنُوبَ ٱلَّتِي تَقْطَعُ ٱلرَّجَاءَ"
  },
  {
   "segment_id": 16,
   "arabic": "وَٱغْفِرْ لِيَ ٱلذُّنُوبَ ٱلَّتِي تُدِيلُ ٱلأَعْدَاءَ"
  },
  {
   "segment_id": 17,
   "arabic": "وَٱغْفِرْ لِيَ ٱلذُّنُوبَ ٱلَّتِي تَرُدُّ ٱلدُّعَاءَ"
  },
  {
   "segment_id": 18,
   "arabic": "وَٱغْفِرْ لِيَ ٱلذُّنُوبَ ٱلَّتِي يُسْتَحَقُّ بِهَا نُزُولُ ٱلْبَلاَءِ"
  },
  {
   "segment_id": 19,
   "arabic": "وَٱغْفِرْ لِيَ ٱلذُّنُوبَ ٱلَّتِي تَحْبِسُ غَيْثَ ٱلسَّمَاءِ"
  },
  {
   "segment_id": 20,
   "arabic": "وَٱغْفِرْ لِيَ ٱلذُّنُوبَ ٱلَّتِي تَكْشِفُ ٱلْغِطَاءَ"
  },
  {
   "segment_id": 21,
   "arabic": "وَٱغْفِرْ لِيَ ٱلذُّنُوبَ ٱلَّتِي تُعَجِّلُ ٱلْفَنَاءَ"
  },
  {
   "segment_id": 22,
   "arabic": "وَٱغْفِرْ لِيَ ٱلذُّنُوبَ ٱلَّتِي تُورِثُ ٱلنَّدَمَ"
  },
  {
   "segment_id": 23,
   "arabic": "وَٱغْفِرْ لِيَ ٱلذُّنُوبَ ٱلَّتِي تَهْتِكُ ٱلْعِصَمَ"
  },
  {
   "segment_id": 24,
   "arabic": "وَأَلْبِسْنِي دِرْعَكَ ٱلحَصِينَةَ الَّتِي لاَ تُرَامُ"
  },
  {
   "segment_id": 25,
   "arabic": "وَعَافِنِي مِنْ شَرِّ مَا أُحَاذِرُ بِٱللَّيْلِ وَٱلنَّهَارِ فِي مُسْتَقْبَلِ سَنَتِي هٰذِهِ"
  },
  {
   "segment_id": 26,
   "arabic": "اللَّهُمَّ رَبَّ ٱلسَّمَاوَاتِ ٱلسَّبْعِ"
  },
  {
   "segment_id": 27,
   "arabic": "وَرَبَّ ٱلأَرَضِينَ ٱلسَّبْعِ وَمَا فِيهِنَّ وَمَا بَيْنَهُنَّ"
  },
  {
   "segment_id": 28,
   "arabic": "وَرَبَّ ٱلْعَرْشِ ٱلْعَظِيمِ"
  },
  {
   "segment_id": 29,
   "arabic": "وَرَبَّ ٱلسَّبْعِ ٱلْمَثَانِي وَٱلْقُرْآنِ ٱلْعَظِيمِ"
  },
  {
   "segment_id": 30,
   "arabic": "وَرَبَّ إِسْرَافِيلَ وَمِيكَائِيلَ وَجَبْرَائِيلَ"
  },
  {
   "segment_id": 31,
   "arabic": "وَرَبَّ مُحَمَّدٍ صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ سَيِّدِ ٱلْمُرْسَلِينَ وَخَاتَمِ ٱلنَّبِيِّينَ"
  },
  {
   "segment_id": 32,
   "arabic": "أَسْأَلُكَ بِكَ وَبِمَا سَمَّيْتَ بِهِ نَفْسَكَ"
  },
  {
   "segment_id": 33,
   "arabic": "يَا عَظِيمُ أَنْتَ ٱلَّذِي تَمُنُّ بِٱلْعَظِيمِ"
  },
  {
   "segment_id": 34,
   "arabic": "وَتَدْفَعُ كُلَّ مَحْذُورٍ"
  },
  {
   "segment_id": 35,
   "arabic": "وَتُعْطِي كُلَّ جَزِيلٍ"
  },
  {
   "segment_id": 36,
   "arabic": "وَتُضَاعِفُ ٱلْحَسَنَاتِ بِٱلْقَلِيلِ وَبِٱلْكَثِيرِ"
  },
  {
   "segment_id": 37,
   "arabic": "وَتَفْعَلُ مَا تَشَاءُ"
  },
  {
   "segment_id": 38,
   "arabic": "يَا قَدِيرُ يَا اللَّهُ يَا رَحْمٰنُ"
  },
  {
   "segment_id": 39,
   "arabic": "صَلِّ عَلَىٰ مُحَمَّدٍ وَأَهْلِ بَيْتِهِ"
  },
  {
   "segment_id": 40,
   "arabic": "وَأَلْبِسْنِي فِي مُسْتَقْبِلِ سَنَتِي هٰذِهِ سِتْرَكَ"
  },
  {
   "segment_id": 41,
   "arabic": "وَنَضِّرْ وَجْهِي بِنُورِكَ"
  },
  {
   "segment_id": 42,
   "arabic": "وَأَحِبَّنِي بِمَحَبَّتِكَ"
  },
  {
   "segment_id": 43,
   "arabic": "وَبَلِّغْنِي رِضْوَانَكَ"
  },
  {
   "segment_id": 44,
   "arabic": "وَشَرِيفَ كَرَامَتِكَ"
  },
  {
   "segment_id": 45,
   "arabic": "وَجَسِيمَ عَطِيَّتِكَ"
  },
  {
   "segment_id": 46,
   "arabic": "وَأَعْطِنِي مِنْ خَيْرِ مَا عِنْدَكَ"
  },
  {
   "segment_id": 47,
   "arabic": "وَمِنْ خَيْرِ مَا أَنْتَ مُعْطِيهِ أَحَداً مِنْ خَلْقِكَ"
  },
  {
   "segment_id": 48,
   "arabic": "وَأَلْبِسْنِي مَعَ ذٰلِكَ عَافِيَتَكَ"
  },
  {
   "segment_id": 49,
   "arabic": "يَا مَوْضِعَ كُلِّ شَكْوَىٰ"
  },
  {
   "segment_id": 50,
   "arabic": "وَيَا شَاهِدَ كُلِّ نَجْوَىٰ"
  },
  {
   "segment_id": 51,
   "arabic": "وَيَا عَالِمَ كُلِّ خَفِيَّةٍ"
  },
  {
   "segment_id": 52,
   "arabic": "وَيَا دَافِعَ مَا تَشَاءُ مِنْ بَلِيَّةٍ"
  },
  {
   "segment_id": 53,
   "arabic": "يَا كَرِيمَ ٱلْعَفْوِ"
  },
  {
   "segment_id": 54,
   "arabic": "يَا حَسَنَ ٱلتَّجَاوُزِ"
  },
  {
   "segment_id": 55,
   "arabic": "تَوَفَّنِي عَلَىٰ مِلَّةِ إِبْرَاهِيمَ وَفِطْرَتِهِ"
  },
  {
   "segment_id": 56,
   "arabic": "وَعَلَىٰ دِينِ مُحَمَّدٍ صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ وَسُنَّتِهِ"
  },
  {
   "segment_id": 57,
   "arabic": "وَعَلَىٰ خَيْرِ ٱلْوَفَاةِ فَتَوَفَّنِي مُوَالِياً لأَوْلِيَائِكَ"
  },
  {
   "segment_id": 58,
   "arabic": "وَمُعَادِياً لأَعْدَائِكَ"
  },
  {
   "segment_id": 59,
   "arabic": "اللَّهُمَّ وَجَنِّبْنِي فِي هٰذِهِ السَّنَةِ"
  },
  {
   "segment_id": 60,
   "arabic": "كُلَّ عَمَلٍ أَوْ قَوْلٍ أَوْ فِعْلٍ يُبَاعِدُنِي مِنْكَ"
  },
  {
   "segment_id": 61,
   "arabic": "وَٱجْلِبْنِي إِلَىٰ كُلِّ عَمَلٍ أَوْ قَوْلٍ أَوْ فِعْلٍ"
  },
  {
   "segment_id": 62,
   "arabic": "يُقَرِّبُنِي مِنْكَ فِي هٰذِهِ ٱلسَّنَةَ"
  },
  {
   "segment_id": 63,
   "arabic": "يَا أَرْحَمَ ٱلرَّاحِمِينَ"
  },
  {
   "segment_id": 64,
   "arabic": "وَٱمْنَعْنِي مِنْ كُلِّ عَمَلٍ أَوْ قَوْلٍ أَوْ فِعْلٍ"
  },
  {
   "segment_id": 65,
   "arabic": "يَكُونُ مِنِّي أَخَافُ ضَرَرَ عَاقِبَتِهِ"
  },
  {
   "segment_id": 66,
   "arabic": "وَأَخَافُ مَقْتَكَ إِيَّايَ عَلَيْهِ"
  },
  {
   "segment_id": 67,
   "arabic": "حِذَارَ أَنْ تَصْرِفَ وَجْهَكَ ٱلْكَرِيمَ عَنِّي"
  },
  {
   "segment_id": 68,
   "arabic": "فَأَسْتَوْجِبَ بِهِ نَقْصاً مِنْ حَظٍّ لِي عِنْدَكَ"
  },
  {
   "segment_id": 69,
   "arabic": "يَا رَؤُوفُ يَا رَحِيمُ"
  },
  {
   "segment_id": 70,
   "arabic": "اللَّهُمَّ ٱجْعَلْنِي فِي مُسْتَقْبِلِ سَنَتِي هٰذِهِ فِي حِفْظِكَ"
  },
  {
   "segment_id": 71,
   "arabic": "وَفِي جِوَارِكَ وَفِي كَنَفِكَ"
  },
  {
   "segment_id": 72,
   "arabic": "وَجَلِّلْنِي سِتْرَ عَافِيَتِكَ"
  },
  {
   "segment_id": 73,
   "arabic": "وَهَبْ لِي كَرَامَتَكَ"
  },
  {
   "segment_id": 74,
   "arabic": "عَزَّ جَارُكَ"
  },
  {
   "segment_id": 75,
   "arabic": "وَجَلَّ ثَنَاؤُكَ"
  },
  {
   "segment_id": 76,
   "arabic": "وَلاَ إِلٰهَ غَيْرُكَ"
  },
  {
   "segment_id": 77,
   "arabic": "اللَّهُمَّ ٱجْعَلْنِي تَابِعاً لِصَالِحِي مَنْ مَضَىٰ مِنْ أَوْلِيَائِكَ"
  },
  {
   "segment_id": 78,
   "arabic": "وَأَلْحِقْنِي بِهِمْ"
  },
  {
   "segment_id": 79,
   "arabic": "وَٱجْعَلْنِي مُسَلِّماً لِمَنْ قَالَ بِٱلصِّدْقِ عَلَيْكَ مِنْهُمْ"
  },
  {
   "segment_id": 80,
   "arabic": "وَأَعُوذُ بِكَ ٱللَّهُمَّ أَنْ تُحِيطَ بِي خَطِيئَتِي وَظُلْمِي"
  },
  {
   "segment_id": 81,
   "arabic": "وَإِسْرَافِي عَلَىٰ نَفْسِي وَٱتِّبَاعِي لِهَوَايَ"
  },
  {
   "segment_id": 82,
   "arabic": "وَٱشْتِغَالِي بِشَهَوَاتِي"
  },
  {
   "segment_id": 83,
   "arabic": "فَيَحُولُ ذٰلِكَ بَيْنِي وَبَيْنَ رَحْمَتِكَ وَرِضْوَانِكَ"
  },
  {
   "segment_id": 84,
   "arabic": "فَأَكُونُ مَنْسِيّاً عِنْدَكَ"
  },
  {
   "segment_id": 85,
   "arabic": "مُتَعَرِّضاً لِسَخَطِكَ وَنِقْمَتِكَ"
  },
  {
   "segment_id": 86,
   "arabic": "اللَّهُمَّ وَفِّقْنِي لِكُلِّ عَمَلٍ صَالِحٍ تَرْضَىٰ بِهِ عَنِّي"
  },
  {
   "segment_id": 87,
   "arabic": "وَقَرِّبْنِي إِلَيْكَ زُلْفَىٰ"
  },
  {
   "segment_id": 88,
   "arabic": "اللَّهُمَّ كَمَا كَفَيْتَ نَبِيَّكَ مُحَمَّداً صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ هَوْلَ عَدُوِّهِ"
  },
  {
   "segment_id": 89,
   "arabic": "وَفَرَّجْتَ هَمَّهُ"
  },
  {
   "segment_id": 90,
   "arabic": "وَكَشَفْتَ غَمَّهُ"
  },
  {
   "segment_id": 91,
   "arabic": "وَصَدَقْتَهُ وَعْدَكَ"
  },
  {
   "segment_id": 92,
   "arabic": "وَأَنْجَزْتَ لَهُ عَهْدَكَ"
  },
  {
   "segment_id": 93,
   "arabic": "اللَّهُمَّ فَبِذٰلِكَ فَٱكْفِنِي هَوْلَ هٰذِهِ ٱلسَّنَةِ"
  },
  {
   "segment_id": 94,
   "arabic": "وَآفَاتِهَا وَأَسْقَامَهَا"
  },
  {
   "segment_id": 95,
   "arabic": "وَفِتْنَتَهَا وَشُرُورَهَا"
  },
  {
   "segment_id": 96,
   "arabic": "وَأَحْزَانَهَا وَضِيقَ ٱلْمَعَاشِ فِيهَا"
  },
  {
   "segment_id": 97,
   "arabic": "وَبَلِّغْنِي بِرَحْمَتِكَ كَمَالَ ٱلْعَافِيَةِ"
  },
  {
   "segment_id": 98,
   "arabic": "بِتَمَامِ دَوَامِ ٱلنِّعْمَةِ عِنْدِي إِلَىٰ مُنْتَهَىٰ أَجَلِي"
  },
  {
   "segment_id": 99,
   "arabic": "أَسْأَلُكَ سُؤَالَ مَنْ أَسَاءَ وَظَلَمَ وَٱسْتَكَانَ وَٱعْتَرَفَ"
  },
  {
   "segment_id": 100,
   "arabic": "وَأَسْأَلُكَ أَنْ تَغْفِرَ لِي مَا مَضَىٰ مِنَ ٱلذُّنُوبِ"
  },
  {
   "segment_id": 101,
   "arabic": "ٱلَّتِي حَصَرَتْهَا حَفَظَتُكَ"
  },
  {
   "segment_id": 102,
   "arabic": "وَأَحْصَتْهَا كِرَامُ مَلاَئِكَتِكَ عَلَيَّ"
  },
  {
   "segment_id": 103,
   "arabic": "وَأَنْ تَعْصِمَنِي ٱللَّهُمَّ مِنَ ٱلذُّنُوبِ"
  },
  {
   "segment_id": 104,
