{
 "dua_id": "duasorg-rabi-al-akher-month-start-2",
 "dua_name_en": "Instruction Block",
 "dua_name_ar": "",
 "source": "https://www.duas.org/rabi-al-akher-month-start.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "قُلْ يَا أَيُّهَا النَّاسُ إِنِّي رَسُولُ اللَّهِ إِلَيْكُمْ جَمِيعًا"
  },
  {
   "segment_id": 2,
   "arabic": "الَّذِي لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ"
  },
  {
   "segment_id": 3,
   "arabic": "لَا إِلَٰهَ إِلَّا هُوَ يُحْيِي وَيُمِيتُ"
  },
  {
   "segment_id": 4,
   "arabic": "فَآمِنُوا بِاللَّهِ وَرَسُولِهِ النَّبِيِّ الْأُمِّيِّ"
  },
  {
   "segment_id": 5,
   "arabic": "الَّذِي يُؤْمِنُ بِاللَّهِ وَكَلِمَاتِهِ وَاتَّبِعُوهُ لَعَلَّكُمْ تَهْتَدُونَ"
  }
 ]
}