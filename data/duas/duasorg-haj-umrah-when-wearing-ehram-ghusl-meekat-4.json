{
 "dua_id": "duasorg-haj-umrah-when-wearing-ehram-ghusl-meekat-4",
 "dua_name_en": "Instruction Block",
 "dua_name_ar": "",
 "source": "https://www.duas.org/haj-umrah-when-wearing-ehram-ghusl-meekat.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "لَبَّیْکَ ذَ الْمَعَارِجِ لَبَّیْکَ"
  },
  {
   "segment_id": 2,
   "arabic": "لَبَّیْکَ دَاعِیًا اِلٰی دَارِ السَّلاَمِ لَبَّیْکَ"
  },
  {
   "segment_id": 3,
   "arabic": "لَبَّیْکَ غَفَّارَ الذُّنُوْبِ لَبَّیْکَ"
  },
  {
   "segment_id": 4,
   "arabic": "لَبَّیْکَ اَہْلَ التَّلْبِیَۃِ لَبَّیْکَ"
  },
  {
   "segment_id": 5,
   "arabic": "لَبَّیْکَ ذَا الْجَلاَلِ وَ الْاِکْرَامِ لَبَّیْکَ"
  },
  {
   "segment_id": 6,
   "arabic": "لَبَّیْکَ تُبْدِءُ وَ الْمُعَادُ اِلَیْکَ لَبَّیْکَ"
  },
  {
   "segment_id": 7,
   "arabic": "لَبَّیْکَ تَسْتَغْنِیْ وَ یُفْتَقَرُ اِلَیْکَ لَبَّیْکَ"
  },
  {
   "segment_id": 8,
   "arabic": "لَبَّیْکَ مَرْہُوْبًا وَ مَرْغُوْبًا اِلَیْکَ لَبَّیْکَ"
  },
  {
   "segment_id": 9,
   "arabic": "لَبَّیْکَ اِلٰہَ الْحَقِّ لَبَّیْکَ"
  },
  {
   "segment_id": 10,
   "arabic": "لَبَّیْکَ ذَا النَّعْمَآءِ وَ الْفَضْلِ الْحَسَنِ الْجَمِیْلِ لَبَّیْکَ"
  },
  {
   "segment_id": 11,
   "arabic": "لَبَّیْکَ کَشَّافَ الْکُرَبِ الْعِظَامِ لَبَّیْکَ"
  },
  {
   "segment_id": 12,
   "arabic": "لَبَّیْکَ عَبْدُکَ وَ ابْنُ عَبْدَیْکَ لَبَّیْکَ"
  },
  {
   "segment_id": 13,
   "arabic": "لَبَّیْکَ یَا کَرِیْمُ لَبَّیْکَ"
  }
 ]
}