 "dua_name_ar": " شهر رمضان ٣",
 "source": "https://www.duaplayer.org/en/dua/ramadan-3",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 2,
   "arabic": "للّهُمّ ارْزُقْنِي فِيهِ الذّهْنَ وَالتّنْبِيهَ،"
  },
  {
   "segment_id": 3,
   "arabic": "وَبَاعِدْنِي فِيهِ مِنَ السّفَاهَةِ وَالتّمْوِيهِ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَاجْعَلْ لِي نَصِيباً مِنْ كُلّ خَيْرٍ تُنْزِلُ فِيهِ،"
  },
  {
   "segment_id": 5,
   "arabic": "بِجُودِكَ يَا أَجْوَدَ الأَجْوَدِينَ."
  }
 ]
}