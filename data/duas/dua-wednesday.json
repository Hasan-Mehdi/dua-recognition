{
 "dua_id": "dua-wednesday",
 "dua_name_en": "Dua al-Arbiaa'",
 "dua_name_ar": "دعاء الأربعاء",
 "source": "https://www.duaplayer.org/en/dua/wednesday",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمٰنِ ٱلرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "الْحَمْدُ لِلَّهِ ٱلَّذِي جَعَلَ ٱللَّيلَ لِبَاساً"
  },
  {
   "segment_id": 3,
   "arabic": "وَٱلنَّوْمَ سُبَاتاً"
  },
  {
   "segment_id": 4,
   "arabic": "وَجَعَلَ ٱلنَّهَارَ نُشُوراً"
  },
  {
   "segment_id": 5,
   "arabic": "لَكَ ٱلْحَمْدُ انْ بَعَثْتَنِي مِنْ مَرْقَدِي"
  },
  {
   "segment_id": 6,
   "arabic": "وَلَوْ شِئْتَ جَعَلْتَهُ سَرْمَداً"
  },
  {
   "segment_id": 7,
   "arabic": "حَمْداً دَائِماً لاَ يَنْقَطِعُ اَبَداً"
  },
  {
   "segment_id": 8,
   "arabic": "وَلاَ يُحْصِي لَهُ ٱلخَلائِقُ عَدَداً"
  },
  {
   "segment_id": 9,
   "arabic": "اَللَّهُمَّ لَكَ ٱلْحَمْدُ انْ خَلَقْتَ فَسَوَّيْتَ"
  },
  {
   "segment_id": 10,
   "arabic": "وَقَدَّرْتَ وَقَضَيْتَ"
  },
  {
   "segment_id": 11,
   "arabic": "وَ امَتَّ وَ احْيَيْتَ"
  },
  {
   "segment_id": 12,
   "arabic": "وَ امْرَضْتَ وَشَفَيْتَ"
  },
  {
   "segment_id": 13,
   "arabic": "وَعَافَيْتَ وَ ابْلَيْتَ"
  },
  {
   "segment_id": 14,
   "arabic": "وَعَلَىٰ ٱلْعَرْشِ ٱسْتَوَيْتَ"
  },
  {
   "segment_id": 15,
   "arabic": "وَعَلَىٰ ٱلْمُلْكِ ٱحْتَوَيْتَ"
  },
  {
   "segment_id": 16,
   "arabic": "ادْعُوكَ دُعَاءَ مَنْ ضَعُفَتْ وَسِيلَتُهُ"
  },
  {
   "segment_id": 17,
   "arabic": "وَٱنْقَطَعَتْ حِيلَتُهُ"
  },
  {
   "segment_id": 18,
   "arabic": "وَٱقْتَرَبَ اجَلُهُ"
  },
  {
   "segment_id": 19,
   "arabic": "وَتَدَانَىٰ فِي ٱلدُّنْيَا امَلُهُ"
  },
  {
   "segment_id": 20,
   "arabic": "وَٱشْتَدَّتْ إِلَىٰ رَحْمَتِكَ فَاقَتُهُ"
  },
  {
   "segment_id": 21,
   "arabic": "وَعَظُمَتْ لِتَفْرِيطِهِ حَسْرَتُهُ"
  },
  {
   "segment_id": 22,
   "arabic": "وَكَثُرَتْ زَلَّتُهُ وَعَثْرَتُهُ"
  },
  {
   "segment_id": 23,
   "arabic": "وَخَلُصَتْ لِوَجْهِكَ تَوْبَتُهُ"
  },
  {
   "segment_id": 24,
   "arabic": "فَصَلِّ عَلَىٰ مُحَمَّدٍ"
  },
  {
   "segment_id": 25,
   "arabic": "خَاتَمِ النَّبِيّينَ"
  },
  {
   "segment_id": 26,
   "arabic": "وَعَلَىٰ اهْلِ بَيْتِهِ ٱلطَّيِّبِينَ ٱلطَّاهِرِينَ"
  },
  {
   "segment_id": 27,
   "arabic": "وَٱرْزُقْنِي شَفَاعَةَ مُحَمَّدٍ"
  },
  {
   "segment_id": 28,
   "arabic": "صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ"
  },
  {
   "segment_id": 29,
   "arabic": "وَلاَ تَحْرِمْنِي صُحْبَتَهُ"
  },
  {
   "segment_id": 30,
   "arabic": "إِنَّكَ انْتَ ارْحَمُ ٱلرَّاحِمِينَ"
  },
  {
   "segment_id": 31,
   "arabic": "اَللَّهُمَّ ٱقْضِ لِي فِي ٱلارْبِعَاءِ اَرْبَعاً"
  },
  {
   "segment_id": 32,
   "arabic": "إِجْعَلْ قُوَّتِي فِي طَاعَتِكَ"
  },
  {
   "segment_id": 33,
   "arabic": "وَنَشَاطِي فِي عِبَادَتِكَ"
  },
  {
   "segment_id": 34,
   "arabic": "وَرَغْبَتِي فِي ثَوَابِكَ"
  },
  {
   "segment_id": 35,
   "arabic": "وَزُهْدِي فِيمَا يُوجِبُ لِي الِيمَ عِقَابِكَ"
  },
  {
   "segment_id": 36,
   "arabic": "إِنَّكَ لَطِيفٌ لِمَا تَشَاءُ"
  }
 ]
}