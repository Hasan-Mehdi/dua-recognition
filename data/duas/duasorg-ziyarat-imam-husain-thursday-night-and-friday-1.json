{
 "dua_id": "duasorg-ziyarat-imam-husain-thursday-night-and-friday-1",
 "dua_name_en": "Ziyarat of Imam Husain (as) on Thursday Night and Friday",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ziyarat-imam-husain-thursday-night-and-friday.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللّهُمَّ إِنِّي أَعْتَزُّ بِدِينِكَ ،"
  },
  {
   "segment_id": 2,
   "arabic": "وَأَكْرَمُ بِهِدَايَتِكَ ،"
  },
  {
   "segment_id": 3,
   "arabic": "وَفُلانٌ يُذِلُّني بِشَرِّهِ ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَيُهِينُني بِأَذِيَّتِهِ ،"
  },
  {
   "segment_id": 5,
   "arabic": "وَيَعِيبُني بِوِلاءِ أَوْلِيائِكَ ،"
  },
  {
   "segment_id": 6,
   "arabic": "وَيَبْهَتُني بِدَعْوَاهُ ،"
  },
  {
   "segment_id": 7,
   "arabic": "وَقَدْ جِئْتُ إِلى مَوْضِعِ الدُّعاءِ وَضِمانِكَ الاِْجابَةِ ،"
  },
  {
   "segment_id": 8,
   "arabic": "اَللّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَآلِ مُحَمَّدٍ ،"
  },
  {
   "segment_id": 9,
   "arabic": "وَأَعْدِني عَلَيْهِ السَّاعَةَ - السَّاعَةَ - ."
  }
 ]
}