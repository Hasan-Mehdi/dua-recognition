{
 "dua_id": "duasorg-ramadan-end-farewell-1",
 "dua_name_en": "Recommended on 29th and 30th",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-end-farewell.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "يَا حَيّ يَا قَيّومُ،"
  },
  {
   "segment_id": 2,
   "arabic": "يَا ذَا الجَلالِ وَالإِكرَامِ،"
  },
  {
   "segment_id": 3,
   "arabic": "يَارَحْمَانَ الدّنيَا وَالآخِرَةِ وَرَحِيمَهُمَا،"
  },
  {
   "segment_id": 4,
   "arabic": "يَا أَرْحَمَ الرَّاحِمِينَ،"
  },
  {
   "segment_id": 5,
   "arabic": "يَاإِلهَ الأَوّلِينَ وَالآخِرِينَ،"
  },
  {
   "segment_id": 6,
   "arabic": "اغْفِرْ لَنَا ذُنُوبَنَا،"
  },
  {
   "segment_id": 7,
   "arabic": "وَتَقَبّلْ مِنَّا صَلاتَنَا وَصِيَامَنَا وَقِيَامَنَا."
  }
 ]
}