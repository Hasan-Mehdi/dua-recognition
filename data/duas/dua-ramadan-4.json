{
 "dua_id": "dua-ramadan-4",
 "dua_name_en": "Day 4",
 "dua_name_ar": "شهر رمضان ٤",
 "source": "https://www.duaplayer.org/en/dua/ramadan-4",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "اللّهُمّ قَوّنِي فِيهِ عَلَى إِقَامَةِ أَمْرِكَ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَأَذِقْنِي فِيهِ حَلاوَةَ ذِكْرِكَ،"
  },
  {
   "segment_id": 5,
   "arabic": "وَأَوْزِعْنِي فِيهِ لأَدَاءِ شُكْرِكَ بِكَرَمِكَ،"
  },
  {
   "segment_id": 6,
   "arabic": "وَاحْفَظْنِي فِيهِ بِحِفْظِكَ وَسَتْرِكَ،"
  },
  {
   "segment_id": 7,
   "arabic": "يَا أَبْصَرَ النَّاظِرِينَ."
  }
 ]
}