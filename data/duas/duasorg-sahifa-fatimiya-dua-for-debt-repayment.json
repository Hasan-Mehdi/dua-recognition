{
 "dua_id": "duasorg-sahifa-fatimiya-dua-for-debt-repayment",
 "dua_name_en": "Duas of Sayeda Fatima (sa) for Debt Repayment",
 "dua_name_ar": "",
 "source": "https://www.duas.org/sahifa-fatimiya-dua-for-debt-repayment.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللّٰهُمَّ رَبَّ السَّمَاوَاتِ السَّبْعِ"
  },
  {
   "segment_id": 2,
   "arabic": "وَ رَبَّ الْعَرْشِ الْعَظِيْمِ"
  },
  {
   "segment_id": 3,
   "arabic": "رَبَّنَا وَ رَبَّ كُلِّ شَيْءٍ"
  },
  {
   "segment_id": 4,
   "arabic": "مُنْزِلَ التَّوْرَاةِ وَ الْاِنْجِيْلِ وَ الْفُرْقَانِ"
  },
  {
   "segment_id": 5,
   "arabic": "فَالِقَ الْحَبِّ وَ النَّوَى"
  },
  {
   "segment_id": 6,
   "arabic": "اَعُوْذُ بِكَ مِنْ كُلِّ شَيْءٍ اَنْتَ آخِذٌ بِنَاصِيَتِهِ"
  },
  {
   "segment_id": 7,
   "arabic": "اَنْتَ الْاَوَّلُ فَلَيْسَ قَبْلَكَ شَيْءٌ"
  },
  {
   "segment_id": 8,
   "arabic": "وَ اَنْتَ الْآخِرُ فَلَيْسَ بَعْدَكَ شَيْءٌ"
  },
  {
   "segment_id": 9,
   "arabic": "وَ اَنْتَ الظَّاهِرُ فَلَيْسَ فَوْقَكَ شَيْءٌ"
  },
  {
   "segment_id": 10,
   "arabic": "وَ اَنْتَ الْبَاطِنُ فَلَيْسَ دُوْنَكَ شَيْءٌ"
  },
  {
   "segment_id": 11,
   "arabic": "اِقْضِ عَنِّي الدَّيْنَ"
  },
  {
   "segment_id": 12,
   "arabic": "وَ اَغْنِنِي مِنَ الْفَقْرِ"
  },
  {
   "segment_id": 13,
   "arabic": "اَللّٰهُمَّ رَبَّ السَّمَاوَاتِ وَ رَبَّ الْاَرَضِيْنَ"
  },
  {
   "segment_id": 14,
   "arabic": "وَ رَبَّ كُلِّ شَيْءٍ"
  },
  {
   "segment_id": 15,
   "arabic": "فَالِقَ الْحَبِّ وَ النَّوَى"
  },
  {
   "segment_id": 16,
   "arabic": "وَ مُنْزِلَ التَّوْرَاةِ وَ الْاِنْجِيْلِ وَ الْقُرْآنِ"
  },
  {
   "segment_id": 17,
   "arabic": "اَعُوْذُ بِكَ مِنْ كُلِّ ذِيْ شَرٍّ اَنْتَ آخِذٌ بِنَاصِيَتِهِ"
  },
  {
   "segment_id": 18,
   "arabic": "اَنْتَ الْاَوَّلُ فَلَيْسَ قَبْلَكَ شَيْءٌ"
  },
  {
   "segment_id": 19,
   "arabic": "وَ اَنْتَ الْآخِرُ فَلَيْسَ بَعْدَكَ شَيْءٌ"
  },
  {
   "segment_id": 20,
   "arabic": "وَ الظَّاهِرُ فَلَيْسَ فَوْقَكَ شَيْءٌ"
  },
  {
   "segment_id": 21,
   "arabic": "وَ الْبَاطِنُ فَلَيْسَ دُوْنَكَ شَيْءٌ"
  },
  {
   "segment_id": 22,
   "arabic": "اِقْضِ عَنِّي الدَّيْنَ"
  },
  {
   "segment_id": 23,
   "arabic": "وَ اَغْنِنِي مِنَ الْفَقْرِ"
  }
 ]
