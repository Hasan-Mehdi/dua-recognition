   "arabic": "وَبَارَكْتَ لِيَعْقُوبَ إِسْرَائيلِكَ"
  },
  {
   "segment_id": 107,
   "arabic": "فِي امَّةِ مُوسَىٰ عَلَيْهِمَا ٱلسَّلاَمُ"
  },
