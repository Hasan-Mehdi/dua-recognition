{
 "dua_id": "dua-simaat",
 "dua_name_en": "Dua Simaat",
 "dua_name_ar": "دعاء السمات",
 "source": "https://www.duaplayer.org/en/dua/simaat",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "ِسْمِ ٱللَّهِ ٱلرَّحْمٰنِ ٱلرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اللَّهُمَّ إِنِّي اسْالُكَ بِٱسْمِكَ ٱلْعَظِيمِ ٱلاعْظَمِ"
  },
  {
   "segment_id": 3,
   "arabic": "ٱلاعَزِّ ٱلاجَلِّ ٱلاكْرَمِ"
  },
  {
   "segment_id": 4,
   "arabic": "ٱلَّذِي إِذَا دُعِيتَ بِهِ عَلَىٰ مَغَاِلقِ ابْوَابِ ٱلسَّمَاء لِلْفَتْحِ بِٱلرَّحْمَةِ ٱنْفَتَحَتْ"
  },
  {
   "segment_id": 5,
   "arabic": "وَإِذَا دُعِيتَ بِهِ عَلَىٰ مَضَائقِ ابْوَابِ ٱلارْضِ لِلْفَرَجِ ٱنْفَرَجَتْ"
  },
  {
   "segment_id": 6,
   "arabic": "وَإِذَا دُعِيتَ بِهِ عَلىٰ ٱلْعُسْرِ لِلْيُسْرِ تَيَسَّرَتْ"
  },
  {
   "segment_id": 7,
   "arabic": "وَإِذَا دُعِيتَ بِهِ عَلىٰ ٱلامْوَاتِ لِلنُّشُورِ ٱنتَشَرَتْ"
  },
  {
   "segment_id": 8,
   "arabic": "وَإِذَا دُعِيتَ بِهِ عَلَىٰ كَشْفِ ٱلْبَاسَاء وَٱلضَّرَّاء ٱنْكَشَفَتْ"
  },
  {
   "segment_id": 9,
   "arabic": "وَبِجَلاَلِ وَجْهِكَ ٱلْكَرِيمِ"
  },
  {
   "segment_id": 10,
   "arabic": "اكْرَمِ ٱلْوُجُوهِ وَاعَزِّ ٱلْوُجُوهِ"
  },
  {
   "segment_id": 11,
   "arabic": "ٱلَّذِي عَنَتْ لَهُ ٱلْوُجُوهُ"
  },
  {
   "segment_id": 12,
   "arabic": "وَخَضَعَتْ لَهُ ٱلرِّقَابُ"
  },
  {
   "segment_id": 13,
   "arabic": "وَخَشَعَتْ لَهُ ٱلاصْوَاتُ"
  },
  {
   "segment_id": 14,
   "arabic": "وَوَجِلَتْ لَهُ ٱلْقُلُوبُ مِنْ مَخَافَتِكَ"
  },
  {
   "segment_id": 15,
   "arabic": "وَبِقُوَّتِكَ ٱلَّتِي بِهَا"
  },
  {
   "segment_id": 16,
   "arabic": "تُمْسِكُ ٱلسَّمَاء ان تَقَعَ عَلىٰ ٱلارْضِ إِلاَّ بِإِذْنِكَ"
  },
  {
   "segment_id": 17,
   "arabic": "وَتُمْسِكُ ٱلسَّمَاوَاتِ وَٱلارْضَ ان تَزُولاَ"
  },
  {
   "segment_id": 18,
   "arabic": "وَبِمَشِيئَتِكَ ٱلَّتِي دَان لَهَا ٱلْعَالَمُونَ"
  },
  {
   "segment_id": 19,
   "arabic": "وَبِكَلِمَتِكَ ٱلَّتِي خَلَقْتَ بِهَا ٱلسَّمَاوَاتِ وَٱلارْضَ"
  },
  {
   "segment_id": 20,
   "arabic": "وَبِحِكْمَتِكَ ٱلَّتِي صَنَعْتَ بِهَا ٱلْعَجَائبَ"
  },
  {
   "segment_id": 21,
   "arabic": "وَخَلَقْتَ بِهَا ٱلظُّلْمَةَ وَجَعَلْتَهَا لَيْلاً"
  },
  {
   "segment_id": 22,
   "arabic": "وَجَعَلْتَ ٱللَّيْلَ سَكَناً"
  },
  {
   "segment_id": 23,
   "arabic": "وَخَلَقْتَ بِهَا ٱلنُّورَ وَجَعَلْتَهُ نَهَاراً"
  },
  {
   "segment_id": 24,
   "arabic": "وَجَعَلْتَ ٱلنَّهَارَ نُشُوراً مُبْصِراً"
  },
  {
   "segment_id": 25,
   "arabic": "وَخَلَقْتَ بِهَا ٱلشَّمْسَ وَجَعَلْتَ ٱلشَّمْسَ ضِيَاءاً"
  },
  {
   "segment_id": 26,
   "arabic": "وَخَلَقْتَ بِهَا ٱلقَمَرَ وَجَعَلْتَ ٱلقَمَرَ نُوراً"
  },
  {
   "segment_id": 27,
   "arabic": "وَخَلَقْتَ بِهَا ٱلْكَوَاكِبَ"
  },
  {
   "segment_id": 28,
   "arabic": "وَجَعَلْتَهَا نُجُوماً وبُرُوجاً وَمَصَابِيحَ وَزِينَةً وَرُجُوماً"
  },
  {
   "segment_id": 29,
   "arabic": "وَجَعَلْتَ لَهَا مَشَارِقَ وَمَغَارِبَ"
  },
  {
   "segment_id": 30,
   "arabic": "وَجَعَلْتَ لَهَا مَطَاِلعَ وَمَجَارِيَ"
  },
  {
   "segment_id": 31,
   "arabic": "وَجَعَلْتَ لَهَا فَلَكاً وَمَسَابِحَ"
  },
  {
   "segment_id": 32,
   "arabic": "وَقَدَّرْتَهَا فِي ٱلسَّمَاء مَنَازِلَ فَاحْسَنتَ تَقْدِيرَهَا"
  },
  {
   "segment_id": 33,
   "arabic": "وَصَوَّرْتَهَا فَاحْسَنتَ تَصْوِيرَهَا"
  },
  {
   "segment_id": 34,
   "arabic": "وَاحْصَيْتَهَا بِاسْمَائكَ إِحْصَاءاً"
  },
  {
   "segment_id": 35,
   "arabic": "وَدَبَّرْتَهَا بِحِكْمَتِكَ تَدْبِيراً وَاحْسَنتَ تَدْبِيرَهَا"
  },
  {
   "segment_id": 36,
   "arabic": "وَسَخَّرْتَهَا بِسُلْطَانِ ٱللَّيْلِ وَسُلْطَانِ ٱلنَّهَارِ"
  },
  {
   "segment_id": 37,
   "arabic": "وَٱلسَّاعَاتِ وَعَدَدِ ٱلسِّنِينَ وَٱلْحِسَابِ"
  },
  {
   "segment_id": 38,
   "arabic": "وَجَعَلْتَ رُؤْيَتَهَا لِجَمِيعِ النَّاسِ مَرْأىً وَاحِداً"
  },
  {
   "segment_id": 39,
   "arabic": "وَاسْالُكَ ٱللَّهُمَّ بِمَجْدِكَ"
  },
  {
   "segment_id": 40,
   "arabic": "ٱلَّذِي كَلَّمْتَ بِهِ عَبْدَكَ وَرَسُولَكَ مُوسَىٰ بْنَ عِمْرَانَ عَلَيْهِ ٱلسَّلاَمُ فِي ٱلْمُقَدَّسِينَ"
  },
  {
   "segment_id": 41,
   "arabic": "فَوْقَ إِحْسَاسِ ٱلكَرُوبِيِّينَ"
  },
  {
   "segment_id": 42,
   "arabic": "فَوْقَ غَمَائمِ ٱلنُّورِ"
  },
  {
   "segment_id": 43,
   "arabic": "فَوْقَ تَابُوتِ ٱلشَّهَادَةِ"
  },
  {
   "segment_id": 44,
   "arabic": "فِي عَمُودِ ٱلنَّارِ وَفِي طُورِ سَيْنَاء"
  },
  {
   "segment_id": 45,
   "arabic": "وَفِي جَبَلِ حُورِيثَ"
  },
  {
   "segment_id": 46,
   "arabic": "فِي ٱلْوَادِي ٱلْمُقَدَّسِ"
  },
  {
   "segment_id": 47,
   "arabic": "فِي ٱلْبُقْعَةِ ٱلْمُبَارَكَةِ"
  },
  {
   "segment_id": 48,
   "arabic": "مِن جَانِبِ ٱلطُّورِ ٱلايْمَنِ مِنَ ٱلشَّجَرَةِ"
  },
  {
   "segment_id": 49,
   "arabic": "وَفِي ارْضِ مِصْرَ بِتِسْعِ آيَاتٍ بَيِّنَاتٍ"
  },
  {
   "segment_id": 50,
   "arabic": "وَيَوْمَ فَرَقْتَ لِبَنِي إِسْرَائيلَ ٱلْبَحْرَ"
  },
  {
   "segment_id": 51,
   "arabic": "وَفِي ٱلْمُنْبَجِسَاتِ ٱلَّتِي صَنَعْتَ بِهَا ٱلْعَجَائبَ فِي بَحْرِ سُوفٍ"
  },
  {
   "segment_id": 52,
   "arabic": "وَعَقَدْتَ مَاء ٱلْبَحْرِ فِي قَلْبِ ٱلْغَمْرِ كَٱلْحِجَارَةِ"
  },
  {
   "segment_id": 53,
   "arabic": "وَجَاوَزْتَ بِبَنِي إِسْرَائيلَ ٱلْبَحْرَ"
  },
  {
   "segment_id": 54,
   "arabic": "وَتَمَّتْ كَلِمَتُكَ ٱلْحُسْنَىٰ عَلَيْهِم بِمَا صَبرُوٱ"
  },
  {
   "segment_id": 55,
   "arabic": "وَاوْرَثْتَهُم مَشَارِقَ ٱلارْضِ وَمَغَارِبَهَا ٱلَّتِي بَارَكْتَ فِيهَا لِلْعَالَمِينَ"
  },
  {
   "segment_id": 56,
   "arabic": "وَاغْرَقْتَ فِرْعَوْنَ وَجُنُودَهُ وَمَرَاكِبَهُ فِي ٱليَمِّ"
  },
  {
   "segment_id": 57,
   "arabic": "وَبِٱسْمِكَ ٱلْعَظِيمِ ٱلاعْظَمِ"
  },
  {
   "segment_id": 58,
   "arabic": "ٱلاعَزِّ ٱلاجَلِّ ٱلاكْرَمِ"
  },
  {
   "segment_id": 59,
   "arabic": "وَبِمَجْدِكَ ٱلَّذِي تَجَلَّيْتَ بِهِ لِمُوسَىٰ كَلِيمِكَ عَلَيْهِ ٱلسَّلاَمُ فِي طُورِ سَيْنَاء"
  },
  {
   "segment_id": 60,
   "arabic": "وَإِبْرَاهِيمَ عَلَيْهِ ٱلسَّلاَمُ خَلِيلِكَ مِنْ قَبْلُ فِي مَسْجِدِ ٱلْخِيفِ"
  },
  {
   "segment_id": 61,
   "arabic": "وَإِسْحَاقَ صَفِيِّكَ عَلَيْهِ ٱلسَّلاَمُ فِي بِئْرِ شِيعٍ"
  },
  {
   "segment_id": 62,
   "arabic": "وَلِيَعْقُوبَ نَبِيِّكَ عَلَيْهِ ٱلسَّلاَمُ فِي بَيْتِ إِيلٍ"
  },
  {
   "segment_id": 63,
   "arabic": "وَاوْفَيْتَ إِبْرِاهِيمَ عَلَيْهِ ٱلسَّلاَمُ بِمِيثَاقِكَ"
  },
  {
   "segment_id": 64,
   "arabic": "وَإِسْحَاقَ بِحِلْفِكَ"
  },
  {
   "segment_id": 65,
   "arabic": "وَلِيَعْقُوبَ بِشَهَادَتِكَ"
  },
  {
   "segment_id": 66,
   "arabic": "وَلِلْمُؤْمِنِينَ بِوَعْدِكَ"
  },
  {
   "segment_id": 67,
   "arabic": "وَلِلدَّاعِينَ بِاسْمَائكَ فَاجَبْتَ"
  },
  {
   "segment_id": 68,
   "arabic": "وَبِمَجْدِكَ ٱلَّذِي ظَهَرَ لِمُوسَىٰ بْنِ عِمْرَانَ عَلَيْهِ ٱلسَّلاَمُ عَلَىٰ قُبَّةِ ٱلرُّمَّانِ"
  },
  {
   "segment_id": 69,
   "arabic": "وَبِآيَاتِكَ ٱلَّتِي وَقَعَتْ عَلَىٰ ارْضِ مِصْرَ"
  },
  {
   "segment_id": 70,
   "arabic": "بِمَجْدِ ٱلْعِزَّةِ وَٱلْغَلَبَةِ"
  },
  {
   "segment_id": 71,
   "arabic": "بِآيَاتٍ عَزِيزَةٍ"
  },
  {
   "segment_id": 72,
   "arabic": "وَبِسُلْطَانِ ٱلْقُوَّةِ"
  },
  {
   "segment_id": 73,
   "arabic": "وَبِعِزَّةِ ٱلْقُدْرَةِ"
  },
  {
   "segment_id": 74,
   "arabic": "وَبِشَاْنِ ٱلْكَلِمَةِ ٱلتَّامَّةِ"
  },
  {
   "segment_id": 75,
   "arabic": "وَبِكَلِمَاتِكَ ٱلَّتِي تَفَضَّلْتَ بِهَا عَلَىٰ اهْلِ ٱلسَّمَاوَاتِ وَٱلارْضِ"
  },
  {
   "segment_id": 76,
   "arabic": "وَاهْلِ ٱلدُّنْيَا وَاهْلِ ٱلآخِرَةِ"
  },
  {
   "segment_id": 77,
   "arabic": "وَبِرَحْمَتِكَ ٱلَّتِي مَنَنتَ بِهَا عَلَىٰ جَمِيعِ خَلْقِكَ"
  },
  {
   "segment_id": 78,
   "arabic": "وَبِٱسْتِطَاعَتِكَ الَّتِي اقَمْتَ بِهَا عَلىٰ ٱلْعَالَمِينَ"
  },
  {
   "segment_id": 79,
   "arabic": "وَبِنُورِكَ ٱلَّذِي قَدْ خَرَّ مِنْ فَزَعِهِ طُورُ سَيْنَاء"
  },
  {
   "segment_id": 80,
   "arabic": "وَبِعِلْمِكَ وَجَلاَلِكَ وَكِبْرِيَائكَ وَعِزَّتِكَ"
  },
  {
   "segment_id": 81,
   "arabic": "وَجَبرُوتِكَ ٱلَّتِي لَمْ تَسْتَقِلَّهَا ٱلارَضُ"
  },
  {
   "segment_id": 82,
   "arabic": "وَٱنْخَفَضَتْ لَهَا ٱلسَّمَاوَاتُ"
  },
  {
   "segment_id": 83,
   "arabic": "وَٱنْزَجَرَ لَهَا ٱلْعُمْقُ ٱلاكْبرُ"
  },
  {
   "segment_id": 84,
   "arabic": "وَرَكَدَتْ لَهَا ٱلْبِحَارُ وَٱلانْهَارُ"
  },
  {
   "segment_id": 85,
   "arabic": "وَخَضَعَتْ لَهَا ٱلْجِبَالُ"
  },
  {
   "segment_id": 86,
   "arabic": "وَسَكَنَتْ لَهَا ٱلارْضُ بِمَنَاكِبِهَا"
  },
  {
   "segment_id": 87,
   "arabic": "وَٱسْتَسْلَمَتْ لَهَا ٱلْخَلائقُ كُلُّهَا"
  },
  {
   "segment_id": 88,
   "arabic": "وَخَفَقَتْ لَهَا ٱلرِّيَاحُ فِي جَرَيَانِهَا"
  },
  {
   "segment_id": 89,
   "arabic": "وَخَمَدَتْ لَهَا ٱلنِّيـرَانُ فِي اوْطَانِهَا"
  },
  {
   "segment_id": 90,
   "arabic": "وَبِسُلْطَانِكَ ٱلَّذِي عُرِفَتْ لَكَ بِهِ ٱلْغَلَبَةُ دَهْرَ ٱلدُّهُورِ"
  },
  {
   "segment_id": 91,
   "arabic": "وَحُمِدْتَ بِهِ فِي ٱلسَّمَاوَاتِ وَٱلارَضِينَ"
  },
  {
   "segment_id": 92,
   "arabic": "وَبِكَلِمَتِكَ كَلِمَةِ ٱلصِّدْقِ ٱلَّتِي سَبَقَتْ لابِينَا آدَمَ عَلَيْهِ ٱلسَّلاَمُ وَذُرِّيَّتِهِ بٱلرَّحْمَةِ"
  },
  {
   "segment_id": 93,
   "arabic": "وَاسْالُكَ بِكَلِمَتِكَ ٱلَّتِي غَلَبَتْ كُلَّ شَيْءٍ"
  },
  {
   "segment_id": 94,
   "arabic": "وَبِنُورِ وَجْهِكَ ٱلَّذِي تَجَلَّيْتَ بِهِ لِلْجَبَلِ"
  },
  {
   "segment_id": 95,
   "arabic": "فَجَعَلْتَهُ دَكّاً وَخَرَّ مُوسَىٰ صَعِقاً"
  },
  {
   "segment_id": 96,
   "arabic": "وَبِمَجْدِكَ ٱلَّذِي ظَهَرَ عَلَىٰ طُورِ سَينْاءَ"
  },
  {
   "segment_id": 97,
   "arabic": "فَكَلَّمْتَ بِهِ عَبْدَكَ وَرَسُولَكَ مُوسَىٰ بْنَ عِمْرَانَ"
  },
