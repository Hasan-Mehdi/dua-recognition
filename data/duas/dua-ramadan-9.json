{
 "dua_id": "dua-ramadan-9",
 "dua_name_en": "Day 9",
 "dua_name_ar": " شهر رمضان ٩  ",
 "source": "https://www.duaplayer.org/en/dua/ramadan-9",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "اللّهُمّ اجْعَلْ لِي فِيهِ نَصِيباً مِنْ رَحْمَتِكَ الوَاسِعَةِ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَاهْدِنِي فِيهِ لِبَرَاهِينِكَ السَّاطِعَةِ،"
  },
  {
   "segment_id": 5,
   "arabic": "وَخُذْ بِنَاصِيَتِي إِلَى مَرْضَاتِكَ الجَامِعَةِ،"
  },
  {
   "segment_id": 6,
   "arabic": "بِمَحَبّتِكَ يَا أَمَلَ المُشْتَاقِينَ."
  }
 ]
}