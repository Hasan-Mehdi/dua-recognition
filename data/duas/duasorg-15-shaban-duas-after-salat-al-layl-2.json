{
 "dua_id": "duasorg-15-shaban-duas-after-salat-al-layl-2",
 "dua_name_en": "Sujood after Salat al-Layl",
 "dua_name_ar": "",
 "source": "https://www.duas.org/15-shaban-duas-after-salat-al-layl.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "سَجَدَ لَكَ سَوَادِي وَخَيَالِي،"
  },
  {
   "segment_id": 2,
   "arabic": "وَآمَنَ بِكَ فُؤَادِي،"
  },
  {
   "segment_id": 3,
   "arabic": "هذِهِ يَدَايَ وَمَا جَنَيْتُهُ عَلَى نَفْسِي،"
  },
  {
   "segment_id": 4,
   "arabic": "يَا عَظِيمُ تُرْجَى لِكُلِّ عَظِيمٍ"
  },
  {
   "segment_id": 5,
   "arabic": "اغْفِرْ لِيَ الْعَظِيمَ"
  },
  {
   "segment_id": 6,
   "arabic": "فَإنَّهُ لا يَغْفِرُ الذَّنْبَ الْعَظِيمَ إلاَّ الرَّبُّ الْعَظِيمُ."
  },
  {
   "segment_id": 7,
   "arabic": "The Holy Prophet (a.s) then raised his head and then prostrated himself again, saying:"
  },
  {
   "segment_id": 8,
   "arabic": "أَعُوذُ بِنُورِ وَجْهِكَ الَّذِي أَضَاءَتْ لَهُ السَّمَاوَاتُ وَالأَرَضُونَ،"
  },
  {
   "segment_id": 9,
   "arabic": "وَانْكَشَفَتْ لَهُ الظُّلُمَاتُ،"
  },
  {
   "segment_id": 10,
   "arabic": "وَصَلَحَ عَلَيْهِ أَمْرُ الأَوَّلِينَ وَالآخِرِينَ"
  },
  {
   "segment_id": 11,
   "arabic": "مِنْ فُجْأَةِ نَقِمَتِكَ،"
  },
  {
   "segment_id": 12,
   "arabic": "وَمِنْ تَحْوِيلِ عَافِيَتِكَ،"
  },
  {
   "segment_id": 13,
   "arabic": "وَمِنْ زَوَالِ نِعْمَتِكَ."
  },
  {
   "segment_id": 14,
   "arabic": "اللّهُمَّ ارْزُقْنِي قَلْباً تَقِيّاً نَقِيّاً"
  },
  {
   "segment_id": 15,
   "arabic": "وَمِنَ الشِّرْكِ بَرِيئاً"
  },
  {
   "segment_id": 16,
   "arabic": "لا كَافِراً وَلا شَقِيّاً."
  },
  {
   "segment_id": 17,
   "arabic": "The Holy Prophet (a.s) then attached his face to the ground and said:"
  },
  {
   "segment_id": 18,
   "arabic": "عَفَّرْتُ وَجْهِي فِي التُّرَابِ"
  },
  {
   "segment_id": 19,
   "arabic": "وَحُقَّ لِي أَنْ أَسْجُدَ لَكَ"
  }
 ]
}