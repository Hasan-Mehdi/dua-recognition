{
 "dua_id": "dua-ramadan-30",
 "dua_name_en": "Day 30",
 "dua_name_ar": " شهر رمضان ٦  ",
 "source": "https://www.duaplayer.org/en/dua/ramadan-30",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "اللّهُمّ اجْعَلْ صِيَامِي فِيهِ بِالشّكْرِ وَالقَبُولِ عَلَى مَا تَرْضَاهُ وَيَرْضَاهُ الرّسُولُ،"
  },
  {
   "segment_id": 4,
   "arabic": "مُحْكَمَةً فُرُوعُهُ بِالأُصُولِ،"
  },
  {
   "segment_id": 5,
   "arabic": "بِحَقّ سَيّدِنَا مُحَمّدٍ وَآلِهِ الطَّاهِرِينَ،"
  },
  {
   "segment_id": 6,
   "arabic": "وَالحَمْدُ لِلّهِ رَبّ العَالَمِينَ"
  }
 ]
}