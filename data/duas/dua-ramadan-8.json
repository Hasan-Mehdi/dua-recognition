 "dua_name_ar": " شهر رمضان ٨  ",
 "source": "https://www.duaplayer.org/en/dua/ramadan-8",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "اللّهُمّ ارْزُقْنِي فِيهِ رَحْمَةَ الأَيْتَامِ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَإِطْعَامَ الطّعَامِ،"
  },
  {
   "segment_id": 5,
   "arabic": "وَإِفْشَاءَ السّلامِ،"
  },
  {
   "segment_id": 6,
   "arabic": "وَصُحْبَةَ الكِرَامِ،"
  },
  {
   "segment_id": 7,
   "arabic": "بِطَوْلِكَ يَامَلْجَأَ الآمِلِينَ."
  }
 ]
}