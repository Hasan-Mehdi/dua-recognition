 "source": "https://www.duas.org/sahifa-fatimiya-short-dua-miscellaneous.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "قَدْ أَتَمَّ نِعْمَتَهُ"
  },
  {
   "segment_id": 2,
   "arabic": "وَ هَنَّانِي كَرَامَتَهُ"
  },
  {
   "segment_id": 3,
   "arabic": "وَ أَبَاحَنِي جَنَّتَهُ"
  },
  {
   "segment_id": 4,
   "arabic": "أَسْأَلُهُ وُلْدِي وَ ذُرِّيَّتِي وَ مَنْ وَدَّهُمْ"
  },
  {
   "segment_id": 5,
   "arabic": "قَدْ أَتَمَّ عَلَيَّ نِعْمَتَهُ"
  },
  {
   "segment_id": 6,
   "arabic": "وَ أَبَاحَنِي جَنَّتَهُ"
  },
  {
   "segment_id": 7,
   "arabic": "وَ هَنَّانِي كَرَامَتَهُ"
  },
  {
   "segment_id": 8,
   "arabic": "وَ فَضَّلَنِي عَلَى نِسَاءِ خَلْقِهِ"
  },
  {
   "segment_id": 9,
   "arabic": "أَسْأَلُهُ أَنْ يُشَفِّعَنِي فِي وُلْدِي وَ ذُرِّيَّتِي"
  },
  {
   "segment_id": 10,
   "arabic": "وَ مَنْ وَدَّهُمْ بَعْدِي وَ حَفِظَهُمْ بَعْدِي"
  },
  {
   "segment_id": 11,
   "arabic": "اَلْحَمْدُ لِلَّهِ الَّذِي أَذْهَبَ عَنَّا الْحَزَنَ"
  },
  {
   "segment_id": 12,
   "arabic": "وَ أَقَرَّ عَيْنِي"
  }
 ]
}