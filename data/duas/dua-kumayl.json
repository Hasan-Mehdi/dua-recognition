{
 "dua_id": "dua-kumayl",
 "dua_name_en": "Dua Kumayl",
 "dua_name_ar": "دعاء كميل",
 "source": "https://www.duaplayer.org/en/dua/kumayl",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اللَّهُمَّ إِنِّي أَسْألُكَ بِرَحْمَتِكَ الَّتِي وَسِعَتْ كُلَّ شَيٍْء"
  },
  {
   "segment_id": 3,
   "arabic": "وَبِقُوَّتِكَ الَّتِي قَهَرْتَ بِهَا كُلَّ شَيٍْء"
  },
  {
   "segment_id": 4,
   "arabic": "وَخَضَعَ لَهَا كُلُّ شَيٍْء"
  },
  {
   "segment_id": 5,
   "arabic": "وَذَلَّ لَهَا كُلُّ شَيٍْء"
  },
  {
   "segment_id": 6,
   "arabic": "وَبِجَبرُوتِكَ الَّتِي غَلَبْتَ بِهَا كُلَّ شَيٍْء"
  },
  {
   "segment_id": 7,
   "arabic": "وَبِعِزَّتِكَ الَّتِي لا يَقُومُ لَهَا شَيْءٌ"
  },
  {
   "segment_id": 8,
   "arabic": "وَبِعَظَمَتِكَ الَّتِي مَلَأَتْ كُلَّ شَيٍْء"
  },
  {
   "segment_id": 9,
   "arabic": "وَبِسُلْطَانِكَ الَّذِي عَلاَ كُلَّ شَيٍْء"
  },
  {
   "segment_id": 10,
   "arabic": "وَبِوَجْهِكَ الْبَاقِي بَعْدَ فَنَاءِ كُلِّ شَيٍْء"
  },
  {
   "segment_id": 11,
   "arabic": "وَبِأَسْمَائِكَ الَّتِي مَلَأَتْ أَرْكَانَ كُلِّ شَيٍْء"
  },
  {
   "segment_id": 12,
   "arabic": "وَبِعِلْمِكَ الَّذِي أَحَاطَ بِكُلِّ شَيٍْء"
  },
  {
   "segment_id": 13,
   "arabic": "وَبِنُورِ وَجْهِكَ الَّذِي أَضَاءَ لَهُ كُلُّ شَيٍْء"
  },
  {
   "segment_id": 14,
   "arabic": "يَّا نُورُ يَا قُدُّوسُ"
  },
  {
   "segment_id": 15,
   "arabic": "يَا أَوَّلَ الأَوَّلِينَ"
  },
  {
   "segment_id": 16,
   "arabic": "وَيَا آخِرَ الآخِرِينَ"
  },
  {
   "segment_id": 17,
   "arabic": "اَللَّهُمَ اغْفِرْ لِي الذُّنُوبَ الَّتِي تَهتِكُ الْعِصَمَ"
  },
  {
   "segment_id": 18,
   "arabic": "اَللَّهُمَ اغْفِرْ لِيَ الذُّنُوبَ الَّتِي تُنْزِلُ النِّقَمَ"
  },
  {
   "segment_id": 19,
   "arabic": "اَللَّهُمَ اغْفِرْ لِيَ الذُّنُوبَ الَّتِي تُغيِّرُ النِّعَمَ"
  },
  {
   "segment_id": 20,
   "arabic": "اَللَّهُمَّ اغْفِرْ لِيَ الذُّنُوبَ الَّتِي تَحْبِسُ الدُّعَاءَ"
  },
  {
   "segment_id": 21,
   "arabic": "اَللَّهُمَّ اغْفِرْ لِيَ الذُّنُوبَ الَّتِي تُنْزِلُ البَلآءَ"
  },
  {
   "segment_id": 22,
   "arabic": "اَللَّهُمَّ اغْفِرْ لِيْ كُلَّ ذَنْبٍ أَذْنَبْتُهُ وَكُلَّ خَطِيئَةٍ أَخْطَأْتُهَا"
  },
  {
   "segment_id": 23,
   "arabic": "اَللَّهُمَّ إِنِّي أَتَقَرَّبُ إِلَيْكَ بِذِكْرِكَ"
  },
  {
   "segment_id": 24,
   "arabic": "وَأَسْتَشْفِعُ بِكَ إِلَى نَفْسِكَ"
  },
  {
   "segment_id": 25,
   "arabic": "وَأَسْألُكَ بِجُودِكَ أَن تُدْنِيَنِي مِن قُرْبِكَ"
  },
  {
   "segment_id": 26,
   "arabic": "وَأَن تُوزِعَنِي شُكْرَكَ"
  },
  {
   "segment_id": 27,
   "arabic": "وَأَن تُلْهِمَنِي ذِكْرَكَ"
  },
  {
   "segment_id": 28,
   "arabic": "اَللَّهُمَّ إِنِّي أَسْألُكَ سُؤَالَ خَاضِعٍ مُّتَذَلِّلٍ خَاشِعٍ أَن تُسَامِحَنِي وَتَرْحَمَنِي"
  },
  {
   "segment_id": 29,
   "arabic": "وَتَجْعَلَنِي بِقِسْمِكَ رَاضِيًا قَانِعًا، وَفِي جَمِيعِ الأَحْوَاِل مُتَوَاضِعًا"
  },
  {
   "segment_id": 30,
   "arabic": "اَللَّهُمَّ وَأَسْألُكَ سُؤَالَ مَنِ اشْتَدَّتْ فَاقَتُهُ"
  },
  {
   "segment_id": 31,
   "arabic": "وَأَنْزَلَ بِكَ عِنْدَ الشَّدَائِدِ حَاجَتَهُ"
  },
  {
   "segment_id": 32,
   "arabic": "وَعَظُمَ فِيمَا عِنْدَكَ رَغْبَتُهُ"
  },
  {
   "segment_id": 33,
   "arabic": "اَللَّهُمَّ عَظُمَ سُلْطَانُكَ وَعَلاَ مَكَانُكَ"
  },
  {
   "segment_id": 34,
   "arabic": "وَخَفِيَ مَكْرُكَ وَظَهَرَ أَمْرُكَ"
  },
  {
   "segment_id": 35,
   "arabic": "وَغَلَبَ قَهْرُكَ وَجَرَتْ قُدْرَتُكَ"
  },
  {
   "segment_id": 36,
   "arabic": "وَلا يُمْكِنُ الْفِرَارُ مِنْ حُكُومَتِكَ"
  },
  {
   "segment_id": 37,
   "arabic": "اَللَّهُمَّ لا أَجِدُ لِذُنُوبِي غَافِرًا"
  },
  {
   "segment_id": 38,
   "arabic": "وَلا لِقَبَائِحِي سَاتِرًا"
  },
  {
   "segment_id": 39,
   "arabic": "وَلا لِشَيٍْء مِّنْ عَمَلِيَ الْقَبِيحِ بِالْحَسَنِ مُبَدِّلاً غَيْرَكَ"
  },
  {
   "segment_id": 40,
   "arabic": "لا إِلَهَ إِلا أَنْتَ"
  },
  {
   "segment_id": 41,
   "arabic": "سُبْحَانَكَ وَبِحَمْدِكَ"
  },
  {
   "segment_id": 42,
   "arabic": "ظَلَمْتُ نَفْسِي"
  },
  {
   "segment_id": 43,
   "arabic": "وَتَجَرَّأْتُ بِجَهْلِي"
  },
  {
   "segment_id": 44,
   "arabic": "وَسَكَنْتُ إِلَى قَدِيمِ ذِكْرِكَ لِي وَمَنِّكَ عَلَيَّ"
  },
  {
   "segment_id": 45,
   "arabic": "اللَّهُمَّ مَوْلايَ"
  },
  {
   "segment_id": 46,
   "arabic": "كَمْ مِّنْ قَبِيحٍ سَتَرْتَهُ"
  },
  {
   "segment_id": 47,
   "arabic": "وَكَمْ مِّن فَاِدحٍ مِّنَ البَلاءِ أَقَلْتَهُ"
  },
  {
   "segment_id": 48,
   "arabic": "وَكَمْ مِّنْ عِثَارٍ وَّقَيْتَهُ"
  },
  {
   "segment_id": 49,
   "arabic": "وَكَمْ مِّن مَّكْرُوهٍ دَفَعْتَهُ"
  },
  {
   "segment_id": 50,
   "arabic": "وَكَمْ مِّنْ ثَنَاءٍ جَمِيلٍ لَّسْتُ أَهْلاً لَّهُ نَشَرْتَهُ"
  },
  {
   "segment_id": 51,
   "arabic": "اَللَّهُمَّ عَظُمَ بَلائِي"
  },
  {
   "segment_id": 52,
   "arabic": "وَأَفْرَطَ بِي سُوءُ حَاِلي"
  },
  {
   "segment_id": 53,
   "arabic": "وَقَصُرَتْ بِي أَعْمَاِلي"
  },
  {
   "segment_id": 54,
   "arabic": "وَقَعَدَتْ بِي أَغْلاَلِي"
  },
  {
   "segment_id": 55,
   "arabic": "وَحَبَسَنِي عَن نَّفْعِي بُعْدُ آمَاِلي"
  },
  {
   "segment_id": 56,
   "arabic": "وَخَدَعَتْنِي الدُّنْيَا بِغُرُورِهَا وَنَفْسِي بِجِنایَتِهَا وَمِطَاِلي"
  },
  {
   "segment_id": 57,
   "arabic": "يَا سَيِّدِي فَأَسْأَلُكَ بِعِزَّتِكَ أَن لا يَحْجُبَ عَنْكَ دُعَآئِي سُوءُ عَمَلِي وَفِعَاِلي"
  },
  {
   "segment_id": 58,
   "arabic": "وَلا تَفْضَحْنِي بِخَفِيِّ مَا اطَّلَعْتَ عَلَيْهِ مِنْ سِرِّي"
  },
  {
   "segment_id": 59,
   "arabic": "وَلا تُعَاجِلْنِي بِالْعُقُوبَةِ عَلَى مَا عَمِلْتُهُ فِي خَلَوَاتِي"
  },
  {
   "segment_id": 60,
   "arabic": "مِنْ سُوءِ فِعْلِي وَإِسَاءَتِي،"
  },
  {
   "segment_id": 61,
   "arabic": "وَدَوَامِ تَفْرِيطِي وَجَهَالَتِي"
  },
  {
   "segment_id": 62,
   "arabic": "وَكَثْرَةِ شَهَوَاتِي وَغَفْلَتِي"
  },
  {
   "segment_id": 63,
   "arabic": "وَكُنِ اللَّهُمَّ بِعِزَّتِكَ لِي فِي كُلِّ الأَحْوَاِل رَؤُوفًا"
  },
  {
   "segment_id": 64,
   "arabic": "وَّعَلَيَّ فِي جَمِيعِ الأُمُورِ عَطُوفًا"
  },
  {
   "segment_id": 65,
   "arabic": "إِلَهِي وَرَبِّي مَن لِّي غَيْرُكَ أَسْأَلُهُ كَشْفَ ضُرِّي وَالْنَّظَرَ فِي أَمْرِي!"
  },
  {
   "segment_id": 66,
   "arabic": "إِلَهِي وَمَوْلايَ أَجْرَيْتَ عَلَيَّ حُكْمًا اتَّبَعْتُ فِيهِ هَوَى نَفْسِي،"
  },
  {
   "segment_id": 67,
   "arabic": "وَلَمْ أَحْتَرِسْ فِيهِ مِن تَزْيِيْنِ عَدُوِّي،"
  },
  {
   "segment_id": 68,
   "arabic": "فَغَرَّنِي بِمَا أَهْوَى وَأَسْعَدَهُ عَلَى ذَلِكَ القَضَاءُ"
  },
  {
   "segment_id": 69,
   "arabic": "فَتَجَاوَزْتُ بِمَا جَرَى عَلَيَّ مِنْ ذَلِكَ بَعْضَ حُدُودِكَ"
  },
  {
   "segment_id": 70,
   "arabic": "وَخَالَفْتُ بَعْضَ أَوَامِرِكَ"
  },
  {
   "segment_id": 71,
   "arabic": "فَلَكَ الْحُجَّةُ عَلَيَّ فِي جَمِيعِ ذَلِكَ"
  },
  {
   "segment_id": 72,
   "arabic": "وَلا حُجَّةَ لِي فِيمَا جَرَى عَلَيَّ فِيهِ قَضَاؤُكَ،"
  },
  {
   "segment_id": 73,
   "arabic": "وَأَلْزَمَنِي حُكْمُكَ وَبَلاؤُكَ"
  },
  {
   "segment_id": 74,
   "arabic": "وَقَدْ أَتَيْتُكَ يَا إِلَهِي بَعْدَ تَقْصِيرِي وَإِسْرَافِي عَلَى نَفْسِي"
  },
  {
   "segment_id": 75,
   "arabic": "مُعْتَذِرًا نَّادِمًا،"
  },
  {
   "segment_id": 76,
   "arabic": "مُّنْكَسِرًا مُّسْتَقِيلاً"
  },
  {
   "segment_id": 77,
   "arabic": "مُّسْتَغْفِرًا مُّنِيبًا،"
  },
  {
   "segment_id": 78,
   "arabic": "مُّقِرًّا مُّذْعِنًا مُّعْتَرِفًا"
  },
  {
   "segment_id": 79,
   "arabic": "لا أَجِدُ مَفَرًّا مِّمَّا كَانَ مِنِّي"
  },
  {
   "segment_id": 80,
   "arabic": "وَلا مَفْزَعًا أَتَوَجَّهُ إِلَيْهِ في أَمْرِي"
  },
  {
   "segment_id": 81,
   "arabic": "غَيْرَ قَبُولِكَ عُذْرِي، وَإِدخَالِكَ إِيَّايَ فِي سَعَةٍ مِّن رَّحْمَتِكَ"
  },
  {
   "segment_id": 82,
   "arabic": "اَللَّهُمَّ فَاقْبَل عُذْرِي"
  },
  {
   "segment_id": 83,
   "arabic": "وَارْحَمْ شِدَّةَ ضُرِّي"
  },
  {
   "segment_id": 84,
   "arabic": "وَفُكَّنِي مِنْ شَدِّ وَثَاقِي"
  },
  {
   "segment_id": 85,
   "arabic": "يَا رَبِّ ارْحَمْ ضَعْفَ بَدَنِي وَرِقَّةَ جِلْدِي وَدِقَّةَ عَظْمِي"
  },
  {
   "segment_id": 86,
   "arabic": "يَا مَنْ بَدَأَ خَلْقِي وَذِكْرِي وَتَرْبِيَتِي وَبِرِّي وَتَغْذِيَتِي"
  },
  {
   "segment_id": 87,
   "arabic": "هَبْنِي لابْتِدَآءِ كَرَمِكَ وَسَاِلفِ بِرِّكَ بِي"
  },
  {
   "segment_id": 88,
   "arabic": "يَا إِلَهِي وَسَيِّدِي وَرَبِّي"
  },
  {
   "segment_id": 89,
   "arabic": "أَتُرَاكَ مُعَذِّبِي بِنَارِكَ بَعْدَ تَوْحِيدِكَ"
  },
  {
   "segment_id": 90,
   "arabic": "وَبَعْدَ مَا انْطَوَى عَلَيْهِ قَلْبِي مِن مَّعْرِفَتِكَ"
  },
  {
   "segment_id": 91,
   "arabic": "وَلَهِجَ بِهِ لِسَانِي مِنْ ذِكْرِكَ"
  },
  {
   "segment_id": 92,
   "arabic": "وَاعْتَقَدَهُ ضَمِيرِي مِنْ حُبِّكَ"
  },
  {
   "segment_id": 93,
   "arabic": "وَبَعْدَ صِدْقِ اعْتِرَافِي وَدُعَائِي خَاضِعًا لِّرُبُوبِيَّتِكَ"
  },
  {
   "segment_id": 94,
   "arabic": "هَيْهَاتَ أَنْتَ أَكْرَمُ مِنْ أَنْ تُضَيِّعَ مَن رَّبَّيْتَهُ"
  },
  {
   "segment_id": 95,
   "arabic": "أَوْ تُبْعِدَ مَنْ أَدْنَيْتَهُ"
  },
  {
   "segment_id": 96,
   "arabic": "أَوْ تُشَرِّدَ مَنْ آوَيْتَهُ"
  },
  {
   "segment_id": 97,
   "arabic": "أَوْ تُسَلِّمَ إِلىَ الْبلآءِ مَن كَفَيْتَهُ وَرَحِمْتَهُ"
  },
  {
   "segment_id": 98,
   "arabic": "وَلَيْتَ شِعْرِي يَا سَيِّدِي وَإِلَهِي وَمَوْلايَ"
  },
  {
   "segment_id": 99,
   "arabic": "أَتُسَلِّطُ النَّارَ عَلَى وُجُوهٍ خَرَّتْ لِعَظَمَتِكَ سَاجِدَةً"
  },
  {
   "segment_id": 100,
   "arabic": "وَعَلَى أَلْسُنٍ نَّطَقَتْ بِتَوْحِيدِكَ صَادِقَةً وَّبِشُكْرِكَ مَادِحَةً"
  },
  {
   "segment_id": 101,
   "arabic": "وَعَلَى قُلُوبٍ اعْتَرَفَتْ بِإِلَهِيَّتِكَ مُحَقِّقَةً"
  },
  {
   "segment_id": 102,
   "arabic": "وَعَلَى ضَمَائِرَ حَوَتْ مِنَ الْعِلْمِ بِكَ حَتَّى صَارَتْ خَاشِعَةً"
  },
  {
   "segment_id": 103,
   "arabic": "وَعَلَى جَوَارِحَ  سَعَتْ إِلَى أَوْطَانِ تَعَبُّدِكَ طَائِعَةً وَّأَشَارَتْ بِاسْتِغْفَارِكَ مُذْعِنَةً"
  },
  {
   "segment_id": 104,
   "arabic": "مَّا هَكَذَا الظَّنُّ بِكَ وَلا أُخْبِرْنَا بِفَضْلِكَ عَنْكَ"
  },
  {
   "segment_id": 105,
   "arabic": "يَا كَرِيمُ، يَا رَبِّ"
  },
  {
   "segment_id": 106,
   "arabic": "وَأَنْتَ تَعْلَمُ ضَعْفِي عَنْ قَلِيلٍ مِّن بَلآءِ الدُّنْيَا وَعُقُوبَاتِهَا،"
  },
  {
   "segment_id": 107,
   "arabic": "وَمَا يَجْرِي فِيهَا مِنَ الْمَكَارِهِ عَلَى أَهْلِهَا"
  },
  {
   "segment_id": 108,
   "arabic": "عَلَى أَنَّ ذَلِكَ بَلآءٌ وَّمَكْرُوهٌ قَلِيلٌ مَّكْثُهُ، يَسِيرٌ بَقَآؤُهُ، قَصِيرٌ مُّدَّتُهُ"
  },
  {
   "segment_id": 109,
   "arabic": "فَكَيْفَ احْتِمَاِلي لِبَلآءِ الآخِرَةِ وَجَلِيلِ وُقُوعِ الْمَكَارِهِ فِيهَا!"
  },
  {
   "segment_id": 110,
   "arabic": "وَهُوَ بَلآءٌ تَطُولُ مُدَّتُهُ، وَيَدُومُ مَقَامُهُ، وَلا يُخَفَّفُ عَنْ أَهْلِهِ"
  },
  {
   "segment_id": 111,
   "arabic": "لِأَنَّهُ لا يَكُونُ إِلا عَنْ غَضَبِكَ وَانْتِقَامِكَ وَسَخَطِكَ"
  },
  {
   "segment_id": 112,
   "arabic": "وَهَذَا مَا لا تَقُومُ لَهُ السَّمَاوَاتُ وَالأَرْضُ"
  },
  {
   "segment_id": 113,
   "arabic": "يَا سَيِّدِي فَكَيْفَ بِي"
  },
  {
   "segment_id": 114,
   "arabic": "وَأَنَا عَبْدُكَ الضَّعِيفُ الذَّلِيلُ الْحَقِيرُ الْمِسْكِينُ الْمُسْتَكِينُ"
  },
  {
   "segment_id": 115,
   "arabic": "يَا إِلَهِي وَرَبِّي وَسَيِّدِي وَمَوْلايَ"
  },
  {
   "segment_id": 116,
   "arabic": "لِأَيِّ الأُمُورِ إِلَيْكَ أَشْكُو"
  },
  {
   "segment_id": 117,
   "arabic": "وَلِمَا مِنْهَا أَضِجُّ وَأَبْكِي"
  },
  {
   "segment_id": 118,
   "arabic": "لِأَلِيمِ الْعَذَابِ وَشِدَّتِهِ!"
  },
  {
   "segment_id": 119,
   "arabic": "أَمْ لِطُولِ الْبَلآءِ وَمُدَّتِهِ!"
  },
  {
   "segment_id": 120,
   "arabic": "فَلَئِن صَيَّرْتَنِي لِلْعُقُوبَاتِ مَعَ أَعْدَآئِكَ"
  },
  {
   "segment_id": 121,
   "arabic": "وَجَمَعْتَ بَيْنِي وَبَيْنَ أَهْلِ بَلآئِكَ"
  },
  {
   "segment_id": 122,
   "arabic": "وَفَرَّقْتَ بَيْنِي وَبَيْنَ أَحِبَّائِكَ وَأَوْلِيَائِكَ"
  },
  {
   "segment_id": 123,
   "arabic": "فَهَبْنِي يَا إِلَهِي وَسَيِّدِي وَمَوْلايَ وَرَبِّي صَبَرْتُ عَلَى عَذَابِكَ،"
  },
  {
   "segment_id": 124,
   "arabic": "فَكَيْفَ أَصْبِرُ عَلَى فِرَاقِكَ"
  },
  {
   "segment_id": 125,
   "arabic": "وَهَبْنِي صَبَرْتُ عَلَى حَرِّ نَارِكَ،"
  },
  {
   "segment_id": 126,
   "arabic": "فَكَيْفَ أَصْبِرُ عَنِ النَّظَرِ إِلَى كَرَامَتِكَ"
  },
  {
   "segment_id": 127,
   "arabic": "أَمْ كَيْفَ أَسْكُنُ فِي النَّارِ وَرَجَائِي عَفْوُكَ"
  },
  {
   "segment_id": 128,
   "arabic": "فَبِعِزَّتِكَ يَا سَيِّدِي وَمَوْلايَ أُقْسِمُ صَادِقًا، لَئِنْ تَرَكْتَنِي نَاطِقًا"
  },
  {
   "segment_id": 129,
   "arabic": "لَأَضِجَّنَّ إِلَيْكَ بَيْنَ أَهْلِهَا ضَجِيجَ الآمِلِينَ"
  },
  {
   "segment_id": 130,
   "arabic": "وَلأَصْرُخَنَّ إِلَيكَ صُرَاخَ المُسْتَصْرِخِينَ"
  },
  {
   "segment_id": 131,
   "arabic": "وَلَأَبْكِيَنَّ عَلَيْكَ بُكَاءَ الفَاقِدِينَ"
  },
  {
   "segment_id": 132,
   "arabic": "وَلَأُنَادِيَنَّكَ أَيْنَ كُنْتَ يَا وَلِيَّ الْمُؤْمِنِينَ"
  },
  {
   "segment_id": 133,
   "arabic": "يَا غَايَةَ آمَاِل العَارِفِينَ"
  },
  {
   "segment_id": 134,
   "arabic": "يَا غِيَاثَ المُسْتَغِيْثِينَ"
  },
  {
   "segment_id": 135,
   "arabic": "يَا حَبِيبَ قُلُوبِ الصَّادِقِينَ"
  },
  {
   "segment_id": 136,
   "arabic": "وَيَا إِلَهَ العَالَمِينَ"
  },
  {
   "segment_id": 137,
   "arabic": "أَفَتُرَاكَ، سُبْحَانَكَ يَا إِلَهِي وَبِحَمْدِكَ، تَسْمَعُ فِيهَا صَوْتَ عَبْدٍ مُّسْلِمٍ"
  },
  {
   "segment_id": 138,
   "arabic": "سُجِنَ فِيهَا بِمُخَالَفَتِهِ"
  },
  {
   "segment_id": 139,
   "arabic": "وَذَاقَ طَعْمَ عَذَابِهَا بِمَعْصِيَتِهِ"
  },
  {
   "segment_id": 140,
   "arabic": "وَحُبِسَ بَيْنَ أَطْبَاقِهَا بِجُرْمِهِ وَجَرِيرَتِهِ"
  },
  {
   "segment_id": 141,
   "arabic": "وَهُوَ يَضِجُّ إلَيْكَ ضَجِيجَ مُؤَمِّلٍ لِّرَحْمَتِكَ"
  },
  {
   "segment_id": 142,
   "arabic": "وَيُنَادِيكَ بِلِسَانِ أَهْلِ تَوْحِيدِكَ"
  },
  {
   "segment_id": 143,
   "arabic": "وَيَتَوَسَّلُ إلَيْكَ بِرُبُوبِيَّتِكَ"
  },
  {
   "segment_id": 144,
   "arabic": "يَا مَوْلايَ فَكَيْفَ يَبْقَى فِي الْعَذَابِ وَهُوَ يَرْجُو مَا سَلَفَ مِنْ حِلْمِكَ"
  },
  {
   "segment_id": 145,
   "arabic": "أَمْ كَيْفَ تُؤْلِمُهُ النَّارُ وَهُوَ يَأْمَلُ فَضْلَكَ وَرَحْمَتَكَ"
  },
  {
   "segment_id": 146,
   "arabic": "أَمْ كَيْفَ يُحْرِقُهُ لَهِيبُهَا وَأَنتَ تَسْمَعُ صَوْتَهُ وَتَرَى مَكَانَهُ"
  },
  {
   "segment_id": 147,
   "arabic": "أَمْ كَيْفَ يَشْتَمِلُ عَلَيْهِ زَفِيرُهَا وَأَنْتَ تَعْلَمُ ضَعْفَهُ"
  },
  {
   "segment_id": 148,
   "arabic": "أَمْ كَيْفَ يَتَقَلْقَلُ بَيْنَ أَطْبَاقِهَا وَأَنْتَ تَعْلَمُ صِدْقَهُ"
  },
  {
   "segment_id": 149,
   "arabic": "أَمْ كَيْفَ تَزْجُرُهُ زَبَانِيَتُهَا وَهُوَ يُنَادِيكَ يَا رَبَّهُ"
  },
  {
   "segment_id": 150,
   "arabic": "أَمْ كَيْفَ يَرْجُو فَضْلَكَ فِي عِتْقِهِ مِنْهَا فَتَتْرُكُهُ فِيهَا"
  },
  {
   "segment_id": 151,
   "arabic": "هَيهَاتَ مَا ذَلِكَ الظَّنُّ بِكَ"
  },
  {
   "segment_id": 152,
   "arabic": "وَلا الْمَعْرُوفُ مِنْ فَضْلِكَ"
  },
  {
   "segment_id": 153,
   "arabic": "وَلا مُشْبِهٌ لِمَا عَامَلْتَ بِهِ الْمُوَحِّدِينَ مِنْ بِرِّكَ وَإِحْسَانِكَ"
  },
  {
   "segment_id": 154,
   "arabic": "فَبِالْيَقِينِ أَقْطَعُ لَوْلا مَا حَكَمْتَ بِهِ مِن تَعْذِيبِ جَاحِدِيكَ"
  },
  {
   "segment_id": 155,
   "arabic": "وَقَضَيْتَ بِهِ مِنْ إِخْلاَدِ مُعَانِدِيكَ"
  },
  {
   "segment_id": 156,
   "arabic": "لَجَعَلْتَ النَّارَ كُلَّهَا بَرْدًا وَّسَلاَمًا،"
  },
  {
   "segment_id": 157,
   "arabic": "وَمَا كَانَ لأَحَدٍ فِيهَا مَقَرًّا وَّلا مُقَامًا"
  },
  {
   "segment_id": 158,
   "arabic": "لَّكِنَّكَ تَقَدَّسَتْ أَسْمَاؤُكَ أَقْسَمْتَ أَنْ تَمْلَأَهَا مِنَ الْكَافِرِينَ،"
  },
  {
   "segment_id": 159,
   "arabic": "مِنَ الْجِنَّةِ وَالنَّاسِ أَجْمَعِينَ"
  },
  {
   "segment_id": 160,
   "arabic": "وَأَنْ تُخَلِّدَ فِيهَا الْمُعَانِدِينَ"
  },
  {
   "segment_id": 161,
   "arabic": "وَأَنْتَ جَلَّ ثَنَاؤُكَ قُلْتَ مُبْتَدِئًا، وَّتَطَوَّلْتَ بِالإِنْعَامِ مُتَكَرِّمًا:"
  },
  {
   "segment_id": 162,
   "arabic": "أَفَمَنْ كَانَ مُؤْمِنًا كَمَنْ كَانَ فَاسِقًا لَّا يَسْتَوُونَ"
  },
  {
   "segment_id": 163,
   "arabic": "إِلَهِي وَسَيِّدِي فَأَسْألُكَ بِالْقُدْرَةِ الَّتِي قَدَّرْتَهَا"
  },
  {
   "segment_id": 164,
   "arabic": "وَبِالْقَضِيَّةِ الَّتِي حَتَمْتَهَا وَحَكَمْتَهَا وَغَلَبْتَ مَنْ عَلَيْهِ أَجْرَيْتَهَا"
  },
  {
   "segment_id": 165,
   "arabic": "أَن تَهَبَ لِي، فِي هذِهِ اللَّيْلَةِ، وَفِي هَذِهِ السَّاعَةِ"
  },
  {
   "segment_id": 166,
   "arabic": "كُلَّ جُرْمٍ أَجْرَمْتُهُ"
  },
  {
   "segment_id": 167,
   "arabic": "وَكُلَّ ذَنْبٍ أَذْنَبْتُهُ"
  },
  {
   "segment_id": 168,
   "arabic": "وَكُلَّ قَبِيحٍ أَسْرَرْتُهُ"
  },
  {
   "segment_id": 169,
   "arabic": "وَكُلَّ جَهْلٍ عَمِلْتُهُ،"
  },
  {
   "segment_id": 170,
   "arabic": "كَتَمْتُهُ أَوْ أَعْلَنتُهُ،"
  },
  {
   "segment_id": 171,
   "arabic": "أَخفَيْتُهُ أَوْ أَظْهَرْتُهُ"
  },
  {
   "segment_id": 172,
   "arabic": "وَكُلَّ سَيِّئَةٍ أَمَرْتَ بِإِثْبَاتِهَا الْكِرَامَ الكَاتِبِينَ"
  },
  {
   "segment_id": 173,
   "arabic": "الَّذِينَ وَكَّلْتَهُم بِحِفْظِ مَا يَكُونُ مِنِّي،"
  },
  {
   "segment_id": 174,
   "arabic": "وَجَعَلْتَهُمْ شُهُودًا عَلَيَّ مَعَ جَوَارِحِي،"
  },
  {
   "segment_id": 175,
   "arabic": "وَكُنتَ أَنْتَ الرَّقِيبَ عَلَيَّ مِن وَّرَائِهِمْ،"
  },
  {
   "segment_id": 176,
   "arabic": "وَالشَّاهِدَ لِمَا خَفِيَ عَنْهُمْ،"
  },
  {
   "segment_id": 177,
   "arabic": "وَبِرَحْمَتِكَ أَخْفَيْتَهُ،"
  },
  {
   "segment_id": 178,
   "arabic": "وَبِفَضْلِكَ سَتَرْتَهُ"
  },
  {
   "segment_id": 179,
   "arabic": "وَأَنْ تُوَفِّرَ حَظِّي مِن كُلِّ خَيْرٍ أَنْزَلْتَهُ"
  },
  {
   "segment_id": 180,
   "arabic": "أَوْ إِحْسَانٍ فَضَّلْتَه"
  },
  {
   "segment_id": 181,
   "arabic": "أَوْ بِرٍّ نَشَرْتَهُ،"
  },
  {
   "segment_id": 182,
   "arabic": "أَوْ رِزْقٍ بَسَطْتَهُ"
  },
  {
   "segment_id": 183,
   "arabic": "أَوْ ذَنْبٍ تَغْفِرُهُ"
  },
  {
   "segment_id": 184,
   "arabic": "أَوْ خَطَأٍ تَسْتُرُهُ"
  },
  {
   "segment_id": 185,
   "arabic": "يَا رَبِّ يَا رَبِّ يَا رَبِّ"
  },
  {
   "segment_id": 186,
   "arabic": "يَا إِلَهِي وَسَيِّدِي وَمَوْلايَ وَمَاِلكَ رِقِّي"
  },
  {
   "segment_id": 187,
   "arabic": "يَا مَنْ بِيَدِهِ نَاصِيَتِي"
  },
  {
   "segment_id": 188,
   "arabic": "يَا عَلِيمًا بِضُرِّي وَمَسْكَنَتِي"
  },
  {
   "segment_id": 189,
   "arabic": "يَا خَبِيرًا بِفَقْرِي وَفَاقَتِي"
  },
  {
   "segment_id": 190,
   "arabic": "يَا رَبِّ يَا رَبِّ يَا رَبِّ"
  },
  {
   "segment_id": 191,
   "arabic": "أَسْأَلُكَ بِحَقِّكَ وَقُدْسِكَ"
  },
  {
   "segment_id": 192,
   "arabic": "وَأَعْظَمِ صِفَاتِكَ وَأَسْمَائِكَ"
  },
  {
   "segment_id": 193,
   "arabic": "أنْ تَجْعَلَ أَوْقَاتِي فِى اللَّيلِ وَالنَّهَارِ بِذِكْرِكَ مَعْمُورَةً،"
  },
  {
   "segment_id": 194,
   "arabic": "وَبِخِدْمَتِكَ مَوْصُولَةً،"
  },
  {
   "segment_id": 195,
   "arabic": "وَّأَعْمَاِلي عِنْدَكَ مَقْبُولَةً،"
  },
  {
   "segment_id": 196,
   "arabic": "حَتَّى تَكُونَ أَعْمَاِلي وَأَوْرَادِي كُلُّهَا وِرْدًا وَّاحِدًا،"
  },
  {
   "segment_id": 197,
   "arabic": "وَّحَاِلي فِي خِدْمَتِكَ سَرْمَدًا"
  },
  {
   "segment_id": 198,
   "arabic": "يَا سَيِّدِي، يَا مَنْ عَلَيْهِ مُعَوَّلِي"
  },
  {
   "segment_id": 199,
   "arabic": "يَا مَنْ إلَيْهِ شَكَوْتُ أَحْوَاِلي"
  },
  {
   "segment_id": 200,
   "arabic": "يَا رَبِّ يَا رَبِّ يَا رَبِّ"
  },
  {
   "segment_id": 201,
   "arabic": "قَوِّ عَلَى خِدْمَتِكَ جَوَارِحِي"
  },
  {
   "segment_id": 202,
   "arabic": "وَاشْدُدْ عَلىَ الْعَزِيمَةِ جَوَانِحِي"
  },
  {
   "segment_id": 203,
   "arabic": "وَهَبْ لِيَ الْجِدَّ فِي خَشْيَتِكَ"
  },
  {
   "segment_id": 204,
   "arabic": "وَالدَّوَامَ فِي الإِتِّصَاِل بِخِدْمَتِكَ"
  },
  {
   "segment_id": 205,
   "arabic": "حَتَّى أَسْرَحَ إِلَيكَ فِي مَيَادِينِ السَّابِقِينَ"
  },
  {
   "segment_id": 206,
   "arabic": "وَأُسْرِعَ إِلَيْكَ فِى البَارِزِينَ"
  },
  {
   "segment_id": 207,
   "arabic": "وَأَشْتَاقَ إلىَ قُرْبِكَ فِي الْمُشْتَاقِينَ"
  },
  {
   "segment_id": 208,
   "arabic": "وَأَدْنُوَ مِنْكَ دُنُوَّ الْمُخْلِصِينَ"
  },
  {
   "segment_id": 209,
   "arabic": "وَأَخَافَكَ مَخَافَةَ الْمُوقِنِينَ"
  },
  {
   "segment_id": 210,
   "arabic": "وَأَجْتَمِعَ فِي جِوَارِكَ مَعَ الْمُؤْمنِينَ"
  },
  {
   "segment_id": 211,
   "arabic": "اَللَّهُمَّ وَمَنْ أَرَادَنِي بِسُوٍء فَأَرِدْهُ"
  },
  {
   "segment_id": 212,
   "arabic": "وَمَنْ كَادَنِي فَكِدْهُ"
  },
  {
   "segment_id": 213,
   "arabic": "وَاجْعَلْنِي مِنْ أَحْسَنِ عَبِيدِكَ نَصِيبًا عِنْدَكَ"
  },
  {
   "segment_id": 214,
   "arabic": "وَأَقْرَبِهِم مَّنْزِلَةً مِّنْكَ"
  },
  {
   "segment_id": 215,
   "arabic": "وَأَخَصِّهِمْ زُلْفَةً لَّدَيْكَ"
  },
  {
   "segment_id": 216,
   "arabic": "فَإِنَّهُ لا يُنَالُ ذَلِكَ إِلاّ بِفَضْلِكَ"
  },
  {
   "segment_id": 217,
   "arabic": "وَجُدْ لِي بِجُودِكَ"
  },
  {
   "segment_id": 218,
   "arabic": "وَاعْطِفْ عَلَيَّ بِمَجْدِكَ"
  },
  {
   "segment_id": 219,
   "arabic": "وَاحْفَظْنِي بِرَحْمَتِكَ"
  },
  {
   "segment_id": 220,
   "arabic": "وَاجْعَل لِّسَانِي بِذِكْرِكَ لَهِجًا"
  },
  {
   "segment_id": 221,
   "arabic": "وَقَلْبِي بِحُبِّكَ مُتَيَّمًا"
  },
  {
   "segment_id": 222,
   "arabic": "وَّمُنَّ عَلَيَّ بِحُسْنِ إِجَابَتِكَ"
  },
  {
   "segment_id": 223,
   "arabic": "وَأَقِلْنِي عَثْرَتِي"
  },
  {
   "segment_id": 224,
   "arabic": "وَاغْفِرْ زَلَّتِي"
  },
  {
   "segment_id": 225,
   "arabic": "فَإِنَّكَ قَضَيْتَ عَلَى عِبَادِكَ بِعِبَادَتِكَ"
  },
  {
   "segment_id": 226,
   "arabic": "وَأَمَرْتَهُم بِدُعَائِكَ"
  },
  {
   "segment_id": 227,
   "arabic": "وَضَمِنْتَ لَهُمُ الإِجَابَةَ"
  },
  {
   "segment_id": 228,
   "arabic": "فَإِلَيْكَ يَا رَبِّ نَصَبْتُ وَجْهِي"
  },
  {
   "segment_id": 229,
   "arabic": "وَإلَيْكَ يَا رَبِّ مَدَدْتُ يَدِي"
  },
  {
   "segment_id": 230,
   "arabic": "فَبِعِزَّتِكَ اسْتَجِبْ لِي دُعَائِي"
  },
  {
   "segment_id": 231,
   "arabic": "وَبَلِّغْنِي مُنَايَ"
  },
  {
   "segment_id": 232,
   "arabic": "وَلا تَقْطَعْ مِن فَضْلِكَ رَجَائِي"
  },
  {
   "segment_id": 233,
   "arabic": "وَاكْفِنِي شَرَّ الْجِنِّ وَالإِنْسِ مِنْ أَعْدَائِي"
  },
  {
   "segment_id": 234,
   "arabic": "يَا سَرِيعَ الرِّضَا"
  },
  {
   "segment_id": 235,
   "arabic": "اِغْفِرْ لِمَن لا يَمْلِكُ إِلا الدُّعَاءَ"
  },
  {
   "segment_id": 236,
   "arabic": "فَإِنَّكَ فَعَّالٌ لِّمَا تَشَاءُ"
  },
  {
   "segment_id": 237,
   "arabic": "يَا مَنْ اسْمُهُ دَوَاءٌ"
  },
  {
   "segment_id": 238,
   "arabic": "وَذِكْرُهُ شِفَاءٌ"
  },
  {
   "segment_id": 239,
   "arabic": "وَطَاعَتُهُ غِنًى"
  },
  {
   "segment_id": 240,
   "arabic": "ارْحَم مَّن رَّأْسُ مَاِلهِ الرَّجَاءُ"
  },
  {
   "segment_id": 241,
   "arabic": "وَسِلاَحُهُ الْبُكَاءُ"
  },
  {
   "segment_id": 242,
   "arabic": "يَا سَابِغَ النِّعَمِ"
  },
  {
   "segment_id": 243,
   "arabic": "يَا دَافِعَ النِّقَمِ"
  },
  {
   "segment_id": 244,
   "arabic": "يَا نُورَ الْمُسْتَوْحِشِينَ فِي الظُّلَمِ"
  },
  {
   "segment_id": 245,
   "arabic": "يَا عَالِمًا لا يُعَلَّمُ"
  },
  {
   "segment_id": 246,
   "arabic": "صَلِّ عَلَى مُحَمَّدٍ وَّآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 247,
   "arabic": "وافْعَلْ بِي مَا أَنتَ أَهْلُهُ"
  },
  {
   "segment_id": 248,
   "arabic": "وَصَلَّى اللَّهُ عَلَى رَسُولِهِ وَالأَئِمَّةِ الْمَيَامِينَ مِنْ آلِهِ"
  },
  {
   "segment_id": 249,
   "arabic": "وَسَلَّمَ تَسْلِيمًا كَثِيرًا"
  }
 ]
}