{
 "dua_id": "dua-ramadan-13",
 "dua_name_en": "Day 13",
 "dua_name_ar": " شهر رمضان ١٣  ",
 "source": "https://www.duaplayer.org/en/dua/ramadan-13",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "اللّهُمّ طَهّرْنِي فِيهِ مِنَ الدّنَسِ وَالأَقْذَارِ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَصَبّرْنِي فِيهِ عَلَى كَائِنَاتِ الأَقْدَارِ،"
  },
  {
   "segment_id": 5,
   "arabic": "وَوَفّقْنِي فِيهِ لِلتّقَى وَصُحْبَةِ الأَبْرَارِ،"
  },
  {
   "segment_id": 6,
   "arabic": "بِعَوْنِكَ يَا قُرّةَ عَيْنِ المَسَاكِينِ."
  }
 ]
}