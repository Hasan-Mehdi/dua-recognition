{
 "dua_id": "duasorg-ramadan-end-farewell-7",
 "dua_name_en": "Imam Sadiq (as) Dua 1",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-end-farewell.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللّهُمَّ إنَّكَ قُلْتَ فِي كِتابِكَ الْمُنْزَلِ:"
  },
  {
   "segment_id": 2,
   "arabic": "”شَهْرُ رَمَضَانَ الَّذِي أُنزِلَ فِيهِ الْقُرْآنُ.“"
  },
  {
   "segment_id": 3,
   "arabic": "وَهذَا شَهْرُ رَمَضانَ"
  },
  {
   "segment_id": 4,
   "arabic": "وَقَدْ تَصَرَّمَ"
  },
  {
   "segment_id": 5,
   "arabic": "فَأسْألُكَ بِوَجْهِكَ الْكَرِيمِ"
  },
  {
   "segment_id": 6,
   "arabic": "وَكَلِماتِكَ التّامَّةِ"
  },
  {
   "segment_id": 7,
   "arabic": "إنْ كانَ بَقِيَ عَلَيَّ ذَنْبٌ لَمْ تَغْفِرْهُ لي"
  },
  {
   "segment_id": 8,
   "arabic": "أوْ تُرِيدُ أنْ تُعَذِّبَنِي عَلَيْهِ"
  },
  {
   "segment_id": 9,
   "arabic": "أوْ تُقايِسَنِي بِهِ"
  },
  {
   "segment_id": 10,
   "arabic": "أنْ لا يَطْلُعَ فَجْرُ هَذِهِ اللَيْلَةِ"
  },
  {
   "segment_id": 11,
   "arabic": "أوْ يَتَصَرَّمُ هذا الشَّهْرُ"
  },
  {
   "segment_id": 12,
   "arabic": "إلاَّ وَقَدْ غَفَرْتَهُ لي"
  },
  {
   "segment_id": 13,
   "arabic": "يا أرْحَمَ الرّاحِمِينَ."
  },
  {
   "segment_id": 14,
   "arabic": "اَللّهُمَّ لَكَ الْحَمْدُ بِمَحامِدِكَ كُلِّها"
  },
  {
   "segment_id": 15,
   "arabic": "أوَّلِها وَآخِرِها"
  },
  {
   "segment_id": 16,
   "arabic": "ما قُلْتَ لِنَفْسِكَ مِنْها"
  },
  {
   "segment_id": 17,
   "arabic": "وَما قالَ الْخَلائِقُ الْحامِدونَ"
  },
  {
   "segment_id": 18,
   "arabic": "الْمُجْتَهِدونَ الْمَعْدودونَ"
  },
  {
   "segment_id": 19,
   "arabic": "الْمُوَقِّرونَ ذِكْرِكَ"
  },
  {
   "segment_id": 20,
   "arabic": "وَالشُّكْرَ لَكَ"
  },
  {
   "segment_id": 21,
   "arabic": "الَّذينَ أعَنْتَهُمْ عَلى أداءِ حَقِّكَ"
  },
  {
   "segment_id": 22,
   "arabic": "مِنْ أصْنافِ خَلْقِكَ"
  },
  {
   "segment_id": 23,
   "arabic": "مِنَ الْمَلائِكَةِ الْمُقَرَّبينَ"
  },
  {
   "segment_id": 24,
   "arabic": "وَالنَّبِيِّينَ وَالْمُرْسَلِينَ"
  },
  {
   "segment_id": 25,
   "arabic": "وَأصْنافِ النّاطِقينَ"
  },
  {
   "segment_id": 26,
   "arabic": "وَالْمُسَبِّحِينَ لَكَ مِنْ جَمِيعِ الْعالَمِينَ"
  },
  {
   "segment_id": 27,
   "arabic": "عَلى أنَّكَ بَلَّغْتَنا شَهْرَ رَمَضانَ"
  },
  {
   "segment_id": 28,
   "arabic": "وَعَلَيْنا مِنْ نِعَمِكَ"
  },
  {
   "segment_id": 29,
   "arabic": "وَعِنْدَنا مِنْ قِسَمِكَ وَإحْسانِكَ"
  },
  {
   "segment_id": 30,
   "arabic": "وَتَظاهُرِ إمْتِنانِكَ"
  },
  {
   "segment_id": 31,
   "arabic": "فَبِذَلِكَ لَكَ مُنْتَهى الْحَمْدِ"
  },
  {
   "segment_id": 32,
   "arabic": "الْخالِدِ الدّائِمِ"
  },
  {
   "segment_id": 33,
   "arabic": "الرّاكِدِ الْمُخَلَّدِ السَّرْمَدِ"
  },
  {
   "segment_id": 34,
   "arabic": "الَّذي لا يَنْفَدُ طُولَ الأبَدِ"
  },
  {
   "segment_id": 35,
   "arabic": "جَلَّ ثَناؤكَ"
  },
  {
   "segment_id": 36,
   "arabic": "أعَنْتَنا عَلَيْهِ حَتّى قَضَيْنا صِيامَهُ وَقِيامَهُ"
  },
  {
   "segment_id": 37,
   "arabic": "مِنْ صَلاةٍ وَما كانَ مِنّا فيهِ مِنْ بِرٍّ"
  },
  {
   "segment_id": 38,
   "arabic": "أوْ شُكْرٍ أوْ ذِكْرٍ."
  },
  {
   "segment_id": 39,
   "arabic": "اَللّهُمَّ فَتَقَبَّلْهُ مِنّا بِأحْسَنِ قَبولِكَ"
  },
  {
   "segment_id": 40,
   "arabic": "وَتَجاوُزِكَ وَعَفْوِكَ"
  },
  {
   "segment_id": 41,
   "arabic": "وَصَفْحِكَ وَغُفْرانِكَ"
  },
  {
   "segment_id": 42,
   "arabic": "وَحَقِيقَةِ رِضْوانِكَ"
  },
  {
   "segment_id": 43,
   "arabic": "حَتّى تُظْفِرَنا فِيهِ بِكُلِّ خَيْرٍ مَطْلوبٍ"
  },
  {
   "segment_id": 44,
   "arabic": "وَجَزيلِ عَطاءٍ مَوهُوبٍ"
  },
  {
   "segment_id": 45,
   "arabic": "وَتُوَقِّيَنا فِيهِ مِنْ كُلِّ مَرْهوبٍ"
  },
  {
   "segment_id": 46,
   "arabic": "أوْ بَلاءٍ مَجْلوبٍ"
  },
  {
   "segment_id": 47,
   "arabic": "أوْ ذَنْبٍ مَكْسوبٍ."
  },
  {
   "segment_id": 48,
   "arabic": "اَللّهُمَّ إنّي أسْألُكَ بِعَظيمِ ما سَألَكَ بِهِ أحَدٌ مِنْ خَلْقِكَ"
  },
  {
   "segment_id": 49,
   "arabic": "مِنْ كَريمِ أسْمائِكَ"
  },
  {
   "segment_id": 50,
   "arabic": "وَجَميلِ ثَنائِكَ"
  },
  {
   "segment_id": 51,
   "arabic": "وَخاصَّةِ دُعائِكَ"
  },
  {
   "segment_id": 52,
   "arabic": "أنْ تُصَلِّيَ عَلى مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 53,
   "arabic": "وَأنْ تَجْعَلَ شَهْرَنا هَذا أعْظَمَ شَهْرِ رَمَضانَ مَرَّ عَلَيْنا"
  },
  {
   "segment_id": 54,
   "arabic": "مُنْذُ أُنْزِلْنا إلى الدُّنْيا بَرَكَةً"
  },
  {
   "segment_id": 55,
   "arabic": "في عِصْمَةِ دِينِي"
  },
  {
   "segment_id": 56,
   "arabic": "وَخَلاصِ نَفْسِي"
  },
  {
   "segment_id": 57,
   "arabic": "وَقَضاءِ حَوائِجِي"
  },
  {
   "segment_id": 58,
   "arabic": "وَتُشَفِّعَنِي في مَسائِلِي"
  },
  {
   "segment_id": 59,
   "arabic": "وَتَمامِ النِّعْمَةِ عَلَيَّ"
  },
  {
   "segment_id": 60,
   "arabic": "وَصَرْفِ السّوءِ عَنّي"
  },
  {
   "segment_id": 61,
   "arabic": "وَلِباسِ الْعافِيَةِ لي فِيهِ"
  },
  {
   "segment_id": 62,
   "arabic": "وَأنْ تَجْعَلَني بِرَحْمَتِكَ مِمَّنْ خِرْتَ لَهُ لَيْلَةَ الْقَدْرِ"
  },
  {
   "segment_id": 63,
   "arabic": "وَجَعَلْتَها لَهُ خَيْراً مِنْ ألْفِ شَهْرٍ"
  },
  {
   "segment_id": 64,
   "arabic": "في أعْظَمِ الأجْرِ"
  },
  {
   "segment_id": 65,
   "arabic": "وَكَرائِمِ الذُّخْرِ"
  },
  {
   "segment_id": 66,
   "arabic": "وَحُسْنِ الشُّكْرِ"
  },
  {
   "segment_id": 67,
   "arabic": "وَطولِ العُمْرِ"
  },
  {
   "segment_id": 68,
   "arabic": "وَدَوامِ الْيُسْرِ."
  },
  {
   "segment_id": 69,
   "arabic": "اَللّهُمَّ وَأسْألُكَ بِرَحْمَتِكَ وَطَوْلِكَ"
  },
  {
   "segment_id": 70,
   "arabic": "وَعَفْوِكَ وَنَعْمائِكَ"
  },
  {
   "segment_id": 71,
   "arabic": "وَجَلالِكَ وَقديمِ إحْسانِكَ وَامْتِنانِكَ"
  },
  {
   "segment_id": 72,
   "arabic": "أنْ لا تَجْعِلَهُ آخِرَ الْعَهْدِ مِنّا لِشَهْرِ رَمَضانَ"
  },
  {
   "segment_id": 73,
   "arabic": "حَتّى تُبَلِّغَناهُ مِنْ قابِلٍ عَلى أحْسَنِ حالٍ"
  },
  {
   "segment_id": 74,
   "arabic": "وَتُعَرِّفَني هِلالَهُ مَعَ النّاظِرِينَ إلَيْهِ وَالْمُعْتَرِفينَ لَهُ"
  },
  {
   "segment_id": 75,
   "arabic": "في أعْفى عافِيَتِكَ"
  },
  {
   "segment_id": 76,
   "arabic": "وَأنْعَمِ نِعْمَتِكَ"
  },
  {
   "segment_id": 77,
   "arabic": "وَأوْسَعِ رَحْمَتِكَ"
  },
  {
   "segment_id": 78,
   "arabic": "وَأجْزَلِ قِسَمِكَ"
  },
  {
   "segment_id": 79,
   "arabic": "يا رَبِّيَ الَّذي لَيْسَ لي رَبٌّ غَيْرُهُ"
  },
  {
   "segment_id": 80,
   "arabic": "لا يَكونُ هَذا الوَداعُ مِنّي لَهُ وَداعَ فَناءٍ"
  },
  {
   "segment_id": 81,
   "arabic": "وَلا آخِرَ الْعَهْدِ مِنّي لِلِّقاءِ"
  },
  {
   "segment_id": 82,
   "arabic": "حَتّى تُرِيَنّيهِ مِنْ قابِلٍ في أوْسَعِ النِّعَمِ وأفْضَلِ الرَّجاءِ"
  },
  {
   "segment_id": 83,
   "arabic": "وأنَا لَكَ عَلى أحْسَنِ الْوَفاءِ"
  },
  {
   "segment_id": 84,
   "arabic": "إنَّكَ سَمِيعُ الدُّعاءِ."
  },
  {
   "segment_id": 85,
   "arabic": "اَللّهُمَّ اسْمَعْ دُعائي"
  },
  {
   "segment_id": 86,
   "arabic": "وَارْحَمْ تَضَرُّعي وَتَذَلُّلي لَكَ"
  },
  {
   "segment_id": 87,
   "arabic": "وَاسْتِكانَتِي وَتَوَكُّلي عَلَيْكَ"
  },
  {
   "segment_id": 88,
   "arabic": "وَأنا لَكَ مُسَلِّمٌ"
  },
  {
   "segment_id": 89,
   "arabic": "لا أرْجو نَجاحاً وَلا مُعافاةً"
  },
  {
   "segment_id": 90,
   "arabic": "وَلا تَشْريفاً وَلا تَبْليغاً إلاَّ بِكَ وَمِنْكَ"
  },
  {
   "segment_id": 91,
   "arabic": "فَامْنُنْ عَلَيَّ"
  },
  {
   "segment_id": 92,
   "arabic": "جَلَّ ثَناؤكَ"
  },
  {
   "segment_id": 93,
   "arabic": "وَتَقَدَّسَتْ أسْماؤكَ"
  },
  {
   "segment_id": 94,
   "arabic": "بِتَبْليغي شَهْرَ رَمَضانَ وَأنا مُعافىً مِنْ كُلِّ مَكْروهٍ وَمَحْذورٍ"
  },
  {
   "segment_id": 95,
   "arabic": "وَمِنْ جَمِيعِ البَوائِقِ،"
  },
  {
   "segment_id": 96,
   "arabic": "اَلْحَمْدُ للهِ الَّذي أعانَنا عَلى صِيامِ هَذا الشَّهْرِ وَقِيامِهِ"
  },
  {
   "segment_id": 97,
   "arabic": "حَتّى بَلَّغَني آخِرَ لَيْلَةٍ مِنْهُ."
  }
 ]
}