{
 "dua_id": "dua-ramadan-18",
 "dua_name_en": "Day 18",
 "dua_name_ar": " شهر رمضان ١٨",
 "source": "https://www.duaplayer.org/en/dua/ramadan-18",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "اللّهُمّ نَبّهْنِي فِيهِ لِبَرَكَاتِ أَسْحَارِهِ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَنَوّرْ فِيهِ قَلْبِي بِضِيَاءِ أَنْوَارِهِ،"
  },
  {
   "segment_id": 5,
   "arabic": "وَخُذْ بِكُلّ أَعْضَائِي إِلَى اتّبَاعِ آثَارِهِ،"
  },
  {
   "segment_id": 6,
   "arabic": "بِنُورِكَ يَا مُنَوّرَ قُلُوبِ العَارِفِينَ."
  }
 ]
}