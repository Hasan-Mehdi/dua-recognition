{
 "dua_id": "duasorg-sahifa-fatimiya-short-dua-miscellaneous-4",
 "dua_name_en": "Instruction Block",
 "dua_name_ar": "",
 "source": "https://www.duas.org/sahifa-fatimiya-short-dua-miscellaneous.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "الْحَمْدُ لِلَّهِ الَّذِي أَذْهَبَ عَنَّا الْحَزَنَ"
  },
  {
   "segment_id": 2,
   "arabic": "إِنَّ رَبَّنَا لَغَفُورٌ شَكُورٌ"
  },
  {
   "segment_id": 3,
   "arabic": "الَّذِي أَحَلَّنَا دَارَ الْمُقَامَةِ مِنْ فَضْلِهِ"
  },
  {
   "segment_id": 4,
   "arabic": "لَا يَمَسُّنَا فِيهَا نَصَبٌ"
  },
  {
   "segment_id": 5,
   "arabic": "وَ لَا يَمَسُّنَا فِيهَا لُغُوبٌ"
  },
  {
   "segment_id": 6,
   "arabic": "إِلٰهِي أَنْتَ الْمُنَى وَ فَوْقَ الْمُنَى"
  },
  {
   "segment_id": 7,
   "arabic": "أَسْأَلُكَ أَنْ لَا تُعَذِّبَ مُحِبِّيَّ"
  },
  {
   "segment_id": 8,
   "arabic": "وَ مُحِبِّي عِتْرَتِي بِالنَّارِ"
  }
 ]
}