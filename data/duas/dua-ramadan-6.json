{
 "dua_id": "dua-ramadan-6",
 "dua_name_en": "Day 6",
 "dua_name_ar": "شهر رمضان ٦  ",
 "source": "https://www.duaplayer.org/en/dua/ramadan-6",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "اللّهُمّ لا تَخْذُلْنِي فِيهِ لِتَعَرّضِ مَعْصِيَتِكَ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَلا تَضْرِبْنِي بِسِيَاطِ نَقِمَتِكَ،"
  },
  {
   "segment_id": 5,
   "arabic": "وَزَحْزِحْنِي فِيهِ مِنْ مُوجِبَاتِ سَخَطِكَ،"
  },
  {
   "segment_id": 6,
   "arabic": "بِمَنّكَ وَأَيَادِيكَ يَا مُنْتَهَى رَغْبَةِ الرَّاغِبِينَ."
  }
 ]
}