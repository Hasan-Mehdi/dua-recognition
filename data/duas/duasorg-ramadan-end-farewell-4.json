{
 "dua_id": "duasorg-ramadan-end-farewell-4",
 "dua_name_en": "Day Dua - 1",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-end-farewell.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللّهُمَّ إنَّكَ أرْحَمُ الرّاحِمينَ"
  },
  {
   "segment_id": 2,
   "arabic": "لا إلهَ إلاّ أنْتَ،"
  },
  {
   "segment_id": 3,
   "arabic": "تَفَضَّلْتَ عَلَيْنا فَهَدَيْتَنا،"
  },
  {
   "segment_id": 4,
   "arabic": "وَمَنَنْتَ عَلَيْنا فَعَرَّفْتَنا،"
  },
  {
   "segment_id": 5,
   "arabic": "وَأحْسَنْتَ إلَيْنا فَأعَنْتَنا عَلى أداءِ ما افْتَرَضْتَ عَلَيْنا"
  },
  {
   "segment_id": 6,
   "arabic": "مِنْ صِيامِ شَهْرِكَ شَهْرِ رَمَضانَ."
  },
  {
   "segment_id": 7,
   "arabic": "فَلَكَ الْحَمْدُ بِمَحامِدِكَ كُلِّها"
  },
  {
   "segment_id": 8,
   "arabic": "عَلى جَميعِ نَعْمائِكَ كُلِّها،"
  },
  {
   "segment_id": 9,
   "arabic": "حَتّى يَنْتَهِيَ الْحَمْدُ إلى ما تُحِبُّ وَتَرْضى"
  },
  {
   "segment_id": 10,
   "arabic": "وَهذا آخِرُ يَوْمٍ مِنْ شَهْرِ رَمَضانَ"
  },
  {
   "segment_id": 11,
   "arabic": "فَإذا انْقَضى فَاخْتِمْهُ لَنا بِالسَّعادَةِ وَالرَّحْمَةِ وَالمَغْفِرَةِ،"
  },
  {
   "segment_id": 12,
   "arabic": "وَالرِّزْقِ الواسِعِ الكَثيرِ الطَّيِّبِ،"
  },
  {
   "segment_id": 13,
   "arabic": "الَّذي لا حِسابَ فيهِ وَلا عَذابَ عَلَيهِ،"
  },
  {
   "segment_id": 14,
   "arabic": "وَالبَرَكَةِ وَالفَوْزِ وَالفَوْزِ بِالجَنَّةِ،"
  },
  {
   "segment_id": 15,
   "arabic": "وَالعِتْقِ مِنَ النّارِ،"
  },
  {
   "segment_id": 16,
   "arabic": "وَلا تَجْعَلْهُ آخِرَ العَهْدِ مِنْهُ،"
  },
  {
   "segment_id": 17,
   "arabic": "وَأهِلَّهُ عَلَينا بِأفْضَلِ الْخَيْرِ وَالبَرَكَةِ وَالسُّرورِ"
  },
  {
   "segment_id": 18,
   "arabic": "عَلَيَّ وَعَلى أَهْلي وَوالِدَيَّ وَذُرِّيَّتي يا كَريمُ."
  },
  {
   "segment_id": 19,
   "arabic": "اَللّهُمَّ هذا شَهْرُ رَمَضانَ"
  },
  {
   "segment_id": 20,
   "arabic": "الَّذي أنْزَلْتَ فيهِ القُرْآنَ"
  },
  {
   "segment_id": 21,
   "arabic": "هُدىً لِلنّاسِ وَبَيِّناتٍ مِن الهُدى وَالفُرْقانِ"
  },
  {
   "segment_id": 22,
   "arabic": "وَقَدْ تَصَرَّمَ،"
  },
  {
   "segment_id": 23,
   "arabic": "فَأعوذُ بِوَجْهِكَ الكَريمِ أنْ تَغيبَ الشَّمْسُ مِنْ هذا اليَوْمِ،"
  },
  {
   "segment_id": 24,
   "arabic": "أوْ يَطْلُعَ الفَجْرُ مِنْ هذِهِ اللَّيْلَةِ،"
  },
  {
   "segment_id": 25,
   "arabic": "وَلَكَ قِبَلي ذَنْبٌ أوْ تَبِعَةٌ،"
  },
  {
   "segment_id": 26,
   "arabic": "تُريدُ أنْ تُعَذِّبَني عَلَيْها يَومَ ألْقاكَ."
  },
  {
   "segment_id": 27,
   "arabic": "أيْ مُلَيِّنَ الْحَديدِ لِداوُدَ،"
  },
  {
   "segment_id": 28,
   "arabic": "أيْ كاشِفَ الْكَرْبِ الْعَظِيمِ عَنْ أيُّوبَ،"
  },
  {
   "segment_id": 29,
   "arabic": "صَلِّ عَلى مُحَمَّدٍ وَعَلى أهْلِ بَيْتِ مُحَمَّدٍ"
  },
  {
   "segment_id": 30,
   "arabic": "وَهَبْ لي فِكاكَ رَقَبَتي مِنَ النّارِ"
  },
  {
   "segment_id": 31,
   "arabic": "وَكُلَّ تَبِعَةٍ وَذَنْبٍ لَكَ قِبَلي،"
  },
  {
   "segment_id": 32,
   "arabic": "وَاخْتِمْ لي بِالرِّضا وَالْجَنَّةِ."
  },
  {
   "segment_id": 33,
   "arabic": "يا اَللهُ يا أرْحَمَ الرّاحِمينَ،"
  },
  {
   "segment_id": 34,
   "arabic": "صَلِّ عَلى مُحَمَّدٍ وَعَلى أهْلِ بَيْتِهِ الْمُبارَكِينَ الأخْيارِ"
  },
  {
   "segment_id": 35,
   "arabic": "وَسَلِّمْ تَسْليماً."
  }
 ]
}