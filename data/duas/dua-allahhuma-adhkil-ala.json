{
 "dua_id": "dua-allahhuma-adhkil-ala",
 "dua_name_en": "Dua Allah'humma Adhkil Ala",
 "dua_name_ar": "اللّهُمَّ أَدْخِلْ عَلَى ",
 "source": "https://www.duaplayer.org/en/dua/allahhuma-adhkil-ala",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 2,
   "arabic": "اللّهُمَّ أَدْخِلْ عَلَى أَهْلِ الْقُبُورِ السُّرُورَ،"
  },
  {
   "segment_id": 3,
   "arabic": "اللّهُمَّ أَغْنِ كُلَّ فَقِيرٍ،"
  },
  {
   "segment_id": 4,
   "arabic": "اللّهُمَّ أَشْبِعْ كُلَّ جَائِعٍ،"
  },
  {
   "segment_id": 5,
   "arabic": "اللّهُمَّ اكْسُ كُلَّ عُرْيَانٍ،"
  },
  {
   "segment_id": 6,
   "arabic": "اللّهُمَّ اقْضِ دَيْنَ كُلِّ مَدِينٍ،"
  },
  {
   "segment_id": 7,
   "arabic": "اللّهُمَّ فَرِّجْ عَنْ كُلِّ مَكْرُوبٍ،"
  },
  {
   "segment_id": 8,
   "arabic": "اللّهُمَّ رُدَّ كُلَّ غَرِيبٍ،"
  },
  {
   "segment_id": 9,
   "arabic": "اللّهُمَّ فُكَّ كُلَّ أَسِيرٍ،"
  },
  {
   "segment_id": 10,
   "arabic": "اللّهُمَّ أَصْلِحْ كُلَّ فَاسِدٍ مِنْ أُمُورِ الْمُسْلِمِينَ،"
  },
  {
   "segment_id": 11,
   "arabic": "اللّهُمَّ اشْفِ كُلَّ مَرِيضٍ،"
  },
  {
   "segment_id": 12,
   "arabic": "اللّهُمَّ سُدَّ فَقْرَنَا بِغِنَاكَ،"
  },
  {
   "segment_id": 13,
   "arabic": "اللّهُمَّ غَيِّرْ سُوءَ حَالِنَا بِحُسْنِ حَالِكَ،"
  },
  {
   "segment_id": 14,
   "arabic": "اللّهُمَّ اقْضِ عَنَّا الدَّيْنَ وَأَغْنِنَا مِنَ الْفَقْرِ،"
  },
  {
   "segment_id": 15,
   "arabic": "إنَّكَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ."
  }
 ]
}