{
 "dua_id": "duasorg-ramadan-eid-6",
 "dua_name_en": "in Sajdah - Ya Allahu",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-eid.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "يَا اللَّهُ يَا اللَّهُ يَا اللَّهُ"
  },
  {
   "segment_id": 2,
   "arabic": "يَا رَبُّ يَا رَبُّ يَا رَبُّ"
  },
  {
   "segment_id": 3,
   "arabic": "يَا مُنْزِلَ ٱلْبَرَكَاتِ"
  },
  {
   "segment_id": 4,
   "arabic": "بِكَ تُنْزَلُ كُلُّ حَاجَةٍ"
  },
  {
   "segment_id": 5,
   "arabic": "اسْالُكَ بِكُلِّ ٱسْم فِي مَخْزُونِ ٱلْغَيْبِ عِنْدَكَ"
  },
  {
   "segment_id": 6,
   "arabic": "وَٱلاسْمَاءِ ٱلْمَشْهُورةِ عِنْدَكَ"
  },
  {
   "segment_id": 7,
   "arabic": "ٱلْمَكْتُوبَةِ عَلَىٰ سُرَادِقِ عَرْشِكَ"
  },
  {
   "segment_id": 8,
   "arabic": "انْ تُصَلِّيَ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 9,
   "arabic": "وَانْ تَقْبَلَ مِنِّي شَهْرَ رَمَضَانَ"
  },
  {
   "segment_id": 10,
   "arabic": "وَتَكْتُبَنِي مِنَ ٱلْوَافِدينَ إِلىٰ بَيْتِكَ ٱلْحَرَامِ"
  },
  {
   "segment_id": 11,
   "arabic": "وَتَصْفَحَ لِي عَنِ ٱلذُّنُوبِ ٱلْعِظَامِ"
  },
  {
   "segment_id": 12,
   "arabic": "وَتَسْتَخْرِجَ لِي يَا رَبِّ كُنُوزَكَ يَا رَحْمٰنُ"
  }
 ]
}