{
 "dua_id": "duasorg-sahifa-fatimiya-short-dua-miscellaneous-8",
 "dua_name_en": "Instruction Block",
 "dua_name_ar": "",
 "source": "https://www.duas.org/sahifa-fatimiya-short-dua-miscellaneous.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللَّهُمَّ إِنِّي أَسْأَلُكَ"
  },
  {
   "segment_id": 2,
   "arabic": "بِمُحَمَّدٍ الْمُصْطَفَى وَ شَوْقِهِ إِلَيَّ"
  },
  {
   "segment_id": 3,
   "arabic": "وَ بِبَعْلِي عَلِيٍّ الْمُرْتَضَى وَ حُزْنِهِ عَلَيَّ"
  },
  {
   "segment_id": 4,
   "arabic": "وَ بِالْحَسَنِ الْمُجْتَبَى وَ بُكَائِهِ عَلَيَّ"
  },
  {
   "segment_id": 5,
   "arabic": "وَ بِالْحُسَيْنِ الشَّهِيدِ وَ كَآبَتِهِ عَلَيَّ"
  },
  {
   "segment_id": 6,
   "arabic": "وَ بِبَنَاتِيَ الْفَاطِمِيَّاتِ وَ تَحَسُّرِهِنَّ عَلَيَّ"
  },
  {
   "segment_id": 7,
   "arabic": "أَنْ تَرْحَمَ وَ تَغْفِرَ"
  },
  {
   "segment_id": 8,
   "arabic": "لِلْعُصَاةِ مِنْ أُمَّةِ مُحَمَّدٍ"
  },
  {
   "segment_id": 9,
   "arabic": "وَ تُدْخِلَهُمُ الْجَنَّةَ"
  },
  {
   "segment_id": 10,
   "arabic": "إِنَّكَ أَكْرَمُ الْمَسْؤُولِينَ"
  },
  {
   "segment_id": 11,
   "arabic": "وَ أَرْحَمُ الرَّاحِمِينَ"
  }
 ]
}