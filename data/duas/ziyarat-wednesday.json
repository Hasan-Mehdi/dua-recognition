{
 "dua_id": "ziyarat-wednesday",
 "dua_name_en": "Ziyarat al-Arbiaa'",
 "dua_name_ar": "زیارة الأربعاء",
 "source": "https://www.duaplayer.org/en/ziyarat/wednesday",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمٰنِ ٱلرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَلسَّلاَمُ عَلَيْكُمْ يَا اوْلِيَاءَ ٱللَّهِ"
  },
  {
   "segment_id": 3,
   "arabic": "اَلسَّلاَمُ عَلَيْكُمْ يَا حُجَجَ ٱللَّهِ"
  },
  {
   "segment_id": 4,
   "arabic": "اَلسَّلاَمُ عَلَيْكُمْ يَا نُورَ ٱللَّهِ فِي ظُلُمَاتِ ٱلارْضِ"
  },
  {
   "segment_id": 5,
   "arabic": "اَلسَّلاَمُ عَلَيْكُمْ"
  },
  {
   "segment_id": 6,
   "arabic": "صَلَوَاتُ ٱللَّهِ عَلَيْكُمْ"
  },
  {
   "segment_id": 7,
   "arabic": "وَعَلَىٰ آلِ بَيْتِكُمُ ٱلطَّيِّبِينَ ٱلطَّاهِرِينَ"
  },
  {
   "segment_id": 8,
   "arabic": "بِابِي انْتُمْ وَامِّي"
  },
  {
   "segment_id": 9,
   "arabic": "لَقَدْ عَبَدْتُمُ ٱللَّهَ مُخْلِصِينَ"
  },
  {
   "segment_id": 10,
   "arabic": "وَجَاهَدْتُمْ فِي ٱللَّهِ حَقَّ جِهَادِهِ"
  },
  {
   "segment_id": 11,
   "arabic": "حَتَّىٰ اتَاكُمُ ٱلْيَقِينُ"
  },
  {
   "segment_id": 12,
   "arabic": "فَلَعَنَ اللَّهُ اعْدَاءكُمْ"
  },
  {
   "segment_id": 13,
   "arabic": "مِنَ ٱلْجِنِّ وَٱلإنْسِ اجْمَعِينَ"
  },
  {
   "segment_id": 14,
   "arabic": "وَانَا ابْرَا إِلَىٰ ٱللَّهِ وَإِلَيْكُمْ مِنْهُمْ"
  },
  {
   "segment_id": 15,
   "arabic": "يَا مَوْلاَيَ يَا ابَا إِبْرَاهِيمَ"
  },
  {
   "segment_id": 16,
   "arabic": "مُوسَىٰ بْنَ جَعْفَرٍ"
  },
  {
   "segment_id": 17,
   "arabic": "يَا مَوْلاَيَ يَا ابَا ٱلْحَسَنِ"
  },
  {
   "segment_id": 18,
   "arabic": "عَلِيَّ بْنَ مُوسَىٰ"
  },
  {
   "segment_id": 19,
   "arabic": "يَا مَوْلاَيَ يَا ابَا جَعْفَرٍ"
  },
  {
   "segment_id": 20,
   "arabic": "مُحَمَّدَ بْنَ عَلِيٍّ"
  },
  {
   "segment_id": 21,
   "arabic": "يَا مَوْلاَيَ يَا ابَا ٱلْحَسَنِ"
  },
  {
   "segment_id": 22,
   "arabic": "عَلِيَّ بْنَ مُحَمَّدٍ"
  },
  {
   "segment_id": 23,
   "arabic": "انَا مَوْلىٰ لَكُمْ"
  },
  {
   "segment_id": 24,
   "arabic": "مُؤْمِنٌ بِسِرِّكُمْ وَجَهْرِكُمْ"
  },
  {
   "segment_id": 25,
   "arabic": "مُتَضَيِّفٌ بِكُمْ في يَوْمِكُمْ هٰذَا"
  },
  {
   "segment_id": 26,
   "arabic": "وَهُوَ يَوْمُ ٱلارْبِعَاءِ"
  },
  {
   "segment_id": 27,
   "arabic": "وَمُسْتَجِيـرٌ بِكُمْ"
  },
  {
   "segment_id": 28,
   "arabic": "فَاضِيفُونِي وَاجِيرُونِي"
  },
  {
   "segment_id": 29,
   "arabic": "بِآلِ بَيْتِكُمُ ٱلطَّيِّبِينَ ٱلطَّاهِرِينَ"
  }
 ]
}