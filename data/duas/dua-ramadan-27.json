{
 "dua_id": "dua-ramadan-27",
 "dua_name_en": "Day 27",
 "dua_name_ar": " شهر رمضان ٢٧  ",
 "source": "https://www.duaplayer.org/en/dua/ramadan-27",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "اللّهُمّ ارْزُقْنِي فِيهِ فَضْلَ لَيْلَةِ القَدْرِ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَصَيّرْ أُمُورِي فِيهِ مِنَ العُسْرِ إِلَى اليُسْرِ،"
  },
  {
   "segment_id": 5,
   "arabic": "وَاقْبَلْ مَعَاذِيرِي،"
  },
  {
   "segment_id": 6,
   "arabic": "وَحُطّ عَنّي الذّنْبَ وَالوِزْرَ،"
  },
  {
   "segment_id": 7,
   "arabic": "يَا رَؤُوفاً بِعِبَادِهِ الصَّالِحِينَ."
  }
 ]
}