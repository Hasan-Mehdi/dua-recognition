{
 "dua_id": "duasorg-salat-jafar-tayyar-3",
 "dua_name_en": "Another Dua After Salat Jafar e Tayyar",
 "dua_name_ar": "",
 "source": "https://www.duas.org/salat-jafar-tayyar.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللَّهُمَّ إِنِّي افْتَتِحُ ٱلْقَوْلَ بِحَمْدِكَ"
  },
  {
   "segment_id": 2,
   "arabic": "وَانْطِقُ بِٱلثَّنَاءِ عَلَيْكَ"
  },
  {
   "segment_id": 3,
   "arabic": "وَامَجِّدُكَ وَلاَ غَايَةَ لِمَدْحِكَ"
  },
  {
   "segment_id": 4,
   "arabic": "وَاثْنِي عَلَيْكَ وَمَنْ يَبْلُغُ غَايَةَ ثَنَائِكَ وَامَدَ مَجْدِكَ"
  },
  {
   "segment_id": 5,
   "arabic": "وَانَّىٰ لِخَلِيقَتِكَ كُنْهُ مَعْرِفَةِ مَجْدِكَ"
  },
  {
   "segment_id": 6,
   "arabic": "وَايَّ زَمَنٍ لَمْ تَكُنْ مَمْدُوحاً بِفَضْلِكَ"
  },
  {
   "segment_id": 7,
   "arabic": "مَوْصُوفاً بِمَجْدِكَ"
  },
  {
   "segment_id": 8,
   "arabic": "عَوَّاداً عَلَىٰ ٱلْمُذْنِبِينَ بِحِلْمِكَ"
  },
  {
   "segment_id": 9,
   "arabic": "تَخَلَّفَ سُكَّانُ ارْضِكَ عَنْ طَاعَتِكَ"
  },
  {
   "segment_id": 10,
   "arabic": "فَكُنْتَ عَلَيْهِمْ عَطُوفاً بِجُودِكَ"
  },
  {
   "segment_id": 11,
   "arabic": "جَوَاداً بِفَضْلِكَ"
  },
  {
   "segment_id": 12,
   "arabic": "عَوَّاداً بِكَرَمِكَ"
  },
  {
   "segment_id": 13,
   "arabic": "يَا لاَ إِلٰهَ إِلاَّ انْتَ ٱلْمَنَّانُ"
  },
  {
   "segment_id": 14,
   "arabic": "ذُو ٱلْجَلاَلِ وَٱلإِكْرَامِ"
  }
 ]
}