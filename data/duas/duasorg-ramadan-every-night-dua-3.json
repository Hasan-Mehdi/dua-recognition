{
 "dua_id": "duasorg-ramadan-every-night-dua-3",
 "dua_name_en": "Allahumma bi Rahmatika",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-every-night-dua.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللَّهُمَّ بِرَحْمَتِكَ فِي ٱلصَّالِحِينَ فَأَدْخِلْنَا"
  },
  {
   "segment_id": 2,
   "arabic": "وَفِي عِلِّيِّينَ فَٱرْفَعْنَا"
  },
  {
   "segment_id": 3,
   "arabic": "وَبِكَأْسٍ مِنْ مَعِينٍ"
  },
  {
   "segment_id": 4,
   "arabic": "مِنْ عَيْنٍ سَلْسَبِيلٍ فَٱسْقِنَا"
  },
  {
   "segment_id": 5,
   "arabic": "وَمِنَ ٱلْحُورِ ٱلْعِينِ بِرَحْمَتِكَ فَزَوِّجْنَا"
  },
  {
   "segment_id": 6,
   "arabic": "وَمِنَ ٱلْوِلْدَانِ ٱلْمُخَلَّدِينَ"
  },
  {
   "segment_id": 7,
   "arabic": "كَأَنَّهُمْ لُؤْلُؤٌ مَكْنُونٌ فَأَخْدِمْنَا"
  },
  {
   "segment_id": 8,
   "arabic": "وَمِنْ ثِمَارِ ٱلْجَنَّةِ وَلُحُومِ ٱلطَّيْرِ فَأَطْعِمْنَا"
  },
  {
   "segment_id": 9,
   "arabic": "وَمِنْ ثِيَابِ ٱلسُّنْدُسِ وَٱلْحَرِيرِ وَٱلإِسْتَبْرَقِ فَأَلْبِسْنَا"
  },
  {
   "segment_id": 10,
   "arabic": "وَلَيْلَةَ ٱلْقَدْرِ"
  },
  {
   "segment_id": 11,
   "arabic": "وَحَجَّ بَيْتِكَ ٱلْحَرَامِ"
  },
  {
   "segment_id": 12,
   "arabic": "وَقَتْلاً فِي سَبِيلِكَ فَوَفِّقْ لَنَا"
  },
  {
   "segment_id": 13,
   "arabic": "وَصَالِحَ ٱلدُّعَاءِ وَٱلْمَسْأَلَةِ فَٱسْتَجِبْ لَنَا"
  },
  {
   "segment_id": 14,
   "arabic": "وَإِذَا جَمَعْتَ ٱلأَوَّلِينَ وَٱلآخِرِينَ يَوْمَ ٱلْقِيَامَةِ فَٱرْحَمْنَا"
  },
  {
   "segment_id": 15,
   "arabic": "وَبَرَاءَةً مِنَ ٱلنَّارِ فَٱكْتُبْ لَنَا"
  },
  {
   "segment_id": 16,
   "arabic": "وَفِي جَهَنَّمَ فَلاَ تَغُلَّنَا"
  },
  {
   "segment_id": 17,
   "arabic": "وَفِي عَذَابِكَ وَهَوَانِكَ فَلا تَبْتَلِنَا"
  },
  {
   "segment_id": 18,
   "arabic": "وَمِنَ ٱلزُّقُّومِ وَٱلضَّرِيعِ فَلاَ تُطْعِمْنَا"
  },
  {
   "segment_id": 19,
   "arabic": "وَمَعَ ٱلشَّيَاطِينِ فَلاَ تَجْعَلْنَا"
  },
  {
   "segment_id": 20,
   "arabic": "وَفِي ٱلنَّارِ عَلَىٰ وُجُوهِنَا فَلاَ تَكْبُبْنَا"
  },
  {
   "segment_id": 21,
   "arabic": "وَمِنْ ثِيَابِ ٱلنَّارِ وَسَرَابِيلِ ٱلْقَطِرَانِ فَلاَ تُلْبِسْنَا"
  },
  {
   "segment_id": 22,
   "arabic": "وَمِنْ كُلِّ سُوءٍ يَا لاَ إِلٰهَ إِلاَّ أَنْتَ"
  },
  {
   "segment_id": 23,
   "arabic": "بِحَقِّ لاَ إِلٰهَ إِلاَّ أَنْتَ فَنَجِّنَا"
  }
 ]
}