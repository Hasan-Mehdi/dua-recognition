  },
  {
   "segment_id": 122,
   "arabic": "اسْالُكَ انْ تُصَلِّيَ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 123,
   "arabic": "وَتَمُنَّ عَلَيَّ بِرِضَاكَ"
  },
  {
   "segment_id": 124,
   "arabic": "وَتَعْفُوَ عَنِّي بِحِلْمِكَ"
  },
  {
   "segment_id": 125,
   "arabic": "وَتُوَسِّعَ عَلَيَّ مِنْ رِزْقِكَ ٱلْحَلاَلِ ٱلطَّيِّبِ"
  },
  {
   "segment_id": 126,
   "arabic": "وَمِنْ حَيْثُ احْتَسِبُ وَمِنْ حَيْثُ لاَ احْتَسِبُ"
  },
  {
   "segment_id": 127,
   "arabic": "فَإِنِّي عَبْدُكَ لَيْسَ لِي احَدٌ سِوَاكَ"
  },
  {
   "segment_id": 128,
   "arabic": "وَلاَ احَدٌ اسْالُهُ غَيْرُكَ"
  },
  {
   "segment_id": 129,
   "arabic": "يَا ارْحَمَ ٱلرَّاحِمينَ"
  },
  {
