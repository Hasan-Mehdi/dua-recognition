{
 "dua_id": "sahifa-26",
 "dua_name_en": "Sahifa 26: his supplication for neighbours and friends",
 "dua_name_ar": "دُعَاؤُهُ لِجِيرَانِهِ وَ أَوْلِيَائِهِ",
 "source": "https://duas.pro/26-his-supplication-for-neighbours-and-friends",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "أَللَّهُمَّ صَـلِّ عَلَى مُحَمَّدٍ وَآلِـهِ"
  },
  {
   "segment_id": 2,
   "arabic": "وَتَـوَلَّنِي فِي جِيرَانِي وَمَوَالِيَّ وَالْعَارِفِينَ بِحَقِّنَا"
  },
  {
   "segment_id": 3,
   "arabic": "وَالْمُنَابِذِينَ لأِعْدَآئِنَا بِأَفْضَلِ وِلاَيَتِكَ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَوَفِّقْهُمْ لإِقَامَةِ سُنَّتِكَ"
  },
  {
   "segment_id": 5,
   "arabic": "وَالأَخْذِ بِمَحَاسِنِ أَدَبِكَ فِي إرْفَاقِ ضَعِيفِهِمْ،"
  },
  {
   "segment_id": 6,
   "arabic": "وَسَدِّ خَلَّتِهِمْ، وَعِيَادَةِ مَرِيضِهِمْ،"
  },
  {
   "segment_id": 7,
   "arabic": "وَهِدَايَةِ مُسْتَرْشِدِهِمْ، وَمُنَاصَحَةِ مُسْتَشِيرِهِمْ،"
  },
  {
   "segment_id": 8,
   "arabic": "وَتَعَهُّدِ قَادِمِهِمْ، وَكِتْمَانِ أَسْرَارِهِمْ،"
  },
  {
   "segment_id": 9,
   "arabic": "وَسَتْرِ عَوْرَاتِهِمْ، وَنُصْرَةِ مَظْلُومِهِمْ،"
  },
  {
   "segment_id": 10,
   "arabic": "وَحُسْنِ مُوَاسَاتِهِمْ بِالْمَاعُونِ،"
  },
  {
   "segment_id": 11,
   "arabic": "وَالْعَوْدِ عَلَيْهِمْ بِـالْجِـدَةِ وَالإِفْضَـالِ،"
  },
  {
   "segment_id": 12,
   "arabic": "وَإعْطَآءِ مَـا يَجِبُ لَهُمْ قَبْلَ السُّؤَالِ"
  },
  {
   "segment_id": 13,
   "arabic": "وَاجْعَلْنِي اللَّهُمَّ أَجْزِي بِالإحْسَانِ مُسِيْئَهُمْ،"
  },
  {
   "segment_id": 14,
   "arabic": "وَأَعْرِضُ بِالتَّجَاوُزِ عَنْ ظَالِمِهِمْ،"
  },
  {
   "segment_id": 15,
   "arabic": "وَأَسْتَعْمِلْ حُسْنَ الظَّنِّ فِي كَافَّتِهِمْ،"
  },
  {
   "segment_id": 16,
   "arabic": "وَأَتَوَلَّى بِالْبِرِّ عَامَّتَهُمْ،"
  },
  {
   "segment_id": 17,
   "arabic": "وَأَغُضُّ بَصَرِي عَنْهُمْ عِفَّةً،"
  },
  {
   "segment_id": 18,
   "arabic": "وَأَلِينُ جَانِبِيْ لَهُمْ تَوَاضُعاً،"
  },
  {
   "segment_id": 19,
   "arabic": "وَأَرِقُّ عَلَى أَهْلِ الْبَلاَءِ مِنْهُمْ رَحْمَةً،"
  },
  {
   "segment_id": 20,
   "arabic": "وَأُسِرُّ لَهُمْ بِالْغَيْبِ مَوَدَّةً،"
  },
  {
   "segment_id": 21,
   "arabic": "وَأُحِبُّ بَقَاءَ النِّعْمَةِ عِنْدَهُمْ نُصْحاً،"
  },
  {
   "segment_id": 22,
   "arabic": "وَأُوجِبُ لَهُمْ مَا أُوجِبُ لِحَامَّتِي،"
  },
  {
   "segment_id": 23,
   "arabic": "وَأَرْعَى لَهُمْ مَا أَرْعَى لِخَاصَّتِي."
  },
  {
   "segment_id": 24,
   "arabic": "أَللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَآلِهِ ،"
  },
  {
   "segment_id": 25,
   "arabic": "وَارْزُقْنِي مِثْلَ ذَلِكَ مِنْهُمْ،"
  },
  {
   "segment_id": 26,
   "arabic": "وَاجْعَلْ لِي أَوْفَى الْحُظُوظِ فِيمَا عِنْدَهُمْ ،"
  },
  {
   "segment_id": 27,
   "arabic": "وَزِدْهُمْ بَصِيْرَةً فِي حَقِّي،"
  },
  {
   "segment_id": 28,
   "arabic": "وَمَعْرِفَةً بِفَضْلِي،"
  },
  {
   "segment_id": 29,
   "arabic": "حَتَّى يَسْعَدُوا بِي وَأَسْعَدَ بِهِمْ"
  },
  {
   "segment_id": 30,
   "arabic": "آللهُمَّ آمِينَ رَبَّ الْعَالَمِينَ."
  }
 ]
}