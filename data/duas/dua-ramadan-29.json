{
 "dua_id": "dua-ramadan-29",
 "dua_name_en": "Day 29",
 "dua_name_ar": " شهر رمضان ٢٩ ",
 "source": "https://www.duaplayer.org/en/dua/ramadan-29",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "اللّهُمّ غَشّنِي فِيهِ بِالرّحْمَةِ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَارْزُقْنِي فِيهِ التّوْفِيقَ وَالعِصْمَةَ،"
  },
  {
   "segment_id": 5,
   "arabic": "وَطَهّرْ قَلْبِي مِنْ غَيَاهِبِ التّهَمَةِ،"
  },
  {
   "segment_id": 6,
   "arabic": "يَا رَحِيماً بِعِبَادِهِ المُؤْمِنِينَ."
  }
 ]
}