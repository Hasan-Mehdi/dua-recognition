{
 "dua_id": "duasorg-sahifa-fatimiya-dua-hareeq-ater-fajr-1",
 "dua_name_en": "Dua Hareeq of Sayeda Fatima (sa) after Fajr",
 "dua_name_ar": "",
 "source": "https://www.duas.org/sahifa-fatimiya-dua-hareeq-ater-fajr.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "أَللَّهُمَّ إِنّي أَصْبَحْتُ اُشْهِدُكَ وَكَفى بِكَ شَهِيداً"
  },
  {
   "segment_id": 2,
   "arabic": "وَاُشْهِدُ مَلائِكَتَكَ وَحَمَلَةَ عَرْشِكَ"
  },
  {
   "segment_id": 3,
   "arabic": "وَسُكَّانَ سَبْعِ سَماواتِكَ وَأَرَضيكَ"
  },
  {
   "segment_id": 4,
   "arabic": "وَأَنْبِياءَكَ وَرُسُلَكَ"
  },
  {
   "segment_id": 5,
   "arabic": "وَوَرَثَةَ أَنْبِياءِكَ وَرُسُلِكَ"
  },
  {
   "segment_id": 6,
   "arabic": "وَالصَّالِحينَ مِنْ عِبادِكَ وَجَميعَ خَلْقِكَ"
  },
  {
   "segment_id": 7,
   "arabic": "فَاشْهَدْ لي وَكَفى بِكَ شَهيداً"
  },
  {
   "segment_id": 8,
   "arabic": "أَنّي أَشْهَدُ أَنَّكَ أَنْتَ اللهُ لا إِلهَ إِلّا أَنْتَ"
  },
  {
   "segment_id": 9,
   "arabic": "الْمَعْبُودُ وَحْدَكَ لا شَريكَ لَكَ"
  },
  {
   "segment_id": 10,
   "arabic": "وَأَنَّ مُحَمَّداً صَلَّى اللهُ عَلَيْهِ وَآلِهِ"
  },
  {
   "segment_id": 11,
   "arabic": "عَبْدُكَ وَرَسُولُكَ"
  },
  {
   "segment_id": 12,
   "arabic": "وَأَنَّ كُلَّ مَعْبُودٍ مِمَّا دُونَ عَرْشِكَ إِلى قَرارِ أَرْضِكَ السَّابِعَةِ"
  },
  {
   "segment_id": 13,
   "arabic": "السُّفْلى باطِلٌ مُضْمَحِلٌّ ما خَلا وَجْهَكَ الْكَريمَ"
  },
  {
   "segment_id": 14,
   "arabic": "فَإِنَّهُ أَعَزُّ وَأَكْرَمُ وَأَجَلُّ وَأَعْظَمُ"
  },
  {
   "segment_id": 15,
   "arabic": "مِنْ أَنْ يَصِفَ الْواصِفُونَ كُنْهَ جَلالِهِ"
  },
  {
   "segment_id": 16,
   "arabic": "أَوْ تَهْتَدِيَ الْقُلُوبُ إِلى كُنْهِ عَظَمَتِهِ"
  },
  {
   "segment_id": 17,
   "arabic": "يا مَنْ فاقَ مَدْحَ الْمادِحينَ فَخْرُ مَدْحِهِ"
  },
  {
   "segment_id": 18,
   "arabic": "وَعَدا وَصْفَ الْواصِفينَ مَآثِرُ حَمْدِهِ"
  },
  {
   "segment_id": 19,
   "arabic": "وَجَلَّ عَنْ مَقالَةِ النَّاطِقينَ تَعْظيمُ شَأْنِهِ"
  },
  {
   "segment_id": 20,
   "arabic": "صَلِّ عَلى مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 21,
   "arabic": "وَافْعَلْ بِنا ما أَنْتَ أَهْلُهُ"
  }
 ]
}