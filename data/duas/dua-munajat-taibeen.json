{
 "dua_id": "dua-munajat-taibeen",
 "dua_name_en": "Munajat Ta'ibeen",
 "dua_name_ar": "مناجات التائبين",
 "source": "https://www.duaplayer.org/en/dua/munajat-taibeen",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "إلـٰهِي أَلْبَسَتْنِي الْخَطايا ثَوْبَ مَذَلَّتِي،"
  },
  {
   "segment_id": 4,
   "arabic": "وَجَلَّلَنِي التَّباعُدُ مِنْكَ لِباسَ مَسْكَنَتِي،"
  },
  {
   "segment_id": 5,
   "arabic": "وَأَماتَ قَلْبِي عَظِيمُ جِنايَتِي،"
  },
  {
   "segment_id": 6,
   "arabic": "فَأَحْيِه بِتَوْبَةٍ مِنْكَ يا أَمَلِي وَبُغْيَتِي،"
  },
  {
   "segment_id": 7,
   "arabic": "وَيا سُؤْلِي وَمُنْيَتِي،"
  },
  {
   "segment_id": 8,
   "arabic": "فَوَعِزَّتِكَ ما أَجِدُ لِذُنُوبِي سِواكَ غافِراً،"
  },
  {
   "segment_id": 9,
   "arabic": "وَلا أَرَىٰ لِكَسْرِي غَيْرَكَ جابِراً،"
  },
  {
   "segment_id": 10,
   "arabic": "وَقَدْ خَضَعْتُ بِالإِنابَةِ إلَيْكَ"
  },
  {
   "segment_id": 11,
   "arabic": "وَعَنَوْتُ بِالاسْتِكانَةِ لَدَيْكَ،"
  },
  {
   "segment_id": 12,
   "arabic": "فَإنْ طَرَدْتَنِي مِنْ بابِكَ فَبِمَنْ أَلُوذُ؟"
  },
  {
   "segment_id": 13,
   "arabic": "وَإنْ رَدَدْتَنِي عَنْ جَنابِكَ فَبِمَنْ أَعُوذُ؟"
  },
  {
   "segment_id": 14,
   "arabic": "فَوَا أَسَفاهُ مِنْ خَجْلَتِي وَافْتِضَاحِي،"
  },
  {
   "segment_id": 15,
   "arabic": "وَوا لَهْفاهُ مِنْ سُوءِ عَمَلِي وَاجْتِراحِي."
  },
  {
   "segment_id": 16,
   "arabic": "أَسْأَلُكَ يا غافِرَ الذَّنْبِ الْكَبِيرِ"
  },
  {
   "segment_id": 17,
   "arabic": "وَيا جابِرَ الْعَظْمِ الْكَسِيرِ،"
  },
  {
   "segment_id": 18,
   "arabic": "أَنْ تَهَبَ لِي مُوبِقاتِ الْجَرائِرِ،"
  },
  {
   "segment_id": 19,
   "arabic": "وَتَسْتُرَ عَلَيَّ فاضِحاتِ السَّرائِرِ،"
  },
  {
   "segment_id": 20,
   "arabic": "وَلا تُخْلِنِي فِي مَشْهَدِ الْقِيامَةِ مِنْ بَرْدِ عَفْوِكَ وَغَفْرِكَ،"
  },
  {
   "segment_id": 21,
   "arabic": "وَلا تُعْرِنِي مِنْ جَمِيلِ صَفْحِكَ وَسَتْرِكَ."
  },
  {
   "segment_id": 22,
   "arabic": "إِلـٰهِي ظَلِّلْ عَلَىٰ ذُنُوبِي غَمامَ رَحْمَتِكَ،"
  },
  {
   "segment_id": 23,
   "arabic": "وَأَرْسِلْ عَلىٰ عُيُوبِي سَحابَ رَأْفَتِكَ"
  },
  {
   "segment_id": 24,
   "arabic": "إِلـٰهِي هَلْ يَرْجِعُ الْعَبْدُ الأَبِقُ إلاَّ إلَىٰ مَوْلاهُ"
  },
  {
   "segment_id": 25,
   "arabic": "أَمْ هَلْ يُجِيرُهُ مِنْ سَخَطِهِ أَحَدٌ سِواهُ؟"
  },
  {
   "segment_id": 26,
   "arabic": "إِلـٰهِي إنْ كانَ النَّدَمُ عَلَىٰ الذَّنْب تَوْبَةً،"
  },
  {
   "segment_id": 27,
   "arabic": "فَإِنِّي وَعِزَّتِكَ مِنَ النَّادِمِينَ،"
  },
  {
   "segment_id": 28,
   "arabic": "وَإِنْ كَانَ الاسْتِغْفارُ مِنَ الْخَطيئَةِ حِطَّةً،"
  },
  {
   "segment_id": 29,
   "arabic": "فَإِنِّي لَكَ مِنَ الُمُسْتَغْفِرِينَ،"
  },
  {
   "segment_id": 30,
   "arabic": "لَكَ الْعُتْبىٰ حَتَّىٰ تَرْضَىٰ."
  },
  {
   "segment_id": 31,
   "arabic": "إِلـٰهِي بِقُدْرَتِكَ عَلَيَّ تُبْ عَلَيَّ،"
  },
  {
   "segment_id": 32,
   "arabic": "وَبِحِلْمِكَ عَنِّي اعْفُ عَنِّي،"
  },
  {
   "segment_id": 33,
   "arabic": "وَبِعِلْمِكَ بِي ارْفَقْ بِي."
  },
  {
   "segment_id": 34,
   "arabic": "إِلـٰهِي أَنْتَ الَّذِي فَتَحْتَ لِعِبادِكَ بَابَاً إلَىٰ عَفْوِكَ سَمَّيْتَهُ التَّوْبَةَ،"
  },
  {
   "segment_id": 35,
   "arabic": "فَقُلْتَ: ( تُوبُوا إلَىٰ اللَّهِ تَوْبَةً نَصُوحَاً )،"
  },
  {
   "segment_id": 36,
   "arabic": "فَما عُذْرُ مَنْ أَغْفَلَ دُخُولَ الْبابِ بَعْدَ فَتْحِهِ."
  },
  {
   "segment_id": 37,
   "arabic": "إِلـٰهِي إنْ كانَ قَبُحَ الذَّنْبُ مِنْ عَبْدِكَ"
  },
  {
   "segment_id": 38,
   "arabic": "فَلْيَحْسُنِ الْعَفْوُ مِنْ عِنْدِكَ."
  },
  {
   "segment_id": 39,
   "arabic": "إِلـٰهِي ما أَنَا بِأَوَّلِ مَنْ عَصاكَ، فَتُبْتَ عَلَيْهِ،"
  },
  {
   "segment_id": 40,
   "arabic": "وَتَعَرَّضَ بِمَعْرُوفِكَ، فَجُدْتَ عَلَيْهِ،"
  },
  {
   "segment_id": 41,
   "arabic": "يا مُجِيبَ الْمُضْطَرِّ،"
  },
  {
   "segment_id": 42,
   "arabic": "يا كَاشِفَ الضُّرِّ،"
  },
  {
   "segment_id": 43,
   "arabic": "يا عَظِيمَ الْبِرِّ،"
  },
  {
   "segment_id": 44,
   "arabic": "يا عَليمَاً بِما فِي السِّرِّ،"
  },
  {
   "segment_id": 45,
   "arabic": "يا جَمِيلَ السِّتْرِ"
  },
  {
   "segment_id": 46,
   "arabic": "اسْتَشْفَعْتُ بِجُودِكَ وَكَرَمِكَ إلَيْكَ،"
  },
  {
   "segment_id": 47,
   "arabic": "وَتَوَسَّلْتُ بِجَنابِكَ وَتَرَحُّمِكَ لَدَيْكَ،"
  },
  {
   "segment_id": 48,
   "arabic": "فَاسْتَجِبْ دُعائِي،"
  },
  {
   "segment_id": 49,
   "arabic": "وَلا تُخَيِّبْ فِيكَ رَجَائِي"
  },
  {
   "segment_id": 50,
   "arabic": "وَتَقَبَّلْ تَوْبَتِي"
  },
  {
   "segment_id": 51,
   "arabic": "وَكَفِّرْ خَطيئَتِي،"
  },
  {
   "segment_id": 52,
   "arabic": "بِمَنِّكَ وَرَحْمَتِكَ"
  },
  {
   "segment_id": 53,
   "arabic": "يا أَرْحَمَ الرَّاحِمِينَ."
  }
 ]
}