{
 "dua_id": "duasorg-sahifa-fatimiya-dua-after-asr",
 "dua_name_en": "Dua of Sayeda Fatima (sa) after Asr Salaat",
 "dua_name_ar": "",
 "source": "https://www.duas.org/sahifa-fatimiya-dua-after-asr.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "سُبْحَانَ مَنْ يَعْلَمُ جَوَارِحَ الْقُلُوْبِ"
  },
  {
   "segment_id": 2,
   "arabic": "سُبْحَانَ مَنْ يُحْصِيْ عَدَدَ الذُّنُوْبِ"
  },
  {
   "segment_id": 3,
   "arabic": "سُبْحَانَ مَنْ لَا يَخْفٰى عَلَيْهِ خَافِيَةٌ فِيْ الْاَرْضِ وَ لَا فِيْ السَّمَاءِ"
  },
  {
   "segment_id": 4,
   "arabic": "وَ الْحَمْدُ لِلهِ الَّذِيْ لَمْ يَجْعَلْنِيْ كَافِرًا لِاَنْعُمِهٖ"
  },
  {
   "segment_id": 5,
   "arabic": "وَ لَا جَاحِدًا لِفَضْلِهٖ"
  },
  {
   "segment_id": 6,
   "arabic": "فَالْخَيْرُ فِيْهِ، وَ هُوَ اَهْلُهٗ"
  },
  {
   "segment_id": 7,
   "arabic": "وَ الْحَمْدُ لِلهِ عَلٰى حُجَّتِهِ الْبَالِغَةِ عَلٰى جَمِيْعِ مَنْ خَلَقَ"
  },
  {
   "segment_id": 8,
   "arabic": "مِمَّنْ اَطَاعَهٗ وَ مِمَّنْ عَصَاهُ"
  },
  {
   "segment_id": 9,
   "arabic": "فَاِنْ رَحِمَ فَمِنْ مَنِّهٖ"
  },
  {
   "segment_id": 10,
   "arabic": "وَ اِنْ عَاقَبَ فَبِمَا قَدَّمَتْ اَيْدِيْهِمْ"
  },
  {
   "segment_id": 11,
   "arabic": "وَ مَا اللهُ بِظَلَّامٍ لِلْعَبِيْدِ"
  },
  {
   "segment_id": 12,
   "arabic": "وَ الْحَمْدُ لِلهِ الْعَلِيِّ الْمَكَانِ"
  },
  {
   "segment_id": 13,
   "arabic": "وَ الرَّفِيْعِ الْبُنْيَانِ"
  },
  {
   "segment_id": 14,
   "arabic": "الشَّدِيْدِ الْاَرْكَانِ"
  },
  {
   "segment_id": 15,
   "arabic": "الْعَزِيْزِ السُّلْطَانِ"
  },
  {
   "segment_id": 16,
   "arabic": "الْعَظِيْمِ الشَّاْنِ"
  },
  {
   "segment_id": 17,
   "arabic": "الْوَاضِحِ الْبُرْهَانِ"
  },
  {
   "segment_id": 18,
   "arabic": "الرَّحِيْمِ الرَّحْمٰنِ"
  },
  {
   "segment_id": 19,
   "arabic": "الْمُنْعِمِ الْمَنَّانِ"
  },
  {
   "segment_id": 20,
   "arabic": "اَلْحَمْدُ لِلهِ الَّذِيْ احْتَجَبَ عَنْ كُلِّ مَخْلُوْقٍ"
  },
  {
   "segment_id": 21,
   "arabic": "يَرَاهُ بِحَقِيْقَةِ الرُّبُوْبِيَّةِ وَ قُدْرَةِ الْوَحْدَانِيَّةِ"
  },
  {
   "segment_id": 22,
   "arabic": "فَلَمْ تُدْرِكْهُ الْاَبْصَارُ"
  },
  {
   "segment_id": 23,
   "arabic": "وَ لَمْ تُحِطْ بِهِ الْاَخْبَارُ"
  },
  {
   "segment_id": 24,
   "arabic": "وَ لَمْ يُعَيِّنْهُ مِقْدَارٌ"
  },
  {
   "segment_id": 25,
   "arabic": "وَ لَمْ يَتَوَهَّمْهُ اعْتِبَارٌ"
  },
  {
   "segment_id": 26,
   "arabic": "لِاَنَّهُ الْمَلِكُ الْجَبَّارُ"
  },
  {
   "segment_id": 27,
   "arabic": "اَللّٰهُمَّ قَدْ تَرٰى مَكَانِيْ"
  },
  {
   "segment_id": 28,
   "arabic": "وَ تَسْمَعُ كَلَامِيْ"
  },
  {
   "segment_id": 29,
   "arabic": "وَ تَطَّلِعُ عَلٰى اَمْرِيْ"
  },
  {
   "segment_id": 30,
   "arabic": "وَ تَعْلَمُ مَا فِيْ نَفْسِيْ"
  },
  {
   "segment_id": 31,
   "arabic": "وَ لَيْسَ يَخْفٰى عَلَيْكَ شَيْ‏ءٌ مِنْ اَمْرِيْ"
  },
  {
   "segment_id": 32,
   "arabic": "وَ قَدْ سَعَيْتُ اِلَيْكَ فِيْ طَلِبَتِيْ"
  },
  {
   "segment_id": 33,
   "arabic": "وَ طَلَبْتُ اِلَيْكَ فِيْ حَاجَتِيْ"
  },
  {
   "segment_id": 34,
   "arabic": "وَ تَضَرَّعْتُ اِلَيْكَ فِيْ مَسْاَلَتِيْ"
  },
  {
   "segment_id": 35,
   "arabic": "وَ سَاَلْتُكَ لِفَقْرٍ وَ حَاجَةٍ"
  },
  {
   "segment_id": 36,
   "arabic": "وَ ذِلَّةٍ وَ ضِيْقَةٍ"
  },
  {
   "segment_id": 37,
   "arabic": "وَ بُؤْسٍ وَ مَسْكَنَةٍ"
  },
  {
   "segment_id": 38,
   "arabic": "وَ اَنْتَ الرَّبُّ الْجَوَادُ بِالْمَغْفِرَةِ"
  },
  {
   "segment_id": 39,
   "arabic": "تَجِدُ مَنْ تُعَذِّبُ غَيْرِيْ"
  },
  {
   "segment_id": 40,
   "arabic": "وَ لَا اَجِدُ مَنْ يَغْفِرُ لِيْ غَيْرَكَ"
  },
  {
   "segment_id": 41,
   "arabic": "وَ اَنْتَ غَنِيٌّ عَنْ عَذَابِيْ"
  },
  {
   "segment_id": 42,
   "arabic": "وَ اَنَا فَقِيْرٌ اِلٰى رَحْمَتِكَ"
  },
  {
   "segment_id": 43,
   "arabic": "فَاَسْاَلُكَ بِفَقْرِيْ اِلَيْكَ وَ غِنَاكَ عَنِّيْ"
  },
  {
   "segment_id": 44,
   "arabic": "وَ بِقُدْرَتِكَ عَلَيَّ وَ قِلَّةِ امْتِنَاعِيْ مِنْكَ"
  },
  {
   "segment_id": 45,
   "arabic": "اَنْ تَجْعَلَ دُعَائِيْ هٰذَا دُعَاءً وَافَقَ مِنْكَ اِجَابَةً"
  },
  {
   "segment_id": 46,
   "arabic": "وَ مَجْلِسِيْ هٰذَا مَجْلِسًا وَافَقَ مِنْكَ رَحْمَةً"
  },
  {
   "segment_id": 47,
   "arabic": "وَ طَلِبَتِيْ هٰذِهٖ طَلِبَةً وَافَقَتْ نَجَاحًا"
  },
  {
   "segment_id": 48,
   "arabic": "وَ مَا خِفْتُ عُسْرَتَهٗ مِنَ الْاُمُوْرِ فَيَسِّرْهُ"
  },
  {
   "segment_id": 49,
   "arabic": "وَ مَا خِفْتُ عَجْزَهٗ مِنَ الْاَشْيَاءِ فَوَسِّعْهُ"
  },
  {
   "segment_id": 50,
   "arabic": "وَ مَنْ اَرَادَنِيْ بِسُوْءٍ مِنَ الْخَلَائِقِ كُلِّهِمْ فَاغْلِبْهُ"
  },
  {
   "segment_id": 51,
   "arabic": "اٰمِيْنَ يَا اَرْحَمَ الرَّاحِمِيْنَ"
  },
  {
   "segment_id": 52,
   "arabic": "وَ هَوِّنْ عَلَيَّ مَا خَشِيْتُ شِدَّتَهٗ"
  },
  {
   "segment_id": 53,
   "arabic": "وَ اكْشِفْ عَنِّيْ مَا خَشِيْتُ كُرْبَتَهٗ"
  },
  {
   "segment_id": 54,
   "arabic": "وَ يَسِّرْ لِيْ مَا خَشِيْتُ عُسْرَتَهٗ"
  },
  {
   "segment_id": 55,
   "arabic": "اٰمِيْنَ يَا رَبَّ الْعَالَمِيْنَ"
  },
  {
   "segment_id": 56,
   "arabic": "اَللّٰهُمَّ انْزِعِ الْعُجْبَ وَ الرِّيَاءَ وَ الْكِبْرَ وَ الْبَغْيَ"
  },
  {
   "segment_id": 57,
   "arabic": "وَ الْحَسَدَ وَ الضَّعْفَ وَ الشَّكَّ وَ الْوَهْنَ"
  },
  {
   "segment_id": 58,
   "arabic": "وَ الضُّرَّ وَ الْاَسْقَامَ وَ الْخِذْلَانَ"
  },
  {
   "segment_id": 59,
   "arabic": "وَ الْمَكْرَ وَ الْخَدِيْعَةَ وَ الْبَلِيَّةَ وَ الْفَسَادَ"
  },
  {
   "segment_id": 60,
   "arabic": "مِنْ سَمْعِيْ وَ بَصَرِيْ وَ جَمِيْعِ جَوَارِحِيْ"
  },
  {
   "segment_id": 61,
   "arabic": "وَ خُذْ بِنَاصِيَتِيْ اِلٰى مَا تُحِبُّ وَ تَرْضٰى"
  },
  {
   "segment_id": 62,
   "arabic": "يَا اَرْحَمَ الرَّاحِمِيْنَ"
  },
  {
   "segment_id": 63,
   "arabic": "اَللّٰهُمَّ صَلِّ عَلٰى مُحَمَّدٍ وَ اٰلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 64,
   "arabic": "وَ اغْفِرْ ذَنْبِيْ"
  },
  {
   "segment_id": 65,
   "arabic": "وَ اسْتُرْ عَوْرَتِيْ"
  },
  {
   "segment_id": 66,
   "arabic": "وَ اٰمِنْ رَوْعَتِيْ"
  },
  {
   "segment_id": 67,
   "arabic": "وَ اجْبُرْ مُصِيْبَتِيْ"
  },
  {
   "segment_id": 68,
   "arabic": "وَ اَغْنِ فَقْرِيْ"
  },
  {
   "segment_id": 69,
   "arabic": "وَ يَسِّرْ حَاجَتِيْ"
  },
  {
   "segment_id": 70,
   "arabic": "وَ اَقِلْنِيْ عَثْرَتِيْ"
  },
  {
   "segment_id": 71,
   "arabic": "وَ اجْمَعْ شَمْلِيْ"
  },
  {
   "segment_id": 72,
   "arabic": "وَ اكْفِنِيْ مَا اَهَمَّنِيْ"
  },
  {
   "segment_id": 73,
   "arabic": "وَ مَا غَابَ عَنِّيْ، وَ مَا حَضَرَنِيْ"
  },
  {
   "segment_id": 74,
   "arabic": "وَ مَا اَتَخَوَّفُهٗ مِنْكَ"
  },
  {
   "segment_id": 75,
   "arabic": "يَا اَرْحَمَ الرَّاحِمِيْنَ"
  },
  {
   "segment_id": 76,
   "arabic": "اَللّٰهُمَّ فَوَّضْتُ اَمْرِيْ اِلَيْكَ"
  },
  {
   "segment_id": 77,
   "arabic": "وَ اَلْجَاْتُ ظَهْرِيْ اِلَيْكَ"
  },
  {
   "segment_id": 78,
   "arabic": "وَ اَسْلَمْتُ نَفْسِيْ اِلَيْكَ بِمَا جَنَيْتُ عَلَيْهَا"
  },
  {
   "segment_id": 79,
   "arabic": "فَرَقًا مِنْكَ وَ خَوْفًا وَ طَمَعًا"
  },
  {
   "segment_id": 80,
   "arabic": "وَ اَنْتَ الْكَرِيْمُ الَّذِيْ لَا يَقْطَعُ الرَّجَاءَ"
  },
  {
   "segment_id": 81,
   "arabic": "وَ لَا يُخَيِّبُ الدُّعَاءَ"
  },
  {
   "segment_id": 82,
   "arabic": "فَاَسْاَلُكَ بِحَقِّ اِبْرَاهِيْمَ خَلِيْلِكَ"
  },
  {
   "segment_id": 83,
   "arabic": "وَ مُوْسٰى كَلِيْمِكَ"
  },
  {
   "segment_id": 84,
   "arabic": "وَ عِيْسٰى رُوحِكَ"
  },
  {
   "segment_id": 85,
   "arabic": "وَ مُحَمَّدٍ صَلَّى اللهُ عَلَيْهِ وَ آلِهِ صَفِيِّكَ وَ نَبِيِّكَ"
  },
  {
   "segment_id": 86,
   "arabic": "اَلَّا تَصْرِفَ وَجْهَكَ الْكَرِيْمَ عَنِّيْ"
  },
  {
   "segment_id": 87,
   "arabic": "حَتّٰى تَقْبَلَ تَوْبَتِيْ"
  },
  {
   "segment_id": 88,
   "arabic": "وَ تَرْحَمَ عَبْرَتِيْ"
  },
  {
   "segment_id": 89,
   "arabic": "وَ تَغْفِرَ لِيْ خَطِيْئَتِيْ"
  },
  {
   "segment_id": 90,
   "arabic": "يَا اَرْحَمَ الرَّاحِمِيْنَ وَ يَا اَحْكَمَ الْحَاكِمِيْنَ"
  },
  {
   "segment_id": 91,
   "arabic": "اَللّٰهُمَّ اجْعَلْ ثَارِيْ عَلٰى مَنْ ظَلَمَنِيْ"
  },
  {
   "segment_id": 92,
   "arabic": "وَ انْصُرْنِيْ عَلٰى مَنْ عَادَانِيْ"
  },
  {
   "segment_id": 93,
   "arabic": "اَللّٰهُمَّ لَا تَجْعَلْ مُصِيْبَتِيْ فِيْ دِيْنِيْ"
  },
  {
   "segment_id": 94,
   "arabic": "وَ لَا تَجْعَلِ الدُّنْيَا اَكْبَرَ هَمِّيْ وَ لَا مَبْلَغَ عِلْمِيْ"
  },
  {
   "segment_id": 95,
   "arabic": "اِلٰهِيْ اَصْلِحْ لِيْ دِيْنِيَ الَّذِيْ هُوَ عِصْمَةُ اَمْرِيْ"
  },
  {
   "segment_id": 96,
   "arabic": "وَ اَصْلِحْ لِيْ دُنْيَايَ الَّتِيْ فِيْهَا مَعَاشِيْ"
  },
  {
   "segment_id": 97,
   "arabic": "وَ اَصْلِحْ لِيْ اٰخِرَتِيَ الَّتِيْ اِلَيْهَا مَعَادِيْ"
  },
  {
   "segment_id": 98,
   "arabic": "وَ اجْعَلِ الْحَيَاةَ زِيَادَةً لِيْ مِنْ كُلِّ خَيْرٍ"
  },
  {
   "segment_id": 99,
   "arabic": "وَ اجْعَلِ الْمَوْتَ رَاحَةً لِيْ مِنْ كُلِّ شَرٍّ"
  },
  {
   "segment_id": 100,
   "arabic": "اَللّٰهُمَّ اِنَّكَ عَفُوٌّ تُحِبُّ الْعَفْوَ فَاعْفُ عَنِّيْ"
  },
  {
   "segment_id": 101,
   "arabic": "اَللّٰهُمَّ اَحْيِنِيْ مَا عَلِمْتَ الْحَيَاةَ خَيْرًا لِيْ"
  },
  {
   "segment_id": 102,
   "arabic": "وَ تَوَفَّنِيْ اِذَا كَانَتِ الْوَفَاةُ خَيْرًا لِيْ"
  },
  {
   "segment_id": 103,
   "arabic": "وَ اَسْاَلُكَ خَشْيَتَكَ فِيْ الْغَيْبِ وَ الشَّهَادَةِ"
  },
  {
   "segment_id": 104,
   "arabic": "وَ الْعَدْلَ فِيْ الْغَضَبِ وَ الرِّضَا"
  },
  {
   "segment_id": 105,
   "arabic": "وَ اَسْاَلُكَ الْقَصْدَ فِيْ الْفَقْرِ وَ الْغِنٰى"
  },
  {
   "segment_id": 106,
   "arabic": "وَ اَسْاَلُكَ نَعِيْمًا لَا يَبِيْدُ"
  },
  {
   "segment_id": 107,
   "arabic": "وَ قُرَّةَ عَيْنٍ لَا يَنْقَطِعُ"
  },
  {
   "segment_id": 108,
   "arabic": "وَ اَسْاَلُكَ الرِّضَا بَعْدَ الْقَضَاءِ"
  },
  {
   "segment_id": 109,
   "arabic": "وَ اَسْاَلُكَ لَذَّةَ النَّظَرِ اِلٰى وَجْهِكَ"
  },
  {
   "segment_id": 110,
   "arabic": "اَللّٰهُمَّ اِنِّيْ اَسْتَهْدِيْكَ لِاِرْشَادِ اَمْرِيْ"
  },
  {
   "segment_id": 111,
   "arabic": "وَ اَعُوْذُ بِكَ مِنْ شَرِّ نَفْسِيْ"
  },
  {
   "segment_id": 112,
   "arabic": "اَللّٰهُمَّ عَمِلْتُ سُوْءً وَ ظَلَمْتُ نَفْسِيْ فَاغْفِرْ لِيْ"
  },
  {
   "segment_id": 113,
   "arabic": "اِنَّهٗ لَا يَغْفِرُ الذُّنُوْبَ اِلَّا اَنْتَ"
  },
  {
   "segment_id": 114,
   "arabic": "اَللّٰهُمَّ اِنِّيْ اَسْاَلُكَ تَعْجِيْلَ عَافِيَتِكَ"
  },
  {
   "segment_id": 115,
   "arabic": "وَ صَبْرًا عَلٰى بَلِيَّتِكَ"
  },
  {
   "segment_id": 116,
   "arabic": "وَ خُرُوْجًا مِنَ الدُّنْيَا اِلٰى رَحْمَتِكَ"
  },
  {
   "segment_id": 117,
   "arabic": "اَللّٰهُمَّ اِنِّيْ اُشْهِدُكَ"
  },
  {
   "segment_id": 118,
   "arabic": "وَ اُشْهِدُ مَلَائِكَتَكَ وَ حَمَلَةَ عَرْشِكَ"
  },
  {
   "segment_id": 119,
   "arabic": "وَ اُشْهِدُ مَنْ فِيْ السَّمَاوَاتِ وَ مَنْ فِيْ الْاَرْضِ"
  },
  {
   "segment_id": 120,
   "arabic": "اَنَّكَ اَنْتَ اللهُ لَا اِلٰهَ اِلَّا اَنْتَ وَحْدَكَ لَا شَرِيْكَ لَكَ"
  },
  {
   "segment_id": 121,
   "arabic": "وَ اَنَّ مُحَمَّدًا عَبْدُكَ وَ رَسُوْلُكَ صَلَّى اللهُ عَلَيْهِ وَ آلِهِ"
  },
  {
   "segment_id": 122,
   "arabic": "وَ اَسْاَلُكَ بِاَنَّ لَكَ الْحَمْدَ لَا اِلٰهَ اِلَّا اَنْتَ"
  },
  {
   "segment_id": 123,
   "arabic": "بَدِيْعُ السَّمَاوَاتِ وَ الْاَرْضِ"
  },
  {
   "segment_id": 124,
   "arabic": "يَا كَائِنُ قَبْلَ اَنْ يَكُوْنَ شَيْ‏ءٌ"
  },
  {
   "segment_id": 125,
   "arabic": "وَ الْمُكَوِّنُ لِكُلِّ شَيْ‏ءٍ"
  },
  {
   "segment_id": 126,
   "arabic": "وَ الْكَائِنُ بَعْدَ مَا لَا يَكُوْنُ شَيْ‏ءٌ"
  },
  {
   "segment_id": 127,
   "arabic": "اَللّٰهُمَّ اِلٰى رَحْمَتِكَ رَفَعْتُ بَصَرِيْ"
  },
  {
   "segment_id": 128,
   "arabic": "وَ اِلٰى جُوْدِكَ بَسَطْتُ كَفِّيْ"
  },
  {
   "segment_id": 129,
   "arabic": "فَلَا تَحْرِمْنِيْ وَ اَنَا اَسْاَلُكَ"
  },
  {
   "segment_id": 130,
   "arabic": "وَ لَا تُعَذِّبْنِيْ وَ اَنَا اَسْتَغْفِرُكَ"
  },
  {
   "segment_id": 131,
   "arabic": "اَللّٰهُمَّ فَاغْفِرْ لِيْ فَاِنَّكَ بِيْ عَالِمٌ"
  },
  {
   "segment_id": 132,
   "arabic": "وَ لَا تُعَذِّبْنِيْ فَاِنَّكَ عَلَيَّ قَادِرٌ"
  },
  {
   "segment_id": 133,
   "arabic": "بِرَحْمَتِكَ يَا اَرْحَمَ الرَّاحِمِيْنَ"
  },
  {
   "segment_id": 134,
   "arabic": "اَللّٰهُمَّ ذَا الرَّحْمَةِ الْوَاسِعَةِ"
  },
  {
   "segment_id": 135,
   "arabic": "وَ الصَّلَاةِ النَّافِعَةِ الرَّافِعَةِ"
  },
  {
   "segment_id": 136,
   "arabic": "صَلِّ عَلٰى اَكْرَمِ خَلْقِكَ عَلَيْكَ"
  },
  {
   "segment_id": 137,
   "arabic": "وَ اَحَبِّهِمْ اِلَيْكَ، وَ اَوْجَهِهِمْ لَدَيْكَ"
  },
  {
   "segment_id": 138,
   "arabic": "مُحَمَّدٍ عَبْدِكَ وَ رَسُوْلِكَ الْمَخْصُوْصِ بِفَضَائِلِ الْوَسَائِلِ"
  },
  {
   "segment_id": 139,
   "arabic": "اَشْرَفَ وَ اَكْمَلَ، وَ اَرْفَعَ وَ اَعْظَمَ"
  },
  {
   "segment_id": 140,
   "arabic": "وَ اَكْرَمَ مَا صَلَّيْتَ عَلٰى مُبَلِّغٍ عَنْكَ"
  },
  {
   "segment_id": 141,
   "arabic": "مُؤْتَمَنٍ عَلٰى وَحْيِكَ"
  },
  {
   "segment_id": 142,
   "arabic": "اَللّٰهُمَّ كَمَا سَدَدْتَ بِهِ الْعَمٰى"
  },
  {
   "segment_id": 143,
   "arabic": "وَ فَتَحْتَ بِهِ الْهُدٰى"
  },
  {
   "segment_id": 144,
   "arabic": "فَاجْعَلْ مَنَاهِـجَ سُبُلِهٖ لَنَا سُنَنًا"
  },
  {
   "segment_id": 145,
   "arabic": "وَ حُجَجَ بُرْهَانِهٖ لَنَا سَبَبًا"
  },
  {
   "segment_id": 146,
   "arabic": "نَاْتَمَّ بِهٖ اِلَى الْقُدُوْمِ عَلَيْكَ"
  },
  {
   "segment_id": 147,
   "arabic": "اَللّٰهُمَّ لَكَ الْحَمْدُ مِلْاَ السَّمَاوَاتِ السَّبْعِ وَ مِلْاَ طِبَاقِهِنَّ"
  },
  {
   "segment_id": 148,
   "arabic": "وَ مِلْاَ الْاَرَضِيْنَ السَّبْعِ وَ مِلْاَ مَا بَيْنَهُنَّ"
  },
  {
   "segment_id": 149,
   "arabic": "وَ مِلْاَ عَرْشِ رَبِّنَا الْكَرِيْمِ"
  },
  {
   "segment_id": 150,
   "arabic": "وَ مِيْزَانَ رَبِّنَا الْغَفَّارِ"
  },
  {
   "segment_id": 151,
   "arabic": "وَ مِدَادَ كَلِمَاتِ رَبِّنَا الْقَهَّارِ"
  },
  {
   "segment_id": 152,
   "arabic": "وَ مِلْاَ الْجَنَّةِ، وَ مِلْاَ النَّارِ"
  },
  {
   "segment_id": 153,
   "arabic": "وَ عَدَدَ الْمَاءِ وَ الثَّرٰى"
  },
  {
   "segment_id": 154,
   "arabic": "وَ عَدَدَ مَا يُرٰى وَ مَا لَا يُرٰى"
  },
  {
   "segment_id": 155,
   "arabic": "اَللّٰهُمَّ وَ اجْعَلْ صَلَوَاتِكَ وَ بَرَكَاتِكَ"
  },
  {
   "segment_id": 156,
   "arabic": "وَ مَنَّكَ وَ مَغْفِرَتَكَ"
  },
  {
   "segment_id": 157,
   "arabic": "وَ رَحْمَتَكَ وَ رِضْوَانَكَ"
  },
  {
   "segment_id": 158,
   "arabic": "وَ فَضْلَكَ وَ سَلَامَتَكَ"
  },
  {
   "segment_id": 159,
   "arabic": "وَ ذِكْرَكَ وَ نُوْرَكَ"
  },
  {
   "segment_id": 160,
   "arabic": "وَ شَرَفَكَ وَ نِعْمَتَكَ وَ خِيَرَتَكَ"
  },
  {
   "segment_id": 161,
   "arabic": "عَلٰى مُحَمَّدٍ وَ اٰلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 162,
   "arabic": "كَمَا صَلَّيْتَ وَ بَارَكْتَ وَ تَرَحَّمْتَ"
  },
  {
   "segment_id": 163,
   "arabic": "عَلٰى اِبْرَاهِيْمَ وَ اٰلِ اِبْرَاهِيْمَ"
  },
  {
   "segment_id": 164,
   "arabic": "اِنَّكَ حَمِيْدٌ مَجِيْدٌ"
  },
  {
   "segment_id": 165,
   "arabic": "اَللّٰهُمَّ اَعْطِ مُحَمَّدًا الْوَسِيْلَةَ الْعُظْمٰى"
  },
  {
   "segment_id": 166,
   "arabic": "وَ كَرِيْمَ جَزَائِكَ فِيْ الْعُقْبٰى"
  },
  {
   "segment_id": 167,
   "arabic": "حَتّٰى تُشَرِّفَهٗ يَوْمَ الْقِيَامَةِ يَا اِلٰهَ الْهُدٰى"
  },
  {
   "segment_id": 168,
   "arabic": "اَللّٰهُمَّ صَلِّ عَلٰى مُحَمَّدٍ وَ اٰلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 169,
   "arabic": "وَ عَلٰى جَمِيْعِ مَلَائِكَتِكَ وَ اَنْبِيَائِكَ وَ رُسُلِكَ"
  },
  {
   "segment_id": 170,
   "arabic": "سَلَامٌ عَلٰى جَبْرَئِيْلَ وَ مِيْكَائِيْلَ وَ اِسْرَافِيْلَ"
  },
  {
   "segment_id": 171,
   "arabic": "وَ حَمَلَةِ الْعَرْشِ وَ مَلَائِكَتِكَ الْمُقَرَّبِيْنَ"
  },
  {
   "segment_id": 172,
   "arabic": "وَ الْكِرَامِ الْكَاتِبِيْنَ وَ الْكَرُوْبِيِّيْنَ"
  },
  {
   "segment_id": 173,
   "arabic": "وَ سَلَامٌ عَلٰى مَلَائِكَتِكَ اَجْمَعِيْنَ"
  },
  {
   "segment_id": 174,
   "arabic": "وَ سَلَامٌ عَلٰى اَبِيْنَا اٰدَمَ، وَ عَلٰى اُمِّنَا حَوَّاءَ"
  },
  {
   "segment_id": 175,
   "arabic": "وَ سَلَامٌ عَلٰى النَّبِيِّيْنَ اَجْمَعِيْنَ"
  },
  {
   "segment_id": 176,
   "arabic": "وَ الصِّدِّيقِيْنَ وَ الشُّهَدَاءِ وَ الصَّالِحِيْنَ"
  },
  {
   "segment_id": 177,
   "arabic": "وَ سَلَامٌ عَلَى الْمُرْسَلِيْنَ اَجْمَعِيْنَ"
  },
  {
   "segment_id": 178,
   "arabic": "وَ الْحَمْدُ لِلهِ رَبِّ الْعَالَمِيْنَ"
  },
  {
   "segment_id": 179,
   "arabic": "وَ لَا حَوْلَ وَ لَا قُوَّةَ اِلَّا بِاللهِ الْعَلِيِّ الْعَظِيْمِ"
  },
  {
   "segment_id": 180,
   "arabic": "وَ حَسْبِيَ اللهُ وَ نِعْمَ الْوَكِيْلُ"
  },
  {
   "segment_id": 181,
   "arabic": "وَ صَلَّى اللهُ عَلٰى مُحَمَّدٍ وَ اٰلِهٖ وَ سَلَّمَ كَثِيْرًا"
  }
 ]
}