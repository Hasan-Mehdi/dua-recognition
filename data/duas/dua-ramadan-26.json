{
 "dua_id": "dua-ramadan-26",
 "dua_name_en": "Day 26",
 "dua_name_ar": " شهر رمضان ٢٦  ",
 "source": "https://www.duaplayer.org/en/dua/ramadan-26",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "اللّهُمّ اجْعَلْ سَعْيِي فِيهِ مَشْكُوراً،"
  },
  {
   "segment_id": 4,
   "arabic": "وَذَنْبِي فِيهِ مَغْفُوراً،"
  },
  {
   "segment_id": 5,
   "arabic": "وَعَمَلِي فِيهِ مَقْبُولاً،"
  },
  {
   "segment_id": 6,
   "arabic": "وَعَيْبِي فِيهِ مَسْتُوراً،"
  },
  {
   "segment_id": 7,
   "arabic": "يَا أَسْمَعَ السَّامِعِينَ."
  }
 ]
}