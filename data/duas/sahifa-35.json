{
 "dua_id": "sahifa-35",
 "dua_name_en": "Sahifa 35: in satisfaction when he looked upon the companions of this world",
 "dua_name_ar": "دُعَاؤُهُ فِي الرِّضَا إذا نَظَرَ الى اَصحابِ الدُنيا",
 "source": "https://duas.pro/35-in-satisfaction-when-he-looked-upon-the-companions-of-this-world",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "أللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَآلِهِ،"
  },
  {
   "segment_id": 2,
   "arabic": "الْحَمْدُ للهِ رِضًى بِحُكْمِ اللهِ،"
  },
  {
   "segment_id": 3,
   "arabic": "شَهِدْتُ أَنَّ اللهَ قَسَمَ مَعَايِشَ عِبَادِهِ بِالْعَدْلِ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَأَخَذَ عَلَى جَمِيعِ خَلْقِهِ بِالْفَضْلِ."
  },
  {
   "segment_id": 5,
   "arabic": "وَلاَ تَفْتِنِّي بِمَا أَعْطَيْتَهُمْ،"
  },
  {
   "segment_id": 6,
   "arabic": "وَلاَ تَفْتِنْهُمْ بِمَا مَنَعْتَنِي،"
  },
  {
   "segment_id": 7,
   "arabic": "فَأحْسُدَ خَلْقَكَ، وَأَغْمِطَ حُكْمَكَ."
  },
  {
   "segment_id": 8,
   "arabic": "وَطَيِّبْ بِقَضَائِكَ نَفْسِي،"
  },
  {
   "segment_id": 9,
   "arabic": "وَوَسِّعْ بِمَوَاقِعِ حُكْمِكَ صَدْرِي،"
  },
  {
   "segment_id": 10,
   "arabic": "وَهَبْ لِي الثِّقَةَ لأُقِرَّ مَعَهَا،"
  },
  {
   "segment_id": 11,
   "arabic": "بِأَنَّ قَضَاءَكَ لَمْ يَجْرِ إلاَّ بِالْخِيَرَةِ."
  },
  {
   "segment_id": 12,
   "arabic": "وَاجْعَلْ شُكْرِي لَكَ عَلَى مَا زَوَيْتَ عَنِّي،"
  },
  {
   "segment_id": 13,
   "arabic": "أَوْفَرَ مِنْ شُكْرِي إِيَّاكَ عَلَى مَا خَوَّلْتَنِي."
  },
  {
   "segment_id": 14,
   "arabic": "وَاعْصِمْنِي مِنْ أَنْ أَظُنَّ بِذِي عَدَمٍ خَسَاسَةً،"
  },
  {
   "segment_id": 15,
   "arabic": "أَوْ أَظُنَّ بِصَاحِبِ ثَرْوَةٍ فَضْلًا."
  },
  {
   "segment_id": 16,
   "arabic": "فَإنَّ الشَّرِيفَ مَنْ شَرَّفَتْهُ طَاعَتُكَ،"
  },
  {
   "segment_id": 17,
   "arabic": "وَالْعَزِيزَ مَنْ أَعَزَّتْهُ عِبَادَتُكَ."
  },
  {
   "segment_id": 18,
   "arabic": "فَصَلِّ عَلَى مُحَمَّدٍ وَآلِهِ،"
  },
  {
   "segment_id": 19,
   "arabic": "وَمَتِّعْنَا بِثَرْوَةٍ لاَ تَنْفَدُ،"
  },
  {
   "segment_id": 20,
   "arabic": "وَأَيِّدْنَا بِعِزٍّ لاَ يُفْقَدُ،"
  },
  {
   "segment_id": 21,
   "arabic": "وَأَسْرِحْنَا فِيْ مُلْكِ الأَبَدِ،"
  },
  {
   "segment_id": 22,
   "arabic": "إنَّكَ الْوَاحِدُ الأَحَدُ الصَّمَدُ،"
  },
  {
   "segment_id": 23,
   "arabic": "الَّذِي لَمْ تَلِدْ وَلَمْ تُولَدْ،"
  },
  {
   "segment_id": 24,
   "arabic": "وَلَمْ يَكُنْ لَكَ كُفُوًا أَحَدٌ."
  }
 ]
}