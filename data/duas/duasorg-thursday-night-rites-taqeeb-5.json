{
 "dua_id": "duasorg-thursday-night-rites-taqeeb-5",
 "dua_name_en": "Thursday Night Dua - Allahumma inni asaluka rehmatan indika",
 "dua_name_ar": "",
 "source": "https://www.duas.org/thursday-night-rites-taqeeb.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللّهُمَّ إنِّي أَسْأَلُكَ رَحْمَةً مِنْ عِنْدكَ."
  },
  {
   "segment_id": 2,
   "arabic": "تَهْدِي بِهَا قَلْبِي، وَتَجْمَعُ بِهَا أَمْرِي."
  },
  {
   "segment_id": 3,
   "arabic": "وَتَلُّمُ بِهَا شَعَثِي، وَتَحْفَظُ بِهَا غَائِبِي."
  },
  {
   "segment_id": 4,
   "arabic": "وَتُصْلِحُ بِهَا شَاهِدِي، وَتَزَكِّي بِهَا عَمَلِي."
  },
  {
   "segment_id": 5,
   "arabic": "وَتُلْهِمُنِي بِهَا رُشْدِي، وَتَعْصِمُنِي بِهَا مِنْ كُلِّ سُوْءٍ."
  },
  {
   "segment_id": 6,
   "arabic": "اَللّهُمَّ أَعْطِنِي إيمَانَاً صَادِقَاً، وَيَقِيناً خَالِصَاً."
  },
  {
   "segment_id": 7,
   "arabic": "وَرَحْمَةً أَنَالُ بِهَا شَرَفَ كَرَامَتِكَ."
  },
  {
   "segment_id": 8,
   "arabic": "فِي الدُّنْيَا وَالآخِرَةِ."
  },
  {
   "segment_id": 9,
   "arabic": "اَللّهُمَّ إِنِّي أَسْأَلُكَ الْفَوْزَ فِي الْقَضَاءِ."
  },
  {
   "segment_id": 10,
   "arabic": "وَمَنَازِلَ الْعُلَمَاءِ، وَعَيْشَ الْسُّعَدَاءِ."
  },
  {
   "segment_id": 11,
   "arabic": "وَالْنَّصْرَ عَلَى الأَعْدَاءِ."
  },
  {
   "segment_id": 12,
   "arabic": "اَللّهُمَّ إِنِّي أَنْزَلْتُ بِكَ حَاجَتِي."
  },
  {
   "segment_id": 13,
   "arabic": "وَإِنْ ضَعُفَ عَمَلِي فَقَدْ افْتَقَرْتُ إِلَى رَحْمَتِكَ."
  },
  {
   "segment_id": 14,
   "arabic": "فَأَسْأَلُكَ يَا قَاضِي الأُمُورِ، وَيَا شَافِي الصُّدُورِ."
  },
  {
   "segment_id": 15,
   "arabic": "كَمَا تُجيرُ بَيْنَ الْبُحُورِ، أَنْ تُجِيرَنِي."
  },
  {
   "segment_id": 16,
   "arabic": "مِنْ عَذَابِ الْسَعِيرِ، وَمِنْ دَعْوَةِ الْثُّبُورِ."
  },
  {
   "segment_id": 17,
   "arabic": "وَمِنْ فِتْنَةِ الْقُبُورِ."
  },
  {
   "segment_id": 18,
   "arabic": "اَللّهُمَّ وَمَا قَصُرَتْ عَنْهُ مَسْأَلَتِي."
  },
  {
   "segment_id": 19,
   "arabic": "وَلَمْ تَبْلَغْهُ نِيَّتِي، وَلَمْ تُحِطْ بِهِ مَسْأَلَتِي."
  },
  {
   "segment_id": 20,
   "arabic": "مِنْ خَيْرٍ وَعَدْتَهُ أَحَدَاً مِنْ خَلْقِكَ."
  },
  {
   "segment_id": 21,
   "arabic": "فَإِنِّي أَرْغَبُ إِلَيْكَ فِيهِ."
  },
  {
   "segment_id": 22,
   "arabic": "اَللّهُمَّ يَا ذَا الْحَبْلِ الَّشدِيدِ، وَالأَمْرِ الرَّشِيدِ."
  },
  {
   "segment_id": 23,
   "arabic": "أَسْأَلُكَ الأَمْنَ يَوْمَ الْوَعِيدِ."
  },
  {
   "segment_id": 24,
   "arabic": "وَالْجَنَّةَ يَوْمَ الْخُلُودِ."
  },
  {
   "segment_id": 25,
   "arabic": "مَعَ الْمُقَرَّبِينَ الشُّهُودِ."
  },
  {
   "segment_id": 26,
   "arabic": "وَالْرُّكَّعِ وَالسُّجُودِ، الْمُوفِينَ بِالْعُهُودِ."
  },
  {
   "segment_id": 27,
   "arabic": "إِنَّكَ رَحِيمٌ وَدُوُدٌ."
  },
  {
   "segment_id": 28,
   "arabic": "وَإِنَّكَ تَفْعَلُ مَا تُريدُ."
  },
  {
   "segment_id": 29,
   "arabic": "اَللّهُمَّ اجْعَلْنَا هَادّينَ مَهْدِيّينَ."
  },
  {
   "segment_id": 30,
   "arabic": "غَيْرَ ضَالِّينَ، وَلاَ مُضِلِّينَ."
  },
  {
   "segment_id": 31,
   "arabic": "سِلْمَاً لأَوْلِيائِكَ، وَحَرْبَاً لأَعْدَائِكَ."
  },
  {
   "segment_id": 32,
   "arabic": "نُحِبُّ بِحُبِّكَ الْتَائِبِينَ."
  },
  {
   "segment_id": 33,
   "arabic": "وَنُعَادِي بِعَدَاوَتِكَ مَنْ خَالَفَكَ."
  },
  {
   "segment_id": 34,
   "arabic": "اَللّهُمَّ هذَا الدُّعَاءُ، وَعَلَيكَ الاسْتِجَابَةُ."
  },
  {
   "segment_id": 35,
   "arabic": "وَهذَا الجُهْدُ، وَعَلَيْكَ التُّكْلاَنُ."
  },
  {
   "segment_id": 36,
   "arabic": "اَللّهُمَّ اجْعَلْ لِي نُورَاً فِي قَلْبِي."
  },
  {
   "segment_id": 37,
   "arabic": "وَنُورَاً فِي قَبْرِي، وَنُورَاً بَيْنَ يَدَيَّ."
  },
  {
   "segment_id": 38,
   "arabic": "وَنُورَاً تَحْتِي، وَنُورَاً فَوْقِي."
  },
  {
   "segment_id": 39,
   "arabic": "وَنُورَاً فِي سَمْعِي، وَنُورَاً فِي بَصَرِي."
  },
  {
   "segment_id": 40,
   "arabic": "وَنُورَاً فِي شَعْرِي، وَنُورَاً فِي بَشَرِي."
  },
  {
   "segment_id": 41,
   "arabic": "وَنُورَاً فِي لَحْمِي، وَنُورَاً فِي عِظَامِي."
  },
  {
   "segment_id": 42,
   "arabic": "اَللّهُمَّ أَعْظِمْ لِي النُّورَ."
  },
  {
   "segment_id": 43,
   "arabic": "سُبْحَانَ الَّذي اِرْتَدى بِالعِزِّ وَبَانَ بِهِ."
  },
  {
   "segment_id": 44,
   "arabic": "سُبْحَانَ الَّذي لَبِسَ الْمَجْدَ وَتَكَرَّمَ بِهِ."
  },
  {
   "segment_id": 45,
   "arabic": "سُبْحَانَ مَنْ لا يَنْبَغِي التَّسْبيحُ إلاّ لَهُ."
  },
  {
   "segment_id": 46,
   "arabic": "سُبْحَانَ ذِي الْفَضْلِ وَالنِّعَمِ."
  },
  {
   "segment_id": 47,
   "arabic": "سُبْحَانَ ذِي الْمَجْدِ وَالْكَرَمِ."
  },
  {
   "segment_id": 48,
   "arabic": "سُبْحَانَ ذِي الْجَلالِ وَالإِكْرَامِ."
  }
 ]
}