{
 "dua_id": "ziyarat-aal-yaseen",
 "dua_name_en": "Ziyarat Aal Yaseen",
 "dua_name_ar": "زیارة آل یاسین",
 "source": "https://duas.pro/ziyarat-aal-yaseen",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "سَلاَمٌ عَلَىٰ آلِ يـٰس"
  },
  {
   "segment_id": 4,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا دَاعِيَ ٱللَّهِ وَرَبَّانِيَّ آيَاتِهِ"
  },
  {
   "segment_id": 5,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا بَابَ ٱللَّهِ وَدَيَّانَ دِينِهِ"
  },
  {
   "segment_id": 6,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا خَلِيفَةَ ٱللَّهِ وَنَاصِرَ حَقِّهِ"
  },
  {
   "segment_id": 7,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا حُجَّةَ ٱللَّهِ وَدَلِيلَ إِرَادَتِهِ"
  },
  {
   "segment_id": 8,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا تَالِيَ كِتَابِ ٱللَّهِ وَتَرْجُمَانَهُ"
  },
  {
   "segment_id": 9,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ فِي آنَاءِ لَيْلِكَ وَأَطْرَافِ نَهَارِكَ"
  },
  {
   "segment_id": 10,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا بَقِيَّةَ ٱللَّهِ فِي أَرْضِهِ"
  },
  {
   "segment_id": 11,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا مِيثَاقَ ٱللَّهِ ٱلَّذِي أَخَذَهُ وَوَكَّدَهُ"
  },
  {
   "segment_id": 12,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا وَعْدَ ٱللَّهِ ٱلَّذِي ضَمِنَهُ"
  },
  {
   "segment_id": 13,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ أَيُّهَا ٱلْعَلَمُ ٱلْمَنْصُوبُ"
  },
  {
   "segment_id": 14,
   "arabic": "وَٱلْعِلْمُ ٱلْمَصْبُوبُ"
  },
  {
   "segment_id": 15,
   "arabic": "وَٱلْغَوْثُ وَٱلرَّحْمَةُ ٱلْوَاسِعَةُ"
  },
  {
   "segment_id": 16,
   "arabic": "وَعْداً غَيْرَ مَكْذُوبٍ"
  },
  {
   "segment_id": 17,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ حِينَ تَقوُمُ"
  },
  {
   "segment_id": 18,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ حِينَ تَقْعُدُ"
  },
  {
   "segment_id": 19,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ حِينَ تَقْرَأُ وَتُبَيِّنُ"
  },
  {
   "segment_id": 20,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ حِينَ تُصَلِّي وَتَقْنُتُ"
  },
  {
   "segment_id": 21,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ حِينَ تَرْكَعُ وَتَسْجُدُ"
  },
  {
   "segment_id": 22,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ حِينَ تُهَلِّلُ وَتُكَبِّرُ"
  },
  {
   "segment_id": 23,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ حِينَ تَحْمَدُ وَتَسْتَغْفِرُ"
  },
  {
   "segment_id": 24,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ حِينَ تُصْبِحُ وَتُمْسِي"
  },
  {
   "segment_id": 25,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ فِي ٱللَّيْلِ إِذَا يَغْشَىٰ"
  },
  {
   "segment_id": 26,
   "arabic": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ"
  },
  {
   "segment_id": 27,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ أَيُّهَا ٱلإِمَامُ ٱلْمَأْمُونُ"
  },
  {
   "segment_id": 28,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ أَيُّهَا ٱلْمُقَدَّمُ ٱلْمَأْمُولُ"
  },
  {
   "segment_id": 29,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ بِجَوَامِعِ ٱلسَّلاَمِ"
  },
  {
   "segment_id": 30,
   "arabic": "أُشْهِدُكَ يَا مَوْلاَيَ"
  },
  {
   "segment_id": 31,
   "arabic": "أَنِّي أَشْهَدُ أَنْ لاَ إِلٰهَ إِلاَّ ٱللَّهُ"
  },
  {
   "segment_id": 32,
   "arabic": "وَحْدَهُ لاَ شَرِيكَ لَهُ"
  },
  {
   "segment_id": 33,
   "arabic": "وَأَنَّ مُحَمَّداً عَبْدُهُ وَرَسُولُهُ"
  },
  {
   "segment_id": 34,
   "arabic": "لاَ حَبِيبَ إِلاَّ هُوَ وَأَهْلُهُ"
  },
  {
   "segment_id": 35,
   "arabic": "وَأُشْهِدُكَ يَا مَوْلاَيَ"
  },
  {
   "segment_id": 36,
   "arabic": "أَنَّ عَلِيّاً أَمِيرَ ٱلْمُؤْمِنِينَ حُجَّتُهُ"
  },
  {
   "segment_id": 37,
   "arabic": "وَٱلْحَسَنَ حُجَّتُهُ"
  },
  {
   "segment_id": 38,
   "arabic": "وَٱلْحُسَيْنَ حُجَّتُهُ"
  },
  {
   "segment_id": 39,
   "arabic": "وَعَلِيَّ بْنَ ٱلْحُسَيْنِ حُجَّتُهُ"
  },
  {
   "segment_id": 40,
   "arabic": "وَمُحَمَّدَ بْنَ عَلِيٍّ حُجَّتُهُ"
  },
  {
   "segment_id": 41,
   "arabic": "وَجَعْفَرَ بْنَ مُحَمَّدٍ حُجَّتُهُ"
  },
  {
   "segment_id": 42,
   "arabic": "وَموُسَىٰ بْنَ جَعْفَرٍ حُجَّتُهُ"
  },
  {
   "segment_id": 43,
   "arabic": "وَعَلِيَّ بْنَ مُوسَىٰ حُجَّتُهُ"
  },
  {
   "segment_id": 44,
   "arabic": "وَمُحَمَّدَ بْنَ عَلِيٍّ حُجَّتُهُ"
  },
  {
   "segment_id": 45,
   "arabic": "وَعَلِيَّ بْنَ مُحَمَّدٍ حُجَّتُهُ"
  },
  {
   "segment_id": 46,
   "arabic": "وَٱلْحَسَنَ بْنَ عَلِيٍّ حُجَّتُهُ"
  },
  {
   "segment_id": 47,
   "arabic": "وَأَشْهَدُ أَنَّكَ حُجَّةُ ٱللَّهِ"
  },
  {
   "segment_id": 48,
   "arabic": "أَنْتُمُ ٱلأَوَّلُ وَٱلآخِرُ"
  },
  {
   "segment_id": 49,
   "arabic": "وَأَنَّ رَجْعَتَكُمْ حَقٌّ لاَ رَيْبَ فِيهَا"
  },
  {
   "segment_id": 50,
   "arabic": "يَوْمَ لاَ يَنْفَعُ نَفْساً إِيـمَانُهَا"
  },
  {
   "segment_id": 51,
   "arabic": "لَمْ تَكُنْ آمَنَتْ مِنْ قَبْلُ"
  },
  {
   "segment_id": 52,
   "arabic": "أَوْ كَسَبَتْ فِي إِيـمَانِهَا خَيْراً"
  },
  {
   "segment_id": 53,
   "arabic": "وَأَنَّ ٱلْمَوْتَ حَقٌّ"
  },
  {
   "segment_id": 54,
   "arabic": "وَأَنَّ نَاكِراً وَنَكيراً حَقٌّ"
  },
  {
   "segment_id": 55,
   "arabic": "وَأَشْهَدُ أَنَّ ٱلنَّشْرَ حَقٌّ"
  },
  {
   "segment_id": 56,
   "arabic": "وَٱلْبَعَثَ حَقٌّ"
  },
  {
   "segment_id": 57,
   "arabic": "وَأَنَّ ٱلصِّرَاطَ حَقٌّ"
  },
  {
   "segment_id": 58,
   "arabic": "وَٱلْمِرْصَادَ حَقٌّ"
  },
  {
   "segment_id": 59,
   "arabic": "وَٱلْمِيزَانَ حَقٌّ"
  },
  {
   "segment_id": 60,
   "arabic": "وَٱلْحَشْرَ حَقٌّ"
  },
  {
   "segment_id": 61,
   "arabic": "وَٱلْحِسَابَ حَقٌّ"
  },
  {
   "segment_id": 62,
   "arabic": "وَٱلْجَنَّةَ وَٱلنَّارَ حَقٌّ"
  },
  {
   "segment_id": 63,
   "arabic": "وَٱلْوَعْدَ وَٱلْوَعِيدَ بِهِمَا حَقٌّ"
  },
  {
   "segment_id": 64,
   "arabic": "يَا مَوْلاَيَ شَقِيَ مَنْ خَالَفَكُمْ"
  },
  {
   "segment_id": 65,
   "arabic": "وَسَعِدَ مَنْ أَطَاعَكُمْ"
  },
  {
   "segment_id": 66,
   "arabic": "فَٱشْهَدْ عَلَىٰ مَا أَشْهَدْتُكَ عَلَيْهِ"
  },
  {
   "segment_id": 67,
   "arabic": "وَأَنَا وَلِيٌّ لَكَ"
  },
  {
   "segment_id": 68,
   "arabic": "بَرِيءٌ مِنْ عَدُوِّكَ"
  },
  {
   "segment_id": 69,
   "arabic": "فَٱلْحَقُّ مَا رَضِيتُمُوهُ"
  },
  {
   "segment_id": 70,
   "arabic": "وَٱلْبَاطِلُ مَا أَسْخَطْتُمُوهُ"
  },
  {
   "segment_id": 71,
   "arabic": "وَٱلْمَعْرُوفُ مَا أَمَرْتُمْ بِهِ"
  },
  {
   "segment_id": 72,
   "arabic": "وَٱلْمُنْكَرُ مَا نَهَيْتُمْ عَنْهُ"
  },
  {
   "segment_id": 73,
   "arabic": "فَنَفْسِي مُؤْمِنَةٌ بِٱللَّهِ"
  },
  {
   "segment_id": 74,
   "arabic": "وَحْدَهُ لاَ شَريكَ لَهُ"
  },
  {
   "segment_id": 75,
   "arabic": "وَبِرَسُولِهِ وَبِأَمِيرِ ٱلْمُؤْمِنِينَ"
  },
  {
   "segment_id": 76,
   "arabic": "وَبِكُمْ يَا مَوْلاَيَ أَوَّلِكُمْ وَآخِرِكُمْ"
  },
  {
   "segment_id": 77,
   "arabic": "وَنُصْرَتِي مُعَدَّةٌ لَكُمْ"
  },
  {
   "segment_id": 78,
   "arabic": "وَمَوَدَّتِي خَالِصَةٌ لَكُمْ"
  },
  {
   "segment_id": 79,
   "arabic": "آمِينَ آمِينَ"
  }
 ]
}