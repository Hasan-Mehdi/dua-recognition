{
 "dua_id": "duasorg-sahifa-fatimiya-dua-for-sleep",
 "dua_name_en": "Dua of Sayeda Fatima (sa) for difficulty in falling asleep",
 "dua_name_ar": "",
 "source": "https://www.duas.org/sahifa-fatimiya-dua-for-sleep.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَلْحَمْدُ لِلهِ الْكَافِيْ"
  },
  {
   "segment_id": 2,
   "arabic": "سُبْحَانَ اللهِ الْاَعْلٰى"
  },
  {
   "segment_id": 3,
   "arabic": "حَسْبِيَ اللهُ وَ كَفٰى"
  },
  {
   "segment_id": 4,
   "arabic": "مَا شَاءَ اللهُ قَضٰى"
  },
  {
   "segment_id": 5,
   "arabic": "سَمِعَ اللهُ لِمَنْ دَعَا"
  },
  {
   "segment_id": 6,
   "arabic": "لَيْسَ مِنَ اللهِ مَلْجَاٌ"
  },
  {
   "segment_id": 7,
   "arabic": "وَ لَا وَرَاءَ اللهِ مُلْتَجَاٌ"
  },
  {
   "segment_id": 8,
   "arabic": "تَوَكَّلْتُ عَلَى اللهِ رَبِّيْ وَ رَبِّكُمْ"
  },
  {
   "segment_id": 9,
   "arabic": "مَا مِنْ دَابَّةٍ اِلَّا هُوَ آخِذٌ بِنَاصِيَتِهَا"
  },
  {
   "segment_id": 10,
   "arabic": "اِنَّ رَبِّيْ عَلٰى صِرَاطٍ مُسْتَقِيْمٍ"
  },
  {
   "segment_id": 11,
   "arabic": "اَلْحَمْدُ لِلهِ الَّذِيْ لَمْ يَتَّخِذْ وَلَدًا"
  },
  {
   "segment_id": 12,
   "arabic": "وَ لَمْ يَكُنْ لَهُ شَرِيْكٌ فِيْ الْمُلْكِ"
  },
  {
   "segment_id": 13,
   "arabic": "وَ لَمْ يَكُنْ لَهُ وَلِيٌّ مِنَ الذُّلِّ"
  },
  {
   "segment_id": 14,
   "arabic": "وَ كَبِّرْهُ تَكْبِيْرًا"
  }
 ]
}