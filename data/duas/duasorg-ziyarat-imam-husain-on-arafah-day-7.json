{
 "dua_id": "duasorg-ziyarat-imam-husain-on-arafah-day-7",
 "dua_name_en": "Ziyarat of Imam Husain on the Day of Arafah · Allāhumma laka ta‘arraḍt",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ziyarat-imam-husain-on-arafah-day.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللَّهُمَّ لَكَ تَعَرَّضْتُ"
  },
  {
   "segment_id": 2,
   "arabic": "وَلِزِيَارَةِ أَوْلِيائِكَ قَصَدْتُ"
  },
  {
   "segment_id": 3,
   "arabic": "رَغْبَةً فِي ثَوَابِكَ"
  },
  {
   "segment_id": 4,
   "arabic": "وَرَجَاءً لِمَغْفِرَتِكَ"
  },
  {
   "segment_id": 5,
   "arabic": "وَجَزِيلِ إِحْسَانِكَ"
  },
  {
   "segment_id": 6,
   "arabic": "فَأَسْأَلُكَ أَنْ تُصَلِّيَ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 7,
   "arabic": "وَأَنْ تَجْعَلَ رِزْقِي بِهِمْ دَارّاً"
  },
  {
   "segment_id": 8,
   "arabic": "وَعَيْشِي بِهِمْ قارّاً"
  },
  {
   "segment_id": 9,
   "arabic": "وَزِيَارَتِي بِهِمْ مَقْبُولَةً"
  },
  {
   "segment_id": 10,
   "arabic": "وَحَيَاتِي بِهِمْ طَيِّبَةً"
  },
  {
   "segment_id": 11,
   "arabic": "وَذَنْبِي بِهِمْ مَغْفُوراً"
  },
  {
   "segment_id": 12,
   "arabic": "وَٱقْلِبْنِي بِهِمْ مُفْلِحاً مُنْجِحاً"
  },
  {
   "segment_id": 13,
   "arabic": "مُسْتَجَاباً دُعَائِي"
  },
  {
   "segment_id": 14,
   "arabic": "بِأَفْضَلِ مَا يَنْقَلِبُ بِهِ أَحَدٌ"
  },
  {
   "segment_id": 15,
   "arabic": "مِنْ زُوَّارِهِ وَٱلْقَاصِدِينَ إِلَيْهِ"
  },
  {
   "segment_id": 16,
   "arabic": "بِرَحْمَتِـكَ يَا أَرْحَمَ ٱلرَّاحِمينَ"
  }
 ]
}