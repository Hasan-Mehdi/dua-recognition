{
 "dua_id": "duasorg-15-shaaban-salaat-after-isha-prayer",
 "dua_name_en": "15 Shaban - Salaat After Isha and Dua by Imam Sadiq(as)",
 "dua_name_ar": "",
 "source": "https://www.duas.org/15-shaaban-salaat-after-isha-prayer.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "يَا مَنْ إلَيْهِ مَلْجَأُ الْعِبَادِ فِي الْمُهِمَّاتِ،"
  },
  {
   "segment_id": 2,
   "arabic": "وَإلَيْهِ يَفْزَعُ الْخَلْقُ فِي الْمُلِمَّاتِ،"
  },
  {
   "segment_id": 3,
   "arabic": "يَا عَالِمَ الْجَهْرِ وَالْخَفِيَّاتِ،"
  },
  {
   "segment_id": 4,
   "arabic": "يَا مَنْ لا تَخْفَى عَلَيْهِ خَوَاطِرُ الأَوْهَامِ وَتَصَرُّفُ الْخَطَرَاتِ،"
  },
  {
   "segment_id": 5,
   "arabic": "يَارَبَّ الْخَلائِقِ وَالْبَرِيَّاتِ،"
  },
  {
   "segment_id": 6,
   "arabic": "يَا مَنْ بِيَدِهِ مَلَكُوتُ الأَرَضِينَ وَالسَّمَاوَاتِ،"
  },
  {
   "segment_id": 7,
   "arabic": "أَنْتَ اللّهُ لا إلهَ إلاَّ أَنْتَ،"
  },
  {
   "segment_id": 8,
   "arabic": "أَمُتُّ إلَيْكَ بِلا إلهَ إلاَّ أَنْتَ،"
  },
  {
   "segment_id": 9,
   "arabic": "فَيَا لا إلهَ إلاَّ أَنْتَ اجْعَلْنِي فِي هذِهِ اللَّيْلَةِ مِمَّنْ نَظَرْتَ إلَيْهِ فَرَحِمْتَهُ،"
  },
  {
   "segment_id": 10,
   "arabic": "وَسَمِعْتَ دُعَاءَهُ فَأَجَبْتَهُ،"
  },
  {
   "segment_id": 11,
   "arabic": "وَعَلِمْتَ اسْتِقَالَتَهُ فَأَقَلْتَهُ،"
  },
  {
   "segment_id": 12,
   "arabic": "وَتَجَاوَزْتَ عَنْ سَالِفِ خَطِيئَتِهِ وَعَظِيمِ جَرِيرَتِهِ،"
  },
  {
   "segment_id": 13,
   "arabic": "فَقَدِ اسْتَجَرْتُ بِكَ مِنْ ذُنُوبِي،"
  },
  {
   "segment_id": 14,
   "arabic": "وَلَجَأْتُ إلَيْكَ فِي سَتْرِ عُيُوبِي."
  },
  {
   "segment_id": 15,
   "arabic": "اللّهُمَّ فَجُدْ عَلَيَّ بِكَرَمِكَ وَفَضلِكَ،"
  },
  {
   "segment_id": 16,
   "arabic": "وَاحْطُطْ خَطَايَايَ بِحِلْمِكَ وَعَفْوِكَ،"
  },
  {
   "segment_id": 17,
   "arabic": "وَتَغَمَّدْنِي فِي هذِهِ اللَّيْلَةِ بِسَابِغِ كَرَامَتِكَ،"
  },
  {
   "segment_id": 18,
   "arabic": "وَاجْعَلْنِي فِيهَا مِنْ أَوْلِيَائِكَ الَّذِينَ اجْتَبَيْتَهُمْ لِطَاعَتِكَ،"
  },
  {
   "segment_id": 19,
   "arabic": "وَاخْتَرْتَهُمْ لِعِبَادَتِكَ،"
  },
  {
   "segment_id": 20,
   "arabic": "وَجَعَلْتَهُمْ خَالِصَتَكَ وَصِفْوَتَكَ."
  },
  {
   "segment_id": 21,
   "arabic": "اللّهُمَّ اجْعَلْنِي مِمَّنْ سَعَدَ جَدُّهُ،"
  },
  {
   "segment_id": 22,
   "arabic": "وَتَوَفَّرَ مِنَ الْخَيْرَاتِ حَظُّهُ،"
  },
  {
   "segment_id": 23,
   "arabic": "وَاجْعَلْنِي مِمَّنْ سَلِمَ فَنَعِمَ،"
  },
  {
   "segment_id": 24,
   "arabic": "وَفَازَ فَغَنِمَ،"
  },
  {
   "segment_id": 25,
   "arabic": "وَاكْفِنِي شَرَّ مَا أَسْلَفْتُ،"
  },
  {
   "segment_id": 26,
   "arabic": "وَاعْصِمْنِي مِنَ الإزْدِيَادِ فِي مَعْصِيَتِكَ،"
  },
  {
   "segment_id": 27,
   "arabic": "وَحَبِّبْ إلَيَّ طَاعَتَكَ وَمَا يُقَرِّبُنِي مِنْكَ وَيُزْلِفُنِي عِنْدَكَ."
  },
  {
   "segment_id": 28,
   "arabic": "سَيِّدِي إلَيْكَ يَلْجَأُ الْهَارِبُ،"
  },
  {
   "segment_id": 29,
   "arabic": "وَمِنْكَ يَلْتَمِسُ الطَّالِبُ،"
  },
  {
   "segment_id": 30,
   "arabic": "وَعَلَى كَرَمِكَ يُعَوِّلُ الْمُسْتَقِيلُ التَّائِبُ،"
  },
  {
   "segment_id": 31,
   "arabic": "أَدَّبْتَ عِبَادَكَ بِالتَّكَرُّمِ وَأَنْتَ أَكْرَمُ الأَكْرَمِينَ،"
  },
  {
   "segment_id": 32,
   "arabic": "وَأَمَرْتَ بِالْعَفْوِ عِبَادَكَ وَأَنْتَ الْغَفُورُ الرَّحِيمُ."
  },
  {
   "segment_id": 33,
   "arabic": "اللّهُمَّ فَلا تَحْرِمْنِي مَا رَجَوْتُ مِنْ كَرَمِكَ،"
  },
  {
   "segment_id": 34,
   "arabic": "وَلا تُؤْيِسْنِي مِنْ سَابِغِ نِعَمِكَ،"
  },
  {
   "segment_id": 35,
   "arabic": "وَلا تُخَيِّبْنِي مِنْ جَزِيلِ قِسَمِكَ فِي هذِهِ اللَّيْلَةِ لأهْلِ طَاعَتِكَ،"
  },
  {
   "segment_id": 36,
   "arabic": "وَاجْعَلْنِي فِي جُنَّةٍ مِنْ شِرَارِ بَرِيَّتِكَ،"
  },
  {
   "segment_id": 37,
   "arabic": "رَبِّ إنْ لَمْ أَكُنْ مِنْ أَهْلِ ذلِكَ فَأَنْتَ أَهْلُ الْكَرَمِ وَالْعَفْوِ وَالْمَغْفِرَةِ،"
  },
  {
   "segment_id": 38,
   "arabic": "وَجُدْ عَلَيَّ بِمَا أَنْتَ أَهْلُهُ لا بِمَا أَسْتَحِقُّهُ،"
  },
  {
   "segment_id": 39,
   "arabic": "فَقَدْ حَسُنَ ظَنِّي بِكَ،"
  },
  {
   "segment_id": 40,
   "arabic": "وَتَحَقَّقَ رَجَائِي لَكَ،"
  },
  {
   "segment_id": 41,
   "arabic": "وَعَلِقَتْ نَفْسِي بِكَرَمِكَ"
  },
  {
   "segment_id": 42,
   "arabic": "فَأَنْتَ أَرْحَمُ الرَّاحِمِينَ،"
  },
  {
   "segment_id": 43,
   "arabic": "وَأَكْرَمُ الأَكْرَمِينَ."
  },
  {
   "segment_id": 44,
   "arabic": "اللّهُمَّ وَاخْصُصْنِي مِنْ كَرَمِكَ بِجَزِيلِ قِسَمِكَ،"
  },
  {
   "segment_id": 45,
   "arabic": "وَأَعُوذُ بِعَفْوِكَ مِنْ عُقُوبَتِكَ،"
  },
  {
   "segment_id": 46,
   "arabic": "وَاغْفِرْ لِيَ الذَّنْبَ الَّذِي يَحْبِسُ عَلَيَّ الْخُلُقَ،"
  },
  {
   "segment_id": 47,
   "arabic": "وَيُضَيِّقُ عَلَيَّ الرّزْقَ"
  },
  {
   "segment_id": 48,
   "arabic": "حَتَّى أَقُومَ بِصَالِحِ رِضَاكَ،"
  },
  {
   "segment_id": 49,
   "arabic": "وَأَنْعَمَ بِجَزِيلِ عَطَائِكَ،"
  },
  {
   "segment_id": 50,
   "arabic": "وَأَسْعَدَ بِسَابِغِ نَعْمَائِكَ،"
  },
  {
   "segment_id": 51,
   "arabic": "فَقَدْ لُذْتُ بِحَرَمِكَ،"
  },
  {
   "segment_id": 52,
   "arabic": "وَتَعَرَّضْتُ لِكَرَمِكَ،"
  },
  {
   "segment_id": 53,
   "arabic": "وَاسْتَعَذْتُ بِعَفْوِكَ مِنْ عُقُوبَتِكَ،"
  },
  {
   "segment_id": 54,
   "arabic": "وَبِحِلْمِكَ مِنْ غَضَبِكَ،"
  },
  {
   "segment_id": 55,
   "arabic": "فَجُدْ بِمَا سَأَلْتُكَ،"
  },
  {
   "segment_id": 56,
   "arabic": "وَأَنِلْ مَا الْتَمَسْتُ مِنْكَ،"
  },
  {
   "segment_id": 57,
   "arabic": "أَسْأَلُكَ بِكَ لا بِشَيْءٍ هُوَ أَعْظَمُ مِنْكَ."
  },
  {
   "segment_id": 58,
   "arabic": "You may prostrate yourself and repeat the following twenty times:"
  },
  {
   "segment_id": 59,
   "arabic": "يَا رَبِّ."
  },
  {
   "segment_id": 60,
   "arabic": "And then repeat the following seven times:"
  },
  {
   "segment_id": 61,
   "arabic": "يَا اَللهُ."
  },
  {
   "segment_id": 62,
   "arabic": "لا حَوْلَ وَلا قُوَّةَ إلاَّ بِاللّهِ."
  },
  {
   "segment_id": 63,
   "arabic": "And then repeat the following ten times"
  },
  {
   "segment_id": 64,
   "arabic": "مَا شَاءَ اللهٌُ."
  },
  {
   "segment_id": 65,
   "arabic": "لا قُوَّةَ إلاَّ بِاللّهِ."
  }
 ]
}