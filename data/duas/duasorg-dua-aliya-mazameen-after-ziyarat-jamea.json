{
 "dua_id": "duasorg-dua-aliya-mazameen-after-ziyarat-jamea",
 "dua_name_en": "Dua Aaliya Madhaameen",
 "dua_name_ar": "",
 "source": "https://www.duas.org/dua-aliya-mazameen-after-ziyarat-jamea.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللَّهُمَّ إِنِّي زُرْتُ هَذَا الْإِمَامَ"
  },
  {
   "segment_id": 2,
   "arabic": "مُقِرّاً بِإِمَامَتِهِ"
  },
  {
   "segment_id": 3,
   "arabic": "مُعْتَقِداً لِفَرْضِ طَاعَتِهِ‏"
  },
  {
   "segment_id": 4,
   "arabic": "فَقَصَدْتُ مَشْهَدَهُ بِذُنُوبِي وَ عُيُوبِي"
  },
  {
   "segment_id": 5,
   "arabic": "وَ مُوبِقَاتِ آثَامِي"
  },
  {
   "segment_id": 6,
   "arabic": "وَ كَثْرَةِ سَيِّئَاتِي وَ خَطَايَايَ"
  },
  {
   "segment_id": 7,
   "arabic": "وَ مَا تَعْرِفُهُ مِنِّي‏"
  },
  {
   "segment_id": 8,
   "arabic": "مُسْتَجِيراً بِعَفْوِكَ"
  },
  {
   "segment_id": 9,
   "arabic": "مُسْتَعِيذاً بِحِلْمِكَ"
  },
  {
   "segment_id": 10,
   "arabic": "رَاجِياً رَحْمَتَكَ"
  },
  {
   "segment_id": 11,
   "arabic": "لاَجِئاً إِلَى رُكْنِكَ"
  },
  {
   "segment_id": 12,
   "arabic": "عَائِذاً بِرَأْفَتِكَ‏"
  },
  {
   "segment_id": 13,
   "arabic": "مُسْتَشْفِعاً بِوَلِيِّكَ وَ ابْنِ أَوْلِيَائِكَ"
  },
  {
   "segment_id": 14,
   "arabic": "وَ صَفِيِّكَ وَ ابْنِ أَصْفِيَائِكَ"
  },
  {
   "segment_id": 15,
   "arabic": "وَ أَمِينِكَ وَ ابْنِ أُمَنَائِكَ‏"
  },
  {
   "segment_id": 16,
   "arabic": "وَ خَلِيفَتِكَ وَ ابْنِ خُلَفَائِكَ"
  },
  {
   "segment_id": 17,
   "arabic": "الَّذِينَ جَعَلْتَهُمُ الْوَسِيلَةَ إِلَى رَحْمَتِكَ وَ رِضْوَانِكَ"
  },
  {
   "segment_id": 18,
   "arabic": "وَ الذَّرِيعَةَ إِلَى رَأْفَتِكَ وَ غُفْرَانِكَ‏"
  },
  {
   "segment_id": 19,
   "arabic": "اللَّهُمَّ وَ أَوَّلُ حَاجَتِي إِلَيْكَ"
  },
  {
   "segment_id": 20,
   "arabic": "أَنْ تَغْفِرَ لِي مَا سَلَفَ مِنْ ذُنُوبِي عَلَى كَثْرَتِهَا"
  },
  {
   "segment_id": 21,
   "arabic": "وَ أَنْ تَعْصِمَنِي فِيمَا بَقِيَ مِنْ عُمْرِي"
  },
  {
   "segment_id": 22,
   "arabic": "وَ تُطَهِّرَ دِينِي مِمَّا يُدَنِّسُهُ"
  },
  {
   "segment_id": 23,
   "arabic": "وَ يَشِينُهُ وَ يُزْرِي بِهِ‏"
  },
  {
   "segment_id": 24,
   "arabic": "وَ تَحْمِيَهُ مِنَ الرَّيْبِ وَ الشَّكِّ"
  },
  {
   "segment_id": 25,
   "arabic": "وَ الْفَسَادِ وَ الشِّرْكِ‏"
  },
  {
   "segment_id": 26,
   "arabic": "وَ تُثَبِّتَنِي عَلَى طَاعَتِكَ"
  },
  {
   "segment_id": 27,
   "arabic": "وَ طَاعَةِ رَسُولِكَ"
  },
  {
   "segment_id": 28,
   "arabic": "وَ ذُرِّيَّتِهِ النُّجَبَاءِ السُّعَدَاءِ"
  },
  {
   "segment_id": 29,
   "arabic": "صَلَوَاتُكَ عَلَيْهِمْ"
  },
  {
   "segment_id": 30,
   "arabic": "وَ رَحْمَتُكَ وَ سَلاَمُكَ وَ بَرَكَاتُكَ‏"
  },
  {
   "segment_id": 31,
   "arabic": "وَ تُحْيِيَنِي مَا أَحْيَيْتَنِي عَلَى طَاعَتِهِمْ"
  },
  {
   "segment_id": 32,
   "arabic": "وَ تُمِيتَنِي إِذَا أَمَتَّنِي عَلَى طَاعَتِهِمْ‏"
  },
  {
   "segment_id": 33,
   "arabic": "وَ أَنْ لاَ تَمْحُوَ مِنْ قَلْبِي مَوَدَّتَهُمْ وَ مَحَبَّتَهُمْ"
  },
  {
   "segment_id": 34,
   "arabic": "وَ بُغْضَ أَعْدَائِهِمْ"
  },
  {
   "segment_id": 35,
   "arabic": "وَ مُرَافَقَةَ أَوْلِيَائِهِمْ وَ بِرَّهُمْ‏"
  },
  {
   "segment_id": 36,
   "arabic": "وَ أَسْأَلُكَ يَا رَبِّ أَنْ تَقْبَلَ ذَلِكَ مِنِّي"
  },
  {
   "segment_id": 37,
   "arabic": "وَ تُحَبِّبَ إِلَيَّ عِبَادَتَكَ"
  },
  {
   "segment_id": 38,
   "arabic": "وَ الْمُوَاظَبَةَ عَلَيْهَا"
  },
  {
   "segment_id": 39,
   "arabic": "وَ تُنَشِّطَنِي لَهَا"
  },
  {
   "segment_id": 40,
   "arabic": "وَ تُبَغِّضَ إِلَيَّ مَعَاصِيَكَ وَ مَحَارِمَكَ"
  },
  {
   "segment_id": 41,
   "arabic": "وَ تَدْفَعَنِي عَنْهَا"
  },
  {
   "segment_id": 42,
   "arabic": "وَ تُجَنِّبَنِي التَّقْصِيرَ فِي صَلَوَاتِي"
  },
  {
   "segment_id": 43,
   "arabic": "وَ الاِسْتِهَانَةَ بِهَا"
  },
  {
   "segment_id": 44,
   "arabic": "وَ التَّرَاخِيَ عَنْهَا"
  },
  {
   "segment_id": 45,
   "arabic": "وَ تُوَفِّقَنِي Lِتَأْدِيَتِهَا كَمَا فَرَضْتَ‏ وَ أَمَرْتَ بِهِ"
  },
  {
   "segment_id": 46,
   "arabic": "عَلَى سُنَّةِ رَسُولِكَ"
  },
  {
   "segment_id": 47,
   "arabic": "صَلَوَاتُكَ عَلَيْهِ وَ آلِهِ"
  },
  {
   "segment_id": 48,
   "arabic": "وَ رَحْمَتُكَ وَ بَرَكَاتُكَ"
  },
  {
   "segment_id": 49,
   "arabic": "خُضُوعاً وَ خُشُوعاً"
  },
  {
   "segment_id": 50,
   "arabic": "وَ تَشْرَحَ صَدْرِي لإِيتَاءِ الزَّكَاةِ"
  },
  {
   "segment_id": 51,
   "arabic": "وَ إِعْطَاءِ الصَّدَقَاتِ"
  },
  {
   "segment_id": 52,
   "arabic": "وَ بَذْلِ الْمَعْرُوفِ‏"
  },
  {
   "segment_id": 53,
   "arabic": "وَ الْإِحْسَانِ إِلَى شِيعَةِ آلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 54,
   "arabic": "عَلَيْهِمُ السَّلاَمُ وَ مُوَاسَاتِهِمْ‏"
  },
  {
   "segment_id": 55,
   "arabic": "وَ لاَ تَتَوَفَّانِي إِلاَّ بَعْدَ أَنْ تَرْزُقَنِي حِجَّ بَيْتِكَ الْحَرَامِ"
  },
  {
   "segment_id": 56,
   "arabic": "وَ زِيَارَةَ قَبْرِ نَبِيِّكَ"
  },
  {
   "segment_id": 57,
   "arabic": "وَ قُبُورِ الْأَئِمَّةِ عَلَيْهِمُ السَّلاَمُ‏"
  },
  {
   "segment_id": 58,
   "arabic": "وَ أَسْأَلُكَ يَا رَبِّ تَوْبَةً نَصُوحاً تَرْضَاهَا"
  },
  {
   "segment_id": 59,
   "arabic": "وَ نِيَّةً تَحْمَدُهَا"
  },
  {
   "segment_id": 60,
   "arabic": "وَ عَمَلاً صَالِحاً تَقْبَلُهُ‏"
  },
  {
   "segment_id": 61,
   "arabic": "وَ أَنْ تَغْفِرَ لِي وَ تَرْحَمَنِي إِذَا تَوَفَّيْتَنِي"
  },
  {
   "segment_id": 62,
   "arabic": "وَ تُهَوِّنَ عَلَيَّ سَكَرَاتِ الْمَوْتِ‏"
  },
  {
   "segment_id": 63,
   "arabic": "وَ تَحْشُرَنِي فِي زُمْرَةِ مُحَمَّدٍ وَ آلِهِ"
  },
  {
   "segment_id": 64,
   "arabic": "صَلَوَاتُ اللَّهِ عَلَيْهِ وَ عَلَيْهِمْ"
  },
  {
   "segment_id": 65,
   "arabic": "وَ تُدْخِلَنِي الْجَنَّةَ بِرَحْمَتِكَ‏"
  },
  {
   "segment_id": 66,
   "arabic": "وَ تَجْعَلَ دَمْعِي غَزِيراً فِي طَاعَتِكَ"
  },
  {
   "segment_id": 67,
   "arabic": "وَ عَبْرَتِي جَارِيَةً فِيمَا يُقَرِّبُنِي مِنْكَ"
  },
  {
   "segment_id": 68,
   "arabic": "وَ قَلْبِي عَطُوفاً عَلَى أَوْلِيَائكَ‏"
  },
  {
   "segment_id": 69,
   "arabic": "وَ تَصُونَنِي فِي هَذِهِ الدُّنْيَا"
  },
  {
   "segment_id": 70,
   "arabic": "مِنَ الْعَاهَاتِ وَ الْآفَاتِ"
  },
  {
   "segment_id": 71,
   "arabic": "وَ الْأَمْرَاضِ الشَّدِيدَةِ"
  },
  {
   "segment_id": 72,
   "arabic": "وَ الْأَسْقَامِ الْمُزْمِنَةِ"
  },
  {
   "segment_id": 73,
   "arabic": "وَ جَمِيعِ أَنْوَاعِ الْبَلاَءِ وَ الْحَوَادِثِ"
  },
  {
   "segment_id": 74,
   "arabic": "وَ تَصْرِفَ قَلْبِي عَنِ الْحَرَامِ‏"
  },
  {
   "segment_id": 75,
   "arabic": "وَ تُبَغِّضَ إِلَيَّ مَعَاصِيَكَ"
  },
  {
   "segment_id": 76,
   "arabic": "وَ تُحَبِّبَ إِلَيَّ الْحَلاَلَ"
  },
  {
   "segment_id": 77,
   "arabic": "وَ تَفْتَحَ لِي أَبْوَابَهُ‏"
  },
  {
   "segment_id": 78,
   "arabic": "وَ تُثَبِّتَ نِيَّتِي وَ فِعْلِي عَلَيْهِ"
  },
  {
   "segment_id": 79,
   "arabic": "وَ تَمُدَّ فِي عُمْرِي"
  },
  {
   "segment_id": 80,
   "arabic": "وَ تُغْلِقَ أَبْوَابَ الْمِحَنِ عَنِّي‏"
  },
  {
   "segment_id": 81,
   "arabic": "وَ لاَ تَسْلُبَنِي مَا مَنَنْتَ بِهِ عَلَيَّ"
  },
  {
   "segment_id": 82,
   "arabic": "وَ لاَ تَسْتَرِدَّ شَيْئًا مِمَّا أَحْسَنْتَ بِهِ إِلَيَ‏"
  },
  {
   "segment_id": 83,
   "arabic": "وَ لاَ تَنْزِعَ مِنِّي النِّعَمَ الَّتِي أَنْعَمْتَ بِهَا عَلَيَّ"
  },
  {
   "segment_id": 84,
   "arabic": "وَ تَزِيدَ فِيمَا خَوَّلْتَنِي"
  },
  {
   "segment_id": 85,
   "arabic": "وَ تُضَاعِفَهُ أَضْعَافاً مُضَاعَفَةً"
  },
  {
   "segment_id": 86,
   "arabic": "وَ تَرْزُقَنِي مَالاً كَثِيراً"
  },
  {
   "segment_id": 87,
   "arabic": "وَاسِعاً سَائِغاً"
  },
  {
   "segment_id": 88,
   "arabic": "هَنِيئاً نَامِياً وَافِياً"
  },
  {
   "segment_id": 89,
   "arabic": "وَ عِزّاً بَاقِياً كَافِياً"
  },
  {
   "segment_id": 90,
   "arabic": "وَ جَاهاً عَرِيضاً مَنِيعاً"
  },
  {
   "segment_id": 91,
   "arabic": "وَ نِعْمَةً سَابِغَةً عَامَّةً"
  },
  {
   "segment_id": 92,
   "arabic": "وَ تُغْنِيَنِي بِذَلِكَ عَنِ الْمَطَالِبِ الْمُنَكَّدَةِ"
  },
  {
   "segment_id": 93,
   "arabic": "وَ الْمَوَارِدِ الصَّعْبَةِ"
  },
  {
   "segment_id": 94,
   "arabic": "وَ تُخَلِّصَنِي مِنْهَا مُعَافًى"
  },
  {
   "segment_id": 95,
   "arabic": "فِي دِينِي وَ نَفْسِي وَ وَلَدِي"
  },
  {
   "segment_id": 96,
   "arabic": "وَ مَا أَعْطَيْتَنِي وَ مَنَحْتَنِي‏"
  },
  {
   "segment_id": 97,
   "arabic": "وَ تَحْفَظَ عَلَيَّ مَالِي"
  },
  {
   "segment_id": 98,
   "arabic": "وَ جَمِيعَ مَا خَوَّلْتَنِي"
  },
  {
   "segment_id": 99,
   "arabic": "وَ تَقْبِضَ عَنِّي أَيْدِيَ الْجَبَابِرَةِ"
  },
  {
   "segment_id": 100,
   "arabic": "وَ تَرُدَّنِي إِلَى وَطَنِي‏"
  },
  {
   "segment_id": 101,
   "arabic": "وَ تُبَلِّغَنِي نِهَايَةَ أَمَلِي فِي دُنْيَايَ وَ آخِرَتِي"
  },
  {
   "segment_id": 102,
   "arabic": "وَ تَجْعَلَ عَاقِبَةَ أَمْرِي مَحْمُودَةً حَسَنَةً سَلِيمَةً"
  },
  {
   "segment_id": 103,
   "arabic": "وَ تَجْعَلَنِي رَحِيبَ الصَّدْرِ"
  },
  {
   "segment_id": 104,
   "arabic": "وَاسِعَ الْحَالِ"
  },
  {
   "segment_id": 105,
   "arabic": "حَسَنَ الْخُلُقِ‏"
  },
  {
   "segment_id": 106,
   "arabic": "بَعِيداً مِنَ الْبُخْلِ وَ الْمَنْعِ"
  },
  {
   "segment_id": 107,
   "arabic": "وَ النِّفَاقِ وَ الْكِذْبِ"
  },
  {
   "segment_id": 108,
   "arabic": "وَ الْبَهْتِ وَ قَوْلِ الزُّورِ"
  },
  {
   "segment_id": 109,
   "arabic": "وَ تُرْسِخَ فِي قَلْبِي مَحَبَّةَ مُحَمَّدٍ وَ آلِ مُحَمَّدٍ وَ شِيعَتِهِمْ‏"
  },
  {
   "segment_id": 110,
   "arabic": "وَ تَحْرُسَنِي يَا رَبِّ فِي نَفْسِي وَ أَهْلِي"
  },
  {
   "segment_id": 111,
   "arabic": "وَ مَالِي وَ وَلَدِي"
  },
  {
   "segment_id": 112,
   "arabic": "وَ أَهْلِ حُزَانَتِي وَ إِخْوَانِي"
  },
  {
   "segment_id": 113,
   "arabic": "وَ أَهْلِ مَوَدَّتِي وَ ذُرِّيَّتِي"
  },
  {
   "segment_id": 114,
   "arabic": "بِرَحْمَتِكَ وَ جُودِكَ‏"
  },
  {
   "segment_id": 115,
   "arabic": "اللَّهُمَّ هَذِهِ حَاجَاتِي عِنْدَكَ"
  },
  {
   "segment_id": 116,
   "arabic": "وَ قَدِ اسْتَكْثَرْتُهَا لِلُؤْمِي وَ شُحِّي"
  },
  {
   "segment_id": 117,
   "arabic": "وَ هِيَ عِنْدَكَ صَغِيرَةٌ حَقِيرَةٌ"
  },
  {
   "segment_id": 118,
   "arabic": "وَ عَلَيْكَ سَهْلَةٌ يَسِيرَةٌ"
  },
  {
   "segment_id": 119,
   "arabic": "فَأَسْأَلُكَ بِجَاهِ مُحَمَّدٍ وَ آلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 120,
   "arabic": "عَلَيْهِ وَ عَلَيْهِمُ السَّلاَمُ عِنْدَكَ"
  },
  {
   "segment_id": 121,
   "arabic": "وَ بِحَقِّهِمْ عَلَيْكَ‏"
  },
  {
   "segment_id": 122,
   "arabic": "وَ بِمَا أَوْجَبْتَ لَهُمْ"
  },
  {
   "segment_id": 123,
   "arabic": "وَ بِسَائِرِ أَنْبِيَائِكَ وَ رُسُلِكَ"
  },
  {
   "segment_id": 124,
   "arabic": "وَ أَصْفِيَائِكَ وَ أَوْلِيَائِكَ"
  },
  {
   "segment_id": 125,
   "arabic": "الْمُخْلَصِينَ مِنْ عِبَادِكَ‏"
  },
  {
   "segment_id": 126,
   "arabic": "وَ بِاسْمِكَ الْأَعْظَمِ الْأَعْظَمِ"
  },
  {
   "segment_id": 127,
   "arabic": "لَمَّا قَضَيْتَهَا كُلَّهَا"
  },
  {
   "segment_id": 128,
   "arabic": "وَ أَسْعَفْتَنِي بِهَا"
  },
  {
   "segment_id": 129,
   "arabic": "وَ لَمْ تُخَيِّبْ أَمَلِي وَ رَجَائِي‏"
  },
  {
   "segment_id": 130,
   "arabic": "اللَّهُمَّ وَ شَفِّعْ صَاحِبَ هَذَا الْقَبْرِ فِيَ‏"
  },
  {
   "segment_id": 131,
   "arabic": "يَا سَيِّدِي يَا وَلِيَّ اللَّهِ يَا أَمِينَ اللَّهِ"
  },
  {
   "segment_id": 132,
   "arabic": "أَسْأَلُكَ أَنْ تَشْفَعَ لِي إِلَى اللَّهِ عَزَّ وَ جَلَّ"
  },
  {
   "segment_id": 133,
   "arabic": "فِي هَذِهِ الْحَاجَاتِ كُلِّهَا"
  },
  {
   "segment_id": 134,
   "arabic": "بِحَقِّ آبَائِكَ الطَّاهِرِينَ"
  },
  {
   "segment_id": 135,
   "arabic": "وَ بِحَقِّ أَوْلاَدِكَ الْمُنْتَجَبِينَ‏"
  },
  {
   "segment_id": 136,
   "arabic": "فَإِنَّ لَكَ عِنْدَ اللَّهِ تَقَدَّسَتْ أَسْمَاؤُهُ"
  },
  {
   "segment_id": 137,
   "arabic": "الْمَنْزِلَةَ الشَّرِيفَةَ"
  },
  {
   "segment_id": 138,
   "arabic": "وَ الْمَرْتَبَةَ الْجَلِيلَةَ"
  },
  {
   "segment_id": 139,
   "arabic": "وَ الْجَاهَ الْعَرِيضَ‏"
  },
  {
   "segment_id": 140,
   "arabic": "اللَّهُمَّ لَوْ عَرَفْتُ مَنْ هُوَ أَوْجَهُ عِنْدَكَ"
  },
  {
   "segment_id": 141,
   "arabic": "مِنْ هَذَا الْإِمَامِ"
  },
  {
   "segment_id": 142,
   "arabic": "وَ مِنْ آبَائِهِ وَ أَبْنَائِهِ الطَّاهِرِينَ"
  },
  {
   "segment_id": 143,
   "arabic": "عَلَيْهِمُ السَّلاَمُ وَ الصَّلاَةُ"
  },
  {
   "segment_id": 144,
   "arabic": "لَجَعَلْتُهُمْ شُفَعَائِي"
  },
  {
   "segment_id": 145,
   "arabic": "وَ قَدَّمْتُهُمْ أَمَامَ حَاجَتِي وَ طَلِبَاتِي هَذِهِ‏"
  },
  {
   "segment_id": 146,
   "arabic": "فَاسْمَعْ مِنِّي"
  },
  {
   "segment_id": 147,
   "arabic": "وَ اسْتَجِبْ لِي"
  },
  {
   "segment_id": 148,
   "arabic": "وَ افْعَلْ بِي مَا أَنْتَ أَهْلُهُ"
  },
  {
   "segment_id": 149,
   "arabic": "يَا أَرْحَمَ الرَّاحِمِينَ‏"
  },
  {
   "segment_id": 150,
   "arabic": "اللَّهُمَّ وَ مَا قَصُرَتْ عَنْهُ مَسْأَلَتِي"
  },
  {
   "segment_id": 151,
   "arabic": "وَ عَجَزَتْ عَنْهُ قُوَّتِي"
  },
  {
   "segment_id": 152,
   "arabic": "وَ لَمْ تَبْلُغْهُ فِطْنَتِي"
  },
  {
   "segment_id": 153,
   "arabic": "مِنْ صَالِحِ دِينِي وَ دُنْيَايَ وَ آخِرَتِي‏"
  },
  {
   "segment_id": 154,
   "arabic": "فَامْنُنْ بِهِ عَلَيَّ"
  },
  {
   "segment_id": 155,
   "arabic": "وَ احْفَظْنِي وَ احْرُسْنِي"
  },
  {
   "segment_id": 156,
   "arabic": "وَ هَبْ لِي وَ اغْفِرْ لِي"
  },
  {
   "segment_id": 157,
   "arabic": "وَ مَنْ أَرَادَنِي بِسُوءٍ أَوْ مَكْرُوهٍ"
  },
  {
   "segment_id": 158,
   "arabic": "مِنْ شَيْطَانٍ مَرِيدٍ"
  },
  {
   "segment_id": 159,
   "arabic": "أَوْ سُلْطَانٍ عَنِيدٍ"
  },
  {
   "segment_id": 160,
   "arabic": "أَوْ مُخَالِفٍ فِي دِينٍ"
  },
  {
   "segment_id": 161,
   "arabic": "أَوْ مُنَازِعٍ فِي دُنْيَا"
  },
  {
   "segment_id": 162,
   "arabic": "أَوْ حَاسِدٍ عَلَيَّ نِعْمَةً"
  },
  {
   "segment_id": 163,
   "arabic": "أَوْ ظَالِمٍ أَوْ بَاغٍ‏"
  },
  {
   "segment_id": 164,
   "arabic": "فَاقْبِضْ عَنِّي يَدَهُ"
  },
  {
   "segment_id": 165,
   "arabic": "وَ اصْرِفْ عَنِّي كَيْدَهُ"
  },
  {
   "segment_id": 166,
   "arabic": "وَ اشْغَلْهُ (عَنِّي) بِنَفْسِهِ"
  },
  {
   "segment_id": 167,
   "arabic": "وَ اكْفِنِي شَرَّهُ"
  },
  {
   "segment_id": 168,
   "arabic": "وَ شَرَّ أَتْبَاعِهِ وَ شَيَاطِينِهِ‏"
  },
  {
   "segment_id": 169,
   "arabic": "وَ أَجِرْنِي مِنْ كُلِّ مَا يَضُرُّنِي وَ يُجْحِفُ بِي"
  },
  {
   "segment_id": 170,
   "arabic": "وَ أَعْطِنِي جَمِيعَ الْخَيْرِ كُلِّهِ (كُلَّهُ)"
  },
  {
   "segment_id": 171,
   "arabic": "مِمَّا أَعْلَمُ وَ مِمَّا لاَ أَعْلَمُ‏"
  },
  {
   "segment_id": 172,
   "arabic": "اللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَ آلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 173,
   "arabic": "وَ اغْفِرْ لِي وَ لِوَالِدَيَّ"
  },
  {
   "segment_id": 174,
   "arabic": "وَ لِإِخْوَانِي وَ أَخَوَاتِي‏"
  },
  {
   "segment_id": 175,
   "arabic": "وَ أَعْمَامِي وَ عَمَّاتِي"
  },
  {
   "segment_id": 176,
   "arabic": "وَ أَخْوَالِي وَ خَالاَتِي"
  },
  {
   "segment_id": 177,
   "arabic": "وَ أَجْدَادِي وَ جَدَّاتِي"
  },
  {
   "segment_id": 178,
   "arabic": "وَ أَوْلاَدِهِمْ وَ ذَرَارِيهِمْ‏"
  },
  {
   "segment_id": 179,
   "arabic": "وَ أَزْوَاجِي وَ ذُرِّيَاتِي"
  },
  {
   "segment_id": 180,
   "arabic": "وَ أَقْرِبَائِي وَ أَصْدِقَائِي"
  },
  {
   "segment_id": 181,
   "arabic": "وَ جِيرَانِي وَ إِخْوَانِي فِيكَ"
  },
  {
   "segment_id": 182,
   "arabic": "مِنْ أَهْلِ الشَّرْقِ وَ الْغَرْبِ‏"
  },
  {
   "segment_id": 183,
   "arabic": "وَ لِجَمِيعِ أَهْلِ مَوَدَّتِي"
  },
  {
   "segment_id": 184,
   "arabic": "مِنَ الْمُؤْمِنِينَ وَ الْمُؤْمِنَاتِ"
  },
  {
   "segment_id": 185,
   "arabic": "الْأَحْيَاءِ مِنْهُمْ وَ الْأَمْوَاتِ‏"
  },
  {
   "segment_id": 186,
   "arabic": "وَ لِجَمِيعِ مَنْ عَلَّمَنِي خَيْراً"
  },
  {
   "segment_id": 187,
   "arabic": "أَوْ تَعَلَّمَ مِنِّي عِلْماً"
  },
  {
   "segment_id": 188,
   "arabic": "اللَّهُمَّ أَشْرِكْهُمْ فِي صَالِحِ دُعَائِي"
  },
  {
   "segment_id": 189,
   "arabic": "وَ زِيَارَتِي لِمَشْهَدِ حُجَّتِكَ وَ وَلِيِّكَ‏"
  },
  {
   "segment_id": 190,
   "arabic": "وَ أَشْرِكْنِي فِي صَالِحِ أَدْعِيَتِهِمْ"
  },
  {
   "segment_id": 191,
   "arabic": "بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِينَ‏"
  },
  {
   "segment_id": 192,
   "arabic": "وَ بَلِّغْ وَلِيَّكَ مِنْهُمُ السَّلاَمَ"
  },
  {
   "segment_id": 193,
   "arabic": "وَ السَّلاَمُ عَلَيْكَ وَ رَحْمَةُ اللَّهِ وَ بَرَكَاتُهُ"
  },
  {
   "segment_id": 194,
   "arabic": "يَا سَيِّدِي يَا مَوْلاَيَ يَا فُلاَنَ بْنَ فُلاَنٍ‏ (بجاى اين كلمه نام امامى را كه زيارت مى‏كند و نام پدر آن بزرگوار را بگويد)"
  },
  {
   "segment_id": 195,
   "arabic": "صَلَّى اللَّهُ عَلَيْكَ"
  },
  {
   "segment_id": 196,
   "arabic": "وَ عَلَى رُوحِكَ وَ بَدَنِكَ"
  },
  {
   "segment_id": 197,
   "arabic": "أَنْتَ وَسِيلَتِي إِلَى اللَّهِ"
  },
  {
   "segment_id": 198,
   "arabic": "وَ ذَرِيعَتِي إِلَيْهِ"
  },
  {
   "segment_id": 199,
   "arabic": "وَ لِي حَقُّ مُوَالاَتِي وَ تَأْمِيلِي‏"
  },
  {
   "segment_id": 200,
   "arabic": "فَكُنْ شَفِيعِي إِلَى اللَّهِ عَزَّ وَ جَلَّ"
  },
  {
   "segment_id": 201,
   "arabic": "فِي الْوُقُوفِ عَلَى قِصَّتِي هَذِهِ"
  },
  {
   "segment_id": 202,
   "arabic": "وَ صَرْفِي عَنْ مَوْقِفِي هَذَا بِالنُّجْحِ"
  },
  {
   "segment_id": 203,
   "arabic": "بِمَا سَأَلْتُهُ كُلِّهِ بِرَحْمَتِهِ وَ قُدْرَتِهِ‏"
  },
  {
   "segment_id": 204,
   "arabic": "اللَّهُمَّ ارْزُقْنِي عَقْلاً كَامِلاً"
  },
  {
   "segment_id": 205,
   "arabic": "وَ لُبّاً رَاجِحاً"
  },
  {
   "segment_id": 206,
   "arabic": "وَ عِزّاً بَاقِياً"
  },
  {
   "segment_id": 207,
   "arabic": "وَ قَلْباً زَكِيّاً"
  },
  {
   "segment_id": 208,
   "arabic": "وَ عَمَلاً كَثِيراً"
  },
  {
   "segment_id": 209,
   "arabic": "وَ أَدَباً بَارِعاً"
  },
  {
   "segment_id": 210,
   "arabic": "وَ اجْعَلْ ذَلِكَ كُلَّهُ لِي"
  },
  {
   "segment_id": 211,
   "arabic": "وَ لاَ تَجْعَلْهُ عَلَيَّ"
  },
  {
   "segment_id": 212,
   "arabic": "بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِينَ"
  }
 ]
}