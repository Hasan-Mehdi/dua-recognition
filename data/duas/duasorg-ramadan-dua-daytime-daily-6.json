{
 "dua_id": "duasorg-ramadan-dua-daytime-daily-6",
 "dua_name_en": "Allahumma Inni Asaluka Min Fadhlik",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-dua-daytime-daily.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللَّهُمَّ إِنِّي أَسْأَلُكَ مِنْ فَضْلِكَ بِأَفْضَلِهِ"
  },
  {
   "segment_id": 2,
   "arabic": "وَكُلُّ فَضْلِكَ فَاضِلٌ"
  },
  {
   "segment_id": 3,
   "arabic": "اللَّهُمَّ إِنِّي أَسْأَلُكَ بِفَضْلِكَ كُلِّهِ"
  },
  {
   "segment_id": 4,
   "arabic": "اللَّهُمَّ إِنِّي أَسْأَلُكَ مِنْ رِزْقِكَ بِأَعَمِّهِ"
  },
  {
   "segment_id": 5,
   "arabic": "وَكُلُّ رِزْقِكَ عَامٌّ"
  },
  {
   "segment_id": 6,
   "arabic": "اللَّهُمَّ إِنِّي أَسْأَلُكَ بِرِزْقِكَ كُلِّهِ"
  },
  {
   "segment_id": 7,
   "arabic": "اللَّهُمَّ إِنِّي أَسْأَلُكَ مِنْ عَطَائِكَ بِأَهْنَئِهِ"
  },
  {
   "segment_id": 8,
   "arabic": "وَكُلُّ عَطَائِكَ هَنِيءٌ"
  },
  {
   "segment_id": 9,
   "arabic": "اللَّهُمَّ إِنِّي أَسْأَلُكَ بِعَطَائِكَ كُلِّهِ"
  },
  {
   "segment_id": 10,
   "arabic": "اللَّهُمَّ إِنِّي أَسْأَلُكَ مِنْ خَيْرِكَ بِأَعْجَلِهِ"
  },
  {
   "segment_id": 11,
   "arabic": "وَكُلُّ خَيْرِكَ عَاجِلٌ"
  },
  {
   "segment_id": 12,
   "arabic": "اللَّهُمَّ إِنِّي أَسْأَلُكَ بِخَيْرِكَ كُلِّهِ"
  },
  {
   "segment_id": 13,
   "arabic": "اللَّهُمَّ إِنِّي أَسْأَلُكَ مِنْ إِحْسَانِكَ بِأَحْسَنِهِ"
  },
  {
   "segment_id": 14,
   "arabic": "وَكُلُّ إِحْسَانِكَ حَسَنٌ"
  },
  {
   "segment_id": 15,
   "arabic": "اللَّهُمَّ إِنِّي أَسْأَلُكَ بِإِحْسَانِكَ كُلِّهِ"
  },
  {
   "segment_id": 16,
   "arabic": "اللَّهُمَّ إِنِّي أَسْأَلُكَ بِمَا تُجِيبُنِي بِهِ حِينَ أَسْأَلُكَ"
  },
  {
   "segment_id": 17,
   "arabic": "فَأَجِبْنِي يَا اللَّهُ"
  },
  {
   "segment_id": 18,
   "arabic": "وَصَلِّ عَلَىٰ مُحَمَّدٍ عَبْدِكَ ٱلْمُرْتَضَىٰ"
  },
  {
   "segment_id": 19,
   "arabic": "وَرَسُولِكَ ٱلْمُصْطَفَىٰ"
  },
  {
   "segment_id": 20,
   "arabic": "وَأَمِينِكَ وَنَجِيِّكَ دُونَ خَلْقِكَ"
  },
  {
   "segment_id": 21,
   "arabic": "وَنَجِيبِكَ مِنْ عِبَادِكَ"
  },
  {
   "segment_id": 22,
   "arabic": "وَنَبِيِّكَ بِٱلصِّدْقِ وَحَبِيبِكَ"
  },
  {
   "segment_id": 23,
   "arabic": "وَصَلِّ عَلَىٰ رَسُولِكَ وَخِيَرَتِكَ مِنَ ٱلْعَالَمِينَ"
  },
  {
   "segment_id": 24,
   "arabic": "ٱلْبَشِيرِ ٱلنَّذِيرِ"
  },
  {
   "segment_id": 25,
   "arabic": "ٱلسِّرَاجِ ٱلْمُنِيرِ"
  },
  {
   "segment_id": 26,
   "arabic": "وَعَلَىٰ أَهْلِ بَيْتِهِ ٱلأَبْرَارِ ٱلطَّاهِرِينَ"
  },
  {
   "segment_id": 27,
   "arabic": "وَعَلَىٰ مَلائِكَتِكَ ٱلَّذِينَ ٱسْتَخْلَصْتَهُمْ لِنَفْسِكَ"
  },
  {
   "segment_id": 28,
   "arabic": "وَحَجَبْتَهُمْ عَنْ خَلْقِكَ"
  },
  {
   "segment_id": 29,
   "arabic": "وَعَلَىٰ أَنْبِيَائِكَ ٱلَّذِينَ يُنْبِئُونَ عَنْكَ بِٱلصِّدْقِ"
  },
  {
   "segment_id": 30,
   "arabic": "وَعَلَىٰ رُسُلِكَ ٱلَّذِينَ خَصَصْتَهُمْ بِوَحْيِكَ"
  },
  {
   "segment_id": 31,
   "arabic": "وَفَضَّلْتَهُمْ عَلَىٰ ٱلْعَالَمِينَ بِرِسَالاتِكَ"
  },
  {
   "segment_id": 32,
   "arabic": "وَعَلَىٰ عِبَادِكَ ٱلصَّالِحِينَ"
  },
  {
   "segment_id": 33,
   "arabic": "ٱلَّذِينَ أَدْخَلْتَهُمْ فِي رَحْمَتِكَ"
  },
  {
   "segment_id": 34,
   "arabic": "ٱلأَئِمَّةِ ٱلْمُهْتَدِينَ ٱلرَّاشِدِينَ وَأَوْلِيَائِكَ ٱلْمُطَهَّرِينَ"
  },
  {
   "segment_id": 35,
   "arabic": "وَعَلَىٰ جَبْرَائِيلَ وَمِيكَائِيلَ وَإِسْرَافِيلَ وَمَلَكِ ٱلْمَوْتِ"
  },
  {
   "segment_id": 36,
   "arabic": "وَعَلَىٰ رِضْوَانَ خَازِنِ ٱلْجِنَانِ"
  },
  {
   "segment_id": 37,
   "arabic": "وَعَلَىٰ مَالِكٍ خَازِنِ ٱلنَّارِ"
  },
  {
   "segment_id": 38,
   "arabic": "وَرُوحِ ٱلْقُدُسِ"
  },
  {
   "segment_id": 39,
   "arabic": "وَالرُّوحِ ٱلأَمِينِ"
  },
  {
   "segment_id": 40,
   "arabic": "وَحَمَلَةِ عَرْشِكَ ٱلْمُقَرَّبِينَ"
  },
  {
   "segment_id": 41,
   "arabic": "وَعَلَىٰ ٱلْمَلَكَيْنِ ٱلْحَافِظَيْنِ عَلَيَّ"
  },
  {
   "segment_id": 42,
   "arabic": "بِٱلصَّلاَةِ ٱلَّتِي تُحِبُّ أَنْ يُصَلِّيَ بِهَا عَلَيْهِمْ أَهْلُ ٱلسَّمَاوَاتِ وَأَهْلُ ٱلأَرَضِينَ"
  },
  {
   "segment_id": 43,
   "arabic": "صَلاةً طَيِّبَةً كَثِيرَةً"
  },
  {
   "segment_id": 44,
   "arabic": "مُبَارَكَةً زَاكِيَةً نَامِيَةً ظَاهِرَةً"
  },
  {
   "segment_id": 45,
   "arabic": "بَاطِنَةً شَرِيفَةً فَاضِلَةً"
  },
  {
   "segment_id": 46,
   "arabic": "تُبَيِّنُ بِهَا فَضْلَهُمْ عَلَىٰ ٱلأَوَّلِينَ وَٱلآخِرِينَ"
  },
  {
   "segment_id": 47,
   "arabic": "اللَّهُمَّ أَعْطِ مُحَمَّداً ٱلْوَسِيلَةَ وَٱلشَّرَفَ وَٱلْفَضِيلَةَ"
  },
  {
   "segment_id": 48,
   "arabic": "وَٱجْزِهِ خَيْرَ مَا جَزَيْتَ نَبِيّاً عَنْ أُمَّتِهِ"
  },
  {
   "segment_id": 49,
   "arabic": "اللَّهُمَّ وَأَعْطِ مُحَمَّداً صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ مَعَ كُلِّ زُلْفَةٍ زُلْفَةً"
  },
  {
   "segment_id": 50,
   "arabic": "وَمَعَ كُلِّ وَسِيلَةٍ وَسِيلَةً"
  },
  {
   "segment_id": 51,
   "arabic": "وَمَعَ كُلِّ فَضِيلَةٍ فَضِيلَةً"
  },
  {
   "segment_id": 52,
   "arabic": "وَمَعَ كُلِّ شَرَفٍ شَرَفاً"
  },
  {
   "segment_id": 53,
   "arabic": "تُعْطِي مُحَمَّداً وَآلَهُ يَوْمَ ٱلْقِيَامَةِ أَفْضَلَ مَا أَعْطَيْتَ أَحَداً مِنَ ٱلأَوَّلِينَ وَٱلآخِرِينَ"
  },
  {
   "segment_id": 54,
   "arabic": "اللَّهُمَّ وَٱجْعَلْ مُحَمَّداً صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ أَدْنَىٰ ٱلْمُرْسَلِينَ مِنْكَ مَجْلِساً"
  },
  {
   "segment_id": 55,
   "arabic": "وَأَفْسَحَهُمْ فِي ٱلْجَنَّةِ عِنْدَكَ مَنْزِلاً"
  },
  {
   "segment_id": 56,
   "arabic": "وَأَقْرَبَهُمْ إِلَيْكَ وَسِيلَةً"
  },
  {
   "segment_id": 57,
   "arabic": "وَٱجْعَلْهُ أَوَّلَ شَافِعٍ"
  },
  {
   "segment_id": 58,
   "arabic": "وَأَوَّلَ مُشَفَّعٍ"
  },
  {
   "segment_id": 59,
   "arabic": "وَأَوَّلَ قَائِلٍ"
  },
  {
   "segment_id": 60,
   "arabic": "وَأَنْجَحَ سَائِلٍ"
  },
  {
   "segment_id": 61,
   "arabic": "وَٱبْعَثْهُ ٱلْمَقَامَ ٱلْمَحْمُودَ ٱلَّذِي يَغْبِطُهُ بِهِ ٱلأَوَّلُونَ وَٱلآخِرُونَ"
  },
  {
   "segment_id": 62,
   "arabic": "يَا أَرْحَمَ ٱلرَّاحِمِينَ"
  },
  {
   "segment_id": 63,
   "arabic": "وَأَسْأَلُكَ أَنْ تُصَلِّيَ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 64,
   "arabic": "وَأَنْ تَسْمَعَ صَوْتِي"
  },
  {
   "segment_id": 65,
   "arabic": "وَتُجِيبَ دَعْوَتِي"
  },
  {
   "segment_id": 66,
   "arabic": "وَتَتَجَاوَزَ عَنْ خَطِيئَتِي"
  },
  {
   "segment_id": 67,
   "arabic": "وَتَصْفَحَ عَنْ ظُلْمِي"
  },
  {
   "segment_id": 68,
   "arabic": "وَتُنْجِحَ طَلِبَتِي"
  },
  {
   "segment_id": 69,
   "arabic": "وَتَقْضِيَ حَاجَتِي"
  },
  {
   "segment_id": 70,
   "arabic": "وَتُنْجِزَ لِي مَا وَعَدْتَنِي"
  },
  {
   "segment_id": 71,
   "arabic": "وَتُقِيلَ عَثْرَتِي"
  },
  {
   "segment_id": 72,
   "arabic": "وَتَغْفِرَ ذُنُوبِي"
  },
  {
   "segment_id": 73,
   "arabic": "وَتَعْفُوَ عَنْ جُرْمِي"
  },
  {
   "segment_id": 74,
   "arabic": "وَتُقْبِلَ عَلَيَّ وَلاَ تُعْرِضَ عَنِّي"
  },
  {
   "segment_id": 75,
   "arabic": "وَتَرْحَمَنِي وَلاَ تُعَذِّبَنِي"
  },
  {
   "segment_id": 76,
   "arabic": "وَتُعَافِيَنِي وَلاَ تَبْتَلِيَنِي"
  },
  {
   "segment_id": 77,
   "arabic": "وَتَرْزُقَنِي مِنَ ٱلرِّزْقِ أَطْيَبَهُ وَأَوْسَعَهُ وَلاَ تَحْرِمَنِي"
  },
  {
   "segment_id": 78,
   "arabic": "يَارَبِّ وَٱقْضِ عَنِّي دَيْنِي"
  },
  {
   "segment_id": 79,
   "arabic": "وَضَعْ عَنِّي وِزْرِي"
  },
  {
   "segment_id": 80,
   "arabic": "وَلاَ تُحَمِّلْنِي مَا لاَ طَاقَةَ لِي بِهِ"
  },
  {
   "segment_id": 81,
   "arabic": "يَا مَوْلاَيَ وَأَدْخِلْنِي فِي كُلِّ خَيْرٍ أَدْخَلْتَ فِيهِ مُحَمَّداً وَآلَ مُحَمَّدٍ"
  },
  {
   "segment_id": 82,
   "arabic": "وَأَخْرِجْنِي مِنْ كُلِّ سُوءٍ أَخْرَجْتَ مِنْهُ مُحَمَّداً وَآلَ مُحَمَّدٍ"
  },
  {
   "segment_id": 83,
   "arabic": "صَلَوَاتُكَ عَلَيْهِ وَعَلَيْهِمْ"
  },
  {
   "segment_id": 84,
   "arabic": "وَٱلسَّلاَمُ عَلَيْهِ وَعَلَيْهِمْ وَرَحْمَةُ ٱللَّهِ وَبَرَكَاتُهُ"
  },
  {
   "segment_id": 85,
   "arabic": "اللَّهُمَّ إِنِّي أَدْعُوكَ كَمَا أَمَرْتَنِي"
  },
  {
   "segment_id": 86,
   "arabic": "فَٱسْتَجِبْ لِي كَمَا وَعَدْتَنِي"
  },
  {
   "segment_id": 87,
   "arabic": "اللَّهُمَّ إِنِّي أَسْأَلُكَ قَلِيلاً مِنْ كَثِيرٍ"
  },
  {
   "segment_id": 88,
   "arabic": "مَعَ حَاجَةٍ بِي إِلَيْهِ عَظِيمَةٍ"
  },
  {
   "segment_id": 89,
   "arabic": "وَغِنَاكَ عَنْهُ قَدِيمٌ"
  },
  {
   "segment_id": 90,
   "arabic": "وَهُوَ عِنْدِي كَثِيرٌ"
  },
  {
   "segment_id": 91,
   "arabic": "وَهُوَ عَلَيْكَ سَهْلٌ يَسِيرٌ"
  },
  {
   "segment_id": 92,
   "arabic": "فَٱمْنُنْ عَلَيَّ بِهِ إِنَّكَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ"
  },
  {
   "segment_id": 93,
   "arabic": "آمِينَ رَبَّ ٱلْعَالَمِينَ"
  }
 ]
}