{
 "dua_id": "ziyarat-imam-hussayn-eid",
 "dua_name_en": "Ziyarat Imam Hussayn fil Eid",
 "dua_name_ar": "زيارة الإمام الحسين في العيد",
 "source": "https://www.duaplayer.org/en/ziyarat/imam-hussayn-eid",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا وَارِثَ آدَمَ صَفْوَةِ ٱللَّهِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا وَارِثَ نُوحٍ امِينِ ٱللَّهِ"
  },
  {
   "segment_id": 3,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا وَارِثَ إِبْرَاهِيمَ خَلِيلِ ٱللَّهِ"
  },
  {
   "segment_id": 4,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا وَارِثَ مُوسَىٰ كَلِيمِ ٱللَّهِ"
  },
  {
   "segment_id": 5,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا وَارِثَ عِيسَىٰ رُوحِ ٱللَّهِ"
  },
  {
   "segment_id": 6,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا وَارِثَ مُحَمَّدٍ"
  },
  {
   "segment_id": 7,
   "arabic": "صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ حَبِيبِ ٱللَّهِ"
  },
  {
   "segment_id": 8,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا وَارِثَ عَلِيٍّ حُجَّةِ ٱللَّهِ"
  },
  {
   "segment_id": 9,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ ايُّهَا ٱلْوَصِيُّ ٱلْبَرُّ ٱلْتَّقِيُّ"
  },
  {
   "segment_id": 10,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا ثَارَ ٱللَّهِ وَٱبْنَ ثَارِهِ وَٱلْوِتْرَ ٱلْمَوْتُورَ"
  },
  {
   "segment_id": 11,
   "arabic": "اشْهَدُ انَّكَ قَدْ اقَمْتَ ٱلصَّلاَةَ"
  },
  {
   "segment_id": 12,
   "arabic": "وَآتَيْتَ ٱلزَّكَاةَ"
  },
  {
   "segment_id": 13,
   "arabic": "وَامَرْتَ بِٱلْمَعْرُوفِ"
  },
  {
   "segment_id": 14,
   "arabic": "وَنَهَيْتَ عَنِ ٱلْمُنْكَرِ"
  },
  {
   "segment_id": 15,
   "arabic": "وَجَاهَدْتَ فِي ٱللَّهِ حَقَّ جِهَادِهِ"
  },
  {
   "segment_id": 16,
   "arabic": "حَتَّىٰ ٱسْتُبيحَ حَرَمُكَ وَقُتِلْتَ مَظْلُوماً"
  },
  {
   "segment_id": 17,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا ابَا عَبْدِ ٱللَّهِ"
  },
  {
   "segment_id": 18,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا بْنَ رَسُولِ ٱللَّهِ"
  },
  {
   "segment_id": 19,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا بْنَ سَيِّدِ ٱلْوَصِيِّينَ"
  },
  {
   "segment_id": 20,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا بْنَ فَاطِمَةَ ٱلزَّهْرَاءِ"
  },
  {
   "segment_id": 21,
   "arabic": "سَيِّدَةِ نِسَاءِ ٱلْعَالَمِينَ"
  },
  {
   "segment_id": 22,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا بَطَلَ ٱلْمُسْلِمِينَ"
  },
  {
   "segment_id": 23,
   "arabic": "يَا مَوْلاَيَ"
  },
  {
   "segment_id": 24,
   "arabic": "اشْهَدُ انَّكَ كُنْتَ نُوراً فِي ٱلاصْلاَبِ ٱلشَّامِخَةِ"
  },
  {
   "segment_id": 25,
   "arabic": "وَٱلارْحَامِ ٱلْمُطَهَّرَةِ"
  },
  {
   "segment_id": 26,
   "arabic": "لَمْ تُنَجِّسْكَ ٱلْجَاهِلِيَّةُ بِانْجَاسِهَا"
  },
  {
   "segment_id": 27,
   "arabic": "وَلَمْ تُلْبِسْكَ مِنْ مُدْلَهِمَّاتِ ثِيَابِهَا"
  },
  {
   "segment_id": 28,
   "arabic": "وَاشْهَدُ انَّكَ مِنْ دَعَائِمِ ٱلدِّينِ"
  },
  {
   "segment_id": 29,
   "arabic": "وَارْكَانِ ٱلْمُسْلِمِينَ"
  },
  {
   "segment_id": 30,
   "arabic": "وَمَعْقِلِ ٱلْمُؤْمِنِينَ"
  },
  {
   "segment_id": 31,
   "arabic": "وَاشْهَدُ انَّكَ ٱلإِمَامُ ٱلْبَرُّ ٱلتَّقِيُّ ٱلرَّضِيُّ"
  },
  {
   "segment_id": 32,
   "arabic": "ٱلزَّكِيُّ ٱلْهَادِي ٱلْمَهْدِيُّ"
  },
  {
   "segment_id": 33,
   "arabic": "وَاشْهَدُ انَّ ٱلائِمَّةَ مِنْ وُلْدِكَ"
  },
  {
   "segment_id": 34,
   "arabic": "كَلِمَةُ ٱلتَّقْوَىٰ وَاعْلاَمُ ٱلْهُدَىٰ"
  },
  {
   "segment_id": 35,
   "arabic": "وَٱلْعُروَةُ ٱلْوُثْقَىٰ"
  },
  {
   "segment_id": 36,
   "arabic": "وَٱلْحُجَّةُ عَلَىٰ اهْلِ ٱلدُّنْيَا"
  },
  {
   "segment_id": 37,
   "arabic": "إِنَّا لِلَّهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ"
  },
  {
   "segment_id": 38,
   "arabic": "يَا مَوْلاَيَ انَا مُوَالٍ لِوَلِيِّكُمْ"
  },
  {
   "segment_id": 39,
   "arabic": "وَمُعَادٍ لِعَدُوِّكُمْ"
  },
  {
   "segment_id": 40,
   "arabic": "وَانَا بِكُمْ مُؤْمِنٌ وَبِإِيَابِكُمْ"
  },
  {
   "segment_id": 41,
   "arabic": "مُوقِنٌ بِشَرَايعِ دِينِي"
  },
  {
   "segment_id": 42,
   "arabic": "وَخَوَاتيمِ عَمَلِي"
  },
  {
   "segment_id": 43,
   "arabic": "وَقَلْبِي لِقَلْبِكُمْ سِلْمٌ"
  },
  {
   "segment_id": 44,
   "arabic": "وَامْرِي لاِمْرِكُمْ مُتَّبِعٌ"
  },
  {
   "segment_id": 45,
   "arabic": "يَا مَوْلاَيَ اتَيْتُكَ خَائِفاً فَآمِنِّي"
  },
  {
   "segment_id": 46,
   "arabic": "وَاتَيْتُكَ مُسْتَجِيراً فَاجِرْنِي"
  },
  {
   "segment_id": 47,
   "arabic": "وَاتَيْتُكَ فَقِيراً فَاغْنِنِي"
  },
  {
   "segment_id": 48,
   "arabic": "سَيِّدِي وَمَوْلاَيَ"
  },
  {
   "segment_id": 49,
   "arabic": "انْتَ مَوْلاَيَ حُجَّةُ ٱللَّهِ عَلَىٰ ٱلْخَلْقِ اجْمَعِينَ"
  },
  {
   "segment_id": 50,
   "arabic": "آمَنْتُ بِسِرِّكُمْ وَعَلاَنِيَتِكُمْ"
  },
  {
   "segment_id": 51,
   "arabic": "وَبِظَاهِرِكُمْ وَبَاطِنِكُمْ"
  },
  {
   "segment_id": 52,
   "arabic": "وَاوَّلِكُمْ وَآخِرِكُمْ"
  },
  {
   "segment_id": 53,
   "arabic": "وَاشْهَدُ انَّكَ ٱلتَّالِي لِكِتَابِ ٱللَّهِ وَامينُ ٱللَّهِ"
  },
  {
   "segment_id": 54,
   "arabic": "ٱلدَّاعِي إِلَىٰ ٱللَّهِ بِٱلْحِكْمَةِ وَٱلْمَوْعِظَةِ ٱلْحَسَنَةِ"
  },
  {
   "segment_id": 55,
   "arabic": "لَعَنَ ٱللَّهُ امَّةً ظَلَمَتْكَ"
  },
  {
   "segment_id": 56,
   "arabic": "وَلَعَنَ ٱللَّهُ امَّةً سَمِعَتْ بِذٰلِكَ فَرَضِيَتْ بِهِ"
  }
 ]
}