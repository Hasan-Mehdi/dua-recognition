{
 "dua_id": "duasorg-ziyarat-of-imam-jafar-al-sadiq-2",
 "dua_name_en": "Short Ziyarat of Imam Jafar al-Sadiq (as)",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ziyarat-of-imam-jafar-al-sadiq.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "السَّلَامُ عَلَيْكَ يَا إِمَامَ الْوَرَى"
  },
  {
   "segment_id": 2,
   "arabic": "السَّلَامُ عَلَيْكَ أَيُّهَا الْعُرْوَةُ الْوُثْقَى"
  },
  {
   "segment_id": 3,
   "arabic": "السَّلَامُ عَلَيْكَ يَا حَبْلَ اللَّهِ الْمَتِينُ"
  },
  {
   "segment_id": 4,
   "arabic": "السَّلَامُ عَلَيْكَ يَا نُورَهُ الْمُبِينُ"
  },
  {
   "segment_id": 5,
   "arabic": "السَّلَامُ عَلَيْكَ أَيُّهَا الصَّادِقُ"
  },
  {
   "segment_id": 6,
   "arabic": "جَعْفَرُ بْنُ مُحَمَّدٍ، خَازِنُ الْعِلْمِ، الدَّاعِي"
  },
  {
   "segment_id": 7,
   "arabic": "إِلَى اللَّهِ بِالْحَقِّ"
  },
  {
   "segment_id": 8,
   "arabic": "اللَّهُمَّ كَمَا جَعَلْتَهُ مَعْدِنَ كَلَامِكَ وَوَحْيِكَ، وَخَازِنَ عِلْمِكَ،"
  },
  {
   "segment_id": 9,
   "arabic": "وَلِسَانَ تَوْحِيدِكَ، وَوَالِيَ أَمْرِكَ،"
  },
  {
   "segment_id": 10,
   "arabic": "وَمُسْتَحْفِظَ دِينِكَ، فَصَلِّ عَلَيْهِ أَفْضَلَ"
  },
  {
   "segment_id": 11,
   "arabic": "مَا صَلَّيْتَ عَلَى أَحَدٍ مِنْ أَوْصِيَائِكَ"
  },
  {
   "segment_id": 12,
   "arabic": "وَحُجَجِكَ، إِنَّكَ حَمِيدٌ مَجِيدٌ"
  }
 ]
}