{
 "dua_id": "ziyarat-saturday",
 "dua_name_en": "Ziyarat asSabt",
 "dua_name_ar": "زیارة السبت",
 "source": "https://www.duaplayer.org/en/ziyarat/saturday",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمٰنِ ٱلرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اشْهَدُ انْ لاَ إِلٰهَ إِلاَّ ٱللَّهُ"
  },
  {
   "segment_id": 3,
   "arabic": "وَحْدَهُ لاَ شَرِيكَ لَهُ"
  },
  {
   "segment_id": 4,
   "arabic": "وَاشْهَدُ انَّكَ رَسُولُهُ"
  },
  {
   "segment_id": 5,
   "arabic": "وَانَّكَ مُحَمَّدُ بْنُ عَبْدِٱللَّهِ"
  },
  {
   "segment_id": 6,
   "arabic": "وَاشْهَدُ انّكَ قَدْ بَلَّغْتَ رِسَالاتِ رَبِّكَ"
  },
  {
   "segment_id": 7,
   "arabic": "وَنَصَحْتَ لاِمَّتِكَ"
  },
  {
   "segment_id": 8,
   "arabic": "وَجَاهَدْتَ فِي سَبِيلِ ٱللَّهِ"
  },
  {
   "segment_id": 9,
   "arabic": "بِٱلْحِكْمَةِ وَٱلْمَوْعِظَةِ ٱلحَسَنَةِ"
  },
  {
   "segment_id": 10,
   "arabic": "وَادَّيْتَ ٱلَّذِي عَلَيْكَ مِنَ ٱلحَقِّ"
  },
  {
   "segment_id": 11,
   "arabic": "وَانَّكَ قَدْ رَؤُفْتَ بِٱلْمُؤْمِنِينَ"
  },
  {
   "segment_id": 12,
   "arabic": "وَغَلَظْتَ عَلَىٰ ٱلكَافِرِينَ"
  },
  {
   "segment_id": 13,
   "arabic": "وَعَبَدْتَ ٱللَّهَ مُخْلِصاً"
  },
  {
   "segment_id": 14,
   "arabic": "حَتَّىٰ اتَاكَ ٱليَقِينُ"
  },
  {
   "segment_id": 15,
   "arabic": "فَبَلَغَ ٱللَّهُ بِكَ اشْرَفَ مَحَلِّ ٱلْمُكَرَّمِينَ"
  },
  {
   "segment_id": 16,
   "arabic": "الْحَمْدُ لِلَّهِ الَّذِي ٱسْتَنْقَذَنَا بِكَ"
  },
  {
   "segment_id": 17,
   "arabic": "مِنَ ٱلشِّرْكِ وَٱلضَّلالِ"
  },
  {
   "segment_id": 18,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 19,
   "arabic": "وَٱجْعَلْ صَلَوَاتِكَ وَصَلَوَاتِ مَلاَئِكَتِكَ"
  },
  {
   "segment_id": 20,
   "arabic": "وَانْبِيَائِكَ وَٱلْمُرْسَلِينَ"
  },
  {
   "segment_id": 21,
   "arabic": "وَعِبَادِكَ ٱلصَّالِحِينَ"
  },
  {
   "segment_id": 22,
   "arabic": "وَاهْلِ ٱلسَّمَاوَاتِ وَٱلارَضِينَ"
  },
  {
   "segment_id": 23,
   "arabic": "وَمَنْ سَبَّحَ لَكَ يَا رَبَّ ٱلعَالَمِينَ"
  },
  {
   "segment_id": 24,
   "arabic": "مِنَ ٱلاوَّلِينَ وَٱلآخِرِينَ"
  },
  {
   "segment_id": 25,
   "arabic": "عَلَىٰ مُحَمَّدٍ عَبْدِكَ وَرَسُولِكَ"
  },
  {
   "segment_id": 26,
   "arabic": "وَنَبِيِّكَ وَامِينِكَ"
  },
  {
   "segment_id": 27,
   "arabic": "وَنَجِيبِكَ وَحَبِيبِكَ"
  },
  {
   "segment_id": 28,
   "arabic": "وَصَفِيِّكَ وَصِفْوَتِكَ"
  },
  {
   "segment_id": 29,
   "arabic": "وَخَاصَّتِكَ وَخَالِصَتِكَ"
  },
  {
   "segment_id": 30,
   "arabic": "وَخِيَرَتِكَ مِنْ خَلْقِكَ"
  },
  {
   "segment_id": 31,
   "arabic": "وَاعْطِهِ ٱلفَضْلَ وَٱلفَضِيلَةَ"
  },
  {
   "segment_id": 32,
   "arabic": "وَٱلوَسِيلَةَ وَٱلدَّرَجَةَ ٱلرَّفِيعَةَ"
  },
  {
   "segment_id": 33,
   "arabic": "وَٱبْعَثْهُ مَقَاماً مَحْمُوداً"
  },
  {
   "segment_id": 34,
   "arabic": "يَغْبِطُهُ بِهِ ٱلاوَّلُونَ وَٱلآخِرُونَ"
  },
  {
   "segment_id": 35,
   "arabic": "اَللَّهُمَّ إِنَّكَ قُلْتَ:"
  },
  {
   "segment_id": 36,
   "arabic": "﴿وَلَوْ انَّهُمْ إِذْ ظَلَمُوٱ انفُسَهُمْ"
  },
  {
   "segment_id": 37,
   "arabic": "جَاءُوكَ فَٱسْتَغْفَرُوا ٱللَّهَ"
  },
  {
   "segment_id": 38,
   "arabic": "وَٱسْتَغْفَرَ لَهُمُ ٱلرَّسُولُ"
  },
  {
   "segment_id": 39,
   "arabic": "لَوَجَدُوٱ ٱللَّهَ تَوَّاباً رَحِيماً﴾"
  },
  {
   "segment_id": 40,
   "arabic": "إِلٰهِي فَقَدْ اتَيْتُ نَبِيَّكَ مُسْتَغْفِراً"
  },
  {
   "segment_id": 41,
   "arabic": "تَائِباً مِنْ ذُنُوبِي"
  },
  {
   "segment_id": 42,
   "arabic": "فَصَلِّ عَلَىٰ مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 43,
   "arabic": "وَٱغْفِرْهَا لِي"
  },
  {
   "segment_id": 44,
   "arabic": "يَا سَيِّدَنَا"
  },
  {
   "segment_id": 45,
   "arabic": "اتَوَجَّهُ بِكَ وَبِاهْلِ بَيْتِكَ"
  },
  {
   "segment_id": 46,
   "arabic": "إِلَىٰ ٱللَّهِ تَعَالَىٰ رَبِّكَ وَرَبِّي"
  },
  {
   "segment_id": 47,
   "arabic": "لِيَغْفِرَ لِي"
  },
  {
   "segment_id": 48,
   "arabic": "إِنَّا لِلَّهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ"
  },
  {
   "segment_id": 49,
   "arabic": "اصِبْنَا بِكَ يَا حَبِيبَ قُلُوبِنَا"
  },
  {
   "segment_id": 50,
   "arabic": "فَمَا اعْظَمَ ٱلْمُصيبَةَ بِكَ"
  },
  {
   "segment_id": 51,
   "arabic": "حيَْثُ ٱنْقَطَعَ عَنَّا ٱلْوَحْيُ"
  },
  {
   "segment_id": 52,
   "arabic": "وَحَيْثُ فَقَدْنَاكَ"
  },
  {
   "segment_id": 53,
   "arabic": "فَإنَّا لِلَّهِ وَإِنَا إِلَيْهِ رَاجِعُونَ"
  },
  {
   "segment_id": 54,
   "arabic": "يَا سَيِّدَنَا يَا رَسُولَ اللّهِ"
  },
  {
   "segment_id": 55,
   "arabic": "صَلَوَاتُ ٱللَّهِ عَلَيْكَ وَعَلَىٰ آلِ بَيْتِكَ ٱلطَّاهِرِينَ"
  },
  {
   "segment_id": 56,
   "arabic": "هٰذَا يَوْمُ ٱلسَّبْتِ وَهُوَ يَوْمُكَ"
  },
  {
   "segment_id": 57,
   "arabic": "وَانَا فِيهِ ضَيْفُكَ وَجَارُكَ"
  },
  {
   "segment_id": 58,
   "arabic": "فَاضِفْنِي وَاجِرْنِي"
  },
  {
   "segment_id": 59,
   "arabic": "فَإنَّكَ كَرِيمٌ تُحِبُّ ٱلضِّيَافَةَ"
  },
  {
   "segment_id": 60,
   "arabic": "وَمَاْمُورٌ بِٱلإِجَارَةِ"
  },
  {
   "segment_id": 61,
   "arabic": "فَاضِفْنِي وَاحْسِنْ ضِيَافَتِي"
  },
  {
   "segment_id": 62,
   "arabic": "وَاجِرْنَا وَاحْسِنْ إِجَارَتَنَا"
  },
  {
   "segment_id": 63,
   "arabic": "بِمَنْزِلَةِ ٱللَّهِ عِنْدَكَ وَعِنْدَ آلِ بَيْتِكَ"
  },
  {
   "segment_id": 64,
   "arabic": "وَبِمَنْزِلَتِهِمْ عِنْدَهُ"
  },
  {
   "segment_id": 65,
   "arabic": "وَبِمَا ٱسْتَوْدَعَكُمْ مِنْ عِلْمِهِ"
  },
  {
   "segment_id": 66,
   "arabic": "فَإنَّهُ اكْرَمُ ٱلاكْرَمِينَ"
  }
 ]
}