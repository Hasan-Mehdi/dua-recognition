{
 "dua_id": "duasorg-ziyarat-muslim-ibn-aqeel-hani-e-urwa-3",
 "dua_name_en": "Izn Dukhool - Permission to Enter the shrine",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ziyarat-muslim-ibn-aqeel-hani-e-urwa.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ أَيُّهَا ٱلْعَبْدُ ٱلصَّالِحُ"
  },
  {
   "segment_id": 2,
   "arabic": "ٱلْمُطِيعُ لِلَّهِ وَلِرَسُولِهِ وَلأَمِيرِ ٱلْمُؤْمِنِينَ"
  },
  {
   "segment_id": 3,
   "arabic": "وَٱلْحَسَنِ وَٱلْحُسَيْنِ عَلَيْهِمُ ٱلسَّلاَمُ"
  },
  {
   "segment_id": 4,
   "arabic": "الْحَمْدُ لِلَّهِ"
  },
  {
   "segment_id": 5,
   "arabic": "وَسَلاَمٌ عَلَىٰ عِبَادِهِ ٱلَّذِينَ ٱصْطَفَىٰ"
  },
  {
   "segment_id": 6,
   "arabic": "مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 7,
   "arabic": "وَٱلسَّلاَمُ عَلَيْكُمْ وَرَحْمَةُ ٱللَّهِ"
  },
  {
   "segment_id": 8,
   "arabic": "وَبَرَكَاتُهُ وَمَغْفِرَتُهُ"
  },
  {
   "segment_id": 9,
   "arabic": "وَعَلَىٰ رُوحِكَ وَبَدَنِكَ"
  },
  {
   "segment_id": 10,
   "arabic": "أَشْهَدُ أَنَّكَ مَضَيْتَ عَلَىٰ مَا مَضَىٰ عَلَيْهِ ٱلْبَدْرِيُّونَ"
  },
  {
   "segment_id": 11,
   "arabic": "ٱلْمُجَاهِدُونَ فِي سَبِيلِ ٱللَّهِ"
  },
  {
   "segment_id": 12,
   "arabic": "ٱلْمُبَالِغُونَ فِي جِهَادِ أَعْدَائِهِ"
  },
  {
   "segment_id": 13,
   "arabic": "وَنُصْرَةِ أَوْلِيَائِهِ"
  },
  {
   "segment_id": 14,
   "arabic": "فَجَزَاكَ ٱللَّهُ أَفْضَلَ ٱلْجَزَاءِ"
  },
  {
   "segment_id": 15,
   "arabic": "وَأَكْثَرَ ٱلْجَزَاءِ"
  },
  {
   "segment_id": 16,
   "arabic": "وَأَوْفَرَ جَزَاءِ أَحَدٍ مِمَّنْ وَفَىٰ بِبَيْعَتِهِ"
  },
  {
   "segment_id": 17,
   "arabic": "وَٱسْتَجَابَ لَهُ دَعْوَتَهُ"
  },
  {
   "segment_id": 18,
   "arabic": "وَأَطَاعَ وُلاَةَ أَمْرِهِ"
  },
  {
   "segment_id": 19,
   "arabic": "أَشْهَدُ أَنَّكَ قَدْ بَالَغْتَ فِي ٱلنَّصِيحَةِ"
  },
  {
   "segment_id": 20,
   "arabic": "وَأَعْطَيْتَ غَايَةَ ٱلْمَجْهُودِ"
  },
  {
   "segment_id": 21,
   "arabic": "حَتَّىٰ بَعَثَكَ ٱللَّهُ فِي ٱلشُّهَدَاءِ"
  },
  {
   "segment_id": 22,
   "arabic": "وَجَعَلَ رُوحَكَ مَعَ أَرْوَاحِ ٱلسُّعَدَاءِ"
  },
  {
   "segment_id": 23,
   "arabic": "وَأَعْطَاكَ مِنْ جِنَانِهِ أَفْسَحَهَا مَنْزِلاً"
  },
  {
   "segment_id": 24,
   "arabic": "وَأَفْضَلَهَا غُرَفاً"
  },
  {
   "segment_id": 25,
   "arabic": "وَرَفَعَ ذِكْرَكَ فِي ٱلْعِلِّيِّينَ"
  },
  {
   "segment_id": 26,
   "arabic": "وَحَشَرَكَ مَعَ ٱلنَّبِيِّينَ وَٱلصِّدِّيقِينَ"
  },
  {
   "segment_id": 27,
   "arabic": "وَٱلشُّهَدَاءِ وَٱلصَّالِحِينَ"
  },
  {
   "segment_id": 28,
   "arabic": "وَحَسُنَ أُولٰئِكَ رَفِيقاً"
  },
  {
   "segment_id": 29,
   "arabic": "أَشْهَدُ أَنَّكَ لَمْ تَهِنْ وَلَمْ تَنْكُلْ"
  },
  {
   "segment_id": 30,
   "arabic": "وَأَنَّكَ قَدْ مَضَيْتَ عَلَىٰ بَصِيرَةٍ مِنْ أَمْرِكَ"
  },
  {
   "segment_id": 31,
   "arabic": "مُقْتَدِياً بِٱلصَّالِحِينَ"
  },
  {
   "segment_id": 32,
   "arabic": "وَمُتَّبِعاً لِلنَّبِيِّينَ"
  },
  {
   "segment_id": 33,
   "arabic": "فَجَمَعَ ٱللَّهُ بَيْنَنَا وَبَيْنَكَ"
  },
  {
   "segment_id": 34,
   "arabic": "وَبَيْنَ رَسُولِهِ وَأَوْلِيَائِهِ"
  },
  {
   "segment_id": 35,
   "arabic": "فِي مَنَازِلِ ٱلْمُخْبِتِينَ"
  },
  {
   "segment_id": 36,
   "arabic": "فَإِنَّهُ أَرْحَمُ ٱلرَّاحِمِينَ"
  }
 ]
}