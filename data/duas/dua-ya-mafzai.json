{
 "dua_id": "dua-ya-mafzai",
 "dua_name_en": "Dua Ya Mafza'i",
 "dua_name_ar": "دعاء يَا مَفْزَعِي",
 "source": "https://www.duaplayer.org/en/dua/ya-mafzai",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "يَا مَفْزَعِي عِنْدَ كُرْبَتِي"
  },
  {
   "segment_id": 2,
   "arabic": "وَيَا غَوْثِي عِنْدَ شِدّتِي"
  },
  {
   "segment_id": 3,
   "arabic": "إِلَيْكَ فَزِعْتُ"
  },
  {
   "segment_id": 4,
   "arabic": "وَبِكَ اسْتَغَثْتُ"
  },
  {
   "segment_id": 5,
   "arabic": "وَبِكَ لُذْتُ"
  },
  {
   "segment_id": 6,
   "arabic": "لاَ الُوذُ بِسِوَاكَ"
  },
  {
   "segment_id": 7,
   "arabic": "وَلاَ اطْلُبُ ٱلْفَرَجَ إِلاَّ مِنْكَ"
  },
  {
   "segment_id": 8,
   "arabic": "فَاغِثْنِي وَفَرِّجْ عَنِّي"
  },
  {
   "segment_id": 9,
   "arabic": "يَا مَنْ يَقْبَلُ ٱلْيَسِيرَ"
  },
  {
   "segment_id": 10,
   "arabic": "وَيَعْفُو عَنِ ٱلْكَثِيرِ"
  },
  {
   "segment_id": 11,
   "arabic": "إِقْبَلْ مِنِّي ٱلْيَسِيرَ"
  },
  {
   "segment_id": 12,
   "arabic": "وَٱعْفُ عَنِّي ٱلْكَثِيرَ"
  },
  {
   "segment_id": 13,
   "arabic": "إِنِّكَ انْتَ ٱلْغَفُورُ ٱلرَّحِيمُ"
  },
  {
   "segment_id": 14,
   "arabic": "اللِّهُمِّ إِنِّي اسْالُكَ إِيـمَاناً تُبَاشِرُ بِهِ قَلْبِي"
  },
  {
   "segment_id": 15,
   "arabic": "وَيَقِيناً حَتَّىٰ اعْلَمَ انِّهُ لَنْ يُصِيبَنِي إِلاَّ مَا كَتَبْتَ لِي"
  },
  {
   "segment_id": 16,
   "arabic": "وَرَضِّنِي مِنَ ٱلْعَيْشِ بِمَا قَسَمْتَ لِي"
  },
  {
   "segment_id": 17,
   "arabic": "يَا ارْحَمَ ٱلرَّاحِمِينَ"
  },
  {
   "segment_id": 18,
   "arabic": "يَا عُدِّتِي فِي كُرْبَتِي"
  },
  {
   "segment_id": 19,
   "arabic": "وَيَا صَاحِبِي فِي شِدِّتِي"
  },
  {
   "segment_id": 20,
   "arabic": "وَيَا وَلِيِّي فِي نِعْمَتِي"
  },
  {
   "segment_id": 21,
   "arabic": "وَيَا غَايَتِي فِي رَغْبَتِي"
  },
  {
   "segment_id": 22,
   "arabic": "انْتَ ٱلسَّاتِرُ عَوْرَتِي"
  },
  {
   "segment_id": 23,
   "arabic": "وَٱلآمِنُ رَوْعَتِي"
  },
  {
   "segment_id": 24,
   "arabic": "وَٱلْمُقِيلُ عَثْرَتِي"
  },
  {
   "segment_id": 25,
   "arabic": "فَٱغْفِرْ لِي خَطِيئَتِي"
  },
  {
   "segment_id": 26,
   "arabic": "يَا ارْحَمَ ٱلرَّاحِمِينَ"
  }
 ]
}