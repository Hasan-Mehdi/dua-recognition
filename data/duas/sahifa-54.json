{
 "dua_id": "sahifa-54",
 "dua_name_en": "Sahifa 54: Removal of worries",
 "dua_name_ar": "دعـاؤه استكشاف الهموم",
 "source": "https://duas.pro/54-removal-of-worries",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "يَا فَارِجَ الْهَمِّ وَكَاشِفَ الغَمِّ،"
  },
  {
   "segment_id": 2,
   "arabic": "يَا رَحْمنَ الدُّنْيَا وَالآخِرَةِ وَرَحِيمَهُمَا،"
  },
  {
   "segment_id": 3,
   "arabic": "صَلِّ عَلَى مُحَمَّد وَآلِ مُحَمَّد،"
  },
  {
   "segment_id": 4,
   "arabic": "وَافْرُجْ هَمِّيَ، وَاكْشِفْ غَمِّيَ،"
  },
  {
   "segment_id": 5,
   "arabic": "يَا وَاحِدُ يَا أَحَدُ، يَا صَمَدُ،"
  },
  {
   "segment_id": 6,
   "arabic": "يَامَنْ لَمْ يَلِدْ وَلَمْ يُولَدْ،"
  },
  {
   "segment_id": 7,
   "arabic": "وَلَمْ يَكُنْ لَهُ كُفُواً أَحَدٌ،"
  },
  {
   "segment_id": 8,
   "arabic": "اعْصِمْنِي وَطَهِّرْنِي، وَاْذهِبْ بِبَلِيَّتِي."
  },
  {
   "segment_id": 9,
   "arabic": "اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ"
  },
  {
   "segment_id": 10,
   "arabic": "لَا تَأْخُذُهُ سِنَةٌ وَلَا نَوْمٌ"
  },
  {
   "segment_id": 11,
   "arabic": "لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ"
  },
  {
   "segment_id": 12,
   "arabic": "مَن ذَا الَّذِي يَشْفَعُ عِندَهُ إِلَّا بِإِذْنِهِ"
  },
  {
   "segment_id": 13,
   "arabic": "يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ"
  },
  {
   "segment_id": 14,
   "arabic": "وَلَا يُحِيطُونَ بِشَيْءٍ مِّنْ عِلْمِهِ إِلَّا بِمَا شَاءَ"
  },
  {
   "segment_id": 15,
   "arabic": "وَسِعَ كُرْسِيُّهُ السَّمَاوَاتِ وَالْأَرْضَ"
  },
  {
   "segment_id": 16,
   "arabic": "وَلَا يَئُودُهُ حِفْظُهُمَا"
  },
  {
   "segment_id": 17,
   "arabic": "وَهُوَ الْعَلِيُّ الْعَظِيمُ"
  },
  {
   "segment_id": 18,
   "arabic": "قُلْ هُوَ اللَّهُ أَحَدٌ، اللَّهُ الصَّمَدُ، لَمْ يَلِدْ وَلَمْ يُولَدْ، وَلَمْ يَكُن لَّهُ كُفُوًا أَحَدٌ."
  },
  {
   "segment_id": 19,
   "arabic": "قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ، مِن شَرِّ مَا خَلَقَ، وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ، وَمِن شَرِّ النَّفَّاثَاتِ فِي الْعُقَدِ، وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ."
  },
  {
   "segment_id": 20,
   "arabic": "قُلْ أَعُوذُ بِرَبِّ النَّاسِ، مَلِكِ النَّاسِ، إِلَٰهِ النَّاسِ، مِن شَرِّ الْوَسْوَاسِ الْخَنَّاسِ، الَّذِي يُوَسْوِسُ فِي صُدُورِ النَّاسِ، مِنَ الْجِنَّةِ وَالنَّاسِ."
  },
  {
   "segment_id": 21,
   "arabic": "أَللَّهُمَّ إنِّيْ أَسْأَلُكَ سُؤَالَ مَنِ اشْتَدَّتْ فَاقَتُهُ،"
  },
  {
   "segment_id": 22,
   "arabic": "وَضَعُفَتْ قُوَّتُهُ، وَكَثُرَتْ ذُنُوبُهُ،"
  },
  {
   "segment_id": 23,
   "arabic": "سُؤَالَ مَنْ لاَ يَجِدُ لِفَاقَتِهِ مُغِيْثاً،"
  },
  {
   "segment_id": 24,
   "arabic": "وَلاَ لِضَعْفِهِ مُقَوِّياً،"
  },
  {
   "segment_id": 25,
   "arabic": "وَلاَ لِذَنْبِهِ غَافِراً غَيْرَكَ،"
  },
  {
   "segment_id": 26,
   "arabic": "يَا ذَا الْجَلاَلِ وَالإكْرَامِ."
  },
  {
   "segment_id": 27,
   "arabic": "أَسْأَلُكَ عَمَلاً تُحِبُّ بِهِ مَنْ عَمِلَ بِهِ،"
  },
  {
   "segment_id": 28,
   "arabic": "وَيَقِيناً تَنْفَعُ بِهِ مَنِ اسْتَيْقَنَ بِهِ"
  },
  {
   "segment_id": 29,
   "arabic": "حَقَّ الْيَقِينِ فِيْ نَفَاذِ أَمْرِكَ."
  },
  {
   "segment_id": 30,
   "arabic": "أَللَّهُمَّ صَلِّ عَلَى مُحَمَّد وَآلِ مُحَمَّد،"
  },
  {
   "segment_id": 31,
   "arabic": "وَاقْبِضَ عَلَى الصِّدْقِ نَفْسِي،"
  },
  {
   "segment_id": 32,
   "arabic": "وَاقْطَعْ مِنَ الدُّنْيَا حَاجَتِي،"
  },
  {
   "segment_id": 33,
   "arabic": "وَاجْعَلْ فِيمَا عِنْدَكَ رَغْبَتِي،"
  },
  {
   "segment_id": 34,
   "arabic": "شَوْقاً إلَى لِقَائِكَ،"
  },
  {
   "segment_id": 35,
   "arabic": "وَهَبْ لِي صِدْقَ التَّوَكُّلِ عَلَيْكَ ."
  },
  {
   "segment_id": 36,
   "arabic": "أَسْأَلُكَ مِنْ خَيْرِ كِتَاب قَدْ خَلاَ وَأَعُوذُ بِكَ"
  },
  {
   "segment_id": 37,
   "arabic": "مِنْ شَرِّ كِتَاب قَدْ خَلاَ"
  },
  {
   "segment_id": 38,
   "arabic": "أَسْأَلُكَ خَوْفَ الْعَابِدِينَ لَكَ،"
  },
  {
   "segment_id": 39,
   "arabic": "وَعِبَادَةَ الْخَاشِعِينَ لَكَ،"
  },
  {
   "segment_id": 40,
   "arabic": "وَيَقِيْنَ الْمُتَوَكِّلِينَ عَلَيْكَ،"
  },
  {
   "segment_id": 41,
   "arabic": "وَتَوَكُّلَ الْمُؤْمِنِينَ عَلَيْكَ."
  },
  {
   "segment_id": 42,
   "arabic": "أَللَّهُمَّ اجْعَلْ رَغْبَتِي فِي مَسْأَلَتِي"
  },
  {
   "segment_id": 43,
   "arabic": "مِثْلَ رَغْبَةِ أَوْلِيَآئِكَ فِي مَسَائِلِهِمْ،"
  },
  {
   "segment_id": 44,
   "arabic": "وَرَهْبَتِيْ مِثْلَ رَهْبَةِ أَوْلِيَآئِكَ،"
  },
  {
   "segment_id": 45,
   "arabic": "وَاسْتَعْمِلْنِي فِي مَرْضَاتِكَ،"
  },
  {
   "segment_id": 46,
   "arabic": "عَمَلاً لاَ أَتْرُكُ مَعَهُ شَيْئاً مِنْ دِيْنِكَ"
  },
  {
   "segment_id": 47,
   "arabic": "مَخَافَةَ أَحْد مِنْ خَلْقِكَ."
  },
  {
   "segment_id": 48,
   "arabic": "أَللَّهُمَّ هَذِهِ حَاجَتِي، فَأَعْظِمْ فِيهَا رَغْبَتِي،"
  },
  {
   "segment_id": 49,
   "arabic": "وَأَظْهِرْ فِيهَا عُذْرِي، وَلَقِّنِي فِيهَا حُجَّتِي وَعَافِ فِيْهَا جَسَدِيْ."
  },
  {
   "segment_id": 50,
   "arabic": "أَللَّهُمَّ مَنْ أَصْبَحَ لَهُ ثِقَةٌ أَوْ رَجَآءٌ غَيْرُكَ،"
  },
  {
   "segment_id": 51,
   "arabic": "فَقَدْ أَصْبَحْتُ وَأَنْتَ ثِقَتِي"
  },
  {
   "segment_id": 52,
   "arabic": "وَرَجَآئِي فِي الأُمُورِ كُلِّهَا،"
  },
  {
   "segment_id": 53,
   "arabic": "فَاقْضِ لِيْ بِخَيْرِهَا عَاقِبَةً،"
  },
  {
   "segment_id": 54,
   "arabic": "وَنَجِّنِيْ مِنْ مُضِلاَّتِ الْفِتَنِ،"
  },
  {
   "segment_id": 55,
   "arabic": "بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِينَ."
  },
  {
   "segment_id": 56,
   "arabic": "وَصَلَّى اللهُ عَلَى سَيِّدِنَا مُحَمَّد رُسُولِ اللهِ المُصْطَفَى،"
  },
  {
   "segment_id": 57,
   "arabic": "وَعَلَى آلِهِ الطَّاهِرِينَ."
  }
 ]
}