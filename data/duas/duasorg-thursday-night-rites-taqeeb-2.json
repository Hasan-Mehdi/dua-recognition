{
 "dua_id": "duasorg-thursday-night-rites-taqeeb-2",
 "dua_name_en": "Thursday Night - Short Dua - Dua Allahumma Anta Rabbi",
 "dua_name_ar": "",
 "source": "https://www.duas.org/thursday-night-rites-taqeeb.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللَّهُمَّ أَنْتَ رَبِّي"
  },
  {
   "segment_id": 2,
   "arabic": "لاَ إِلٰهَ إِلاَّ أَنْتَ"
  },
  {
   "segment_id": 3,
   "arabic": "خَلَقْتَني وَأَنَا عَبْدُكَ وَٱبْنُ أَمَتِكَ"
  },
  {
   "segment_id": 4,
   "arabic": "وَفي قَبْضَتِكَ وَنَاصِيَتي بِيَدِكَ"
  },
  {
   "segment_id": 5,
   "arabic": "أَمْسَيْتُ عَلَىٰ عَهْدِكَ وَوَعْدِكَ مَا ٱسْتَطَعْتُ"
  },
  {
   "segment_id": 6,
   "arabic": "أَعُوذُ بِرِضَاكَ مِنْ شَرِّ مَا صَنَعْتُ"
  },
  {
   "segment_id": 7,
   "arabic": "أَبُوءُ بِنِعْمَتِكَ وَأَبُوءُ بِذَنْبِي"
  },
  {
   "segment_id": 8,
   "arabic": "فَٱغْفِرْ لِي ذُنُوبِي"
  },
  {
   "segment_id": 9,
   "arabic": "إِنَّهُ لاَ يَغْفِرُ ٱلذُّنُوبَ إِلاَّ أَنْتَ"
  }
 ]
}