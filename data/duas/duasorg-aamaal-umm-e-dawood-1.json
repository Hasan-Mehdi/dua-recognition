{
 "dua_id": "duasorg-aamaal-umm-e-dawood-1",
 "dua_name_en": "Dua Umme Dawood",
 "dua_name_ar": "",
 "source": "https://www.duas.org/aamaal-umm-e-dawood.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "صَدَقَ ٱللَّهُ ٱلْعَظِيمُ"
  },
  {
   "segment_id": 2,
   "arabic": "ٱلَّذِي لاَ إِلٰهَ إِلاَّ هُوَ"
  },
  {
   "segment_id": 3,
   "arabic": "ٱلْحَيُّ ٱلْقَيُّومُ"
  },
  {
   "segment_id": 4,
   "arabic": "ذُو ٱلْجَلالِ وَٱلإِكْرَامِ"
  },
  {
   "segment_id": 5,
   "arabic": "ٱلرَّحْمٰنُ ٱلرَّحِيمُ"
  },
  {
   "segment_id": 6,
   "arabic": "ٱلْحَلِيمُ ٱلْكَرِيمُ"
  },
  {
   "segment_id": 7,
   "arabic": "ٱلَّذِي لَيْسَ كَمِثْلِهِ شَيْءٌ"
  },
  {
   "segment_id": 8,
   "arabic": "وَهُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ"
  },
  {
   "segment_id": 9,
   "arabic": "ٱلْبَصِيرُ ٱلْخَبِيرُ"
  },
  {
   "segment_id": 10,
   "arabic": "شَهِدَ ٱللَّهُ انَّهُ لاَ إِلٰهَ إِلاَّ هُوَ"
  },
  {
   "segment_id": 11,
   "arabic": "وَٱلْمَلائِكَةُ وَاوْلُو ٱلْعِلْمِ"
  },
  {
   "segment_id": 12,
   "arabic": "قَائِماً بِٱلْقِسْطِ"
  },
  {
   "segment_id": 13,
   "arabic": "لاَ إِلٰهَ إِلاَّ هُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ"
  },
  {
   "segment_id": 14,
   "arabic": "وَبَلَّغَتْ رُسُلُهُ ٱلْكِرَامُ"
  },
  {
   "segment_id": 15,
   "arabic": "وَانَا عَلَىٰ ذٰلِكَ مِنَ ٱلشَّاهِدِينَ"
  },
  {
   "segment_id": 16,
   "arabic": "اللَّهُمَّ لَكَ ٱلْحَمْدُ"
  },
  {
   "segment_id": 17,
   "arabic": "وَلَكَ ٱلْمَجْدُ"
  },
  {
   "segment_id": 18,
   "arabic": "وَلَكَ ٱلْعِزُّ"
  },
  {
   "segment_id": 19,
   "arabic": "وَلَكَ ٱلْفَخْرُ"
  },
  {
   "segment_id": 20,
   "arabic": "وَلَكَ ٱلْقَهْرُ"
  },
  {
   "segment_id": 21,
   "arabic": "ولَكَ ٱلنِّعْمَةُ"
  },
  {
   "segment_id": 22,
   "arabic": "وَلَكَ ٱلْعَظَمَةُ"
  },
  {
   "segment_id": 23,
   "arabic": "وَلَكَ ٱلرَّحْمَةُ"
  },
  {
   "segment_id": 24,
   "arabic": "وَلَكَ ٱلْمَهَابَةُ"
  },
  {
   "segment_id": 25,
   "arabic": "وَلَكَ ٱلسُّلْطَانُ"
  },
  {
   "segment_id": 26,
   "arabic": "وَلَكَ ٱلْبَهَاءُ"
  },
  {
   "segment_id": 27,
   "arabic": "وَلَكَ ٱلاِمْتِنَانُ"
  },
  {
   "segment_id": 28,
   "arabic": "وَلَكَ ٱلتَّسْبِيحُ"
  },
  {
   "segment_id": 29,
   "arabic": "وَلَكَ ٱلتَّقْدِيسُ"
  },
  {
   "segment_id": 30,
   "arabic": "وَلَكَ ٱلتَّهْلِيلُ"
  },
  {
   "segment_id": 31,
   "arabic": "وَلَكَ ٱلتَّكْبِيرُ"
  },
  {
   "segment_id": 32,
   "arabic": "وَلَكَ مَا يُرَىٰ"
  },
  {
   "segment_id": 33,
   "arabic": "وَلَكَ مَا لاَ يُرَىٰ"
  },
  {
   "segment_id": 34,
   "arabic": "وَلَكَ مَا فَوْقَ ٱلسَّمَاوَاتِ ٱلْعُلَىٰ"
  },
  {
   "segment_id": 35,
   "arabic": "وَلَكَ مَا تَحْتَ ٱلثَّرَىٰ"
  },
  {
   "segment_id": 36,
   "arabic": "وَلَكَ ٱلارَضُونَ ٱلسُّفْلَىٰ"
  },
  {
   "segment_id": 37,
   "arabic": "وَلَكَ ٱلآخِرَةُ وَٱلاولَىٰ"
  },
  {
   "segment_id": 38,
   "arabic": "وَلَكَ مَا تَرْضَىٰ بِهِ مِنَ ٱلثَّنَاءِ وَٱلْحَمْدِ"
  },
  {
   "segment_id": 39,
   "arabic": "وَٱلشُّكْرِ وَٱلنَّعْمَاءِ"
  },
  {
   "segment_id": 40,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ جَبْرَئِيلَ"
  },
  {
   "segment_id": 41,
   "arabic": "امِينِكَ عَلَىٰ وَحْيِكَ"
  },
  {
   "segment_id": 42,
   "arabic": "وَٱلْقَوِيِّ عَلَىٰ امْرِكَ"
  },
  {
   "segment_id": 43,
   "arabic": "وَٱلْمُطَاعِ فِي سَمَاوَاتِكَ وَمَحَالِّ كَرَامَاتِكَ"
  },
  {
   "segment_id": 44,
   "arabic": "ٱلْمُتَحَمِّلِ لِكَلِمَاتِكَ"
  },
  {
   "segment_id": 45,
   "arabic": "ٱلنَّاصِرِ لانْبِيَائِكَ"
  },
  {
   "segment_id": 46,
   "arabic": "ٱلْمُدَمِّرِ لاعْدَائِكَ"
  },
  {
   "segment_id": 47,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مِيكَائِيلَ"
  },
  {
   "segment_id": 48,
   "arabic": "مَلَكِ رَحْمَتِكَ"
  },
  {
   "segment_id": 49,
   "arabic": "وَٱلْمَخْلُوقِ لِرَافَتِكَ"
  },
  {
   "segment_id": 50,
   "arabic": "وَٱلْمُسْتَغْفِرِ ٱلْمُعِينِ لاهْلِ طَاعَتِكَ"
  },
  {
   "segment_id": 51,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ إِسْرَافِيلَ"
  },
  {
   "segment_id": 52,
   "arabic": "حَامِلِ عَرْشِكَ"
  },
  {
   "segment_id": 53,
   "arabic": "وَصَاحِبِ ٱلصُّوْرِ"
  },
  {
   "segment_id": 54,
   "arabic": "ٱلْمُنْتَظِرِ لامْرِكَ"
  },
  {
   "segment_id": 55,
   "arabic": "ٱلْوَجِلِ ٱلْمُشْفِقِ مِنْ خِيفَتِكَ"
  },
  {
   "segment_id": 56,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ حَمَلَةِ ٱلْعَرْشِ ٱلطَّاهِرِينَ"
  },
  {
   "segment_id": 57,
   "arabic": "وَعَلَىٰ ٱلسَّفَرَةِ ٱلْكِرَامِ"
  },
  {
   "segment_id": 58,
   "arabic": "ٱلْبَرَرَةِ ٱلطَّيِّبِينَ"
  },
  {
   "segment_id": 59,
   "arabic": "وَعَلَىٰ مَلائِكَتِكَ ٱلْكِرَامِ ٱلْكَاتِبِينَ"
  },
  {
   "segment_id": 60,
   "arabic": "وَعَلَىٰ مَلائِكَةِ ٱلْجِنَانِ"
  },
  {
   "segment_id": 61,
   "arabic": "وَخَزَنَةِ ٱلنِّيرَانِ"
  },
  {
   "segment_id": 62,
   "arabic": "وَمَلَكِ ٱلْمَوْتِ وَٱلاعْوَانِ"
  },
  {
   "segment_id": 63,
   "arabic": "يَا ذَا ٱلْجَلاَلِ وَٱلإِكْرَامِ"
  },
  {
   "segment_id": 64,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ ابِينَا آدَمَ"
  },
  {
   "segment_id": 65,
   "arabic": "بَدِيعِ فِطْرَتِكَ"
  },
  {
   "segment_id": 66,
   "arabic": "ٱلَّذِي كَرَّمْتَهُ بِسُجُودِ مَلائِكَتِكَ"
  },
  {
   "segment_id": 67,
   "arabic": "وَابَحْتَهُ جَنَّتَكَ"
  },
  {
   "segment_id": 68,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ امِّنَا حَوَّاءَ"
  },
  {
   "segment_id": 69,
   "arabic": "ٱلْمُطَهَّرَةِ مِنَ ٱلرِّجْسِ"
  },
  {
   "segment_id": 70,
   "arabic": "ٱلْمُصَفَّاةِ مِنَ ٱلدَّنَسِ"
  },
  {
   "segment_id": 71,
   "arabic": "ٱلْمُفَضَّلَةِ مِنَ ٱلإِنْسِ"
  },
  {
   "segment_id": 72,
   "arabic": "ٱلْمُتَرَدِّدَةِ بَيْنَ مَحَالِّ ٱلْقُدْسِ"
  },
  {
   "segment_id": 73,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ هَابِيلَ وَشَيْثٍ"
  },
  {
   "segment_id": 74,
   "arabic": "وَإِدْرِيسَ وَنُوحٍ"
  },
  {
   "segment_id": 75,
   "arabic": "وَهُودٍ وَصَالِحٍ"
  },
  {
   "segment_id": 76,
   "arabic": "وَإِبْرَاهِيمَ وَإِسْمَاعِيلَ"
  },
  {
   "segment_id": 77,
   "arabic": "وَإِسْحَاقَ وَيَعْقُوبَ"
  },
  {
   "segment_id": 78,
   "arabic": "وَيُوسُفَ وَٱلاسْبَاطِ"
  },
  {
   "segment_id": 79,
   "arabic": "وَلُوطٍ وَشُعَيْبٍ"
  },
  {
   "segment_id": 80,
   "arabic": "وَايُّوْبَ وَمُوسَىٰ"
  },
  {
   "segment_id": 81,
   "arabic": "وَهَارُونَ وَيُوشَعَ"
  },
  {
   "segment_id": 82,
   "arabic": "وَمِيشَا وَٱلْخِضْرِ"
  },
  {
   "segment_id": 83,
   "arabic": "وَذِي ٱلْقَرْنَيْنِ وَيُونُسَ"
  },
  {
   "segment_id": 84,
   "arabic": "وَإِلْيَاسَ وَٱلْيَسَعَ"
  },
  {
   "segment_id": 85,
   "arabic": "وَذِي ٱلْكِفْلِ وَطَالُوتَ"
  },
  {
   "segment_id": 86,
   "arabic": "وَدَاوُودَ وَسُلَيْمَانَ"
  },
  {
   "segment_id": 87,
   "arabic": "وَزَكَرِيَّا وَشَعْيَا"
  },
  {
   "segment_id": 88,
   "arabic": "وَيَحْيَىٰ وَتُورَخَ"
  },
  {
   "segment_id": 89,
   "arabic": "وَمَتَّىٰ وَإِرْمِيَا"
  },
  {
   "segment_id": 90,
   "arabic": "وَحَيْقُوقَ وَدَانِيَالَ"
  },
  {
   "segment_id": 91,
   "arabic": "وَعُزَيْرٍ وَعِيسَىٰ"
  },
  {
   "segment_id": 92,
   "arabic": "وَشَمْعُونَ وَجِرْجِيسَ"
  },
  {
   "segment_id": 93,
   "arabic": "وَٱلْحَوَارِيِّينَ وَٱلاتْبَاعِ"
  },
  {
   "segment_id": 94,
   "arabic": "وَخَالِدٍ وَحَنْظَلَةَ وَلُقْمَانَ"
  },
  {
   "segment_id": 95,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 96,
   "arabic": "وَٱرْحَمْ مُحَمَّداً وَآلَ مُحَمَّدٍ"
  },
  {
   "segment_id": 97,
   "arabic": "وَبَارِكْ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 98,
   "arabic": "كَمَا صَلَّيْتَ وَرَحِمْتَ وَبَارَكْتَ عَلَىٰ إِبْرَاهِيمَ وَآلِ إِبْرَاهِيمَ"
  },
  {
   "segment_id": 99,
   "arabic": "إِنَّكَ حَمِيدٌ مَجِيدٌ"
  },
  {
   "segment_id": 100,
   "arabic": "اللَّهُمَّ صَلِّ عَلَىٰ ٱلاوْصِيَاءِ وَٱلسُّعَدَاءِ"
  },
  {
   "segment_id": 101,
   "arabic": "وَٱلشُّهَدَاءِ وَائِمَّةِ ٱلْهُدَىٰ"
  },
  {
   "segment_id": 102,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ ٱلابْدَالِ وَٱلاوْتَادِ"
  },
  {
   "segment_id": 103,
   "arabic": "وَٱلسُّيَّاحِ وَٱلْعُبَّادِ"
  },
  {
   "segment_id": 104,
   "arabic": "وَٱلْمُخْلِصِينَ وَٱلزُّهَّادِ"
  },
  {
   "segment_id": 105,
   "arabic": "وَاهْلِ ٱلْجِدِّ وَٱلاِجْتِهَادِ"
  },
  {
   "segment_id": 106,
   "arabic": "وَٱخْصُصْ مُحَمَّداً وَاهْلَ بَيْتِهِ بِافْضَلِ صَلَوَاتِكَ"
  },
  {
   "segment_id": 107,
   "arabic": "وَاجْزَلِ كَرَامَاتِكَ"
  },
  {
   "segment_id": 108,
   "arabic": "وَبَلِّغْ رُوحَهُ وَجَسَدَهُ مِنِّي تَحِيَّةً وَسَلاماً"
  },
  {
   "segment_id": 109,
   "arabic": "وَزِدْهُ فَضْلاً وَشَرَفاً وَكَرَماً"
  },
  {
   "segment_id": 110,
   "arabic": "حَتَّىٰ تُبَلِّغَهُ اعْلَىٰ دَرَجَاتِ اهْلِ ٱلشَّرَفِ"
  },
  {
   "segment_id": 111,
   "arabic": "مِنَ ٱلنَّبِيِّينَ وَٱلْمُرْسَلِينَ"
  },
  {
   "segment_id": 112,
   "arabic": "وَٱلافَاضِلِ ٱلْمُقَرَّبِينَ"
  },
  {
   "segment_id": 113,
   "arabic": "اَللَّهُمَّ وَصَلِّ عَلَىٰ مَنْ سَمَّيْتُ وَمَنْ لَمْ اسَمِّ"
  },
  {
   "segment_id": 114,
   "arabic": "مِنْ مَلائِكَتِكَ وَانْبِيَائِكَ"
  },
  {
   "segment_id": 115,
   "arabic": "وَرُسُلِكَ وَاهْلِ طَاعَتِكَ"
  },
  {
   "segment_id": 116,
   "arabic": "وَاوْصِلْ صَلَوَاتِي إِلَيْهِمْ وَإِلَىٰ ارْوَاحِهِمْ"
  },
  {
   "segment_id": 117,
   "arabic": "وَٱجْعَلْهُمْ إِخْوَانِي فِيكَ"
  },
  {
   "segment_id": 118,
   "arabic": "وَاعْوَانِي عَلَىٰ دُعَائِكَ"
  },
  {
   "segment_id": 119,
   "arabic": "اَللَّهُمَّ إِنِّي اسْتَشْفِعُ بِكَ إِلَيْكَ"
  },
  {
   "segment_id": 120,
   "arabic": "وَبِكَرَمِكَ إِلَىٰ كَرَمِكَ"
  },
  {
   "segment_id": 121,
   "arabic": "وَبِجُودِكَ إِلَىٰ جُودِكَ"
  },
  {
   "segment_id": 122,
   "arabic": "وَبِرَحْمَتِكَ إِلَىٰ رَحْمَتِكَ"
  },
  {
   "segment_id": 123,
   "arabic": "وَبِاهْلِ طَاعَتِكَ إِلَيْكَ"
  },
  {
   "segment_id": 124,
   "arabic": "وَاسْالُكَ ٱللَّهُمَّ بِكُلِّ مَا سَالَكَ بِهِ احَدٌ مِنْهُمْ"
  },
  {
   "segment_id": 125,
   "arabic": "مِنْ مَسْالَةٍ شَرِيفَةٍ غَيْرِ مَرْدُودَةٍ"
  },
  {
   "segment_id": 126,
   "arabic": "وَبِمَا دَعَوْكَ بِهِ مِنْ دَعْوَةٍ مُجَابَةٍ غَيْرِ مُخَيِّبَةٍ"
  },
  {
   "segment_id": 127,
