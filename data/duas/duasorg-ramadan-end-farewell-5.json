{
 "dua_id": "duasorg-ramadan-end-farewell-5",
 "dua_name_en": "Day Dua - 2",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-end-farewell.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللّهُمّ اشْرَحْ بِالقُرْآنِ صَدْرِي،"
  },
  {
   "segment_id": 2,
   "arabic": "وَاسْتَعْمِلْ بِالقُرْآنِ بَدَنِي،"
  },
  {
   "segment_id": 3,
   "arabic": "وَنَوّرْ بِالقُرْآنِ بَصَرِي،"
  },
  {
   "segment_id": 4,
   "arabic": "وَأَطْلِقْ بِالقُرْآنِ لِسَانِي،"
  },
  {
   "segment_id": 5,
   "arabic": "وَأَعِنّي عَلَيْهِ مَا أَبْقَيْتَنِي"
  },
  {
   "segment_id": 6,
   "arabic": "فَإِنّهُ لا حَوْلَ وَلا قُوّةَ إِلاَّ بِكَ."
  }
 ]
}