{
 "dua_id": "dua-iftitah",
 "dua_name_en": "Dua Iftitah",
 "dua_name_ar": "دعاء الأفتتاح",
 "source": "https://www.duaplayer.org/en/dua/iftitah",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ للهِ الرَّحمْنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "اللَّهُمَّ إِنِىّ أَفْتَتِحُ الثَّنَاءَ بِحَمْدِكَ"
  },
  {
   "segment_id": 4,
   "arabic": "وَ أَنْتَ مُسَدِّدٌ لِلصَّوَابِ بِمَنِّكَ"
  },
  {
   "segment_id": 5,
   "arabic": "وَ أَيْقَنْتُ أَنَّكَ أَنْتَ أَرْحَمُ الرَّاحِمِينَ"
  },
  {
   "segment_id": 6,
   "arabic": "فِي مَوْضِعِ الْعَفْوِ وَالرَّحْمَةِ،"
  },
  {
   "segment_id": 7,
   "arabic": "وَ أَشَدُّ الْمُعَاقِبِينَ فِى مَوْضِعِ النَّكَالِ وَ النَّقِمَةِ"
  },
  {
   "segment_id": 8,
   "arabic": "وَأَعْظَمُ الْمُتَجَبِّرِينَ فِي مَوْضِعِ الْكِبْرِيَاءِ وَالْعَظَمَةِ."
  },
  {
   "segment_id": 9,
   "arabic": "اللَّهُمَّ أَذِنْتَ لِى فِى دُعَائِكَ وَ مَسْأَلَتِكَ"
  },
  {
   "segment_id": 10,
   "arabic": "فَاسْمَعْ يَا سَمِيعُ مِدْحَتِي،"
  },
  {
   "segment_id": 11,
   "arabic": "وَأَجِبْ يَا رَحِيمُ دَعْوَتِي،"
  },
  {
   "segment_id": 12,
   "arabic": "وَأَقِلْ يَا غَفُورُ عَثْرَتِي،"
  },
  {
   "segment_id": 13,
   "arabic": "فَكَمْ يَا إلهِي مِنْ كُرْبَةٍ قَدْ فَرَّجْتَهَا،"
  },
  {
   "segment_id": 14,
   "arabic": "وَهُمُومٍ قَدْ كَشَفْتَهَا،"
  },
  {
   "segment_id": 15,
   "arabic": "وَعَثْرَةٍ قَدْ أَقَلْتَهَا، وَرَحْمَةٍ قَدْ نَشَرْتَهَا،"
  },
  {
   "segment_id": 16,
   "arabic": "وَحَلْقَةِ بَلاءٍ قَدْ فَكَكْتَهَا؟"
  },
  {
   "segment_id": 17,
   "arabic": "الْحَمْدُ لِلّهِ الَّذِي لَمْ يَتَّخِذْ صَاحِبَةً وَلا وَلَداً"
  },
  {
   "segment_id": 18,
   "arabic": "وَلَمْ يَكُنْ لَهُ شَرِيكٌ فِي الْمُلْكِ"
  },
  {
   "segment_id": 19,
   "arabic": "وَلَمْ يَكُنْ لَهُ وَلِيٌّ مِنَ الذُّلِّ وَكَبِّرْهُ تَكْبِيراً."
  },
  {
   "segment_id": 20,
   "arabic": "الْحَمْدُ لِلّهِ بِجَمِيعِ مَحَامِدِهِ كُلِّهَا،"
  },
  {
   "segment_id": 21,
   "arabic": "عَلَى جَمِيعِ نِعَمِهِ كُلِّهَا."
  },
  {
   "segment_id": 22,
   "arabic": "الْحَمْدُ لِلّهِ الَّذِي لا مُضَادَّ لَهُ فِي مُلْكِهِ،"
  },
  {
   "segment_id": 23,
   "arabic": "وَلا مُنَازِعَ لَهُ فِي أَمْرِهِ."
  },
  {
   "segment_id": 24,
   "arabic": "الْحَمْدُ لِلّهِ الَّذِي لا شَرِيكَ لَهُ فِي خَلْقِهِ،"
  },
  {
   "segment_id": 25,
   "arabic": "وَلا شَبِيهَ لَهُ فِي عَظَمَتِهِ."
  },
  {
   "segment_id": 26,
   "arabic": "الْحَمْدُ لِلّهِ الْفَاشِي فِي الْخَلْقِ أَمْرُهُ وَحَمْدُهُ،"
  },
  {
   "segment_id": 27,
   "arabic": "وَحَمْدُهُ، الظَّاهِرِ بِالْكَرَمِ مَجْدُهُ،"
  },
  {
   "segment_id": 28,
   "arabic": "الْبَاسِطِ بِالْجُودِ يَدَهُ،"
  },
  {
   "segment_id": 29,
   "arabic": "الَّذِي لا تَنْقُصُ خَزَائِنُهُ،"
  },
  {
   "segment_id": 30,
   "arabic": "وَلا تَزِيدُهُ كَثْرَةُ الْعَطَاءِ إلاَّ جُوداً وَكَرَماً"
  },
  {
   "segment_id": 31,
   "arabic": "إِنَّهُ هُوَ الْعَزِيزُ الْوَهَّابُ"
  },
  {
   "segment_id": 32,
   "arabic": "اللَّهُمَّ إِنِىّ أَسْأَلُكَ قَلِيلا مِنْ كَثِيرٍ"
  },
  {
   "segment_id": 33,
   "arabic": "مَعَ حَاجَةٍ بِى إِلَيْهِ عَظِيمَةٍ"
  },
  {
   "segment_id": 34,
   "arabic": "وَ غِنَاكَ عَنْهُ قَدِيم"
  },
  {
   "segment_id": 35,
   "arabic": "وَ هُوَ عِنْدِى كَثِيرٌ وَ هُوَ عَلَيْكَ سَهْلٌ يَسِير"
  },
  {
   "segment_id": 36,
   "arabic": "اللَّهُمَّ إِنَّ عَفْوَكَ عَنْ ذَنْبِى وَ تَجَاوُزَكَ عَنْ خَطِ يئَتِى"
  },
  {
   "segment_id": 37,
   "arabic": "وَصَفْحَكَ عَنْ ظُلْمِي، وَسِتْرَكَ عَلَى قَبِيحِ عَمَلِي،"
  },
  {
   "segment_id": 38,
   "arabic": "وَحِلْمَكَ عَنْ كَثِيرِ جُرْمِي"
  },
  {
   "segment_id": 39,
   "arabic": "عِنْدَ مَا كَانَ مِنْ خَطَإي وَعَمْدِي"
  },
  {
   "segment_id": 40,
   "arabic": "أَطْمَعَنِي فِي أَنْ أَسْأَلَكَ مَا لا أَسْتَوْجِبُهُ مِنْكَ"
  },
  {
   "segment_id": 41,
   "arabic": "الَّذِي رَزَقْتَنِي مِنْ رَحْمَتِكَ،"
  },
  {
   "segment_id": 42,
   "arabic": "وَأَرَيْتَنِي مِنْ قُدْرَتِكَ، وَعَرَّفْتَنِي مِنْ إجَابَتِكَ،"
  },
  {
   "segment_id": 43,
   "arabic": "فَصِرْتُ أَدْعُوكَ آمِناً، وَأَسْأَلُكَ مُسْتَأْنِساً"
  },
  {
   "segment_id": 44,
   "arabic": "لا خَائِفاً وَلا وَجِلاً،"
  },
  {
   "segment_id": 45,
   "arabic": "مُدِلاً عَلَيْكَ فِيمَا قَصَدْتُ فِيهِ إلَيْكَ،"
  },
  {
   "segment_id": 46,
   "arabic": "فَإنْ أَبْطَأ عَنِّي عَتَبْتُ بِجَهْلِي عَلَيْكَ،"
  },
  {
   "segment_id": 47,
   "arabic": "وَلَعَلَّ الَّذِي أَبْطَأَ عَنِّي هُوَ خَيْرٌ لِي لِعِلْمِكَ بِعَاقِبَةِ الأُمُورِ،"
  },
  {
   "segment_id": 48,
   "arabic": "فَلَمْ أَرَ مَوْلَىً كَرِيماً"
  },
  {
   "segment_id": 49,
   "arabic": "أَصْبَرَ عَلَى عَبْدٍ لَئِيمٍ مِنْكَ عَلَيَّ،"
  },
  {
   "segment_id": 50,
   "arabic": "يَارَبِّ، إنَّكَ تَدْعُونِي فَأُوَلِّي عَنْكَ،"
  },
  {
   "segment_id": 51,
   "arabic": "وَتَتَحَبَّبُ إلَيَّ فأَتَبَغَّضُ إلَيْكَ،"
  },
  {
   "segment_id": 52,
   "arabic": "وَ تَتَوَدَّدُ إِلَىَّ فَلا أَقْبَلُ مِنْكَ كَأَنَّ لِىَ التَّطَوُّلَ عَلَيْكَ"
  },
  {
   "segment_id": 53,
   "arabic": "فَلَمْ يَمْنَعْكَ ذلِكَ مِنَ الرَّحْمَةِ لِي"
  },
  {
   "segment_id": 54,
   "arabic": "وَ الْإِحْسَانِ إِلَىَّ"
  },
  {
   "segment_id": 55,
   "arabic": "وَالتَّفَضُّلِ عَلَيَّ بِجُودِكَ وَكَرَمِكَ،"
  },
  {
   "segment_id": 56,
   "arabic": "فَارْحَمْ عَبْدَكَ الْجَاهِلَ"
  },
  {
   "segment_id": 57,
   "arabic": "وَجُدْ عَلَيْهِ بِفَضْلِ إحْسَانِكَ"
  },
  {
   "segment_id": 58,
   "arabic": "إنَّكَ جَوَادٌ كَرِيمٌ."
  },
  {
   "segment_id": 59,
   "arabic": "الْحَمْدُ لِلّهِ مَالِكِ الْمُلْكِ، مُجْرِي الْفُلْكِ،"
  },
  {
   "segment_id": 60,
   "arabic": "مُسَخِّرِ الرِّيَاحِ، فَالِقِ الإصْبَاحِ،"
  },
  {
   "segment_id": 61,
   "arabic": "دَيَّانِ الدِّينِ، رَبِّ الْعَالَمِينَ."
  },
  {
   "segment_id": 62,
   "arabic": "الْحَمْدُ لِلّهِ عَلَى حِلْمِهِ بَعْدَ عِلْمِهِ،"
  },
  {
   "segment_id": 63,
   "arabic": "وَالْحَمْدُ لِلّهِ عَلَى عَفْوِهِ بَعْدَ قُدْرَتِهِ،"
  },
  {
   "segment_id": 64,
   "arabic": "وَالْحَمْدُ لِلّهِ عَلَى طُولِ أَنَاتِهِ فِي غَضَبِهِ"
  },
  {
   "segment_id": 65,
   "arabic": "وَهُوَ قَادِرٌ عَلَى مَا يُرِيدُ."
  },
  {
   "segment_id": 66,
   "arabic": "الْحَمْدُ لِلّهِ خَالِقِ الْخَلْقِ،"
  },
  {
   "segment_id": 67,
   "arabic": "بَاسِطِ الرِّزْقِ، فَالِقِ الإصْبَاحِ،"
  },
  {
   "segment_id": 68,
   "arabic": "ذِي الْجَلالِ وَالإكْرَامِ وَالْفَضْلِ وَالإنْعَامِ"
  },
  {
   "segment_id": 69,
   "arabic": "الَّذِي بَعُدَ فَلا يُرَى، وَقَرُبَ فَشَهِدَ النَّجْوَى،"
  },
  {
   "segment_id": 70,
   "arabic": "تَبَارَكَ وَتَعَالَى."
  },
  {
   "segment_id": 71,
   "arabic": "الْحَمْدُ لِلّهِ الَّذِي لَيْسَ لَهُ مُنَازِعٌ يُعَادِلُهُ،"
  },
  {
   "segment_id": 72,
   "arabic": "وَلا شَبِيهٌ يُشَاكِلُهُ،"
  },
  {
   "segment_id": 73,
   "arabic": "وَلا ظَهِيرٌ يُعَاضِدُهُ،"
  },
  {
   "segment_id": 74,
   "arabic": "قَهَرَ بِعِزَّتِهِ الأَعِزَّاءَ،"
  },
  {
   "segment_id": 75,
   "arabic": "وَتَوَاضَعَ لِعَظَمَتِهِ الْعُظَمَاءُ،"
  },
  {
   "segment_id": 76,
   "arabic": "فَبَلَغَ بِقُدْرَتِهِ مَا يَشَاءُ."
  },
  {
   "segment_id": 77,
   "arabic": "الْحَمْدُ لِلّهِ الَّذِي يُجِيبُنِي حِينَ أُنَادِيهِ،"
  },
  {
   "segment_id": 78,
   "arabic": "وَيَسْتُرُ عَلَيَّ كُلَّ عَوْرَةٍ وَأَنَا أَعْصِيهِ،"
  },
  {
   "segment_id": 79,
   "arabic": "وَيُعَظِّمُ النِّعْمَةَ عَلَيَّ فَلا أُجَازِيهِ،"
  },
  {
   "segment_id": 80,
   "arabic": "فَكَمْ مِنْ مَوْهِبَةٍ هَنِيئَةٍ قَدْ أَعْطَانِي،"
  },
  {
   "segment_id": 81,
   "arabic": "وَعَظِيمَةٍ مَخُوفَةٍ قَدْ كَفَانِي،"
  },
  {
   "segment_id": 82,
   "arabic": "وَبَهْجَةٍ مُونِقَةٍ قَدْ أَرَانِي؟"
  },
  {
   "segment_id": 83,
   "arabic": "فَأُثْنِي عَلَيْهِ حَامِداً، وَأَذْكُرُهُ مُسَبِّحاً."
  },
  {
   "segment_id": 84,
   "arabic": "الْحَمْدُ لِلّهِ الَّذِي لا يُهْتَكُ حِجَابُهُ،"
  },
  {
   "segment_id": 85,
   "arabic": "وَلا يُغْلَقُ بَابُهُ،"
  },
  {
   "segment_id": 86,
   "arabic": "وَلا يُرَدُّ سَائِلُهُ،"
  },
  {
   "segment_id": 87,
   "arabic": "وَلا يُخَيَّبُ آمِلُهُ."
  },
  {
   "segment_id": 88,
   "arabic": "الْحَمْدُ لِلّهِ الَّذِي يُؤْمِنُ الْخَائِفِينَ،"
  },
  {
   "segment_id": 89,
   "arabic": "وَيُنَجِّي الصَّالِحِينَ، وَيَرْفَعُ الْمُسْتَضْعَفِينَ،"
  },
  {
   "segment_id": 90,
   "arabic": "وَيَضَعُ الْمُسْتَكْبِرِينَ، وَيُهْلِكُ مُلُوكاً"
  },
  {
   "segment_id": 91,
   "arabic": "وَيَسْتَخْلِفُ آخَرِينَ؛"
  },
  {
   "segment_id": 92,
   "arabic": "وَالْحَمْدُ لِلّهِ قَاصِمِ الْجَبَّارِينَ،"
  },
  {
   "segment_id": 93,
   "arabic": "مُبِيرِ الظَّالِمِينَ، مُدْرِكِ الْهَارِبِينَ،"
  },
  {
   "segment_id": 94,
   "arabic": "نَكَالِ الظَّالِمِينَ، صَرِيخِ الْمُسْتَصْرِخِينَ،"
  },
  {
   "segment_id": 95,
   "arabic": "مَوْضِعِ حَاجَاتِ الطَّالِبِينَ مُعْتَمَدِ الْمُؤْمِنِينَ"
  },
  {
   "segment_id": 96,
   "arabic": "الْحَمْدُ لِلّهِ الَّذِي مِنْ خَشْيَتِهِ تَرْعُدُ السَّمَاءُ وَسُكَّانُهَا،"
  },
  {
   "segment_id": 97,
   "arabic": "وَتَرْجُفُ الأَرْضُ وَعُمَّارُهَا،"
  },
  {
   "segment_id": 98,
   "arabic": "وَتَمُوجُ الْبِحَارُ وَمَنْ يَسْبَحُ فِي غَمَرَاتِهَا،"
  },
  {
   "segment_id": 99,
   "arabic": "الْحَمْدُ لِلّهِ الَّذِي هَدَانَا لِهذَا"
  },
  {
   "segment_id": 100,
   "arabic": "وَمَا كُنَّا لِنَهْتَدِيَ لَوْلا أَنْ هَدَانَا اللّهُ."
  },
  {
   "segment_id": 101,
   "arabic": "الْحَمْدُ لِلّهِ الَّذِي يَخْلُقُ وَلَمْ يُخْلَقْ،"
  },
  {
   "segment_id": 102,
   "arabic": "وَيَرْزُقُ وَلا يُرْزَقُ، وَيُطْعِمُ وَلا يُطْعَمُ،"
  },
  {
   "segment_id": 103,
   "arabic": "وَيُمِيتُ الأَحْيَاءَ، وَيُحْيِي الْمَوْتَى،"
  },
  {
   "segment_id": 104,
   "arabic": "وَهُوَ حَيٌّ لا يَمُوتُ، بِيَدِهِ الْخَيْرُ،"
  },
  {
   "segment_id": 105,
   "arabic": "وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ."
  },
  {
   "segment_id": 106,
   "arabic": "اللّهُمَّ صَلِّ عَلَى مُحَمَّدٍ عَبْدِكَ وَرَسُولِكَ"
  },
  {
   "segment_id": 107,
   "arabic": "وَأَمِينِكَ وَصَفِيِّكَ وَحَبِيبِكَ"
  },
  {
   "segment_id": 108,
   "arabic": "وَخِيَرَتِكَ مِنْ خَلْقِكَ،"
  },
  {
   "segment_id": 109,
   "arabic": "وَحَافِظِ سِرِّكَ، وَمُبَلِّغِ رِسَالاتِكَ"
  },
  {
   "segment_id": 110,
   "arabic": "أَفْضَلَ وَأَحْسَنَ وَأَجْمَلَ"
  },
  {
   "segment_id": 111,
   "arabic": "وَأَكْمَلَ وَأَزْكَى"
  },
  {
   "segment_id": 112,
   "arabic": "وَأَنْمَى وَأَطْيَبَ وَأَطْهَرَ وَأَسْنَى"
  },
  {
   "segment_id": 113,
   "arabic": "وَأَكْثَرَ مَا صَلَّيْتَ وَبَارَكْتَ وَتَرَحَّمْتَ"
  },
  {
   "segment_id": 114,
   "arabic": "وَ تَحَنَّنْتَ وَ سَلَّمْتَ"
  },
  {
   "segment_id": 115,
   "arabic": "عَلَى أَحَدٍ مِنْ عِبَادِكَ وَأَنْبِيَائِكَ"
  },
  {
   "segment_id": 116,
   "arabic": "وَ رُسُلِكَ وَ صِفْوَتِكَ"
  },
  {
   "segment_id": 117,
   "arabic": "وَ أَهْلِ الْكَرَامَةِ عَلَيْكَ مِنْ خَلْقِكَ."
  },
  {
   "segment_id": 118,
   "arabic": "اللَّهُمَّ وَ صَلِّ عَلَى عَلِىٍّ أَمِيرِ الْمُؤْمِنِينَ"
  },
  {
   "segment_id": 119,
   "arabic": "وَ وَصِىِّ رَسُولِ رَبِّ الْعَالَمِينَ،"
  },
  {
   "segment_id": 120,
   "arabic": "عَبْدِكَ وَ وَلِيِّكَ"
  },
  {
   "segment_id": 121,
   "arabic": "وَ أَخِى رَسُولِكَ وَ حُجَّتِكَ عَلَى خَلْقِكَ"
  },
  {
   "segment_id": 122,
   "arabic": "وَ آيَتِكَ الْكُبْرَى وَ النَّبَإِ الْعَظِيمِ"
  },
  {
   "segment_id": 123,
   "arabic": "وَ صَلِّ عَلَى الصِّدِّيقَةِ الطَّاهِرَةِ"
  },
  {
   "segment_id": 124,
   "arabic": "فَاطِمَةَ الزَّهْرَاءِ سَيِّدَةِ نِسَاءِ الْعَالَمِينَ"
  },
  {
   "segment_id": 125,
   "arabic": "وَصَلِّ عَلَى سِبْطَيِ الرَّحْمَةِ،"
  },
  {
   "segment_id": 126,
   "arabic": "وَإمَامَيِ الْهُدَى"
  },
  {
   "segment_id": 127,
   "arabic": "الْحَسَنِ وَالْحُسَيْنِ"
  },
  {
   "segment_id": 128,
   "arabic": "سَيِّدَيْ شَبَابِ أَهْلِ الْجَنَّةِ،"
  },
  {
   "segment_id": 129,
   "arabic": "وَصَلِّ عَلَى أَئِمَّةِ الْمُسْلِمِينَ:"
  },
  {
   "segment_id": 130,
   "arabic": "عَلِيِّ بْنِ الْحُسَيْنِ"
  },
  {
   "segment_id": 131,
   "arabic": "وَ مُحَمَّدِ بْنِ عَلِىٍّ"
  },
  {
   "segment_id": 132,
   "arabic": "وَ جَعْفَرِ بْنِ مُحَمَّدٍ"
  },
  {
   "segment_id": 133,
   "arabic": "وَ مُوسَى بْنِ جَعْفَرٍ"
  },
  {
   "segment_id": 134,
   "arabic": "وَ عَلِىِّ بْنِ مُوسَى"
  },
  {
   "segment_id": 135,
   "arabic": "وَ مُحَمَّدِ بْنِ عَلِىٍّ"
  },
  {
   "segment_id": 136,
   "arabic": "وَ عَلِىِّ بْنِ مُحَمَّدٍ"
  },
  {
   "segment_id": 137,
   "arabic": "وَالْحَسَنِ بْنِ عَلِيٍّ،"
  },
  {
   "segment_id": 138,
   "arabic": "وَالْخَلَفِ الْهَادِي الْمَهْدِيِّ،"
  },
  {
   "segment_id": 139,
   "arabic": "حُجَجِكَ عَلَى عِبَادِكَ وَ أُمَنَائِكَ فِى بِلادِكَ"
  },
  {
   "segment_id": 140,
   "arabic": "صَلاةً كَثِيرَةً دَائِمَةً."
  },
  {
   "segment_id": 141,
   "arabic": "اللّهُمَّ وَصَلِّ عَلَى وَليِّ أَمْرِكَ الْقَائِمِ الْمُؤَمَّلِ،"
  },
  {
   "segment_id": 142,
   "arabic": "وَ الْعَدْلِ الْمُنْتَظَرِ"
  },
  {
   "segment_id": 143,
   "arabic": "وَ حُفَّهُ بِمَلائِكَتِكَ الْمُقَرَّبِينَ"
  },
  {
   "segment_id": 144,
   "arabic": "وَأَيِّدْهُ بِرُوحِ الْقُدُسِ يَارَبَّ الْعَالَمِينَ."
  },
  {
   "segment_id": 145,
   "arabic": "اللَّهُمَّ اجْعَلْهُ الدَّاعِىَ إِلَى كِتَابِكَ"
  },
  {
   "segment_id": 146,
   "arabic": "وَ الْقَائِمَ بِدِينِكَ"
  },
  {
   "segment_id": 147,
   "arabic": "اسْتَخْلِفْهُ فِى الْأَرْضِ"
  },
  {
   "segment_id": 148,
   "arabic": "كَمَا اسْتَخْلَفْتَ الَّذِينَ مِنْ قَبْلِهِ"
  },
  {
   "segment_id": 149,
   "arabic": "مَكِّنْ لَهُ دِينَهُ الَّذِ ى ارْتَضَيْتَهُ لَه"
  },
  {
   "segment_id": 150,
   "arabic": "أَبْدِلْهُ مِنْ بَعْدِ خَوْفِهِ أَمْناً"
  },
  {
   "segment_id": 151,
   "arabic": "يَعْبُدُكَ لا يُشْرِكُ بِكَ شَيْئاً."
  },
  {
   "segment_id": 152,
   "arabic": "اللَّهُمَّ أَعِزَّهُ وَ أَعْزِزْ بِهِ"
  },
  {
   "segment_id": 153,
   "arabic": "وَ انْصُرْهُ وَ انْتَصِرْ بِهِ"
  },
  {
   "segment_id": 154,
   "arabic": "وَ انْصُرْهُ نَصْرا عَزِيزا"
  },
  {
   "segment_id": 155,
   "arabic": "وَ افْتَحْ لَهُ فَتْحا يَسِيرا"
  },
  {
   "segment_id": 156,
   "arabic": "وَاجْعَلْ لَهُ مِنْ لَدُنْكَ سُلْطَاناً نَصِيراً."
  },
  {
   "segment_id": 157,
   "arabic": "اللَّهُمَّ أَظْهِرْ بِهِ دِينَكَ"
  },
  {
   "segment_id": 158,
   "arabic": "وَ سُنَّةَ نَبِيِّكَ"
  },
  {
   "segment_id": 159,
   "arabic": "حَتَّى لا يَسْتَخْفِيَ بِشَيْءٍ مِنَ الْحَقِّ"
  },
  {
   "segment_id": 160,
   "arabic": "مَخَافَةَ أَحَدٍ مِنَ الْخَلْقِ."
  },
  {
   "segment_id": 161,
   "arabic": "اللّهُمَّ إنَّا نَرْغَبُ إلَيْكَ فِي دَوْلَةٍ كَرِيمَةٍ"
  },
  {
   "segment_id": 162,
   "arabic": "تُعِزُّ بِهَا الإسْلامَ وَأَهْلَهُ،"
  },
  {
   "segment_id": 163,
   "arabic": "وَتُذِلُّ بِهَا النِّفَاقَ وَأَهْلَهُ،"
  },
  {
   "segment_id": 164,
   "arabic": "وَ تَجْعَلُنَا فِيهَا مِنَ الدُّعَاةِ إِلَى طَاعَتِكَ"
  },
  {
   "segment_id": 165,
   "arabic": "وَ الْقَادَةِ إِلَى سَبِيلِكَ"
  },
  {
   "segment_id": 166,
   "arabic": "وَتَرْزُقُنَا بِهَا كَرَامَةَ الدُّنْيَا وَالآخِرَةِ."
  },
  {
   "segment_id": 167,
   "arabic": "اللّهُمَّ مَا عَرَّفْتَنَا مِنَ الْحَقِّ فَحَمِّلْنَاهُ،"
  },
  {
   "segment_id": 168,
   "arabic": "وَمَا قَصُرْنَا عَنْهُ فَبَلِّغْنَاهُ."
  },
  {
   "segment_id": 169,
   "arabic": "اللّهُمَّ الْمُمْ بِه شَعَثَنَا،"
  },
  {
   "segment_id": 170,
   "arabic": "وَاشْعَبْ بِهِ صَدْعَنَا،"
  },
  {
   "segment_id": 171,
   "arabic": "وَ ارْتُقْ بِهِ فَتْقَنَا وَ كَثِّرْ بِهِ قِلَّتَنَا"
  },
  {
   "segment_id": 172,
   "arabic": "وَ أَعْزِزْ بِهِ ذِلَّتَنَا وَ أَغْنِ بِهِ عَائِلَنَا"
  },
  {
   "segment_id": 173,
   "arabic": "وَاقْضِ بِهِ عَنْ مُغْرَمِنَا، وَاجْبُرْ بِهِ فَقْرَنَا،"
  },
  {
   "segment_id": 174,
   "arabic": "وَسُدَّ بِهِ خَلَّتَنَا، وَيَسِّرْ بِهِ عُسْرَنَا،"
  },
  {
   "segment_id": 175,
   "arabic": "وَبَيِّضْ بِهِ وُجُوهَنَا، وَفُكَّ بِهِ أَسْرَنَا،"
  },
  {
   "segment_id": 176,
   "arabic": "وَأَنْجِحْ بِهِ طَلِبَتَنَا، وَأَنْجِزْ بِهِ مَوَاعِيدَنَا،"
  },
  {
   "segment_id": 177,
   "arabic": "وَ اسْتَجِبْ بِهِ دَعْوَتَنَا وَ أَعْطِنَا بِهِ سُؤْلَنَا"
  },
  {
   "segment_id": 178,
   "arabic": "وَبَلِّغْنَا بِهِ مِنَ الدُّنْيَا وَالآخِرَةِ آمَالَنَا،"
  },
  {
   "segment_id": 179,
   "arabic": "وَ أَعْطِنَا بِهِ فَوْقَ رَغْبَتِنَا"
  },
  {
   "segment_id": 180,
   "arabic": "يَا خَيْرَ الْمَسْؤُولِينَ، وَأَوْسَعَ الْمُعْطِينَ،"
  },
  {
   "segment_id": 181,
   "arabic": "اشْفِ بِهِ صُدُورَنَا، وَأَذْهِبْ بِهِ غَيْظَ قُلُوبِنَا،"
  },
  {
   "segment_id": 182,
   "arabic": "وَاهْدِنَا بِهِ لِمَا اخْتُلِفَ فِيهِ مِنَ الْحَقِّ بِإذْنِكَ،"
  },
  {
   "segment_id": 183,
   "arabic": "إنَّكَ تَهْدِي مَنْ تَشَاءُ إلَى صِرَاطٍ مُسْتَقِيمٍ،"
  },
  {
   "segment_id": 184,
   "arabic": "وَانْصُرْنَا بِهِ عَلَى عَدُوِّكَ وَعَدُوِّنَا"
  },
  {
   "segment_id": 185,
   "arabic": "إلهَ الْحَقِّ آمِينَ."
  },
  {
   "segment_id": 186,
   "arabic": "اللّهُمَّ إنَّا نَشْكُو إلَيْكَ فَقْدَ نَبِيِّنَا"
  },
  {
   "segment_id": 187,
   "arabic": "صَلَوَاتُكَ عَلَيْهِ وَ آلِهِ"
  },
  {
   "segment_id": 188,
   "arabic": "وَغَيْبَةَ وَلِيِّنَا، وَكَثْرَةَ عَدُوِّنَا،"
  },
  {
   "segment_id": 189,
   "arabic": "وَقِلَّةَ عَدَدِنَا، وَشِدَّةَ الْفِتَنِ بِنَا،"
  },
  {
   "segment_id": 190,
   "arabic": "وَتَظَاهُرَ الزَّمَانِ عَلَيْنَا،"
  },
  {
   "segment_id": 191,
   "arabic": "فَصَلِّ عَلَى مُحَمَّدٍ وَآلِهِ،"
  },
  {
   "segment_id": 192,
   "arabic": "وَأَعِنَّا عَلَى ذلِكَ بِفَتْحٍ مِنْكَ تُعَجِّلُهُ،"
  },
  {
   "segment_id": 193,
   "arabic": "وَبِضُرٍّ تَكْشِفُهُ، وَنَصْرٍ تُعِزُّهُ،"
  },
  {
   "segment_id": 194,
   "arabic": "وَسُلْطَانِ حَقٍّ تُظْهِرُهُ،"
  },
  {
   "segment_id": 195,
   "arabic": "وَرَحْمَةٍ مِنْكَ تُجَلِّلُنَاهَا"
  },
  {
   "segment_id": 196,
   "arabic": "وَعَافِيَةٍ مِنْكَ تُلْبِسُنَاهَا،"
  },
  {
   "segment_id": 197,
   "arabic": "بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِينَ."
  }
 ]
}