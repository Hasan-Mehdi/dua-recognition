{
 "dua_id": "sahifa-43",
 "dua_name_en": "Sahifa 43: When he looked at the new crescent moon",
 "dua_name_ar": "د دُعَاؤُهُ إِذَا نَظَرَ إِلَى الْهِلَالِ",
 "source": "https://duas.pro/43-when-he-looked-at-the-new-crescent-moon",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "أَيُّهَا ٱلْخَلْقُ ٱلْمُطِيعُ"
  },
  {
   "segment_id": 2,
   "arabic": "ٱلدَّائِبُ ٱلسَّرِيعُ"
  },
  {
   "segment_id": 3,
   "arabic": "ٱلْمُتَرَدِّدُ فِي مَنَازِلِ ٱلتَّقْدِيرِ"
  },
  {
   "segment_id": 4,
   "arabic": "ٱلْمُتَصَرِّفُ فِي فَلَكِ ٱلتَّدْبِيرِ"
  },
  {
   "segment_id": 5,
   "arabic": "آمَنْتُ بِمَنْ نَوَّرَ بِكَ ٱلظُّلَمَ"
  },
  {
   "segment_id": 6,
   "arabic": "وَأَوْضَحَ بِكَ ٱلْبُهَمَ"
  },
  {
   "segment_id": 7,
   "arabic": "وَجَعَلَكَ آيَةً مِنْ آيَاتِ مُلْكِهِ"
  },
  {
   "segment_id": 8,
   "arabic": "وَعَلاَمَةً مِنْ عَلاَمَاتِ سُلْطَانِهِ"
  },
  {
   "segment_id": 9,
   "arabic": "فَحَدَّ بِكَ ٱلزَّمَانَ"
  },
  {
   "segment_id": 10,
   "arabic": "وَٱمْتَهَنَكَ بِٱلْكَمَالِ وَٱلنُّقْصَانِ"
  },
  {
   "segment_id": 11,
   "arabic": "وَٱلطُّلُوعِ وَٱلأُفُولِ"
  },
  {
   "segment_id": 12,
   "arabic": "وَٱلإِنَارَةِ وَٱلْكُسُوفِ"
  },
  {
   "segment_id": 13,
   "arabic": "فِي كُلِّ ذٰلِكَ أَنْتَ لَهُ مُطِيعٌ"
  },
  {
   "segment_id": 14,
   "arabic": "وَإِلَىٰ إِرَادَتِهِ سَرِيعٌ"
  },
  {
   "segment_id": 15,
   "arabic": "سُبْحَانَهُ مَا أَعْجَبَ مَا دَبَّرَ مِنْ أَمْرِكَ"
  },
  {
   "segment_id": 16,
   "arabic": "وَأَلْطَفَ مَا صَنَعَ فِي شَأْنِكَ"
  },
  {
   "segment_id": 17,
   "arabic": "جَعَلَكَ مِفْتَاحَ شَهْرٍ حَادِثٍ لأَمْرٍ حَادِثٍ"
  },
  {
   "segment_id": 18,
   "arabic": "فَأَسْأَلُ ٱللَّهَ رَبِّي وَرَبَّكَ"
  },
  {
   "segment_id": 19,
   "arabic": "وَخَالِقِي وَخَالِقَكَ"
  },
  {
   "segment_id": 20,
   "arabic": "وَمُقَدِّرِي وَمُقَدِّرَكَ"
  },
  {
   "segment_id": 21,
   "arabic": "وَمُصَوِّرِي وَمُصَوِّرَكَ"
  },
  {
   "segment_id": 22,
   "arabic": "أَنْ يُصَلِّيَ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 23,
   "arabic": "وَأَنْ يَجْعَلَكَ هِلاَلَ بَرَكَةٍ لاَ تَمْحَقُهَا ٱلأَيَّامُ"
  },
  {
   "segment_id": 24,
   "arabic": "وَطَهَارَةٍ لاَ تُدَنِّسُهَا ٱلآثَامُ"
  },
  {
   "segment_id": 25,
   "arabic": "هِلاَلَ أَمْنٍ مِنَ ٱلآفَاتِ"
  },
  {
   "segment_id": 26,
   "arabic": "وَسَلاَمَةٍ مِنَ ٱلسَّيِّئَاتِ"
  },
  {
   "segment_id": 27,
   "arabic": "هِلاَلَ سَعْدٍ لاَ نَحْسَ فِيهِ"
  },
  {
   "segment_id": 28,
   "arabic": "وَيُمْنٍ لاَ نَكَدَ مَعَهُ"
  },
  {
   "segment_id": 29,
   "arabic": "وَيُسْرٍ لاَ يُمَازِجُهُ عُسْرٌ"
  },
  {
   "segment_id": 30,
   "arabic": "وَخيْرٍ لاَ يَشُوبُهُ شَرٍّ"
  },
  {
   "segment_id": 31,
   "arabic": "هِلالَ أَمْنٍ وَإِيـمَانٍ"
  },
  {
   "segment_id": 32,
   "arabic": "وَنِعْمَةٍ وَإِحْسَانٍ"
  },
  {
   "segment_id": 33,
   "arabic": "وَسَلاَمَةٍ وَإِسْلاَمٍ"
  },
  {
   "segment_id": 34,
   "arabic": "اللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 35,
   "arabic": "وَٱجْعَلْنَا مِنْ أَرْضَىٰ مَنْ طَلَعَ عَلَيْهِ"
  },
  {
   "segment_id": 36,
   "arabic": "وَأَزْكَىٰ مَنْ نَظَرَ إِلَيْهِ"
  },
  {
   "segment_id": 37,
   "arabic": "وَأَسْعَدَ مَنْ تَعَبَّدَ لَكَ فِيهِ"
  },
  {
   "segment_id": 38,
   "arabic": "وَوَفِّقْنَا ٱللَّهُمَّ فِيهِ لِلطَّاعَةِ وَٱلتَّوْبَةِ"
  },
  {
   "segment_id": 39,
   "arabic": "وَٱعْصِمْنَا فِيهِ مِنَ ٱلآثَامِ وَٱلْحَوْبَةِ"
  },
  {
   "segment_id": 40,
   "arabic": "وَأَوْزِعْنَا فِيهِ شُكْرَ ٱلنِّعْمَةِ"
  },
  {
   "segment_id": 41,
   "arabic": "وَأَلْبِسْنَا فِيهِ جُنَنَ ٱلْعَافِيَةِ"
  },
  {
   "segment_id": 42,
   "arabic": "وَأَتْمِمْ عَلَيْنَا بِٱسْتِكْمَالِ طَاعَتِكَ فِيهِ ٱلْمِنَّةَ"
  },
  {
   "segment_id": 43,
   "arabic": "إِنَّكَ أَنْتَ ٱلْمَنَّانُ ٱلْحَمِيدُ"
  },
  {
   "segment_id": 44,
   "arabic": "وَصَلَّىٰ ٱللَّهُ عَلَىٰ مُحَمَّدٍ وَآلِهِ ٱلطَّيِّبِينَ"
  },
  {
   "segment_id": 45,
   "arabic": "وَٱجْعَلْ لَنَا فِيهِ عَوْناً مِنْكَ عَلَىٰ مَا نَدَبْتَنَا إِلَيْهِ"
  },
  {
   "segment_id": 46,
   "arabic": "مِنْ مُفْتَرَضِ طَاعَتِكَ"
  },
  {
   "segment_id": 47,
   "arabic": "وَتَقَبَّلْهَا إِنَّكَ ٱلأَكْرَمُ مِنْ كُلِّ كَرِيمٍ"
  },
  {
   "segment_id": 48,
   "arabic": "وَٱلأَرْحَمُ مِنْ كُلِّ رَحِيمٍ"
  },
  {
   "segment_id": 49,
   "arabic": "آمِينَ آمِينَ رَبَّ ٱلْعَالَمِينَ"
  }
 ]
}