{
 "dua_id": "dua-ramadan-27-night",
 "dua_name_en": "Dua Night 27",
 "dua_name_ar": "",
 "source": "https://www.duaplayer.org/en/dua/ramadan-27-night",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "يَا مَادَّ ٱلظِّلِّ"
  },
  {
   "segment_id": 4,
   "arabic": "وَلَوْ شِئْتَ لَجَعَلْتَهُ سَاكِناً"
  },
  {
   "segment_id": 5,
   "arabic": "وَجَعَلْتَ ٱلشَّمْسَ عَلَيْهِ دَلِيلاً"
  },
  {
   "segment_id": 6,
   "arabic": "ثُمَّ قَبَضْتَهُ إِلَيْكَ قَبْضاً يَسِيراً"
  },
  {
   "segment_id": 7,
   "arabic": "يَاذَا ٱلْجُودِ وَٱلطَّوْلِ"
  },
  {
   "segment_id": 8,
   "arabic": "وَٱلْكِبْرِيَاءِ وَٱلآلاَءِ"
  },
  {
   "segment_id": 9,
   "arabic": "لاَ إِلٰهَ إِلاَّ انْتَ"
  },
  {
   "segment_id": 10,
   "arabic": "عَالِمُ ٱلْغَيْبِ وَٱلشَّهَادَةِ"
  },
  {
   "segment_id": 11,
   "arabic": "ٱلرَّحْمٰنُ ٱلرَّحِيمُ"
  },
  {
   "segment_id": 12,
   "arabic": "لاَ إِلٰهَ إِلاَّ انْتَ"
  },
  {
   "segment_id": 13,
   "arabic": "يَا قُدُّوسُ يَا سَلاَمُ"
  },
  {
   "segment_id": 14,
   "arabic": "يَا مُؤْمِنُ يَا مُهَيْمِنُ"
  },
  {
   "segment_id": 15,
   "arabic": "يَا عَزِيزُ يَا جَبَّارُ"
  },
  {
   "segment_id": 16,
   "arabic": "يَا مُتَكَبِّرُ يَا اللَّهُ"
  },
  {
   "segment_id": 17,
   "arabic": "يَا خَالِقُ يَا بَارِئُ يَا مُصَوِّرُ"
  },
  {
   "segment_id": 18,
   "arabic": "يَا اللَّهُ يَا اللَّهُ يَا اللَّهُ"
  },
  {
   "segment_id": 19,
   "arabic": "لَكَ ٱلاسْمَاءُ ٱلْحُسْنَىٰ"
  },
  {
   "segment_id": 20,
   "arabic": "وَٱلامْثَالُ ٱلْعُلْيَا"
  },
  {
   "segment_id": 21,
   "arabic": "وَٱلْكِبْرِيَاءُ وَٱلآلاَءُ"
  },
  {
   "segment_id": 22,
   "arabic": "اسْالُكَ انْ تُصَلِّيَ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 23,
   "arabic": "وَانْ تَجْعَلَ ٱسْمِي فِي هٰذِهِ ٱللَّيْلَةِ فِي ٱلسُّعَدَاءِ"
  },
  {
   "segment_id": 24,
   "arabic": "وَرُوحِي مَعَ ٱلشُّهَدَاءِ"
  },
  {
   "segment_id": 25,
   "arabic": "وَإِحْسَانِي فِي عِلِّيِّينَ"
  },
  {
   "segment_id": 26,
   "arabic": "وَإِسَاءَتِي مَغْفُورَةً"
  },
  {
   "segment_id": 27,
   "arabic": "وَانْ تَهَبَ لِي يَقِيناً تُبَاشِرُ بِهِ قَلْبِي"
  },
  {
   "segment_id": 28,
   "arabic": "وَإِيـمَاناً يُذْهِبُ ٱلشَّكَّ عَنِّي"
  },
  {
   "segment_id": 29,
   "arabic": "وَتُرْضِيَنِي بِمَا قَسَمْتَ لِي"
  },
  {
   "segment_id": 30,
   "arabic": "وَآتِنَا فِي ٱلدُّنْيَا حَسَنَةً"
  },
  {
   "segment_id": 31,
   "arabic": "وَفِي ٱلآخِرَةِ حَسَنَةً"
  },
  {
   "segment_id": 32,
   "arabic": "وَقِنَا عَذَابَ ٱلنَّارِ ٱلْحَرِيقِ"
  },
  {
   "segment_id": 33,
   "arabic": "وَٱرْزُقْنِي فِيهَا ذِكْرَكَ وَشُكْرَكَ وَٱلرَّغْبَةَ إِلَيْكَ"
  },
  {
   "segment_id": 34,
   "arabic": "وَٱلإِنَابَةَ وَٱلتَّوْفِيقَ لِمَا وَفَّقْتَ لَهُ مُحَمَّداً وَآلَ مُحَمَّدٍ عَلَيْهِ وَعَلَيْهِمُ ٱلسَّلاَمُ"
  }
 ]
}