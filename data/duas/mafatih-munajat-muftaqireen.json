{
 "dua_id": "mafatih-munajat-muftaqireen",
 "dua_name_en": "Munajat Muftaqireen",
 "dua_name_ar": "مناجاة المفتقرين",
 "source": "Mafatih al-Jinan (github.com/kazemcodes/MafatihDecoder); lines from reciters' pauses",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "إِلهي كَسْري لا يَجْبُرُهُ إِلاّ لُطْفُكَ وَحَنانُكَ"
  },
  {
   "segment_id": 2,
   "arabic": "وَفَقْري لا يُغْنيهِ إِلاّ عَطْفُكَ وَإِحْسانُكَ"
  },
  {
   "segment_id": 3,
   "arabic": "وَرَوْعَتي لا يُسَكِّنُها إِلاّ أَمانُكَ"
  },
  {
   "segment_id": 4,
   "arabic": "وَذِلَّتي لا يُعِزُّها إِلاّ سُلْطانُكَ"
  },
  {
   "segment_id": 5,
   "arabic": "وَأُمْنِيَّتي لا يُبَلِّغُنيها إِلاّ فَضْلُكَ"
  },
  {
   "segment_id": 6,
   "arabic": "وَخَلَّتي لا يَسُدُّها إِلاّ طَوْلُكَ"
  },
  {
   "segment_id": 7,
   "arabic": "وَحاجَتي لا يَقْضيها غَيْرُكَ"
  },
  {
   "segment_id": 8,
   "arabic": "وَكَرْبي لا يُفَرِّجُهُ سِوى رَحْمَتِكَ"
  },
  {
   "segment_id": 9,
   "arabic": "وَضُرّي لا يَكْشِفُهُ غَيْرُ رَأْفَتِكَ"
  },
  {
   "segment_id": 10,
   "arabic": "وَغُلَّتي لا يُبَرِّدُها إِلاّ وَصْلُكَ"
  },
  {
   "segment_id": 11,
   "arabic": "وَلَوْعَتي لا يُطْفيها إِلاّ لِقاؤُكَ"
  },
  {
   "segment_id": 12,
   "arabic": "وَشَوْقي إِلَيْكَ لا يَبُلُّهُ إِلا النَّظَرُ إِلى وَجْهِكَ"
  },
  {
   "segment_id": 13,
   "arabic": "وَقَراري لا يَقَرُّ دُونَ دُنُوّي مِنْكَ"
  },
  {
   "segment_id": 14,
   "arabic": "وَلَهْفَتي لا يَرُدُّها إِلاّ رَوْحُكَ"
  },
  {
   "segment_id": 15,
   "arabic": "وَسُقْمي لا يَشْفيهِ إِلاّ طِبُّكَ"
  },
  {
   "segment_id": 16,
   "arabic": "وَغَمّي لا يُزيلُهُ إِلاّ قُرْبُكَ"
  },
  {
   "segment_id": 17,
   "arabic": "وَجُرْحي لا يُبْرِئُهُ إِلاّ صَفْحُكَ"
  },
  {
   "segment_id": 18,
   "arabic": "وَرَيْنُ قَلْبي لا يَجْلُوهُ إِلاّ عَفْوُكَ"
  },
  {
   "segment_id": 19,
   "arabic": "وَوَسْواسُ صَدْري لا يُزيحُهُ إِلاّ أَمْرُكَ"
  },
  {
   "segment_id": 20,
   "arabic": "فَيا مُنْتَهى أَمَلِ الآمِلينَ"
  },
  {
   "segment_id": 21,
   "arabic": "وَيا غايَةَ سُؤْلِ السّائِلينَ وَيا أَقْصى طَلِبَةِ الطّالِبينَ"
  },
  {
   "segment_id": 22,
   "arabic": "وَيا أَعْلى رَغْبَةِ الرّاغِبينَ"
  },
  {
   "segment_id": 23,
   "arabic": "وَيا وَلِيَّ الصّالِحينَ وَيا أَمانَ الْخائِفينَ"
  },
  {
   "segment_id": 24,
   "arabic": "وَيا مُجيبَ دَعْوَةِ الْمُضْطَرّينَ"
  },
  {
   "segment_id": 25,
   "arabic": "وَيا ذُخْرَ الْمُعْدِمينَ وَيا كَنْزَ الْبائِسينَ وَيا غِياثَ الْمُسْتَغيثينَ"
  },
  {
   "segment_id": 26,
   "arabic": "وَيا قاضِيَ حَوائِجِ الْفُقَراءِ وَالْمَساكينَ"
  },
  {
   "segment_id": 27,
   "arabic": "وَيا أَكرَمَ الأَكْرَمينَ وَيا أَرْحَمَ الرّاحِمينَ"
  },
  {
   "segment_id": 28,
   "arabic": "لَكَ تَخَضُّعي وَسُؤالي"
  },
  {
   "segment_id": 29,
   "arabic": "وَإِلَيْكَ تَضَرُّعي وَابْتِهالي"
  },
  {
   "segment_id": 30,
   "arabic": "أَسْئَلُكَ أَنْ تُنيلَني مِنْ رَوْحِ رِضْوانِكَ"
  },
  {
   "segment_id": 31,
   "arabic": "وَتُديمَ عَلَيَّ نِعَمَ امْتِنانِكَ"
  },
  {
   "segment_id": 32,
   "arabic": "وَها أَنَا بِبابِ كَرَمِكَ واقِفٌ"
  },
  {
   "segment_id": 33,
   "arabic": "وَلِنَفَحاتِ بِرِّكَ مُتَعَرِّضٌ"
  },
  {
   "segment_id": 34,
   "arabic": "وَبِحَبْلِكَ الشَّديدِ مُعْتَصِمٌ"
  },
  {
   "segment_id": 35,
   "arabic": "وَبِعُرْوَتِكَ الْوُثْقى مُتَمَسِّكٌ"
  },
  {
   "segment_id": 36,
   "arabic": "إِلهي اِرْحَمْ عَبْدَكَ الذَّليلَ ذَا اللِّسانِ الْكَليلِ وَالْعَمَلِ الْقَليلِ"
  },
  {
   "segment_id": 37,
   "arabic": "وَامْنُنْ عَلَيْهِ بِطَوْلِكَ الْجَزيلِ وَاكْنُفْهُ تَحْتَ ظِلِّكَ الظَّليلِ"
  },
  {
   "segment_id": 38,
   "arabic": "يا كَريمُ يا جَميلُ"
  }
 ]
}