{
 "dua_id": "duasorg-sahifa-fatimiya-amaal-for-removal-of-dangers-1",
 "dua_name_en": "Dua of Sayeda Fatima (sa) for safety from dangers",
 "dua_name_ar": "",
 "source": "https://www.duas.org/sahifa-fatimiya-amaal-for-removal-of-dangers.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 2,
   "arabic": "اللَّهُمَّ بِحَقِّ الْعَرْشِ وَ مَنْ عَلَاهُ،"
  },
  {
   "segment_id": 3,
   "arabic": "وَ بِحَقِّ الْوَحْى وَ مَنْ أَوْحَاهُ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَ بِحَقِّ النَّبِيِّ وَمَنْ نَبَّاهُ،"
  },
  {
   "segment_id": 5,
   "arabic": "وَ بِحَقِّ الْبَيْتِ"
  },
  {
   "segment_id": 6,
   "arabic": "وَمَنْ بَنَاهُ يَا سَامِعَ كُلِّ صَوْتٍ،"
  },
  {
   "segment_id": 7,
   "arabic": "يَا جَامِعَ كُلِّ فَوْتٍ،"
  },
  {
   "segment_id": 8,
   "arabic": "يَا بَارِيءَ النُّفُوسِ بَعْدَ الْمَوْتِ،"
  },
  {
   "segment_id": 9,
   "arabic": "صَلِّ عَلَى مُحَمَّدٍ وَ أَهْلِ بَيْتِهِ،"
  },
  {
   "segment_id": 10,
   "arabic": "وَاتِنَا وَ جَمِيعَ الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ،"
  },
  {
   "segment_id": 11,
   "arabic": "فِي مَشَارِقِ الْأَرْضِ وَ مَغَارِبِهَا،"
  },
  {
   "segment_id": 12,
   "arabic": "فَرَجًا مِنْ عِنْدِكَ"
  },
  {
   "segment_id": 13,
   "arabic": "عَاجِلاً بِشَهَادَةِ أَنْ لَا إِلَهَ إِلَّا اللهُ،"
  },
  {
   "segment_id": 14,
   "arabic": "وَ أَنَّ مُحَمَّدًا عَبْدُكَ وَ رَسُولُكَ،"
  },
  {
   "segment_id": 15,
   "arabic": "صَلَّى اللَّهُ عَلَيْهِ وَ عَلَى ذُرِّيَتِهِ الطَّيِّبِينَ"
  },
  {
   "segment_id": 16,
   "arabic": "الطَّاهِرِينَ وَ سَلَّمَ تَسْلِيمًا"
  }
 ]
}