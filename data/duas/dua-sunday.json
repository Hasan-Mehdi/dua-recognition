{
 "dua_id": "dua-sunday",
 "dua_name_en": "Dua Yum al-Ahad",
 "dua_name_ar": "دعاء يوم الأحد",
 "source": "https://www.duaplayer.org/en/dua/sunday",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمٰنِ ٱلرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "بِسْمِ ٱللَّهِ الَّذِي لاَ ارْجُو إِلاَّ فَضْلَهُ"
  },
  {
   "segment_id": 3,
   "arabic": "وَلاَ اخْشىٰ إِلاَّ عَدْلَهُ"
  },
  {
   "segment_id": 4,
   "arabic": "وَلاَ اعْتَمِدُ إِلاَّ قَوْلَهُ"
  },
  {
   "segment_id": 5,
   "arabic": "وَلاَ امْسِكُ إِلاَّ بِحَبْلِهِ"
  },
  {
   "segment_id": 6,
   "arabic": "بِكَ اسْتَجِيـرُ يَا ذَا ٱلْعَفْوِ وَٱلرِّضْوَانِ"
  },
  {
   "segment_id": 7,
   "arabic": "مِنَ ٱلظُّلْمِ وَٱلْعُدْوَانِ"
  },
  {
   "segment_id": 8,
   "arabic": "وَمِنْ غِيَرِ ٱلزَّمَانِ"
  },
  {
   "segment_id": 9,
   "arabic": "وَتَوَاتُرِ ٱلاحْزَانِ"
  },
  {
   "segment_id": 10,
   "arabic": "وَطَوَارِقِ ٱلْحَدَثَانِ"
  },
  {
   "segment_id": 11,
   "arabic": "وَمِنِ ٱنْقِضَاءِ ٱلْمُدَّةِ قَبْلَ ٱلتَّاهُّبِ وَٱلْعُدَّةِ"
  },
  {
   "segment_id": 12,
   "arabic": "وَإِيَّاكَ اسْتَرْشِدُ لِمَا فيهِ ٱلصَّلاَحُ وَٱلإِصْلاَحُ"
  },
  {
   "segment_id": 13,
   "arabic": "وَبِكَ اسْتَعينُ فيمَا يَقْتَرِنُ بِهِ ٱلنَّجَاحُ وَٱلإِنْجَاحُ"
  },
  {
   "segment_id": 14,
   "arabic": "وَإِيَّاكَ ارْغَبُ فِي لِبَاسِ ٱلْعَافِيَةِ وَتَمَامِهَا"
  },
  {
   "segment_id": 15,
   "arabic": "وَشُمُولِ ٱلسَّلاَمَةِ وَدَوَامِهَا"
  },
  {
   "segment_id": 16,
   "arabic": "وَ اعُوذُ بِكَ يَا رَبِّ مِنْ هَمَزَاتِ ٱلشَّيَاطينِ"
  },
  {
   "segment_id": 17,
   "arabic": "وَ احْتَرِزُ بِسُلْطَانِكَ مِنْ جَوْرِ ٱلسَّلاَطِينِ"
  },
  {
   "segment_id": 18,
   "arabic": "فَتَقَبَّلْ مَا كَانَ مِنْ صَلاَتِي وَصَوْمِي"
  },
  {
   "segment_id": 19,
   "arabic": "وَٱجْعَلْ غَدِي وَمَا بَعْدَهُ افْضَلَ مِنْ سَاعَتِي وَيَوْمِي"
  },
  {
   "segment_id": 20,
   "arabic": "وَ اعِزَّنِي فِي عَشيرَتِي وَقَوْمِي"
  },
  {
   "segment_id": 21,
   "arabic": "وَٱحْفَظْنِي فِي يَقْظَتِي وَنَوْمِي"
  },
  {
   "segment_id": 22,
   "arabic": "فَانْتَ ٱللَّهُ خَيْرٌ حَافِظاً"
  },
  {
   "segment_id": 23,
   "arabic": "وَ انْتَ ارْحَمُ ٱلرَّاحِمِينَ"
  },
  {
   "segment_id": 24,
   "arabic": "اَللَّهُمَّ إِنِّي ابْرَا إِلَيْكَ فِي يَوْمِي هٰذَا"
  },
  {
   "segment_id": 25,
   "arabic": "وَمَا بَعْدَهُ مِنَ ٱلآحَادِ"
  },
  {
   "segment_id": 26,
   "arabic": "مِنَ ٱلشِّرْكِ وَٱلإلْحَادِ"
  },
  {
   "segment_id": 27,
   "arabic": "وَاخْلِصُ لَكَ دُعَائِي"
  },
  {
   "segment_id": 28,
   "arabic": "تَعَرُّضَاً لِلإجَابَةِ"
  },
  {
   "segment_id": 29,
   "arabic": "وَاقيمُ عَلَىٰ طَاعَتِكَ"
  },
  {
   "segment_id": 30,
   "arabic": "رَجَاءً لِلإِثَابَةِ"
  },
  {
   "segment_id": 31,
   "arabic": "فَصَلِّ عَلَىٰ مُحَمَّدٍ خَيْرِ خَلْقِكَ"
  },
  {
   "segment_id": 32,
   "arabic": "ٱلدَّاعِي إِلَىٰ حَقِّكَ"
  },
  {
   "segment_id": 33,
   "arabic": "وَ اعِزَّنِي بِعِزِّكَ ٱلَّذِي لاَ يُضَامُ"
  },
  {
   "segment_id": 34,
   "arabic": "وَٱحْفَظْنِي بِعَيْنِكَ ٱلَّتِي لاَ تَنَامُ"
  },
  {
   "segment_id": 35,
   "arabic": "وَٱخْتِمْ بِٱلإِنْقِطَاعِ إِلَيْكَ امْرِي"
  },
  {
   "segment_id": 36,
   "arabic": "وَبِٱلْمَغْفِرَةِ عُمْرِي"
  },
  {
   "segment_id": 37,
   "arabic": "إِنَّكَ انْتَ ٱلْغَفُورُ ٱلرَّحِيمُ"
  }
 ]
}