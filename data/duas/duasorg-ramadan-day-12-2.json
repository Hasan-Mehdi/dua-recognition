{
 "dua_id": "duasorg-ramadan-day-12-2",
 "dua_name_en": "Holy Prophet's Dua",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-day-12.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللَّهُمَّ أَنْتَ الْعَزِيزُ الْحَكِيمُ"
  },
  {
   "segment_id": 2,
   "arabic": "وَ أَنْتَ الْغَفُورُ الرَّحِيمُ"
  },
  {
   "segment_id": 3,
   "arabic": "وَ أَنْتَ الْعَلِيُّ الْعَظِيمُ"
  },
  {
   "segment_id": 4,
   "arabic": "لَكَ الْحَمْدُ حَمْداً يَبْقَى وَ لَا يَفْنَى"
  },
  {
   "segment_id": 5,
   "arabic": "وَ لَكَ الشُّكْرُ شُكْراً يَبْقَى وَ لَا يَفْنَى"
  },
  {
   "segment_id": 6,
   "arabic": "وَ أَنْتَ الْحَيُّ الْحَلِيمُ [الْحَكِيمُ‌] الْعَلِيمُ"
  },
  {
   "segment_id": 7,
   "arabic": "أَسْأَلُكَ بِنُورِ وَجْهِكَ الْكَرِيمِ وَ بِجَلَالِكَ الَّذِي لَا يُرَامُ"
  },
  {
   "segment_id": 8,
   "arabic": "وَ بِعِزَّتِكَ الَّتِي لَا تُقْهَرُ"
  },
  {
   "segment_id": 9,
   "arabic": "أَنْ تُصَلِّيَ عَلَى مُحَمَّدٍ وَ آلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 10,
   "arabic": "وَ أَنْ تَغْفِرَ لِي وَ تَرْحَمَنِي"
  },
  {
   "segment_id": 11,
   "arabic": "إِنَّكَ‌ أَنْتَ أَرْحَمُ الرَّاحِمِينَ‌"
  }
 ]
}