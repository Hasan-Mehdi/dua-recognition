{
 "dua_id": "duasorg-ramadan-dua-last-10-nights-2",
 "dua_name_en": "Innaka Kult",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-dua-last-10-nights.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللّهُمّ إِنّكَ قُلْتَ فِي كِتَابِكَ المُنْزَلِ:"
  },
  {
   "segment_id": 2,
   "arabic": "(شَهْرُ رَمَضَانَ الّذِي أُنْزِلَ فِيهِ القُرْآنُ"
  },
  {
   "segment_id": 3,
   "arabic": "هُدَىً لِلنَّاسِ وَبَيّنَاتٍ مِنَ الهُدَى وَالفُرْقَانِ)"
  },
  {
   "segment_id": 4,
   "arabic": "فَعَظّمْتَ حُرْمَةَ شَهْرِ رَمَضَانَ"
  },
  {
   "segment_id": 5,
   "arabic": "بِمَا أَنْزَلْتَ فِيهِ مِنَ القُرْآنِ"
  },
  {
   "segment_id": 6,
   "arabic": "وَخَصَصْتَهُ بِلَيْلَةِ القَدْرِ"
  },
  {
   "segment_id": 7,
   "arabic": "وَجَعَلْتَهَا خَيْراً مِنْ أَلْفِ شَهْرٍ."
  },
  {
   "segment_id": 8,
   "arabic": "اللّهُمّ وَهذِهِ أَيَّامُ شَهْرِ رَمَضَانَ قَدِ انْقَضَتْ،"
  },
  {
   "segment_id": 9,
   "arabic": "وَلَيَالِيهِ قَدْ تَصَرّمَتْ،"
  },
  {
   "segment_id": 10,
   "arabic": "وَقَدْ صِرْتُ يَا إِلهِي مِنْهُ إِلَى مَا أَنْتَ أَعْلَمُ بِهِ مِنّي"
  },
  {
   "segment_id": 11,
   "arabic": "وَأَحْصَى لِعَدَدِهِ مِنَ الخَلْقِ أَجْمَعِينَ،"
  },
  {
   "segment_id": 12,
   "arabic": "فَأَسْأَلُكَ بِمَا سَأَلَكَ بِهِ مَلائِكَتُكَ المُقَرّبُونَ،"
  },
  {
   "segment_id": 13,
   "arabic": "وَأَنْبِيَاؤُكَ المُرْسَلُونَ،"
  },
  {
   "segment_id": 14,
   "arabic": "وَعِبَادُكَ الصَّالِحُونَ"
  },
  {
   "segment_id": 15,
   "arabic": "أَنْ تُصَلّيَ عَلَى مُحَمّدٍ وَآلِ مُحَمّدٍ"
  },
  {
   "segment_id": 16,
   "arabic": "وَأَنْ تَفُكّ رَقَبَتِي مِنَ النَّارِ،"
  },
  {
   "segment_id": 17,
   "arabic": "وَتُدْخِلَنِي الجَنّةَ برَحْمَتِكَ،"
  },
  {
   "segment_id": 18,
   "arabic": "وَأَنْ تَتَفَضّلَ عَلَيّ بِعَفْوِكَ وَكَرَمِكَ،"
  },
  {
   "segment_id": 19,
   "arabic": "وَتَتَقَبّلَ تَقَرّبِي،"
  },
  {
   "segment_id": 20,
   "arabic": "وَتَسْتَجِيبَ دُعَائِي،"
  },
  {
   "segment_id": 21,
   "arabic": "وَتَمُنّ عَلَيّ بِالأَمْنِ يَوْمَ الخَوْفِ"
  },
  {
   "segment_id": 22,
   "arabic": "مِنْ كُلّ هَوْلٍ أَعْدَدْتَهُ لِيَوْمِ القِيَامَةِ."
  },
  {
   "segment_id": 23,
   "arabic": "إِلهِي وَأَعُوذُ بِوَجْهِكَ الكَرِيمِ،"
  },
  {
   "segment_id": 24,
   "arabic": "وَبِجَلالِكَ العَظِيمِ"
  },
  {
   "segment_id": 25,
   "arabic": "أَنْ تَنْقَضِيَ أَيَّامُ شَهْرِ رَمَضَانَ وَلَيَالِيهِ"
  },
  {
   "segment_id": 26,
   "arabic": "وَلَكَ قِبَلِي تَبِعَةٌ أَوْ ذَنْبٌ تُؤَاخِذُنِي بِهِ،"
  },
  {
   "segment_id": 27,
   "arabic": "أَوْ خَطِيئَةٌ تُرِيدُ أَنْ تَقْتَصّهَا مِنّي لَمْ تَغْفِرْهَا لِي،"
  },
  {
   "segment_id": 28,
   "arabic": "سَيّدِي سَيّدِي سَيّدِي،"
  },
  {
   "segment_id": 29,
   "arabic": "أَسْأَلُكَ يَا لا إِلهَ إِلاَّ أَنْتَ"
  },
  {
   "segment_id": 30,
   "arabic": "إِذْ لا إِلهَ إِلاَّ أَنْتَ"
  },
  {
   "segment_id": 31,
   "arabic": "إِنْ كُنْتَ رَضِيتَ عَنّي فِي هذَا الشّهْرِ"
  },
  {
   "segment_id": 32,
   "arabic": "فَازْدَدْ عَنّي رِضَىً،"
  },
  {
   "segment_id": 33,
   "arabic": "وَإِنْ لَمْ تَكُنْ رَضِيتَ عَنّي"
  },
  {
   "segment_id": 34,
   "arabic": "فَمِنَ الآنَ فَارْضَ عَنّي"
  },
  {
   "segment_id": 35,
   "arabic": "يَا أَرْحَمَ الرَّاحِمِينَ،"
  },
  {
   "segment_id": 36,
   "arabic": "يَا اللّهُ يَا أَحَدُ يَا صَمَدُ"
  },
  {
   "segment_id": 37,
   "arabic": "يَا مَنْ لَمْ يَلِدْ وَلَمْ يُولَدْ"
  },
  {
   "segment_id": 38,
   "arabic": "وَلَمْ يَكُنْ لَهُ كُفُواً أَحَدٌ."
  }
 ]
}