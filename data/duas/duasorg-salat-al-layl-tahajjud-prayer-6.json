{
 "dua_id": "duasorg-salat-al-layl-tahajjud-prayer-6",
 "dua_name_en": "Dua after each 2 Rakaat of Tahajjud Prayer - Salat al-Layl - Namaz e Shab",
 "dua_name_ar": "",
 "source": "https://www.duas.org/salat-al-layl-tahajjud-prayer.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "أَللَّهُمَّ إِنّي أَسْأَلُكَ وَلَمْ يُسْأَلْ مِثْلُكَ"
  },
  {
   "segment_id": 2,
   "arabic": "أَنْتَ مَوْضِعُ مَسْأَلَةِ السَّائِلينَ"
  },
  {
   "segment_id": 3,
   "arabic": "وَمُنْتَهى رَغْبَةِ الرَّاغِبينَ"
  },
  {
   "segment_id": 4,
   "arabic": "أَدْعُوكَ وَلَمْ يُدْعَ مِثْلُكَ"
  },
  {
   "segment_id": 5,
   "arabic": "وَأَرْغَبُ إِلَيْكَ وَلَمْ يُرْغَبْ إِلى مِثْلِكَ"
  },
  {
   "segment_id": 6,
   "arabic": "أَنْتَ مُجيبُ دَعْوَةِ الْمُضْطَرّينَ"
  },
  {
   "segment_id": 7,
   "arabic": "وَأَرْحَمُ الرَّاحِمينَ"
  },
  {
   "segment_id": 8,
   "arabic": "أَسْأَلُكَ بِأَفْضَلِ الْمَسائِلِ وَأَنْجَحِها وَأَعْظَمِها"
  },
  {
   "segment_id": 9,
   "arabic": "يا اَللَّهُ يا رَحْمانُ يا رَحيمُ"
  },
  {
   "segment_id": 10,
   "arabic": "وَبِأَسْمائِكَ الْحُسْنى"
  },
  {
   "segment_id": 11,
   "arabic": "وَأَمْثالِكَ الْعُلْيا"
  },
  {
   "segment_id": 12,
   "arabic": "وَنِعَمِكَ الَّتي لاتُحْصى"
  },
  {
   "segment_id": 13,
   "arabic": "وَبِأَكْرَمِ أَسْمائِكَ عَلَيْكَ وَأَحَبِّها إِلَيْكَ"
  },
  {
   "segment_id": 14,
   "arabic": "وَأَقْرَبِها مِنْكَ وَسيلَةً"
  },
  {
   "segment_id": 15,
   "arabic": "وَأَشْرَفِها عِنْدَكَ مَنْزِلَةً"
  },
  {
   "segment_id": 16,
   "arabic": "وَأَجْزَلِها لَدَيْكَ ثَواباً"
  },
  {
   "segment_id": 17,
   "arabic": "وَأَسْرَعِها فِي الْاُمُورِ إِجابَةً"
  },
  {
   "segment_id": 18,
   "arabic": "وَبِاسْمِكَ الْمَكْنُونِ الْأَكْبَرِ الْأَعَزِّ الْأَجَلِّ الْأَعْظَمِ الْأَكْرَمِ"
  },
  {
   "segment_id": 19,
   "arabic": "اَلَّذي تُحِبُّهُ وَتَهْواهُ"
  },
  {
   "segment_id": 20,
   "arabic": "وَتَرْضى بِهِ عَمَّنْ دَعاكَ"
  },
  {
   "segment_id": 21,
   "arabic": "فَاسْتَجَبْتَ لَهُ دُعاءَهُ"
  },
  {
   "segment_id": 22,
   "arabic": "وَحَقٌّ عَلَيْكَ أَنْ لاتَحْرِمَ سائِلَكَ وَلاتَرُدَّهُ"
  },
  {
   "segment_id": 23,
   "arabic": "وَبِكُلِّ اسْمٍ هُوَ لَكَ فِي التَّوْراةِ وَالْإِنْجيلِ وَالزَّبُورِ وَالْقُرْآنِ الْعَظيمِ"
  },
  {
   "segment_id": 24,
   "arabic": "وَبِكُلِّ اسْمٍ دَعاكَ بِهِ حَمَلَةُ عَرْشِكَ وَمَلائِكَتُكَ"
  },
  {
   "segment_id": 25,
   "arabic": "وَأَنْبِياؤُكَ وَرُسُلُكَ"
  },
  {
   "segment_id": 26,
   "arabic": "وَأَهْلُ طاعَتِكَ مِنْ خَلْقِكَ"
  },
  {
   "segment_id": 27,
   "arabic": "أَنْ تُصَلِّيَ عَلى مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 28,
   "arabic": "وَأَنْ تُعَجِّلَ فَرَجَ وَلِيِّكَ وَابْنِ وَلِيِّكَ"
  },
  {
   "segment_id": 29,
   "arabic": "وَتُعَجِّلَ خِزْيَ أَعْدائِهِ"
  }
 ]
}