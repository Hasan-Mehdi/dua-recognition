{
 "dua_id": "duasorg-sahifa-fatimiya-dua-for-fever-2",
 "dua_name_en": "Dua of Sayeda Fatima (sa) for fever",
 "dua_name_ar": "",
 "source": "https://www.duas.org/sahifa-fatimiya-dua-for-fever.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "وَ لَهُ مَا سَكَنَ فِي اللَّيْلِ وَ النَّهَارِ"
  },
  {
   "segment_id": 2,
   "arabic": "وَ هُوَ السَّمِيعُ الْعَلِيمُ"
  },
  {
   "segment_id": 3,
   "arabic": "يَا أُمَّ مُلْدَمٍ"
  },
  {
   "segment_id": 4,
   "arabic": "إِنْ كُنْتِ آمَنْتِ بِاللهِ الْعَظِيمِ"
  },
  {
   "segment_id": 5,
   "arabic": "وَ رَسُولِهِ الْكَرِيمِ"
  },
  {
   "segment_id": 6,
   "arabic": "فَلَا تَهْشِمِي الْعَظْمَ"
  },
  {
   "segment_id": 7,
   "arabic": "وَ لَا تَأْكُلِي اللَّحْمَ"
  },
  {
   "segment_id": 8,
   "arabic": "وَ لَا تَشْرَبِي الدَّمَ"
  },
  {
   "segment_id": 9,
   "arabic": "اخْرُجِي مِنْ حَامِلِ كِتَابِي هٰذَا"
  },
  {
   "segment_id": 10,
   "arabic": "إِلٰى مَنْ لَا يُؤْمِنُ بِاللهِ الْعَظِيمِ"
  },
  {
   "segment_id": 11,
   "arabic": "وَ رَسُولِهِ الْكَرِيمِ وَ آلِهِ"
  },
  {
   "segment_id": 12,
   "arabic": "مُحَمَّدٍ وَ عَلِيٍّ وَ فَاطِمَةَ وَ الْحَسَنِ وَ الْحُسَيْنِ عَلَيْهِمُ السَّلَامُ"
  }
 ]
}