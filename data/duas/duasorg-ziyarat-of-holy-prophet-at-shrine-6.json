{
 "dua_id": "duasorg-ziyarat-of-holy-prophet-at-shrine-6",
 "dua_name_en": "Salawat on Holy Prophet",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ziyarat-of-holy-prophet-at-shrine.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ"
  },
  {
   "segment_id": 2,
   "arabic": "كَمَا حَمَلَ وَحْيَكَ"
  },
  {
   "segment_id": 3,
   "arabic": "وَبَلَّغَ رِسَالاَتِكَ"
  },
  {
   "segment_id": 4,
   "arabic": "وَصَلِّ عَلَىٰ مُحَمَّدٍ"
  },
  {
   "segment_id": 5,
   "arabic": "كَمَا أَحَلَّ حَلاَلَكَ"
  },
  {
   "segment_id": 6,
   "arabic": "وَحَرَّمَ حَرَامَكَ"
  },
  {
   "segment_id": 7,
   "arabic": "وَعَلَّمَ كِتَابَكَ"
  },
  {
   "segment_id": 8,
   "arabic": "وَصَلِّ عَلَىٰ مُحَمَّدٍ"
  },
  {
   "segment_id": 9,
   "arabic": "كَمَا أَقَامَ ٱلصَّلاَةَ"
  },
  {
   "segment_id": 10,
   "arabic": "وَآتَىٰ ٱلزَّكَاةَ"
  },
  {
   "segment_id": 11,
   "arabic": "وَدَعَا إِلَىٰ دِينِكَ"
  },
  {
   "segment_id": 12,
   "arabic": "وَصَلِّ عَلَىٰ مُحَمَّدٍ"
  },
  {
   "segment_id": 13,
   "arabic": "كَمَا صَدَّقَ بِوَعْدِكَ"
  },
  {
   "segment_id": 14,
   "arabic": "وَأَشْفَقَ مِنْ وَعِيدِكَ"
  },
  {
   "segment_id": 15,
   "arabic": "وَصَلِّ عَلَىٰ مُحَمَّدٍ"
  },
  {
   "segment_id": 16,
   "arabic": "كَمَا غَفَرْتَ بِهِ ٱلذُّنُوبَ"
  },
  {
   "segment_id": 17,
   "arabic": "وَسَتَرْتَ بِهِ ٱلْعُيُوبَ"
  },
  {
   "segment_id": 18,
   "arabic": "وَفَرَّجْتَ بِهِ ٱلْكُرُوبَ"
  },
  {
   "segment_id": 19,
   "arabic": "وَصَلِّ عَلَىٰ مُحَمَّدٍ"
  },
  {
   "segment_id": 20,
   "arabic": "كَمَا دَفَعْتَ بِهِ ٱلشَّقَاءَ"
  },
  {
   "segment_id": 21,
   "arabic": "وَكَشَفْتَ بِهِ ٱلْغَمَّاءَ"
  },
  {
   "segment_id": 22,
   "arabic": "وَأَجَبْتَ بِهِ ٱلدُّعَاءَ"
  },
  {
   "segment_id": 23,
   "arabic": "وَنَجَّيْتَ بِهِ مِنَ ٱلْبَلاَءِ"
  },
  {
   "segment_id": 24,
   "arabic": "وَصَلِّ عَلَىٰ مُحَمَّدٍ"
  },
  {
   "segment_id": 25,
   "arabic": "كَمَا رَحِمْتَ بِهِ ٱلْعِبَادَ"
  },
  {
   "segment_id": 26,
   "arabic": "وَأَحْيَيْتَ بِهِ ٱلْبِلاَدَ"
  },
  {
   "segment_id": 27,
   "arabic": "وَقَصَمْتَ بِهِ ٱلْجَبَابِرَةَ"
  },
  {
   "segment_id": 28,
   "arabic": "وَأَهْلَكْتَ بِهِ ٱلْفَرَاعِنَةَ"
  },
  {
   "segment_id": 29,
   "arabic": "وَصَلِّ عَلَىٰ مُحَمَّدٍ"
  },
  {
   "segment_id": 30,
   "arabic": "كَمَا أَضْعَفْتَ بِهِ ٱلأَمْوَالَ"
  },
  {
   "segment_id": 31,
   "arabic": "وَأَحْرَزْتَ بِهِ مِنَ ٱلأَهْوَالِ"
  },
  {
   "segment_id": 32,
   "arabic": "وَكَسَرْتَ بِهِ ٱلأَصْنَامَ"
  },
  {
   "segment_id": 33,
   "arabic": "وَرَحِمْتَ بِهِ ٱلأَنَامَ"
  },
  {
   "segment_id": 34,
   "arabic": "وَصَلِّ عَلَىٰ مُحَمَّدٍ"
  },
  {
   "segment_id": 35,
   "arabic": "كَمَا بَعَثْتَهُ بِخَيْرِ ٱلأَدْيَانِ"
  },
  {
   "segment_id": 36,
   "arabic": "وَأَعْزَزْتَ بِهِ ٱلإِيمَانَ"
  },
  {
   "segment_id": 37,
   "arabic": "وَتَبَّرْتَ بِهِ ٱلأَوْثَانَ"
  },
  {
   "segment_id": 38,
   "arabic": "وَعَظَّمْتَ بِهِ ٱلْبَيْتَ ٱلْحَرَامَ"
  },
  {
   "segment_id": 39,
   "arabic": "وَصَلِّ عَلَىٰ مُحَمَّدٍ"
  },
  {
   "segment_id": 40,
   "arabic": "وَأَهْلِ بَيْتِهِ ٱلطَّاهِرِينَ ٱلأَخْيَارِ"
  },
  {
   "segment_id": 41,
   "arabic": "وَسَلِّمْ تَسْلِيماً"
  }
 ]
}