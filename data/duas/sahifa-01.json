{
 "dua_id": "sahifa-01",
 "dua_name_en": "Sahifa 1: In praise of God",
 "dua_name_ar": "التَّحْمِيدُ لِلَّهِ عَزَّ وَ جَلَّ",
 "source": "https://duas.pro/1-in-praise-of-god",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "أَلْحَمْدُ للهِ"
  },
  {
   "segment_id": 2,
   "arabic": "الاوَّلِ بِلا أَوَّل كَانَ قَبْلَهُ،"
  },
  {
   "segment_id": 3,
   "arabic": "وَ الاخِر بِلاَ آخِر يَكُونُ بَعْدَهُ"
  },
  {
   "segment_id": 4,
   "arabic": "الَّذِي قَصُرَتْ عَنْ رُؤْيَتِهِ أَبْصَارُ النَّاظِرِينَ"
  },
  {
   "segment_id": 5,
   "arabic": "وَ عَجَزَتْ عَنْ نَعْتِهِ أَوهامُ اَلْوَاصِفِينَ"
  },
  {
   "segment_id": 6,
   "arabic": "ابْتَدَعَ بِقُدْرَتِهِ الْخَلْقَ اَبتِدَاعَاً،"
  },
  {
   "segment_id": 7,
   "arabic": "وَاخْتَرَعَهُمْ عَلَى مَشِيَّتِهِ اخترَاعاً،"
  },
  {
   "segment_id": 8,
   "arabic": "ثُمَّ سَلَكَ بِهِمْ طَرِيقَ إرَادَتِهِ،"
  },
  {
   "segment_id": 9,
   "arabic": "وَبَعَثَهُمْ فِي سَبِيلِ مَحَبَّتِهِ"
  },
  {
   "segment_id": 10,
   "arabic": "لايَمْلِكُونَ تَأخِيراً عَمَا قَدَّمَهُمْ إليْهِ"
  },
  {
   "segment_id": 11,
   "arabic": "وَلا يَسْتَطِيعُونَ تَقَدُّماً إلَى مَا أَخَّرَهُمْ عَنْهُ،"
  },
  {
   "segment_id": 12,
   "arabic": "وَ جَعَلَ لِكُلِّ رُوْح مِنْهُمْ"
  },
  {
   "segment_id": 13,
   "arabic": "قُوتَاً مَعْلُوماً مَقْسُوماً مِنْ رِزْقِهِ"
  },
  {
   "segment_id": 14,
   "arabic": "لاَ يَنْقُصُ مَنْ زادَهُ نَاقِصٌ،"
  },
  {
   "segment_id": 15,
   "arabic": "وَلاَ يَزِيدُ مَنْ نَقَصَ منْهُمْ زَائِدٌ"
  },
  {
   "segment_id": 16,
   "arabic": "ثُمَّ ضَرَبَ لَهُ فِي الْحَيَاةِ أَجَلاً مَوْقُوتاً،"
  },
  {
   "segment_id": 17,
   "arabic": "وَ نَصَبَ لَهُ أَمَداً مَحْدُوداً،"
  },
  {
   "segment_id": 18,
   "arabic": "يَتَخَطَّأُ إلَيهِ بِأَيَّامِ عُمُرِهِ،"
  },
  {
   "segment_id": 19,
   "arabic": "وَيَرْهَقُهُ بِأَعْوَامِ دَهْرِهِ،"
  },
  {
   "segment_id": 20,
   "arabic": "حَتَّى إذَا بَلَغَ أَقْصَى أَثَرِهِ،"
  },
  {
   "segment_id": 21,
   "arabic": "وَ اسْتَوْعَبَ حِسابَ عُمُرِهِ،"
  },
  {
   "segment_id": 22,
   "arabic": "قَبَضهُ إلَى ما نَدَبَهُ إلَيْهِ"
  },
  {
   "segment_id": 23,
   "arabic": "مِنْ مَوْفُورِ ثَوَابِهِ أَوْ مَحْذُورِ عِقَابِهِ،"
  },
  {
   "segment_id": 24,
   "arabic": "لِيَجْزِيَ الَّذِينَ أَساءُوا بِمَا عَمِلُوا"
  },
  {
   "segment_id": 25,
   "arabic": "وَ يَجْزِىَ الَّذِينَ أَحْسَنُوا بِالْحُسْنَى"
  },
  {
   "segment_id": 26,
   "arabic": "عَدْلاً مِنْهُ تَقَدَّسَتْ أَسْمَآؤُهُ،"
  },
  {
   "segment_id": 27,
   "arabic": "وَتَظَاهَرَتْ ألاؤُهُ،"
  },
  {
   "segment_id": 28,
   "arabic": "لاَ يُسْأَلُ عَمَّا يَفْعَلُ وَهُمْ يُسْأَلُونَ"
  },
  {
   "segment_id": 29,
   "arabic": "وَالْحَمْدُ للهِ الَّذِي لَوْ حَبَسَ عَنْ عِبَادِهِ مَعْرِفَةَ"
  },
  {
   "segment_id": 30,
   "arabic": "حَمْدِهِ عَلَى مَا أَبْلاَهُمْ مِنْ مِنَنِهِ الْمُتَتَابِعَةِ"
  },
  {
   "segment_id": 31,
   "arabic": "وَأَسْبَغَ عَلَيْهِمْ مِن نِعَمِهِ الْمُتَظَاهِرَة"
  },
  {
   "segment_id": 32,
   "arabic": "لَتَصرَّفُوا فِي مِنَنِهِ فَلَمْ يَحْمَدُوهُ"
  },
  {
   "segment_id": 33,
   "arabic": "وَتَوَسَّعُوا فِي رِزْقِهِ فَلَمْ يَشْكُرُوهُ،"
  },
  {
   "segment_id": 34,
   "arabic": "وَلَوْ كَانُوا كَذلِكَ لَخَرَجُوا مِنْ حُدُودِ الانْسَانِيَّةِ"
  },
  {
   "segment_id": 35,
   "arabic": "إلَى حَدِّ الْبَهِيمِيَّةِ،"
  },
  {
   "segment_id": 36,
   "arabic": ":فَكَانُوا كَمَا وَصَفَ فِي مُحْكَم كِتَابِهِ"
  },
  {
   "segment_id": 37,
   "arabic": "( إنْ هُمْ إلا كَالانْعَامِ بَلْ هُمْ أَضَلُّ سَبِيلا )"
  },
  {
   "segment_id": 38,
   "arabic": "وَالْحَمْدُ لله عَلَى مَا عَرَّفَنا من نفسه"
  },
  {
   "segment_id": 39,
   "arabic": "وَأَلْهَمَنَا مِنْ شُكْرِهِ"
  },
  {
   "segment_id": 40,
   "arabic": "وَفَتَحَ لَنَا من أبوَابِ الْعِلْمِ بِرُبُوبِيّته"
  },
  {
   "segment_id": 41,
   "arabic": "وَدَلَّنَا عَلَيْهِ مِنَ الاِخْلاَصِ لَهُ فِي تَوْحِيدِهِ"
  },
  {
   "segment_id": 42,
   "arabic": "وَجَنَّبَنا مِنَ الالْحَادِ وَالشَّكِّ فِي أَمْرِهِ،"
  },
  {
   "segment_id": 43,
   "arabic": "حَمْداً نُعَمَّرُ بِهِ فِيمَنْ حَمِدَهُ مِنْ خَلْقِهِ"
  },
  {
   "segment_id": 44,
   "arabic": "وَنَسْبِقُ بِـهِ مَنْ سَبَقَ إلَى رِضَاهُ وَعَفْوِهِ"
  },
  {
   "segment_id": 45,
   "arabic": "حَمْداً يُضِيءُ لَنَا بِهِ ظُلُمَاتِ الْبَرْزَخِ"
  },
  {
   "segment_id": 46,
   "arabic": "وَيُسَهِّلُ عَلَيْنَا بِهِ سَبِيلَ الْمَبْعَثِ"
  },
  {
   "segment_id": 47,
   "arabic": "وَيُشَرِّفُ بِهِ مَنَازِلَنَا عِنْدَ مَوَاقِفِ الاشْهَادِ"
  },
  {
   "segment_id": 48,
   "arabic": "يَوْمَ تُجْزَى كُلُّ نَفْس بِمَا كَسَبَتْ وَهُمْ لا يُظْلَمُونَ"
  },
  {
   "segment_id": 49,
   "arabic": "(يَوْمَ لاَ يُغْنِي مَوْلىً عَنْ مَوْلىً شَيْئاً وَلاَ هُمْ يُنْصَرُونَ)"
  },
  {
   "segment_id": 50,
   "arabic": "حَمْداً يَرْتَفِعُ مِنَّا إلَى أَعْلَى عِلِّيِّينَ"
  },
  {
   "segment_id": 51,
   "arabic": "فِي كِتَاب مَرْقُوم يَشْهَدُهُ الْمُقَرَّبُونَ،"
  },
  {
   "segment_id": 52,
   "arabic": "حَمْداً تَقَرُّ بِهِ عُيُونُنَا إذَا بَرِقَت الابْصَارُ"
  },
  {
   "segment_id": 53,
   "arabic": "وَتَبْيَضُّ بِهِ وُجُوهُنَا إذَا اسْوَدَّتِ الابْشَارُ،"
  },
  {
   "segment_id": 54,
   "arabic": "حَمْداً نُعْتَقُ بِهِ مِنْ أَلِيمِ نار الله"
  },
  {
   "segment_id": 55,
   "arabic": "الى كَرِيمِ جِوَارِ اللهِ"
  },
  {
   "segment_id": 56,
   "arabic": "حَمْداً نُزَاحِمُ بِهِ مَلاَئِكَتَهُ الْمُقَرَّبِينَ"
  },
  {
   "segment_id": 57,
   "arabic": "وَنُضَامُّ بِـهِ أَنْبِيآءَهُ الْمُـرْسَلِيْنَ"
  },
  {
   "segment_id": 58,
   "arabic": "فِي دَارِ الْمُقَامَةِ الَّتِي لا تَزُولُ"
  },
  {
   "segment_id": 59,
   "arabic": "وَمَحَلِّ كَرَامَتِهِ الَّتِي لاَ تَحُولُ"
  },
  {
   "segment_id": 60,
   "arabic": "وَالْحَمْدُ للهِ الَّذِي اخْتَارَ لَنَا مَحَاسِنَ الْخَلْقِ"
  },
  {
   "segment_id": 61,
   "arabic": "وَأَجرى عَلَيْنَا طَيِّبَاتِ الرِّزْقِ"
  },
  {
   "segment_id": 62,
   "arabic": "وَجَعَلَ لَنَا الفَضِيلَةَ بِالْمَلَكَةِ عَلَى جَمِيعِ الْخَلْقِ"
  },
  {
   "segment_id": 63,
   "arabic": "فَكُلُّ خَلِيقَتِهِ مُنْقَادَةٌ لَنَا بِقُدْرَتِهِ،"
  },
  {
   "segment_id": 64,
   "arabic": "وَصَآئِرَةٌ إلَى طَاعَتِنَا بِعِزَّتِهِ"
  },
  {
   "segment_id": 65,
   "arabic": "وَالْحَمْدُ لله الَّذِي أَغْلَقَ عَنَّْا بَابَ الْحَّاجَةِ إلاّ إلَيْهِ"
  },
  {
   "segment_id": 66,
   "arabic": "فَكَيْفَ نُطِيقُ حَمْدَهُ أَمْ مَتَى نُؤَدِّي شُكْرَهُ؟ لا، مَتى؟"
  },
  {
   "segment_id": 67,
   "arabic": "وَالْحَمْدُ للهِ الَّذِي رَكَّبَ فِينَا آلاَتِ الْبَسْطِ"
  },
  {
   "segment_id": 68,
   "arabic": "وَجَعَلَ لَنَا أدَوَاتِ الْقَبْضِ،"
  },
  {
   "segment_id": 69,
   "arabic": "وَمَتَّعَنا بِاَرْواحِ الْحَياةِ"
  },
  {
   "segment_id": 70,
   "arabic": "وَأثْبَتَ فِينَا جَوَارِحَ الْأعْمَال"
  },
  {
   "segment_id": 71,
   "arabic": "وَغَذَّانَا بِطَيِّبَاتِ الرِّزْقِ ،"
  },
  {
   "segment_id": 72,
   "arabic": "وَأغْنانَا بِفَضْلِهِ"
  },
  {
   "segment_id": 73,
   "arabic": "وَأقْنانَا بِمَنِّهِ"
  },
  {
   "segment_id": 74,
   "arabic": "ثُمّ أَمَرَنَا لِيَخْتَبِرَ طاعَتَنَا،"
  },
  {
   "segment_id": 75,
   "arabic": "وَنَهَانَا لِيَبْتَلِيَ شُكْرَنَا"
  },
  {
   "segment_id": 76,
   "arabic": "فَخَالَفْنَا عَنْ طَرِيْقِ أمْرِهِ"
  },
  {
   "segment_id": 77,
   "arabic": "وَرَكِبْنا مُتُونَ زَجْرهِ"
  },
  {
   "segment_id": 78,
   "arabic": "فَلَم يَبْتَدِرْنَابِعُقُوبَتِه وَلَمْ يُعَاجِلْنَا بِنِقْمَتِهِ"
  },
  {
   "segment_id": 79,
   "arabic": "بَلْ تَانَّانا بِرَحْمَتِهِ تَكَرُّماً، وَانْتَظَرَ مُراجَعَتَنَا بِرَأفَتِهِ حِلْماً."
  },
  {
   "segment_id": 80,
   "arabic": "وَالْحَمْدُ للهِ الَّذِي دَلَّنَاعَلَى التَّوْبَةِ"
  },
  {
   "segment_id": 81,
   "arabic": "الَّتِي لَمْ نُفِدْهَا إلاّ مِنْ فَضْلِهِ،"
  },
  {
   "segment_id": 82,
   "arabic": "فَلَوْ لَمْ نَعْتَدِدْ مِنْ فَضْلِهِ إلاّ بِهَا"
  },
  {
   "segment_id": 83,
   "arabic": "لَقَدْ حَسُنَ بَلاؤُهُ عِنْدَنَا،"
  },
  {
   "segment_id": 84,
   "arabic": "وَ جَلَّ إحْسَانُهُ إلَيْنَا،"
  },
  {
   "segment_id": 85,
   "arabic": "وَ جَسُمَ فَضْلُهُ عَلَيْنَا"
  },
  {
   "segment_id": 86,
   "arabic": "فَمَا هكذا كَانَتْ سُنَّتُهُ فِي التَّوْبَةِ لِمَنْ كَانَ قَبْلَنَا"
  },
  {
   "segment_id": 87,
   "arabic": "لَقَدْ وَضَعَ عَنَّا مَا لا طَاقَةَ لَنَا بِهِ،"
  },
  {
   "segment_id": 88,
   "arabic": "وَلَمْ يُكَلِّفْنَا إلاّ وُسْعاً،"
  },
  {
   "segment_id": 89,
   "arabic": "وَ لَمْ يُجَشِّمْنَا إلاّ يُسْراً"
  },
  {
   "segment_id": 90,
   "arabic": "وَلَمْ يَدَعْ لاَحَـد مِنَّا حُجَّةً وَلاَ عُذْراً"
  },
  {
   "segment_id": 91,
   "arabic": "فَالْهَالِكُ مِنَّا مَنْ هَلَكَ عَلَيْهِ"
  },
  {
   "segment_id": 92,
   "arabic": "وَ السَّعِيدُ مِنَّا مَنْ رَغِبَ إلَيْهِ"
  },
  {
   "segment_id": 93,
   "arabic": "وَ الْحَمْد للهِ بِكُلِّ مَا حَمِدَهُ بِهِ"
  },
  {
   "segment_id": 94,
   "arabic": "أدْنَى مَلائِكَتِهِ إلَيْهِ"
  },
  {
   "segment_id": 95,
   "arabic": "وَ أَكْرَمُ خَلِيقَتِهِ عَلَيْهِ"
  },
  {
   "segment_id": 96,
   "arabic": "وَأرْضَى حَامِدِيْهِ لَدَيْهِ"
  },
  {
   "segment_id": 97,
   "arabic": "حَمْداً يَفْضُلُ سَآئِرَ الْحَمْدِ"
  },
  {
   "segment_id": 98,
   "arabic": "كَفَضْلِ رَبِّنا عَلَى جَمِيعِ خَلْقِهِ"
  },
  {
   "segment_id": 99,
   "arabic": "ثُمَّ لَهُ الْحَمْدُ مَكَانَ كُلِّ نِعْمَة لَهُ عَلَيْنَا"
  },
  {
   "segment_id": 100,
   "arabic": "وَ عَلى جَمِيعِ عِبَادِهِ الْمَاضِينَ وَالْبَاقِينَ"
  },
  {
   "segment_id": 101,
   "arabic": "عَدَدَ مَا أَحَاطَ بِهِ عِلْمُهُ مِنْ جَمِيعِ الْاشْيَآءِ"
  },
  {
   "segment_id": 102,
   "arabic": "وَ مَكَانَ كُلِّ وَاحِدَة مِنْهَا عَدَدُهَا أَضْعافَاً مُضَاعَفَةً أَبَداً سَرْمَداً إلَى يَوْمِ الْقِيَامَةِ"
  },
  {
   "segment_id": 103,
   "arabic": "حَمْداً لاَ مُنْتَهَى لِحَدِّهِ"
  },
  {
   "segment_id": 104,
   "arabic": "وَ لا حِسَابَ لِعَدَدِهِ"
  },
  {
   "segment_id": 105,
   "arabic": "وَ لاَ مَبْلَغَ لِغَايَتِهِ"
  },
  {
   "segment_id": 106,
   "arabic": "وَ لا انْقِطَاعَ لاَمَدِهِ"
  },
  {
   "segment_id": 107,
