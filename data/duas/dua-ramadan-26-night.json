{
 "dua_id": "dua-ramadan-26-night",
 "dua_name_en": "Dua Night 26",
 "dua_name_ar": "",
 "source": "https://www.duaplayer.org/en/dua/ramadan-26-night",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "يَا جَاعِلَ ٱللَّيْلِ وَٱلنَّهَارِ آيَتَيْنِ"
  },
  {
   "segment_id": 4,
   "arabic": "يَا مَنْ مَحَا آيَةَ ٱللَّيْلِ"
  },
  {
   "segment_id": 5,
   "arabic": "وَجَعَلَ آيَةَ ٱلنَّهَارِ مُبْصِرَةً"
  },
  {
   "segment_id": 6,
   "arabic": "لِتَبْتَغُوٱ فَضْلاً مِنْهُ وَرِضْوَاناً"
  },
  {
   "segment_id": 7,
   "arabic": "يَا مُفَصِّلَ كُلِّ شَيْءٍ تَفْصِيلاً"
  },
  {
   "segment_id": 8,
   "arabic": "يَا مَاجِدُ يَا وَهَّابُ"
  },
  {
   "segment_id": 9,
   "arabic": "يَا اللَّهُ يَا جَوَادُ"
  },
  {
   "segment_id": 10,
   "arabic": "يَا اللَّهُ يَا اللَّهُ يَا اللَّهُ"
  },
  {
   "segment_id": 11,
   "arabic": "لَكَ ٱلاسْمَاءُ ٱلْحُسْنَىٰ"
  },
  {
   "segment_id": 12,
   "arabic": "وَٱلامْثَالُ ٱلْعُلْيَا"
  },
  {
   "segment_id": 13,
   "arabic": "وَٱلْكِبْرِيَاءُ وَٱلآلاَءُ"
  },
  {
   "segment_id": 14,
   "arabic": "اسْالُكَ انْ تُصَلِّيَ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 15,
   "arabic": "وَانْ تَجْعَلَ ٱسْمِي فِي هٰذِهِ ٱللَّيْلَةِ فِي ٱلسُّعَدَاءِ"
  },
  {
   "segment_id": 16,
   "arabic": "وَرُوحِي مَعَ ٱلشُّهَدَاءِ"
  },
  {
   "segment_id": 17,
   "arabic": "وَإِحْسَانِي فِي عِلِّيِّينَ"
  },
  {
   "segment_id": 18,
   "arabic": "وَإِسَاءَتِي مَغْفُورَةً"
  },
  {
   "segment_id": 19,
   "arabic": "وَانْ تَهَبَ لِي يَقِيناً تُبَاشِرُ بِهِ قَلْبِي"
  },
  {
   "segment_id": 20,
   "arabic": "وَإِيـمَاناً يُذْهِبُ ٱلشَّكَّ عَنِّي"
  },
  {
   "segment_id": 21,
   "arabic": "وَتُرْضِيَنِي بِمَا قَسَمْتَ لِي"
  },
  {
   "segment_id": 22,
   "arabic": "وَآتِنَا فِي ٱلدُّنْيَا حَسَنَةً"
  },
  {
   "segment_id": 23,
   "arabic": "وَفِي ٱلآخِرَةِ حَسَنَةً"
  },
  {
   "segment_id": 24,
   "arabic": "وَقِنَا عَذَابَ ٱلنَّارِ ٱلْحَرِيقِ"
  },
  {
   "segment_id": 25,
   "arabic": "وَٱرْزُقْنِي فِيهَا ذِكْرَكَ وَشُكْرَكَ وَٱلرَّغْبَةَ إِلَيْكَ"
  },
  {
   "segment_id": 26,
   "arabic": "وَٱلإِنَابَةَ وَٱلتَّوْفِيقَ لِمَا وَفَّقْتَ لَهُ مُحَمَّداً وَآلَ مُحَمَّدٍ عَلَيْهِ وَعَلَيْهِمُ ٱلسَّلاَمُ"
  }
 ]
}