{
 "dua_id": "duasorg-ramadan-dua-daytime-daily-2",
 "dua_name_en": "Dua An taj`ala",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-dua-daytime-daily.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللّهُمَّ إنِّي أَسْأَلُكَ أَنْ تَجْعَلَ فِيمَا تَقْضِي وَتُقَدِّرُ"
  },
  {
   "segment_id": 2,
   "arabic": "مِنَ الأَمْرِ الْمَحْتُومِ فِي الأَمْرِ الْحَكِيمِ"
  },
  {
   "segment_id": 3,
   "arabic": "مِنَ الْقَضَاءِ الَّذِي لا يُرَدُّ وَلا يُبَدَّلُ"
  },
  {
   "segment_id": 4,
   "arabic": "أَنْ تَكْتُبَنِي مِنْ حُجَّاجِ بَيْتِكَ الْحَرَامِ"
  },
  {
   "segment_id": 5,
   "arabic": "الْمَبْرُورِ حَجُّهُمُ،"
  },
  {
   "segment_id": 6,
   "arabic": "الْمَشْكُورِ سَعْيُهُمُ،"
  },
  {
   "segment_id": 7,
   "arabic": "الْمَغْفُورِ ذُنُوبُهُمُ،"
  },
  {
   "segment_id": 8,
   "arabic": "الْمُكَفَّرِ عَنْ سَيِّئَاتِهِمْ،"
  },
  {
   "segment_id": 9,
   "arabic": "وَأَنْ تَجْعَلَ فِيمَا تَقْضِي وَتُقَدِّرُ"
  },
  {
   "segment_id": 10,
   "arabic": "أَنْ تُطِيلَ عُمْرِي فِي خَيْرٍ وَعَافِيَةٍ،"
  },
  {
   "segment_id": 11,
   "arabic": "وَتُوَسِّعَ في رِزْقِي،"
  },
  {
   "segment_id": 12,
   "arabic": "وَتَجْعَلَنِي مِمَّنْ تَنْتَصِرُ بِهِ لِدِينِكَ"
  },
  {
   "segment_id": 13,
   "arabic": "وَلا تَسْتَبْدِلْ بِي غَيْرِي."
  }
 ]
}