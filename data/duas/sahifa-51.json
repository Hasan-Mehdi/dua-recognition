{
 "dua_id": "sahifa-51",
 "dua_name_en": "Sahifa 51: In pleading and abasement",
 "dua_name_ar": "دعـاؤه في التضرع والاستكانة",
 "source": "https://duas.pro/51-in-pleading-and-abasement",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "إلهِي أَحْمَـدُكَ ـ وَأَنْتَ لِلْحَمْدِ أَهْلٌ ـ"
  },
  {
   "segment_id": 2,
   "arabic": "عَلَى حُسْنِ صَنِيعِكَ إلَيَّ، وَسُبُـوغِ نَعْمَآئِكَ عَلَيَّ،"
  },
  {
   "segment_id": 3,
   "arabic": "وَجَزِيْلِ عَطَآئِكَ عِنْدِي،"
  },
  {
   "segment_id": 4,
   "arabic": "وَعَلَى ما فَضَّلْتَنِي مِنْ رَحْمَتِكَ،"
  },
  {
   "segment_id": 5,
   "arabic": "وَأَسْبَغْتَ عَلَيَّ مِنْ نِعْمَتِكَ،"
  },
  {
   "segment_id": 6,
   "arabic": "فَقَدِ اصْطَنَعْتَ عِنْدِي ما يَعْجِزُ عَنُهُ شُكْرِي، وَلَوْلاَ إحْسَانُكَ، إلَيَّ"
  },
  {
   "segment_id": 7,
   "arabic": "وَسُبُوغُ نَعْمَآئِـكَ عَلَيَّ"
  },
  {
   "segment_id": 8,
   "arabic": "مَا بَلَغْتُ إحْرازَ حَظِّي، وَلاَ إصْلاَحَ نَفْسِي،"
  },
  {
   "segment_id": 9,
   "arabic": "وَلكِنَّكَ ابْتَدَأْتَنِي بِالإحْسَانِ،"
  },
  {
   "segment_id": 10,
   "arabic": "وَرَزَقْتَنِي فِي أُمُورِي كُلِّهَا الْكِفَايَةَ،"
  },
  {
   "segment_id": 11,
   "arabic": "وَصَرَفْتَ عَنِّي جَهْدَ الْبَلاءِ،"
  },
  {
   "segment_id": 12,
   "arabic": "وَمَنَعْتَ مِنِّي مَحْذُورَ الْقَضَآءِ"
  },
  {
   "segment_id": 13,
   "arabic": "إلهِي فَكَمْ مِنْ بَلاء جَاهِد قَدْ صَرَفْتَ عَنِّي،"
  },
  {
   "segment_id": 14,
   "arabic": "وَكَمْ مِنْ نِعْمَة سَابِغَة أَقْرَرْتَ بِهَا عَيْنِي،"
  },
  {
   "segment_id": 15,
   "arabic": "وَكَمْ مِنْ صَنِيعَة كَرِيمَة لَكَ عِنْدِي."
  },
  {
   "segment_id": 16,
   "arabic": "أَنْتَ الَّذِي أَجَبْتَ عِنْدَ الاضْطِرَارِ دَعْوَتِي،"
  },
  {
   "segment_id": 17,
   "arabic": "وَأَقَلْتَ عِنْدَ الْعِثَارِ زَلَّتِي،"
  },
  {
   "segment_id": 18,
   "arabic": "وَأَخَذْتَ لِي مِنَ الاَعْدَآءِ بِظُلاَمَتِي."
  },
  {
   "segment_id": 19,
   "arabic": "إلهِي مَا وَجَدْتُكَ بَخِيلاً حِينَ سَأَلْتُكَ،"
  },
  {
   "segment_id": 20,
   "arabic": "وَلاَ مُنْقَبِضاً حِينَ أَرَدْتُكَ،"
  },
  {
   "segment_id": 21,
   "arabic": "بل وَجَدْتُكَ لِدُعَآئِي سَامِعاً، وَلِمَطَالِبِي مُعْطِياً،"
  },
  {
   "segment_id": 22,
   "arabic": "وَوَجَدْتُ نُعْمَاكَ عَلَيَّ سَابِغَةً،"
  },
  {
   "segment_id": 23,
   "arabic": "فِي كُلِّ شَأْن مِنْ شَأْنِي، وَكُلِّ زَمَان مِنْ زَمَانِي،"
  },
  {
   "segment_id": 24,
   "arabic": "فَأَنْتَ عِنْدِي مَحْمُودٌ، وَصَنِيعُكَ لَدَيَّ مَبْرُورٌ،"
  },
  {
   "segment_id": 25,
   "arabic": "تَحْمَدُكَ نَفْسِي وَلِسَانِيْ وَعَقْلِي حَمْداً يَبْلُغُ الوَفَآءَ وَحَقِيقَةَ الشُّكْرِ،"
  },
  {
   "segment_id": 26,
   "arabic": "حَمْداً يَكُونُ مَبْلَغَ رِضَاكَ عَنِّي،"
  },
  {
   "segment_id": 27,
   "arabic": "فَنَجِّنِي مِنْ سَخَطِكَ يَا كَهْفِي حِينَ تُعْعينِي الْمَذَاهِبُ،"
  },
  {
   "segment_id": 28,
   "arabic": "وَيَا مُقيلِي عَثْرَتِي،"
  },
  {
   "segment_id": 29,
   "arabic": "فَلَوْلاَ سَتْرُكَ عَوْرَتِي لَكُنْتُ مِنَ الْمَفْضُوحِينَ،"
  },
  {
   "segment_id": 30,
   "arabic": "وَيَا مُؤَيِّدِي بِالنَّصْرِ،"
  },
  {
   "segment_id": 31,
   "arabic": "فَلَوْلاَ نَصْرُكَ إيَّايَ لَكُنْتُ مِنَ الْمَغْلُوبِينَ،"
  },
  {
   "segment_id": 32,
   "arabic": "وَيَا مَنْ وَضَعَتْ لَهُ الْمُلُوكُ نِيرَ الْمَذَلَّةِ عَلى أَعْنَاقِهَا،"
  },
  {
   "segment_id": 33,
   "arabic": "فَهُمْ مِنْ سَطَواتِهِ خَائِفُونَ، وَيَا أَهْلَ التَّقْوَى،"
  },
  {
   "segment_id": 34,
   "arabic": "وَيَا مَنْ لَهُ الأَسْمَآءُ الْحُسْنى أَسْأَلُكَ أَنْ تَعْفُوَ عَنِّي،"
  },
  {
   "segment_id": 35,
   "arabic": "وَتَغْفِرَ لِي فَلَسْتُ، بَرِيئاً فَأَعْتَذِرَ،"
  },
  {
   "segment_id": 36,
   "arabic": "وَلاَ بِذِي قُوَّة فَأَنْتَصِرَ،"
  },
  {
   "segment_id": 37,
   "arabic": "وَلاَ مَفَرَّ لِي فَأَفِرَّ. وَأَسْتَقِيْلُكَ عَثَراتِي،"
  },
  {
   "segment_id": 38,
   "arabic": "وَأَتَنَصَّلُ إلَيْكَ مِنْ ذُنُوبِي الَّتِي قَدْ أَوْبَقَتْنِي،"
  },
  {
   "segment_id": 39,
   "arabic": "وَأَحَاطَتْ بِي فَأَهْلَكَتْنِي،"
  },
  {
   "segment_id": 40,
   "arabic": "مِنْهَا فَرَرْتُ إلَيْكَ رَبِّ تَائِباً،"
  },
  {
   "segment_id": 41,
   "arabic": "فَتُبْ عَلَيَّ مُتَعَوِّذاً، فَأَعِذْنِي مُسْتَجِيراً،"
  },
  {
   "segment_id": 42,
   "arabic": "فَلاَ تَخْذُلْنِي سَآئِلاً، فَلاَ تَحْرِمْنِي مُعْتَصِماً،"
  },
  {
   "segment_id": 43,
   "arabic": "فَلاَ تُسْلِمْنِي دَاعِياً، فَلاَ تَرُدَّنِي خَائِباً،"
  },
  {
   "segment_id": 44,
   "arabic": "دَعوْتُكَ يَارَبِّ مِسْكِيناً، مُسْتَكِيناً،"
  },
  {
   "segment_id": 45,
   "arabic": "مُشْفِقاً، خَائِفاً، وَجِلاً، فَقِيراً، مُضْطَرّاً، إلَيْكَ"
  },
  {
   "segment_id": 46,
   "arabic": "أَشْكُو إلَيْكَ يَا إلهِي ضَعْفَ نَفْسِي"
  },
  {
   "segment_id": 47,
   "arabic": "عَنِ الْمُسَارَعَةِ فِيمَا وَعَدْتَهُ أَوْلِيَآءَكَ،"
  },
  {
   "segment_id": 48,
   "arabic": "وَالْمُجَانَبَةِ عَمَّا حَذَّرْتَهُ أَعْدَآءَكَ،"
  },
  {
   "segment_id": 49,
   "arabic": "وَكَثْرَةَ هُمُومِي وَوَسْوَسَةَ نَفْسِي ."
  },
  {
   "segment_id": 50,
   "arabic": "إلهِي لَمْ تَفْضَحْنِي بِسَرِيرَتِي،"
  },
  {
   "segment_id": 51,
   "arabic": "وَلَمْ تُهْلِكْنِي بِجَرِيرَتِي، أَدْعُوكَ فَتُجِيبُنِي"
  },
  {
   "segment_id": 52,
   "arabic": "وَإنْ كُنْتُ بَطِيئاً حِيْنَ تَدْعُونِي."
  },
  {
   "segment_id": 53,
   "arabic": "وَأَسْأَلُكَ كُلَّمَا شِئْتُ مِنْ حَوَائِجِي،"
  },
  {
   "segment_id": 54,
   "arabic": "وَحَيْثُ مَا كُنْتُ وَضَعْتُ عِنْدَكَ سِرِّي،"
  },
  {
   "segment_id": 55,
   "arabic": "فَلاَ أَدْعُو سِوَاكَ، وَلاَ أَرْجُو غَيْرَكَ،"
  },
  {
   "segment_id": 56,
   "arabic": "لَبَّيْكَ لَبَّيْكَ، تَسْمَعُ مَنْ شَكَا إلَيْكَ،"
  },
  {
   "segment_id": 57,
   "arabic": "وَتَلْقى مَنْ تَوَكَّلَ عَلَيْكَ،"
  },
  {
   "segment_id": 58,
   "arabic": "وَتُخَلِّصُ مَنِ اعْتَصَمَ بِكَ،"
  },
  {
   "segment_id": 59,
   "arabic": "وَتُفَرِّجُ عَمَّنْ لاذَ بِكَ."
  },
  {
   "segment_id": 60,
   "arabic": "إلهِي فَلاَ تَحْرِمْنِي خَيْرَ الآخِرَةِ وَالأُولى لِقِلَّةِ شُكْرِي،"
  },
  {
   "segment_id": 61,
   "arabic": "وَاغْفِرْ لِي مَا تَعْلَمُ مِنْ ذُنُوبِي،"
  },
  {
   "segment_id": 62,
   "arabic": "إنْ تُعَذِّبْ فَأَنَا الظَّالِمُ، الْمُفَرِّطُ،"
  },
  {
   "segment_id": 63,
   "arabic": "الْمُضَيِّعُ، الاثِمُ، الْمُقَصِّرُ، الْمُضْجِعُ،"
  },
  {
   "segment_id": 64,
   "arabic": "الُمُغْفِلُ حَظَّ نَفْسِي،"
  },
  {
   "segment_id": 65,
   "arabic": "وَإنْ تَغْفِرْ فَأَنْتَ أَرْحَمُ الرَّاحِمِينَ."
  }
 ]
}