{
 "dua_id": "dua-ramadan-14",
 "dua_name_en": "Day 14",
 "dua_name_ar": " شهر رمضان ١٤  ",
 "source": "https://www.duaplayer.org/en/dua/ramadan-14",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "اللّهُمّ لا تُؤَاخِذْنِي فِيهِ بِالعَثَرَاتِ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَأَقِلْنِي فِيهِ مِنَ الخَطَايَا وَالهَفَوَاتِ،"
  },
  {
   "segment_id": 5,
   "arabic": "وَلا تَجْعَلْنِي فِيهِ غَرَضاً لِلْبَلايَا وَالآفَاتِ،"
  },
  {
   "segment_id": 6,
   "arabic": "بِعِزّتِكَ يَا عِزّ المُسْلِمِينَ."
  }
 ]
}