{
 "dua_id": "duasorg-arafah-day-dua-amaal-2",
 "dua_name_en": "Amaal for the Day of Arafah · Lā ilāha illallāh",
 "dua_name_ar": "",
 "source": "https://www.duas.org/arafah-day-dua-amaal.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "لاَ إِلٰهَ إِلاَّ ٱللَّهُ"
  },
  {
   "segment_id": 2,
   "arabic": "وَحْدَهُ لاَ شَريكَ لَهُ"
  },
  {
   "segment_id": 3,
   "arabic": "لَهُ ٱلْمُلْكُ وَلَهُ ٱلْحَمْدُ"
  },
  {
   "segment_id": 4,
   "arabic": "يُحْيِي وَيُميتُ"
  },
  {
   "segment_id": 5,
   "arabic": "وَيُميتُ وَيُحْيِي"
  },
  {
   "segment_id": 6,
   "arabic": "وَهُوَ حَيٌّ لاَ يَموُتُ"
  },
  {
   "segment_id": 7,
   "arabic": "بِيَدِهِ ٱلْخَيْرُ"
  },
  {
   "segment_id": 8,
   "arabic": "وَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَديرٌ"
  },
  {
   "segment_id": 9,
   "arabic": "أَسْتَغْفِرُ ٱللَّهَ ٱلَّذِي لاَ إِلٰهَ إِلاَّ هُوَ"
  },
  {
   "segment_id": 10,
   "arabic": "ٱلْحَيُّ ٱلْقَيُّومُ وَأَتُوبُ إِلَيْهِ"
  },
  {
   "segment_id": 11,
   "arabic": "يَا اللَّهُ"
  },
  {
   "segment_id": 12,
   "arabic": "يَا رَحْمٰنُ"
  },
  {
   "segment_id": 13,
   "arabic": "يَا رَحِيمُ"
  },
  {
   "segment_id": 14,
   "arabic": "يَا بَدِيعَ ٱلسَّمَاوَاتِ وَٱلأَرْضِ"
  },
  {
   "segment_id": 15,
   "arabic": "يَا ذَا ٱلْجَلاَلِ وَٱلإِكْرَامِ"
  },
  {
   "segment_id": 16,
   "arabic": "يَا حَيُّ يَا قَيُّومُ"
  },
  {
   "segment_id": 17,
   "arabic": "يَا حَنَّانُ يَا مَنَّانُ"
  },
  {
   "segment_id": 18,
   "arabic": "يَا لاَ إِلٰهَ إِلاَّ أَنْتَ"
  },
  {
   "segment_id": 19,
   "arabic": "آمِينَ"
  }
 ]
}