{
 "dua_id": "duasorg-thursday-night-rites-taqeeb-7",
 "dua_name_en": "Friday Dua at Fajr",
 "dua_name_ar": "",
 "source": "https://www.duas.org/thursday-night-rites-taqeeb.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "أَصْبَحْتُ فِي ذِمَّةِ ٱللَّهِ"
  },
  {
   "segment_id": 2,
   "arabic": "وَذِمَّةِ مَلاَئِكَتِهِ"
  },
  {
   "segment_id": 3,
   "arabic": "وَذِمَمِ أَنْبِيَائِهِ وَرُسُلِهِ عَلَيهِمُ ٱلسَّلاَمُ"
  },
  {
   "segment_id": 4,
   "arabic": "وَذِمَّةِ مُحَمَّدٍ صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ"
  },
  {
   "segment_id": 5,
   "arabic": "وَذِمَمِ ٱلأَوْصِيَاءِ مِنَ آلِ مُحَمَّدٍ عَلَيْهِمُ ٱلسَّلاَمُ"
  },
  {
   "segment_id": 6,
   "arabic": "آمَنْتُ بِسِرِّ آلِ مُحَمَّدٍ عَلَيْهِمُ ٱلسَّلاَمُ وَعَلاَنِيَتِهِمْ"
  },
  {
   "segment_id": 7,
   "arabic": "وَظَاهِرِهِمْ وَبَاطِنِهِمْ"
  },
  {
   "segment_id": 8,
   "arabic": "وَأَشْهَدُ أَنَّهُمْ فِي عِلْمِ ٱللَّهِ وَطَاعَتِهِ"
  },
  {
   "segment_id": 9,
   "arabic": "كَمُحَمَّدٍ صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ"
  }
 ]
}