 "dua_name_ar": " شهر رمضان ١٥  ",
 "source": "https://www.duaplayer.org/en/dua/ramadan-15",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "اللّهُمّ ارْزُقْنِي فِيهِ طَاعَةَ الخَاشِعِينَ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَاشْرَحْ فِيهِ صَدْرِي بِإِنَابَةِ المُخْبِتِينَ،"
  },
  {
   "segment_id": 5,
   "arabic": "بِأَمَانِكَ يَا أَمَانَ الخَائِفِينَ."
  }
 ]
}