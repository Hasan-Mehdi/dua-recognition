 "segments": [
  {
   "segment_id": 1,
   "arabic": "اسْالُ ٱللَّهَ ٱلَّذِي ٱجْتَبَاكَ وَٱخْتَارَكَ"
  },
  {
   "segment_id": 2,
   "arabic": "وَهَدَاكَ وَهَدَىٰ بِكَ"
  },
  {
   "segment_id": 3,
   "arabic": "انْ يُصَلِّيَ عَلَيْكَ"
  },
  {
   "segment_id": 4,
   "arabic": "«إِنَّ ٱللَّهَ وَمَلائِكَتَهُ يُصَلُّونَ عَلَىٰ ٱلنَّبِيِّ"
  },
  {
   "segment_id": 5,
   "arabic": "يَا ايُّهَا ٱلَّذِينَ آمَنُوٱ صَلُّوٱ عَلَيْهِ وَسَلِّمُوٱ تَسْلِيماً.»"
  }
 ]
}