{
 "dua_id": "duasorg-ramadan-every-night-dua-1",
 "dua_name_en": "Allahumma Rabba Shahri Ramadan",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-every-night-dua.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللَّهُمَّ رَبَّ شَهْرِ رَمَضَانَ"
  },
  {
   "segment_id": 2,
   "arabic": "ٱلَّذِي أَنْزَلْتَ فِيهِ ٱلْقُرْآنَ"
  },
  {
   "segment_id": 3,
   "arabic": "وَٱفْتَرَضْتَ عَلَىٰ عِبَادِكَ فِيهِ ٱلصِّيَامَ"
  },
  {
   "segment_id": 4,
   "arabic": "صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 5,
   "arabic": "وٱرْزُقْنِي حَجَّ بَيْتِكَ ٱلْحَرَامِ"
  },
  {
   "segment_id": 6,
   "arabic": "فِي هٰذَا ٱلْعَامِ وَفِي كُلِّ عَامٍ"
  },
  {
   "segment_id": 7,
   "arabic": "وَٱغْفِرْ لِيَ ٱلذُّنُوبَ ٱلْعِظَامَ"
  },
  {
   "segment_id": 8,
   "arabic": "فَإِنَّهُ لاَ يَغْفِرُهَا غَيْرُكَ"
  },
  {
   "segment_id": 9,
   "arabic": "يَا رَحْمٰنُ يَا عَلاَّمُ"
  }
 ]
}