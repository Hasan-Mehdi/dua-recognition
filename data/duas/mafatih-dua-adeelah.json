{
 "dua_id": "mafatih-dua-adeelah",
 "dua_name_en": "Dua Adeelah",
 "dua_name_ar": "دعاء العديلة",
 "source": "Mafatih al-Jinan (github.com/kazemcodes/MafatihDecoder); lines from reciters' pauses",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "شَهِدَ اللّهُ أَنَّهُ لا إِلهَ إِلاّ هُوَ"
  },
  {
   "segment_id": 2,
   "arabic": "وَالْمَلائِكَةُ وَأُولُوا الْعِلْمِ قائِما بِالْقِسْطِ"
  },
  {
   "segment_id": 3,
   "arabic": "لا إِلهَ إِلاّ هُوَ الْعَزيزُ الْحَكيمُ"
  },
  {
   "segment_id": 4,
   "arabic": "إِنَّ الدّينَ عِنْدَ اللهِ الإِسْلامُ"
  },
  {
   "segment_id": 5,
   "arabic": "وَأَنَا الْعَبْدُ الضَّعيفُ الْمُذْنِبُ الْعاصِي الْمُحْتاجُ الْحَقيرُ"
  },
  {
   "segment_id": 6,
   "arabic": "أَشْهَدُ لِمُنْعِمي وَخالِقي وَرازِقي"
  },
  {
   "segment_id": 7,
   "arabic": "وَمُكْرِمي كَما شَهِدَ لِذاتِهِ"
  },
  {
   "segment_id": 8,
   "arabic": "وَشَهِدَتْ لَهُ الْمَلائِكَةُ وَأُولُوا الْعِلْمِ مِنْ عِبادِهِ"
  },
  {
   "segment_id": 9,
   "arabic": "بِأَنَّهُ لا إِلهَ إِلاّ هُوَ ذُو النِّعَمِ وَالإِحْسانِ"
  },
  {
   "segment_id": 10,
   "arabic": "وَالْكَرَمِ وَالإِمْتِنانِ قادِرٌ أَزَلِيُّ"
  },
  {
   "segment_id": 11,
   "arabic": "عالِمٌ أَبَدِيُّ حَيُّ أَحَدِيُّ"
  },
  {
   "segment_id": 12,
   "arabic": "مَوْجُودٌ سَرْمَدِيُّ سَميعٌ بَصيرٌ"
  },
  {
   "segment_id": 13,
   "arabic": "مُريدٌ كارِهٌ مُدْرِكٌ صَمَدِيُّ"
  },
  {
   "segment_id": 14,
   "arabic": "يَسْتَحِقُّ هذِهِ الصِّفاتِ"
  },
  {
   "segment_id": 15,
   "arabic": "وَهُوَ عَلى ما هُوَ عَلَيْهِ في عِزِّ صِفاتِهِ"
  },
  {
   "segment_id": 16,
   "arabic": "كانَ قَوِيّاً قَبْلَ وُجُودِ الْقُدْرَةِ وَالْقُوَّةِ"
  },
  {
   "segment_id": 17,
   "arabic": "وَكانَ عَليما قَبْلَ إِيجادِ الْعِلْمِ وَالْعِلَّةِ"
  },
  {
   "segment_id": 18,
   "arabic": "لَمْ يَزَلْ سُلْطانا إِذْ لا مَمْلَكَةَ وَلا مالَ"
  },
  {
   "segment_id": 19,
   "arabic": "وَلَمْ يَزَلْ سُبْحانا عَلى جَميعِ الأَحْوالِ"
  },
  {
   "segment_id": 20,
   "arabic": "وُجُودُهُ قَبْلَ الْقَبْلِ في أَزَلِ الآزالِ"
  },
  {
   "segment_id": 21,
   "arabic": "وَبَقائُهُ بَعْدَ الْبَعْدِ مِنْ غَيْرِ اِنْتِقالٍ وَلا زَوالٍ"
  },
  {
   "segment_id": 22,
   "arabic": "غَنِيُّ فِي الأَوَّلِ وَالآخِرِ"
  },
  {
   "segment_id": 23,
   "arabic": "مُسْتَغْنٍ فِي الْباطِنِ وَالظّاهِرِ"
  },
  {
   "segment_id": 24,
   "arabic": "لا جَوْرَ في قَضِيَّتِهِ"
  },
  {
   "segment_id": 25,
   "arabic": "وَلا مَيْلَ في مَشِيَّتِهِ"
  },
  {
   "segment_id": 26,
   "arabic": "وَلا ظُلْمَ في تَقْديرِهِ"
  },
  {
   "segment_id": 27,
   "arabic": "وَلا مَهْرَبَ مِنْ حُكُومَتِهِ"
  },
  {
   "segment_id": 28,
   "arabic": "وَلا مَلْجَأَ مِنْ سَطَواتِهِ"
  },
  {
   "segment_id": 29,
   "arabic": "وَلا مَنْجا مِنْ نَقِماتِهِ"
  },
  {
   "segment_id": 30,
   "arabic": "سَبَقَتْ رَحْمَتُهُ غَضَبَهُ"
  },
  {
   "segment_id": 31,
   "arabic": "وَلا يَفُوتُهُ أَحَدٌ إِذا طَلَبَهُ"
  },
  {
   "segment_id": 32,
   "arabic": "أَزاحَ الْعِلَلَ فِي التَّكْليفِ وَسَوَّى التَّوْفيقَ بَيْنَ الضَّعيفِ وَالشَّريفِ"
  },
  {
   "segment_id": 33,
   "arabic": "مَكَّنَ أَداءَ الْمَأْمُورِ وَسَهَّلَ سَبيلَ اجْتِنابِ الْمَحْظُورِ"
  },
  {
   "segment_id": 34,
   "arabic": "لَمْ يُكَلِّفِ الطّاعَةَ إِلاّ دُوْنَ الْوُسْعِ والطّاقَةِ"
  },
  {
   "segment_id": 35,
   "arabic": "سُبْحانَهُ ما أَبْيَنَ كَرَمَهُ وَأَعْلى شَأْنَهُ"
  },
  {
   "segment_id": 36,
   "arabic": "سُبْحانَهُ ما أَجَلَّ نَيْلَهُ وَأَعْظَمَ إِحْسانَهُ"
  },
  {
   "segment_id": 37,
   "arabic": "بَعَثَ الأَنْبِياءَ لِيُبَيِّنَ عَدْلَهُ"
  },
  {
   "segment_id": 38,
   "arabic": "وَنَصَبَ الأَوْصِياءَ لِيُظْهِرَ طَوْلَهُ وَفَضْلَهُ"
  },
  {
   "segment_id": 39,
   "arabic": "وَجَعَلَنا مِنْ أُمَّةِ سَيِّدِ الأَنْبِياءِ وَخَيْرِ الأَوْلِياءِ"
  },
  {
   "segment_id": 40,
   "arabic": "وَأَفْضَلِ الأَصْفِياءِ وَأَعْلَى الأَزْكِياءِ مُحَمَّدٍ"
  },
  {
   "segment_id": 41,
   "arabic": "صَلَّى اللّهُ عَلَيْهِ وَآلِهِ وَسَلَّمَ"
  },
  {
   "segment_id": 42,
   "arabic": "آمَنّا بِهِ وَبِما دَعانا إِلَيْهِ"
  },
  {
   "segment_id": 43,
   "arabic": "وَبِالْقُرْآنِ الَّذي أَنْزَلَهُ عَلَيْهِ"
  },
  {
   "segment_id": 44,
   "arabic": "وَبِوَصِيِّهِ الَّذي نَصَبَهُ يَوْمَ الْغَديرِ"
  },
  {
   "segment_id": 45,
   "arabic": "وَأَشارَ بِقَوْلِهِ هذا عَلِيُّ إِلَيْهِ"
  },
  {
   "segment_id": 46,
   "arabic": "وَأَشْهَدُ أَنَّ الأَئِمَّةَ الأَبْرارَ"
  },
  {
   "segment_id": 47,
   "arabic": "وَالْخُلَفاءَ الأَخْيارَ بَعْدَ الرَّسُولِ الْمُخْتارِ"
  },
  {
   "segment_id": 48,
   "arabic": "عَلِيُّ قامِعُ الْكُفّارِ"
  },
  {
   "segment_id": 49,
   "arabic": "وَمِنْ بَعْدِهِ سَيِّدُ أَوْلادِهِ الْحَسَنُ بْنُ عَلِي"
  },
  {
   "segment_id": 50,
   "arabic": "ثُمَّ أَخُوهُ السِّبْطُ التّابِعُ لِمَرْضاتِ اللّهِ الْحُسَيْنُ"
  },
  {
   "segment_id": 51,
   "arabic": "ثُمَّ الْعابِدُ عَلِيُّ ثُمَّ الْباقِرُ مُحَمَّدٌ"
  },
  {
   "segment_id": 52,
   "arabic": "ثُمَّ الصّادِقُ جَعْفَرٌ ثُمَّ الْكاظِمُ مُوسى"
  },
  {
   "segment_id": 53,
   "arabic": "ثُمَّ الرِّضا عَلِيُّ ثُمَّ التَّقِيُّ مُحَمَّدٌ"
  },
  {
   "segment_id": 54,
   "arabic": "ثُمَّ النَّقِيُّ عَلِيُّ ثُمَّ الزَّكِيُّ الْعَسْكَرِيُّ الْحَسَنُ"
  },
  {
   "segment_id": 55,
   "arabic": "ثُمَّ الْحُجَّةُ الْخَلَفُ الْقائِمُ الْمُنْتَظَرُ الْمَهْدِيُّ الْمُرجَى"
  },
  {
   "segment_id": 56,
   "arabic": "الَّذي بِبَقائِهِ بَقِيَتِ الدُّنْيا"
  },
  {
   "segment_id": 57,
   "arabic": "وَبِيُمْنِهِ رُزِقَ الْوَرى"
  },
  {
   "segment_id": 58,
   "arabic": "وَبِوُجُودِهِ ثَبَتَتِ الأَرْضُ وَالسَّماءُ"
  },
  {
   "segment_id": 59,
   "arabic": "وَبِهِ يَمْلَأُ اللّهُ الأَرْضَ قِسْطا وَعَدْلاً"
  },
  {
   "segment_id": 60,
   "arabic": "بَعْدَ ما مُلِئَتْ ظُلْما وَجَوْرا"
  },
  {
   "segment_id": 61,
   "arabic": "وَأَشْهَدُ أَنَّ أَقْوالَهُمْ حُجَّةٌ"
  },
  {
   "segment_id": 62,
   "arabic": "وَامْتِثالَهُمْ فَريْضَةٌ وَطاعَتَهُمْ مَفْرُوضَةٌ"
  },
  {
   "segment_id": 63,
   "arabic": "وَمَوَدَّتَهُمْ لازِمَةٌ مَقْضِيَّةٌ"
  },
  {
   "segment_id": 64,
   "arabic": "وَالإِقْتِداءَ بِهِمْ مُنْجِيَةٌ وَمُخالَفَتَهُمْ مُرْدِيَةٌ"
  },
  {
   "segment_id": 65,
   "arabic": "وَهُمْ ساداتُ أَهْلِ الْجَنَّةِ أَجْمَعينَ"
  },
  {
   "segment_id": 66,
   "arabic": "وَشُفَعاءُ يَوْمِ الدّينِ وَأَئِمَّةُ أَهْلِ الأَرْضِ عَلَى الْيَقينِ"
  },
  {
   "segment_id": 67,
   "arabic": "وَأَفْضَلُ الأَوْصِياءِ الْمَرْضِيّينَ"
  },
  {
   "segment_id": 68,
   "arabic": "وَأَشْهَدُ أَنَّ الْمَوْتَ حَقُّ وَمُسائَلَةَ الْقَبْرِ حَقُّ"
  },
  {
   "segment_id": 69,
   "arabic": "وَالْبَعْثَ حَقُّ وَالنُّشُورَ حَقُّ وَالصِّراطَ حَقُّ"
  },
  {
   "segment_id": 70,
   "arabic": "وَالْميزانَ حَقُّ وَالْحِسابَ حَقُّ"
  },
  {
   "segment_id": 71,
   "arabic": "وَالْكِتابَ حَقُّ وَالْجَنَّةَ حَقُّ وَالنّارَ حَقُّ"
  },
  {
   "segment_id": 72,
   "arabic": "وَأَنَّ السّاعَةَ آتِيَةٌ لا رَيْبَ فيها"
  },
  {
   "segment_id": 73,
   "arabic": "وَأَنَّ اللّهَ يَبْعَثُ مَنْ فِي الْقُبُورِ"
  },
  {
   "segment_id": 74,
   "arabic": "اَللّهُمَّ فَضْلُكَ رَجائي وَكَرَمُكَ وَرَحْمَتُكَ أَمَلي"
  },
  {
   "segment_id": 75,
   "arabic": "لا عَمَلَ لي أَسْتَحِقُّ بِهِ الْجَنَّةَ"
  },
  {
   "segment_id": 76,
   "arabic": "وَلا طاعَةَ ليْ أَسْتَوْجِبُ بِهَا الرِّضْوانَ"
  },
  {
   "segment_id": 77,
   "arabic": "إِلاّ أَنِّي اِعْتَقَدْتُ تَوْحيدَكَ وَعَدْلَكَ"
  },
  {
   "segment_id": 78,
   "arabic": "وَارْتَجَيْتُ إِحْسانَكَ وَفَضْلَكَ وَتَشَفَّعْتُ إِلَيْكَ بِالنَّبِيِّ وَآلِهِ مَنْ أَحِبَّتِكَ"
  },
  {
   "segment_id": 79,
   "arabic": "وَأَنْتَ أَكْرَمُ الأَكْرَمينَ وَأَرْحَمُ الرّاحِمينَ"
  },
  {
   "segment_id": 80,
   "arabic": "وَصَلَّى اللّهُ عَلى نَبِيِّنا مُحَمَّدٍ وَآلِهِ أَجْمَعينَ"
  },
  {
   "segment_id": 81,
   "arabic": "الطَّيِّبينَ الطّاهِريْنَ وَسَلَّمَ تَسْليما كَثيرا كَثيرا"
  },
  {
   "segment_id": 82,
   "arabic": "وَلا حَوْلَ وَلا قُوَّةَ إِلاّ بِاللّهِ الْعَلِيِّ الْعَظيمِ"
  },
  {
   "segment_id": 83,
   "arabic": "اَللّهُمَّ يا أَرْحَمَ الرّاحِمينَ"
  },
  {
   "segment_id": 84,
   "arabic": "إِنّي أَوْدَعْتُكَ يَقيني هذا وَثَباتَ ديني"
  },
  {
   "segment_id": 85,
   "arabic": "وَأَنْتَ خَيْرُ مُسْتَوْدَعٍ وَقَدْ أَمَرْتَنا بِحِفْظِ الْوَدائِعِ"
  },
  {
   "segment_id": 86,
   "arabic": "فَرُدَّهُ عَلَيَّ وَقْتَ حُضُورِ مَوْتي"
  },
  {
   "segment_id": 87,
   "arabic": "بِرَحْمَتِكَ يا أَرْحَمَ الرّاحِمينَ"
  },
  {
   "segment_id": 88,
   "arabic": "اَللّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْعَديلَةِ عِنْدَ الْمَوْتِ"
  },
  {
   "segment_id": 89,
   "arabic": "اَللّهُمَّ يا أَرْحَمَ الرّاحِمينَ"
  },
  {
   "segment_id": 90,
   "arabic": "إِنّي قَدْ أَوْدَعْتُكَ يَقيني هذا وَثَباتَ ديني"
  },
  {
   "segment_id": 91,
   "arabic": "وَأَنْتَ خَيْرُ مُسْتَوْدَعٍ"
  },
  {
   "segment_id": 92,
   "arabic": "وَقَدْ أَمَرْتَنا بِحِفْظِ الْوَدائِعِ"
  },
  {
   "segment_id": 93,
   "arabic": "فَرُدَّهُ عَلَيَّ وَقْتَ حُضُورِ مَوْتي"
  },
  {
   "segment_id": 94,
   "arabic": "رَضيتُ بِاللّهِ رَبّا"
  },
  {
   "segment_id": 95,
   "arabic": "وَبِمُحَمَّدٍ صَلَّى اللّهُ عَلَيْهِ وَآلِهِ نَبِيّا"
  },
  {
   "segment_id": 96,
   "arabic": "وَبِالاِسْلامِ دينا وَبِالْقُرآنِ كِتابا"
  },
  {
   "segment_id": 97,
   "arabic": "وَبِالْكَعْبَةِ قِبْلَةً وَبِعَلِي وَلِيّا وَإِماماً"
  },
  {
   "segment_id": 98,
   "arabic": "وَبِالْحَسَنِ وَالْحُسَيْنِ وَعَلِيِّ بْنِ الْحُسَيْنِ"
  },
  {
   "segment_id": 99,
   "arabic": "وَمُحَمَّدِ بْنِ عَلِي وَجَعْفَرِ بْنِ مُحَمَّدٍ"
  },
  {
   "segment_id": 100,
   "arabic": "وَمُوسى بْنِ جَعْفَرٍ وَعَلِيِّ بْنِ مُوسى"
  },
  {
   "segment_id": 101,
   "arabic": "وَمُحَمَّدِ بْنِ عَلِي وَعَلِيِّ بْنِ مُحَمَّدٍ"
  },
  {
   "segment_id": 102,
   "arabic": "وَالْحَسَنِ بْنِ عَلِي وَالْحُجَّةِ بْنِ الْحَسَنِ"
  },
  {
   "segment_id": 103,
   "arabic": "صَلَواتُ اللّهِ عَلَيْهِمْ أَئِمَّةً"
  },
