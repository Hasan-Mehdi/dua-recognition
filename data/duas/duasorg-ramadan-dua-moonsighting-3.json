{
 "dua_id": "duasorg-ramadan-dua-moonsighting-3",
 "dua_name_en": "Ramadan Moonsighting - Allahumma Ahillahu Alayna",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-dua-moonsighting.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللّهُمّ أَهِلّهُ عَلَيْنَا بِالأَمْنِ وَالإيمَانِ"
  },
  {
   "segment_id": 2,
   "arabic": "وَالسّلامَةِ وَالإسْلامِ"
  },
  {
   "segment_id": 3,
   "arabic": "وَالعَافِيَةِ المُجَلّلَةِ وَدِفَاعِ الأَسْقَامِ"
  },
  {
   "segment_id": 4,
   "arabic": "وَالعَوْنِ عَلَى الصّلاةِ وَالصّيَامِ وَالقِيَامِ"
  },
  {
   "segment_id": 5,
   "arabic": "وَتِلاوَةِ القُرْآنِ."
  },
  {
   "segment_id": 6,
   "arabic": "اللّهُمّ سَلّمْنَا لِشَهْرِ رَمَضَانَ،"
  },
  {
   "segment_id": 7,
   "arabic": "وَتَسَلّمْهُ مِنَّا،"
  },
  {
   "segment_id": 8,
   "arabic": "وَسَلّمْنَا فِيهِ"
  },
  {
   "segment_id": 9,
   "arabic": "حَتَّى يَنْقَضِيَ عَنَّا شَهْرُ رَمَضَانَ"
  },
  {
   "segment_id": 10,
   "arabic": "وَقَدْ عَفَوْتَ عَنَّا وَغَفَرْتَ لَنَا وَرَحِمْتَنَا."
  }
 ]
}