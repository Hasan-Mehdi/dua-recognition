{
 "dua_id": "dua-ya-uddati",
 "dua_name_en": "Dua Ya Uddati",
 "dua_name_ar": "دعاء يَا عُدَّتِي ",
 "source": "https://www.duaplayer.org/en/dua/ya-uddati",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "يَا عُدَّتِي فِي كُرْبَتِي،"
  },
  {
   "segment_id": 2,
   "arabic": "وَيَا صَاحِبِي فِي شِدَّتِي،"
  },
  {
   "segment_id": 3,
   "arabic": "وَيَا وَلِيِّي فِي نِعْمَتِي،"
  },
  {
   "segment_id": 4,
   "arabic": "وَيَا غَايَتِي فِي رَغْبَتِي،"
  },
  {
   "segment_id": 5,
   "arabic": "أَنْتَ السَّاتِرُ عَوْرَتِي،"
  },
  {
   "segment_id": 6,
   "arabic": "وَالْمُؤْمِنُ رَوْعَتِي،"
  },
  {
   "segment_id": 7,
   "arabic": "وَالْمُقِيلُ عَثْرَتِي،"
  },
  {
   "segment_id": 8,
   "arabic": "فَاغْفِرْ لِي خَطِيئَتِي."
  },
  {
   "segment_id": 9,
   "arabic": "اللّهُمَّ إنِّي أَسْأَلُكَ خُشُوعَ الإيمَانِ"
  },
  {
   "segment_id": 10,
   "arabic": "قَبْلَ خُشُوعِ الذُلَّ فِي النَّارِ،"
  },
  {
   "segment_id": 11,
   "arabic": "يَا وَاحِدُ يَا أَحَدُ يَا صَمَدُ"
  },
  {
   "segment_id": 12,
   "arabic": "يَا مَنْ لَمْ يَلِدْ وَلَمْ يُولَدْ"
  },
  {
   "segment_id": 13,
   "arabic": "وَلَمْ يَكُنْ لَهُ كُفُواً أَحَدٌ،"
  },
  {
   "segment_id": 14,
   "arabic": "يَا مَنْ يُعْطِي مَنْ سَأَلَهُ"
  },
  {
   "segment_id": 15,
   "arabic": "تَحَنُّناً مِنْهُ وَرَحْمَةً،"
  },
  {
   "segment_id": 16,
   "arabic": "وَيَبْتَدِئُ بِالْخَيْرِ مَنْ لَمْ يَسْأَلْهُ"
  },
  {
   "segment_id": 17,
   "arabic": "تَفَضُّلاً مِنْهُ وَكَرَماً،"
  },
  {
   "segment_id": 18,
   "arabic": "بِكَرَمِكَ الدَّائِمِ"
  },
  {
   "segment_id": 19,
   "arabic": "صَلِّ عَلَى مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 20,
   "arabic": "وَهَبْ لِي رَحْمَةً وَاسِعَةً جَامِعَةً"
  },
  {
   "segment_id": 21,
   "arabic": "أَبْلُغُ بِهَا خَيْرَ الدُّنْيَا وَالآخِرَةِ."
  },
  {
   "segment_id": 22,
   "arabic": "اللّهُمَّ إنِّي أَسْتَغْفِرُكَ لِمَا تُبْتُ إلَيْكَ مِنْهُ ثُمَّ عُدْتُ فِيهِ،"
  },
  {
   "segment_id": 23,
   "arabic": "وَأَسْتَغْفِرُكَ لِكُلِّ خَيْرٍ أَرَدْتُ بِهِ وَجْهَكَ"
  },
  {
   "segment_id": 24,
   "arabic": "فَخَالَطَنِي فِيهِ مَا لَيْسَ لَكَ."
  },
  {
   "segment_id": 25,
   "arabic": "اللّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 26,
   "arabic": "وَاعْفُ عَنْ ظُلْمِي وَجُرْمِي"
  },
  {
   "segment_id": 27,
   "arabic": "بِحِلْمِكَ وَجُودِكَ يَا كَرِيمُ،"
  },
  {
   "segment_id": 28,
   "arabic": "يَامَنْ لا يَخِيبُ سَائِلُهُ،"
  },
  {
   "segment_id": 29,
   "arabic": "وَلا يَنْفَدُ نَائِلُهُ،"
  },
  {
   "segment_id": 30,
   "arabic": "يَا مَنْ عَلا فَلا شَيْءَ فَوْقَهُ،"
  },
  {
   "segment_id": 31,
   "arabic": "وَدَنَا فَلا شَيْءَ دُونَهُ،"
  },
  {
   "segment_id": 32,
   "arabic": "صَلِّ عَلَى مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 33,
   "arabic": "وَارْحَمْنِي"
  },
  {
   "segment_id": 34,
   "arabic": "يَا فَالِقَ الْبَحْرِ لِمُوسَى،"
  },
  {
   "segment_id": 35,
   "arabic": "اللَّيْلَةَ اللَّيْلَةَ اللَّيْلَةَ،"
  },
  {
   "segment_id": 36,
   "arabic": "السَّاعَةَ السَّاعَةَ السَّاعَةَ."
  },
  {
   "segment_id": 37,
   "arabic": "اللّهُمَّ طَهِّرْ قَلْبِي مِنَ النِّفَاقِ،"
  },
  {
   "segment_id": 38,
   "arabic": "وَعَمَلِي مِنَ الرِّيَاءِ،"
  },
  {
   "segment_id": 39,
   "arabic": "وَلِسَانِي مِنَ الكَذِبِ،"
  },
  {
   "segment_id": 40,
   "arabic": "وَعَيْنِي مِنَ الْخِيَانَةِ،"
  },
  {
   "segment_id": 41,
   "arabic": "فَإنَّكَ تَعْلَمُ خَائِنَةَ الأَعْيُنِ وَمَا تُخْفِي الصُّدُورُ،"
  },
  {
   "segment_id": 42,
   "arabic": "يَا رَبِّ هذَا مَقَامُ الْعَائِذِ بِكَ مِنَ النَّارِ،"
  },
  {
   "segment_id": 43,
   "arabic": "هذَا مَقَامُ الْمُسْتَجِيرِ بِكَ مِنَ النَّارِ،"
  },
  {
   "segment_id": 44,
   "arabic": "هذَا مَقَامُ الْمُسْتَغِيثِ بِكَ مِنَ النَّارِ،"
  },
  {
   "segment_id": 45,
   "arabic": "هذَا مَقَامُ الْهَارِبِ إلَيْكَ مِنَ النَّارِ،"
  },
  {
   "segment_id": 46,
   "arabic": "هذَا مَقَامُ مَنْ يَبُوءُ لَكَ بِخَطِيئَتِهِ،"
  },
  {
   "segment_id": 47,
   "arabic": "وَيَعْتَرِفُ بِذَنْبِهِ،"
  },
  {
   "segment_id": 48,
   "arabic": "وَيَتُوبُ إلَى رَبِّهِ،"
  },
  {
   "segment_id": 49,
   "arabic": "هذَا مَقَامُ الْبَائِسِ الْفَقِيرِ،"
  },
  {
   "segment_id": 50,
   "arabic": "هذَا مَقَامُ الْخَائِفِ الْمُسْتَجِيرِ،"
  },
  {
   "segment_id": 51,
   "arabic": "هذَا مَقَامُ الْمَحْزُونِ الْمَكْرُوبِ،"
  },
  {
   "segment_id": 52,
   "arabic": "هذَا مَقَامُ الْمَغْمُومِ الْمَهْمُومِ،"
  },
  {
   "segment_id": 53,
   "arabic": "هذَا مَقَامُ الْغَرِيبِ الْغَرِيقِ،"
  },
  {
   "segment_id": 54,
   "arabic": "هذَا مَقَامُ الْمُسْتَوْحِشِ الْفَرِقِ،"
  },
  {
   "segment_id": 55,
   "arabic": "هذَا مَقَامُ مَنْ لا يَجِدُ لِذَنْبِهِ غَافِراً غَيْرَكَ،"
  },
  {
   "segment_id": 56,
   "arabic": "وَلا لِضَعْفِهِ مُقَوِّياً إلاَّ أَنْتَ،"
  },
  {
   "segment_id": 57,
   "arabic": "وَلا لِهَمِّهِ مُفَرِّجاً سِوَاكَ،"
  },
  {
   "segment_id": 58,
   "arabic": "يَا اللّهُ يَا كَرِيمُ"
  },
  {
   "segment_id": 59,
   "arabic": "لا تُحْرِقْ وَجْهِي بِالنَّارِ بَعْدَ سُجُودِي لَكَ وَتَعْفِيرِي"
  },
  {
   "segment_id": 60,
   "arabic": "بِغَيرِ مَنٍّ مِنِّي عَلَيْكَ"
  },
  {
   "segment_id": 61,
   "arabic": "بَلْ لَكَ الْحَمْدُ وَالْمَنُّ وَالتَّفَضُّلُ عَلَيَّ،"
  },
  {
   "segment_id": 62,
   "arabic": "ارْحَمْ أَيْ رَبِّ أَيْ رَبِّ أَيْ رَبِّ..."
  },
  {
   "segment_id": 63,
   "arabic": "ضَعْفِي،"
  },
  {
   "segment_id": 64,
   "arabic": "وَقِلَّةَ حِيلَتِي،"
  },
  {
   "segment_id": 65,
   "arabic": "وَرِقَّةَ جِلْدِي،"
  },
  {
   "segment_id": 66,
   "arabic": "وَتَبَدُّدَ أَوْصَالِي،"
  },
  {
   "segment_id": 67,
   "arabic": "وَتَنَاثُرَ لَحْمِي وَجِسْمِي وَجَسَدِي،"
  },
  {
   "segment_id": 68,
   "arabic": "وَوَحْدَتِي وَوَحْشَتِي فِي قَبْرِي"
  },
  {
   "segment_id": 69,
   "arabic": "وَجَزَعِي مِنْ صَغِيرِ الْبَلاءِ،"
  },
  {
   "segment_id": 70,
   "arabic": "أَسْأَلُكَ يَا رَبِّ قُرَّةَ الْعَيْنِ وَالإغْتِبَاطَ"
  },
  {
   "segment_id": 71,
   "arabic": "يَوْمَ الْحَسْرَةِ وَالنَّدَامَةِ،"
  },
  {
   "segment_id": 72,
   "arabic": "بَيِّضْ وَجْهِي يَا رَبِّ يَوْمَ تَسْوَدُّ الْوُجُوهُ،"
  },
  {
   "segment_id": 73,
   "arabic": "آمِنِّي مِنَ الْفَزَعِ الأَكْبَرِ،"
  },
  {
   "segment_id": 74,
   "arabic": "أَسْأَلُكَ الْبُشْرَى يَوْمَ تُقَلَّبُ الْقُلُوبُ وَالأَبْصَارُ،"
  },
  {
   "segment_id": 75,
   "arabic": "وَالْبُشْرَى عِنْدَ فِرَاقِ الدُّنْيَا."
  },
  {
   "segment_id": 76,
   "arabic": "الْحَمْدُ لِلّهِ الَّذِي أَرْجُوهُ عَوْناً لِي فِي حَيَاتِي،"
  },
  {
   "segment_id": 77,
   "arabic": "وَأُعِدُّهُ ذُخْراً لِيَوْمِ فَاقَتِي."
  },
  {
   "segment_id": 78,
   "arabic": "الْحَمْدُ لِلّهِ الَّذِي أَدْعُوهُ وَلا أَدْعُو غَيْرَهُ،"
  },
  {
   "segment_id": 79,
   "arabic": "وَلَوْ دَعَوْتُ غَيْرَهُ لَخَيَّبَ دُعَائِي."
  },
  {
   "segment_id": 80,
   "arabic": "الْحَمْدُ لِلّهِ الَّذِي أَرْجُوهُ وَلا أَرْجُو غَيْرَهُ،"
  },
  {
   "segment_id": 81,
   "arabic": "وَلَوْ رَجَوْتُ غَيْرَهُ لأَخْلَفَ رَجَائِي."
  },
  {
   "segment_id": 82,
   "arabic": "الْحَمْدُ لِلّهِ الْمُنْعِمِ الْمُحْسِنِ"
  },
  {
   "segment_id": 83,
   "arabic": "الْمُجْمِلِ الْمُفْضِلِ"
  },
  {
   "segment_id": 84,
   "arabic": "ذِي الْجَلالِ وَالإكْرَامِ،"
  },
  {
   "segment_id": 85,
   "arabic": "وَلِيُّ كُلِّ نِعْمَةٍ،"
  },
  {
   "segment_id": 86,
   "arabic": "وَصَاحِبُ كُلِّ حَسَنَةٍ،"
  },
  {
   "segment_id": 87,
   "arabic": "وَمُنْتَهَى كُلِّ رَغْبَةٍ،"
  },
  {
   "segment_id": 88,
   "arabic": "وَقَاضِي كُلِّ حَاجَةٍ."
  },
  {
   "segment_id": 89,
   "arabic": "اللّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 90,
   "arabic": "وَارْزُقْنِي الْيَقِينَ وَحُسْنَ الظَّنِّ بِكَ،"
  },
  {
   "segment_id": 91,
   "arabic": "وَأَثْبِتْ رَجَاءَكَ فِي قَلْبِي،"
  },
  {
   "segment_id": 92,
   "arabic": "وَاقْطَعْ رَجَائِي عَمَّنْ سِوَاكَ"
  },
  {
   "segment_id": 93,
   "arabic": "حَتَّى لا أَرْجُوَ غَيْرَكَ وَلا أَثِقَ إلاَّ بِكَ،"
  },
  {
   "segment_id": 94,
   "arabic": "يَا لَطِيفاً لِمَا تَشَاءُ"
  },
  {
   "segment_id": 95,
   "arabic": "أُلْطُفْ لِي فِي جَمِيعِ أَحْوَالِي بِمَا تُحِبُّ وَتَرْضَى،"
  },
  {
   "segment_id": 96,
   "arabic": "يَا رَبِّ إنِّي ضَعِيفٌ عَلَى النَّارِ فَلا تُعَذِّبْنِي بِالنَّارِ،"
  },
  {
   "segment_id": 97,
   "arabic": "يَا رَبِّ ارْحَمْ دُعَائِي وَتَضَرُّعِي"
  },
  {
   "segment_id": 98,
   "arabic": "وَخَوْفِي وَذُلِّي وَمَسْكَنَتِي"
  },
  {
   "segment_id": 99,
   "arabic": "وَتَعْوِيذِي وَتَلْوِيذِي،"
  },
  {
   "segment_id": 100,
   "arabic": "يَا رَبِّ إنِّي ضَعِيفٌ عَنْ طَلَبِ الدُّنْيَا"
  },
  {
   "segment_id": 101,
   "arabic": "وَأَنْتَ وَاسِعٌ كَرِيمٌ،"
  },
  {
   "segment_id": 102,
   "arabic": "أَسْأَلُكَ يَا رَبِّ بِقُوَّتِكَ عَلَى ذلِكَ،"
  },
  {
   "segment_id": 103,
   "arabic": "وَقُدْرَتِكَ عَلَيْهِ،"
  },
  {
   "segment_id": 104,
   "arabic": "وَغِنَاكَ عَنْهُ،"
  },
  {
   "segment_id": 105,
   "arabic": "وَحَاجَتِي إلَيْهِ،"
  },
  {
   "segment_id": 106,
   "arabic": "أَنْ تَرْزُقَنِي فِي عَامِي هذَا،"
  },
  {
   "segment_id": 107,
   "arabic": "وَشَهْرِي هذَا،"
  },
  {
   "segment_id": 108,
   "arabic": "وَيَوْمِي هذَا،"
  },
  {
   "segment_id": 109,
   "arabic": "وَسَاعَتِي هذِهِ"
  },
  {
   "segment_id": 110,
   "arabic": "رِزْقاً تُغْنِينِي بِهِ عَنْ تَكَلُّفِ مَا فِي أَيْدِي النَّاسِ"
  },
  {
   "segment_id": 111,
   "arabic": "مِنْ رِزْقِكَ الْحَلالِ الطَّيِّبِ،"
  },
  {
   "segment_id": 112,
   "arabic": "أَيْ رَبِّ مِنْكَ أَطْلُبُ،"
  },
  {
   "segment_id": 113,
   "arabic": "وَإلَيْكَ أَرْغَبُ،"
  },
  {
   "segment_id": 114,
   "arabic": "وَإيَّاكَ أَرْجُو،"
  },
  {
   "segment_id": 115,
   "arabic": "وَأَنْتَ أَهْلُ ذلِكَ"
  },
  {
   "segment_id": 116,
   "arabic": "لا أَرْجُو غَيْرَكَ"
  },
  {
   "segment_id": 117,
   "arabic": "وَلا أَثِقُ إلاَّ بِكَ"
  },
  {
   "segment_id": 118,
   "arabic": "يَا أَرْحَمَ الرَّاحِمِينَ،"
  },
  {
   "segment_id": 119,
   "arabic": "أَيْ رَبِّ ظَلَمْتُ نَفْسِي"
  },
  {
   "segment_id": 120,
   "arabic": "فَاغْفِرْ لِي وَارْحَمْنِي وَعَافِنِي،"
  },
  {
   "segment_id": 121,
   "arabic": "يَا سَامِعَ كُلِّ صَوْتٍ،"
  },
  {
   "segment_id": 122,
   "arabic": "وَيَا جَامِعَ كُلِّ فَوْتٍ،"
  },
  {
   "segment_id": 123,
   "arabic": "وَيَا بَارِئَ النُّفُوسِ بَعْدَ الْمَوْتِ،"
  },
  {
   "segment_id": 124,
   "arabic": "يَا مَنْ لا تَغْشَاهُ الظُّلُمَاتُ،"
  },
  {
   "segment_id": 125,
   "arabic": "وَلا تَشْتَبِهُ عَلَيْهِ الأَصْوَاتُ،"
  },
  {
   "segment_id": 126,
   "arabic": "وَلا يَشْغَلُهُ شَيْءٌ عَنْ شَيْءٍ،"
  },
  {
   "segment_id": 127,
   "arabic": "أَعْطِ مُحَمَّداً صَلَّى اللّهُ عَلَيْهِ وَآلِهِ أَفْضَلَ مَا سَأَلَكَ،"
  },
  {
   "segment_id": 128,
   "arabic": "وَأَفْضَلَ مَا سُئِلْتَ لَه،"
  },
  {
   "segment_id": 129,
   "arabic": "وَأَفْضَلَ مَا أَنْتَ مَسْؤُولٌ لَهُ إلَى يَوْمِ الْقِيَامَةِ،"
  },
  {
   "segment_id": 130,
   "arabic": "وَهَبْ لِيَ الْعَافِيَةَ حَتَّى تُهَنِّئَنِي الْمَعِيشَةَ،"
  },
  {
   "segment_id": 131,
   "arabic": "وَاخْتِمْ لِي بِخَيْرٍ حَتَّى لا تَضُرَّنِي الذُّنُوبُ."
  },
  {
   "segment_id": 132,
   "arabic": "اللّهُمَّ رَضِّنِي بِمَا قَسَمْتَ لِي حَتَّى لا أَسْأَلَ أَحَداً شَيْئاً."
  },
  {
   "segment_id": 133,
   "arabic": "اللّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 134,
   "arabic": "وَافْتَحْ لِي خَزَائِنَ رَحْمَتِكَ،"
  },
  {
   "segment_id": 135,
   "arabic": "وَارْحَمْنِي رَحْمَةً لا تُعَذِّبُنِي بَعْدَهَا أَبَداً فِي الدُّنْيَا وَالآخِرَةِ،"
  },
  {
   "segment_id": 136,
   "arabic": "وَارْزُقْنِي مِنْ فَضْلِكَ الْوَاسِعِ رِزْقاً حَلالاً طَيِّباً"
  },
  {
   "segment_id": 137,
   "arabic": "لا تُفْقِرُنِي إلَى أَحَدٍ بَعْدَهُ سِوَاكَ،"
  },
  {
   "segment_id": 138,
   "arabic": "تَزِيدُنِي بِذلِكَ شُكْراً،"
  },
  {
   "segment_id": 139,
   "arabic": "وَإلَيْكَ فَاقَةً وَفَقْراً،"
  },
  {
   "segment_id": 140,
   "arabic": "وَبِكَ عَمَّنْ سِوَاكَ غِنَىً وَتَعَفُّفاً،"
  },
  {
   "segment_id": 141,
   "arabic": "يَا مُحْسِنُ يَا مُجْمِلُ"
  },
  {
   "segment_id": 142,
   "arabic": "يَا مُنْعِمُ يَا مُفْضِلُ"
  },
  {
   "segment_id": 143,
   "arabic": "يَا مَلِيكُ يَا مُقْتَدِرُ"
  },
  {
   "segment_id": 144,
   "arabic": "صَلِّ عَلَى مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 145,
   "arabic": "وَاكْفِنِي الْمُهِمَّ كُلَّهُ،"
  },
  {
   "segment_id": 146,
   "arabic": "وَاقْضِ لِي بِالْحُسْنَى،"
  },
  {
   "segment_id": 147,
   "arabic": "وَبَارِكْ لِي فِي جَمِيعِ أُمُورِي"
  },
  {
   "segment_id": 148,
   "arabic": "وَاقْضِ لِي جَمِيعَ حَوَائِجِي."
  },
  {
   "segment_id": 149,
   "arabic": "اللّهُمَّ يَسِّرْ لِي مَا أَخَافُ تَعْسِيرَهُ"
  },
  {
   "segment_id": 150,
   "arabic": "فَإنَّ تَيْسِيرَ مَا أَخَافُ تَعْسِيرَهُ عَلَيْكَ سَهْلٌ يَسِيرٌ،"
  },
  {
   "segment_id": 151,
   "arabic": "وَسَهِّلْ لِي مَا أَخَافُ حُزُونَتَهُ،"
  },
  {
   "segment_id": 152,
   "arabic": "وَنَفِّسْ عَنِّي مَا أَخَافُ ضِيقَهُ،"
  },
  {
   "segment_id": 153,
   "arabic": "وَكُفَّ عَنِّي مَا أَخَافُ هَمَّهُ،"
  },
  {
   "segment_id": 154,
   "arabic": "وَاصْرِفْ عَنِّي مَا أَخَافُ بَلِيَّتَهُ"
  },
  {
   "segment_id": 155,
   "arabic": "يَا أَرْحَمَ الرَّاحِمِينَ."
  },
  {
   "segment_id": 156,
   "arabic": "اللّهُمَّ امْلأْ قَلْبِي حُبّاً لَكَ،"
  },
  {
   "segment_id": 157,
   "arabic": "وَخَشْيَةً مِنْكَ،"
  },
  {
   "segment_id": 158,
   "arabic": "وَتَصْدِيقاً لَكَ،"
  },
  {
   "segment_id": 159,
   "arabic": "وَإيمَاناً بِكَ،"
  },
  {
   "segment_id": 160,
   "arabic": "وَفَرَقاً مِنْكَ،"
  },
  {
   "segment_id": 161,
   "arabic": "وَشَوْقاً إلَيْكَ،"
  },
  {
   "segment_id": 162,
   "arabic": "يَا ذَا الْجَلالِ وَالإكْرَامِ."
  },
  {
   "segment_id": 163,
   "arabic": "اللّهُمَّ إنَّ لَكَ حُقُوقاً فَتَصَدَّقْ بِهَا عَلَيَّ،"
  },
  {
   "segment_id": 164,
   "arabic": "وَلِلنَّاسِ قِبَلِي تَبِعَاتٌ فَتَحَمَّلْهَا عَنِّي،"
  },
  {
   "segment_id": 165,
   "arabic": "وَقَدْ أَوْجَبْتَ لِكُلِّ ضَيْفٍ قِرَىً"
  },
  {
   "segment_id": 166,
   "arabic": "وَأَنَا ضَيْفُكَ فَاجْعَلْ قِرَايَ اللَّيْلَةَ الْجَنَّةَ،"
  },
  {
   "segment_id": 167,
   "arabic": "يَا وَهَّابَ الْجَنَّةِ،"
  },
  {
   "segment_id": 168,
   "arabic": "يَا وَهَّابَ الْمَغْفِرَةِ،"
  },
  {
   "segment_id": 169,
   "arabic": "وَلا حَوْلَ وَلا قُوَّةَ إلاَّبِكَ."
  }
 ]
}