{
 "dua_id": "duasorg-ramadan-day-23-6",
 "dua_name_en": "Ramadan Day 23 · from Muhammad ibn Abi Qurrah",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-day-23.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "يَا بَاطِناً فِي ظُهُورِهِ"
  },
  {
   "segment_id": 2,
   "arabic": "ويَا ظَاهِراً فِي بُطُونِهِ"
  },
  {
   "segment_id": 3,
   "arabic": "وَيَا بَاطِناً لَيْسَ يَخْفَىٰ"
  },
  {
   "segment_id": 4,
   "arabic": "وَيَا ظَاهِراً لَيْسَ يُرَىٰ"
  },
  {
   "segment_id": 5,
   "arabic": "يَا مَوْصُوفاً لاَ يَبْلُغُ بِكَيْنُونَتِهِ مَوْصُوفٌ"
  },
  {
   "segment_id": 6,
   "arabic": "وَلاَ حَدٌّ مَحْدُودٌ"
  },
  {
   "segment_id": 7,
   "arabic": "وَيَا غَائِباً غَيْرَ مَفْقُودٍ"
  },
  {
   "segment_id": 8,
   "arabic": "وَيَا شَاهِداً غَيْرَ مَشْهُودٍ"
  },
  {
   "segment_id": 9,
   "arabic": "يُطْلَبُ فَيُصَابُ"
  },
  {
   "segment_id": 10,
   "arabic": "وَلَمْ يَخْلُ مِنْهُ ٱلسَّمَاوَاتُ وَٱلارْضُ وَمَا بَيْنَهُمَا طَرْفَةَ عَيْنٍ"
  },
  {
   "segment_id": 11,
   "arabic": "لاَ يُدْرَكُ بِكَيْفٍ"
  },
  {
   "segment_id": 12,
   "arabic": "وَلاَ يُؤَيَّنُ بِايْنٍ وَلاَ بِحَيْثٍ"
  },
  {
   "segment_id": 13,
   "arabic": "انْتَ نُورُ ٱلنُّورِ"
  },
  {
   "segment_id": 14,
   "arabic": "وَرَبُّ ٱلارْبَابِ"
  },
  {
   "segment_id": 15,
   "arabic": "احَطْتَ بِجَمِيعِ ٱلامورِ"
  },
  {
   "segment_id": 16,
   "arabic": "سُبحَانَ مَنْ لَيْسَ كَمِثْلِهِ شَيْءٌ"
  },
  {
   "segment_id": 17,
   "arabic": "وَهُوَ ٱلسَّمِيعُ ٱلبَصِيرُ"
  },
  {
   "segment_id": 18,
   "arabic": "سبحَانَ مَنْ هُوَ هٰكَذَا وَلاَ هٰكَذَا غَيْرُهُ"
  }
 ]
}