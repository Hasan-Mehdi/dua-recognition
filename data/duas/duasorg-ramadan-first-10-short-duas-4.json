{
 "dua_id": "duasorg-ramadan-first-10-short-duas-4",
 "dua_name_en": "Allahumma Innahu Qad Dakhala",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-first-10-short-duas.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللَّهُمَّ إِنَّهُ قَدْ دَخَلَ شَهْرُ رَمَضَانَ"
  },
  {
   "segment_id": 2,
   "arabic": "اللَّهُمَّ رَبَّ شَهْرِ رَمَضَانَ"
  },
  {
   "segment_id": 3,
   "arabic": "ٱلَّذِي أَنْزَلْتَ فِيهِ ٱلْقُرْآنَ"
  },
  {
   "segment_id": 4,
   "arabic": "وَجَعَلْتَهُ بَيِّنَاتٍ مِنَ ٱلْهُدَىٰ وَٱلْفُرْقَانِ"
  },
  {
   "segment_id": 5,
   "arabic": "اللَّهُمَّ فَبَارِكْ لَنَا فِي شَهْرِ رَمَضَانَ"
  },
  {
   "segment_id": 6,
   "arabic": "وَأَعِنَّا عَلَىٰ صِيَامِهِ وَصَلَوَاتِهِ"
  },
  {
   "segment_id": 7,
   "arabic": "وَتَقَبَّلْهُ مِنَّا"
  }
 ]
}