 "dua_name_ar": "",
 "source": "https://www.duas.org/dua-faraj-dua-azumal-bala-imam-mahdi.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللَّهُمَّ عَظُمَ ٱلْبَلاَءُ"
  },
  {
   "segment_id": 2,
   "arabic": "وَبَرِحَ ٱلْخَفَاءُ"
  },
  {
   "segment_id": 3,
   "arabic": "وَٱنْكَشَفَ ٱلْغِطَاءُ"
  },
  {
   "segment_id": 4,
   "arabic": "وَضَاقَتِ ٱلأَرْضُ بِمَا وَسِعَتِ ٱلسَّمَاءُ"
  },
  {
   "segment_id": 5,
   "arabic": "وَإِلَيْكَ يَا رَبِّ ٱلْمُشْتَكَىٰ"
  },
  {
   "segment_id": 6,
   "arabic": "وَعَلَيْكَ ٱلْمُعَوَّلُ فِي ٱلشِّدَّةِ وَٱلرَّخَاءِ"
  },
  {
   "segment_id": 7,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 8,
   "arabic": "ٱلَّذينَ أَمَرْتَنَا بِطَاعَتِهِمْ"
  },
  {
   "segment_id": 9,
   "arabic": "وَعَجِّلِ ٱللَّهُمَّ فَرَجَهُمْ بِقَائِمِهِمْ"
  },
  {
   "segment_id": 10,
   "arabic": "وَأَظْهِرْ إِعْزَازَهُ"
  },
  {
   "segment_id": 11,
   "arabic": "يَا مُحَمَّدُ يَا عَلِيُّ"
  },
  {
   "segment_id": 12,
   "arabic": "يَا عَلِيُّ يَا مُحَمَّدُ"
  },
  {
   "segment_id": 13,
   "arabic": "إِكْفِيَانِي فَإنَّكُمَا كَافِيَايَ"
  },
  {
   "segment_id": 14,
   "arabic": "يَا مُحَمَّدُ يَا عَلِيُّ"
  },
  {
   "segment_id": 15,
   "arabic": "يَا عَلِيُّ يَا مُحَمَّدُ"
  },
  {
   "segment_id": 16,
   "arabic": "أُنْصُرَانِي فَإنَّكُمَا نَاصِرَايَ"
  },
  {
   "segment_id": 17,
   "arabic": "يَا مُحَمَّدُ يَا عَلِيُّ"
  },
  {
   "segment_id": 18,
   "arabic": "يَا عَلِيُّ يَا مُحَمَّدُ"
  },
  {
   "segment_id": 19,
   "arabic": "إِحْفَظَانِي فَإنَّكُمَا حَافِظَايَ"
  },
  {
   "segment_id": 20,
   "arabic": "يَامَوْلاَيَ يَا صَاحِبَ ٱلزَّمَانِ"
  },
  {
   "segment_id": 21,
   "arabic": "يَا مَوْلاَيَ يَا صَاحِبَ ٱلزَّمَانِ"
  },
  {
   "segment_id": 22,
   "arabic": "يَا مَوْلاَيَ يَا صَاحِبَ ٱلزَّمَانِ"
  },
  {
   "segment_id": 23,
   "arabic": "الْغَوْثَ ٱلْغَوْثَ ٱلْغَوْثَ"
  },
  {
   "segment_id": 24,
   "arabic": "أَدْرِكْنِي أَدْرِكْنِي أَدْرِكْنِي"
  },
  {
   "segment_id": 25,
   "arabic": "ٱلأَمَانَ ٱلأَمَانَ ٱلأَمَانَ"
  }
 ]
}