{
 "dua_id": "duasorg-dua-taqeebat-after-maghrib-isha-prayers-8",
 "dua_name_en": "Dua after Isha: Allahumma Rabba alssamawati..",
 "dua_name_ar": "",
 "source": "https://www.duas.org/dua-taqeebat-after-maghrib-isha-prayers.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللَّهُمَّ رَبَّ ٱلسَّمَاوَاتِ ٱلسَّبْعِ وَمَا اظَلَّتْ"
  },
  {
   "segment_id": 2,
   "arabic": "وَرَبَّ ٱلارَضِينَ ٱلسَّبْعِ وَمَا اقَلَّتْ"
  },
  {
   "segment_id": 3,
   "arabic": "وَرَبَّ ٱلشَّيَاطِينِ وَمَا اضَلَّتْ"
  },
  {
   "segment_id": 4,
   "arabic": "وَرَبَّ ٱلرِّيَاحِ وَمَا ذَرَتْ"
  },
  {
   "segment_id": 5,
   "arabic": "اللَّهُمَّ رَبَّ كُلِّ شَيْءٍ"
  },
  {
   "segment_id": 6,
   "arabic": "وَإِلٰهَ كُلِّ شَيْءٍ"
  },
  {
   "segment_id": 7,
   "arabic": "وَمَلِيكَ كُلِّ شَيْءٍ"
  },
  {
   "segment_id": 8,
   "arabic": "انْتَ ٱللَّهُ ٱلْمُقْتَدِرُ عَلَىٰ كُلِّ شَيْءٍ"
  },
  {
   "segment_id": 9,
   "arabic": "انْتَ ٱللَّهُ ٱلاوَّلُ فَلاَ شَيْءَ قَبْلَكَ"
  },
  {
   "segment_id": 10,
   "arabic": "وَانْتَ ٱلآخِرُ فَلاَ شَيْءَ بَعْدَكَ"
  },
  {
   "segment_id": 11,
   "arabic": "وَانْتَ ٱلظَّاهِرُ فَلاَ شَيْءَ فَوْقَكَ"
  },
  {
   "segment_id": 12,
   "arabic": "وَانْتَ ٱلْبَاطِنُ فَلاَ شَيْءَ دُونَكَ"
  },
  {
   "segment_id": 13,
   "arabic": "رَبَّ جَبْرَائِيلَ وَمِيكَائِيلَ وَإِسْرَافِيلَ"
  },
  {
   "segment_id": 14,
   "arabic": "وَإِلٰهَ إِبْرَاهِيمَ وَإِسْمَاعِيلَ"
  },
  {
   "segment_id": 15,
   "arabic": "وَإِسْحَاقَ وَيَعْقُوبَ وَٱلاسْبَاطِ"
  },
  {
   "segment_id": 16,
   "arabic": "اسْالُكَ انْ تُصَلِّيَ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 17,
   "arabic": "وَانْ تَوَلاَّنِي بِرَحْمَتِكَ"
  },
  {
   "segment_id": 18,
   "arabic": "وَلاَ تُسَلِّطْ عَلَيَّ احَداً مِنْ خَلْقِكَ"
  },
  {
   "segment_id": 19,
   "arabic": "مِمَّنْ لاَ طَاقَةَ لِي بِهِ"
  },
  {
   "segment_id": 20,
   "arabic": "اللَّهُمَّ إِنِّي اتَحَبَّبُ إِلَيْكَ فَحَبِّبْنِي"
  },
  {
   "segment_id": 21,
   "arabic": "وَفِي ٱلنَّاسِ فَعَزِّزْنِي"
  },
  {
   "segment_id": 22,
   "arabic": "وَمِنْ شَرِّ شَّيَاطِينِ ٱلْجِنِّ وَٱلإِنْسِ فَسَلِّمْنِي"
  },
  {
   "segment_id": 23,
   "arabic": "يَا رَبَّ ٱلْعَالَمِينَ"
  },
  {
   "segment_id": 24,
   "arabic": "وَصَلِّ عَلَىٰ مُحَمَّدٍ وَآلِهِ"
  }
 ]
}