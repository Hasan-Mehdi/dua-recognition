{
 "dua_id": "duasorg-ziyarat-muslim-ibn-aqeel-hani-e-urwa-2",
 "dua_name_en": "Ziyarat of Hani ibn Urwa",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ziyarat-muslim-ibn-aqeel-hani-e-urwa.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "سَلامُ ٱللَّهِ ٱلْعَظِيمِ وَصَلَوَاتُهُ"
  },
  {
   "segment_id": 2,
   "arabic": "عَلَيْكَ يَا هَانِئُ بْنَ عُرْوَةَ"
  },
  {
   "segment_id": 3,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ ايُّهَا ٱلْعَبْدُ ٱلصَّالِحُ"
  },
  {
   "segment_id": 4,
   "arabic": "ٱلنَّاصِحُ لِلَّهِ وَلِرَسُولِهِ وَلاِمِيرِ ٱلْمُؤْمِنِينَ"
  },
  {
   "segment_id": 5,
   "arabic": "وَٱلْحَسَنِ وَٱلْحُسَيْنِ عَلَيْهِمُ اَلسَّلاَمُ"
  },
  {
   "segment_id": 6,
   "arabic": "اشْهَدُ انَّكَ قُتِلْتَ مَظْلُوماً"
  },
  {
   "segment_id": 7,
   "arabic": "فَلَعَنَ ٱللَّهُ مَنْ قَتَلَكَ وَٱسْتَحَلَّ دَمَكَ"
  },
  {
   "segment_id": 8,
   "arabic": "وَحَشَىٰ قُبُورَهُمْ نَاراً"
  },
  {
   "segment_id": 9,
   "arabic": "اشْهَدُ انَّكَ لَقِيتَ ٱللَّهَ وَهُوَ رَاضٍ عَنْكَ"
  },
  {
   "segment_id": 10,
   "arabic": "بِمَا فَعَلْتَ وَنَصَحْتَ"
  },
  {
   "segment_id": 11,
   "arabic": "وَاشْهَدُ انَّكَ قَدْ بَلَغْتَ دَرَجَةَ ٱلشُّهَدَاءِ"
  },
  {
   "segment_id": 12,
   "arabic": "وَجُعِلَ رُوحُكَ مَعَ ارْوَاحِ ٱلسُّعَدَاءِ"
  },
  {
   "segment_id": 13,
   "arabic": "بِمَا نَصَحْتَ لِلَّهِ وَلِرَسُولِهِ مُجْتَهِداً"
  },
  {
   "segment_id": 14,
   "arabic": "وَبَذَلْتَ نَفْسَكَ فِي ذَاتِ ٱللَّهِ وَمَرْضَاتِهِ"
  },
  {
   "segment_id": 15,
   "arabic": "فَرَحِمَكَ ٱللَّهُ وَرَضِيَ عَنْكَ"
  },
  {
   "segment_id": 16,
   "arabic": "وَحَشَرَكَ مَعَ مُحَمَّدٍ وَآلِهِ ٱلطَّاهِرِينَ"
  },
  {
   "segment_id": 17,
   "arabic": "وَجَمَعَنَا وَإِيَّاكُمْ مَعَهُمْ فِي دَارِ ٱلنَّعِيمِ"
  },
  {
   "segment_id": 18,
   "arabic": "وَسَلامٌ عَلَيْكَ وَرَحْمَةُ ٱللَّهِ وَبَرَكَاتُهُ"
  }
 ]
}