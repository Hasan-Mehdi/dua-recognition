{
 "dua_id": "dua-ramadan-16",
 "dua_name_en": "Day 16",
 "dua_name_ar": " شهر رمضان ١٦",
 "source": "https://www.duaplayer.org/en/dua/ramadan-16",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "اللّهُمّ وَفّقْنِي فِيهِ لِمُوَافَقَةِ الأَبْرَارِ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَجَنّبْنِي فِيهِ مُرَافَقَةَ الأَشْرَارِ،"
  },
  {
   "segment_id": 5,
   "arabic": "وَآوِنِي فِيهِ بِرَحْمَتِكَ إِلَى دَارِ القَرَارِ،"
  },
  {
   "segment_id": 6,
   "arabic": "بِإِلهِيّتِكَ يَا إِلهَ العَالَمِينَ."
  }
 ]
}