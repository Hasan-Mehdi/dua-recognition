{
 "dua_id": "duasorg-ramadan-dua-daytime-daily-1",
 "dua_name_en": "Ya DhaAlladhi",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-dua-daytime-daily.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "يَا ذَا ٱلَّذِي كَانَ قَبْلَ كُلِّ شَيْءٍ"
  },
  {
   "segment_id": 2,
   "arabic": "ثُمَّ خَلَقَ كُلَّ شَيْءٍ"
  },
  {
   "segment_id": 3,
   "arabic": "ثُمَّ يَبْقَىٰ وَيَفْنَىٰ كُلُّ شَيْءٍ"
  },
  {
   "segment_id": 4,
   "arabic": "يَا ذَا ٱلَّذِي لَيْسَ كَمِثْلِهِ شَيْءٌ"
  },
  {
   "segment_id": 5,
   "arabic": "وَيَا ذَا ٱلَّذِي لَيْسَ فِي ٱلسَّمَاوَاتِ ٱلْعُلَىٰ"
  },
  {
   "segment_id": 6,
   "arabic": "وَلاَ فِي ٱلأَرَضِينَ ٱلسُّفْلَىٰ"
  },
  {
   "segment_id": 7,
   "arabic": "وَلاَ فَوْقَهُنَّ وَلاَ تَحْتَهُنَّ"
  },
  {
   "segment_id": 8,
   "arabic": "وَلاَ بَيْنَهُنَّ إِلٰهٌ يُعْبَدُ غَيْرُهُ"
  },
  {
   "segment_id": 9,
   "arabic": "لَكَ ٱلْحَمْدُ حَمْداً لاَ يَقْوَىٰ عَلَىٰ إِحْصَائِهِ إِلاَّ أَنْتَ"
  },
  {
   "segment_id": 10,
   "arabic": "فَصَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 11,
   "arabic": "صَلاةً لاَ يَقْوَىٰ عَلَىٰ إِحْصَائِهَا إِلاَّ أَنْتَ"
  }
 ]
}