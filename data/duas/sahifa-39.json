{
 "dua_id": "sahifa-39",
 "dua_name_en": "Sahifa 39: His supplication in seeking pardon and mercy",
 "dua_name_ar": "ددُعَاؤُهُ فِي طَلَبِ الْعَفْوِ و المَغْفِرَةِ",
 "source": "https://duas.pro/39-his-supplication-in-seeking-pardon-and-mercy",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "أَللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 2,
   "arabic": "وَاكْسِرْ شَهْوَتِي عَنْ كُلِّ مَحْرَمٍ"
  },
  {
   "segment_id": 3,
   "arabic": "وَازْوِ حِرْصِي عَنْ كُلِّ مَأثَمٍ"
  },
  {
   "segment_id": 4,
   "arabic": "وَامْنَعْنِي عَنْ أَذَى كُلِّ مُؤْمِنٍ وَمُؤْمِنَةٍ وَمُسْلِمٍ وَمُسْلِمَةٍ"
  },
  {
   "segment_id": 5,
   "arabic": "أَللَّهُمَّ وَأَيُّمَا عَبْدٍ نَالَ مِنِّي مَا حَظَرْتَ عَلَيْهِ"
  },
  {
   "segment_id": 6,
   "arabic": "وَانْتَهَكَ مِنِّي مَا حَجَرْتَ عَلَيْهِ"
  },
  {
   "segment_id": 7,
   "arabic": "فَمَضَى بِظُلَامَتِي مَيِّتًا"
  },
  {
   "segment_id": 8,
   "arabic": "أَوْ حَصَلَتْ لِي قِبَلَهُ حَيًّا"
  },
  {
   "segment_id": 9,
   "arabic": "فَاغْفِرْ لَهُ مَا أَلَمَّ بِهِ مِنِّي"
  },
  {
   "segment_id": 10,
   "arabic": "وَاعْفُ لَهُ عَمَّا أَدْبَرَ بِهِ عَنِّي"
  },
  {
   "segment_id": 11,
   "arabic": "وَلَا تَقِفْهُ عَلَى مَا ارْتَكَبَ فِيَّ"
  },
  {
   "segment_id": 12,
   "arabic": "وَلَا تَكْشِفْهُ عَمَّا اكْتَسَبَ بِي"
  },
  {
   "segment_id": 13,
   "arabic": "وَاجْعَلْ مَا سَمَحْتُ بِهِ مِنَ الْعَفْوِ عَنْهُمْ"
  },
  {
   "segment_id": 14,
   "arabic": "وَتَبَرَّعْتُ بِهِ مِنَ الصَّدَقَةِ عَلَيْهِمْ"
  },
  {
   "segment_id": 15,
   "arabic": "أَزْكَى صَدَقَاتِ الْمُتَصَدِّقِينَ"
  },
  {
   "segment_id": 16,
   "arabic": "وَأَعْلَى صِلاتِ الْمُتَقَرِّبِينَ"
  },
  {
   "segment_id": 17,
   "arabic": "وَعَوِّضْنِي مِنْ عَفْوِي عَنْهُمْ عَفْوَكَ"
  },
  {
   "segment_id": 18,
   "arabic": "وَمِنْ دُعَائِي لَهُمْ رَحْمَتَكَ"
  },
  {
   "segment_id": 19,
   "arabic": "حَتَّى يَسْعَدَ كُلُّ وَاحِدٍ مِنَّا بِفَضْلِكَ"
  },
  {
   "segment_id": 20,
   "arabic": "وَيَنْجُوَ كُلٌّ مِنَّا بِمَنِّكَ"
  },
  {
   "segment_id": 21,
   "arabic": "أَللَّهُمَّ وَأَيُّما عَبْدٍ مِنْ عَبِيدِكَ"
  },
  {
   "segment_id": 22,
   "arabic": "أَدْرَكَهُ مِنِّي دَرَكٌ أَوْ مَسَّهُ مِنْ نَاحِيَتِي أَذًى"
  },
  {
   "segment_id": 23,
   "arabic": "أَوْ لَحِقَهُ بِي أَوْ بِسَبَبِي ظُلْمٌ"
  },
  {
   "segment_id": 24,
   "arabic": "فَفُتُّهُ بِحَقِّهِ"
  },
  {
   "segment_id": 25,
   "arabic": "أَوْ سَبَقْتُهُ بِمَظْلَمَتِهِ"
  },
  {
   "segment_id": 26,
   "arabic": "فَصَلِّ عَلَى مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 27,
   "arabic": "وَأَرْضِهِ عَنِّْي مِنْ وُجْدِكَ"
  },
  {
   "segment_id": 28,
   "arabic": "وَأَوْفِهِ حَقَّهُ مِنْ عِنْدِكَ"
  },
  {
   "segment_id": 29,
   "arabic": "ثُمَّ قِنِي مَا يُوجِبُ لَهُ حُكْمُكَ"
  },
  {
   "segment_id": 30,
   "arabic": "وَخَلِّصْنِي مِمَّا يَحْكُمُ بِهِ عَدْلُكَ"
  },
  {
   "segment_id": 31,
   "arabic": "فَإِنَّ قُوَّتِي لَا تَسْتَقِلُّ بِنَقِمَتِكَ"
  },
  {
   "segment_id": 32,
   "arabic": "وَإِنَّ طَاقَتِي لَا تَنْهَضُ بِسُخْطِكَ"
  },
  {
   "segment_id": 33,
   "arabic": "فَإِنَّكَ إِنْ تُكَافِنِي بِالْحَقِّ تُهْلِكْنِي"
  },
  {
   "segment_id": 34,
   "arabic": "وَإِلَّا تَغَمَّدْنِي بِرَحْمَتِكَ تُوبِقْنِي"
  },
  {
   "segment_id": 35,
   "arabic": "أَللَّهُمَّ إِنِّي أَسْتَوْهِبُكَ يَا إِلَهِي مَا لَا يَنْقُصُكَ بَذْلُهُ"
  },
  {
   "segment_id": 36,
   "arabic": "وَأَسْتَحْمِلُكَ مَا لَا يَبْهَظُكَ حَمْلُهُ"
  },
  {
   "segment_id": 37,
   "arabic": "أَسْتَوْهِبُكَ يَا إِلَهِي نَفْسِيَ الَّتِي لَمْ تَخْلُقْهَا لِتَمْتَنِعَ بِهَا مِنْ سُوءٍ"
  },
  {
   "segment_id": 38,
   "arabic": "أَوْ لِتَطَرَّقَ بِهَا إِلَى نَفْعٍ"
  },
  {
   "segment_id": 39,
   "arabic": "وَلَكِنْ أَنْشَأْتَهَا إِثْبَاتًا لِقُدْرَتِكَ عَلَى مِثْلِهَا"
  },
  {
   "segment_id": 40,
   "arabic": "وَاحْتِجَاجًا بِهَا عَلَى شَكْلِهَا"
  },
  {
   "segment_id": 41,
   "arabic": "وَأَسْتَحْمِلُكَ مِنْ ذُنُوبِي مَا قَدْ بَهَظَنِي حَمْلُهُ"
  },
  {
   "segment_id": 42,
   "arabic": "وَأَسْتَعِينُ بِكَ عَلَى مَا قَدْ فَدَحَنِي ثِقْلُهُ"
  },
  {
   "segment_id": 43,
   "arabic": "فَصَلِّ عَلَى مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 44,
   "arabic": "وَهَبْ لِنَفْسِي عَلَى ظُلْمِهَا نَفْسِي"
  },
  {
   "segment_id": 45,
   "arabic": "وَوَكِّلْ رَحْمَتَكَ بِاحْتِمَالِ إصْرِي"
  },
  {
   "segment_id": 46,
   "arabic": "فَكَمْ قَدْ لَحِقَتْ رَحْمَتُكَ بِالْمُسِيئِينَ"
  },
  {
   "segment_id": 47,
   "arabic": "وَكَمْ قَدْ شَمِلَ عَفْوُكَ الظَّالِمِينَ"
  },
  {
   "segment_id": 48,
   "arabic": "فَصَلِّ عَلَى مُحَمَّدٍ وَآلِهِ وَاجْعَلْنِي أُسْوَةَ مَنْ قَدْ أَنْهَضْتَهُ"
  },
  {
   "segment_id": 49,
   "arabic": "بِتَجَاوُزِكَ عَنْ مَصَارِعِ الْخَاطِئِينَ"
  },
  {
   "segment_id": 50,
   "arabic": "وَخَلَّصْتَهُ بِتَوْفِيقِكَ مِنْ وَرَطَاتِ الْمُجْرِمِينَ"
  },
  {
   "segment_id": 51,
   "arabic": "فَأَصْبَحَ طَلِيقَ عَفْوِكَ مِنْ إسَارِ سُخْطِكَ"
  },
  {
   "segment_id": 52,
   "arabic": "وَعَتِيقَ صُنْعِكَ مِنْ وَثَاقِ عَدْلِكَ"
  },
  {
   "segment_id": 53,
   "arabic": "إنَّكَ إنْ تَفْعَلْ ذَلِكَ يَا إِلَهِي تَفْعَلْهُ بِمَنْ"
  },
  {
   "segment_id": 54,
   "arabic": "لاَ يَجْحَدُ اسْتِحْقَاقَ عُقُوبَتِكَ"
  },
  {
   "segment_id": 55,
   "arabic": "وَلاَ يُبَرِّئُ نَفْسَهُ مِنِ اسْتِيجَابِ نَقِمَتِكَ"
  },
  {
   "segment_id": 56,
   "arabic": "تَفْعَلُ ذَلِكَ يَا إِلَهِي بِمَنْ خَوْفُهُ مِنْكَ أَكْثَرُ مِنْ طَمَعِهِ فِيكَ"
  },
  {
   "segment_id": 57,
   "arabic": "وَبِمَنْ يَأْسُهُ مِنَ النَّجَاةِ أَوْكَدُ مِنْ رَجَائِهِ لِلْخَلاَصِ"
  },
  {
   "segment_id": 58,
   "arabic": "لاَ أَنْ يَكُونَ يَأْسُهُ قُنُوطًا"
  },
  {
   "segment_id": 59,
   "arabic": "أَوْ أَنْ يَكُونَ طَمَعُهُ اغْتِرَارًا"
  },
  {
   "segment_id": 60,
   "arabic": "بَلْ لِقِلَّةِ حَسَنَاتِهِ بَيْنَ سَيِّئَاتِهِ"
  },
  {
   "segment_id": 61,
   "arabic": "وَضَعْفِ حُجَجِهِ فِي جَمِيعِ تَبِعَاتِهِ"
  },
  {
   "segment_id": 62,
   "arabic": "فَأَمَّا أَنْتَ يَا إِلَهِي فَأَهْلٌ أَنْ لاَ يَغْتَرَّ بِكَ الصِّدِّيقُونَ"
  },
  {
   "segment_id": 63,
   "arabic": "وَلاَ يَيْأَسَ مِنْكَ الْمُجْرِمُونَ"
  },
  {
   "segment_id": 64,
   "arabic": "لاِنَّكَ الرَّبُّ الْعَظِيمُ الَّذِيْ لاَ يَمْنَعُ أَحَدًا فَضْلَهُ"
  },
  {
   "segment_id": 65,
   "arabic": "وَلاَ يَسْتَقْصِي مِنْ أَحَدٍ حَقَّهُ"
  },
  {
   "segment_id": 66,
   "arabic": "تَعَالَى ذِكْرُكَ عَنِ الْمَذْكُورِينَ"
  },
  {
   "segment_id": 67,
   "arabic": "وَتَقَدَّسَتْ أَسْمَاؤُكَ عَنِ الْمَنْسُوبِينَ"
  },
  {
   "segment_id": 68,
   "arabic": "وَفَشَتْ نِعْمَتُكَ فِي جَمِيعِ الْمَخْلُوقِينَ"
  },
  {
   "segment_id": 69,
   "arabic": "فَلَكَ الْحَمْدُ عَلَى ذَلِكَ يَا رَبَّ الْعَالَمِينَ"
  }
 ]
}