{
 "dua_id": "duasorg-1st-muharram-dua-amaal-3",
 "dua_name_en": "Dua and Salaat by Imam Reza (as)",
 "dua_name_ar": "",
 "source": "https://www.duas.org/1st-muharram-dua-amaal.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللَّهُمَّ أَنْتَ ٱلإِلٰهُ ٱلْقَدِيمُ"
  },
  {
   "segment_id": 2,
   "arabic": "وَهٰذِهِ سَنَةٌ جَدِيدَةٌ"
  },
  {
   "segment_id": 3,
   "arabic": "فَأَسْأَلُكَ فِيهَا ٱلْعِصْمَةَ مِنَ ٱلشَّيْطَانِ"
  },
  {
   "segment_id": 4,
   "arabic": "وَٱلْقُوَّةَ عَلَىٰ هٰذِهِ ٱلنَّفْسِ ٱلأَمَّارَةِ بِٱلسُّوءِ"
  },
  {
   "segment_id": 5,
   "arabic": "وَٱلاِﹾشْتِغَالَ بِمَا يُقَرِّبُنِي إِلَيْكَ يَا كَرِيمُ"
  },
  {
   "segment_id": 6,
   "arabic": "يَا ذَا ٱلْجَلاَلِ وَٱلإِكْرَامِ"
  },
  {
   "segment_id": 7,
   "arabic": "يَا عِمَادَ مَنْ لاَ عِمَادَ لَهُ"
  },
  {
   "segment_id": 8,
   "arabic": "يَا ذَخِيرَةَ مَنْ لا ذَخِيرَةَ لَهُ"
  },
  {
   "segment_id": 9,
   "arabic": "يَا حِرْزَ مَنْ لاَ حِرْزَ لَهُ"
  },
  {
   "segment_id": 10,
   "arabic": "يَا غِيَاثَ مَنْ لاَ غِيَاثَ لَهُ"
  },
  {
   "segment_id": 11,
   "arabic": "يَا سَنَدَ مَنْ لاَ سَنَدَ لَهُ"
  },
  {
   "segment_id": 12,
   "arabic": "يَا كَنْزَ مَنْ لاَ كَنْزَ لَهُ"
  },
  {
   "segment_id": 13,
   "arabic": "يَا حَسَنَ ٱلْبَلاَءِ"
  },
  {
   "segment_id": 14,
   "arabic": "يَا عَظِيمَ ٱلرَّجَاءِ"
  },
  {
   "segment_id": 15,
   "arabic": "يَا عِزَّ ٱلضُّعَفَاءِ"
  },
  {
   "segment_id": 16,
   "arabic": "يَا مُنْقِذَ ٱلْغَرْقَىٰ"
  },
  {
   "segment_id": 17,
   "arabic": "يَا مُنْجِيَ ٱلْهَلْكَىٰ"
  },
  {
   "segment_id": 18,
   "arabic": "يَا مُنْعِمُ يَا مُجْمِلُ"
  },
  {
   "segment_id": 19,
   "arabic": "يَا مُفْضِلُ يَا مُحْسِنُ"
  },
  {
   "segment_id": 20,
   "arabic": "أَنْتَ ٱلَّذِي سَجَدَ لَكَ سَوَادُ ٱللَّيْلِ وَنُورُ ٱلنَّهَارِ"
  },
  {
   "segment_id": 21,
   "arabic": "وَضَوْءُ ٱلْقَمَرِ وَشُعَاعُ ٱلشَّمْسِ"
  },
  {
   "segment_id": 22,
   "arabic": "وَدَوِيُّ ٱلْمَاءِ وَحَفِيفُ ٱلشَّجَرِ"
  },
  {
   "segment_id": 23,
   "arabic": "يَا اللَّهُ لاَ شَرِيكَ لَكَ"
  },
  {
   "segment_id": 24,
   "arabic": "اَللَّهُمَّ ٱجْعَلْنَا خَيْراً مِمَّا يَظُنُّونَ"
  },
  {
   "segment_id": 25,
   "arabic": "وَٱغْفِرْ لَنَا مَا لاَ يَعْلَمُونَ"
  },
  {
   "segment_id": 26,
   "arabic": "وَلاَ تُؤَاخِذْنَا بِمَا يَقُولُونَ"
  },
  {
   "segment_id": 27,
   "arabic": "حَسْبِيَ ٱللَّهُ لاَ إِلٰهَ إِلاَّ هُوَ"
  },
  {
   "segment_id": 28,
   "arabic": "عَلَيْهِ تَوَكَّلْتُ وَهُوَ رَبُّ ٱلْعَرْشِ ٱلْعَظِيمِ"
  },
  {
   "segment_id": 29,
   "arabic": "آمَنَّا بِهِ كُلٌّ مِنْ عِنْدِ رَبِّنَا"
  },
  {
   "segment_id": 30,
   "arabic": "وَمَا يَذَّكَّرُ إِلاَّ أُوْلُوٱ ٱلأَلْبَابِ"
  },
  {
   "segment_id": 31,
   "arabic": "رَبَّنَا لاَ تُزِغْ قُلُوبَنَا بَعْدَ إِذْ هَدَيْتَنَا"
  },
  {
   "segment_id": 32,
   "arabic": "وَهَبْ لَنَا مِنْ لَدُنْكَ رَحْمَةً إِنَّكَ أَنْتَ ٱلْوَهَّابُ"
  }
 ]
}