{
 "dua_id": "duasorg-ramadan-end-farewell-6",
 "dua_name_en": "Day Dua - 3",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-end-farewell.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللّهُمّ إِنّي أَسْأَلُكَ إِخْبَاتَ المُخْبِتِينَ،"
  },
  {
   "segment_id": 2,
   "arabic": "وَإِخْلاصَ المُوقِنِينَ،"
  },
  {
   "segment_id": 3,
   "arabic": "وَمُرَافَقَةَ الأَبْرَارِ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَاسْتِحْقَاقَ حَقَائِقِ الاِيمَانِ،"
  },
  {
   "segment_id": 5,
   "arabic": "وَالغَنِيمَةَ مِنْ كُلّ بِرّ،"
  },
  {
   "segment_id": 6,
   "arabic": "وَالسّلامَةَ مِنْ كُلّ إِثْمٍ،"
  },
  {
   "segment_id": 7,
   "arabic": "وَوُجُوبَ رَحْمَتِكَ،"
  },
  {
   "segment_id": 8,
   "arabic": "وَعَزَائِمَ مَغْفِرَتِكَ،"
  },
  {
   "segment_id": 9,
   "arabic": "وَالفَوْزَ بِالجَنّةِ،"
  },
  {
   "segment_id": 10,
   "arabic": "وَالنّجَاةَ مِنَ النَّارِ."
  }
 ]
}