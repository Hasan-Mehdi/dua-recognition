{
 "dua_id": "duasorg-15-shaban-dua-to-welcome-the-birth-of-imam-mahdi-ajtfs",
 "dua_name_en": "Dua’a to welcome the birth of Imam Mahdi (ajtfs)",
 "dua_name_ar": "",
 "source": "https://www.duas.org/15-shaban-dua-to-welcome-the-birth-of-Imam-mahdi-ajtfs.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللّهُمَّ بِحَقِّ لَيْلَتِنَا هذِهِ وَمَوْلُودِهَا"
  },
  {
   "segment_id": 2,
   "arabic": "وَحُجَّتِكَ وَمَوْعُودِهَا،"
  },
  {
   "segment_id": 3,
   "arabic": "الَّتِي قَرَنْتَ إلَى فَضْلِهَا فَضْلاً،"
  },
  {
   "segment_id": 4,
   "arabic": "فَتَمَّتْ كَلِمَتُكَ صِدْقاً وَعَدْلاً،"
  },
  {
   "segment_id": 5,
   "arabic": "لا مُبَدِّلَ لِكَلِمَاتِكَ،"
  },
  {
   "segment_id": 6,
   "arabic": "وَلا مُعَقِّبَ لآيَاتِكَ،"
  },
  {
   "segment_id": 7,
   "arabic": "نُورُكَ الْمُتَأَلِّقُ،"
  },
  {
   "segment_id": 8,
   "arabic": "وَضِيَاؤُكَ الْمُشْرِقُ،"
  },
  {
   "segment_id": 9,
   "arabic": "وَالْعَلَمُ النُّورُ فِي طَخْيَاءِ الدَّيْجُورِ،"
  },
  {
   "segment_id": 10,
   "arabic": "الْغَائِبُ الْمَسْتُورُ"
  },
  {
   "segment_id": 11,
   "arabic": "جَلَّ مَوْلِدُهُ، وَكَرُمَ مَحْتِدُهُ،"
  },
  {
   "segment_id": 12,
   "arabic": "وَالْمَلائِكَةُ شُهَّدُهُ،"
  },
  {
   "segment_id": 13,
   "arabic": "وَاللّهُ نَاصِرُهُ وَمُؤَيِّدُهُ،"
  },
  {
   "segment_id": 14,
   "arabic": "إذَا آنَ مِيعَادُهُ وَالْمَلائِكَةُ أَمْدَادُهُ،"
  },
  {
   "segment_id": 15,
   "arabic": "سَيْفُ اللّهِ الَّذِي لا يَنْبُو،"
  },
  {
   "segment_id": 16,
   "arabic": "وَنُورُهُ الَّذِي لا يَخْبُو،"
  },
  {
   "segment_id": 17,
   "arabic": "وَذُو الْحِلْمِ الَّذِي لا يَصْبُو،"
  },
  {
   "segment_id": 18,
   "arabic": "مَدَارُ الدَّهْرِ،"
  },
  {
   "segment_id": 19,
   "arabic": "وَنَوَامِيسُ الْعَصْرِ،"
  },
  {
   "segment_id": 20,
   "arabic": "وَوُلاةُ الأَمْرِ،"
  },
  {
   "segment_id": 21,
   "arabic": "وَالْمُنَزَّلُ عَلَيْهِمْ مَا يَتَنَزَّلُ فِي لَيْلَةِ الْقَدْرِ،"
  },
  {
   "segment_id": 22,
   "arabic": "وَأَصْحَابُ الْحَشْرِ وَالنَّشْرِ،"
  },
  {
   "segment_id": 23,
   "arabic": "تَرَاجِمَةُ وَحْيِهِ،"
  },
  {
   "segment_id": 24,
   "arabic": "وَوُلاةُ أَمْرِهِ وَنَهْيِهِ."
  },
  {
   "segment_id": 25,
   "arabic": "اللّهُمَّ فَصَلِّ عَلَى خَاتِمِهِمْ وَقَائِمِهِمُ"
  },
  {
   "segment_id": 26,
   "arabic": "الْمَسْتُورِ عَنْ عَوَالِمِهِمْ."
  },
  {
   "segment_id": 27,
   "arabic": "اللّهُمَّ وَأَدْرِكْ بِنَا أَيَّامَهُ"
  },
  {
   "segment_id": 28,
   "arabic": "وَظُهُورَهُ وَقِيَامَهُ،"
  },
  {
   "segment_id": 29,
   "arabic": "وَاجْعَلْنَا مِنْ أَنْصَارِهِ،"
  },
  {
   "segment_id": 30,
   "arabic": "وَاقْرِنْ ثأْرَنَا بِثَأْرِهِ،"
  },
  {
   "segment_id": 31,
   "arabic": "وَاكْتُبْنَا فِي أَعْوَانِهِ وَخُلَصَائِهِ،"
  },
  {
   "segment_id": 32,
   "arabic": "وَأَحْيِنَا فِي دَوْلَتِهِ نَاعِمِينَ،"
  },
  {
   "segment_id": 33,
   "arabic": "وَبِصُحْبَتِهِ غَانِمِينَ،"
  },
  {
   "segment_id": 34,
   "arabic": "وَبِحَقِّهِ قَائِمِينَ،"
  },
  {
   "segment_id": 35,
   "arabic": "وَمِنَ السُّوءِ سَالِمِينَ،"
  },
  {
   "segment_id": 36,
   "arabic": "يَا أَرْحَمَ الرَّاحِمِينَ،"
  },
  {
   "segment_id": 37,
   "arabic": "وَالْحَمْدُ لِلّهِ رَبِّ الْعَالَمِينَ،"
  },
  {
   "segment_id": 38,
   "arabic": "وَصَلَوَاتُهُ عَلَى سَيِّدِنَا مُحَمَّدٍ"
  },
  {
   "segment_id": 39,
   "arabic": "خَاتَمِ النَّبِيِّينَ وَالْمُرْسَلِينَ"
  },
  {
   "segment_id": 40,
   "arabic": "وَعَلَى أَهْلِ بَيْتِهِ الصَّادِقِينَ"
  },
  {
   "segment_id": 41,
   "arabic": "وَعِتْرَتِهِ النَّاطِقِينَ،"
  },
  {
   "segment_id": 42,
   "arabic": "وَالْعَنْ جَمِيعَ الظَّالِمِينَ،"
  },
  {
   "segment_id": 43,
   "arabic": "وَاحْكُمْ بَيْنَنَا وَبَيْنَهُمْ"
  },
  {
   "segment_id": 44,
   "arabic": "يَا أَحْكَمَ الْحَاكِمِينَ."
  }
 ]
}