{
 "dua_id": "duasorg-salaat-al-ghufaylah-1",
 "dua_name_en": "Instruction Block",
 "dua_name_ar": "",
 "source": "https://www.duas.org/salaat-al-ghufaylah.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "وَذَا ٱلنُّونِ إِذْ ذَهَبَ مُغَاضِباً"
  },
  {
   "segment_id": 2,
   "arabic": "فَظَنَّ انْ لَنْ نَقْدِرَ عَلَيْهِ"
  },
  {
   "segment_id": 3,
   "arabic": "فَنَادَىٰ فِي ٱلظُّلُمَاتِ"
  },
  {
   "segment_id": 4,
   "arabic": "انْ لاَ إِلٰهَ إِلاَّ انْتَ سُبْحَانَكَ"
  },
  {
   "segment_id": 5,
   "arabic": "إِنِّي كُنتُ مِنَ ٱلظَّالِمِينَ"
  },
  {
   "segment_id": 6,
   "arabic": "فَٱسْتَجَبْنَا لَهُ وَنَجَّيْنَاهُ مِنَ ٱلغَمِّ"
  },
  {
   "segment_id": 7,
   "arabic": "وَكَذٰلِكَ نُنْجِي ٱلْمُؤْمِنِينَ"
  }
 ]
}