{
 "dua_id": "dua-monday",
 "dua_name_en": "Dua al-Ithneen",
 "dua_name_ar": "دعاء الإثنين",
 "source": "https://www.duaplayer.org/en/dua/monday",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمٰنِ ٱلرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "الْحَمْدُ لِلَّهِ ٱلَّذِي لَمْ يُشْهِدْ احَداً"
  },
  {
   "segment_id": 3,
   "arabic": "حِيـنَ فَطَرَ ٱلسَّمَاوَاتِ وَٱلارْضَ"
  },
  {
   "segment_id": 4,
   "arabic": "وَلاَ ٱتَّخَذَ مُعِيناً حِيـنَ بَرَا ٱلنَّسَمَاتِ"
  },
  {
   "segment_id": 5,
   "arabic": "لَمْ يُشَارَكْ فِي ٱلإِلٰهِيَّةِ"
  },
  {
   "segment_id": 6,
   "arabic": "وَلَمْ يُظاهَرْ فِي ٱلْوَحْدَانِيَّةِ"
  },
  {
   "segment_id": 7,
   "arabic": "كَلَّتِ ٱلالْسُنُ عَنْ غَايَةِ صِفَتِهِ"
  },
  {
   "segment_id": 8,
   "arabic": "وَٱنْحَسَرَتِ ٱلْعُقُولُ عَنْ كُنْهِ مَعْرِفَتِهِ"
  },
  {
   "segment_id": 9,
   "arabic": "وَتَوَاضَعَتِ ٱلْجَبَابِرَةُ لِهَيْبَتِهِ"
  },
  {
   "segment_id": 10,
   "arabic": "وَعَنَتِ ٱلْوُجُوهُ لِخَشْيَتِهِ"
  },
  {
   "segment_id": 11,
   "arabic": "وَٱنْقَادَ كُلُّ عَظِيمٍ لِعَظَمَتِهِ"
  },
  {
   "segment_id": 12,
   "arabic": "فَلَكَ ٱلْحَمْدُ مُتَوَاتِراً مُتَّسِقاً"
  },
  {
   "segment_id": 13,
   "arabic": "وَمُتَوَالِياً مُسْتَوْسِقاً"
  },
  {
   "segment_id": 14,
   "arabic": "وَصَلَوَاتُهُ عَلَىٰ رَسُولِهِ ابَداً"
  },
  {
   "segment_id": 15,
   "arabic": "وَسَلامُهُ دَائِماً سَرْمَداً"
  },
  {
   "segment_id": 16,
   "arabic": "اَللَّهُمَّ ٱجْعَلْ اوَّلَ يَوْمِي هٰذَا صَلاَحاً"
  },
  {
   "segment_id": 17,
   "arabic": "وَ اوْسَطَهُ فَلاَحاً"
  },
  {
   "segment_id": 18,
   "arabic": "وَآخِرَهُ نَجَاحاً"
  },
  {
   "segment_id": 19,
   "arabic": "وَ اعُوذُ بِكَ مِنْ يَوْمٍ اَوَّلُهُ فَزَعٌ"
  },
  {
   "segment_id": 20,
   "arabic": "وَ اوْسَطُهُ جَزَعٌ"
  },
  {
   "segment_id": 21,
   "arabic": "وَآخِرُهُ وَجَعٌ"
  },
  {
   "segment_id": 22,
   "arabic": "اَللَّهُمَّ إِنِّي اسْتَغْفِرُكَ لِكُلِّ نَذْرٍ نَذَرْتُهُ"
  },
  {
   "segment_id": 23,
   "arabic": "وَلِكُلِّ وَعْدٍ وَعَدْتُهُ"
  },
  {
   "segment_id": 24,
   "arabic": "وَلِكُلِّ عَهْدٍ عَاهَدْتُهُ"
  },
  {
   "segment_id": 25,
   "arabic": "ثُمَّ لَمْ افِ لَكَ بِهِ"
  },
  {
   "segment_id": 26,
   "arabic": "وَ اسْالُكَ فِي مَظَالِمِ عِبَادِكَ عِنْدِي"
  },
  {
   "segment_id": 27,
   "arabic": "فَايُّمَا عَبْدٍ مِنْ عَبِيدِكَ"
  },
  {
   "segment_id": 28,
   "arabic": "اوْ امَةٍ مِنْ إِمَائِكَ"
  },
  {
   "segment_id": 29,
   "arabic": "كَانَتْ لَهُ قِبَلِي مَظْلَمَةٌ ظَلَمْتُهَا إِيَّاهُ"
  },
  {
   "segment_id": 30,
   "arabic": "فِي نَفْسِهِ اوْ فِي عِرْضِهِ"
  },
  {
   "segment_id": 31,
   "arabic": "اوْ فِي مَالِهِ اوْ فِي اهْلِهِ وَوَلَدِهِ"
  },
  {
   "segment_id": 32,
   "arabic": "اوْ غِيبَةٌ ﭐغْتَبْتُهُ بِهَا"
  },
  {
   "segment_id": 33,
   "arabic": "اوْ تَحَامُلٌ عَلَيهِ بِمَيْلٍ اوْ هَوًىٰ"
  },
  {
   "segment_id": 34,
   "arabic": "اوْ انَفَةٍ اوْ حَمِيَّةٍ"
  },
  {
   "segment_id": 35,
   "arabic": "اوْ رِيَاءٍ اوْ عَصَبِيَّةٍ"
  },
  {
   "segment_id": 36,
   "arabic": "غَائِباً كَانَ اوْ شَاهِداً"
  },
  {
   "segment_id": 37,
   "arabic": "وَحَيّاً كَانَ اوْ مَيِّتاً"
  },
  {
   "segment_id": 38,
   "arabic": "فَقَصُرَتْ يَدِي"
  },
  {
   "segment_id": 39,
   "arabic": "وَضَاقَ وُسْعِي عَنْ رَدِّهَا إِلَيْهِ"
  },
  {
   "segment_id": 40,
   "arabic": "وَٱلتَّحَلُّلِ مِنْهُ"
  },
  {
   "segment_id": 41,
   "arabic": "فَاسْالُك يَا مَنْ يَمْلِكُ ٱلْحَاجَاتِ"
  },
  {
   "segment_id": 42,
   "arabic": "وَهِيَ مُسْتَجِيبَةٌ بِمَشِيَّتِهِ"
  },
  {
   "segment_id": 43,
   "arabic": "وَمُسْرِعَةٌ إِلَىٰ إِرَادَتِهِ"
  },
  {
   "segment_id": 44,
   "arabic": "انْ تُصَلِّيَ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 45,
   "arabic": "وَانْ تُرْضِيَهُ عَنِّي بِمَا شِئْتَ"
  },
  {
   "segment_id": 46,
   "arabic": "وَتَهَبَ لِي مِنْ عِنْدِكَ رَحْمَةً"
  },
  {
   "segment_id": 47,
   "arabic": "إِنَّهُ لاَ تَنْقُصُكَ ٱلْمَغْفِرَةُ"
  },
  {
   "segment_id": 48,
   "arabic": "وَلاَ تَضُرُّكَ ٱلْمَوْهِبَةُ"
  },
  {
   "segment_id": 49,
   "arabic": "يَا ارْحَمَ ٱلرَّاحِمِينَ"
  },
  {
   "segment_id": 50,
   "arabic": "اَللَّهُمَّ اوْلِنِي فِي كُلِّ يَومِ ٱثْنَيْنِ"
  },
  {
   "segment_id": 51,
   "arabic": "نِعْمَتَيْنِ مِنْكَ ثِنْتَيْنِ"
  },
  {
   "segment_id": 52,
   "arabic": "سَعَادَةً فِي اوَّلِهِ بِطَاعَتِكَ"
  },
  {
   "segment_id": 53,
   "arabic": "وَنِعْمَةً فِي آخِرِهِ بِمَغْفِرَتِكَ"
  },
  {
   "segment_id": 54,
   "arabic": "يَا مَنْ هُوَ ٱلإِلٰهُ"
  },
  {
   "segment_id": 55,
   "arabic": "وَلاَ يَغْفِرُ ٱلذُّنُوبَ سِوَاهُ"
  }
 ]
}