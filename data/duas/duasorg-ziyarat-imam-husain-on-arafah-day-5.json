{
 "dua_id": "duasorg-ziyarat-imam-husain-on-arafah-day-5",
 "dua_name_en": "Ziyarah of the Martyrs of Karbala",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ziyarat-imam-husain-on-arafah-day.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَلسَّلاَمُ عَلَيْكُمْ يَا أَوْلِيَاءَ ٱللَّهِ وَأَحِبَّاءَهُ"
  },
  {
   "segment_id": 2,
   "arabic": "اَلسَّلاَمُ عَلَيْكُمْ يَا أَصْفِيَاءَ ٱللَّهِ وَأَوِدَّاءَهُ"
  },
  {
   "segment_id": 3,
   "arabic": "اَلسَّلاَمُ عَلَيْكُمْ يَا أَنْصَارَ دِينِ ٱللَّهِ"
  },
  {
   "segment_id": 4,
   "arabic": "وَأَنْصَارَ نَبِيِّهِ"
  },
  {
   "segment_id": 5,
   "arabic": "وَأَنْصَارَ أَمِيرِ ٱلْمُؤْمِنِينَ"
  },
  {
   "segment_id": 6,
   "arabic": "وَأَنْصَارَ فَاطِمَةَ سَيِّدَةِ نِسَاءِ ٱلْعَالَمِينَ"
  },
  {
   "segment_id": 7,
   "arabic": "اَلسَّلاَمُ عَلَيْكُمْ يَا أَنْصَارَ أَبِي مُحَمَّدٍ"
  },
  {
   "segment_id": 8,
   "arabic": "ٱلْحَسَنِ ٱلْوَلِيِّ ٱلنَّاصِحِ"
  },
  {
   "segment_id": 9,
   "arabic": "اَلسَّلاَمُ عَلَيْكُمْ يَا أَنْصَارَ أَبِي عَبْدِ ٱللَّهِ"
  },
  {
   "segment_id": 10,
   "arabic": "ٱلْحُسَيْنِ ٱلشَّهِيدِ ٱلْمَظْلُومِ"
  },
  {
   "segment_id": 11,
   "arabic": "صَلَوَاتُ ٱللَّهِ عَلَيْهِمْ أَجْمَعِينَ"
  },
  {
   "segment_id": 12,
   "arabic": "بِأَبِي أَنْتُمْ وَأُمِّي"
  },
  {
   "segment_id": 13,
   "arabic": "طِبْتُمْ وَطَابَتِ ٱلأَرْضُ ٱلَّتِي فِيهَا دُفِنْتُمْ"
  },
  {
   "segment_id": 14,
   "arabic": "وَفُزْتُمْ وَٱللَّهِ فَوْزاً عَظِيماً"
  },
  {
   "segment_id": 15,
   "arabic": "يَا لَيْتَنِي كُنْتُ مَعَكُمْ فَأَفُوزَ مَعَكُمْ"
  },
  {
   "segment_id": 16,
   "arabic": "فِي ٱلْجِنَانِ مَعَ ٱلشُّهَدَاءِ وَٱلصَّالِحينَ"
  },
  {
   "segment_id": 17,
   "arabic": "وَحَسُنَ أُولٰئِكَ رَفِيقاً"
  },
  {
   "segment_id": 18,
   "arabic": "وَٱلسَّلاَمُ عَلَيْكُمْ وَرَحْمَةُ ٱللَّهِ وَبَرَكَاتُهُ"
  }
 ]
}