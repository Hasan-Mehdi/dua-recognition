{
 "dua_id": "duasorg-ramadan-day-09-2",
 "dua_name_en": "Ramadan Day 9 · Second du'a",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-day-09.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللَّهُمَّ اغْفِرْ ذَنْبِي وَ اعْصِمْ عَمَلِي"
  },
  {
   "segment_id": 2,
   "arabic": "وَ اهْدِ قَلْبِي وَ اشْرَحْ صَدْرِي"
  },
  {
   "segment_id": 3,
   "arabic": "وَ يَسِّرْ لِي أَمْرِي وَ جَوِّدْ فَهْمِي"
  },
  {
   "segment_id": 4,
   "arabic": "وَ خَفِّفْ وِزْرِي وَ آمِنْ خَوْفِي"
  },
  {
   "segment_id": 5,
   "arabic": "وَ ثَبِّتْ حُجَّتِي وَ ارْبُطْ جَأْشِي"
  },
  {
   "segment_id": 6,
   "arabic": "وَ بَيِّضْ وَجْهِي وَ ارْفَعْ جَاهِي"
  },
  {
   "segment_id": 7,
   "arabic": "وَ صَدِّقْ قَوْلِي وَ بَلِّغْ حَدِيثِي"
  },
  {
   "segment_id": 8,
   "arabic": "وَ عَافِنِي فِي عُمُرِي"
  },
  {
   "segment_id": 9,
   "arabic": "وَ بَارِكْ لِي فِي مُنْقَلَبِي"
  },
  {
   "segment_id": 10,
   "arabic": "وَ اعْصِمْنِي فِي جَمِيعِ أَحْوَالِي"
  },
  {
   "segment_id": 11,
   "arabic": "وَ أَوْسِعْ عَلَيَّ فِي رِزْقِي"
  },
  {
   "segment_id": 12,
   "arabic": "وَ سَهِّلْ عَلَيَّ مَطَالِبِي"
  },
  {
   "segment_id": 13,
   "arabic": "وَ أَعْطِنِي مِنْ جَزِيلِ عَطَائِكَ"
  },
  {
   "segment_id": 14,
   "arabic": "وَ أَفْضَلِ مَا أَعْطَيْتَ أَحَداً مِنْ خَلْقِكَ"
  },
  {
   "segment_id": 15,
   "arabic": "وَ تَجَاوَزْ عَنِّي عَنْ جَمِيعِ مَا عِنْدِي بِحُسْنِ لُطْفِكَ الَّذِي عِنْدَكَ"
  },
  {
   "segment_id": 16,
   "arabic": "اللَّهُمَّ لَا تُشْمِتْ بِي عَدُوِّي"
  },
  {
   "segment_id": 17,
   "arabic": "وَ لَا تُمَكِّنْهُ مِنْ عُنُقِي"
  },
  {
   "segment_id": 18,
   "arabic": "وَ لَا تَفْضَحْنِي فِي نَفْسِي"
  },
  {
   "segment_id": 19,
   "arabic": "وَ لَا تَفْجَعْنِي فِي جَارِي"
  },
  {
   "segment_id": 20,
   "arabic": "وَ هَبْ لِي"
  },
  {
   "segment_id": 21,
   "arabic": "يَا إِلَهِي عَطِيَّةً كَرِيمَةً رَحِيمَةً"
  },
  {
   "segment_id": 22,
   "arabic": "مِنْ عَطَائِكَ الَّذِي لَا فَقْرَ بَعْدَهُ"
  },
  {
   "segment_id": 23,
   "arabic": "فَقَدْ ضَعُفَتْ قُوَّتِي"
  },
  {
   "segment_id": 24,
   "arabic": "وَ انْقَطَعَ عَنِ الْخَلْقِ رَجَائِي"
  },
  {
   "segment_id": 25,
   "arabic": "فَقُدْرَتُكَ"
  },
  {
   "segment_id": 26,
   "arabic": "يَا رَبِّ أَنْ تَرْحَمَنِي"
  },
  {
   "segment_id": 27,
   "arabic": "وَ تُعَافِيَنِي كَقُدْرَتِكَ عَلَى أَنْ تُعَذِّبَنِي"
  },
  {
   "segment_id": 28,
   "arabic": "وَ تَبْتَلِيَنِي فَاجْعَلْ"
  },
  {
   "segment_id": 29,
   "arabic": "يَا مَوْلَايَ فِيمَا قَضَيْتَ"
  },
  {
   "segment_id": 30,
   "arabic": "تَعْجِيلَ خَلَاصِي مِنْ جَمِيعِ مَا أَنَا فِيهِ"
  },
  {
   "segment_id": 31,
   "arabic": "مِنَ الْمَكْرُوهِ وَ الْمَحْذُورِ وَ الْمَشَقَّةِ"
  },
  {
   "segment_id": 32,
   "arabic": "وَعَافِنِي مِنْهُ كُلِّهِ"
  },
  {
   "segment_id": 33,
   "arabic": "يَا إِلَهِي لَا أَرْجُو لِدَفْعِ ذَلِكَ عَنِّْي"
  },
  {
   "segment_id": 34,
   "arabic": "أَحَداً مِنْ خَلْقِكَ"
  },
  {
   "segment_id": 35,
   "arabic": "فَكُنْ يَا ذَا الْجَلَالِ وَ الْإِكْرَامِ"
  },
  {
   "segment_id": 36,
   "arabic": "عِنْدَ أَحْسَنِ ظَنِّي بِكَ"
  },
  {
   "segment_id": 37,
   "arabic": "وَ امْنُنْ عَلَيَّ بِذَلِكَ"
  },
  {
   "segment_id": 38,
   "arabic": "وَعَلَى كُلِّ دَاعٍ دَعَاكَ بِهِ"
  },
  {
   "segment_id": 39,
   "arabic": "يَا مَوْلَايَ مِنَ الْمُؤْمِنِينَ"
  },
  {
   "segment_id": 40,
   "arabic": "وَ أَنْتَ سَيِّدِي"
  },
  {
   "segment_id": 41,
   "arabic": "أَمَرْتَ بِالدُّعَاءِ"
  },
  {
   "segment_id": 42,
   "arabic": "وَ ضَمِنْتَ لِمَنْ شِئْتَ الْإِجَابَةَ"
  },
  {
   "segment_id": 43,
   "arabic": "وَ وَعْدُكَ الْحَقُّ الَّذِي لَا خُلْفَ لَهُ"
  }
 ]
}