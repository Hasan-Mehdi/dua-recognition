{
 "dua_id": "dua-ramadan-30-night",
 "dua_name_en": "Dua Night 30",
 "dua_name_ar": "",
 "source": "https://www.duaplayer.org/en/dua/ramadan-30-night",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَلْحَمْدُ لِلَّهِ لاَ شَرِيكَ لَهُ"
  },
  {
   "segment_id": 2,
   "arabic": "الْحَمْدُ لِلَّهِ كَمَا يَنْبَغِي لِكَرَمِ وَجْهِهِ"
  },
  {
   "segment_id": 3,
   "arabic": "وَعِزِّ جَلاَلِهِ وَكَمَا هُوَ اهْلُهُ"
  },
  {
   "segment_id": 4,
   "arabic": "يَا قُدُّوسُ يَا نُورُ"
  },
  {
   "segment_id": 5,
   "arabic": "يَا نُورَ ٱلْقُدْسِ"
  },
  {
   "segment_id": 6,
   "arabic": "يَا سُبُّوحُ يَا مُنْتَهَىٰ ٱلتَّسْبِيحِ"
  },
  {
   "segment_id": 7,
   "arabic": "يَا رَحْمٰنُ يَا فَاعِلَ ٱلرَّحْمَةِ"
  },
  {
   "segment_id": 8,
   "arabic": "يَا اللَّهُ يَا عَلِيمُ"
  },
  {
   "segment_id": 9,
   "arabic": "يَا كَبِيرُ يَا اللَّهُ"
  },
  {
   "segment_id": 10,
   "arabic": "يَا لَطِيفُ يَا جَلِيلُ"
  },
  {
   "segment_id": 11,
   "arabic": "يَا اللَّهُ يَا سَمِيعُ يَا بَصِيرُ"
  },
  {
   "segment_id": 12,
   "arabic": "يَا اللَّهُ يَا اللَّهُ يَا اللَّهُ"
  },
  {
   "segment_id": 13,
   "arabic": "لَكَ ٱلاسْمَاءُ ٱلْحُسْنَىٰ"
  },
  {
   "segment_id": 14,
   "arabic": "وَٱلامْثَالُ ٱلْعُلْيَا"
  },
  {
   "segment_id": 15,
   "arabic": "وَٱلْكِبْرِيَاءُ وَٱلآلاَءُ"
  },
  {
   "segment_id": 16,
   "arabic": "اسْالُكَ انْ تُصَلِّيَ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 17,
   "arabic": "وَانْ تَجْعَلَ ٱسْمِي فِي هٰذِهِ ٱللَّيْلَةِ فِي ٱلسُّعَدَاءِ"
  },
  {
   "segment_id": 18,
   "arabic": "وَرُوحِي مَعَ ٱلشُّهَدَاءِ"
  },
  {
   "segment_id": 19,
   "arabic": "وَإِحْسَانِي فِي عِلِّيِّينَ"
  },
  {
   "segment_id": 20,
   "arabic": "وَإِسَاءَتِي مَغْفُورَةً"
  },
  {
   "segment_id": 21,
   "arabic": "وَانْ تَهَبَ لِي يَقِيناً تُبَاشِرُ بِهِ قَلْبِي"
  },
  {
   "segment_id": 22,
   "arabic": "وَإِيـمَاناً يُذْهِبُ ٱلشَّكَّ عَنِّي"
  },
  {
   "segment_id": 23,
   "arabic": "وَتُرْضِيَنِي بِمَا قَسَمْتَ لِي"
  },
  {
   "segment_id": 24,
   "arabic": "وَآتِنَا فِي ٱلدُّنْيَا حَسَنَةً"
  },
  {
   "segment_id": 25,
   "arabic": "وَفِي ٱلآخِرَةِ حَسَنَةً"
  },
  {
   "segment_id": 26,
   "arabic": "وَقِنَا عَذَابَ ٱلنَّارِ ٱلْحَرِيقِ"
  },
  {
   "segment_id": 27,
   "arabic": "وَٱرْزُقْنِي فِيهَا ذِكْرَكَ وَشُكْرَكَ وَٱلرَّغْبَةَ إِلَيْكَ"
  },
  {
   "segment_id": 28,
   "arabic": "وَٱلإِنَابَةَ وَٱلتَّوْفِيقَ لِمَا وَفَّقْتَ لَهُ مُحَمَّداً وَآلَ مُحَمَّدٍ عَلَيْهِ وَعَلَيْهِمُ ٱلسَّلاَمُ"
  }
 ]
}