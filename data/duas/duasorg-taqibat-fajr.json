{
 "dua_id": "duasorg-taqibat-fajr",
 "dua_name_en": "Ta'qibat after Fajr",
 "dua_name_ar": "تعقيب صلاة الصبح",
 "source": "https://www.duas.org/regular-after-salaat-taqibat.html (its ta'qibat pages, in Mafatih al-Jinan's order; scripts/taqibat_corpus.py)",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللَّهُمَّ صَلِّ علَىٰ مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 2,
   "arabic": "وَٱهْدِنِي لِمَا ٱخْتُلِفَ فِيهِ مِنَ ٱلحَقِّ بِإِذْنِكَ"
  },
  {
   "segment_id": 3,
   "arabic": "إِنَّكَ تَهْدي مَنْ تَشَاءُ إِلَىٰ صِرَاطٍ مُسْتَقِيمٍ"
  },
  {
   "segment_id": 4,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 5,
   "arabic": "اَلْأَوْصِيَاءِ ٱلرَّاضِيـنَ ٱلْمَرْضِيِّينَ"
  },
  {
   "segment_id": 6,
   "arabic": "بِأَفْضَلِ صَلَوَاتِكَ"
  },
  {
   "segment_id": 7,
   "arabic": "وَبَارِكْ عَلَيْهِمْ بِأَفْضَلِ بَرَكَاتِكَ"
  },
  {
   "segment_id": 8,
   "arabic": "وَٱلسَّلاَمُ عَلَيْهِمْ"
  },
  {
   "segment_id": 9,
   "arabic": "وَعَلىٰ أَرْوَاحِهِمْ وَ أَجْسَادِهِمْ"
  },
  {
   "segment_id": 10,
   "arabic": "وَرَحْمَةُ ٱللَّهِ وَبَرَكَاتُهُ"
  },
  {
   "segment_id": 11,
   "arabic": "اللّهُمَّ أَحْيِنِي عَلى ما أَحْيَيْتَ عَلَيْهِ عَلِيَّ بْنَ أَبِي طالِبٍ"
  },
  {
   "segment_id": 12,
   "arabic": "وَأَمِتْنِي عَلى ما ماتَ عَلَيْهِ عَلِيُّ بْنُ أَبِي طالِبٍ عليه السلام"
  },
  {
   "segment_id": 13,
   "arabic": "أَسْتَغْفِرُ ٱللَّهَ وَ أَتُوبُ إِلَيْهِ"
  },
  {
   "segment_id": 14,
   "arabic": "أَسْأَلُ ٱللَّهَ ٱلْعَافِيَةَ"
  },
  {
   "segment_id": 15,
   "arabic": "أَسْتَجِيـرُ بِٱللَّهِ مِنَ ٱلنَّارِ"
  },
  {
   "segment_id": 16,
   "arabic": "وَ أَسْأَلُهُ ٱلْجَنَّةَ"
  },
  {
   "segment_id": 17,
   "arabic": "أَسْأَلُ ٱللَّهَ ٱلْحُورَ ٱلْعِيـنَ"
  },
  {
   "segment_id": 18,
   "arabic": "لاَ إِلٰهَ إِلاَّ ٱللَّهُ ٱلْمَلِكُ ٱلْحَقُّ ٱلْمُبينُ"
  },
  {
   "segment_id": 19,
   "arabic": "صَلَّىٰ ٱللَّهُ عَلَىٰ مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 20,
   "arabic": "سُبْحَانَ ٱللَّهِوَٱلْحَمْدُ لِلَّهِوَلاَ إِلٰهَ إِلاَّ اللَّهُوَٱللَّهُ أَكْبَرُ"
  },
  {
   "segment_id": 21,
   "arabic": "وَلاَ حَوْلَ وَلاَ قُوَّةَ إِلاَّ بِٱللَّهِ ٱلْعَلِيِّ ٱلْعَظِيمِ"
  },
  {
   "segment_id": 22,
   "arabic": "مَا شَاءَ ٱللَّهُ كَانَ وَلاَ حَوْلَ وَلاَ قُوَّةَ إِلاَّ بِٱللَّهِ ٱلْعَلِيِّ ٱلْعَظِيمِ"
  },
  {
   "segment_id": 23,
   "arabic": "أَصْبَحْتُ ٱللَّهُمَّ مُعْتَصِماً بِذِمَامِكَ ٱلْمَنِيعِ"
  },
  {
   "segment_id": 24,
   "arabic": "ٱلَّذِي لاَ يُطَاوَلُ وَلاَ يُحَاوَلُ"
  },
  {
   "segment_id": 25,
   "arabic": "مِنْ شَرِّ كُلِّ غَاشِمٍ وَطَارِقٍ"
  },
  {
   "segment_id": 26,
   "arabic": "مِنْ سَائِرِ مَنْ خَلَقْتَ وَمَا خَلَقْتَ"
  },
  {
   "segment_id": 27,
   "arabic": "مِنْ خَلْقِكَ ٱلصَّامِتِ وَٱلنَّاطِقِ"
  },
  {
   "segment_id": 28,
   "arabic": "في جُنَّةٍ مِنْ كُلِّ مَخُوفٍ"
  },
  {
   "segment_id": 29,
   "arabic": "بِلِبَاسٍ سَابِغَةٍ"
  },
  {
   "segment_id": 30,
   "arabic": "وَلاَءِ أَهْلِ بَيْتِ نَبِيِّكَ"
  },
  {
   "segment_id": 31,
   "arabic": "مُحْتَجِباً مِنْ كُلِّ قَاصِدٍ لِي إِلىٰ أَذِيَّةٍ"
  },
  {
   "segment_id": 32,
   "arabic": "بِجِدَارٍ حَصِينٍ"
  },
  {
   "segment_id": 33,
   "arabic": "ٱلإِخْلاَصِ فِي ٱلإِعْتِرَافِ بِحَقِّهِمْ"
  },
  {
   "segment_id": 34,
   "arabic": "وَٱلتَّمَسُّكِ بَحَبْلِهِمْ"
  },
  {
   "segment_id": 35,
   "arabic": "مُوقِناً أَنَّ ٱلْحَقَّ لَهُمْ وَمَعَهُمْ"
  },
  {
   "segment_id": 36,
   "arabic": "وَفيهِمْ وَبِهِمْ"
  },
  {
   "segment_id": 37,
   "arabic": "أُوَالِي مَنْ وَالَوْٱ"
  },
  {
   "segment_id": 38,
   "arabic": "وَأُجَانِبُ مَنْ جَانَبُوٱ"
  },
  {
   "segment_id": 39,
   "arabic": "فَأَعِذْنِي اَللَّهُمَّ بِهِمْ"
  },
  {
   "segment_id": 40,
   "arabic": "مِنْ شَرِّ كُلِّ مَا أَتَّقيهِ يَا عَظِيمُ"
  },
  {
   "segment_id": 41,
   "arabic": "حَجَزْتُ ٱلأَعَادِيَ عَنِّي بِبَدِيعِ ٱلسَّمَاوَاتِ وَٱلأَرْضِ"
  },
  {
   "segment_id": 42,
   "arabic": "وَجَعَلْنَا مِنْ بَيْنِ أَيْديهِمِ سَدّاً"
  },
  {
   "segment_id": 43,
   "arabic": "وَمِنْ خَلْفِهِمْ سَدّاً"
  },
  {
   "segment_id": 44,
   "arabic": "فَأَغْشَيْنَاهُمْ فَهُمْ لاَ يُبْصِرُونَ"
  },
  {
   "segment_id": 45,
   "arabic": "سُبْحَانَ ٱللَّهِ ٱلْعَظِيمِ وَبِحَمْدِهِ"
  },
  {
   "segment_id": 46,
   "arabic": "وَلاَ حَوْلَ وَلاَ قُوَةَ إِلاَّ بِٱللَّهِ ٱلْعَلِيِّ ٱلْعَظِيمِ"
  },
  {
   "segment_id": 47,
   "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمٰنِ ٱلرَّحِيمِ"
  },
  {
   "segment_id": 48,
   "arabic": "لاَ حَوْلَ وَلاَ قُوَةَ إِلاَّ بِٱللَّهِ ٱلْعَلِيِّ ٱلْعَظِيمِ"
  },
  {
   "segment_id": 49,
   "arabic": "بِسْمِ ٱللَّهِ"
  },
  {
   "segment_id": 50,
   "arabic": "وَصَلَّىٰ ٱللَّهُ عَلَىٰ مُحَمَّد وآلِهِ"
  },
  {
   "segment_id": 51,
   "arabic": "وَأُفَوِّضُ أَمْرِي إِلَىٰ ٱللَّهِ"
  },
  {
   "segment_id": 52,
   "arabic": "إِنَّ ٱللَّهَ بَصيرٌ بِٱلْعِبَادِ"
  },
  {
   "segment_id": 53,
   "arabic": "فَوَقَاهُ ٱللَّهُ سَيِّئَاتِ مَا مَكَرُوا"
  },
  {
   "segment_id": 54,
   "arabic": "لاَ إِلٰهَ إِلاَّ أَنْتَ سُبْحَانَكَ"
  },
  {
   "segment_id": 55,
   "arabic": "إِنِّي كُنْتُ مِنَ ٱلظَّالِمِيـنَ"
  },
  {
   "segment_id": 56,
   "arabic": "فَٱسْتَجَبْنَا لَهُ وَنَجَّيْنَاهُ مِنَ ٱلغَمِّ"
  },
  {
   "segment_id": 57,
   "arabic": "وَكَذٰلِكَ نُنْجِي ٱلْمُؤْمِنينَ"
  },
  {
   "segment_id": 58,
   "arabic": "حَسْبُنَا ٱللَّهُ وَنِعْمَ ٱلْوَكِيلُ"
  },
  {
   "segment_id": 59,
   "arabic": "فَٱنَقَلَبُوٱ بِنِعْمَةٍ مِنَ ٱللَّهِ وَفَضْلٍ"
  },
  {
   "segment_id": 60,
   "arabic": "لَمْ يَمْسَسْهُمْ سُوءٌ"
  },
  {
   "segment_id": 61,
   "arabic": "مَا شَاءَ ٱللَّهُ"
  },
  {
   "segment_id": 62,
   "arabic": "لاَ حَوْلَ وَلاَ قُوَّةَ إِلاَّ بِٱللَّهِ"
  },
  {
   "segment_id": 63,
   "arabic": "مَا شَاءَ ٱللَّهُ لاَ مَا شَاءَ ٱلنَّاسُ"
  },
  {
   "segment_id": 64,
   "arabic": "مَا شَاءَ ٱللَّهُ وَإِنْ كَرِهَ ٱلنَّاسُ"
  },
  {
   "segment_id": 65,
   "arabic": "حَسْبِيَ ٱلرَّبُّ مِنَ ٱلْمَرْبُوبِيـنَ"
  },
  {
   "segment_id": 66,
   "arabic": "حَسْبِيَ ٱلْخَالِقُ مِنَ ٱلْمَخْلُوقِيـنَ"
  },
  {
   "segment_id": 67,
   "arabic": "حَسْبِيَ ٱلرَّازِقُ مِنَ ٱلْمَرْزُوقِيـنَ"
  },
  {
   "segment_id": 68,
   "arabic": "حَسْبِيَ ٱللَّهُ رَبُّ ٱلْعَالَمِيـنَ"
  },
  {
   "segment_id": 69,
   "arabic": "حَسْبِي مَنْ هُوَ حَسْبِي"
  },
  {
   "segment_id": 70,
   "arabic": "حَسْبِي مَنْ لَمْ يَزَلْ حَسْبِي"
  },
  {
   "segment_id": 71,
   "arabic": "حَسْبِي مَنْ كَانَ مُذْ كُنْتُ لَمْ يَزَلْ حَسْبِي"
  },
  {
   "segment_id": 72,
   "arabic": "حَسْبِيَ ٱللَّهُ لاَ إِلٰهَ إِلاَّ هُوَ"
  },
  {
   "segment_id": 73,
   "arabic": "عَلَيْهِ تَوَكَّلْتُ"
  },
  {
   "segment_id": 74,
   "arabic": "وَهُوَ رَبُّ ٱلْعَرْشِ ٱلْعَظِيمِ"
  },
  {
   "segment_id": 75,
   "arabic": "لاَ حَوْلَ وَلاَ قُوَّةَ إِلاََّ بِٱللَّهِ"
  },
  {
   "segment_id": 76,
   "arabic": "تَوَكَّلْتُ عَلَىٰ ٱلْحَيِّ ٱلَّذِي لاَ يَمُوتُ"
  },
  {
   "segment_id": 77,
   "arabic": "وَٱلْحَمْدُ لِلَّهِ ٱلَّذِي لَمْ يَتَّخِذْ وَلَداً"
  },
  {
   "segment_id": 78,
   "arabic": "وَلَمْ يَكُنْ لَهُ شَرِيكٌ فِي ٱلْمُلْكِ"
  },
  {
   "segment_id": 79,
   "arabic": "وَلَمْ يَكُنْ لَهُ وَلِيٌّ مِنَ ٱلذُّلِّ"
  },
  {
   "segment_id": 80,
   "arabic": "وَكَبِّرْهُ تَكْبِيراً"
  },
  {
   "segment_id": 81,
   "arabic": "لَا إِلٰهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ"
  },
  {
   "segment_id": 82,
   "arabic": "لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ"
  },
  {
   "segment_id": 83,
   "arabic": "يُحْيِي وَيُمِيتُ وَيُمِيتُ وَيُحْيِي"
  },
  {
   "segment_id": 84,
   "arabic": "وَهُوَ حَيٌّ لَا يَمُوتُ"
  },
  {
   "segment_id": 85,
   "arabic": "بِيَدِهِ الْخَيْرُ وَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ"
  },
  {
   "segment_id": 86,
   "arabic": "أَعُوذُ بِاللَّهِ السَّمِيعِ الْعَلِيمِ"
  },
  {
   "segment_id": 87,
   "arabic": "مِنْ هَمَزَاتِ الشَّيَاطِينِ"
  },
  {
   "segment_id": 88,
   "arabic": "وَأَعُوذُ بِاللَّهِ أَنْ يَحْضُرُونِ"
  },
  {
   "segment_id": 89,
   "arabic": "إِنَّ اللَّهَ هُوَ السَّمِيعُ الْعَلِيمُ"
  },
  {
   "segment_id": 90,
   "arabic": "سُبْحَانَ اللّٰهِ الْعَظيْمِ وَبِحَمْدِهِ اَسْتَغْفِرُ اللّٰهَ وَاَسْئَلُهُ مِنْ فَضْلِهِ"
  },
  {
   "segment_id": 91,
   "arabic": "اٰمَنْتُ بِاللهِ وَحْدَهُ لَا شَرِيْكَ لَهُ"
  },
  {
   "segment_id": 92,
   "arabic": "وَ كَفَرْتُ بِالْجِبْتِ وَ الطَّاغُوْتِ"
  },
  {
   "segment_id": 93,
   "arabic": "وَ اٰمَنْتُ بِسِرِّ اٰلِ مُحَمَّدٍ وَ عَلَانِيَتِهِمْ"
  },
  {
   "segment_id": 94,
   "arabic": "وَ ظَاهِرِهِمْ وَ بَاطِنِهِمْ وَ اَوَّلِهِمْ وَ اٰخِرِهِمْ"
  }
 ]
}