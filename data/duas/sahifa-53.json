{
 "dua_id": "sahifa-53",
 "dua_name_en": "Sahifa 53: abasing himself before god",
 "dua_name_ar": "ددُعَاؤُهُ فِي التَّذَلُّلِ",
 "source": "https://duas.pro/53-abasing-himself-before-god",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "رَبِّ أَفْحَمَتْنِيْ ذُنُوبِي، وَانْقَطَعَتْ مَقَالَتِي،"
  },
  {
   "segment_id": 2,
   "arabic": "فَلاَ حُجَّةَ لِي، فَأَنَا الأَسِيـرُ بِبَلِيَّتِي،"
  },
  {
   "segment_id": 3,
   "arabic": "الْمُـرْتَهَنُ بِعَمَلِي، الْمُتَرَدِّدُ فِي خَطِيئَتِي،"
  },
  {
   "segment_id": 4,
   "arabic": "الْمُتَحَيِّرُ عَنْ قَصْدِي، الْمُنْقَطَعُ بِي،"
  },
  {
   "segment_id": 5,
   "arabic": "قَدْ أَوْقَفْتُ نَفْسِي مَوْقِفَ الأَذِلاَّءِ الْمُذْنِبِينَ،"
  },
  {
   "segment_id": 6,
   "arabic": "مَوْقِفَ الأَشْقِيآءِ الْمُتَجَرِّينَ عَلَيْكَ، الْمُسْتَخِفِّينَ بِوَعْدِكَ."
  },
  {
   "segment_id": 7,
   "arabic": "سُبْحَانَكَ! أَيَّ جُرْأَة اجْتَرَأْتُ عَلَيْكَ؟"
  },
  {
   "segment_id": 8,
   "arabic": "وَأَيَّ تَغْرِير غَرَّرْتُ بِنَفْسِي"
  },
  {
   "segment_id": 9,
   "arabic": "مَوْلاَيَ إرْحَمْ كَبْوَتِيْ لِحُرِّ وَجْهِي،"
  },
  {
   "segment_id": 10,
   "arabic": "وَزَلَّةَ قَدَمِي، وَعُدْ بِحِلْمِكَ عَلَى جَهْلِي،"
  },
  {
   "segment_id": 11,
   "arabic": "وَبِإحْسَانِكَ عَلَى إسَآءَتِي، فَأَنَا الْمُقِرُّ بِذَنْبِي،"
  },
  {
   "segment_id": 12,
   "arabic": "الْمُعْتَرِفُ بِخَطِيئَتِي، وَهَذِهِ يَدِيْ وَنَاصِيَتِي،"
  },
  {
   "segment_id": 13,
   "arabic": "أَسْتَكِينُ بِالْقَـوْدِ مِنْ نَفْسِي ."
  },
  {
   "segment_id": 14,
   "arabic": "إرْحَمْ شَيْبَتِي، وَنَفَادَ أَيَّامِي،"
  },
  {
   "segment_id": 15,
   "arabic": "وَاقْتِرَابَ أَجَلِي، وَضَعْفِي،"
  },
  {
   "segment_id": 16,
   "arabic": "وَمَسْكَنَتِي، وَقِلَّةَ حِيلَتِي."
  },
  {
   "segment_id": 17,
   "arabic": "مَوْلاَيَ وَارْحَمْنِي إذَا انْقَطَعَ مِنَ الدُّنْيَا أَثَرِي،"
  },
  {
   "segment_id": 18,
   "arabic": "وَامَّحى مِنَ الْمَخْلُوقِينَ ذِكْرِي،"
  },
  {
   "segment_id": 19,
   "arabic": "وَكُنْتُ فِي الْمَنْسِيِّينَ، كَمَنْ قَدْ نُسِيَ."
  },
  {
   "segment_id": 20,
   "arabic": "مَوْلاَيَ وَارْحَمْنِي عِنْدَ تَغَيُّرِ صُورَتِي"
  },
  {
   "segment_id": 21,
   "arabic": "وَحَالِي إذَا بَلِيَ جِسْمِي، وَتَفَرَّقَتْ أَعْضَائِي،"
  },
  {
   "segment_id": 22,
   "arabic": "وَتَقَطَّعَتْ أَوْصَالِيْ، يا غَفْلَتِي عَمَّا يُرَادُ بِيَ."
  },
  {
   "segment_id": 23,
   "arabic": "مَوْلاَيَ وَارْحَمْنِي فِي حَشْرِي وَنَشْرِي،"
  },
  {
   "segment_id": 24,
   "arabic": "وَاجْعَل فِي ذَلِكَ الْيَومِ مَعَ أَوْلِيَآئِكَ مَوْقِفِي،"
  },
  {
   "segment_id": 25,
   "arabic": "وَفِي أَحِبَّائِكَ مَصْدَرِي،"
  },
  {
   "segment_id": 26,
   "arabic": "وَفِي جِوَارِكَ مَسْكَنِي يَا رَبَّ الْعَالَمِينَ."
  }
 ]
}