{
 "dua_id": "dua-tuesday",
 "dua_name_en": "Dua at-Thulatha'",
 "dua_name_ar": "دعاء الثلاثاء",
 "source": "https://www.duaplayer.org/en/dua/tuesday",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمٰنِ ٱلرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "الْحَمْدُ لِلَّهِ"
  },
  {
   "segment_id": 3,
   "arabic": "وَٱلْحَمْدُ حَقُّهُ كَمَا يَسْتَحِقُّهُ"
  },
  {
   "segment_id": 4,
   "arabic": "حَمْداً كَثيراً"
  },
  {
   "segment_id": 5,
   "arabic": "وَ اعُوذُ بِهِ مِنْ شَرِّ نَفْسِي:"
  },
  {
   "segment_id": 6,
   "arabic": "﴿إِنَّ ٱلنَّفْسَ ﻷَمَّارَةٌ بِٱلسُّوءِ"
  },
  {
   "segment_id": 7,
   "arabic": "إِلاَّ مَا رَحِمَ رَبِّي﴾"
  },
  {
   "segment_id": 8,
   "arabic": "وَ اعُوذُ بِهِ مِنْ شَرِّ ٱلشَّيْطَانِ"
  },
  {
   "segment_id": 9,
   "arabic": "ٱلَّذِي يَزِيدُنِي ذَنْباً إِلَىٰ ذَنْبِي"
  },
  {
   "segment_id": 10,
   "arabic": "وَ احْتَرِزُ بِهِ مِنْ كُلِّ جَبَّارٍ فَاجِرٍ"
  },
  {
   "segment_id": 11,
   "arabic": "وَسُلْطَانٍ جَائِرٍ"
  },
  {
   "segment_id": 12,
   "arabic": "وَعَدُوٍّ قَاهِرٍ"
  },
  {
   "segment_id": 13,
   "arabic": "اَللَّهُمَّ ٱجْعَلْنِي مِنْ جُنْدِكَ"
  },
  {
   "segment_id": 14,
   "arabic": "فَإِنَّ جُنْدَكَ هُمُ ٱلْغَالِبُونَ"
  },
  {
   "segment_id": 15,
   "arabic": "وَٱجْعَلْنِي مِنْ حِزْبِكَ"
  },
  {
   "segment_id": 16,
   "arabic": "فَإِنَّ حِزْبَكَ هُمُ ٱلْمُفْلِحونَ"
  },
  {
   "segment_id": 17,
   "arabic": "وَٱجْعَلْنِي مِنْ اوْلِيَائِكَ"
  },
  {
   "segment_id": 18,
   "arabic": "فَإِنَّ اوْلِيَائَكَ لاَ خَوْفٌ عَلَيْهِمْ وَلاَ هُمْ يَحْزَنُونَ"
  },
  {
   "segment_id": 19,
   "arabic": "اَللَّهُمَّ اصْلِحْ لِي دِينِي"
  },
  {
   "segment_id": 20,
   "arabic": "فَإِنَّهُ عِصْمَةُ امْرِي"
  },
  {
   "segment_id": 21,
   "arabic": "وَ اصْلِحْ لِي آخِرَتِي"
  },
  {
   "segment_id": 22,
   "arabic": "فَإِنَّهَا دَارُ مَقَرِّي"
  },
  {
   "segment_id": 23,
   "arabic": "وَإِلَيْهَا مِنْ مُجاوَرَةِ ٱللِّئَامِ مَفَرِّي"
  },
  {
   "segment_id": 24,
   "arabic": "وَٱجْعَلِ ٱلْحَيَاةَ زِيَادَةً لِي فِي كُلِّ خَيْرٍ"
  },
  {
   "segment_id": 25,
   "arabic": "وَٱلْوَفَاةَ رَاحَةً لِي مِنْ كُلِّ شَرٍّ"
  },
  {
   "segment_id": 26,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ"
  },
  {
   "segment_id": 27,
   "arabic": "خَاتَمِ ٱلنَّبِيِّينَ"
  },
  {
   "segment_id": 28,
   "arabic": "وَتَمَامِ عِدَّةِ ٱلْمُرْسَلِينَ"
  },
  {
   "segment_id": 29,
   "arabic": "وَعَلَىٰ آلِهِ ٱلطَّيِّبِينَ ٱلطَّاهِرِينَ"
  },
  {
   "segment_id": 30,
   "arabic": "وَ اصْحَابِهِ ٱلْمُنْتَجَبِينَ"
  },
  {
   "segment_id": 31,
   "arabic": "وَهَبْ لِي فِي ٱلثُّلاثَاءِ ثَلاثاً"
  },
  {
   "segment_id": 32,
   "arabic": "لاَ تَدَعْ لِي ذَنْباً إِلاَّ غَفَرْتَهُ"
  },
  {
   "segment_id": 33,
   "arabic": "وَلاَ غَمّاً إِلاَّ اذْهَبْتَهُ"
  },
  {
   "segment_id": 34,
   "arabic": "وَلاَ عَدُوّاً إِلاَّ دَفَعْتَهُ"
  },
  {
   "segment_id": 35,
   "arabic": "بِبِسْمِ ٱللَّهِ خَيْرِ ٱلاسْمَاءِ"
  },
  {
   "segment_id": 36,
   "arabic": "بِسْمِ ٱللَّهِ رَبِّ ٱلارْضِ وَٱلسَّمَاءِ"
  },
  {
   "segment_id": 37,
   "arabic": "اسْتَدْفِعُ كُلَّ مَكْرُوهٍ اوَّلُهُ سَخَطُهُ"
  },
  {
   "segment_id": 38,
   "arabic": "وَ اسْتَجْلِبُ كُلَّ مَحْبُوبٍ اوَّلُهُ رِضَاهُ"
  },
  {
   "segment_id": 39,
   "arabic": "فَٱخْتِمْ لِي مِنْكَ بِٱلْغُفْرَانِ"
  },
  {
   "segment_id": 40,
   "arabic": "يَا وَلِيَّ ٱلإِحْسَانِ"
  },
  {
   "segment_id": 41,
   "arabic": "فَاسْالُك يَا مَنْ يَمْلِكُ ٱلْحَاجَاتِ"
  },
  {
   "segment_id": 42,
   "arabic": "وَهِيَ مُسْتَجِيبَةٌ بِمَشِيَّتِهِ"
  },
  {
   "segment_id": 43,
   "arabic": "وَمُسْرِعَةٌ إِلَىٰ إِرَادَتِهِ"
  },
  {
   "segment_id": 44,
   "arabic": "انْ تُصَلِّيَ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 45,
   "arabic": "وَانْ تُرْضِيَهُ عَنِّي بِمَا شِئْتَ"
  },
  {
   "segment_id": 46,
   "arabic": "وَتَهَبَ لِي مِنْ عِنْدِكَ رَحْمَةً"
  },
  {
   "segment_id": 47,
   "arabic": "إِنَّهُ لاَ تَنْقُصُكَ ٱلْمَغْفِرَةُ"
  },
  {
   "segment_id": 48,
   "arabic": "وَلاَ تَضُرُّكَ ٱلْمَوْهِبَةُ"
  },
  {
   "segment_id": 49,
   "arabic": "يَا ارْحَمَ ٱلرَّاحِمِينَ"
  },
  {
   "segment_id": 50,
   "arabic": "اَللَّهُمَّ اوْلِنِي فِي كُلِّ يَومِ ٱثْنَيْنِ"
  },
  {
   "segment_id": 51,
   "arabic": "نِعْمَتَيْنِ مِنْكَ ثِنْتَيْنِ"
  },
  {
   "segment_id": 52,
   "arabic": "سَعَادَةً فِي اوَّلِهِ بِطَاعَتِكَ"
  },
  {
   "segment_id": 53,
   "arabic": "وَنِعْمَةً فِي آخِرِهِ بِمَغْفِرَتِكَ"
  },
  {
   "segment_id": 54,
   "arabic": "يَا مَنْ هُوَ ٱلإِلٰهُ"
  },
  {
   "segment_id": 55,
   "arabic": "وَلاَ يَغْفِرُ ٱلذُّنُوبَ سِوَاهُ"
  }
 ]
}