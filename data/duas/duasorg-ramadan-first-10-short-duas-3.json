{
 "dua_id": "duasorg-ramadan-first-10-short-duas-3",
 "dua_name_en": "Allahumma Inna Hadha Shahr",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-first-10-short-duas.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللّهُمَّ إنَّ هِذا شَهْرُ رَمَضانَ"
  },
  {
   "segment_id": 2,
   "arabic": "اَلَّذي أنْزَلْتَ فِيهِ الْقُرْآنَ،"
  },
  {
   "segment_id": 3,
   "arabic": "هُدىً لِلنّاسِ وَبَيِّناتٍ مِنَ الْهُدى وَالْفُرْقَانِ"
  },
  {
   "segment_id": 4,
   "arabic": "قَدْ حَضَرَ."
  },
  {
   "segment_id": 5,
   "arabic": "يا رَبِّ أعوذُ بِكَ فيهِ مِنَ الشَّيْطانِ الرَّجيمِ،"
  },
  {
   "segment_id": 6,
   "arabic": "وَمِنْ مَكْرِهِ وَحِيَلِهِ،"
  },
  {
   "segment_id": 7,
   "arabic": "وَخِداعِهِ وَحَبائِلِهِ،"
  },
  {
   "segment_id": 8,
   "arabic": "وَجُنودِهِ وَخَيلِهِ،"
  },
  {
   "segment_id": 9,
   "arabic": "وَرِجْلِهِ وَوَساوِسِهِ،"
  },
  {
   "segment_id": 10,
   "arabic": "وَمِنَ الضَّلالِ بَعْدَ الْهُدى،"
  },
  {
   "segment_id": 11,
   "arabic": "وَمِنَ الكُفْرِ بَعْدَ الإيمانِ،"
  },
  {
   "segment_id": 12,
   "arabic": "وَمِنَ النِّفاقِ وَالرِّياءِ وَالجِناياتِ،"
  },
  {
   "segment_id": 13,
   "arabic": "وَمِنْ شَرِّ الوِسْواسِ الخَنّاسِ،"
  },
  {
   "segment_id": 14,
   "arabic": "الَّذي يُوَسْوِسُ في صُدورِ النّاسِ،"
  },
  {
   "segment_id": 15,
   "arabic": "مِنَ الجِنَّةِ وَالنّاسِ."
  },
  {
   "segment_id": 16,
   "arabic": "اللّهُمَّ وَارْزُقْني صِيامَهُ وَقِيامَهُ،"
  },
  {
   "segment_id": 17,
   "arabic": "وَالعَمَلَ فيهِ بِطاعَتِكَ،"
  },
  {
   "segment_id": 18,
   "arabic": "وَطاعَةِ رَسولِكَ وَأُولي الأمْرِ،"
  },
  {
   "segment_id": 19,
   "arabic": "عَلَيهِ وَعَلَيهِمُ السَّلامُ،"
  },
  {
   "segment_id": 20,
   "arabic": "وَما قَرَّبَ مِنْكَ،"
  },
  {
   "segment_id": 21,
   "arabic": "وَجَنِّبْني مَعاصِيكَ،"
  },
  {
   "segment_id": 22,
   "arabic": "وَارْزُقْني فيهِ التَّوْبَةَ وَالإنابَةَ وَالإجابَةَ."
  },
  {
   "segment_id": 23,
   "arabic": "وَأعِذْني فيهِ مِنَ الغيبَةِ وَالكَسَلِ وَالفَشَلِ،"
  },
  {
   "segment_id": 24,
   "arabic": "وَاسْتَجِبْ لي فيهِ الدُّعاءَ،"
  },
  {
   "segment_id": 25,
   "arabic": "وَأصِحَّ لي فيهِ جِسمي وَعَقْلي"
  },
  {
   "segment_id": 26,
   "arabic": "وَفَرِّغْني فيهِ لِطاعَتِكَ وَما قَرَّبَ مِنكَ،"
  },
  {
   "segment_id": 27,
   "arabic": "يا كَريمُ يا جَوادُ."
  },
  {
   "segment_id": 28,
   "arabic": "يا كَريمُ،"
  },
  {
   "segment_id": 29,
   "arabic": "صَلِّ عَلى مُحَمَّدٍ وَعَلى أهْلِ بَيْتِ مُحَمَّدٍ"
  },
  {
   "segment_id": 30,
   "arabic": "عَلَيهِ وَعَلَيهِمُ السَّلامُ،"
  },
  {
   "segment_id": 31,
   "arabic": "وَكَذالِكَ فَافْعَلْ بِنا"
  },
  {
   "segment_id": 32,
   "arabic": "يا أرْحَمَ الرّاحِمينَ."
  }
 ]
}