 "dua_name_ar": "شهر رمضان ٢٥ ",
 "source": "https://www.duaplayer.org/en/dua/ramadan-25",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "اللّهُمّ اجْعَلْنِي فِيهِ مُحِبّاً لأَوْلِيَائِكَ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَمُعَادِياً لأَعْدَائِكَ،"
  },
  {
   "segment_id": 5,
   "arabic": "مُسْتَنّاً بِسُنّةِ خَاتَمِ أَنْبِيَائِكَ،"
  },
  {
   "segment_id": 6,
   "arabic": "يَا عَاصِمَ قُلُوبِ النّبِيّينَ."
  }
 ]
}