{
 "dua_id": "ziyarat-tuesday",
 "dua_name_en": "Ziyarat at-Thulatha'",
 "dua_name_ar": "زیارة الثلاثاء",
 "source": "https://www.duaplayer.org/en/ziyarat/tuesday",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمٰنِ ٱلرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَلسَّلاَمُ عَلَيْكُمْ يَا خُزَّانَ عِلْمِ ٱللَّهِ"
  },
  {
   "segment_id": 3,
   "arabic": "اَلسَّلاَمُ عَلَيْكُمْ يَا تَرَاجِمَةَ وَحْيِ ٱللَّهِ"
  },
  {
   "segment_id": 4,
   "arabic": "اَلسَّلاَمُ عَلَيْكُمْ يَا ائِمَّةَ ٱلْهُدَىٰ"
  },
  {
   "segment_id": 5,
   "arabic": "اَلسَّلاَمُ عَلَيْكُمْ يَا اعْلاَمَ ٱلتُّقَىٰ"
  },
  {
   "segment_id": 6,
   "arabic": "اَلسَّلاَمُ عَلَيْكُمْ يَا اوْلاَدَ رَسُولِ ٱللَّهِ"
  },
  {
   "segment_id": 7,
   "arabic": "انَا عَارِفٌ بِحَقِّكُمْ"
  },
  {
   "segment_id": 8,
   "arabic": "مُسْتَبْصِرٌ بِشَاْنِكُمْ"
  },
  {
   "segment_id": 9,
   "arabic": "مُعَادٍ لاعْدَائِكُمْ"
  },
  {
   "segment_id": 10,
   "arabic": "مُوَالٍ لاوْلِيَائِكُمْ"
  },
  {
   "segment_id": 11,
   "arabic": "بِابِي انْتُمْ وَامِّي"
  },
  {
   "segment_id": 12,
   "arabic": "صَلَوَاتُ ٱللَّهِ عَلَيْكُمْ"
  },
  {
   "segment_id": 13,
   "arabic": "اَللَّهُمَّ إِنِّي اتَوَالَىٰ آخِرَهُمْ كَمَا تَوَالَيْتُ اوَّلَهُمْ"
  },
  {
   "segment_id": 14,
   "arabic": "وَابْرَا مِنْ كُلِّ وَلِيجَةٍ دُونَهُمْ"
  },
  {
   "segment_id": 15,
   "arabic": "وَاكْفُرُ بِٱلْجِبْتِ وَٱلطَّاغُوتِ وَٱللاَّتِ وَٱلْعُزَّىٰ"
  },
  {
   "segment_id": 16,
   "arabic": "صَلَوَاتُ ٱللَّهِ عَلَيْكُمْ يَا مَوَالِيَّ"
  },
  {
   "segment_id": 17,
   "arabic": "وَرَحْمَةُ ٱللَّهِ وَبَرَكَاتُهُ"
  },
  {
   "segment_id": 18,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا سَيِّدَ ٱلْعَابِدِينَ وَسُلاَلَةَ ٱلْوَصِيِّينَ"
  },
  {
   "segment_id": 19,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا بَاقِرَ عِلْمِ ٱلنَّبِيِّينَ"
  },
  {
   "segment_id": 20,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا صَادِقاً مُصَدِّقاً فِي ٱلْقَوْلِ وَٱلْفِعْلِ"
  },
  {
   "segment_id": 21,
   "arabic": "يَا مَوَالِيَّ هٰذَا يَوْمُكُمْ"
  },
  {
   "segment_id": 22,
   "arabic": "وَهُوَ يَوْمُ ٱلثُّلاَثَاءِ"
  },
  {
   "segment_id": 23,
   "arabic": "وَانَا فِيهِ ضَيْفٌ لَكُمْ"
  },
  {
   "segment_id": 24,
   "arabic": "وَمُسْتَجِيرٌ بِكُمْ"
  },
  {
   "segment_id": 25,
   "arabic": "فَاضِيفُونِي وَاجِيرُونِي"
  },
  {
   "segment_id": 26,
   "arabic": "بِمَنْزِلَةِ ٱللَّهِ عِنْدَكُمْ"
  },
  {
   "segment_id": 27,
   "arabic": "وَآلِ بَيْتِكُمُ ٱلطَّيِّبِينَ ٱلطَّاهِرينَ"
  }
 ]
}