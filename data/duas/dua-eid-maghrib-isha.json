{
 "dua_id": "dua-eid-maghrib-isha",
 "dua_name_en": "Dua Ya Dha al-Manni walt-tawli",
 "dua_name_ar": "دعاء يَا ذَا ٱلْمَنِّ وَٱلطَّوْلِ",
 "source": "https://www.duaplayer.org/en/dua/eid-maghrib-isha",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "يَا ذَا ٱلْمَنِّ وَٱلطَّوْلِ"
  },
  {
   "segment_id": 2,
   "arabic": "يَا ذَا ٱلْجُودِ"
  },
  {
   "segment_id": 3,
   "arabic": "يَا مُصْطَفِيَ مُحَمَّدٍ وَنَاصِرَهُ"
  },
  {
   "segment_id": 4,
   "arabic": "صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 5,
   "arabic": "وَٱغْفِرْ لِي كُلَّ ذَنْبٍ احْصَيْتَهُ"
  },
  {
   "segment_id": 6,
   "arabic": "وَهُوَ عِنْدَكَ فِي كِتَابٍ مُبِينٍ"
  },
  {
   "segment_id": 7,
   "arabic": ""
  },
  {
   "segment_id": 8,
   "arabic": "يَا ذَا الْحَوْلِ"
  },
  {
   "segment_id": 9,
   "arabic": "يَا ذَا الطّوْلِ"
  },
  {
   "segment_id": 10,
   "arabic": "يَا مُصْطَفِياً مُحَمّداً وَنَاصِرَهُ"
  },
  {
   "segment_id": 11,
   "arabic": "صَلّ عَلَى مُحَمّدٍ وَآلِ مُحَمّدٍ"
  },
  {
   "segment_id": 12,
   "arabic": "وَاغْفِرْ لِي كُلّ ذَنْبٍ أَذْنَبْتُهُ"
  },
  {
   "segment_id": 13,
   "arabic": "وَنَسِيتُهُ أَنَا وَهُوَ عِنْدَكَ فِي كِتَابٍ مُبِينٍ"
  },
  {
   "segment_id": 14,
   "arabic": ""
  },
  {
   "segment_id": 15,
   "arabic": "أَتُوبُ إِلَى اللّهِ"
  }
 ]
}