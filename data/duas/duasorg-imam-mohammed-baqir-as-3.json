{
 "dua_id": "duasorg-imam-mohammed-baqir-as-3",
 "dua_name_en": "Salawat on Imam Mohammed Baqer (as)",
 "dua_name_ar": "",
 "source": "https://www.duas.org/imam-mohammed-baqir-as.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدِ بْنِ عَلِيٍّ"
  },
  {
   "segment_id": 2,
   "arabic": "بَاقِرِ ٱلْعِلْمِ وَإِمَامِ ٱلْهُدَىٰ"
  },
  {
   "segment_id": 3,
   "arabic": "وَقَائِدِ أَهْلِ ٱلتَّقْوَىٰ"
  },
  {
   "segment_id": 4,
   "arabic": "وَٱلْمُنْتَجَبِ مِنْ عِبَادِكَ"
  },
  {
   "segment_id": 5,
   "arabic": "اَللَّهُمَّ وَكَمَا جَعَلْتَهُ عَلَماً لِعِبَادِكَ"
  },
  {
   "segment_id": 6,
   "arabic": "وَمَنَاراً لِبِلاَدِكَ"
  },
  {
   "segment_id": 7,
   "arabic": "وَمُسْتَوْدَعاً لِحِكْمَتِكَ"
  },
  {
   "segment_id": 8,
   "arabic": "وَمُتَرْجِماً لِوَحْيِكَ"
  },
  {
   "segment_id": 9,
   "arabic": "وَأَمَرْتَ بِطَاعَتِهِ"
  },
  {
   "segment_id": 10,
   "arabic": "وَحَذَّرْتَ عَنْ مَعْصِيَتِهِ"
  },
  {
   "segment_id": 11,
   "arabic": "فَصَلِّ عَلَيْهِ يَا رَبِّ"
  },
  {
   "segment_id": 12,
   "arabic": "أَفْضَلَ مَا صَلَّيْتَ عَلَىٰ أَحَدٍ"
  },
  {
   "segment_id": 13,
   "arabic": "مِنْ ذُرِّيَّةِ أَنْبِيَاءِكَ وَأَصْفِيَاءِكَ"
  },
  {
   "segment_id": 14,
   "arabic": "وَرُسُلِكَ وَأُمَنَائِكَ"
  },
  {
   "segment_id": 15,
   "arabic": "يَا رَبَّ ٱلْعَالَمِينَ"
  }
 ]
}