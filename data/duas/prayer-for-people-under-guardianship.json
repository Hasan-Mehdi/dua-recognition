{
 "dua_id": "prayer-for-people-under-guardianship",
 "dua_name_en": "Prayer For People Under Guardianship",
 "dua_name_ar": "دُعَاؤُهُ لِنَفسِهِ وَ اهل وِِلايتهِ",
 "source": "https://duas.pro/prayer-for-people-under-guardianship",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "يامَن لا تَنْقَضِي عَجَائِبُ عَظَمَتِهِ،"
  },
  {
   "segment_id": 2,
   "arabic": "صَلِّ عَلَى مُحَمَّدٍ وَآلِهِ،"
  },
  {
   "segment_id": 3,
   "arabic": "وَاحْجُبْنَا عَنِ الْإِلْحَادِ فِي عَظَمَتِكَ."
  },
  {
   "segment_id": 4,
   "arabic": "وَيَا مَنْ لا تَنْتَهِي مُدَّةُ مُلْكِهِ،"
  },
  {
   "segment_id": 5,
   "arabic": "صَلِّ عَلَى مُحَمَّدٍ وَآلِهِ،"
  },
  {
   "segment_id": 6,
   "arabic": "وَأَعْتِقْ رِقَابَنَا مِنْ نَقِمَتِكَ."
  },
  {
   "segment_id": 7,
   "arabic": "وَيَا مَنْ لا تَفْنَى خَزَائِنُ رَحْمَتِهِ،"
  },
  {
   "segment_id": 8,
   "arabic": "صَلِّ عَلَى مُحَمَّدٍ وَآلِهِ،"
  },
  {
   "segment_id": 9,
   "arabic": "وَاجْعَلْ لَنَا نَصِيبًا فِي رَحْمَتِكَ."
  },
  {
   "segment_id": 10,
   "arabic": "وَيَا مَنْ تَنْقَطِعُ دُونَ رُؤْيَتِهِ الْأَبْصَارُ،"
  },
  {
   "segment_id": 11,
   "arabic": "صَلِّ عَلَى مُحَمَّدٍ وَآلِهِ،"
  },
  {
   "segment_id": 12,
   "arabic": "وَأَدْنِنَا إِلَى قُرْبِكَ."
  },
  {
   "segment_id": 13,
   "arabic": "وَيَا مَنْ تَصْغُرُ عِنْدَ خَطَرِهِ الْأَخْطَارُ،"
  },
  {
   "segment_id": 14,
   "arabic": "صَلِّ عَلَى مُحَمَّدٍ وَآلِهِ،"
  },
  {
   "segment_id": 15,
   "arabic": "وَكَرِّمْنَا عَلَيْكَ."
  },
  {
   "segment_id": 16,
   "arabic": "وَيَا مَنْ تَظْهَرُ عِنْدَهُ بَوَاطِنُ الْأَخْبَارِ،"
  },
  {
   "segment_id": 17,
   "arabic": "صَلِّ عَلَى مُحَمَّدٍ وَآلِهِ،"
  },
  {
   "segment_id": 18,
   "arabic": "وَلَا تَفْضَحْنَا لَدَيْكَ."
  },
  {
   "segment_id": 19,
   "arabic": "اللَّهُمَّ أَغْنِنَا عَنْ هِبَةِ الْوَهَّابِينَ بِهِبَتِكَ،"
  },
  {
   "segment_id": 20,
   "arabic": "وَاكْفِنَا وَحْشَةَ الْقَاطِعِينَ بِصِلَتِكَ،"
  },
  {
   "segment_id": 21,
   "arabic": "حَتَّى لَا نَرْغَبَ إِلَى أَحَدٍ مَعَ بَذْلِكَ،"
  },
  {
   "segment_id": 22,
   "arabic": "وَلَا نَسْتَوْحِشَ مِنْ أَحَدٍ مَعَ فَضْلِكَ."
  },
  {
   "segment_id": 23,
   "arabic": "اللَّهُمَّ فَصَلِّ عَلَى مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 24,
   "arabic": "وَكِدْ لَنَا وَلَا تَكِدْ عَلَيْنَا،"
  },
  {
   "segment_id": 25,
   "arabic": "وَامْكُرْ لَنَا وَلَا تَمْكُرْ بِنَا،"
  },
  {
   "segment_id": 26,
   "arabic": "وَأَدِلْ لَنَا وَلَا تُدِلَّ مِنَّا."
  },
  {
   "segment_id": 27,
   "arabic": "اللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَآلِهِ،"
  },
  {
   "segment_id": 28,
   "arabic": "وَقِنَا مِنْكَ، وَاحْفَظْنَا بِكَ، وَاهْدِنَا إِلَيْكَ،"
  },
  {
   "segment_id": 29,
   "arabic": "وَلَا تُبَاعِدْنَا عَنْكَ إِنَّ مَنْ تَقِهِ يَسْلَمُ،"
  },
  {
   "segment_id": 30,
   "arabic": "وَمَنْ تَهْدِهِ يَعْلَمُ، وَمَنْ تُقَرِّبُهُ إِلَيْكَ يَغْنَمُ."
  },
  {
   "segment_id": 31,
   "arabic": "اللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 32,
   "arabic": "وَاكْفِنَا حَدَّ نَوَائِبِ الزَّمَانِ،"
  },
  {
   "segment_id": 33,
   "arabic": "وَشَرَّ مَصَائِدِ الشَّيْطَانِ وَمَرَارَةَ صَوْلَةِ السُّلْطَانِ."
  },
  {
   "segment_id": 34,
   "arabic": "اللَّهُمَّ إِنَّمَا يَكْتَفِي الْمُكْتَفُونَ بِفَضْلِ"
  },
  {
   "segment_id": 35,
   "arabic": "قُوَّتِكَ فَصَلِّ عَلَى مُحَمَّدٍ وَآلِهِ، وَاكْفِنَا"
  },
  {
   "segment_id": 36,
   "arabic": "وَإِنَّمَا يُعْطِي الْمُعْطُونَ مِنْ فَضْلِ جِدَّتِكَ"
  },
  {
   "segment_id": 37,
   "arabic": "فَصَلِّ عَلَى مُحَمَّدٍ وَآلِهِ وَأعْطِنَا"
  },
  {
   "segment_id": 38,
   "arabic": "وَإِنَّمَا يَهْتَدِي الْمُهْتَدُونَ بِنُورِ وَجْهِكَ"
  },
  {
   "segment_id": 39,
   "arabic": "فَصَلِّ عَلَى مُحَمَّدٍ وَآلِهِ وَاهْدِنَا."
  },
  {
   "segment_id": 40,
   "arabic": "اللَّهُمَّ إِنَّكَ مَنْ وَلَّيْتَ لَمْ يَضُرَّهُ خِذْلَانُ الْخَاذِلِينَ،"
  },
  {
   "segment_id": 41,
   "arabic": "وَمَنْ أَعْطَيْتَ لَمْ يَنْقُصْهُ مَنْعُ الْمَانِعِينَ،"
  },
  {
   "segment_id": 42,
   "arabic": "وَمَنْ هَدَيْتَ لَمْ يُغْوِهِ إِضْلَالُ الْمُضِلِّينَ."
  },
  {
   "segment_id": 43,
   "arabic": "فَصَلِّ عَلَى مُحَمَّدٍ وَآلِهِ، وَامْنَعْنَا بِعِزَّكَ، مِنْ عِبَادِكَ"
  },
  {
   "segment_id": 44,
   "arabic": "وَأَغْنِنَا عَنْ غَيْرِكَ بِإِرْفَادِكَ،"
  },
  {
   "segment_id": 45,
   "arabic": "وَاسْلُكْ بِنَا سَبِيلَ الْحَقِّ بِإِرْشَادِكَ."
  },
  {
   "segment_id": 46,
   "arabic": "اللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَآلِهِ وَاجْعَلْ سَلاَمَةَ قُلُوبِنَا"
  },
  {
   "segment_id": 47,
   "arabic": "فِي ذِكْرِ عَظَمَتِكَ وَفَرَاغَ أَبْدَانِنَا فِي شُكْرِ نِعْمَتِكَ"
  },
  {
   "segment_id": 48,
   "arabic": "وَانطِلاقَ أَلْسِنَتِنَا فِي وَصْفِ مِنَّتِكَ."
  },
  {
   "segment_id": 49,
   "arabic": "اللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 50,
   "arabic": "وَاجْعَلْنَا مِنْ دُعَاتِكَ الدَّاعِينَ إِلَيْكَ،"
  },
  {
   "segment_id": 51,
   "arabic": "وَهُدَاتِكَ الدَّالِّينَ عَلَيْكَ،"
  },
  {
   "segment_id": 52,
   "arabic": "وَمِنْ خَاصَّتِكَ الْخَاصِّينَ لَدَيْكَ،"
  },
  {
   "segment_id": 53,
   "arabic": "يَا أَرْحَمَ الرَّاحِمِينَ."
  }
 ]
}