{
 "dua_id": "duasorg-zilhajj-amaal-1st-10-days-2",
 "dua_name_en": "Dua after Fajr and Before Magrib",
 "dua_name_ar": "",
 "source": "https://www.duas.org/zilhajj-amaal-1st-10-days.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللَّهُمَّ هٰذِهِ ٱلأَيَّامُ ٱلَّتِي فَضَّلْتَهَا عَلَىٰ ٱلأَيَّامِ وَشَرَّفْتَهَا"
  },
  {
   "segment_id": 2,
   "arabic": "قَدْ بَلَّغْتَنِيهَا بِمَنِّكَ وَرَحْمَتِكَ"
  },
  {
   "segment_id": 3,
   "arabic": "فَأَنْزِلْ عَلَيْنَا مِنْ بَرَكَاتِكَ"
  },
  {
   "segment_id": 4,
   "arabic": "وَأَوْسِعْ عَلَيْنَا فِيهَا مِنْ نَعْمَائِكَ"
  },
  {
   "segment_id": 5,
   "arabic": "اَللَّهُمَّ إِنِّي أَسْأَلُكَ أَنْ تُصَلِّيَ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 6,
   "arabic": "وَأَنْ تَهْدِيَنَا فِيهَا لِسَبِيلِ ٱلْهُدَىٰ"
  },
  {
   "segment_id": 7,
   "arabic": "وَٱلْعِفَافِ وِٱلْغِنَىٰ"
  },
  {
   "segment_id": 8,
   "arabic": "وَٱلْعَمَلِ فِيهَا بِمَا تُحِبُّ وَتَرْضَىٰ"
  },
  {
   "segment_id": 9,
   "arabic": "اَللَّهُمَّ إِنِّي أَسْأَلُكَ يَا مَوْضِعَ كُلِّ شَكْوَىٰ"
  },
  {
   "segment_id": 10,
   "arabic": "وَيَا سَامِعَ كُلِّ نَجْوَىٰ"
  },
  {
   "segment_id": 11,
   "arabic": "وَيَا شَاهِدَ كُلِّ مَلأٍ"
  },
  {
   "segment_id": 12,
   "arabic": "وَيَا عَالِمَ كُلِّ خَفِيَّةٍ"
  },
  {
   "segment_id": 13,
   "arabic": "أَنْ تُصَلِّيَ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 14,
   "arabic": "وَأَنْ تَكْشِفَ عَنَّا فِيهَا ٱلْبَلَاءَ"
  },
  {
   "segment_id": 15,
   "arabic": "وَتَسْتَجِيبَ لَنَا فِيهَا ٱلدُّعَاءَ"
  },
  {
   "segment_id": 16,
   "arabic": "وَتُقَوِّيَنَا فِيهَا وَتُعِينَنَا"
  },
  {
   "segment_id": 17,
   "arabic": "وَتُوَفِّقَنَا فِيهَا لِمَا تُحِبُّ رَبَّنَا وَتَرْضَىٰ"
  },
  {
   "segment_id": 18,
   "arabic": "وَعَلىٰ مَا ٱفْتَرَضْتَ عَلَيْنَا مِنْ طَاعَتِكَ"
  },
  {
   "segment_id": 19,
   "arabic": "وَطَاعَةِ رَسوُلِكَ وَأَهْلِ وَلَايَتِكَ"
  },
  {
   "segment_id": 20,
   "arabic": "اَللَّهُمَّ إِنِّي أَسْأَلُكَ يَا أَرْحَمَ ٱلرَّاحِمِينَ"
  },
  {
   "segment_id": 21,
   "arabic": "أَنْ تُصَلِّيَ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 22,
   "arabic": "وَأَنْ تَهَبَ لَنَا فِيهَا ٱلرِّضَا"
  },
  {
   "segment_id": 23,
   "arabic": "إِنَّكَ سَمِيعُ ٱلدُّعَاءِ"
  },
  {
   "segment_id": 24,
   "arabic": "وَلَا تَحْرِمْنَا خَيْرَ مَا تُنْزِلُ فِيهَا مِنَ ٱلسَّمَاءِ"
  },
  {
   "segment_id": 25,
   "arabic": "وَطَهَّرْنَا مِنَ ٱلذُّنوُبِ"
  },
  {
   "segment_id": 26,
   "arabic": "يَا عَلاَّمَ ٱلْغُيوُبِ"
  },
  {
   "segment_id": 27,
   "arabic": "وَأَوْجِبْ لَنَا فِيهَا دَارَ ٱلْخُلوُدِ"
  },
  {
   "segment_id": 28,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 29,
   "arabic": "وَلَا تَتْرُكْ لَنَا فِيهَا ذَنْباً إِلاَّ غَفَرْتَهُ"
  },
  {
   "segment_id": 30,
   "arabic": "وَلَا هَمّاً إِلاَّ فَرَّجْتَهُ"
  },
  {
   "segment_id": 31,
   "arabic": "وَلَا دَيْناً إِلاَّ قَضَيْتَهُ"
  },
  {
   "segment_id": 32,
   "arabic": "وَلَا غَائِباً إِلاَّ أَدَّيْتَهُ"
  },
  {
   "segment_id": 33,
   "arabic": "وَلَا حَاجَةً مِنْ حَوَائِجِ ٱلدُّنْيَا وَٱلآخِرَةِ"
  },
  {
   "segment_id": 34,
   "arabic": "إِلاَّ سَهَّلْتَهَا وَيَسَّرْتَهَا"
  },
  {
   "segment_id": 35,
   "arabic": "إِنَّكَ عَلَىٰ كُلِّ شَىٰءٍ قَديرٌ"
  },
  {
   "segment_id": 36,
   "arabic": "اَللَّهُمَّ يَا عَالِمَ ٱلْخَفِيَّاتِ"
  },
  {
   "segment_id": 37,
   "arabic": "يَا رَاحِمَ ٱلْعَبَرَاتِ"
  },
  {
   "segment_id": 38,
   "arabic": "يَا مُجِيبَ ٱلدَّعَوَاتِ"
  },
  {
   "segment_id": 39,
   "arabic": "يَا رَبَّ ٱلأَرَضِينَ وَٱلسَّمَاوَاتِ"
  },
  {
   "segment_id": 40,
   "arabic": "يَا مَنْ لَا تَتَشَابَهُ عَلَيْهِ ٱلأَصْوَاتِ"
  },
  {
   "segment_id": 41,
   "arabic": "صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 42,
   "arabic": "وَٱجْعَلْنَا فِيهَا مِنْ عُتَقَائِكَ وَطُلَقَائِكَ مِنَ ٱلنَّارِ"
  },
  {
   "segment_id": 43,
   "arabic": "وَٱلْفَائِزِينَ بِجَنَّتِكَ"
  },
  {
   "segment_id": 44,
   "arabic": "وَٱلنَّاجِينَ بِرَحْمَتِكَ"
  },
  {
   "segment_id": 45,
   "arabic": "يَا أَرْحَمَ ٱلرَّاحِمِينَ"
  },
  {
   "segment_id": 46,
   "arabic": "وَصَلَّىٰ ٱللَّهُ عَلَىٰ سَيِّدِنَا مُحَمَّدٍ وَآلِهِ أَجْمَعينَ"
  }
 ]
}