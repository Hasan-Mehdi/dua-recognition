{
 "dua_id": "duasorg-ziyarat-imam-hussain-night-15-shaban",
 "dua_name_en": "Ziyarat Imam Hussain(as) - 15 Shaban",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ziyarat-imam-hussain-night-15-shaban.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "ألْحَمْدُ للهِ الْعَلِيِّ الْعَظيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "والسَّلامُ عَلَيْكَ أيُّها الْعَبْدُ الصَّالِحُ الزَّكيُّ"
  },
  {
   "segment_id": 3,
   "arabic": "اُودِعُكَ شَهادَةً مِنِّي لَكَ تُقَرِّبُني إلَيْكَ فِي يَوْمِ شَفاعَتِكَ،"
  },
  {
   "segment_id": 4,
   "arabic": "أشْهَدُ أنَّكَ قُتِلْتَ وَلَمْ تَمُتْ"
  },
  {
   "segment_id": 5,
   "arabic": "بَلْ بِرَجاءِ حَياتِكَ حَيِيَتْ قُلُوبُ شيعَتِكَ،"
  },
  {
   "segment_id": 6,
   "arabic": "وَبِضِياءِ نُورِكَ اهْتَدَى الطَّالِبُونَ إلَيْكَ،"
  },
  {
   "segment_id": 7,
   "arabic": "وَأشْهَدُ أنَّكَ نُورُ اللهِ الَّذي لَمْ يُطْفَأْ وَلا يُطْفَأُ أبَداً،"
  },
  {
   "segment_id": 8,
   "arabic": "وَأنَّكَ وَجْهُ اللهِ الَّذي لَمْ يَهْلِكْ وَلا يُهْلَكُ أبَداً،"
  },
  {
   "segment_id": 9,
   "arabic": "وَأشْهَدُ أنَّ هذِهِ التُّرْبَةَ تُرْبَتُكَ،"
  },
  {
   "segment_id": 10,
   "arabic": "وَهذا الْحَرَمَ حَرَمُكَ،"
  },
  {
   "segment_id": 11,
   "arabic": "وَهذا الْمَصْرَعَ مَصْرَعُ بَدَنِكَ"
  },
  {
   "segment_id": 12,
   "arabic": "لا ذَليلَ واللهِ مُعِزُّكَ"
  },
  {
   "segment_id": 13,
   "arabic": "وَلا مَغْلُوبَ واللهِ ناصِرُكَ،"
  },
  {
   "segment_id": 14,
   "arabic": "هذِهِ شَهادَةٌ لي عِنْدَكَ إلى يَوْمَ قَبْضِ روُحي بِحَضْرَتِكَ،"
  },
  {
   "segment_id": 15,
   "arabic": "والسَّلامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ وَبَرَكاتُهُ."
  }
 ]
}