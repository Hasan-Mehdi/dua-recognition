{
 "dua_id": "sahifa-17",
 "dua_name_en": "Sahifa 17: When he mentioned Satan sought refuge from him",
 "dua_name_ar": "دُعَاؤُهُ إذا ذُكِرَ الشيطان فَاستَعاذَ مِنهُِ",
 "source": "https://duas.pro/17-when-he-mentioned-satan-sought-refuge-from-him",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "أَللَّهُمَّ إنَّا نَعُوذُ بِكَ"
  },
  {
   "segment_id": 2,
   "arabic": "مِنْ نَزَغَـاتِ الشَّيْطَانِ الرَّجِيمِ وَكَيْدِهِ وَمَكَائِدِهِ،"
  },
  {
   "segment_id": 3,
   "arabic": "وَمِنَ الثِّقَةِ بِأَمَـانِيِّهِ وَمَوَاعِيدِهِ وَغُرُورِهِ وَمَصَائِدِهِ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَأَنْ يُطْمِعَ نَفْسَهُ فِي إضْلاَلِنَا"
  },
  {
   "segment_id": 5,
   "arabic": "عَنْ طَاعَتِكَ وَامْتِهَانِنَا بِمَعْصِيَتِكَ،"
  },
  {
   "segment_id": 6,
   "arabic": "أَوْ أَنْ يَحْسُنَ عِنْدَنَا مَا حَسَّنَ لَنَا،"
  },
  {
   "segment_id": 7,
   "arabic": "أَوْ أَنْ يَثْقُلَ عَلَيْنَا مَا كَرَّهَ إلَيْنَا."
  },
  {
   "segment_id": 8,
   "arabic": "أللَّهُمَّ اخْسَأْهُ عَنَّا بِعِبَادَتِكَ،"
  },
  {
   "segment_id": 9,
   "arabic": "وَاكْبِتْهُ بِدُؤوبِنَا فِي مَحَبَّتِكَ،"
  },
  {
   "segment_id": 10,
   "arabic": "وَاجْعَلْ بَيْنَنَا وَبَيْنَهُ سِتْراً لاَ يَهْتِكُهُ،"
  },
  {
   "segment_id": 11,
   "arabic": "وَرَدْماً مُصْمِتاً لا يَفْتُقُهُ."
  },
  {
   "segment_id": 12,
   "arabic": "أللَّهُمَّ صَـلِّ عَلَى مُحَمَّد وَآلِـهِ،"
  },
  {
   "segment_id": 13,
   "arabic": "وَاشْغَلْهُ عَنَّا بِبَعْضِ أَعْدَائِكَ،"
  },
  {
   "segment_id": 14,
   "arabic": "وَاعْصِمْنَا مِنْهُ بِحُسْنِ رِعَايَتِكَ، وَاكْفِنَا خَتْرَهُ،"
  },
  {
   "segment_id": 15,
   "arabic": "وَوَلِّنَا ظَهْرَهُ، وَاقْطَعْ عَنَّا إثْرَهُ."
  },
  {
   "segment_id": 16,
   "arabic": "اللَّهُمَّ صَلِّ عَلَى مُحَمَّد وَآلِهِ"
  },
  {
   "segment_id": 17,
   "arabic": "وَأَمْتِعْنَا مِنَ الْهُدَى، بِمِثْلِ ضَلاَلَتِهِ،"
  },
  {
   "segment_id": 18,
   "arabic": "وَزَوِّدْنَا مِنَ التَّقْوَى ضِدَّ غَوَايَتِهِ،"
  },
  {
   "segment_id": 19,
   "arabic": "وَاسْلُكْ بِنَـا مِنَ التُّقى خِـلافَ سَبِيلِهِ مِنَ الـرَّدى."
  },
  {
   "segment_id": 20,
   "arabic": "أللَّهُمَّ لاَ تَجْعَلْ لَهُ فِي قُلُوبِنَا مَدْخَلاً"
  },
  {
   "segment_id": 21,
   "arabic": "وَلاَ تُوطِنَنَّ لَهُ فِيمَا لَدَيْنَا مَنْزِلاً."
  },
  {
   "segment_id": 22,
   "arabic": "اللَّهُمَّ وَمَا سَوَّلَ لَنَا مِنْ بَاطِل فَعَرِّفْنَاهُ"
  },
  {
   "segment_id": 23,
   "arabic": "وَإذَا عَرَّفْتَنَاهُ فَقِنَاهُ، وَبَصِّرْنَا مَا نُكَايِدُهُ بِهِ،"
  },
  {
   "segment_id": 24,
   "arabic": "وَأَلْهِمْنَا مَا نُعِدُّهُ لَهُ، وَأَيْقِظْنَا عَنْ سِنَةِ الْغَفْلَةِ بِالرُّكُونِ إلَيْهِ"
  },
  {
   "segment_id": 25,
   "arabic": "وَأَحْسِنْ بِتَوْفِيقِكَ عَوْنَنَا عَلَيْهِ."
  },
  {
   "segment_id": 26,
   "arabic": "اللَّهُمَّ وَأَشْرِبْ قُلُوبَنَـا إنْكَارَ عَمَلِهِ،"
  },
  {
   "segment_id": 27,
   "arabic": "وَالْـطُفْ لَنَا فِي نَقضِ حِيَلِهِ."
  },
  {
   "segment_id": 28,
   "arabic": "أللَّهُمَّ صَلِّ عَلَى مُحَمَّد وَآلِهِ وَحَوِّلْ سُلْطَانَهُ عَنَّا،"
  },
  {
   "segment_id": 29,
   "arabic": "وَاقْطَعْ رَجَاءَهُ مِنَّا ، وادْرَأْه عَنِ الْوُلُوعِ بِنَا."
  },
  {
   "segment_id": 30,
   "arabic": "اللَّهُمَّ صَلِّ عَلَى مُحَمَّد وَآلِهِ"
  },
  {
   "segment_id": 31,
   "arabic": "وَاجْعَلْ آباءَنَا وَأُمَّهَاتِنَا وَأَوْلاَدَنَا وَأَهَالِينَا"
  },
  {
   "segment_id": 32,
   "arabic": "وَذَوِي أَرْحَامِنَا وَقَرَابَاتِنَا وَجِيْرَانَنَا"
  },
  {
   "segment_id": 33,
   "arabic": "مِنَ الْمُؤْمِنِينَ وَالْمُؤْمِنَـاتِ مِنْهُ فِي حِرْز حَـارِز،"
  },
  {
   "segment_id": 34,
   "arabic": "وَحِصْن حَافِظ ، وَكَهْف مَانِع، وَألْبِسْهُمْ مِنْهُ جُنَناً وَاقِيَةً،"
  },
  {
   "segment_id": 35,
   "arabic": "وَأَعْطِهِمْ عَلَيْهِ أَسْلِحَةً مَاضِيَةً"
  },
  {
   "segment_id": 36,
   "arabic": "أللَّهُمَّ وَاعْمُمْ بِذلِكَ مَنْ شَهِدَ لَكَ بِالرُّبُوبِيَّةِ،"
  },
  {
   "segment_id": 37,
   "arabic": "وَأَخْلَصَ لَكَ بِالْوَحْدَانِيَّةِ،"
  },
  {
   "segment_id": 38,
   "arabic": "وَعَادَاهُ لَكَ بِحَقِيقَةِ الْعُبُودِيَّة،"
  },
  {
   "segment_id": 39,
   "arabic": "وَاسْتَظْهَرَ بِكَ عَلَيْهِ فِي مَعْرِفَةِ الْعُلُومِ الرَّبَّانِيَّةِ."
  },
  {
   "segment_id": 40,
   "arabic": "اللَّهُمَّ احْلُلْ مَا عَقَدَ، وَافْتقْ مَا رَتَقَ،"
  },
  {
   "segment_id": 41,
   "arabic": "وَافسَخ مَا دَبَّرَ، وَثَبِّطْهُ إذَا عَزَمَ، وَانْقُضْ مَا أَبْرَمَ."
  },
  {
   "segment_id": 42,
   "arabic": "اللَّهُمَّ وَاهْزِمْ جُنْدَهُ وَأَبْطِلْ كَيْدَهُ"
  },
  {
   "segment_id": 43,
   "arabic": "وَاهْدِمْ كَهْفَهُ وَأَرْغِمْ أَنْفَهُ."
  },
  {
   "segment_id": 44,
   "arabic": "اللَّهُمَّ اجْعَلْنَا فِي نَظْم أَعْدَآئِهِ"
  },
  {
   "segment_id": 45,
   "arabic": "وَاعْزِلْنَا عَنْ عِدَادِ أَوْلِيَائِهِ،"
  },
  {
   "segment_id": 46,
   "arabic": "لا نُطِيعُ لَهُ إذَا اسْتَهْوَانَا،"
  },
  {
   "segment_id": 47,
   "arabic": "وَلا نَسْتَجِيبُ لَهُ إذَا دَعَانَا"
  },
  {
   "segment_id": 48,
   "arabic": "نَأْمُرُ بِمُنَاوَاتِهِ مَنْ أَطَاعَ أَمْرَنَا"
  },
  {
   "segment_id": 49,
   "arabic": "وَنَعِظُ عَنْ مُتَابَعَتِهِ مَنِ اتَّبَعَ زَجْرَنَا."
  },
  {
   "segment_id": 50,
   "arabic": "اللَّهُمَّ صَلِّ عَلَى مُحَمَّد خَاتَمِ النَّبِيِّينَ وَسَيِّدِ الْمُرْسَلِينَ"
  },
  {
   "segment_id": 51,
   "arabic": "وَعَلَى أَهْلِ بَيْتِهِ الطَّيِّبِينَ الـطَّاهِرِينَ"
  },
  {
   "segment_id": 52,
   "arabic": "وَأَعِذْنَا وَأَهَـالِينَا وَإخْـوَانَنَا"
  },
  {
   "segment_id": 53,
   "arabic": "وَجَمِيـعَ الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ مِمَّا اسْتَعَذْنَا مِنْهُ،"
  },
  {
   "segment_id": 54,
   "arabic": "وَأَجِرْنَا مِمَّا اسْتَجَرْنَا بِكَ مِنْ خَوْفِهِ"
  },
  {
   "segment_id": 55,
   "arabic": "وَاسْمَعْ لَنَا مَا دَعَوْنَا بِهِ وَأَعْطِنَا مَا أَغْفَلْنَاهُ وَاحْفَظْ لَنَا مَا نَسِيْنَاهُ،"
  },
  {
   "segment_id": 56,
   "arabic": "وَصَيِّرْنَا بِذَلِكَ فِي دَرَجَاتِ الصَّالِحِينَ"
  },
  {
   "segment_id": 57,
   "arabic": "وَمَـرَاتِبِ الْمُؤْمِنِينَ"
  },
  {
   "segment_id": 58,
   "arabic": "آمينَ رَبَّ ا لْعَالَمِينَ ."
  }
 ]
}