  {
   "segment_id": 386,
   "arabic": "إِنَّكَ أَنْتَ ٱلْوَهَّابُ"
  },
  {
   "segment_id": 387,
   "arabic": "سُبْحَانَ رَبِّنَا"
  },
  {
   "segment_id": 388,
   "arabic": "إِنْ كَانَ وَعْدُ رَبِّنَا لَمَفْعُولاًَ"
  },
  {
   "segment_id": 389,
   "arabic": "يَا وَلِيَّ ٱللَّهِ"
  },
  {
   "segment_id": 390,
   "arabic": "إِنَّ بَيْنِي وَبيْنَ ٱللَّهِ عَزَّ وَجَلَّ ذُنُوباً"
  },
  {
   "segment_id": 391,
   "arabic": "لَا يَأْتِي عَلَيْهَا إِلَّا رِضَاكُمْ"
  },
  {
   "segment_id": 392,
   "arabic": "فَبِحَقِّ مَنِ ٱئْتَمَنَكُمْ عَلَىٰ سِرِّهِ"
  },
  {
   "segment_id": 393,
   "arabic": "وَٱسْتَرْعَاكُمْ أَمْرَ خَلْقِهِ"
  },
  {
   "segment_id": 394,
   "arabic": "وَقَرَنَ طَاعَتَكُمْ بِطَاعَتِهِ"
  },
  {
   "segment_id": 395,
   "arabic": "لَمَّا ٱسْتَوْهَبْتُمْ ذُنُوبِي"
  },
  {
   "segment_id": 396,
   "arabic": "وَكُنْتُمْ شُفَعَائِي"
  },
  {
   "segment_id": 397,
   "arabic": "فَإِنِّي لَكُمْ مُطِيعٌ"
  },
  {
   "segment_id": 398,
   "arabic": "مَنْ أَطَاعَكُمْ فَقَدْ أَطَاعَ ٱللَّهَ"
  },
  {
   "segment_id": 399,
   "arabic": "وَمَنْ عَصَاكُمْ فَقَدْ عَصَىٰ ٱللَّهَ"
  },
  {
   "segment_id": 400,
   "arabic": "وَمَنْ أَحَبَّكُمْ فَقَدْ أَحَبَّ ٱللَّهَ"
  },
  {
   "segment_id": 401,
   "arabic": "وَمَنْ أَبْغَضَكُمْ فَقَدْ أَبْغَضَ ٱللَّهَ"
  },
  {
   "segment_id": 402,
   "arabic": "اَللَّهُمَّ إِنِّي لَوْ وَجَدْتُ شُفَعَاءَ"
  },
  {
   "segment_id": 403,
   "arabic": "أَقْرَبَ إِلَيْكَ مِنْ مُحَمِّد وَأَهْلِ بَيْتِهِ"
  },
  {
   "segment_id": 404,
   "arabic": "ٱلْأَخْيَارِ ٱلْأَئِمَّةِ ٱلْأَبْرَارِ"
  },
  {
   "segment_id": 405,
   "arabic": "لَجَعَلْتُهُمْ شُفَعَائِي"
  },
  {
   "segment_id": 406,
   "arabic": "فَبِحَقِّهِمُ ٱلَّذِي أَوْجَبْتَ لَهُمْ عَلَيْكَ"
  },
  {
   "segment_id": 407,
   "arabic": "أَسْأَلُكَ أَنْ تُدْخِلَنِي فِي جُمْلَةِ ٱلْعَارِفِينَ بِهِمْ وَبِحَقِّهِمْ"
  },
  {
   "segment_id": 408,
   "arabic": "وَفِي زُمْرَةِ ٱلْمَرْحُومِينَ بِشَفَاعَتِهِمْ"
  },
  {
   "segment_id": 409,
   "arabic": "إِنَّكَ أَرْحَمُ ٱلرَّاحِمِينَ"
  },
  {
   "segment_id": 410,
   "arabic": "وَصَلَّىٰ ٱللَّهُ عَلَىٰ مُحَمَّدٍ وَآلِهِ ٱلطَّاهِرينَ"
  },
  {
   "segment_id": 411,
   "arabic": "وَسَلَّمَ تَسْلِيماً كَثِيراً"
  },
  {
   "segment_id": 412,
   "arabic": "وَحَسْبُنَا ٱللَّهُ وَنِعْمَ ٱلْوَكِيلُ"
  }
 ]
}