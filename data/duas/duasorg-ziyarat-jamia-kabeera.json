{
 "dua_id": "duasorg-ziyarat-jamia-kabeera",
 "dua_name_en": "Ziyarat Jamia - Kabeera",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ziyarat-jamia-kabeera.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَلسَّلاَمُ عَلَيْكُمْ يَا أَهْلَ بَيْتِ ٱلنُّبُوَّةِ"
  },
  {
   "segment_id": 2,
   "arabic": "وَمَوْضِعَ ٱلرِّسَالَةِ"
  },
  {
   "segment_id": 3,
   "arabic": "وَمُخْتَلَفَ ٱلْمَلاَئِكَةِ"
  },
  {
   "segment_id": 4,
   "arabic": "وَمَهْبِطَ ٱلْوَحْيِ"
  },
  {
   "segment_id": 5,
   "arabic": "وَمَعْدِنَ ٱلرَّحْمَةِ"
  },
  {
   "segment_id": 6,
   "arabic": "وَخُزَّانَ ٱلْعِلْمِ"
  },
  {
   "segment_id": 7,
   "arabic": "وَمُنْتَهَىٰ ٱلْحِلْمِ"
  },
  {
   "segment_id": 8,
   "arabic": "وَأُصُولَ ٱلْكَرَمِ"
  },
  {
   "segment_id": 9,
   "arabic": "وَقَادَةَ ٱلْأُمَمِ"
  },
  {
   "segment_id": 10,
   "arabic": "وَأَوْلِيَاءَ ٱلنِّعَمِ"
  },
  {
   "segment_id": 11,
   "arabic": "وَعَنَاصِرَ ٱلْأَبْرَارِ"
  },
  {
   "segment_id": 12,
   "arabic": "وَدَعَائِمَ ٱلْأَخْيَارِ"
  },
  {
   "segment_id": 13,
   "arabic": "وَسَاسَةَ ٱلْعِبَادِ"
  },
  {
   "segment_id": 14,
   "arabic": "وَأَرْكَانَ ٱلْبِلاَدِ"
  },
  {
   "segment_id": 15,
   "arabic": "وَأَبْوَابَ ٱلْإِيـمَانِ"
  },
  {
   "segment_id": 16,
   "arabic": "وَأُمَنَاءَ ٱلرَّحْمٰنِ"
  },
  {
   "segment_id": 17,
   "arabic": "وَسُلاَلَةَ ٱلنَّبِيِّينَ"
  },
  {
   "segment_id": 18,
   "arabic": "وَصَفْوَةَ ٱلْمُرْسَلِينَ"
  },
  {
   "segment_id": 19,
   "arabic": "وَعِتْرَةَ خِيَرَةِ رَبِّ ٱلْعَالَمِينَ"
  },
  {
   "segment_id": 20,
   "arabic": "وَرَحْمَةُ ٱللَّهِ وَبَرَكَاتُهُ"
  },
  {
   "segment_id": 21,
   "arabic": "اَلسَّلاَمُ عَلَىٰ أَئِمَّةِ ٱلْهُدَىٰ"
  },
  {
   "segment_id": 22,
   "arabic": "وَمَصَابِيحِ ٱلدُّجَىٰ"
  },
  {
   "segment_id": 23,
   "arabic": "وَأَعْلاَمِ ٱلتُّقَىٰ"
  },
  {
   "segment_id": 24,
   "arabic": "وَذَوِي ٱلنُّهَىٰ"
  },
  {
   "segment_id": 25,
   "arabic": "وَأُوْلِي ٱلْحِجَىٰ"
  },
  {
   "segment_id": 26,
   "arabic": "وَكَهْفِ ٱلْوَرَىٰ"
  },
  {
   "segment_id": 27,
   "arabic": "وَوَرَثَةِ ٱلْأَنْبِيَاءِ"
  },
  {
   "segment_id": 28,
   "arabic": "وَٱلْمَثَلِ ٱلْأَعْلَىٰ"
  },
  {
   "segment_id": 29,
   "arabic": "وَٱلدَّعْوَةِ ٱلْحُسْنَىٰ"
  },
  {
   "segment_id": 30,
   "arabic": "وَحُجَجِ ٱللَّهِ عَلَىٰ أَهْلِ ٱلدُّنْيَا"
  },
  {
   "segment_id": 31,
   "arabic": "وَٱلْآخِرَةِ وَٱلْأُولَىٰ"
  },
  {
   "segment_id": 32,
   "arabic": "وَرَحْمَةُ ٱللَّهِ وَبَرَكَاتُهُ"
  },
  {
   "segment_id": 33,
   "arabic": "اَلسَّلاَمُ عَلَىٰ مَحَالِّ مَعْرِفَةِ ٱللَّهِ"
  },
  {
   "segment_id": 34,
   "arabic": "وَمَسَاكِنِ بَرَكَةِ ٱللَّهِ"
  },
  {
   "segment_id": 35,
   "arabic": "وَمَعَادِنِ حِكْمَةِ ٱللَّهِ"
  },
  {
   "segment_id": 36,
   "arabic": "وَحَفَظَةِ سِرِّ ٱللَّهِ"
  },
  {
   "segment_id": 37,
   "arabic": "وَحَمَلَةِ كِتَابِ ٱللَّهِ"
  },
  {
   "segment_id": 38,
   "arabic": "وَأَوْصِيَاءِ نَبِيِّ ٱللَّهِ"
  },
  {
   "segment_id": 39,
   "arabic": "وَذُرِّيَّةِ رَسُولِ ٱللَّهِ"
  },
  {
   "segment_id": 40,
   "arabic": "صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ"
  },
  {
   "segment_id": 41,
   "arabic": "وَرَحْمَةُ ٱللَّهِ وَبَرَكَاتُهُ"
  },
  {
   "segment_id": 42,
   "arabic": "اَلسَّلاَمُ عَلَىٰ ٱلدُّعَاةِ إِلَىٰ ٱللَّهِ"
  },
  {
   "segment_id": 43,
   "arabic": "وَٱلْأَدِلاَّءِ عَلَىٰ مَرْضَاتِ ٱللَّهِ"
  },
  {
   "segment_id": 44,
   "arabic": "وَٱلْمُسْتَقِرِّينَ فِي أَمْرِ ٱللَّهِ"
  },
  {
   "segment_id": 45,
   "arabic": "وَٱلتَّامِّينَ فِي مَحَبَّةِ ٱللَّهِ"
  },
  {
   "segment_id": 46,
   "arabic": "وَٱلْمُخْلِصِينَ فِي تَوْحِيدِ ٱللَّهِ"
  },
  {
   "segment_id": 47,
   "arabic": "وَٱلْمُظْهِرِينَ لِأَمْرِ ٱللَّهِ وَنَهْيِهِ"
  },
  {
   "segment_id": 48,
   "arabic": "وَعِبَادِهِ ٱلْمُكْرَمِينَ"
  },
  {
   "segment_id": 49,
   "arabic": "ٱلَّذِينَ لَا يَسْبِقُونَهُ بِٱلْقَوْلِ"
  },
  {
   "segment_id": 50,
   "arabic": "وَهُمْ بِأَمْرِهِ يَعْمَلُونَ"
  },
  {
   "segment_id": 51,
   "arabic": "وَرَحْمَةُ ٱللَّهِ وَبَرَكَاتُهُ"
  },
  {
   "segment_id": 52,
   "arabic": "اَلسَّلاَمُ عَلَىٰ ٱلْأَئِمَّةِ ٱلدُّعَاةِ"
  },
  {
   "segment_id": 53,
   "arabic": "وَٱلْقَادَةِ ٱلْهُدَاةِ"
  },
  {
   "segment_id": 54,
   "arabic": "وَٱلسَّادَةِ ٱلْوُلاَةِ"
  },
  {
   "segment_id": 55,
   "arabic": "وَٱلذَّادَةِ ٱلْحُمَاةِ"
  },
  {
   "segment_id": 56,
   "arabic": "وَأَهْلِ ٱلذِّكْرِ"
  },
  {
   "segment_id": 57,
   "arabic": "وَأُوْلِي ٱلْأَمْرِ"
  },
  {
   "segment_id": 58,
   "arabic": "وَبَقِيَّةِ ٱللَّهِ وَخِيَرَتِهِ"
  },
  {
   "segment_id": 59,
   "arabic": "وَحِزْبِهِ وَعَيْبَةِ عِلْمِهِ"
  },
  {
   "segment_id": 60,
   "arabic": "وَحُجَّتِهِ وَصِرَاطِهِ"
  },
  {
   "segment_id": 61,
   "arabic": "وَنُورِهِ وَبُرْهَانِهِ"
  },
  {
   "segment_id": 62,
   "arabic": "وَرَحْمَةُ ٱللَّهِ وَبَرَكَاتُهُ"
  },
  {
   "segment_id": 63,
   "arabic": "أَشْهَدُ أَنْ لَا إِلٰهَ إِلاَّ ٱللَّهُ"
  },
  {
   "segment_id": 64,
   "arabic": "وَحْدَهُ لَا شَرِيكَ لَهُ"
  },
  {
   "segment_id": 65,
   "arabic": "كَمَا شَهِدَ ٱللَّهُ لِنَفْسِهِ"
  },
  {
   "segment_id": 66,
   "arabic": "وَشَهِدَتْ لَهُ مَلاَئِكَتُهُ"
  },
  {
   "segment_id": 67,
   "arabic": "وَأُوْلُو ٱلْعِلْمِ مِنْ خَلْقِهِ"
  },
  {
   "segment_id": 68,
   "arabic": "لَا إِلٰهَ إِلاَّ هُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ"
  },
  {
   "segment_id": 69,
   "arabic": "وَأَشْهَدُ أَنَّ مُحَمَّداً عَبْدُهُ ٱلْمُنْتَجَبُ"
  },
  {
   "segment_id": 70,
   "arabic": "وَرَسُولُهُ ٱلْمُرْتَضَىٰ"
  },
  {
   "segment_id": 71,
   "arabic": "أَرْسَلَهُ بِٱلْهُدَىٰ وَدِينِ ٱلْحَقِّ"
  },
  {
   "segment_id": 72,
   "arabic": "لِيُظْهِرَهُ عَلَىٰ ٱلدِّينِ كُلِّهِ"
  },
  {
   "segment_id": 73,
   "arabic": "وَلَوْ كَرِهَ ٱلْمُشْرِكُونَ"
  },
  {
   "segment_id": 74,
   "arabic": "وَأَشْهَدُ أَنَّكُمُ ٱلْأَئِمَّةُ ٱلرَّاشِدُونَ"
  },
  {
   "segment_id": 75,
   "arabic": "ٱلْمَهْدِيُّونَ ٱلْمَعْصُومُونَ"
  },
  {
   "segment_id": 76,
   "arabic": "ٱلْمُكَرَّمُونَ ٱلْمُقَرَّبُونَ"
  },
  {
   "segment_id": 77,
   "arabic": "ٱلْمُتَّقُونَ ٱلصَّادِقُونَ"
  },
  {
   "segment_id": 78,
   "arabic": "ٱلْمُصْطَفَوْنَ ٱلْمُطيعُونَ لِلَّهِ"
  },
  {
   "segment_id": 79,
   "arabic": "ٱلْقَوَّامُونَ بِأَمْرِهِ"
  },
  {
   "segment_id": 80,
   "arabic": "ٱلْعَامِلُونَ بِإِرَادَتِهِ"
  },
  {
   "segment_id": 81,
   "arabic": "ٱلْفَائِزُونَ بِكَرَامَتِهِ"
  },
  {
   "segment_id": 82,
   "arabic": "إِصْطَفَاكُمْ بِعِلْمِهِ"
  },
  {
   "segment_id": 83,
   "arabic": "وَٱرْتَضَاكُمْ لِغَيْبِهِ"
  },
  {
   "segment_id": 84,
   "arabic": "وَٱخْتَارَكُمْ لِسِرِّهِ"
  },
  {
   "segment_id": 85,
   "arabic": "وَٱجْتَبَاكُمْ بِقُدْرَتِهِ"
  },
  {
   "segment_id": 86,
   "arabic": "وَأَعَزَّكُمْ بِهُدَاهُ"
  },
  {
   "segment_id": 87,
   "arabic": "وَخَصَّكُمْ بِبُرْهَانِهِ"
  },
  {
   "segment_id": 88,
   "arabic": "وَٱنْتَجَبَكُمْ لِنُورِهِ"
  },
  {
   "segment_id": 89,
   "arabic": "وَأَيَّدَكُمْ بِرُوحِهِ"
  },
  {
   "segment_id": 90,
   "arabic": "وَرَضِيَكُمْ خُلَفَاءَ فِي أَرْضِهِ"
  },
  {
   "segment_id": 91,
   "arabic": "وَحُجَجاً عَلَىٰ بَرِيَّتِهِ"
  },
  {
   "segment_id": 92,
   "arabic": "وَأَنْصَاراً لِدِينِهِ"
  },
  {
   "segment_id": 93,
   "arabic": "وَحَفَظَةً لِسِرِّهِ"
  },
  {
   "segment_id": 94,
   "arabic": "وَخَزَنَةً لِعِلْمِهِ"
  },
  {
   "segment_id": 95,
   "arabic": "وَمُسْتَوْدَعاً لِحِكْمَتِهِ"
  },
  {
   "segment_id": 96,
   "arabic": "وَتَرَاجِمَةً لِوَحْيِهِ"
  },
  {
   "segment_id": 97,
   "arabic": "وَأَرْكَاناً لِتَوْحِيدِهِ"
  },
  {
   "segment_id": 98,
   "arabic": "وَشُهَدَاءَ عَلَىٰ خَلْقِهِ"
  },
  {
   "segment_id": 99,
   "arabic": "وَأَعْلاَماً لِعِبَادِهِ"
  },
  {
   "segment_id": 100,
   "arabic": "وَمَنَاراً فِي بِلاَدِهِ"
  },
  {
   "segment_id": 101,
   "arabic": "وَأَدِلاَّءَ عَلَىٰ صِرَاطِهِ"
  },
  {
   "segment_id": 102,
   "arabic": "عَصَمَكُمُ ٱللَّهُ مِنَ ٱلزَّلَلِ"
  },
  {
   "segment_id": 103,
   "arabic": "وَآمَنَكُمْ مِنَ ٱلْفِتَنِ"
  },
  {
   "segment_id": 104,
   "arabic": "وَطَهَّرَكُمْ مِنَ ٱلدَّنَسِ"
  },
  {
   "segment_id": 105,
   "arabic": "وَأَذْهَبَ عَنْكُمُ ٱلرِّجْسَ"
  },
  {
   "segment_id": 106,
   "arabic": "وَطَهَّرَكُمْ تَطْهِيراً"
  },
  {
   "segment_id": 107,
   "arabic": "فَعَظَّمْتُمْ جَلاَلَهُ"
  },
  {
   "segment_id": 108,
   "arabic": "وَأَكْبَرْتُمْ شَأْنَهُ"
  },
  {
   "segment_id": 109,
   "arabic": "وَمَجَّدْتُمْ كَرَمَهُ"
  },
  {
   "segment_id": 110,
   "arabic": "وَأَدَمْتُمْ ذِكْرَهُ"
  },
  {
   "segment_id": 111,
   "arabic": "وَوَكَّدْتُمْ مِيثَاقَهُ"
  },
  {
   "segment_id": 112,
   "arabic": "وَأَحْكَمْتُمْ عَقْدَ طَاعَتِهِ"
  },
  {
   "segment_id": 113,
   "arabic": "وَنَصَحْتُمْ لَهُ فِي ٱلسِّرِّ وَٱلْعَلاَنِيَةِ"
  },
  {
   "segment_id": 114,
   "arabic": "وَدَعَوْتُمْ إِلَىٰ سَبِيلِهِ"
  },
  {
   "segment_id": 115,
   "arabic": "بِٱلْحِكْمَةِ وَٱلْمَوْعِظَةِ ٱلْحَسَنَةِ"
  },
  {
   "segment_id": 116,
   "arabic": "وَبَذَلْتُمْ أَنْفُسَكُمْ فِي مَرْضَاتِهِ"
  },
  {
   "segment_id": 117,
   "arabic": "وَصَبَرْتُمْ عَلَىٰ مَا أَصَابَكُمْ فِي جَنْبِهِ"
  },
  {
   "segment_id": 118,
   "arabic": "وَأَقَمْتُمُ ٱلصَّلاَةَ"
  },
  {
   "segment_id": 119,
   "arabic": "وَآتَيْتُمُ ٱلزَّكَاةَ"
  },
  {
   "segment_id": 120,
   "arabic": "وَأَمَرْتُمْ بِٱلْمَعْرُوفِ"
  },
  {
   "segment_id": 121,
   "arabic": "وَنَهَيْتُمْ عَنِ ٱلْمُنْكَرِ"
  },
  {
   "segment_id": 122,
   "arabic": "وَجَاهَدْتُمْ فِي ٱللَّهِ حَقَّ جِهَادِهِ"
  },
  {
   "segment_id": 123,
   "arabic": "حَتَّىٰ أَعْلَنْتُمْ دَعْوَتَهُ"
  },
  {
   "segment_id": 124,
   "arabic": "وَبَيَّنْتُمْ فَرَائِضَهُ"
  },
  {
   "segment_id": 125,
   "arabic": "وَأَقَمْتُمْ حُدُودَهُ"
  },
  {
   "segment_id": 126,
   "arabic": "وَنَشَرْتُمْ شَرَائِعَ أَحْكَامِهِ"
  },
  {
   "segment_id": 127,
   "arabic": "وَسَنَنْتُمْ سُنَّتَهُ"
  },
  {
   "segment_id": 128,
   "arabic": "وَصِرْتُمْ فِي ذٰلِكَ مِنْهُ إِلَىٰ ٱلرِّضَا"
  },
  {
   "segment_id": 129,
   "arabic": "وَسَلَّمْتُمْ لَهُ ٱلْقَضَاءَ"
