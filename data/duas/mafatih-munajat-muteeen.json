{
 "dua_id": "mafatih-munajat-muteeen",
 "dua_name_en": "Munajat Muti'een",
 "dua_name_ar": "مناجاة المطيعين لله",
 "source": "Mafatih al-Jinan (github.com/kazemcodes/MafatihDecoder); lines from reciters' pauses",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللّهُمَّ أَلْهِمْنا طاعَتَكَ"
  },
  {
   "segment_id": 2,
   "arabic": "وَجَنِّبْنا مَعْصِيَتَكَ"
  },
  {
   "segment_id": 3,
   "arabic": "وَيَسِّرْ لَنا بُلُوغَ ما نَتَمَنّى مِنْ اِبْتِغاءِ رِضْوانِكَ"
  },
  {
   "segment_id": 4,
   "arabic": "وَأَحْلِلْنا بُحْبُوحَةَ جِنانِكَ"
  },
  {
   "segment_id": 5,
   "arabic": "وَاقْشَعْ عَنْ بَصائِرِنا سَحابَ الإِرْتِيابِ"
  },
  {
   "segment_id": 6,
   "arabic": "وَاكْشِفْ عَنْ قُلُوبِنا أَغْشِيَةَ الْمِرْيَةِ وَالْحِجابِ"
  },
  {
   "segment_id": 7,
   "arabic": "وَأَزْهِقِ الْباطِلَ عَنْ ضَمائِرِنا"
  },
  {
   "segment_id": 8,
   "arabic": "وَأَثْبِتِ الْحَقَّ في سَرائِرِنا"
  },
  {
   "segment_id": 9,
   "arabic": "فَإِنَّ الشُّكُوكَ وَالظُّنُونَ لَواقِحُ الْفِتَنِ"
  },
  {
   "segment_id": 10,
   "arabic": "وَمُكَدِّرَةٌ لِصَفْوِ الْمَنائِحِ وَالْمِنَنِ"
  },
  {
   "segment_id": 11,
   "arabic": "اَللّهُمَّ احْمِلْنا في سُفُنِ نَجاتِكَ وَمَتِّعْنا بِلَذيذِ مُناجاتِكَ"
  },
  {
   "segment_id": 12,
   "arabic": "وَأَوْرِدْنا حِياضَ حُبِّكَ وَأَذِقْنا حَلاوَةَ وُدِّكَ وَقُرْبِكَ"
  },
  {
   "segment_id": 13,
   "arabic": "وَاجْعَلْ جِهادَنا فيكَ وَهَمَّنا في طاعَتِكَ"
  },
  {
   "segment_id": 14,
   "arabic": "وَأَخْلِصْ نِيّاتِنا في مُعامَلَتِكَ"
  },
  {
   "segment_id": 15,
   "arabic": "فَإِنّا بِكَ وَلَكَ وَلا وَسيلَةَ لَنا إِلَيْكَ إِلاّ أَنْتَ"
  },
  {
   "segment_id": 16,
   "arabic": "إِلهي اِجْعَلْني مِنَ الْمُصْطَفَيْنَ الأَخْيارِ"
  },
  {
   "segment_id": 17,
   "arabic": "وَأَلْحِقْني بِالصّالِحينَ الأَبْرارِ"
  },
  {
   "segment_id": 18,
   "arabic": "السّابِقينَ إِلى الْمَكْرُماتِ الْمُسارِعينَ إِلى الْخَيْراتِ"
  },
  {
   "segment_id": 19,
   "arabic": "الْعامِلينَ لِلْباقِياتِ الصّالِحاتِ"
  },
  {
   "segment_id": 20,
   "arabic": "السّاعينَ إِلى رَفيعِ الدَّرَجاتِ"
  },
  {
   "segment_id": 21,
   "arabic": "إِنَّكَ عَلى كُلِّ شَيْءٍ قَديرٌ وَبِالإِجابَةِ جَديرٌ"
  },
  {
   "segment_id": 22,
   "arabic": "بِرَحْمَتِكَ يا أَرْحَمَ الرّاحِمينَ"
  }
 ]
}