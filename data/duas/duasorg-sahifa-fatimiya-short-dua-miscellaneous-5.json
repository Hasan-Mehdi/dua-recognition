{
 "dua_id": "duasorg-sahifa-fatimiya-short-dua-miscellaneous-5",
 "dua_name_en": "Instruction Block",
 "dua_name_ar": "",
 "source": "https://www.duas.org/sahifa-fatimiya-short-dua-miscellaneous.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "إِلٰهِي وَ سَيِّدِي"
  },
  {
   "segment_id": 2,
   "arabic": "هٰذَا مُحَمَّدٌ نَبِيُّكَ"
  },
  {
   "segment_id": 3,
   "arabic": "وَ هٰذَا عَلِيٌّ ابْنُ عَمِّ نَبِيِّكَ"
  },
  {
   "segment_id": 4,
   "arabic": "وَ هٰذَانِ الْحَسَنُ وَ الْحُسَيْنُ سِبْطَا نَبِيِّكَ"
  },
  {
   "segment_id": 5,
   "arabic": "إِلٰهِي أَنْزِلْ عَلَيْنَا مَائِدَةً مِنَ السَّمَاءِ"
  },
  {
   "segment_id": 6,
   "arabic": "كَمَا أَنْزَلْتَهَا عَلَى بَنِي إِسْرَائِيلَ"
  },
  {
   "segment_id": 7,
   "arabic": "أَكَلُوا مِنْهَا وَ كَفَرُوا بِهَا"
  },
  {
   "segment_id": 8,
   "arabic": "اللَّهُمَّ أَنْزِلْهَا عَلَيْنَا فَإِنَّا بِكَ مُؤْمِنُونَ"
  },
  {
   "segment_id": 9,
   "arabic": "اللَّهُمَّ إِنَّ فَاطِمَةَ بِنْتَ نَبِيِّكَ قَدْ أَضَرَّ بِهَا الْجُوعُ"
  },
  {
   "segment_id": 10,
   "arabic": "وَ هٰذَا عَلِيُّ بْنُ أَبِي طَالِبٍ ابْنُ عَمِّ نَبِيِّكَ"
  },
  {
   "segment_id": 11,
   "arabic": "قَدْ أَضَرَّ بِهِ الْجُوعُ"
  },
  {
   "segment_id": 12,
   "arabic": "فَأَنْزِلِ اللَّهُمَّ عَلَيْنَا مَائِدَةً مِنَ السَّمَاءِ"
  },
  {
   "segment_id": 13,
   "arabic": "كَمَا أَنْزَلْتَهَا عَلَى بَنِي إِسْرَائِيلَ"
  },
  {
   "segment_id": 14,
   "arabic": "فَكَفَرُوا وَ إِنَّا مُؤْمِنُونَ"
  }
 ]
}