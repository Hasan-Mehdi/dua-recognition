{
 "dua_id": "dua-ramadan-5",
 "dua_name_en": "Day 5",
 "dua_name_ar": "شهر رمضان ٥",
 "source": "https://www.duaplayer.org/en/dua/ramadan-5",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "اللّهُمّ اجْعَلْنِي فِيهِ مِنَ المُسْتَغْفِرِينَ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَاجْعَلْنِي فِيهِ مِنْ عِبَادِكَ الصَّالِحِينَ القَانِتِينَ،"
  },
  {
   "segment_id": 5,
   "arabic": "وَاجْعَلْنِي فِيهِ مِنْ أَوْلِيَائِكَ المُقَرّبِينَ،"
  },
  {
   "segment_id": 6,
   "arabic": "بِرَأْفَتِكَ يَا أَرْحَمَ الرَّاحِمِينَ."
  }
 ]
}