{
 "dua_id": "duasorg-month-of-safar-daily-dua",
 "dua_name_en": "Daily Dua for the Month of Safar",
 "dua_name_ar": "",
 "source": "https://www.duas.org/month-of-safar-daily-dua.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "يَا شَدِيدَ ٱلْقُوَىٰ"
  },
  {
   "segment_id": 2,
   "arabic": "وَيَا شَدِيدَ ٱلْمِحَالِ"
  },
  {
   "segment_id": 3,
   "arabic": "يَا عَزِيزُ يَا عَزِيزُ يَا عَزِيزُ"
  },
  {
   "segment_id": 4,
   "arabic": "ذَلَّتْ بِعَظَمَتِكَ جَمِيعُ خَلْقِكَ"
  },
  {
   "segment_id": 5,
   "arabic": "فَاكْفِنِي شَرَّ خَلْقِكَ"
  },
  {
   "segment_id": 6,
   "arabic": "يَا مُحْسِنُ يَا مُجْمِلُ"
  },
  {
   "segment_id": 7,
   "arabic": "يَا مُنْعِمُ يَا مُفْضِلُ"
  },
  {
   "segment_id": 8,
   "arabic": "يَا لاَ إِلٰهَ إِلاَّ انْتَ سُبْحَانَكَ"
  },
  {
   "segment_id": 9,
   "arabic": "إِنِّي كُنْتُ مِنَ ٱلظَّالِمِينَ"
  },
  {
   "segment_id": 10,
   "arabic": "فَٱسْتَجَبْنَا لَهُ وَنَجّيْنَاهُ مِنَ ٱلْغَمِّ"
  },
  {
   "segment_id": 11,
   "arabic": "وَكَذلِكَ نُنْجِي ٱلْمُؤْمِنِينَ"
  },
  {
   "segment_id": 12,
   "arabic": "وَصَلَّىٰ ٱللَّهُ عَلَىٰ مُحَمَّدٍ وَآلِهِ ٱلطَّيِّبِينَ ٱلطَّاهِرِينَ"
  }
 ]
}