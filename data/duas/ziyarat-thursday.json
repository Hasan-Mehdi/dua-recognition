{
 "dua_id": "ziyarat-thursday",
 "dua_name_en": "Ziyarat al-Khamis",
 "dua_name_ar": "زیارة الخميس",
 "source": "https://www.duaplayer.org/en/ziyarat/thursday",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ ٱللَّهِ ٱلرَّحْمٰنِ ٱلرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا وَلِيَّ ٱللَّهِ"
  },
  {
   "segment_id": 3,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا حُجَّةَ ٱللَّهِ وَخَالِصَتَهُ"
  },
  {
   "segment_id": 4,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا إِمَامَ ٱلْمُؤْمِنينَ"
  },
  {
   "segment_id": 5,
   "arabic": "وَوَارِثَ ٱلْمُرْسَلِينَ"
  },
  {
   "segment_id": 6,
   "arabic": "وَحُجَّةَ رَبِّ ٱلْعَالَمِينَ"
  },
  {
   "segment_id": 7,
   "arabic": "صَلَّىٰ ٱللَّهُ عَلَيْكَ وَعَلَىٰ آلِ بَيْتِكَ"
  },
  {
   "segment_id": 8,
   "arabic": "ٱلطَّيِّبِينَ ٱلطَّاهِرِينَ"
  },
  {
   "segment_id": 9,
   "arabic": "يَا مَوْلاَيَ يَا ابَا مُحَمَّدٍ"
  },
  {
   "segment_id": 10,
   "arabic": "ٱلْحَسَنَ بْنَ عَلِيٍّ"
  },
  {
   "segment_id": 11,
   "arabic": "انَا مَوْلىٰ لَكَ وَلآِلِ بَيْتِكَ"
  },
  {
   "segment_id": 12,
   "arabic": "وَهٰذَا يَوْمُكَ وَهُوَ يَوْمُ ٱلْخَمِيسِ"
  },
  {
   "segment_id": 13,
   "arabic": "وَانَا ضَيْفُكَ فِيهِ وَمُسْتَجِيرٌ بِكَ فِيهِ"
  },
  {
   "segment_id": 14,
   "arabic": "فَاحْسِنْ ضِيَافَتِي وَإِجَارَتِي"
  },
  {
   "segment_id": 15,
   "arabic": "بِحَقِّ آلِ بَيْتِكَ ٱلطَّيِّبِينَ ٱلطَّاهِرِينَ"
  }
 ]
}