{
 "dua_id": "dua-saturday",
 "dua_name_en": "Dua asSabt",
 "dua_name_ar": "دعاء السبت",
 "source": "https://www.duaplayer.org/en/dua/saturday",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ ٱللَّه ٱلرَّحْمٰنِ ٱلرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "بِسْمِ ٱللَّهِ كَلِمَةِ ٱلْمُعْتَصِمِينَ"
  },
  {
   "segment_id": 3,
   "arabic": "وَمَقَالَةِ ٱلْمُتَحَرِّزِينَ"
  },
  {
   "segment_id": 4,
   "arabic": "وَ اعُوذُ بِٱللَّهِ تَعَالَىٰ مِنْ جَوْرِ ٱلْجَائِرِينَ"
  },
  {
   "segment_id": 5,
   "arabic": "وَكَيْدِ ٱلْحَاسِدِينَ"
  },
  {
   "segment_id": 6,
   "arabic": "وَبَغْيِ ٱلظَّالِمِينَ"
  },
  {
   "segment_id": 7,
   "arabic": "وَ احْمَدُهُ فَوْقَ حَمْدِ ٱلْحَامِدِينَ"
  },
  {
   "segment_id": 8,
   "arabic": "اَللَّهُمَّ انْتَ ٱلْوَاحِدُ بِلا شَرِيكٍ"
  },
  {
   "segment_id": 9,
   "arabic": "وَٱلْمَلِكُ بِلا تَمْلِيكٍ"
  },
  {
   "segment_id": 10,
   "arabic": "لاَ تُضَادُّ فِي حُكْمِكَ"
  },
  {
   "segment_id": 11,
   "arabic": "وَلاَ تُنَازَعُ فِي مُلْكِكَ"
  },
  {
   "segment_id": 12,
   "arabic": "اسْالُكَ انْ تُصَلِّيَ عَلَىٰ مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 13,
   "arabic": "عَبْدِكَ وَرَسُولِكَ"
  },
  {
   "segment_id": 14,
   "arabic": "وَانْ تُوْزِعَنِي مِنْ شُكْرِ نَعْمَاكَ"
  },
  {
   "segment_id": 15,
   "arabic": "مَا تَبْلُغُ بِي غَايَةَ رِضَاكَ"
  },
  {
   "segment_id": 16,
   "arabic": "وَانْ تُعِينَنِي عَلَىٰ طَاعَتِكَ"
  },
  {
   "segment_id": 17,
   "arabic": "وَلُزُومِ عِبَادَتِكَ"
  },
  {
   "segment_id": 18,
   "arabic": "وَٱسْتِحْقَاقِ مَثُوبَتِكَ"
  },
  {
   "segment_id": 19,
   "arabic": "بِلُطْفِ عِنَايَتِكَ"
  },
  {
   "segment_id": 20,
   "arabic": "وَتَرْحَمَنِي وَتَصُدَّنِي عَنْ مَعَاصِيكَ مَا احْيَيْتَنِي"
  },
  {
   "segment_id": 21,
   "arabic": "وَتُوَفِّقَنِي لِمَا يَنْفَعُنِي مَا ابْقَيْتَنِي"
  },
  {
   "segment_id": 22,
   "arabic": "وَانْ تَشْرَحَ بِكِتَابِكَ صَدْرِي"
  },
  {
   "segment_id": 23,
   "arabic": "وَتَحُطَّ بِتِلاوَتِهِ وِزْرِي"
  },
  {
   "segment_id": 24,
   "arabic": "وَتَمْنَحَنِي ٱلسَّلامَةَ فِي دِينِي وَنَفْسِي"
  },
  {
   "segment_id": 25,
   "arabic": "وَلاَ تُوحِشْ بِي اهلَ انْسِي"
  },
  {
   "segment_id": 26,
   "arabic": "وَتُتِمَّ إِحْسَانَكَ فِيمَا بَقِيَ مِنْ عُمُرِي"
  },
  {
   "segment_id": 27,
   "arabic": "كَمَا احْسَنْتَ فِيمَا مَضَىٰ مِنْهُ"
  },
  {
   "segment_id": 28,
   "arabic": "يَا ارْحَمَ ٱلرَّاحِمِينَ"
  }
 ]
}