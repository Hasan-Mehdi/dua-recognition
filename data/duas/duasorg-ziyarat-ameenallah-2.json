{
 "dua_id": "duasorg-ziyarat-ameenallah-2",
 "dua_name_en": "Ziyarat Ameenallah - Ziyarat of Imam Ali · Anta ilāhī wa sayyadī…",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ziyarat-ameenallah.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَنْتَ اِلٰهِیْ وَ سَیَّدِیْ وَ مَوْلَایَ"
  },
  {
   "segment_id": 2,
   "arabic": "اغْفِرْ لِاَوْلِیَاۤئِنَا"
  },
  {
   "segment_id": 3,
   "arabic": "وَ كُفَّ عَنَّا اَعْدَاۤئَنَا"
  },
  {
   "segment_id": 4,
   "arabic": "وَ اشْغَلْهُمْ عَنْ اَذَانَا"
  },
  {
   "segment_id": 5,
   "arabic": "وَ اَظْهِرْ كَلِمَۃَ الْحَقِّ"
  },
  {
   "segment_id": 6,
   "arabic": "وَ اجْعَلْهَا الْعُلْیَا"
  },
  {
   "segment_id": 7,
   "arabic": "وَ اَدْحِضْ كَلِمَۃَ الْبَاطِلِ"
  },
  {
   "segment_id": 8,
   "arabic": "وَ اجْعَلْهَا السُّفْلیٰ"
  },
  {
   "segment_id": 9,
   "arabic": "اِنَّكَ عَلٰی كُلِّ شَیْئٍ قَدِیْرٌ۔"
  }
 ]
}