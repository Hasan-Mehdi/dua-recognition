{
 "dua_id": "duasorg-namaz-e-wahshat",
 "dua_name_en": "Ayatul Kursi",
 "dua_name_ar": "",
 "source": "https://www.duas.org/namaz-e-wahshat.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللَّهُ لَا إِلَهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ"
  },
  {
   "segment_id": 2,
   "arabic": "لَا تَأْخُذُهُ سِنَةٌ وَلَا نَوْمٌ"
  },
  {
   "segment_id": 3,
   "arabic": "لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ"
  },
  {
   "segment_id": 4,
   "arabic": "مَنْ ذَا الَّذِي يَشْفَعُ عِنْدَهُ إِلَّا بِإِذْنِهِ"
  },
  {
   "segment_id": 5,
   "arabic": "يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ"
  },
  {
   "segment_id": 6,
   "arabic": "وَلَا يُحِيطُونَ بِشَيْءٍ مِنْ عِلْمِهِ إِلَّا بِمَا شَاءَ"
  },
  {
   "segment_id": 7,
   "arabic": "وَسِعَ كُرْسِيُّهُ السَّمَاوَاتِ وَالْأَرْضَ"
  },
  {
   "segment_id": 8,
   "arabic": "وَلَا يَئُودُهُ حِفْظُهُمَا"
  },
  {
   "segment_id": 9,
   "arabic": "وَهُوَ الْعَلِيُّ الْعَظِيمُ"
  },
  {
   "segment_id": 10,
   "arabic": "لَا إِكْرَاهَ فِي الدِّينِ"
  },
  {
   "segment_id": 11,
   "arabic": "قَدْ تَبَيَّنَ الرُّشْدُ مِنَ الْغَيِّ"
  },
  {
   "segment_id": 12,
   "arabic": "فَمَنْ يَكْفُرْ بِالطَّاغُوتِ وَيُؤْمِنْ بِاللَّهِ فَقَدِ اسْتَمْسَكَ بِالْعُرْوَةِ الْوُثْقَى"
  },
  {
   "segment_id": 13,
   "arabic": "لَا انْفِصَامَ لَهَا"
  },
  {
   "segment_id": 14,
   "arabic": "وَاللَّهُ سَمِيعٌ عَلِيمٌ"
  },
  {
   "segment_id": 15,
   "arabic": "اللَّهُ وَلِيُّ الَّذِينَ آمَنُوا"
  },
  {
   "segment_id": 16,
   "arabic": "يُخْرِجُهُمْ مِنَ الظُّلُمَاتِ إِلَى النُّورِ"
  },
  {
   "segment_id": 17,
   "arabic": "وَالَّذِينَ كَفَرُوا أَوْلِيَاؤُهُمُ الطَّاغُوتُ يُخْرِجُونَهُمْ مِنَ النُّورِ إِلَى الظُّلُمَاتِ"
  },
  {
   "segment_id": 18,
   "arabic": "أُولَئِكَ أَصْحَابُ النَّارِ"
  },
  {
   "segment_id": 19,
   "arabic": "هُمْ فِيهَا خَالِدُونَ"
  }
 ]
}