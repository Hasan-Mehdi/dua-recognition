{
 "dua_id": "ziyarat-laylatul-qadr",
 "dua_name_en": "Ziyarat Imam Hussain (a) on Laylatul Qadr",
 "dua_name_ar": "",
 "source": "https://www.duaplayer.org/en/ziyarat/laylatul-qadr",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا بْنَ رَسُولِ ٱللَّهِ"
  },
  {
   "segment_id": 4,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا بْنَ امِيرِ ٱلْمُؤْمِنِينَ"
  },
  {
   "segment_id": 5,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا بْنَ ٱلصِّدِّيقَةِ ٱلطَّاهِرَةِ"
  },
  {
   "segment_id": 6,
   "arabic": "فَاطِمَةَ سَيِّدَةِ نِسَاءِ ٱلْعَالَمِينَ"
  },
  {
   "segment_id": 7,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا مَوْلاَيَ يَا ابَا عَبْدِ ٱللَّهِ"
  },
  {
   "segment_id": 8,
   "arabic": "وَرَحْمَةُ ٱللَّهِ وَبَرَكَاتُهُ"
  },
  {
   "segment_id": 9,
   "arabic": "اشْهَدُ انَّكَ قَدْ اقَمْتَ ٱلصَّلاَةَ"
  },
  {
   "segment_id": 10,
   "arabic": "وَآتَيْتَ ٱلزَّكَاةَ"
  },
  {
   "segment_id": 11,
   "arabic": "وَامَرْتَ بِٱلْمَعْرُوفِ"
  },
  {
   "segment_id": 12,
   "arabic": "وَنَهَيْتَ عَنِ ٱلْمُنْكَرِ"
  },
  {
   "segment_id": 13,
   "arabic": "وَتَلَوْتَ ٱلْكِتَابَ حَقَّ تِلاَوَتِهِ"
  },
  {
   "segment_id": 14,
   "arabic": "وَجَاهَدْتَ فِي ٱللَّهِ حَقَّ جِهَادِهِ"
  },
  {
   "segment_id": 15,
   "arabic": "وَصَبَرْتَ عَلَىٰ ٱلاذَىٰ فِي جَنْبِهِ مُحْتَسِباً حَتَّىٰ اتَاكَ ٱلْيَقِينُ"
  },
  {
   "segment_id": 16,
   "arabic": "اشْهَدُ انَّ ٱلَّذِينَ خَالَفُوكَ وَحَارَبُوكَ"
  },
  {
   "segment_id": 17,
   "arabic": "وَٱلَّذِينَ خَذَلُوكَ وَٱلَّذِينَ قَتَلُوكَ"
  },
  {
   "segment_id": 18,
   "arabic": "مَلْعُونُونَ عَلَىٰ لِسَانِ ٱلنَّبِيِّ ٱلامِّيِّ"
  },
  {
   "segment_id": 19,
   "arabic": "وَقَدْ خَابَ مَنِ ٱفْتَرَىٰ"
  },
  {
   "segment_id": 20,
   "arabic": "لَعَنَ ٱللَّهُ ٱلظَّالِمِينَ لَكُمْ مِنَ ٱلاوَّلِينَ وَٱلآخِرِينَ"
  },
  {
   "segment_id": 21,
   "arabic": "وَضَاعَفَ عَلَيْهِمُ ٱلْعَذَابَ ٱلالِيمَ"
  },
  {
   "segment_id": 22,
   "arabic": "اتَيْتُكَ يَا مَوْلايَ يَا بْنَ رَسُولِ ٱللَّهِ"
  },
  {
   "segment_id": 23,
   "arabic": "زَائِراً عَارِفاً بِحَقِّكَ"
  },
  {
   "segment_id": 24,
   "arabic": "مُوَالِياً لاِوْلِيَائِكَ"
  },
  {
   "segment_id": 25,
   "arabic": "مُعَادِياً لاِعْدَائِكَ"
  },
  {
   "segment_id": 26,
   "arabic": "مُسْتَبْصِراً بِٱلْهُدَىٰ ٱلَّذِي انْتَ عَلَيْهِ"
  },
  {
   "segment_id": 27,
   "arabic": "عَارِفاً بِضَلاَلَةِ مَنْ خَالَفَكَ"
  },
  {
   "segment_id": 28,
   "arabic": "فَٱشْفَعْ لِي عِنْدَ رَبِّكَ"
  },
  {
   "segment_id": 29,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا حُجّةَ ٱللَّهِ فِي ارْضِهِ وَسَمَائِهِ"
  },
  {
   "segment_id": 30,
   "arabic": "صَلَّىٰ ٱللَّهُ عَلَىٰ رُوحِكَ ٱلطَّيِّبِ وَجَسَدِكَ ٱلطَّاهِرِ"
  },
  {
   "segment_id": 31,
   "arabic": "وَعَلَيْكَ ٱلسَّلاَمُ يَا مَوْلاَيَ وَرَحْمَةُ ٱللَّهِ وَبَرَكَاتُهُ"
  },
  {
   "segment_id": 32,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا مَوْلاَيَ وَٱبْنَ مَوْلاَيَ"
  },
  {
   "segment_id": 33,
   "arabic": "وَرَحْمَةُ ٱللَّهِ وَبَرَكَاتُهُ"
  },
  {
   "segment_id": 34,
   "arabic": "لَعَنَ ٱللَّهُ مَنْ ظَلَمَكَ"
  },
  {
   "segment_id": 35,
   "arabic": "وَلَعَنَ ٱللَّهُ مَنْ قَتَلَكَ"
  },
  {
   "segment_id": 36,
   "arabic": "وَضَاعَفَ عَلَيْهِمُ ٱلْعَذَابَ ٱلالِيمَ"
  },
  {
   "segment_id": 37,
   "arabic": ""
  },
  {
   "segment_id": 38,
   "arabic": ""
  },
  {
   "segment_id": 39,
   "arabic": "اَلسَّلاَمُ عَلَيْكُمْ ايُّهَا ٱلصِّدِّيقُونَ"
  },
  {
   "segment_id": 40,
   "arabic": "اَلسَّلاَمُ عَلَيْكُمْ ايُّهَا ٱلشُّهَدَاءُ ٱلصَّابِرُونَ"
  },
  {
   "segment_id": 41,
   "arabic": "اشْهَدُ انَّكُمْ جَاهَدْتُمْ فِي سَبِيلِ ٱللَّهِ"
  },
  {
   "segment_id": 42,
   "arabic": "وَصَبَرْتُمْ عَلَىٰ ٱلاذَىٰ فِي جَنْبِ ٱللَّهِ"
  },
  {
   "segment_id": 43,
   "arabic": "وَنَصَحْتُمْ لِلَّهِ وَلِرَسُولِهِ حَتَّىٰ اتَاكُمُ ٱلْيَقِينُ"
  },
  {
   "segment_id": 44,
   "arabic": "اشْهَدُ انّكُمْ احْيَاءٌ عِنْدَ رَبِّكُمْ تُرْزَقُونَ"
  },
  {
   "segment_id": 45,
   "arabic": "فَجَزَاكُمُ ٱللَّهُ عَنِ ٱلإِسْلاَمِ وَاهْلِهِ افْضَلَ جَزَاءِ ٱلْمُحْسِنِينَ"
  },
  {
   "segment_id": 46,
   "arabic": "وَجَمَعَ بَيْنَنَا وَبَيْنَكُمْ فِي مَحَلِّ ٱلنَّعِيمِ"
  },
  {
   "segment_id": 47,
   "arabic": ""
  },
  {
   "segment_id": 48,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا بْنَ امِيرِ ٱلْمُؤْمِنِينَ"
  },
  {
   "segment_id": 49,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ ايُّهَا ٱلْعَبْدُ ٱلصَّالِحُ"
  },
  {
   "segment_id": 50,
   "arabic": "ٱلْمُطِيعُ لِلَّهِ وَلِرَسُولِهِ"
  },
  {
   "segment_id": 51,
   "arabic": "اشْهَدُ انَّكَ قَدْ جَاهَدْتَ وَنَصَحْتَ"
  },
  {
   "segment_id": 52,
   "arabic": "وَصَبَرْتَ حَتَّىٰ اتَاكَ ٱلْيَقِينُ"
  },
  {
   "segment_id": 53,
   "arabic": "لَعَنَ ٱللَّهُ ٱلظَّالِمِينَ لَكُمْ مِنَ ٱلاوَّلِينَ وَٱلآخِرِينَ"
  },
  {
   "segment_id": 54,
   "arabic": "وَالْحَقَهُمْ بِدَرْكِ ٱلْجَحِيمِ"
  }
 ]
}