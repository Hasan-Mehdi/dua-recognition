{
 "dua_id": "sahifa-02",
 "dua_name_en": "Sahifa 2: Blessings upon God's messenger",
 "dua_name_ar": "الصَّلَاةُ عَلَى مُحَمَّدٍ وَ آلِهَ",
 "source": "https://duas.pro/2-blessings-upon-gods-messenger",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "وَالْحَمْدُ للهِ الَّذِي مَنَّ عَلَيْنَا بِمُحَمَّدٍ نَبِيِّهِ صَلَّى اللَّهُ عَلَيْهِ وَ آلِهِ"
  },
  {
   "segment_id": 2,
   "arabic": "دُونَ ٱلْاُمَمِ ٱلْمَاضِيَةِ وَٱلْقُـرُونِ السَّالِفَةِ،"
  },
  {
   "segment_id": 3,
   "arabic": "بِقُدْرَتِهِ الَّتِي لَا تَعْجِزُ عَنْ شَيْ‏ءٍ وَ إِنْ عَظُمَ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَ لا يَفُوتُهَا شَيءٌ وَإنْ لَطُفَ،"
  },
  {
   "segment_id": 5,
   "arabic": "فَخَتَمَ بِنَاعَلَى جَمِيع مَنْ ذَرَأَ،"
  },
  {
   "segment_id": 6,
   "arabic": "وَ جَعَلَنَا شُهَدَاءَ عَلَى مَنْ جَحَدَ،"
  },
  {
   "segment_id": 7,
   "arabic": "وَكَثَّرَنا بِمَنِّهِ عَلَى مَنْ قَلَّ."
  },
  {
   "segment_id": 8,
   "arabic": "اللَّهُمَّ فَصَلِّ عَلَى مُحَمَّدٍ أَمِينِكَ عَلَى وَحْيِكَ،"
  },
  {
   "segment_id": 9,
   "arabic": "وَنَجِيبِكَ مِنْ خَلْقِكَ،"
  },
  {
   "segment_id": 10,
   "arabic": "وَ صَفِيِّكَ مِنْ عِبَادِكَ،"
  },
  {
   "segment_id": 11,
   "arabic": "إمَامِ الرَّحْمَةِ وَقَائِدِ الْخَيْرِ،"
  },
  {
   "segment_id": 12,
   "arabic": "وَ مِفْتَاحِ الْبَرَكَةِ،"
  },
  {
   "segment_id": 13,
   "arabic": "كَمَا نَصَبَ لِأَمْرِكَ نَفْسَهُ،"
  },
  {
   "segment_id": 14,
   "arabic": "وَ عَرَّضَ فِيْكَ لِلْمَكْرُوهِ بَدَنَهُ،"
  },
  {
   "segment_id": 15,
   "arabic": "وَكَاشَفَ فِي الدُّعَآءِ إلَيْكَ حَامَّتَهُ،"
  },
  {
   "segment_id": 16,
   "arabic": "وَحَارَبَ فِي رِضَاكَ أسْرَتَهُ،"
  },
  {
   "segment_id": 17,
   "arabic": "وَقَطَعَ فِىْ إحْياءِ دِينِكَ رَحِمَهُ،"
  },
  {
   "segment_id": 18,
   "arabic": "وَ أَقْصَى الْأَدْنَيْنَ عَلَى جُحُودِهِمْ،"
  },
  {
   "segment_id": 19,
   "arabic": "وَ قَرَّبَ الْأَقْصَيْنَ عَلَى اسْتِجَابَتِهِمْ لَكَ،"
  },
  {
   "segment_id": 20,
   "arabic": "وَ وَالَى فِيكَ الْأَبْعَدِينَ،"
  },
  {
   "segment_id": 21,
   "arabic": "وَ عَادَى فِيكَ الْأَقْرَبِينَ."
  },
  {
   "segment_id": 22,
   "arabic": "وَ أَدْأَبَ نَفْسَهُ فِي تَبْلِيغِ رِسَالَتِكَ،"
  },
  {
   "segment_id": 23,
   "arabic": "وَأَتْعَبَهَا بِالدُّعآءِ إِلٰى مِلَّتِكَ،"
  },
  {
   "segment_id": 24,
   "arabic": "وَ شَغَلَهَا بِالنُّصْحِ لِأَهْلِ دَعْوَتِكَ،"
  },
  {
   "segment_id": 25,
   "arabic": "وَهَاجَرَ إِلٰى بِلاَدِ الْغُرْبَةِ،"
  },
  {
   "segment_id": 26,
   "arabic": "وَمَحَلِّ النَّأْيِ عَنْ مَوْطِنِ رَحْلِهِ،"
  },
  {
   "segment_id": 27,
   "arabic": "وَمَوْضِـعِ رِجْلِهِ وَ مَسْقَطِ رَأْسِهِ،"
  },
  {
   "segment_id": 28,
   "arabic": "وَمَأْنَسِ نَفْسِهِ،"
  },
  {
   "segment_id": 29,
   "arabic": "إِرَادَةً مِنْهُ لِإِعْزَازِ دِينِكَ،"
  },
  {
   "segment_id": 30,
   "arabic": "واسْتِنْصَاراً عَلَى أَهْلِ الْكُفْرِ بِكَ،"
  },
  {
   "segment_id": 31,
   "arabic": "حَتَّى ٱسْتَتَبَّ لَهُ مَا حَاوَلَ فِي أَعْدَائِكَ،"
  },
  {
   "segment_id": 32,
   "arabic": "وَاسْتَتَمَّ لَهُ مَا دَبَّرَ فِي أَوْلِيآئِكَ،"
  },
  {
   "segment_id": 33,
   "arabic": "فَنَهَدَ إلَيْهِمْ مُسْتَفْتِحاً بِعَوْنِكَ،"
  },
  {
   "segment_id": 34,
   "arabic": "وَمُتَقَوِّياً عَلَى ضَعْفِهِ بِنَصْرِكَ،"
  },
  {
   "segment_id": 35,
   "arabic": "فَغَزَاهُمْ فِي عُقْرِ دِيَارِهِمْ،"
  },
  {
   "segment_id": 36,
   "arabic": "وَهَجَمَ عَلَيْهِمْ فِي بُحْبُوحَةِ قَرَارِهِمْ،"
  },
  {
   "segment_id": 37,
   "arabic": "حَتَّى ظَهَرَ أَمْرُكَ وَعَلَتْ كَلِمَتُكَ وَلَوْ كَرِهَ الْمُشْرِكُونَ."
  },
  {
   "segment_id": 38,
   "arabic": "اَللَّهُمَّ فَارْفَعْهُ بِمَا كَدَحَ فِيكَ إِلٰى الدَّرَجَةِ الْعُلْيَا مِنْ جَنَّتِكَ،"
  },
  {
   "segment_id": 39,
   "arabic": "حَتَّى لاَ يُسَاوَى فِي مَنْزِلَةٍ،"
  },
  {
   "segment_id": 40,
   "arabic": "وَلا يُكَاْفَأَ فِي مَرْتَبَةٍ،"
  },
  {
   "segment_id": 41,
   "arabic": "وَلَا يُوَازِيَهُ لَدَيْكَ مَلَكٌ مُقَرَّبٌ وَلَا نَبِيٌّ مُرْسَلٌ."
  },
  {
   "segment_id": 42,
   "arabic": "وَعَرِّفْهُ فِي أَهْلِهِ الطَّاهِرِينَ وَاُمَّتِهِ الْمُؤْمِنِينَ مِنْ حُسْنِ الشَّفَاعَةِ،"
  },
  {
   "segment_id": 43,
   "arabic": "أَجَلَّ مَا وَعَدْتَهُ،"
  },
  {
   "segment_id": 44,
   "arabic": "يَا نَافِذَ الْعِدَةِ،"
  },
  {
   "segment_id": 45,
   "arabic": "يَا وَافِىَ الْقَوْلِ،"
  },
  {
   "segment_id": 46,
   "arabic": "يَا مُبَدِّلَ السَّيِّئَاتِ بِأَضْعَافِهَا مِنَ الْحَسَنَاتِ،"
  },
  {
   "segment_id": 47,
   "arabic": "إنَّكَ ذُو الْفَضْلِ الْعَظِيمِ الْجَوَادُ اَلْكَرِيمُ."
  }
 ]
}