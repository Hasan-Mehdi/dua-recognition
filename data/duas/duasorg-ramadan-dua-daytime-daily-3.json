{
 "dua_id": "duasorg-ramadan-dua-daytime-daily-3",
 "dua_name_en": "Dua hadha shahr",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-dua-daytime-daily.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللَّهُمَّ هٰذَا شَهْرُ رَمَضَانَ"
  },
  {
   "segment_id": 2,
   "arabic": "ٱلَّذِي أَنْزَلْتَ فِيهِ القُرْآنَ"
  },
  {
   "segment_id": 3,
   "arabic": "هُدَىً لِلنَّاسِ وَبَيِّنَاتٍ مِنَ ٱلْهُدَىٰ وَٱلفُرْقَانِ"
  },
  {
   "segment_id": 4,
   "arabic": "وَهٰذَا شَهْرُ ٱلصِّيَامِ"
  },
  {
   "segment_id": 5,
   "arabic": "وَهٰذَا شَهْرُ ٱلْقِيَامِ"
  },
  {
   "segment_id": 6,
   "arabic": "وَهٰذَا شَهْرُ ٱلإِنَابَةِ"
  },
  {
   "segment_id": 7,
   "arabic": "وَهٰذَا شَهْرُ ٱلتَّوْبَةِ"
  },
  {
   "segment_id": 8,
   "arabic": "وَهٰذَا شَهْرُ ٱلْمَغْفِرَةِ وَٱلرَّحْمَةِ"
  },
  {
   "segment_id": 9,
   "arabic": "وَهٰذَا شَهْرُ ٱلْعِتْقِ مِنَ ٱلنَّارِ وَٱلْفَوْزِ بِٱلْجَنَّةِ"
  },
  {
   "segment_id": 10,
   "arabic": "وَهٰذَا شَهْرٌ فِيهِ لَيْلَةُ ٱلْقَدْرِ"
  },
  {
   "segment_id": 11,
   "arabic": "ٱلَّتِي هِيَ خَيْرٌ مِنَ أَلْفِ شَهْرٍ"
  },
  {
   "segment_id": 12,
   "arabic": "اَللَّهُمَّ فَصَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 13,
   "arabic": "وَأَعِنِّي عَلَىٰ صِيَامِهِ وَقِيَامِهِ"
  },
  {
   "segment_id": 14,
   "arabic": "وَسَلِّمْهُ لِي وَسَلِّمْنِي فِيهِ"
  },
  {
   "segment_id": 15,
   "arabic": "وَأَعِنِّي عَلَيْهِ بِأَ فْضَلِ عَوْنِكَ"
  },
  {
   "segment_id": 16,
   "arabic": "وَوَفِّقْنِي فِيهِ لِطَاعَتِكَ وَطَاعَةِ رَسُولِكَ وَأَوْلِيَائِكَ"
  },
  {
   "segment_id": 17,
   "arabic": "صَلَّىٰ ٱللَّهُ عَلَيْهِمْ"
  },
  {
   "segment_id": 18,
   "arabic": "وَفَرِّغْنِي فِيهِ لِعِبَادَتِكَ وَدُعَائِكَ وَتِلاوَةِ كِتَابِكَ"
  },
  {
   "segment_id": 19,
   "arabic": "وَأَعْظِمْ لِي فِيهِ ٱلبَرَكَةَ"
  },
  {
   "segment_id": 20,
   "arabic": "وَأَحْسِنْ لِي فِيهِ ٱلعَافِيَةَ"
  },
  {
   "segment_id": 21,
   "arabic": "وَأَصِحَّ فِيهِ بَدَنِي"
  },
  {
   "segment_id": 22,
   "arabic": "وَأَوْسِعْ فِيهِ رِزْقِي"
  },
  {
   "segment_id": 23,
   "arabic": "وَٱكْفِنِي فِيهِ مَا أَهَمَّنِي"
  },
  {
   "segment_id": 24,
   "arabic": "وَٱسْتَجِبْ فِيهِ دُعَائِي"
  },
  {
   "segment_id": 25,
   "arabic": "وَبَلِّغْنِي فِيهِ رَجَائِي"
  },
  {
   "segment_id": 26,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 27,
   "arabic": "وَأَذْهِبْ عَنِّي فِيهِ ٱلنُّعَاسَ وَٱلْكَسَلَ وَٱلسَّأْمَةَ"
  },
  {
   "segment_id": 28,
   "arabic": "وَٱلْفَتْرَةَ وَٱلْقَسْوَةَ وَٱلْغَفْلَةَ وَٱلْغِرَّةَ"
  },
  {
   "segment_id": 29,
   "arabic": "وَجَنِّبْنِي فِيهِ ٱلْعِلَلَ وَٱلأَسْقَامَ"
  },
  {
   "segment_id": 30,
   "arabic": "وَٱلْهُمُومَ وَٱلأَحْزَانَ"
  },
  {
   "segment_id": 31,
   "arabic": "وَٱلأَعْرَاضَ وَٱلأَمْرَاضَ"
  },
  {
   "segment_id": 32,
   "arabic": "وَٱلْخَطَايَا وَٱلذُّنُوبَ"
  },
  {
   "segment_id": 33,
   "arabic": "وَٱصْرِفْ عَنِّي فِيهِ ٱلسُّوءَ وَٱلْفَحْشَاءَ"
  },
  {
   "segment_id": 34,
   "arabic": "وَٱلْجَهْدَ وَٱلْبَلاَءَ"
  },
  {
   "segment_id": 35,
   "arabic": "وَٱلتَّعَبَ وَٱلْعَنَاءَ"
  },
  {
   "segment_id": 36,
   "arabic": "إِنَّكَ سَمِيعُ ٱلدُّعَاءِ"
  },
  {
   "segment_id": 37,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 38,
   "arabic": "وَأَعِذْنِي فِيهِ مِنَ ٱلشَّيْطَانِ ٱلرَّجِيمِ"
  },
  {
   "segment_id": 39,
   "arabic": "وَهَمْزِهِ وَلَمْزِهِ وَنَفْثِهِ وَنَفْخِهِ"
  },
  {
   "segment_id": 40,
   "arabic": "وَوَسْوَسَتِهِ وَتَثْبِيطِهِ وَبَطْشِهِ وَكَيْدِهِ"
  },
  {
   "segment_id": 41,
   "arabic": "وَمَكْرِهِ وَحَبَائِلِهِ وَخُدَعِهِ وَأَمَانِيِّهِ"
  },
  {
   "segment_id": 42,
   "arabic": "وَغُرُورِهِ وَفِتْنَتِهِ وَشَرَكِهِ وَأَحْزَابِهِ"
  },
  {
   "segment_id": 43,
   "arabic": "وَأَتْبَاعِهِ وَأَشْيَاعِهِ وَأَوْلِيَائِهِ وَشُرَكَائِهِ"
  },
  {
   "segment_id": 44,
   "arabic": "وَجَمِيعِ مَكَائِدِهِ"
  },
  {
   "segment_id": 45,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 46,
   "arabic": "وَٱرْزُقْنَا قِيَامَهُ وَصِيَامَهُ"
  },
  {
   "segment_id": 47,
   "arabic": "وَبُلُوغَ ٱلأَمَلِ فِيهِ وَفِي قِيَامِهِ"
  },
  {
   "segment_id": 48,
   "arabic": "وَٱسْتِكْمَالَ مَا يُرْضِيكَ عَنِّي"
  },
  {
   "segment_id": 49,
   "arabic": "صَبْراً وَاحْتِسَاباً وَإِيـمَاناً وَيَقِيناً"
  },
  {
   "segment_id": 50,
   "arabic": "ثُمَّ تَقَبَّلْ ذٰلِكَ مِنِّي بِٱلأَضْعَافِ ٱلْكَثِيرَةِ"
  },
  {
   "segment_id": 51,
   "arabic": "وَٱلأَجْرِ ٱلْعَظِيمِ"
  },
  {
   "segment_id": 52,
   "arabic": "يَا رَبَّ ٱلعَالَمِينَ"
  },
  {
   "segment_id": 53,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 54,
   "arabic": "وَٱرْزُقْنِي ٱلْحَجَّ وَٱلْعُمْرَةَ"
  },
  {
   "segment_id": 55,
   "arabic": "وَٱلْجِدَّ وَٱلاِجْتِهَادَ"
  },
  {
   "segment_id": 56,
   "arabic": "وَٱلْقُوَّةَ وَٱلنَّشَاطَ"
  },
  {
   "segment_id": 57,
   "arabic": "وَٱلإِنَابَةَ وَٱلتَّوْبَةَ"
  },
  {
   "segment_id": 58,
   "arabic": "وَٱلتَّوْفِيقَ وَٱلْقُرْبَةَ"
  },
  {
   "segment_id": 59,
   "arabic": "وَٱلْخَيْرَ ٱلْمَقْبُولَ وَٱلرَّغْبَةَ وَٱلرَّهْبَةَ"
  },
  {
   "segment_id": 60,
   "arabic": "وَٱلتَّضَرُّعَ وَٱلْخُشُوعَ"
  },
  {
   "segment_id": 61,
   "arabic": "وَٱلرِّقَّةَ وَٱلنِّيَّةَ ٱلصَّادِقَةَ"
  },
  {
   "segment_id": 62,
   "arabic": "وَصِدْقَ ٱللِّسَانِ"
  },
  {
   "segment_id": 63,
   "arabic": "وَٱلْوَجَلَ مِنْكَ"
  },
  {
   "segment_id": 64,
   "arabic": "وَٱلرَّجَاءَ لَكَ"
  },
  {
   "segment_id": 65,
   "arabic": "وَٱلتَّوَكًُّلَ عَلَيْكَ"
  },
  {
   "segment_id": 66,
   "arabic": "وَٱلثَِّقَةَ بِكَ"
  },
  {
   "segment_id": 67,
   "arabic": "وَٱلْوَرَعَ عَنْ مَحَارِمِكَ"
  },
  {
   "segment_id": 68,
   "arabic": "مَعَ صَالِحِ ٱلْقَوْلِ"
  },
  {
   "segment_id": 69,
   "arabic": "وَمَقْبُولِ ٱلسَّعْيِ"
  },
  {
   "segment_id": 70,
   "arabic": "وَمَرْفُوعِ ٱلْعَمَلِ"
  },
  {
   "segment_id": 71,
   "arabic": "وَمُسْتَجَابِ ٱلدَّعْوَةِ"
  },
  {
   "segment_id": 72,
   "arabic": "وَلاَ تَحُلْ بَيْنِي وَبَيْنَ شَيْءٍ مِنْ ذٰلِكَ"
  },
  {
   "segment_id": 73,
   "arabic": "بِعَرَضٍ وَلاَ مَرَضٍ"
  },
  {
   "segment_id": 74,
   "arabic": "وَلاَ هَمٍّ وَلاَ غَمٍّ"
  },
  {
   "segment_id": 75,
   "arabic": "وَلاَ سُقْمٍ وَلاَ غَفْلَةٍ وَلاَ نِسْيَانٍ"
  },
  {
   "segment_id": 76,
   "arabic": "بَلْ بِٱلتَّعَاهُدِ وَٱلتَّحَفُّظِ لَكَ وَفِيكَ"
  },
  {
   "segment_id": 77,
   "arabic": "وَٱلرِّعَايَةِ لِحَقِّكَ وَٱلْوَفَاءِ بِعَهْدِكَ وَوَعْدِكَ"
  },
  {
   "segment_id": 78,
   "arabic": "بِرَحْمَتِكَ يَا أَرْحَمَ ٱلرَّاحِمِينَ"
  },
  {
   "segment_id": 79,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 80,
   "arabic": "وَٱقْسِمْ لِي فِيهِ أَفْضَلَ مَا تَقْسِمُهُ لِعِبَادِكَ ٱلصَّالِحِينَ"
  },
  {
   "segment_id": 81,
   "arabic": "وَأَعْطِنِي فِيهِ أَفْضَلَ مَا تُعْطِي أَوْلِيَاءَكَ ٱلْمُقَرَّبِينَ"
  },
  {
   "segment_id": 82,
   "arabic": "مِنَ ٱلرَّحْمَةِ وَٱلْمَغْفِرَةِ وَٱلتَّحَنُّنِ وَٱلإِجَابَةِ"
  },
  {
   "segment_id": 83,
   "arabic": "وَٱلْعَفْوِ وَٱلْمَغْفِرَةِ ٱلدَّائِمَةِ وَٱلْعَافِيَةِ وَٱلْمُعَافَاةِ"
  },
  {
   "segment_id": 84,
   "arabic": "وَٱلْعِتْقِ مِنَ ٱلنَّارِ وَٱلْفَوْزِ بِٱلْجَنَّةِ"
  },
  {
   "segment_id": 85,
   "arabic": "وَخَيْرِ ٱلدُّنْيَا وَٱلآخِرَةِ"
  },
  {
   "segment_id": 86,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 87,
   "arabic": "وَٱجْعَلْ دُعَائِي فِيهِ إِلَيْكَ وَاصِلاً"
  },
  {
   "segment_id": 88,
   "arabic": "وَرَحْمَتَكَ وَخَيْرَكَ إِلَيَّ فِيهِ نَازِلاً"
  },
  {
   "segment_id": 89,
   "arabic": "وَعَمَلِي فِيهِ مَقْبُولاً"
  },
  {
   "segment_id": 90,
   "arabic": "وَسَعْيِي فِيهِ مَشْكُوراً"
  },
  {
   "segment_id": 91,
   "arabic": "وَذَنْبِي فِيهِ مَغْفُوراً"
  },
  {
   "segment_id": 92,
   "arabic": "حَتَّىٰ يَكُونَ نَصِيبِي فِيهِ ٱلأَكْثَرُ"
  },
  {
   "segment_id": 93,
   "arabic": "وَحَظِّي فِيهِ ٱلأَوْفَرُ"
  },
  {
   "segment_id": 94,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 95,
   "arabic": "وَوَفِّقْنِي فِيهِ لِلَيْلَةِ ٱلقَدْرِ"
  },
  {
   "segment_id": 96,
   "arabic": "عَلَىٰ أَفْضَلِ حَالٍ تُحِبُّ أَنْ يَكُونَ عَلَيْهَا أَحَدٌ مِنْ أَوْلِيَائِكَ وَأَرْضَاهَا لَكَ"
  },
  {
   "segment_id": 97,
   "arabic": "ثُمَّ ٱجْعَلْهَا لِي خَيْراً مِنَ أَلْفِ شَهْرٍ"
  },
  {
   "segment_id": 98,
   "arabic": "وَٱرْزُقْنِي فِيهَا أَفْضَلَ مَا رَزَقْتَ أَحَداً مِمَّنْ بَلَّغْتَهُ إِيَّاهَا وَأَكْرَمْتَهُ بِهَا"
  },
  {
   "segment_id": 99,
   "arabic": "وَٱجْعَلْنِي فِيهَا مِنْ عُتَقَائِكَ مِنْ جَهَنَّمَ"
  },
  {
   "segment_id": 100,
   "arabic": "وَطُلَقَائِكَ مِنَ ٱلنَّارِ"
  },
  {
   "segment_id": 101,
   "arabic": "وَسُعَدَاءِ خَلْقِكَ بِمَغْفِرَتِكَ وَرِضْوَانِكَ"
  },
  {
   "segment_id": 102,
   "arabic": "يَا أَرْحَمَ ٱلرَّاحِمِينَ"
  },
  {
   "segment_id": 103,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 104,
   "arabic": "وَٱرْزُقْنَا فِي شَهْرِنَا هٰذَا ٱلجِدَّ وَٱلإِجْتِهَادَ"
  },
  {
   "segment_id": 105,
   "arabic": "وَٱلقُوَّةَ وَٱلنَّشَاطَ"
  },
  {
   "segment_id": 106,
   "arabic": "وَمَا تُحِبُّ وَتَرْضَىٰ"
  },
  {
   "segment_id": 107,
   "arabic": "اَللَّهُمَّ رَبَّ ٱلفَجْرِ وَلَيَالٍ عَشْرٍ وَٱلشَّفْعِ وَٱلْوَتْرِ"
  },
  {
   "segment_id": 108,
   "arabic": "وَرَبَّ شَهْرِ رَمَضَانَ وَمَا أَنْزَلْتَ فِيهِ مِنَ ٱلْقُرْآنِ"
  },
  {
   "segment_id": 109,
   "arabic": "وَرَبَّ جَبْرَائِيلَ وَمِيكَائِيلَ وَإِسْرَافِيلَ وَعِزْرَائِيلَ"
  },
  {
   "segment_id": 110,
   "arabic": "وَجَمِيعِ ٱلْمَلاَئِكَةِ ٱلْمُقَرَّبِينَ"
  },
  {
   "segment_id": 111,
   "arabic": "وَرَبَّ إِبْرَاهِيمَ وَإِسْمَاعِيلَ"
  },
  {
   "segment_id": 112,
   "arabic": "وَإِسْحَاقَ وَيَعْقُوبَ"
  },
  {
   "segment_id": 113,
   "arabic": "وَرَبَّ مُوسَىٰ وَعِيسَىٰ"
  },
  {
   "segment_id": 114,
   "arabic": "وَجَمِيعِ ٱلنَّبِيِّينَ وَٱلْمُرْسَلِينَ"
  },
  {
   "segment_id": 115,
   "arabic": "وَرَبَّ مُحَمَّدٍ خَاتَمِ ٱلنَّبِيِّينَ"
  },
  {
   "segment_id": 116,
   "arabic": "صَلَوَاتُكَ عَلَيْهِ وَعَلَيْهِمْ أَجْمَعِينَ"
  },
  {
   "segment_id": 117,
   "arabic": "وَأَسْأَلُكَ بِحَقِّكَ عَلَيْهِمْ وَبِحَقِّهِمْ عَلَيْكَ"
  },
  {
   "segment_id": 118,
   "arabic": "وَبِحَقِّكَ ٱلْعَظِيمِ لَمَّا صَلَّيْتَ عَلَيْهِ وَآلِهِ وَعَلَيْهِمْ أَجْمَعِينَ"
  },
  {
   "segment_id": 119,
   "arabic": "وَنَظَرْتَ إِلَيَّ نَظْرَةً رَحِيمَةً"
  },
  {
   "segment_id": 120,
   "arabic": "تَرْضَىٰ بِهَا عَنِّي رِضَىً لاَ سَخَطَ عَلَيَّ بَعْدَهُ أَبَداً"
  },
  {
   "segment_id": 121,
   "arabic": "وَأَعْطَيْتَنِي جَمِيعَ سُؤْلِي وَرَغْبَتِي وَأُمْنِيَتِي وَإِرَادَتِي"
  },
  {
   "segment_id": 122,
   "arabic": "وَصَرَفْتَ عَنِّي مَا أَكْرَهُ وَأَحْذَرُ"
