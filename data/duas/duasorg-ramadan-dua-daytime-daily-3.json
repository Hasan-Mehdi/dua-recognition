   "arabic": "وَٱغْفِرْ لِي ذُنُوبِي وَعُيُوبِي"
  },
  {
   "segment_id": 151,
   "arabic": "وَإِسَاءَتِي وَظُلْمِي وَجُرْمِي"
  },
