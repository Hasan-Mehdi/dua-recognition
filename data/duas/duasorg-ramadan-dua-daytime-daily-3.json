   "segment_id": 124,
   "arabic": "وَعَنْ أَهْلِي وَمَالِي وَإِخْوَانِي وَذُرِّيَّتِي"
  },
  {
   "segment_id": 125,
   "arabic": "اللَّهُمُّ إِلَيْكَ فَرَرْنَا مِنْ ذُنُوبِنَا فَآوِنَا تَائِبِينَ"
  },
  {
   "segment_id": 126,
   "arabic": "وَتُبْ عَلَيْنَا مُسْتَغْفِرِينَ"
  },
  {
   "segment_id": 127,
   "arabic": "وَٱغْفِرْ لَنَا مُتَعَوّذِينَ"
