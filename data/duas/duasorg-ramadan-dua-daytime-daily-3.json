   "arabic": "وَأَجِرْنَا مُسْتَسْلِمِينَ"
  },
  {
   "segment_id": 130,
   "arabic": "وَلاَ تَخْذُلْنَا رَاهِبِينَ"
  },
  {
   "segment_id": 131,
   "arabic": "وَآمِنَّا رَاغِبِينَ"
  },
