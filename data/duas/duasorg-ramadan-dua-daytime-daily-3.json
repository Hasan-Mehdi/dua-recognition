  {
   "segment_id": 187,
   "arabic": "تَنَزَّلَ ٱلْمَلائِكَةِ وَٱلرُّوْحِ فِيهَا"
  },
  {
   "segment_id": 188,
   "arabic": "فَأَخِّرْنِي إِلَىٰ ذٰلِكَ"
