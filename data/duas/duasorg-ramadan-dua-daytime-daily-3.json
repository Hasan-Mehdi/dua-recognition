   "arabic": "وَيَا فَارِجَ هَمِّ ٱلْمَهْمُومِينَ"
  },
  {
   "segment_id": 146,
   "arabic": "وَيَا كَاشِفَ ٱلْكَرْبِ ٱلْعَظِيمِ"
  },
  {
   "segment_id": 147,
   "arabic": "يَا اللَّهُ يَا رَحْمٰنُ يَا رَحِيمُ"
  },
  {
   "segment_id": 148,
   "arabic": "يَا أَرْحَمَ ٱلرَّاحِمِينَ"
  },
