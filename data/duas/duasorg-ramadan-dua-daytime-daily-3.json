   "arabic": "يَا لاَ إِلٰهَ إِلاَّ أَنْتَ"
  },
  {
   "segment_id": 216,
   "arabic": "بِحَقِّ لاَ إِلٰهَ إِلاَّ أَنْتَ"
  },
