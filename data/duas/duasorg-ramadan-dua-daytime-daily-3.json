   "arabic": "يَا رَبَّ مُحَمَّدٍ"
  },
  {
   "segment_id": 195,
   "arabic": "إِغْضَبِ ٱليَوْمَ لِمُحَمَّدٍ وَلأَبْرَارِ عِتْرَتِهِ"
  },
  {
   "segment_id": 196,
   "arabic": "وَٱقْتُلْ أَعْدَاءَهُمْ بَدَداً"
  },
