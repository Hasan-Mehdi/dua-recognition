  },
  {
   "segment_id": 143,
   "arabic": "وَيَا رَبّ ٱلْمُسْتَضْعَفِينَ"
  },
  {
   "segment_id": 144,
   "arabic": "وَيَا كَاشِفَ كَرْبِ ٱلْمَكْرُوبِينَ"
