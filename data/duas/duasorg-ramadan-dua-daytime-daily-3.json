   "arabic": "وَآتِنِي فِي ٱلدُّنْيَا حَسَنَةً وَفِي ٱلآخِرَةِ حَسَنَةً"
  },
  {
   "segment_id": 185,
   "arabic": "وَقِنِي عَذَابَ ٱلنَّارِ"
  },
