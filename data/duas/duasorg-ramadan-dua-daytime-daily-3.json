   "arabic": "وَأَنْ تَهَبَ لِي يَقِيناً تُبَاشِرُ بِهِ قَلْبِي"
  },
  {
   "segment_id": 182,
   "arabic": "وَإِيـمَاناً لاَ يَشُوبُهُ شَكٌّ"
  },
  {
