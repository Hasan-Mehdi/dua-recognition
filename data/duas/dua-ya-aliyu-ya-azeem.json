{
 "dua_id": "dua-ya-aliyu-ya-azeem",
 "dua_name_en": "Dua Ya Aliyu Ya Azeem",
 "dua_name_ar": "دعاء يَا عَلِيُّ يَا عَظِيمُ",
 "source": "https://www.duaplayer.org/en/dua/ya-aliyu-ya-azeem",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "يَا عَلِيُّ يَا عَظِيمُ،"
  },
  {
   "segment_id": 4,
   "arabic": "يَا غَفُورُ يَا رَحِيمُ،"
  },
  {
   "segment_id": 5,
   "arabic": "أَنْتَ الرَّبُّ الْعَظِيمُ"
  },
  {
   "segment_id": 6,
   "arabic": "الَّذِي لَيْسَ كَمِثْلِهِ شَيْءٌ"
  },
  {
   "segment_id": 7,
   "arabic": "وَهُوَ السَّمِيعُ الْبَصِيرُ،"
  },
  {
   "segment_id": 8,
   "arabic": "وَهذَا شَهْرٌ عَظَّمْتَهُ وَكَرَّمْتَهُ"
  },
  {
   "segment_id": 9,
   "arabic": "وَشَرَّفْتَهُ وَفَضَّلْتَهُ عَلَى الشُّهُورِ،"
  },
  {
   "segment_id": 10,
   "arabic": "وَهُوَ الشَّهْرُ الَّذِي فَرَضْتَ صِيَامَهُ عَلَيَّ،"
  },
  {
   "segment_id": 11,
   "arabic": "وَهُوَ شَهْرُ رَمَضَانَ الَّذِي أَنْزَلْتَ فِيهِ الْقُرْآنَ"
  },
  {
   "segment_id": 12,
   "arabic": "هُدَىً لِلنَّاسِ وَبَيِّنَاتٍ مِنَ الْهُدَى وَالْفُرْقَانِ"
  },
  {
   "segment_id": 13,
   "arabic": "وَجَعَلْتَ فِيهِ لَيْلَةَ الْقَدْرِ"
  },
  {
   "segment_id": 14,
   "arabic": "وَجَعَلْتَهَا خَيْراً مِنْ أَلْفِ شَهْرٍ،"
  },
  {
   "segment_id": 15,
   "arabic": "فَيَا ذَا الْمَنِّ وَلا يُمَنُّ عَلَيْكَ"
  },
  {
   "segment_id": 16,
   "arabic": "مُنَّ عَلَيَّ بِفَكَاكِ رَقَبَتِي مِنَ النَّارِ فِي مَنْ تَمُنُّ عَلَيْهِ"
  },
  {
   "segment_id": 17,
   "arabic": "وَأَدْخِلْنِي الْجَنَّةَ"
  },
  {
   "segment_id": 18,
   "arabic": "بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِينَ."
  }
 ]
}