{
 "dua_id": "blessings-on-bearers-of-throne-and-angels",
 "dua_name_en": "Blessings On Bearers Of Throne And Angels",
 "dua_name_ar": "الصَّلَاةُ عَلَى حَمَلَةِ الْعَرْشِ و كلّ مَلَكٍ مقرّبٍَ",
 "source": "https://duas.pro/blessings-on-bearers-of-throne-and-angels",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللَّهُمَّ وَحَمَلَةُ عَرْشِكَ الَّذِينَ لا يَفْتُرُونَ مِنْ تَسْبِيحِكَ،"
  },
  {
   "segment_id": 2,
   "arabic": "وَلا يَسْـأَمُـونَ مِنْ تَقْـدِيْسِكَ،"
  },
  {
   "segment_id": 3,
   "arabic": "وَلا يَسْتَحسِرُونَ مِنْ عِبَادَتِكَ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَلاَ يُؤْثِرُونَ التَّقْصِيرَ عَلَى الْجِدِّ فِي أَمْرِكَ،"
  },
  {
   "segment_id": 5,
   "arabic": "وَلا يَغْفُلُونَ عَنِ الْوَلَهِ إلَيْكَ."
  },
  {
   "segment_id": 6,
   "arabic": "وَمِيكَآئِيلُ ذُو الْجَاهِ عِنْدَكَ،"
  },
  {
   "segment_id": 7,
   "arabic": "وَالْمَكَانِ الرَّفِيعِ مِنْ طَاعَتِكَ."
  },
  {
   "segment_id": 8,
   "arabic": "وَجِبْريلُ الامِينُ عَلَى وَحْيِكَ،"
  },
  {
   "segment_id": 9,
   "arabic": "الْمُطَاعُ فِي أَهْلِ سَمَاوَاتِكَ،"
  },
  {
   "segment_id": 10,
   "arabic": "الْمَكِينُ لَدَيْكَ، الْمُقَرَّبُ عِنْدَكَ،"
  },
  {
   "segment_id": 11,
   "arabic": "وَالرُّوحُ الَّذِي هُوَ عَلَى مَلائِكَةِ الْحُجُبِ،"
  },
  {
   "segment_id": 12,
   "arabic": "وَالرُّوحُ الَّذِي هُوَ مِنْ أَمْرِكَ."
  },
  {
   "segment_id": 13,
   "arabic": "أَللَّهُمَّ فَصَلِّ عليهم وَعَلَى الْمَلاَئِكَـةِ الَّذِينَ مِنْ دُونِهِمْ"
  },
  {
   "segment_id": 14,
   "arabic": "مِنْ سُكَّـانِ سَمَاوَاتِكَ وَأَهْلِ الامَانَةِ عَلَى رِسَالاَتِكَ،"
  },
  {
   "segment_id": 15,
   "arabic": "وَالَّذِينَ لا تَدْخُلُهُمْ سَأْمَةٌ مِنْ دؤُوب ،"
  },
  {
   "segment_id": 16,
   "arabic": "وَلاَ إعْيَاءٌ مِنْ لُغُوب وَلاَ فُتُورٌ،"
  },
  {
   "segment_id": 17,
   "arabic": "وَلاَ تَشْغَلُهُمْ عَنْ تَسْبِيحِكَ الشَّهَوَاتُ،"
  },
  {
   "segment_id": 18,
   "arabic": "وَلا يَقْطَعُهُمْ عَنْ تَعْظِيمِكَ سَهْوُ الْغَفَـلاَتِ،"
  },
  {
   "segment_id": 19,
   "arabic": "الْخُشَّعُ الابْصارِ فلا يَرُومُونَ النَّظَرَ إلَيْكَ ،"
  },
  {
   "segment_id": 20,
   "arabic": "النَّواكِسُ الاذْقانِ الَّذِينَ قَدْ طَالَتْ رَغْبَتُهُمْ فِيمَا لَدَيْكَ"
  },
  {
   "segment_id": 21,
   "arabic": "الْمُسْتَهْتِرُونَ بِذِكْرِ آلائِكَ"
  },
  {
   "segment_id": 22,
   "arabic": "وَالْمُتَوَاضِعُونَ دُونَ عَظَمَتِكَ وَجَلاَلِ كِبْرِيآئِكَ"
  },
  {
   "segment_id": 23,
   "arabic": "وَالَّذِينَ يَقُولُونَ إذَا نَظَرُوا إلَى جَهَنَّمَ تَزْفِرُ عَلَى أَهْلِ مَعْصِيَتِكَ:"
  },
  {
   "segment_id": 24,
   "arabic": "سُبْحَانَكَ مَا عَبَدْنَاكَ حَقَّ عِبَـادَتِكَ."
  },
  {
   "segment_id": 25,
   "arabic": "فَصَـلِّ عَلَيْهِمْ وَعَلَى الرَّوْحَانِيِّينَ مِنْ مَلائِكَتِكَ،"
  },
  {
   "segment_id": 26,
   "arabic": "وَ أهْلِ الزُّلْفَةِ عِنْدَكَ،"
  },
  {
   "segment_id": 27,
   "arabic": "وَحُمَّالِ الْغَيْبِ إلى رُسُلِكَ،"
  },
  {
   "segment_id": 28,
   "arabic": "وَالْمُؤْتَمَنِينَ على وَحْيِكَ"
  },
  {
   "segment_id": 29,
   "arabic": "وَقَبائِلِ الْمَلائِكَةِ الَّذِينَ اخْتَصَصْتَهُمْ لِنَفْسِكَ،"
  },
  {
   "segment_id": 30,
   "arabic": "وَأَغْنَيْتَهُمْ عَنِ الطَّعَامِ والشَّرَابِ بِتَقْدِيْسِكَ،"
  },
  {
   "segment_id": 31,
   "arabic": "وَأسْكَنْتَهُمْ بُطُونَ أطْبَـاقِ سَمَاوَاتِكَ،"
  },
  {
   "segment_id": 32,
   "arabic": "وَالّذينَ عَلَى أرْجَآئِهَا إذَا نَزَلَ الامْرُ بِتَمَامِ وَعْدِكَ،"
  },
  {
   "segment_id": 33,
   "arabic": "وَخزّانِ الْمَطَرِ وَزَوَاجِرِ السَّحَابِ،"
  },
  {
   "segment_id": 34,
   "arabic": "وَالّذِي بِصَوْتِ زَجْرِهِ يُسْمَعُ زَجَلُ ألرُّعُوْدِ،"
  },
  {
   "segment_id": 35,
   "arabic": "وَإذَا سَبَحَتْ بِهِ حَفِيفَةُ السّحَـابِ الْتَمَعَتْ صَوَاعِقُ الْبُرُوقِ."
  },
  {
   "segment_id": 36,
   "arabic": "وَمُشَيِّعِيْ الْثَلْجِ وَالْبَرَدِ."
  },
  {
   "segment_id": 37,
   "arabic": "وَالْهَابِطِينَ مَعَ قَطْرِ الْمَطَر إَذَا نَزَلَ،"
  },
  {
   "segment_id": 38,
   "arabic": "وَالْقُوَّامِ عَلَى خَزَائِنِ الرّيَاحِ،"
  },
  {
   "segment_id": 39,
   "arabic": "وَ المُوَكَّلِينَ بِالجِبَالِ فَلا تَزُولُ."
  },
  {
   "segment_id": 40,
   "arabic": "وَالَّذِينَ عَرَّفْتَهُمْ مَثَاقِيلَ الْمِياهِ،"
  },
  {
   "segment_id": 41,
   "arabic": "وَكَيْلَ مَا تَحْوِيهِ لَوَاعِجُ الامْطَارِ وَعَوَالِجُهَا،"
  },
  {
   "segment_id": 42,
   "arabic": "وَرُسُلِكَ مِنَ الْمَلائِكَةِ إلَى أهْلِ الارْضِ"
  },
  {
   "segment_id": 43,
   "arabic": "بِمَكْرُوهِ مَا يَنْزِلُ مِنَ الْبَلاءِ،"
  },
  {
   "segment_id": 44,
   "arabic": "وَمَحْبُوبِ الرَّخَآءِ،"
  },
  {
   "segment_id": 45,
   "arabic": "والسَّفَرَةِ الْكِرَامِ اَلبَرَرَةِ،"
  },
  {
   "segment_id": 46,
   "arabic": "وَالْحَفَظَةِ الْكِرَامِ الْكَاتِبِينَ،"
  },
  {
   "segment_id": 47,
   "arabic": "وَمَلَكِ الْمَوْتِ وَأعْوَانِهِ،"
  },
  {
   "segment_id": 48,
   "arabic": "وَمُنْكَر وَنَكِير،"
  },
  {
   "segment_id": 49,
   "arabic": "وَرُومَانَ فَتَّانِ الْقُبُورِ،"
  },
  {
   "segment_id": 50,
   "arabic": "وَالطَّائِفِينَ بِالبَيْتِ الْمَعْمُورِ،"
  },
  {
   "segment_id": 51,
   "arabic": "وَمَالِك، وَالْخَزَنَةِ،"
  },
  {
   "segment_id": 52,
   "arabic": "وَرُضْوَانَ، وَسَدَنَةِ الْجِنَانِ"
  },
  {
   "segment_id": 53,
   "arabic": "وَالَّذِينَ لاَ يَعْصُوْنَ اللّهَ مَا أمَرَهُمْ"
  },
  {
   "segment_id": 54,
   "arabic": "وَيَفْعَلُونَ مَا يُؤْمَرُونَ."
  },
  {
   "segment_id": 55,
   "arabic": "وَالَّذِينَ يَقُولُونَ: سَلاَمٌ عَلَيْكُمْ بِمَا صَبَرْتُمْ"
  },
  {
   "segment_id": 56,
   "arabic": "فَنِعْمَ عُقْبَى الـدّارِ."
  },
  {
   "segment_id": 57,
   "arabic": "والزّبانيةُ الذّينَ إذَا قِيْـلَ لَهُمْ: خُذُوهُ فَغُلُّوْهُ"
  },
  {
   "segment_id": 58,
   "arabic": "ثُمَّ الْجَحِيمَ صَلُّوْهُ"
  },
  {
   "segment_id": 59,
   "arabic": "ابْتَدَرُوهُ سِرَاعاً وَلَمْ يُنْظِرُوهُ."
  },
  {
   "segment_id": 60,
   "arabic": "وَمَنْ أوْهَمْنَا ذِكْرَهُ،"
  },
  {
   "segment_id": 61,
   "arabic": "وَلَمْ نَعْلَمْ مَكَانَهُ مِنْكَ،"
  },
  {
   "segment_id": 62,
   "arabic": "وَبأيِّ أمْر وَكَّلْتَهُ."
  },
  {
   "segment_id": 63,
   "arabic": "وَسُكّانُ الْهَوَآءِ وَالارْضِ وَالمآءِ،"
  },
  {
   "segment_id": 64,
   "arabic": "وَمَنْ مِنْهُمْ عَلَى الْخَلْقِ فَصَلِّ عَلَيْهِمْ"
  },
  {
   "segment_id": 65,
   "arabic": "يَوْمَ تَأْتي كُلُّ نَفْس مَعَهَا سَائِقٌ وَشَهِيدٌ،"
  },
  {
   "segment_id": 66,
   "arabic": "وَصَلّ عَلَيْهِمْ صَلاَةً تَزِيدُهُمْ كَرَامَةً عَلى كَرَامَتِهِمْ،"
  },
  {
   "segment_id": 67,
   "arabic": "وَطَهَارَةً عَلَى طَهَارَتِهِمْ."
  },
  {
   "segment_id": 68,
   "arabic": "اللّهُمَّ وَإذَا صَلَّيْتَ عَلَى مَلاَئِكَتِكَ وَرُسُلِكَ،"
  },
  {
   "segment_id": 69,
   "arabic": "وَبَلَّغْتَهُمْ صَلاَتَنَا عَلَيْهِمْ،"
  },
  {
   "segment_id": 70,
   "arabic": "فَصَلِّ عَلَينا بِمَا فَتَحْتَ لَنَا مِنْ حُسْنِ الْقَوْلِ فِيْهِمْ"
  },
  {
   "segment_id": 71,
   "arabic": "إنَّكَ جَوَاْدٌ كَرِيمٌ."
  }
 ]
}