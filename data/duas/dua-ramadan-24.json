{
 "dua_id": "dua-ramadan-24",
 "dua_name_en": "Day 24",
 "dua_name_ar": "شهر رمضان ٢٤ ",
 "source": "https://www.duaplayer.org/en/dua/ramadan-24",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "اللّهُمّ إِنّي أَسْأَلُكَ فِيهِ مَا يُرْضِيكَ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَأَعُوذُ بِكَ مِمَّا يُؤْذِيكَ،"
  },
  {
   "segment_id": 5,
   "arabic": "وَأَسْأَلُكَ التّوْفِيقَ فِيهِ لأَنْ أُطِيعَكَ وَلا أَعْصِيَكَ،"
  },
  {
   "segment_id": 6,
   "arabic": "يَا جَوَادَ السَّائِلِينَ."
  }
 ]
}