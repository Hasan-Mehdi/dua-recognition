{
 "dua_id": "duasorg-salat-jafar-tayyar-4",
 "dua_name_en": "For Special needs - Severe Problems",
 "dua_name_ar": "",
 "source": "https://www.duas.org/salat-jafar-tayyar.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "يَا مَنْ اظْهَرَ ٱلْجَمِيلَ"
  },
  {
   "segment_id": 2,
   "arabic": "وَسَتَرَ ٱلْقَبِيحَ"
  },
  {
   "segment_id": 3,
   "arabic": "يَا مَنْ لَمْ يُؤَاخِذْ بِٱلْجَرِيرَةِ"
  },
  {
   "segment_id": 4,
   "arabic": "وَلَمْ يَهْتِكِ ٱلسِّتْرَ"
  },
  {
   "segment_id": 5,
   "arabic": "يَا عَظِيمَ ٱلْعَفْوِ"
  },
  {
   "segment_id": 6,
   "arabic": "يَا حَسَنَ ٱلتَّجَاوُزِ"
  },
  {
   "segment_id": 7,
   "arabic": "يَا وَاسِعَ ٱلْمَغْفِرَةِ"
  },
  {
   "segment_id": 8,
   "arabic": "يَا بَاسِطَ ٱلْيَدَيْنِ بِٱلرَّحْمَةِ"
  },
  {
   "segment_id": 9,
   "arabic": "يَا صَاحِبَ كُلِّ نَجْوَىٰ"
  },
  {
   "segment_id": 10,
   "arabic": "يَا مُنْتَهَىٰ كُلِّ شَكْوَىٰ"
  },
  {
   "segment_id": 11,
   "arabic": "يَا مُقِيلَ ٱلْعَثَرَاتِ"
  },
  {
   "segment_id": 12,
   "arabic": "يَا كَرِيـمَ ٱلصَّفْحِ"
  },
  {
   "segment_id": 13,
   "arabic": "يَا عَظِيمَ ٱلْمَنِّ"
  },
  {
   "segment_id": 14,
   "arabic": "يَا مُبْتَدِئاً بِٱلنِّعَمِ قَبْلَ ٱسْتِحْقَاقِهَا"
  },
  {
   "segment_id": 15,
   "arabic": "يَا رَبَّاهُ يَا رَبَّاهُ يَا رَبَّاهُ"
  },
  {
   "segment_id": 16,
   "arabic": "Repeat these 10 times each."
  },
  {
   "segment_id": 17,
   "arabic": "يَا اللَّهُ َيَا اللَّهُ يَا اللَّهُ"
  },
  {
   "segment_id": 18,
   "arabic": "يَا سَيِّدَاهُ يَا سَيِّدَاهُ"
  },
  {
   "segment_id": 19,
   "arabic": "يَا مَوْلاَيَاهُ يَا مَوْلاَيَاهُ"
  },
  {
   "segment_id": 20,
   "arabic": "يَا رَجَاءَاهُ"
  },
  {
   "segment_id": 21,
   "arabic": "يَا غِيَاثَاهُ"
  },
  {
   "segment_id": 22,
   "arabic": "يَا غَايَةَ رَغْبَتَاهُ"
  },
  {
   "segment_id": 23,
   "arabic": "يَا رَحْمٰنُ"
  },
  {
   "segment_id": 24,
   "arabic": "يَا رَحِيمُ"
  },
  {
   "segment_id": 25,
   "arabic": "يَا مُعْطِيَ ٱلْخَيْرَاتِ"
  },
  {
   "segment_id": 26,
   "arabic": "صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 27,
   "arabic": "كَثِيراً طَيِّباً"
  },
  {
   "segment_id": 28,
   "arabic": "كَافْضَلِ مَا صَلَّيْتَ عَلَىٰ احَدٍ مِنْ خَلْقِكَ"
  },
  {
   "segment_id": 29,
   "arabic": "After this mention your needs/desires."
  }
 ]
}