{
 "dua_id": "dua-tasbih-suhoor",
 "dua_name_en": "Tasbih as-Suhoor",
 "dua_name_ar": "تسبیح سحور",
 "source": "https://www.duaplayer.org/en/dua/tasbih-suhoor",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "سُبْحَانَ مَنْ يَعْلَمُ جَوَارِحَ ٱلقُلُوبِ"
  },
  {
   "segment_id": 2,
   "arabic": "سُبْحَانَ مَنْ يُحْصِي عَدَدَ ٱلذُّنُوبِ"
  },
  {
   "segment_id": 3,
   "arabic": "سُبْحَانَ مَنْ لاَ يَخْفَىٰ عَلَيْهِ خَافِيَةٌ فِي ٱلسَّمَاوَاتِ وَٱلارَضِينَ"
  },
  {
   "segment_id": 4,
   "arabic": "سُبْحَانَ ٱلرَّبِّ ٱلْوَدُودِ"
  },
  {
   "segment_id": 5,
   "arabic": "سُبْحَانَ ٱلفَرْدِ ٱلوِتْرِ"
  },
  {
   "segment_id": 6,
   "arabic": "سُبْحَانَ ٱلعَظِيمِ ٱلاعْظَمِ"
  },
  {
   "segment_id": 7,
   "arabic": "سُبْحَانَ مَنْ لاَ يَعْتَدِي عَلَىٰ اهْلِ مَمْلَكَتِهِ"
  },
  {
   "segment_id": 8,
   "arabic": "سُبْحَانَ مَنْ لاَ يُؤَاخِذُ اهْلَ ٱلارْضِ بِالْوَانِ ٱلْعَذَابِ"
  },
  {
   "segment_id": 9,
   "arabic": "سُبْحَانَ ٱلْحَنَّانِ ٱلْمَنَّانِ"
  },
  {
   "segment_id": 10,
   "arabic": "سُبْحَانَ ٱلرَّؤُوفِ ٱلرَّحِيمِ"
  },
  {
   "segment_id": 11,
   "arabic": "سُبْحَانَ ٱلْجَبَّارِ ٱلْجَوَادِ"
  },
  {
   "segment_id": 12,
   "arabic": "سُبْحَانَ ٱلْكَرِيمِ ٱلْحَلِيمِ"
  },
  {
   "segment_id": 13,
   "arabic": "سُبْحَانَ ٱلْبَصِيرِ ٱلْعَلِيمِ"
  },
  {
   "segment_id": 14,
   "arabic": "سُبْحَانَ ٱلْبَصِيرِ ٱلْوَاسِعِ"
  },
  {
   "segment_id": 15,
   "arabic": "سُبْحَانَ ٱللَّهِ عَلَىٰ إِقْبَالِ ٱلنَّهَارِ"
  },
  {
   "segment_id": 16,
   "arabic": "سُبْحَانَ ٱللَّهِ عَلَىٰ إِدْبَارِ ٱلنَّهَارِ"
  },
  {
   "segment_id": 17,
   "arabic": "سُبْحَانَ ٱللَّهِ عَلَىٰ إِدْبَارِ ٱللَّيْلِ وَإِقْبَالِ ٱلنَّهَارِ"
  },
  {
   "segment_id": 18,
   "arabic": "وَلَهُ ٱلحَمْدُ وَٱلْمَجْدُ وَٱلعَظَمَةُ وَٱلكِبْرِيَاءُ"
  },
  {
   "segment_id": 19,
   "arabic": "مَعَ كُلِّ نَفَسٍ وَكُلِّ طَرْفَةِ عَيْنٍ"
  },
  {
   "segment_id": 20,
   "arabic": "وَكُلِّ لَمْحَةٍ سَبَقَ فِي عِلْمِهِ"
  },
  {
   "segment_id": 21,
   "arabic": "سُبْحَانَكَ مِلْءَ مَا احْصَىٰ كِتَابُكَ"
  },
  {
   "segment_id": 22,
   "arabic": "سُبْحَانَكَ زِنَةَ عَرْشِكَ"
  },
  {
   "segment_id": 23,
   "arabic": "سُبْحَانَكَ سُبْحَانَكَ سُبْحَانَكَ"
  }
 ]
}