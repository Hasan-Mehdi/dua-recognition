{
 "dua_id": "sahifa-21",
 "dua_name_en": "Sahifa 21: When something made him sorrowful",
 "dua_name_ar": "دُعَاؤُهُ إِذَا حَزَنَهُ أَمْرٌ",
 "source": "https://duas.pro/21-when-something-made-him-sorrowful",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "أَللَّهُمَّ يَا كَافِيَ الْفَرْدِ الضَّعِيفِ"
  },
  {
   "segment_id": 2,
   "arabic": "وَوَاقِيَ الْأَمْرِ الْمَخُوفِ"
  },
  {
   "segment_id": 3,
   "arabic": "أَفْرَدَتْنِي الْخَطَايَا فَلَا صَاحِبَ مَعِي"
  },
  {
   "segment_id": 4,
   "arabic": "وَضَعُفْتُ عَنْ غَضَبِكَ فَلَا مُؤَيِّدَ لِي"
  },
  {
   "segment_id": 5,
   "arabic": "وَأَشْرَفْتُ عَلَى خَوْفِ لِقَائِكَ فَلَا مُسَكِّنَ لِرَوْعَتِي"
  },
  {
   "segment_id": 6,
   "arabic": "وَمَنْ يُؤْمِنُنِي مِنْكَ وَأَنْتَ أَخَفْتَنِي"
  },
  {
   "segment_id": 7,
   "arabic": "وَمَنْ يُسَاعِدُنِي وَأَنْتَ أَفْرَدْتَنِي"
  },
  {
   "segment_id": 8,
   "arabic": "وَمَنْ يُقَوِّينِي وَأَنْتَ أَضْعَفْتَنِي"
  },
  {
   "segment_id": 9,
   "arabic": "لَا يُجِيرُ يَا إِلَهِي إِلَّا رَبٌّ عَلَى مَرْبُوبٍ"
  },
  {
   "segment_id": 10,
   "arabic": "وَلَا يُؤْمِنُ إِلَّا غَالِبٌ عَلَى مَغْلُوبٍ"
  },
  {
   "segment_id": 11,
   "arabic": "وَلَا يُعِينُ إِلَّا طَالِبٌ عَلَى مَطْلُوبٍ"
  },
  {
   "segment_id": 12,
   "arabic": "وَبِيَدِكَ يَا إِلَهِي جَمِيعُ ذَلِكَ السَّبَبِ"
  },
  {
   "segment_id": 13,
   "arabic": "وَإِلَيْكَ الْمَفَرُّ وَالْمَهْرَبُ"
  },
  {
   "segment_id": 14,
   "arabic": "فَصَلِّ عَلَى مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 15,
   "arabic": "وَأَجِرْ هَرَبِي وَأَنْجِحْ مَطْلَبِي"
  },
  {
   "segment_id": 16,
   "arabic": "أَللَّهُمَّ إِنَّكَ إِنْ صَرَفْتَ عَنِّي وَجْهَكَ الْكَرِيمَ"
  },
  {
   "segment_id": 17,
   "arabic": "أَوْ مَنَعْتَنِي فَضْلَكَ الْجَسِيمَ"
  },
  {
   "segment_id": 18,
   "arabic": "أَوْ حَظَرْتَ عَلَيَّ رِزْقَكَ أَوْ قَطَعْتَ عَنِّي سَبَبَكَ"
  },
  {
   "segment_id": 19,
   "arabic": "لَمْ أَجِدِ السَّبِيلَ إِلَى شَيْءٍ مِنْ أَمَلِي غَيْرَكَ"
  },
  {
   "segment_id": 20,
   "arabic": "وَلَمْ أَقْدِرْ عَلَى مَا عِنْدَكَ بِمَعُونَةِ سِوَاكَ"
  },
  {
   "segment_id": 21,
   "arabic": "فَإِنِّي عَبْدُكَ وَفِي قَبْضَتِكَ نَاصِيَتِي بِيَدِكَ"
  },
  {
   "segment_id": 22,
   "arabic": "لَا أَمْرَ لِي مَعَ أَمْرِكَ"
  },
  {
   "segment_id": 23,
   "arabic": "مَاضٍ فِيَّ حُكْمُكَ عَدْلٌ فِيَّ قَضَاؤُكَ"
  },
  {
   "segment_id": 24,
   "arabic": "وَلَا قُوَّةَ لِي عَلَى الْخُرُوجِ مِنْ سُلْطَانِكَ"
  },
  {
   "segment_id": 25,
   "arabic": "وَلَا أَسْتَطِيعُ مُجَاوَزَةَ قُدْرَتِكَ"
  },
  {
   "segment_id": 26,
   "arabic": "وَلَا أَسْتَمِيلُ هَوَاكَ وَلَا أَبْلُغُ رِضَاكَ"
  },
  {
   "segment_id": 27,
   "arabic": "وَلَا أَنَالُ مَا عِنْدَكَ إِلَّا بِطَاعَتِكَ"
  },
  {
   "segment_id": 28,
   "arabic": "وَبِفَضْلِ رَحْمَتِكَ"
  },
  {
   "segment_id": 29,
   "arabic": "إِلَهِي أَصْبَحْتُ وَأَمْسَيْتُ عَبْدًا دَاخِرًا لَكَ"
  },
  {
   "segment_id": 30,
   "arabic": "لَا أَمْلِكُ لِنَفْسِي نَفْعًا وَلَا ضَرًّا إِلَّا بِكَ"
  },
  {
   "segment_id": 31,
   "arabic": "أَشْهَدُ بِذَلِكَ عَلَى نَفْسِي"
  },
  {
   "segment_id": 32,
   "arabic": "وَأَعْتَرِفُ بِضَعْفِ قُوَّتِي وَقِلَّةِ حِيلَتِي"
  },
  {
   "segment_id": 33,
   "arabic": "فَأَنْجِزْ لِي مَا وَعَدْتَنِي"
  },
  {
   "segment_id": 34,
   "arabic": "وَتَمِّمْ لِي مَا آتَيْتَنِي"
  },
  {
   "segment_id": 35,
   "arabic": "فَإِنِّي عَبْدُكَ الْمِسْكِينُ الْمُسْتَكِينُ"
  },
  {
   "segment_id": 36,
   "arabic": "الضَّعِيفُ الضَّرِيرُ الذَّلِيلُ"
  },
  {
   "segment_id": 37,
   "arabic": "الْحَقِيرُ الْمَهِينُ الْفَقِيرُ"
  },
  {
   "segment_id": 38,
   "arabic": "الْخَائِفُ الْمُسْتَجِيرُ"
  },
  {
   "segment_id": 39,
   "arabic": "أَللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 40,
   "arabic": "وَلَا تَجْعَلْنِي نَاسِيًا لِذِكْرِكَ فِيمَا أَوْلَيْتَنِي"
  },
  {
   "segment_id": 41,
   "arabic": "وَلَا غَافِلًا لِإِحْسَانِكَ فِيمَا أَبْلَيْتَنِي"
  },
  {
   "segment_id": 42,
   "arabic": "وَلَا آيِسًا مِنْ إِجَابَتِكَ لِي وَإِنْ أَبْطَأَتْ عَنِّي"
  },
  {
   "segment_id": 43,
   "arabic": "فِي سَرَّاءَ كُنْتُ أَوْ ضَرَّاءَ"
  },
  {
   "segment_id": 44,
   "arabic": "أَوْ شِدَّةٍ أَوْ رَخَاءٍ"
  },
  {
   "segment_id": 45,
   "arabic": "أَوْ عَافِيَةٍ أَوْ بَلَاءٍ"
  },
  {
   "segment_id": 46,
   "arabic": "أَوْ بُؤْسٍ أَوْ نَعْمَاءَ"
  },
  {
   "segment_id": 47,
   "arabic": "أَوْ جِدَةٍ أَوْ لَأْوَاءَ"
  },
  {
   "segment_id": 48,
   "arabic": "أَوْ فَقْرٍ أَوْ غِنًى"
  },
  {
   "segment_id": 49,
   "arabic": "أَللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 50,
   "arabic": "وَاجْعَلْ ثَنَائِي عَلَيْكَ وَمَدْحِي إِيَّاكَ"
  },
  {
   "segment_id": 51,
   "arabic": "وَحَمْدِي لَكَ فِي كُلِّ حَالَاتِي"
  },
  {
   "segment_id": 52,
   "arabic": "حَتَّى لَا أَفْرَحَ بِمَا آتَيْتَنِي مِنَ الدُّنْيَا"
  },
  {
   "segment_id": 53,
   "arabic": "وَلَا أَحْزَنَ عَلَى مَا مَنَعْتَنِي فِيهَا"
  },
  {
   "segment_id": 54,
   "arabic": "وَأَشْعِرْ قَلْبِي تَقْوَاكَ"
  },
  {
   "segment_id": 55,
   "arabic": "وَاسْتَعْمِلْ بَدَنِي فِيمَا تَقْبَلُهُ مِنِّي"
  },
  {
   "segment_id": 56,
   "arabic": "وَاشْغَلْ بِطَاعَتِكَ نَفْسِي"
  },
  {
   "segment_id": 57,
   "arabic": "عَنْ كُلِّ مَا يَرِدُ عَلَيَّ"
  },
  {
   "segment_id": 58,
   "arabic": "حَتَّى لَا أُحِبَّ شَيْئًا مِنْ سُخْطِكَ"
  },
  {
   "segment_id": 59,
   "arabic": "وَلَا أَسْخَطَ شَيْئًا مِنْ رِضَاكَ"
  },
  {
   "segment_id": 60,
   "arabic": "أَللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 61,
   "arabic": "وَفَرِّغْ قَلْبِي لِمَحَبَّتِكَ"
  },
  {
   "segment_id": 62,
   "arabic": "وَاشْغَلْهُ بِذِكْرِكَ"
  },
  {
   "segment_id": 63,
   "arabic": "وَانْعَشْهُ بِخَوْفِكَ وَبِالْوَجَلِ مِنْكَ"
  },
  {
   "segment_id": 64,
   "arabic": "وَقَوِّهِ بِالرَّغْبَةِ إِلَيْكَ"
  },
  {
   "segment_id": 65,
   "arabic": "وَأَمِلْهُ إِلَى طَاعَتِكَ"
  },
  {
   "segment_id": 66,
   "arabic": "وَأَجْرِ بِهِ فِي أَحَبِّ السُّبُلِ إِلَيْكَ"
  },
  {
   "segment_id": 67,
   "arabic": "وَذَلِّلْهُ بِالرَّغْبَةِ فِيمَا عِنْدَكَ"
  },
  {
   "segment_id": 68,
   "arabic": "أَيَّامَ حَيَاتِي كُلِّهَا"
  },
  {
   "segment_id": 69,
   "arabic": "وَاجْعَلْ تَقْوَاكَ مِنَ الدُّنْيَا زَادِي"
  },
  {
   "segment_id": 70,
   "arabic": "وَإِلَى رَحْمَتِكَ رِحْلَتِي"
  },
  {
   "segment_id": 71,
   "arabic": "وَفِي مَرْضَاتِكَ مَدْخَلِي"
  },
  {
   "segment_id": 72,
   "arabic": "وَاجْعَلْ فِي جَنَّتِكَ مَثْوَايَ"
  },
  {
   "segment_id": 73,
   "arabic": "وَهَبْ لِي قُوَّةً أَحْتَمِلُ بِهَا"
  },
  {
   "segment_id": 74,
   "arabic": "جَمِيعَ مَرْضَاتِكَ"
  },
  {
   "segment_id": 75,
   "arabic": "وَاجْعَلْ فِرَارِي إِلَيْكَ"
  },
  {
   "segment_id": 76,
   "arabic": "وَرَغْبَتِي فِيمَا عِنْدَكَ"
  },
  {
   "segment_id": 77,
   "arabic": "وَأَلْبِسْ قَلْبِي الْوَحْشَةَ مِنْ شِرَارِ خَلْقِكَ"
  },
  {
   "segment_id": 78,
   "arabic": "وَهَبْ لِي الْأُنْسَ بِكَ"
  },
  {
   "segment_id": 79,
   "arabic": "وَبِأَوْلِيَائِكَ وَأَهْلِ طَاعَتِكَ"
  },
  {
   "segment_id": 80,
   "arabic": "وَلَا تَجْعَلْ لِفَاجِرٍ وَلَا كَافِرٍ عَلَيَّ مِنَّةً"
  },
  {
   "segment_id": 81,
   "arabic": "وَلَا لَهُ عِنْدِي يَدًا"
  },
  {
   "segment_id": 82,
   "arabic": "وَلَا بِي إِلَيْهِمْ حَاجَةً"
  },
  {
   "segment_id": 83,
   "arabic": "بَلِ اجْعَلْ سُكُونَ قَلْبِي"
  },
  {
   "segment_id": 84,
   "arabic": "وَأُنْسَ نَفْسِي وَاسْتِغْنَائِي"
  },
  {
   "segment_id": 85,
   "arabic": "وَكِفَايَتِي بِكَ وَبِخِيَارِ خَلْقِكَ"
  },
  {
   "segment_id": 86,
   "arabic": "أَللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 87,
   "arabic": "وَاجْعَلْنِي لَهُمْ قَرِينًا"
  },
  {
   "segment_id": 88,
   "arabic": "وَاجْعَلْنِي لَهُمْ نَصِيرًا"
  },
  {
   "segment_id": 89,
   "arabic": "وَامْنُنْ عَلَيَّ بِشَوْقٍ إِلَيْكَ"
  },
  {
   "segment_id": 90,
   "arabic": "وَبِالْعَمَلِ لَكَ بِمَا تُحِبُّ وَتَرْضَى"
  },
  {
   "segment_id": 91,
   "arabic": "إِنَّكَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ"
  },
  {
   "segment_id": 92,
   "arabic": "وَذَلِكَ عَلَيْكَ يَسِيرٌ"
  }
 ]
}