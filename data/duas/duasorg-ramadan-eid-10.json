{
 "dua_id": "duasorg-ramadan-eid-10",
 "dua_name_en": "When going for Eid Prayer",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-eid.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللَّهُمَّ مَنْ تَهَيّا فِي هٰذَا ٱلْيَوْمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اوْ تَعَبَّا اوْ اعَدَّ وَٱسْتَعَدَّ"
  },
  {
   "segment_id": 3,
   "arabic": "لِوِفَادَةٍ إِلَىٰ مَخْلُوقٍ"
  },
  {
   "segment_id": 4,
   "arabic": "رَجَاءَ رِفْدِهِ وَنَوَافِلِهِ"
  },
  {
   "segment_id": 5,
   "arabic": "وَفَوَاضِلِهِ وَعَطَايَاهُ"
  },
  {
   "segment_id": 6,
   "arabic": "فَإِنَّ إِلَيْكَ يَاسَيِّدِي تَهْيِئَتِي وَتَعْبِئَتِي"
  },
  {
   "segment_id": 7,
   "arabic": "وَإِعْدَادِي وَٱسْتِعْدَادِي"
  },
  {
   "segment_id": 8,
   "arabic": "رَجَاءَ رِفْدِكَ وَجَوَائِزِكَ"
  },
  {
   "segment_id": 9,
   "arabic": "وَنَوَافِلِكَ وَفَوَاضِلِكَ"
  },
  {
   "segment_id": 10,
   "arabic": "وَفَضَائِلِكَ وَعَطَايَاكَ"
  },
  {
   "segment_id": 11,
   "arabic": "وَقَدْ غَدَوْتُ إِلَىٰ عِيدٍ مِنْ اعْيَادِ امَّةِ نَبِيِّكَ مُحَمَّدٍ"
  },
  {
   "segment_id": 12,
   "arabic": "صَلَوَاتُ ٱللَّهِ عَلَيْهِ وَعَلَىٰ آلِهِ"
  },
  {
   "segment_id": 13,
   "arabic": "وَلَمْ افِدْ إِلَيْكَ ٱلْيَوْمَ بِعَمَلٍ صَالِحٍ اثِقُ بِهِ قَدَّمْتُهُ"
  },
  {
   "segment_id": 14,
   "arabic": "وَلاَ تَوَجَّهْتُ بِمَخْلُوقٍ امَّلْتُهُ"
  },
  {
   "segment_id": 15,
   "arabic": "وَلكِنْ اتَيْتُكَ خَاضِعاً"
  },
  {
   "segment_id": 16,
   "arabic": "مُقِرّاً بِذُنُوبِي وَإِسَاءَتِي إِلَىٰ نَفْسِي"
  },
  {
   "segment_id": 17,
   "arabic": "فَيَا عَظِيمُ يَا عَظِيمُ يَا عَظِيمُ"
  },
  {
   "segment_id": 18,
   "arabic": "ٱغْفِرْ لِيَ ٱلْعَظِيمَ مِنْ ذُنُوبِي"
  },
  {
   "segment_id": 19,
   "arabic": "فَإِنَّهُ لاَ يَغْفِرُ ٱلذُّنُوبَ ٱلْعِظَامَ إِلاَّ انْتَ"
  },
  {
   "segment_id": 20,
   "arabic": "يَا لاَ إِلٰهَ إِلاَّ انْتَ"
  },
  {
   "segment_id": 21,
   "arabic": "يَا ارْحَمَ ٱلرَّاحِمِينَ"
  }
 ]
}