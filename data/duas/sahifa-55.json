   "arabic": "سُبْحَانَكَ اَللّٰهُمَّ وَحَنَانَيْكَ"
  },
  {
   "segment_id": 2,
   "arabic": "سُبْحَانَكَ اَللّٰهُمَّ وَتَعَالَيْتَ"
  },
  {
   "segment_id": 3,
   "arabic": "سُبْحَانَكَ اَللّٰهُمَّ وَ الْعِزُّ اِزَارُكَ"
  },
  {
   "segment_id": 4,
   "arabic": "سُبْحَانَكَ اَللّٰهُمَّ وَالْعَظَمَةُ رِدآؤُكَ"
  },
  {
   "segment_id": 5,
   "arabic": "سُبْحَانَكَ اَللّٰهُمَّ وَالْكِبْرِيَآءُ سُلْطَانُكَ"
  },
  {
   "segment_id": 6,
   "arabic": "سُبْحَانَكَ مِنْ عَظِيْمِ مَا أَعْظَمَكَ"
  },
  {
   "segment_id": 7,
   "arabic": "سُبْحَانَكَ سُبِّحْتَ فِيْ الْمَلَاِ الْأَعْلٰى، تَسْمَعُ وَتَرٰى مَا تَحْتَ الثَّرٰى"
  },
  {
   "segment_id": 8,
   "arabic": "سُبْحَانَكَ اَنْتَ شَاهِدُ كُلِّ نَجْوٰى"
  },
  {
   "segment_id": 9,
   "arabic": "سُبْحَانَكَ مَوْضِعُ كُلِّ شَكْوٰى"
  },
  {
   "segment_id": 10,
   "arabic": "سُبْحَانَكَ حَاضِرُ كُلِّ مَلَاٍ"
  },
  {
   "segment_id": 11,
   "arabic": "سُبْحَانَكَ عَظِيمُ الرَّجآءِ"
  },
  {
   "segment_id": 12,
   "arabic": "سُبْحَانَكَ تَرٰى مَا فِيْ قَعْرِ الْمَآءِ"
  },
  {
   "segment_id": 13,
   "arabic": "سُبْحَانَكَ تَسْمَعُ أَنْفَاسَ الْحِيْتَانِ فِيْ قُعُوْرِ الْبِحَارِ"
  },
  {
   "segment_id": 14,
   "arabic": "سُبْحَانَكَ تَعْلَمُ وَزْنَ السَّمَوَاتِ"
  },
  {
   "segment_id": 15,
   "arabic": "سُبْحَانَكَ تَعْلَمُ وَزْنَ الْاَرَضِيْنَ"
  },
  {
   "segment_id": 16,
   "arabic": "سُبْحَانَكَ تَعْلَمُ وَزْنَ الشَّمْسِ وَ الْقَمَرِ"
  },
  {
   "segment_id": 17,
   "arabic": "سُبْحَانَكَ تَعْلَمُ وَزْنَ الظُّلْمَةِ وَالنُّوْرِ"
  },
  {
   "segment_id": 18,
   "arabic": "سُبْحَانَكَ تَعْلَمُ وَزْنَ الْفَيْءِ وَالْهَوَآءِ"
  },
  {
   "segment_id": 19,
   "arabic": "سُبْحَانَكَ تَعْلَمُ وَزْنَ الرِّيْحِ كَمْ هِيَ مِنْ مِثْقَالِ ذَرَّةٍ"
  },
  {
   "segment_id": 20,
   "arabic": "سُبْحَانَكَ قُدُّوْسٌ قُدُّوْسٌ قُدُّوْسٌ"
  },
  {
   "segment_id": 21,
   "arabic": "سُبْحَانَكَ عَجَبًا مَنْ عَرَفَكَ كَيْفَ لَا يَخَافُكَ"
  },
  {
   "segment_id": 22,
   "arabic": "سُبْحَانَكَ اَللّٰهُمَّ وَبِحَمْدِكَ"
  },
  {
   "segment_id": 23,
   "arabic": "سُبْحَانَكَ اللهُ الْعَلِيُّ الْعَظِيْمُ"
  }
 ]
