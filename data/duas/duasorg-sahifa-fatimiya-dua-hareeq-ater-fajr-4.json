  },
  {
   "segment_id": 64,
   "arabic": "أَللَّهُمَّ صَلِّ عَلى مُحَمّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 65,
   "arabic": "بِعَدَدِ كُلِّ حَرْفٍ في صَلوةٍ صُلِّيَتْ عَلَيْهِ"
  },
  {
   "segment_id": 66,
   "arabic": "أَللَّهُمَّ صَلِّ عَلى مُحَمّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 67,
   "arabic": "بِعَدَدِ مَنْ صَلَّى عَلَيْهِ وَمَنْ لَمْ يُصَلِّ عَلَيْهِ"
  },
  {
   "segment_id": 68,
   "arabic": "أَللَّهُمَّ صَلِّ عَلى مُحَمّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 69,
   "arabic": "بِعَدَدِ كُلِّ شَعْرَةٍ وَلَفْظَةٍ وَلَحْظَةٍ وَنَفَسٍ"
