  {
   "segment_id": 40,
   "arabic": "وَعَلى كُلِّ نَبِيٍّ وَلَدَ مُحَمَّداً"
  },
  {
   "segment_id": 41,
   "arabic": "وَعَلى كُلِّ مَنْ في صَلَواتِكَ عَلَيْهِ رِضىً لَكَ"
  },
  {
   "segment_id": 42,
   "arabic": "وَرِضىً لِنَبِيِّكَ مُحَمَّدٍ صَلَّى اللهُ عَلَيْهِ وَآلِهِ"
  },
  {
   "segment_id": 43,
   "arabic": "أَللَّهُمَّ صَلِّ عَلَيْهِمْ حَتَّى تُبَلِّغَهُمُ الرِّضا"
  },
  {
