   "segment_id": 92,
   "arabic": "وَالْخَيْرُ وَالتَّوْحيدُ وَالتَّمْجيدُ وَالتَّحْميدُ"
  },
  {
   "segment_id": 93,
   "arabic": "وَالتَّهْليلُ وَالتَّكْبيرُ وَالتَّقْديسُ"
  },
  {
