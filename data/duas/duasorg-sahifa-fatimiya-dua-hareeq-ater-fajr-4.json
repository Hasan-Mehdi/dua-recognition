  },
  {
   "segment_id": 37,
   "arabic": "وَعَلى أَصْحابِهِ الْمُنْتَجَبينَ"
  },
  {
   "segment_id": 38,
   "arabic": "وَعَلى أَزْواجِهِ الْمُطَهَّراتِ وَعَلى ذُرِّيَّةِ مُحَمَّدٍ"
  },
  {
   "segment_id": 39,
   "arabic": "وَعَلى كُلِّ نَبِيٍّ بَشَّرَ بِمُحَمَّدٍ"
