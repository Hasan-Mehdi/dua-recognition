  {
   "segment_id": 80,
   "arabic": "أَوْ كانَ مِنْهُمْ أَوْ يَكُونُ إِلى يَوْمِ الْقِيامَةِ"
  },
  {
   "segment_id": 81,
   "arabic": "وَكَأَضْعافِ ذلِكَ أَضْعافاً مُضاعَفَةً إِلى يَوْمِ الْقِيامَةِ"
  },
  {
   "segment_id": 82,
   "arabic": "يا أَرْحَمَ الرَّاحِمينَ"
