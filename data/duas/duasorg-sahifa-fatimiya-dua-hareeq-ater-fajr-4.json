   "arabic": "وَبِعَدَدِ ساعاتِهِمْ وَدَقائِقِهِمْ"
  },
  {
   "segment_id": 73,
   "arabic": "وَسُكُونِهِمْ وَحَرَكاتِهِمْ"
  },
  {
   "segment_id": 74,
   "arabic": "وَحَقائِقِهِمْ وَميقاتِهِمْ"
