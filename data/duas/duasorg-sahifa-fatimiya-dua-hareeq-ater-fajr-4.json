   "arabic": "إِلى يَوْمِ الْقِيامَةِ صَلوةً تُرْضيهِ"
  },
  {
   "segment_id": 86,
   "arabic": "أَللَّهُمَّ لَكَ الْحَمْدُ وَالثَّناءُ وَالشُّكْرُ"
  },
  {
   "segment_id": 87,
   "arabic": "وَالْمَنُّ وَالْفَضْلُ وَالطَّوْلُ وَالْخَيْرُ"
  },
  {
   "segment_id": 88,
   "arabic": "وَالْحُسْنى وَالنِّعْمَةُ وَالْعَظَمَةُ وَالْجَبَرُوتُ"
  },
  {
   "segment_id": 89,
   "arabic": "وَالْمُلْكُ وَالْمَلَكُوتُ وَالْقَهْرُ وَالسُّلْطانُ"
  },
  {
   "segment_id": 90,
   "arabic": "وَالْفَخْرُ وَالسُّؤْدَدُ وَالْإِمْتِنانُ وَالْكَرَمُ"
  },
  {
   "segment_id": 91,
   "arabic": "وَالْجَلالُ وَالْإِكْرامُ وَالْجَمالُ وَالْكَمالُ"
