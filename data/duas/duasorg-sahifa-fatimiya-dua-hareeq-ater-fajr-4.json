  {
   "segment_id": 46,
   "arabic": "أَللَّهُمَّ صَلِّ عَلى مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 47,
   "arabic": "وَبارِكْ عَلى مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 48,
   "arabic": "وَارْحَمْ مُحَمَّداً وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 49,
   "arabic": "كَأَفْضَلِ ما صَلَّيْتَ وَبارَكْتَ وَتَرَحَّمْتَ"
  },
  {
   "segment_id": 50,
   "arabic": "عَلى إِبْراهيمَ وَآلِ إِبْراهيمَ إِنَّكَ حَميدٌ مَجيدٌ"
  },
  {
   "segment_id": 51,
   "arabic": "أَللَّهُمَّ أَعْطِ مُحَمَّداً صَلَّى اللهُ عَلَيْهِ وَآلِهِ الْوَسيلَةَ وَالْفَضْلَ"
  },
  {
