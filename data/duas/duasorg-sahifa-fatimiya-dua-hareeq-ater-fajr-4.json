  {
   "segment_id": 96,
   "arabic": "وَالْمَديحِ الْفاخِرِ وَالْقَوْلِ الْحَسَنِ الْجَميلِ"
  },
  {
   "segment_id": 97,
   "arabic": "الَّذي تَرْضى بِهِ عَنْ قائِلِهِ"
  },
  {
   "segment_id": 98,
   "arabic": "وَتُرْضِيَ بِهِ قائِلَهُ وَهُوَ رِضىً لَكَ"
  },
  {
   "segment_id": 99,
   "arabic": "يَتَّصِلُ حَمْدي بِحَمْدِ أَوَّلِ الْحامِدينَ"
