  },
  {
   "segment_id": 101,
   "arabic": "مُتَّصِلاً ذلِكَ بِذلِكَ"
  },
  {
   "segment_id": 102,
   "arabic": "وَتَهْليلي بِتَهْليلِ أَوَّلِ الْمُهَلِّلينَ"
  },
  {
   "segment_id": 103,
   "arabic": "وَتَكْبيري بِتَكْبيرِ أَوَّلِ الْمُكَبِّرينَ"
  },
  {
   "segment_id": 104,
   "arabic": "وَقَوْلِيَ الْحَسَنُ الْجَميلُ بِقَوْلِ أَوَّلِ الْقائِلينَ"
  },
  {
   "segment_id": 105,
   "arabic": "الْمُجْمِلينَ الْمُثْنينَ عَلى رَبِّ الْعالَمينَ"
  },
  {
   "segment_id": 106,
   "arabic": "مُتَّصِلاً ذلِكَ بِذلِكَ"
  },
  {
   "segment_id": 107,
   "arabic": "مِنْ أَوَّلِ الدَّهْرِ إِلى آخِرِهِ"
  },
  {
   "segment_id": 108,
   "arabic": "وَبِعَدَدِ زِنَةِ ذَرِّ السَّماواتِ وَالْأَرَضينَ"
  },
  {
   "segment_id": 109,
   "arabic": "وَالرِّمالِ وَالتِّلالِ وَالْجِبالِ"
  },
  {
   "segment_id": 110,
   "arabic": "وَعَدَدِ جُرَعِ ماءِ الْبِحارِ"
  },
  {
   "segment_id": 111,
   "arabic": "وَعَدَدِ قَطْرِ الْأَمْطارِ"
  },
  {
   "segment_id": 112,
   "arabic": "وَوَرَقِ الْأَشْجارِ وَعَدَدِ النُّجُومِ"
  },
  {
   "segment_id": 113,
   "arabic": "وَعَدَدِ الثَّرى وَالْحَصى وَالنَّوى وَالْمَدَرِ"
  },
  {
   "segment_id": 114,
   "arabic": "وَعَدَدِ زِنَةِ ذلِكَ كُلِّهِ"
  },
  {
   "segment_id": 115,
   "arabic": "وَعَدَدِ زِنَةِ ذَرِّ السَّماواتِ وَالْأَرَضينَ"
  },
  {
   "segment_id": 116,
   "arabic": "وَما فيهِنَّ وَما بَيْنَهُنَّ وَما تَحْتَهُنَّ"
  },
  {
   "segment_id": 117,
   "arabic": "وَما بَيْنَ ذلِكَ وَما فَوْقَهُنَّ إِلى يَوْمِ الْقِيامَةِ"
  },
  {
   "segment_id": 118,
   "arabic": "مِنْ لَدُنِ الْعَرْشِ إِلى قَرارِ أَرْضِكَ السَّابِعَةِ السُّفْلى"
  },
  {
   "segment_id": 119,
   "arabic": "وَبِعَدَدِ حُرُوفِ أَلْفاظِ أَهْلِهِنِّ"
  },
  {
   "segment_id": 120,
   "arabic": "وَعَدَدِ أَزْمانِهِمْ وَدَقائِقِهِمْ"
  },
  {
   "segment_id": 121,
   "arabic": "وَشَعائِرِهِمْ وَساعاتِهِمْ"
  },
  {
   "segment_id": 122,
   "arabic": "وَأَيَّامِهِمْ وَشُهُورِهِمْ وَسِنيهِمْ"
  },
  {
   "segment_id": 123,
   "arabic": "وَسُكُونِهِمْ وَحَرَكاتِهِمْ"
  },
  {
   "segment_id": 124,
   "arabic": "وَأَشْعارِهِمْ وَأَبْشارِهِمْ"
  },
  {
   "segment_id": 125,
   "arabic": "وَعَدَدِ زِنَةِ ذَرِّ ما عَمِلُوا أَوْ يَعْمَلُونَ"
  },
  {
   "segment_id": 126,
   "arabic": "أَوْ بَلَغَهُمْ أَوْ رَأَوْا أَوْ ظَنُّوا أَو فَطِنُوا"
  },
  {
   "segment_id": 127,
   "arabic": "أَوْ كانَ مِنْهُمْ أَوْ يَكُونُ إِلى يَوْمِ الْقِيامَةِ"
  },
  {
   "segment_id": 128,
   "arabic": "وَعَدَدِ زِنَةِ ذَرِّ ذلِكَ وَأَضْعافِ ذلِكَ"
  },
  {
   "segment_id": 129,
   "arabic": "وَكَأَضْعافِ ذلِكَ أَضْعافاً مُضاعَفَةً لايَعْلَمُها"
  },
  {
   "segment_id": 130,
   "arabic": "وَلايُحْصيها غَيْرُكَ يا ذَا الْجَلالِ وَالْإِكْرامِ"
  },
  {
   "segment_id": 131,
   "arabic": "وَأَهْلُ ذلِكَ أَنْتَ وَمُسْتَحِقُّهُ"
  },
  {
   "segment_id": 132,
   "arabic": "وَمُسْتَوْجِبُهُ مِنّي وَمِنْ جَميعِ خَلْقِكَ"
  },
  {
   "segment_id": 133,
   "arabic": "يا بَديعَ السَّمواتِ وَالْأَرْضِ"
  },
  {
   "segment_id": 134,
   "arabic": "أَللَّهُمَّ إِنَّكَ لَسْتَ بِرَبٍّ اسْتَحْدَثْناكَ"
  },
  {
   "segment_id": 135,
   "arabic": "وَلا مَعَكَ إِلهٌ فَيَشْرَكَكَ في رُبُوبِيَّتِكَ"
  },
  {
   "segment_id": 136,
   "arabic": "وَلا مَعَكَ إِلهٌ أَعانَكَ عَلى خَلْقِنا"
  },
  {
   "segment_id": 137,
   "arabic": "أَنْتَ رَبُّنا كَما تَقُولُ وَفَوْقَ ما يَقُولُ الْقائِلُونَ"
  },
  {
   "segment_id": 138,
   "arabic": "أَسْأَلُكَ أَنْ تُصَلِّيَ عَلى مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 139,
   "arabic": "وَأَنْ تُعْطِيَ مُحَمَّداً صَلَّى اللهُ عَلَيْهِ وَآلِهِ"
  },
  {
   "segment_id": 140,
   "arabic": "أَفْضَلَ ما سَأَلَكَ وَأَفْضَلَ ما سُئِلْتَ"
  },
  {
   "segment_id": 141,
   "arabic": "وَأَفْضَلَ ما أَنْتَ مَسْؤُولٌ لَهُ إِلى يَوْمِ الْقِيامَةِ"
  },
  {
   "segment_id": 142,
   "arabic": "اُعيذُ أَهْلَ بَيْتِ النَّبِيِّ مُحَمَّدٍ صَلَّى اللهُ عَلَيْهِ وَآلِهِ"
  },
  {
   "segment_id": 143,
   "arabic": "وَنَفْسي وَديني وَذُرِّيَّتي وَمالي"
  },
  {
   "segment_id": 144,
   "arabic": "وَوَلَدي وَأَهْلي وَقَراباتي وَأَهْلَ بَيْتي"
  },
  {
   "segment_id": 145,
   "arabic": "وَكُلَّ ذي رَحِمٍ لي دَخَلَ فِي الْإِسْلامِ"
  },
  {
   "segment_id": 146,
   "arabic": "أَوْ يَدْخُلُ إِلى يَوْمِ الْقِيامَةِ"
  },
  {
   "segment_id": 147,
   "arabic": "وَحُزانَتي وَخاصَّتي"
  },
  {
   "segment_id": 148,
   "arabic": "وَمَنْ قَلَّدَني دُعاءً أَوْ أَسْدى إِلَيَّ يَداً"
  },
  {
   "segment_id": 149,
   "arabic": "أَوْ رَدَّ عَنّي غَيْبَةً أَوْ قالَ فِيَّ خَيْراً"
  },
  {
   "segment_id": 150,
   "arabic": "أَوِ اتَّخَذْتُ عِنْدَهُ يَداً أَوْ صَنيعَةً"
  },
  {
   "segment_id": 151,
   "arabic": "وَجيراني وَ إِخْواني مِنَ الْمُؤْمِنينَ وَالْمُؤْمِناتِ"
  },
  {
   "segment_id": 152,
   "arabic": "بِاللهِ وَبِأَسْمائِهِ التَّامَّةِ الْعامَّةِ الشَّامِلَةِ الْكامِلَةِ الطَّاهِرَةِ الْفاضِلَةِ الْمُبارَكَةِ الْمُتَعالِيَةِ الزَّاكِيَةِ الشَّريفَةِ الْمَنيعَةِ الْكَريمَةِالْعَظيمَةِ الْمَخْزُونَةِ الْمَكْنُونَةِ"
  },
  {
   "segment_id": 153,
   "arabic": "الَّتي لايُجاوِزُهُنَّ بَرٌّ وَلا فاجِرٌ"
  },
  {
   "segment_id": 154,
   "arabic": "وَبِاُمِّ الْكِتابِ وَخاتِمَتِهِ"
  },
  {
   "segment_id": 155,
   "arabic": "وَما بَيْنَهُما مِنْ سُورَةٍ شَريفَةٍ وَآيَةٍ مُحْكَمَةٍ وَشِفاءٍ وَرَحْمَةٍ وَعَوْذَةٍ وَبَرَكَةٍ"
  },
  {
   "segment_id": 156,
   "arabic": "وَبِالتَّوْريةِ وَالْإِنْجيلِ وَالزَّبُورِ وَالْفُرْقانِ"
  },
  {
   "segment_id": 157,
   "arabic": "وَصُحُفِ إِبْراهيمَ وَمُوسى"
  },
  {
   "segment_id": 158,
   "arabic": "وَبِكُلِّ كِتابٍ أَنْزَلَهُ اللهُ"
  },
  {
   "segment_id": 159,
   "arabic": "وَبِكُلِّ رَسُولٍ أَرْسَلَهُ اللهُ"
  },
  {
   "segment_id": 160,
   "arabic": "وَبِكُلِّ حُجَّةٍ أَقامَهَا اللهُ"
  },
  {
   "segment_id": 161,
   "arabic": "وَبِكُلِّ بُرْهانٍ أَظْهَرَهُ اللهُ"
  },
  {
   "segment_id": 162,
   "arabic": "وَبِكُلِّ نُورٍ أَنارَهُ اللهُ"
  },
  {
   "segment_id": 163,
   "arabic": "وَبِكُلِّ آلاءِ اللهِ وَعَظَمَتِهِ"
  },
  {
   "segment_id": 164,
   "arabic": "اُعيذُ وَأَسْتَعيذُ مِنْ شَرِّ كُلِّ ذِي شَرٍّ"
  },
  {
   "segment_id": 165,
   "arabic": "وَمِنْ شَرِّ ما أَخافُ وَأَحْذَرُ"
  },
  {
   "segment_id": 166,
   "arabic": "وَمِنْ شَرِّ ما رَبّي مِنْهُ أَكْبَرُ"
  },
  {
   "segment_id": 167,
   "arabic": "وَمِنْ شَرِّ فَسَقَةِ الْعَرَبِ وَالْعَجَمِ"
  },
  {
   "segment_id": 168,
   "arabic": "وَمِنْ شَرِّ فَسَقَةِ الْجِنِّ وَالْإِنْسِ"
  },
  {
   "segment_id": 169,
   "arabic": "وَالشَّياطينِ وَالسَّلاطينِ"
  },
  {
   "segment_id": 170,
   "arabic": "وَإِبْليسَ وَجُنُودِهِ وَأَشْياعِهِ وَأَتْباعِهِ"
  },
  {
   "segment_id": 171,
   "arabic": "وَمِنْ شَرِّ ما فِي النُّورِ وَالظُّلْمَةِ"
  },
  {
   "segment_id": 172,
   "arabic": "وَمِنْ شَرِّ ما دَهَمَ أَوْ هَجَمَ أَوْ أَلَمَّ"
  },
  {
   "segment_id": 173,
   "arabic": "وَمِنْ شَرِّ كُلِّ غَمٍّ وَهَمٍّ"
  },
  {
   "segment_id": 174,
   "arabic": "وَآفَةٍ وَنَدَمٍ وَنازِلَةٍ وَسَقَمٍ"
  },
  {
   "segment_id": 175,
   "arabic": "وَمِنْ شَرِّ ما يَحْدُثُ فِي اللَّيْلِ وَالنَّهارِ"
  },
  {
   "segment_id": 176,
   "arabic": "وَتَأْتي بِهِ الْأَقْدارُ"
  },
  {
   "segment_id": 177,
   "arabic": "وَمِنْ شَرِّ فِي النَّارِ"
  },
  {
   "segment_id": 178,
   "arabic": "وَمِنْ شَرِّ ما فِي الْأَرَضينَ وَالْأَقْطارِ"
  },
  {
   "segment_id": 179,
   "arabic": "وَالْفَلَواتِ وَالْقِفارِ وَالْبِحارِ وَالْأَنْهارِ"
  },
  {
   "segment_id": 180,
   "arabic": "وَمِنْ شَرِّ الْفُسَّاقِ وَالْفُجَّارِ وَالْكُهَّانِ"
  },
  {
   "segment_id": 181,
   "arabic": "وَالسُّحَّارِ وَالْحُسَّادِ وَالذُّعَّارِ وَالْأَشْرارِ"
  },
  {
   "segment_id": 182,
   "arabic": "وَمِنْ شَرِّ ما يَلِجُ فِي الْأَرْضِ وَما يَخْرُجُ مِنْها"
  },
  {
   "segment_id": 183,
   "arabic": "وَما يَنْزِلُ مِنَ السَّماءِ وَما يَعْرُجُ إِلَيْها"
  },
  {
   "segment_id": 184,
   "arabic": "وَمِنْ شَرِّ كُلِّ ذي شَرٍّ"
  },
  {
   "segment_id": 185,
   "arabic": "وَمِنْ شَرِّ كُلِّ دابَّةٍ رَبّي آخِذٌ بِناصِيَتِها"
  },
  {
   "segment_id": 186,
   "arabic": "إِنَّ رَبّي عَلى صِراطٍ مُسْتَقيمٍ"
  },
  {
   "segment_id": 187,
   "arabic": "فَإِنْ تَوَلَّوْا فَقُلْ حَسْبِيَ اللهُ"
  },
  {
   "segment_id": 188,
   "arabic": "لا إِلهَ إِلّا هُوَ عَلَيْهِ تَوَكَّلْتُ"
  },
  {
   "segment_id": 189,
   "arabic": "وَهُوَ رَبُّ الْعَرْشِ الْعَظيمِ"
  },
  {
   "segment_id": 190,
   "arabic": "وَأَعُوذُ بِكَ اللَّهُمَّ مِنَ الْهَمِّ وَالْغَمِّ"
  },
  {
   "segment_id": 191,
   "arabic": "وَالْحُزْنِ وَالْعَجْزِ وَالْكَسَلِ وَالْجُبْنِ وَالْبُخْلِ"
  },
  {
   "segment_id": 192,
   "arabic": "وَمِنْ ضَلَعِ الدَّيْنِ وَغَلَبَةِ الرِّجالِ"
  },
  {
   "segment_id": 193,
   "arabic": "وَمِنْ عَمَلٍ لايَنْفَعُ"
  },
  {
   "segment_id": 194,
   "arabic": "وَمِنْ عَيْنٍ لاتَدْمَعُ"
  },
  {
   "segment_id": 195,
   "arabic": "وَمِنْ قَلْبٍ لايَخْشَعُ"
  },
  {
   "segment_id": 196,
   "arabic": "وَمِنْ دُعاءٍ لايُسْمَعُ"
  },
  {
   "segment_id": 197,
   "arabic": "وَمِنْ نَصيحَةٍ لاتَنْجَعُ"
  },
  {
   "segment_id": 198,
   "arabic": "وَمِنْ صَحابَةٍ لاتَرْدَعُ"
  },
  {
   "segment_id": 199,
   "arabic": "وَمِنْ إِجْماعٍ عَلى نُكْرٍ وَتَوَدُّدٍ عَلى خُسْرٍ"
  },
  {
   "segment_id": 200,
   "arabic": "أَوْ تَؤاخُذٍ عَلى خُبْثٍ"
  },
  {
   "segment_id": 201,
   "arabic": "وَمِمَّا اسْتَعاذَ مِنْهُ مَلائِكَتُكَ الْمُقَرَّبُونَ وَالْأَنْبِياءُ الْمُرْسَلُونَ وَالْأَئِمَّةُ الْمُطَهَّرُونَ وَالشُّهَداءُ وَالصَّالِحُونَ وَعِبادُكَ الْمُتَّقُونَ"
  },
  {
   "segment_id": 202,
   "arabic": "وَأَسْأَلُكَ اللَّهُمَّ أَنْ تُصَلِّيَ عَلى مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 203,
   "arabic": "وَأَنْ تُعْطِيَني مِنَ الْخَيْرِ ما سَأَلُوا"
  },
  {
   "segment_id": 204,
   "arabic": "وَأَنْ تُعيذَني مِنْ شَرِّ مَا اسْتَعاذُوا"
  },
  {
   "segment_id": 205,
   "arabic": "وَأَسْأَلُكَ اللَّهُمَّ مِنَ الْخَيْرِ كُلِّهِ عاجِلِهِ وآجِلِهِ"
  },
  {
   "segment_id": 206,
   "arabic": "ما عَلِمْتُ مِنْهُ وَما لَمْ أَعْلَمْ"
  },
  {
   "segment_id": 207,
   "arabic": "وَأَعُوذُ بِكَ رَبِّ مِنْ هَمَزاتِ الشَّياطينِ"
  },
  {
   "segment_id": 208,
   "arabic": "وَأَعُوذُ بِكَ رَبِّ أَنْ يَحْضُرُونِ"
  },
  {
   "segment_id": 209,
   "arabic": "بِسْمِ اللهِ عَلى أَهْلِ بَيْتِ النَّبِيِّ مُحَمَّدٍ صَلَّى اللهُ عَلَيْهِ وَآلِهِ"
  },
  {
   "segment_id": 210,
   "arabic": "بِسْمِ اللهِ عَلى نَفْسي وَديني"
  },
  {
   "segment_id": 211,
   "arabic": "بِسْمِ اللهِ عَلى أَهْلي وَمالي"
  },
  {
   "segment_id": 212,
   "arabic": "بِسْمِ اللهِ عَلى كُلِّ شَيْ‏ءٍ أَعْطاني رَبّي"
  },
  {
   "segment_id": 213,
   "arabic": "بِسْمِ اللهِ عَلى أَحِبَّتي وَوَلَدي وَقَراباتي"
  },
  {
   "segment_id": 214,
   "arabic": "بِسْمِ اللهِ عَلى جيراني وَ إِخْواني"
  },
  {
   "segment_id": 215,
   "arabic": "وَمَنْ قَلَّدَني دُعاءً أَوِ اتَّخَذَ عِنْدي يَداً"
  },
  {
   "segment_id": 216,
   "arabic": "أَوِ ابْتَدَءَ إِلَيَّ بِرّاً مِنَ الْمُؤْمِنينَ وَالْمُؤْمِناتِ"
  },
  {
   "segment_id": 217,
   "arabic": "بِسْمِ اللهِ عَلى ما رَزَقَني رَبّي وَيَرْزُقُني"
  },
  {
   "segment_id": 218,
   "arabic": "بِسْمِ اللهِ الَّذي لايَضُرُّ مَعَ اسْمِهِ شَيْ‏ءٌ فِي الْأَرْضِ وَلا فِي السَّماءِ"
  },
  {
   "segment_id": 219,
   "arabic": "وَهُوَ السَّميعُ الْعَليمُ"
  },
  {
   "segment_id": 220,
   "arabic": "أَللَّهُمَّ صَلِّ عَلى مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 221,
   "arabic": "وَصِلْني بِجَميعِ ما سَأَلَكَ عِبادُكَ الْمُؤْمِنُونَ"
  },
  {
   "segment_id": 222,
   "arabic": "أَنْ تَصِلَهُمْ بِهِ مِنَ الْخَيْرِ"
  },
  {
   "segment_id": 223,
   "arabic": "وَاصْرِفْ عَنّي جَميعَ ما سَأَلَكَ عِبادُكَ الْمُؤْمِنُونَ"
  },
  {
   "segment_id": 224,
   "arabic": "أَنْ تَصْرِفَهُ عَنْهُمْ مِنَ السُّوءِ وَالرَّدى"
  },
  {
   "segment_id": 225,
   "arabic": "وَزِدْني مِنْ فَضْلِكَ ما أَنْتَ أَهْلُهُ وَوَلِيُّهُ"
  },
  {
   "segment_id": 226,
   "arabic": "يا أَرْحَمَ الرَّاحِمينَ"
  },
  {
   "segment_id": 227,
   "arabic": "أَللَّهُمَّ صَلِّ عَلى مُحَمَّدٍ وَأَهْلِ بَيْتِهِ الطَّيِّبينَ"
  },
  {
   "segment_id": 228,
   "arabic": "وَعَجِّلِ اللَّهُمَّ فَرَجَهُمْ وَفَرَجي وَفَرِّجْ عَنْ كُلِّ مَهْمُومٍ مِنَ الْمُؤْمِنينَ وَالْمُؤْمِناتِ"
  },
  {
   "segment_id": 229,
   "arabic": "أَللَّهُمَّ صَلِّ عَلى مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 230,
   "arabic": "وَارْزُقْني نَصْرَهُمْ وَأَشْهِدْني أَيَّامَهُمْ"
  },
  {
   "segment_id": 231,
   "arabic": "وَاجْمَعْ بَيْني وَبَيْنَهُمْ فِي الدُّنْيا وَالْآخِرَةِ"
  },
  {
   "segment_id": 232,
   "arabic": "وَاجْعَلْ مِنْكَ عَلَيْهِمْ واقِيَةً حَتَّى لايُخْلَصَ إِلَيْهِمْ إِلّا بِسَبيلِ خَيْرٍ وَعَلَيَّ مَعَهُمْ"
  },
  {
   "segment_id": 233,
   "arabic": "وَعَلى شيعَتِهِمْ وَمُحِبّيهِمْ وَعَلى أَوْلِيائِهِمْ"
  },
  {
   "segment_id": 234,
   "arabic": "وَعَلى جَميعِ الْمُؤْمِنينَ وَالْمُؤْمِناتِ"
  },
  {
   "segment_id": 235,
   "arabic": "فَإِنَّكَ عَلى كُلِّ شَيْ‏ءٍ قَديرٌ"
  },
  {
   "segment_id": 236,
   "arabic": "بِسْمِ اللهِ وَبِاللهِ وَمِنَ اللهِ وَ إِلَى اللهِ"
  },
  {
   "segment_id": 237,
   "arabic": "وَلا غالِبَ إِلّاَ اللهُ ، ما شاءَ اللهُ"
  },
  {
   "segment_id": 238,
   "arabic": "لا قُوَّةَ إِلّا بِاللهِ حَسْبِيَ اللهُ تَوَكَّلْتُ عَلَى اللهِ"
  },
  {
   "segment_id": 239,
   "arabic": "وَاُفَوِّضُ أَمْري إِلَى اللهِ وَأَلْتَجِئُ إِلَى اللهِ"
  },
  {
   "segment_id": 240,
   "arabic": "وَبِاللهِ اُحاوِلُ وَاُصاوِلُ وَاُكاثِرُ"
  },
  {
   "segment_id": 241,
   "arabic": "وَاُفاخِرُ وَأَعْتَزُّ وَأَعْتَصِمُ"
  },
  {
   "segment_id": 242,
   "arabic": "عَلَيْهِ تَوَكَّلْتُ وَ إِلَيْهِ مَتابُ"
  },
  {
   "segment_id": 243,
   "arabic": "لا إِلهَ إِلّاَ اللهُ الْحَيُّ الْقَيُّومُ"
  },
  {
   "segment_id": 244,
   "arabic": "عَدَدَ الثَّرى وَالنُّجُومِ وَالْمَلائِكَةِ الصُّفُوفِ"
  },
  {
   "segment_id": 245,
   "arabic": "لا إِلهَ إِلّاَ اللهُ وَحْدَهُ لا شَريكَ لَهُ الْعَلِيُّ الْعَظيمُ"
  },
  {
   "segment_id": 246,
   "arabic": "لا إِلهَ إِلّاَ اللهُ سُبْحانَكَ إِنّي كُنْتُ مِنَ الظَّالِمينَ"
  }
 ]
}