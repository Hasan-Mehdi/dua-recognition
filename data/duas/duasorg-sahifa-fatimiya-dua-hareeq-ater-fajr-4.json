   "segment_id": 56,
   "arabic": "أَللَّهُمَّ صَلِّ عَلى مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 57,
   "arabic": "كَما أَمَرْتَنا أَنْ نُصَلِّيَ عَلَيْهِ"
  },
  {
   "segment_id": 58,
   "arabic": "أَللَّهُمَّ صَلِّ عَلى مُحَمّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 59,
   "arabic": "كَما يَنْبَغي لَنا أَنْ نُصَلِّيَ عَلَيْهِ"
  },
  {
   "segment_id": 60,
   "arabic": "أَللَّهُمَّ صَلِّ عَلى مُحَمّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 61,
   "arabic": "بِعَدَدِ مَنْ صَلَّى عَلَيْهِ"
