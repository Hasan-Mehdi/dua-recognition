  {
   "segment_id": 78,
   "arabic": "وَبِعَدَدِ زِنَةِ ذَرِّ ما عَمِلُوا أَوْ يَعْمَلُونَ"
  },
  {
   "segment_id": 79,
   "arabic": "أَوْ بَلَغَهُمْ أَوْ رَأَوْا أَوْ ظَنُّوا أَوْ فَطِنُوا"
