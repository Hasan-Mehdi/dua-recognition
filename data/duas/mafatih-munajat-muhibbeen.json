{
 "dua_id": "mafatih-munajat-muhibbeen",
 "dua_name_en": "Munajat Muhibbeen",
 "dua_name_ar": "مناجاة المحبين",
 "source": "Mafatih al-Jinan (github.com/kazemcodes/MafatihDecoder); lines from reciters' pauses",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "إِلهي مَنْ ذَا الَّذي ذاقَ حَلاوَةَ مَحَبَّتِكَ فَرامَ مِنْكَ بَدَلاً"
  },
  {
   "segment_id": 2,
   "arabic": "وَمَنْ ذَا الَّذي أَنِسَ بِقُرْبِكَ فَابْتَغى عَنْكَ حِوَلاً"
  },
  {
   "segment_id": 3,
   "arabic": "إِلهي فَاجْعَلْنا مِمَّنِ اصْطَفَيْتَهُ لِقُرْبِكَ وَوِلايَتِكَ"
  },
  {
   "segment_id": 4,
   "arabic": "وَأَخْلَصْتَهُ لِوُدِّكَ وَمَحَبَّتِكَ"
  },
  {
   "segment_id": 5,
   "arabic": "وَشَوَّقْتَهُ إِلى لِقائِكَ وَرَضَّيْتَهُ بِقَضائِكَ"
  },
  {
   "segment_id": 6,
   "arabic": "وَمَنَحْتَهُ بِالنَّظَرِ إِلى وَجْهِكَ وَحَبَوْتَهُ بِرِضاكَ"
  },
  {
   "segment_id": 7,
   "arabic": "وَأَعَذْتَهُ مِنْ هَجْرِكَ وَقِلاكَ"
  },
  {
   "segment_id": 8,
   "arabic": "وَبَوَّأْتَهُ مَقْعَدَ الصِّدْقِ في جِوارِكَ"
  },
  {
   "segment_id": 9,
   "arabic": "وَخَصَصْتَهُ بِمَعْرِفَتِكَ وَأَهَّلْتَهُ لِعِبادَتِكَ"
  },
  {
   "segment_id": 10,
   "arabic": "وَهَيَّمْتَ قَلْبَهُ لإِرادَتِكَ وَاجْتَبَيْتَهُ لِمُشاهَدَتِكَ"
  },
  {
   "segment_id": 11,
   "arabic": "وَأَخْلَيْتَ وَجْهَهُ لَكَ وَفَرَّغْتَ فُؤادَهُ لِحُبِّكَ"
  },
  {
   "segment_id": 12,
   "arabic": "وَرَغَّبْتَهُ فيما عِنْدَكَ وَأَلْهَمْتَهُ ذِكْرَكَ"
  },
  {
   "segment_id": 13,
   "arabic": "وَأَوْزَعْتَهُ شُكْرَكَ وَشَغَلْتَهُ بِطاعَتِكَ"
  },
  {
   "segment_id": 14,
   "arabic": "وَصَيَّرْتَهُ مِنْ صالِحي بَرِيَّتِكَ"
  },
  {
   "segment_id": 15,
   "arabic": "وَاخْتَرْتَهُ لِمُناجاتِكَ"
  },
  {
   "segment_id": 16,
   "arabic": "وَقَطَعْتَ عَنْهُ كُلَّ شَيْءٍ يَقْطَعُهُ عَنْكَ"
  },
  {
   "segment_id": 17,
   "arabic": "اَللّهُمَّ اجْعَلْنا مِمَّنْ دَأْبُهُمُ الإِرْتِياحُ إِلَيْكَ وَالْحَنينُ"
  },
  {
   "segment_id": 18,
   "arabic": "وَدَهْرُهُمُ الزَّفْرَةُ وَالأَنينُ"
  },
  {
   "segment_id": 19,
   "arabic": "جِباهُهُمْ ساجِدَةٌ لِعَظَمَتِكَ"
  },
  {
   "segment_id": 20,
   "arabic": "وَعُيُونُهُمْ ساهِرَةٌ في خِدْمَتِكَ"
  },
  {
   "segment_id": 21,
   "arabic": "وَدُمُوعُهُمْ سائِلَةٌ مِنْ خَشْيَتِكَ"
  },
  {
   "segment_id": 22,
   "arabic": "وَقُلُوبُهُمْ مُتَعَلِّقَةٌ بِمَحَبَّتِكَ"
  },
  {
   "segment_id": 23,
   "arabic": "وَأَفْئِدَتُهُمْ مُنْخَلِعَةٌ مِنْ مَهابَتِكَ"
  },
  {
   "segment_id": 24,
   "arabic": "يا مَنْ أَنْوارُ قُدْسِهِ لأَبْصارِ مُحِبّيهِ رائِقَةٌ"
  },
  {
   "segment_id": 25,
   "arabic": "وَسُبُحاتُ وَجْهِهِ لِقُلُوبِ عارِفيهِ شائِفَةٌ"
  },
  {
   "segment_id": 26,
   "arabic": "يا مُنى قُلُوبِ الْمُشْتاقينَ وَيا غايَةَ آمالِ الْمُحِبّينَ"
  },
  {
   "segment_id": 27,
   "arabic": "أَسْئَلُكَ حُبَّكَ وَحُبَّ مَنْ يُحِبُّكَ"
  },
  {
   "segment_id": 28,
   "arabic": "وَحُبَّ كُلِّ عَمَلٍ يُوصِلُني إِلى قُرْبِكَ"
  },
  {
   "segment_id": 29,
   "arabic": "وَأَنْ تَجْعَلَكَ أَحَبَّ إِلَيَّ مِمّا سِواكَ"
  },
  {
   "segment_id": 30,
   "arabic": "وَأَنْ تَجْعَلَ حُبّي إِيّاكَ قائِداً إِلى رِضْوانِكَ"
  },
  {
   "segment_id": 31,
   "arabic": "وَشَوْقي إِلَيْكَ ذائِداً عَنْ عِصْيانِكَ"
  },
  {
   "segment_id": 32,
   "arabic": "وَامْنُنْ بِالنَّظَرِ إِلَيْكَ عَلَيَّ وَانْظُرْ بِعَيْنِ الْوُدِّ وَالْعَطْفِ إِلَيَّ"
  },
  {
   "segment_id": 33,
   "arabic": "وَلا تَصْرِفْ عَنّي وَجْهَكَ"
  },
  {
   "segment_id": 34,
   "arabic": "وَاجْعَلْني مِنْ أَهْلِ الإِسْعادِ وَالْحِظْوَةِ عِنْدَكَ"
  },
  {
   "segment_id": 35,
   "arabic": "يا مُجيبُ يا أَرْحَمَ الرّاحِمينَ"
  }
 ]
}