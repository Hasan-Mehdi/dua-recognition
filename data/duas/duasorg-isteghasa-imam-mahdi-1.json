{
 "dua_id": "duasorg-isteghasa-imam-mahdi-1",
 "dua_name_en": "Isteghasa (seeking aid) - Imam Mahdi (atfs)",
 "dua_name_ar": "",
 "source": "https://www.duas.org/isteghasa-imam-mahdi.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "سَلاَمُ ٱللَّهِ ٱلْكَامِلُ ٱلتَّامُّ"
  },
  {
   "segment_id": 2,
   "arabic": "ٱلشَّامِلُ ٱلْعَامُّ"
  },
  {
   "segment_id": 3,
   "arabic": "وَصَلَوَاتُهُ ٱلدَّائِمَةُ"
  },
  {
   "segment_id": 4,
   "arabic": "وَبَرَكَاتُهُ ٱلْقَائِمَةُ ٱلتَّامَّةُ"
  },
  {
   "segment_id": 5,
   "arabic": "عَلَىٰ حُجَّةِ ٱللَّهِ"
  },
  {
   "segment_id": 6,
   "arabic": "وَوَلِيِّهِ فِي ارْضِهِ وَبِلادِهِ"
  },
  {
   "segment_id": 7,
   "arabic": "وَخَلِيفَتِهِ عَلَىٰ خَلْقِهِ وَعِبَادِهِ"
  },
  {
   "segment_id": 8,
   "arabic": "وَسُلالَةِ ٱلنُّبُوَّةِ"
  },
  {
   "segment_id": 9,
   "arabic": "وَبَقِيَّةِ ٱلْعِتْرَةِ وَٱلصَّفْوَةِ"
  },
  {
   "segment_id": 10,
   "arabic": "صَاحِبِ ٱلزَّمَانِ"
  },
  {
   "segment_id": 11,
   "arabic": "وَمُظْهِرِ ٱلإِيـمَانِ"
  },
  {
   "segment_id": 12,
   "arabic": "وَمُلَقِّنِ احْكَامِ ٱلْقُرْآنِ"
  },
  {
   "segment_id": 13,
   "arabic": "وَمُطَهِّرِ ٱلارْضِ"
  },
  {
   "segment_id": 14,
   "arabic": "وَنَاشِرِ ٱلْعَدْلِ فِي ٱلطُّولِ وَٱلْعَرْضِ"
  },
  {
   "segment_id": 15,
   "arabic": "وَٱلْحُجَّةِ ٱلْقَائِمِ ٱلْمَهْدِيِّ"
  },
  {
   "segment_id": 16,
   "arabic": "ٱلإِمَامِ ٱلْمُنْتَظَرِ ٱلْمَرْضِيِّ"
  },
  {
   "segment_id": 17,
   "arabic": "وَٱبْنِ ٱلائِمَّةِ ٱلطَّاهِرِينَ"
  },
  {
   "segment_id": 18,
   "arabic": "ٱلْوَصِيِّ ٱبْنِ ٱلاوْصِيَاءِ ٱلْمَرْضِيِّينَ"
  },
  {
   "segment_id": 19,
   "arabic": "ٱلْهَادِي ٱلْمَعْصُومِ"
  },
  {
   "segment_id": 20,
   "arabic": "ٱبْنِ ٱلائِمَّةِ ٱلْهُدَاةِ ٱلْمَعْصُومِينَ"
  },
  {
   "segment_id": 21,
   "arabic": "السَّلاَمُ عَلَيْكَ يَا مُعِزَّ ٱلْمُؤْمِنِينَ ٱلْمُسْتَضْعَفِينَ"
  },
  {
   "segment_id": 22,
   "arabic": "السَّلامُ عَلَيْكَ يَا مُذِلَّ ٱلْكَافِرِينَ ٱلْمُتَكَبِّرِينَ ٱلظَّالِمِينَ"
  },
  {
   "segment_id": 23,
   "arabic": "السَّلامُ عَلَيْكَ يَا مَوْلايَ يَا صَاحِبَ ٱلزَّمَانِ"
  },
  {
   "segment_id": 24,
   "arabic": "السَّلامُ عَلَيْكَ يَا بْنَ رَسُولِ ٱللَّهِ"
  },
  {
   "segment_id": 25,
   "arabic": "السَّلامُ عَلَيْكَ يَا بْنَ امِيرِ ٱلْمُؤْمِنِينَ"
  },
  {
   "segment_id": 26,
   "arabic": "السّلامُ عَلَيْكَ يَا بْنَ فَاطِمَةَ ٱلزَّهْرَاءِ"
  },
  {
   "segment_id": 27,
   "arabic": "سَيِّدَةِ نِسَاءِ ٱلْعَالَمِينَ"
  },
  {
   "segment_id": 28,
   "arabic": "السَّلامُ عَلَيْكَ يَا بْنَ ٱلائِمَّةِ ٱلْحُجَجِ ٱلْمَعْصُومِينَ"
  },
  {
   "segment_id": 29,
   "arabic": "وَٱلإِمَامُ عَلَىٰ ٱلْخَلْقِ اجْمَعِينَ"
  },
  {
   "segment_id": 30,
   "arabic": "السَّلامُ عَلَيْكَ يَا مَوْلايَ"
  },
  {
   "segment_id": 31,
   "arabic": "سَلامَ مُخْلِصٍ لَكَ فِي ٱلْوِلايَةِ"
  },
  {
   "segment_id": 32,
   "arabic": "اشْهَدُ انَّكَ ٱلإِمَامُ ٱلْمَهْدِيُّ قَوْلاً وَفِعْلاً"
  },
  {
   "segment_id": 33,
   "arabic": "وَانْتَ ٱلَّذِي تَمْلَا ٱلارْضَ قِسْطاً وَعَدْلاً"
  },
  {
   "segment_id": 34,
   "arabic": "بَعْدَ مَا مُلِئَتْ ظُلْماً وَجَوْراً"
  },
  {
   "segment_id": 35,
   "arabic": "فَعَجَّلَ ٱللَّهُ فَرَجَكَ"
  },
  {
   "segment_id": 36,
   "arabic": "وَسَهَّلَ مَخْرَجَكَ"
  },
  {
   "segment_id": 37,
   "arabic": "وَقَرَّبَ زَمَانَكَ"
  },
  {
   "segment_id": 38,
   "arabic": "وَكَثَّرَ انْصَارَكَ وَاعْوَانَكَ"
  },
  {
   "segment_id": 39,
   "arabic": "وَانْجَزَ لَكَ مَا وَعَدَكَ"
  },
  {
   "segment_id": 40,
   "arabic": "فَهُوَ اصْدَقُ ٱلْقَائِلِينَ:"
  },
  {
   "segment_id": 41,
   "arabic": "(وَنُرِيدُ انْ نَمُنَّ عَلَىٰ ٱلَّذِينَ ٱسْتُضْعِفُوا فِي ٱلارْضِ"
  },
  {
   "segment_id": 42,
   "arabic": "وَنَجْعَلَهُمْ ائِمَّةً وَنَجْعَلَهُمُ ٱلْوَارِثِينَ)"
  },
  {
   "segment_id": 43,
   "arabic": "يَا مَوْلايَ يَا صَاحِبَ ٱلزَّمَانِ"
  },
  {
   "segment_id": 44,
   "arabic": "يَا بْنَ رَسُولِ ٱللَّهِ"
  },
  {
   "segment_id": 45,
   "arabic": "حَاجَتِي…"
  },
  {
   "segment_id": 46,
   "arabic": "فَٱشْفَعْ لِي فِي نَجَاحِهَا"
  },
  {
   "segment_id": 47,
   "arabic": "فَقَدْ تَوَجَّهْتُ إِلَيْكَ بِحَاجَتِي"
  },
  {
   "segment_id": 48,
   "arabic": "لِعِلْمِي انَّ لَكَ عِنْدَ ٱللَّهِ شَفَاعَةً مَقْبُولَةً"
  },
  {
   "segment_id": 49,
   "arabic": "وَمَقَاماً مَحْمُوداً"
  },
  {
   "segment_id": 50,
   "arabic": "فَبِحَقِّ مَنِ ٱخْتَصَّكُمْ بِامْرِهِ"
  },
  {
   "segment_id": 51,
   "arabic": "وَٱرْتَضَاكُمْ لِسِرِّهِ"
  },
  {
   "segment_id": 52,
   "arabic": "وَبِٱلشَّانِ ٱلَّذِي لَكُمْ عِنْدَ ٱللَّهِ بَيْنَكُمْ وَبَيْنَهُ"
  },
  {
   "segment_id": 53,
   "arabic": "سَلِ ٱللَّهَ تَعَالَىٰ فِي نُجْحِ طَلِبَتِي"
  },
  {
   "segment_id": 54,
   "arabic": "وَإِجَابَةِ دَعْوَتِي"
  },
  {
   "segment_id": 55,
   "arabic": "وَكَشْفِ كُرْبَتِي"
  }
 ]
}