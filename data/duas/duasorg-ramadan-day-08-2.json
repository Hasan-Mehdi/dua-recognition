{
 "dua_id": "duasorg-ramadan-day-08-2",
 "dua_name_en": "Ramadan Day 8 · from the Prophet (s)",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-day-08.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَ آلِ مُحَمَّد"
  },
  {
   "segment_id": 2,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ"
  },
  {
   "segment_id": 3,
   "arabic": "اَللَّهُمَّ هذِا شَهْرُكَ الَّذِي أَمَرْتَ فِيهِ عِبَادَكَ بِالدُّعَاءِ"
  },
  {
   "segment_id": 4,
   "arabic": "وَضَمِنْتَ لَهُمُ الإِجَابَةَ وَالرَّحْمَةَ"
  },
  {
   "segment_id": 5,
   "arabic": "وَقُلْتَ ﴿وَإِذَا سَأَلَكَ عِبَادِي عَنِّي فَإِنِّي قَرِيبٌ أُجِيبُ دَعْوَةَ الدَّاعِي إِذَا دَعَانِي﴾ فَأَدْعُوكَ يَا مُجِيبَ دَعْوَةِ الْمُضْطَرِّينَ"
  },
  {
   "segment_id": 6,
   "arabic": "وَيَا كَاشِفَ السُّوءِ عَنِ الْمَكْرُوبِينَ"
  },
  {
   "segment_id": 7,
   "arabic": "وَيَا جَاعِلَ اللَّيْلِ سَكَناً"
  },
  {
   "segment_id": 8,
   "arabic": "وَيَا مَنْ لاَ يَمُوتُ اغْفِرْ لِمَنْ يَمُوتُ"
  },
  {
   "segment_id": 9,
   "arabic": "قَدَّرْتَ وَخَلَقْتَ وَسَوَّيْتَ"
  },
  {
   "segment_id": 10,
   "arabic": "فَلَكَ الْحَمْدُ أَطْعَمْتَ وَسَقَيْتَ وَآوَيْتَ وَرَزَقْتَ"
  },
  {
   "segment_id": 11,
   "arabic": "فَلَكَ الْحَمْدُ وَأَسْأَلُكَ أَنْ تُصَلِّيَ عَلى مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 12,
   "arabic": "فِي اللَّيْلِ إِذَا يَغَشى"
  },
  {
   "segment_id": 13,
   "arabic": "وَفِي النَّهَارِ إِذَا تَجَلّى"
  },
  {
   "segment_id": 14,
   "arabic": "وَفِي الآخِرَةِ وَالأُولَى"
  },
  {
   "segment_id": 15,
   "arabic": "وَأَنْ تَكْفِينِي مَا أَهَمَّنِي وَتَغْفِرَ لِي"
  },
  {
   "segment_id": 16,
   "arabic": "إِنَّكَ أَنْتَ الْغَفُورُ الرَّحِيمُ."
  }
 ]
}