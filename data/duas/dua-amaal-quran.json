  },
  {
   "segment_id": 2,
   "arabic": "اللَّهُمَّ إِنِّي أَسْأَلُكَ بِكِتَابِكَ الْمُنْزَلِ وَ مَا فِيهِ"
  },
  {
   "segment_id": 3,
   "arabic": "وَ فِيهِ اسْمُكَ الْأَكْبَرُ وَ أَسْمَاؤُكَ الْحُسْنَى"
  },
  {
   "segment_id": 4,
   "arabic": "وَ مَا يُخَافُ وَ يُرْجَى أَنْ تَجْعَلَنِي مِنْ عُتَقَائِكَ مِنَ النَّارِ"
  },
  {
   "segment_id": 5,
   "arabic": ""
  },
  {
   "segment_id": 6,
   "arabic": "اللّهُمّ بِحَقّ هذَا القُرْآنِ"
  },
  {
   "segment_id": 7,
   "arabic": "وَبِحَقّ مَنْ أَرْسَلْتَهُ بِهِ"
  },
  {
   "segment_id": 8,
   "arabic": "وَبِحَقّ كُلّ مُؤْمِنٍ مَدَحْتَهُ فِيهِ"
  },
  {
   "segment_id": 9,
   "arabic": "وَبِحَقّكَ عَلَيْهِمْ"
  },
  {
   "segment_id": 10,
   "arabic": "فَال أَحَدَ أَعْرَفُ بِحَقّكَ مِنْكَ."
  },
  {
   "segment_id": 11,
   "arabic": "بِكَ يَا اللّهُ،"
  },
  {
   "segment_id": 12,
   "arabic": "بِمُحَمّدٍ،"
  },
  {
   "segment_id": 13,
   "arabic": "بِعَلِيّ،"
  },
  {
   "segment_id": 14,
   "arabic": "بِفَاطِمَةَ،"
  },
  {
   "segment_id": 15,
   "arabic": "بِالحَسَنِ،"
  },
  {
   "segment_id": 16,
   "arabic": "بِالحُسَيْنِ،"
  },
  {
   "segment_id": 17,
   "arabic": "بِعَلِيّ بْنِ الحُسَيْنِ،"
  },
  {
