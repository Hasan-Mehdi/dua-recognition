 "segments": [
  {
   "segment_id": 1,
   "arabic": "يَا حَيُّ يَا قَيُّومُ"
  },
  {
   "segment_id": 2,
   "arabic": "بِرَحْمَتِكَ أَسْتَغِيثُ فَأَغِثْنِي"
  },
  {
   "segment_id": 3,
   "arabic": "اللَّهُمَّ زَحْزِحْنِي عَنِ النَّارِ"
  },
  {
   "segment_id": 4,
   "arabic": "وَ أَدْخِلْنِي الْجَنَّةَ"
  },
  {
   "segment_id": 5,
   "arabic": "وَ أَلْحِقْنِي بِأَبِي مُحَمَّدٍ"
  },
  {
   "segment_id": 6,
   "arabic": "صَلَّى اللَّهُ عَلَيْهِ وَ آلِهِ"
  }
 ]
}