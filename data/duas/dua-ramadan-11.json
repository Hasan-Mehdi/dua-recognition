{
 "dua_id": "dua-ramadan-11",
 "dua_name_en": "Day 11",
 "dua_name_ar": " شهر رمضان ١١  ",
 "source": "https://www.duaplayer.org/en/dua/ramadan-11",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "اللّهُمّ حَبّبْ إِلَيّ فِيهِ الإِحْسَانَ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَكَرّهْ إِلَيّ فِيهِ الفُسُوقَ وَالعِصْيَانَ،"
  },
  {
   "segment_id": 5,
   "arabic": "وَحَرّمْ عَلَيّ فِيهِ السّخَطَ وَالنّيرَانَ،"
  },
  {
   "segment_id": 6,
   "arabic": "بِعَوْنِكَ يَا غِيَاثَ المُسْتَغِيثِينَ."
  }
 ]
}