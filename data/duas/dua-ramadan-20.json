{
 "dua_id": "dua-ramadan-20",
 "dua_name_en": "Day 20",
 "dua_name_ar": " شهر رمضان ٢٠",
 "source": "https://www.duaplayer.org/en/dua/ramadan-20",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "اللّهُمّ افْتَحْ لِي فِيهِ أَبْوَابَ الجِنَانِ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَأَغْلِقْ عَنّي فِيهِ أَبْوَابَ النّيرَانِ،"
  },
  {
   "segment_id": 5,
   "arabic": "وَوَفّقْنِي فِيهِ لِتِلاوَةِ القُرْآنِ،"
  },
  {
   "segment_id": 6,
   "arabic": "يَا مُنْزِلَ السّكِينَةِ فِي قُلُوبِ المُؤْمِنِينَ."
  }
 ]
}