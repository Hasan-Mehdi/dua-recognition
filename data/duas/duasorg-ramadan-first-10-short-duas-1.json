{
 "dua_id": "duasorg-ramadan-first-10-short-duas-1",
 "dua_name_en": "Allahumma Rabba Shahr Ramadan",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ramadan-first-10-short-duas.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اللَّهُمَّ رَبَّ شَهْرِ رَمَضَانَ"
  },
  {
   "segment_id": 2,
   "arabic": "مُنَزِّلَ ٱلْقُرْآنِ"
  },
  {
   "segment_id": 3,
   "arabic": "هٰذَا شَهْرُ رَمَضَانَ"
  },
  {
   "segment_id": 4,
   "arabic": "ٱلَّذِي أَنْزَلْتَ فِيهِ ٱلْقُرْآنَ"
  },
  {
   "segment_id": 5,
   "arabic": "وَأَنْزَلْتَ فِيهِ آيَاتٍ بَيِّنَاتٍ مِنَ ٱلْهُدَىٰ وَٱلْفُرْقَانِ"
  },
  {
   "segment_id": 6,
   "arabic": "اللَّهُمَّ ٱرْزُقْنَا صِيَامَهُ"
  },
  {
   "segment_id": 7,
   "arabic": "وَأَعِنَّا عَلَىٰ قِيَامِهِ"
  },
  {
   "segment_id": 8,
   "arabic": "اللَّهُمَّ سَلِّمْهُ لَنَا"
  },
  {
   "segment_id": 9,
   "arabic": "وَسَلِّمْنَا فِيهِ"
  },
  {
   "segment_id": 10,
   "arabic": "وَتَسَلَّمْهُ مِنَّا فِي يُسْرٍ مِنْكَ وَمُعَافَاةٍ"
  },
  {
   "segment_id": 11,
   "arabic": "وَٱجْعَلْ فِي مَا تَقْضِي وَتُقَدِّرُ"
  },
  {
   "segment_id": 12,
   "arabic": "مِنَ ٱلأَمْرِ ٱلْمَحْتُومِ"
  },
  {
   "segment_id": 13,
   "arabic": "وَفِيمَا تَفْرُقُ مِنَ ٱلأَمْرِ ٱلْحَكِيمِ"
  },
  {
   "segment_id": 14,
   "arabic": "فِي لَيْلَةِ ٱلْقَدْرِ"
  },
  {
   "segment_id": 15,
   "arabic": "مِنَ ٱلْقَضَاءِ ٱلَّذِي لاَ يُرَدُّ وَلاَ يُبَدَّلُ"
  },
  {
   "segment_id": 16,
   "arabic": "أَنْ تَكْتُبَنِي مِنْ حُجَّاجِ بَيْتِكَ ٱلْحَرَامِ"
  },
  {
   "segment_id": 17,
   "arabic": "ٱلْمَبْرُورِ حَجُّهُمُ"
  },
  {
   "segment_id": 18,
   "arabic": "ٱلْمَشْكُورِ سَعْيُهُمُ"
  },
  {
   "segment_id": 19,
   "arabic": "ٱلْمَغْفُورِ ذُنُوبُهُمُ"
  },
  {
   "segment_id": 20,
   "arabic": "ٱلْمُكَفَّرِ عَنْهُمْ سَيِّئَاتُهُمْ"
  },
  {
   "segment_id": 21,
   "arabic": "وَٱجْعَلْ فِي مَا تَقْضِي وَتُقَدِّرُ"
  },
  {
   "segment_id": 22,
   "arabic": "أَنْ تُطِيلَ لِي فِي عُمْرِي"
  },
  {
   "segment_id": 23,
   "arabic": "وَتُوَسِّعَ عَلَيَّ مِنَ ٱلرِّزْقِ ٱلْحَلاَلِ"
  }
 ]
}