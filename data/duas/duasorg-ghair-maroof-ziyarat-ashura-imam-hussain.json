{
 "dua_id": "duasorg-ghair-maroof-ziyarat-ashura-imam-hussain",
 "dua_name_en": "Ghair Maroof - Ziyarat Ashura",
 "dua_name_ar": "",
 "source": "https://www.duas.org/ghair-maroof-ziyarat-ashura-imam-hussain.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا بْنَ رَسُولِ ٱللَّهِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا بْنَ ٱلْبَشِيرِ ٱلنَّذِيرِ"
  },
  {
   "segment_id": 3,
   "arabic": "وَٱبْنَ سَيِّدِ ٱلْوَصِيِّينَ"
  },
  {
   "segment_id": 4,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا بْنَ فَاطِمَةَ"
  },
  {
   "segment_id": 5,
   "arabic": "سَيِّدَةِ نِسَاءِ ٱلْعَالَمِينَ"
  },
  {
   "segment_id": 6,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا خِيَرَةِ ٱللَّهِ وَٱبْنَ خِيَرَتِهِ"
  },
  {
   "segment_id": 7,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا ثَارَ ٱللَّهِ وَٱبْنَ ثَارِهِ"
  },
  {
   "segment_id": 8,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ أَيُّهَا ٱلْوِتْرُ ٱلْمَوْتُورُ"
  },
  {
   "segment_id": 9,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ أَيُّهَا ٱلإِمَامُ ٱلْهَادِي ٱلزَّكِيُّ"
  },
  {
   "segment_id": 10,
   "arabic": "وَعَلَىٰ أَرْوَاحٍ حَلَّتْ بِفَنَائِكَ"
  },
  {
   "segment_id": 11,
   "arabic": "وَأَقَامَتْ فِي جَوَارِكَ"
  },
  {
   "segment_id": 12,
   "arabic": "وَوَفَدَتْ مَعَ زُوَّارِكَ"
  },
  {
   "segment_id": 13,
   "arabic": "اَلسَّلاَمُ عَلَيْكَ مِنِّي مَا بَقيتُ وَبَقِيَ ٱللَّيْلُ وَٱلنَّهَارُ"
  },
  {
   "segment_id": 14,
   "arabic": "فَلَقَدْ عَظُمَتْ بِكَ ٱلرَّزِيَّةُ"
  },
  {
   "segment_id": 15,
   "arabic": "وَجَلَّتْ فِي ٱلْمُؤْمِنِينَ وَٱلْمُسْلِمِينَ"
  },
  {
   "segment_id": 16,
   "arabic": "وَفِي أَهْلِ ٱلسَّمَاوَاتِ وَأَهْلِ ٱلأَرَضِينَ أَجْمَعِينَ"
  },
  {
   "segment_id": 17,
   "arabic": "فَإِنَّا لِلَّهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ"
  },
  {
   "segment_id": 18,
   "arabic": "صَلَوَاتُ ٱللَّهِ وَبَرَكَاتُهُ وَتَحِيَّاتُهُ"
  },
  {
   "segment_id": 19,
   "arabic": "عَلَيْكَ يَا أَبَا عَبْدِ ٱللَّهِ ٱلْحُسَيْنُ"
  },
  {
   "segment_id": 20,
   "arabic": "وَعَلَىٰ آبَائِكَ ٱلطَّيِّبِينَ ٱلْمُنْتَجَبِينَ"
  },
  {
   "segment_id": 21,
   "arabic": "وَعَلَىٰ ذُرِّيَّاتِكُمُ ٱلْهُدَاةِ ٱلْمَهْدِيِّينَ"
  },
  {
   "segment_id": 22,
   "arabic": "لَعَنَ ٱللَّهُ أُمَّةً خَذَلَتْكَ"
  },
  {
   "segment_id": 23,
   "arabic": "وَتَرَكَتْ نُصْرَتَكَ وَمَعُونَتَكَ"
  },
  {
   "segment_id": 24,
   "arabic": "وَلَعَنَ ٱللَّهُ أُمَّةً أَسَّسَتْ أَسَاسَ ٱلظُّلْمِ لَكُمْ"
  },
  {
   "segment_id": 25,
   "arabic": "وَمَهَّدَتِ ٱلْجَوْرَ عَلَيْكُمْ"
  },
  {
   "segment_id": 26,
   "arabic": "وَطَرَّقَتْ إِلَىٰ أَذِيَّتِكُمْ وَتَحَيُّفِكُمْ"
  },
  {
   "segment_id": 27,
   "arabic": "وَجَارَتْ ذٰلِكَ فِي دِيَارِكُمْ وَأَشْيَاعِكُمْ"
  },
  {
   "segment_id": 28,
   "arabic": "بَرِئْتُ إِلَىٰ ٱللَّهِ عَزَّ وَجَلَّ وَإِلَيْكُمْ"
  },
  {
   "segment_id": 29,
   "arabic": "يَا سَادَاتِي وَمَوَالِيَّ وَأَئِمَّتِي"
  },
  {
   "segment_id": 30,
   "arabic": "مِنْهُمْ وَمِنْ أَشْيَاعِهِمْ وَأَتْبَاعِهِمْ"
  },
  {
   "segment_id": 31,
   "arabic": "وَسْأَلُ ٱللَّهَ ٱلَّذِي أَكْرَمَ يَا مَوَالِيَّ مَقَامَكُمْ"
  },
  {
   "segment_id": 32,
   "arabic": "وَشَرَّفَ مَنْزِلَتَكُمْ وَشَأْنَكُمْ"
  },
  {
   "segment_id": 33,
   "arabic": "أَنْ يُكْرِمَنِي بِوِلاَيَتِكُمْ وَمَحَبَّتِكُمْ وَٱلٱِئْتِمَامِ بِكُمْ"
  },
  {
   "segment_id": 34,
   "arabic": "وَبِٱلْبَرَاءَةِ مِنْ أَعْدَائِكُمْ"
  },
  {
   "segment_id": 35,
   "arabic": "وَأَسْأَلُ ٱللَّهَ ٱلْبَرَّ ٱلرَّحِيمَ أَنْ يَرْزُقَنِي مَوَدَّتَكُمْ"
  },
  {
   "segment_id": 36,
   "arabic": "وَأَنْ يُوَفِّقَنِي لِلطَّلَبِ بِثَارِكُمْ"
  },
  {
   "segment_id": 37,
   "arabic": "مَعَ ٱلإِمَامِ ٱلْمُنْتَظَرِ ٱلْهَادِي مِنْ آلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 38,
   "arabic": "وَأَنْ يَجْعَلَنِي مَعَكُمْ فِي ٱلدُّنْيَا وَٱلآخِرَةِ"
  },
  {
   "segment_id": 39,
   "arabic": "وَأَنْ يُبَلِّغَنِيَ ٱلْمَقَامَ ٱلْمَحْمُودَ لَكُمْ عِنْدَ ٱللَّهِ"
  },
  {
   "segment_id": 40,
   "arabic": "وَأَسْأَلُ ٱللَّهَ عَزَّ وَجَلَّ بِحَقِّكُمْ"
  },
  {
   "segment_id": 41,
   "arabic": "وَبِٱلشَّأْنِ ٱلَّذِي جَعَلَ ٱللَّهُ لَكُمْ"
  },
  {
   "segment_id": 42,
   "arabic": "أَنْ يُعْطِيَنِي بِمُصَابِي بِكُمْ"
  },
  {
   "segment_id": 43,
   "arabic": "أَفْضَلَ مَا أَعْطَىٰ مُصَاباً بِمُصيبَةٍ"
  },
  {
   "segment_id": 44,
   "arabic": "إِنَّا لِلَّهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ"
  },
  {
   "segment_id": 45,
   "arabic": "يَا لَهَا مِنْ مُصيبَةٍ"
  },
  {
   "segment_id": 46,
   "arabic": "مَا أَفْجَعَهَا وَأَنْكَاهَا لِقُلُوبِ ٱلْمُؤْمِنِينَ وَٱلْمُسْلِمينَ"
  },
  {
   "segment_id": 47,
   "arabic": "فَإِنَا لِلَّهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ"
  },
  {
   "segment_id": 48,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 49,
   "arabic": "وَٱجْعَلْنِي فِي مَقَامِي"
  },
  {
   "segment_id": 50,
   "arabic": "مِمَّنْ تَنَالُهُ مِنْكَ صَلَوَاتٌ وَرَحْمَةٌ وَمَغْفِرَةٌ"
  },
  {
   "segment_id": 51,
   "arabic": "وَٱجْعَلْنِي عِنْدَكَ وَجِيهاً"
  },
  {
   "segment_id": 52,
   "arabic": "فِي ٱلدُّنْيَا وَٱلآخِرَةِ وَمِنَ ٱلْمُقَرَّبِينَ"
  },
  {
   "segment_id": 53,
   "arabic": "فَإِنِّي أَتَقَرَّبُ إِلَيْكَ بِمُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 54,
   "arabic": "صَلَوَاتُكَ عَلَيْهِ وَعَلَيْهِمْ أَجْمَعِينَ"
  },
  {
   "segment_id": 55,
   "arabic": "اَللَّهُمَّ وَإِنِّي أَتَوَسَّلُ وَأَتَوَجَّهُ"
  },
  {
   "segment_id": 56,
   "arabic": "بِصَفْوَتِكَ مِنْ خَلْقِكَ"
  },
  {
   "segment_id": 57,
   "arabic": "وَخِيَرَتِكَ مِنْ خَلْقِكَ"
  },
  {
   "segment_id": 58,
   "arabic": "مُحَمَّدٍ وَعَلِيٍّ وَٱلطَّيِّبِينَ مِنْ ذُرِّيَّتِهِمَا"
  },
  {
   "segment_id": 59,
   "arabic": "اَللَّهُمَّ فَصَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 60,
   "arabic": "وَٱجْعَلْ مَحْيَايَ مَحْيَاهُمْ"
  },
  {
   "segment_id": 61,
   "arabic": "وَمَمَاتِي مَمَاتَهُمْ"
  },
  {
   "segment_id": 62,
   "arabic": "وَلاَ تُفَرِّقْ بَيْنِي وَبَيْنَهُمْ"
  },
  {
   "segment_id": 63,
   "arabic": "فِي ٱلدُّنْيَا وَٱلآخِرَةِ"
  },
  {
   "segment_id": 64,
   "arabic": "إِنَّكَ سَمِيعُ ٱلدُّعَاءِ"
  },
  {
   "segment_id": 65,
   "arabic": "اَللَّهُمَّ وَهٰذَا يَوْمٌ تُجَدَّدُ فِيهِ ٱلنِّقْمَةُ"
  },
  {
   "segment_id": 66,
   "arabic": "وَتُنَزَّلَ فِيهِ ٱللَّعْنَةُ"
  },
  {
   "segment_id": 67,
   "arabic": "عَلَىٰ ٱللَّعينِ يَزِيدَ وَعَلَىٰ آلِ يَزِيدَ"
  },
  {
   "segment_id": 68,
   "arabic": "وَعَلَىٰ آلِ زِيَادٍ وَعُمَرَ بْنِ سَعْدٍ وَٱلشِّمْرِ"
  },
  {
   "segment_id": 69,
   "arabic": "اَللَّهُمَّ ٱلْعَنْهُمْ وَٱلْعَنْ مَنْ رَضِيَ بِقَوْلِهِمْ وَفِعْلِهِمْ"
  },
  {
   "segment_id": 70,
   "arabic": "مِنْ أَوَّلٍ وَآخِرٍ لَعْناً كَثيراً"
  },
  {
   "segment_id": 71,
   "arabic": "وَأَصْلِهِمْ حَرَّ نَارِكَ"
  },
  {
   "segment_id": 72,
   "arabic": "وَأَسْكِنْهُمْ جَهَنَّمَ وَسَاءَتْ مَصيراً"
  },
  {
   "segment_id": 73,
   "arabic": "وَأَوْجِبْ عَلَيْهِمْ وَعَلَىٰ كُلِّ مَنْ شَايَعَهُمْ"
  },
  {
   "segment_id": 74,
   "arabic": "وَبَايَعَهُمْ وَتَابَعَهُمْ وَسَاعَدَهُمْ"
  },
  {
   "segment_id": 75,
   "arabic": "وَرَضِيَ بِفِعْلِهِمْ"
  },
  {
   "segment_id": 76,
   "arabic": "وَٱفْتَحْ لَهُمْ وَعَلَيْهِمْ"
  },
  {
   "segment_id": 77,
   "arabic": "وَعَلَىٰ كُلِّ مَنْ رَضِيَ بِذٰلِكَ"
  },
  {
   "segment_id": 78,
   "arabic": "لَعَنَاتِكَ ٱلَّتِي لَعَنْتَ بِهَا كُلَّ ظَالِمٍ"
  },
  {
   "segment_id": 79,
   "arabic": "وَكُلَّ غَاصِبٍ وَكُلَّ جَاحِدٍ"
  },
  {
   "segment_id": 80,
   "arabic": "وَكُلَّ كَافِرٍ وَكُلَّ مُشْرِكٍ"
  },
  {
   "segment_id": 81,
   "arabic": "وَكُلَّ شَيْطَانٍ رَجِيمٍ وَكُلَّ جَبَّارٍ عَنِيدٍ"
  },
  {
   "segment_id": 82,
   "arabic": "اَللَّهُمَّ ٱلْعَنْ يَزِيدَ وَآلَ يَزِيدَ"
  },
  {
   "segment_id": 83,
   "arabic": "وَبَنِي مَرْوَانَ جَمِيعاً"
  },
  {
   "segment_id": 84,
   "arabic": "اَللَّهُمَّ وَضَعِّفْ غَضَبَكَ وَسَخَطَكَ"
  },
  {
   "segment_id": 85,
   "arabic": "وَعَذَابَكَ وَنَقِمَتَكَ"
  },
  {
   "segment_id": 86,
   "arabic": "عَلَىٰ أَوَّلِ ظَالِمٍ ظَلَمَ أَهْلَ بَيْتِ نَبِيِّكَ"
  },
  {
   "segment_id": 87,
   "arabic": "اَللَّهُمَّ وَٱلْعَنْ جَمِيعَ ٱلظَّالِمينَ لَهُمْ"
  },
  {
   "segment_id": 88,
   "arabic": "وَٱنْتَقِمْ مِنْهُمْ"
  },
  {
   "segment_id": 89,
   "arabic": "إِنَّكَ ذوُ نِقْمَة مِنَ ٱلْمُجْرِمِينَ"
  },
  {
   "segment_id": 90,
   "arabic": "اَللَّهُمَّ وَٱلْعَنْ أَوَّلَ ظَالِمٍ ظَلَمَ آلَ بَيْتِ مُحَمَّدٍ"
  },
  {
   "segment_id": 91,
   "arabic": "وَٱلْعَنْ أَرْوَاحَهُمْ وَدِيَارَهُمْ وَقُبُورَهُمْ"
  },
  {
   "segment_id": 92,
   "arabic": "وَٱلْعَنِ ٱللَّهُمَّ ٱلْعِصَابَةَ ٱلَّتِي نَازَلَتِ ٱلْحُسَيْنَ"
  },
  {
   "segment_id": 93,
   "arabic": "ٱبْنَ بِنْتَ نَبِيِّكَ"
  },
  {
   "segment_id": 94,
   "arabic": "وَحَارَبَتْهُ وَقَتَلَتْ أَصْحَابَهُ وَأَنْصَارَهُ"
  },
  {
   "segment_id": 95,
   "arabic": "وَأَعْوَانَهُ وَأَوْلِيَاءَهُ"
  },
  {
   "segment_id": 96,
   "arabic": "وَشيعَتَهُ وَمُحِبِّيهِ"
  },
  {
   "segment_id": 97,
   "arabic": "وَأَهْلَ بَيْتِهِ وَذُرِّيَّتَهُ"
  },
  {
   "segment_id": 98,
   "arabic": "وَٱلْعَنِ ٱللَّهُمَّ ٱلَّذِينَ نَهَبُوٱ مَالَهُ"
  },
  {
   "segment_id": 99,
   "arabic": "وَسَلَبُوٱ حَرِيـمَهُ"
  },
  {
   "segment_id": 100,
   "arabic": "وَلَمْ يَسْمَعُوٱ كَلاَمَهُ وَلاَ مَقَالَهُ"
  },
  {
   "segment_id": 101,
   "arabic": "اَللَّهُمَّ وَٱلْعَنْ كُلَّ مَنْ بَلَغَهُ ذٰلِكَ فَرَضِيَ بِهِ"
  },
  {
   "segment_id": 102,
   "arabic": "مِنَ ٱلأَوَّلِينَ وَٱلآخِرِينَ"
  },
  {
   "segment_id": 103,
   "arabic": "وَٱلْخَلاَئِقِ أَجْمَعِينَ إِلَىٰ يَوْمِ ٱلدِّينِ"
  },
  {
   "segment_id": 104,
