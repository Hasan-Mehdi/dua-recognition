{
 "dua_id": "dua-allahuma-arzukni",
 "dua_name_en": "Dua Allah'humma Arz'ukni",
 "dua_name_ar": "اللّهُمَّ ارْزُقْنِي",
 "source": "https://www.duaplayer.org/en/dua/allahuma-arzukni",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اللّهُمَّ ارْزُقْنِي حَجَّ بَيْتِكَ الْحَرَامِ"
  },
  {
   "segment_id": 3,
   "arabic": "فِي عَامِي هذَا وَفِي كُلِّ عَامٍ"
  },
  {
   "segment_id": 4,
   "arabic": "مَا أَبْقَيْتَنِي فِي يُسْرٍ مِنْكَ وَعَافِيَةٍ وَسَعَةِ رِزْقٍ،"
  },
  {
   "segment_id": 5,
   "arabic": "وَلا تُخْلِنِي مِنْ تِلْكَ الْمَوَاقِفِ الْكَرِيمَةِ،"
  },
  {
   "segment_id": 6,
   "arabic": "وَالْمَشَاهِدِ الشَّرِيفَةِ،"
  },
  {
   "segment_id": 7,
   "arabic": "وَزِيَارَةِ قَبْرِ نَبِيِّكَ صَلَوَاتُكَ عَلَيْهِ وَآلِهِ،"
  },
  {
   "segment_id": 8,
   "arabic": "وَفِي جَمِيعِ حَوَائِجِ الدُّنْيَا وَالأخِرَةِ فَكُنْ لِي"
  },
  {
   "segment_id": 9,
   "arabic": "اللّهُمَّ إنِّي أَسْأَلُكَ فِي مَا تَقْضِي وَتُقَدِّرُ"
  },
  {
   "segment_id": 10,
   "arabic": "مِنْ الأمْرِ الْمَحْتُومِ فِي لَيْلَةِ الْقَدْرِ"
  },
  {
   "segment_id": 11,
   "arabic": "مِنَ الْقَضَاءِ الَّذِي لا يُرَدُّ وَلا يُبَدَّلُ"
  },
  {
   "segment_id": 12,
   "arabic": "أَنْ تَكْتُبَنِي مِنْ حُجَّاجِ بَيْتِكَ الْحَرَامِ"
  },
  {
   "segment_id": 13,
   "arabic": "الْمَبْرُورِ حَجُّهُمُ،"
  },
  {
   "segment_id": 14,
   "arabic": "الْمَشْكُورِ سَعْيُهُمُ،"
  },
  {
   "segment_id": 15,
   "arabic": "الْمَغْفُورِ ذُنُوبُهُمُ،"
  },
  {
   "segment_id": 16,
   "arabic": "الْمُكَفَّرِ عَنْهُمْ سَيِّئَاتُهُمْ،"
  },
  {
   "segment_id": 17,
   "arabic": "وَاجْعَلْ فِي مَا تَقْضِي وَتُقَدِّرُ"
  },
  {
   "segment_id": 18,
   "arabic": "أَنْ تُطِيلَ عُمْرَي"
  },
  {
   "segment_id": 19,
   "arabic": "وَتُوَسِّعَ عَلَيَّ رِزْقِي،"
  },
  {
   "segment_id": 20,
   "arabic": "وَتُؤَدِّيَ عَنِّي أَمَانَتِي وَدَيْنِي،"
  },
  {
   "segment_id": 21,
   "arabic": "آمِين رَبَّ الْعَالَمِينَ."
  }
 ]
}