{
 "dua_id": "sahifa-50",
 "dua_name_en": "Sahifa 50: His supplication in fear",
 "dua_name_ar": "دعـاؤه في الرهبةِ",
 "source": "https://duas.pro/50-his-supplication-in-fear",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "أَللَّهُمَّ إنَّكَ خَلَقْتَنِي سَوِيّاً،"
  },
  {
   "segment_id": 2,
   "arabic": "وَرَبَّيْتَنِي صَغِيراً، وَرَزَقْتَنِي مَكْفِيّاً."
  },
  {
   "segment_id": 3,
   "arabic": "أَللَّهُمَّ إنِّي وَجَدْتُ فِيمَا أَنْزَلْتَ مِنْ كِتَابِكَ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَبَشَّرْتَ بِهِ عِبَادِكَ،"
  },
  {
   "segment_id": 5,
   "arabic": "أَنْ قُلْتَ: (يا عِبَادِيَ الَّذِينَ أَسْرَفُوا عَلَى أَنْفُسِهِمْ"
  },
  {
   "segment_id": 6,
   "arabic": "لاَ تَقْنَطُوا مِنْ رَحْمَةِ اللهِ إنَّ اللهَ يَغْفِرُ الذُّنُوبَ جَمِيعاً)"
  },
  {
   "segment_id": 7,
   "arabic": "وَقَدْ تَقَدَّمَ مِنِّي مَا قَدْ عَلِمْتَ،"
  },
  {
   "segment_id": 8,
   "arabic": "وَمَا أَنْتَ أَعْلَمُ بِهِ مِنِّي،"
  },
  {
   "segment_id": 9,
   "arabic": "فَيَا سَوْأَتا مِمَّا أَحْصَاهُ عَلَيَّ كِتَابُكَ،"
  },
  {
   "segment_id": 10,
   "arabic": "فَلَوْلاَ الْمَوَاقِفُ الَّتِي أُؤَمِّلُ مِنْ عَفْوِكَ"
  },
  {
   "segment_id": 11,
   "arabic": "الَّذِي شَمِلَ كُلَّ شَيْء لاَلْقَيْتُ بِيَدِي،"
  },
  {
   "segment_id": 12,
   "arabic": "وَلَوْ أَنَّ أَحَداً اسْتَطاعَ الْهَرَبَ"
  },
  {
   "segment_id": 13,
   "arabic": "مِنْ رَبِّهِ لَكُنْتُ أَنَا أَحَقُّ بِالهَرَبِ مِنکَ،"
  },
  {
   "segment_id": 14,
   "arabic": "وَأَنْتَ لاَ تَخْفَى عَلَيْكَ خَافِيَةٌ فِي الاَرْضِ"
  },
  {
   "segment_id": 15,
   "arabic": "وَلاَ فِي السَّمَآءِ إلاَّ أَتَيْتَ بِهَا،"
  },
  {
   "segment_id": 16,
   "arabic": "وَكَفى بِكَ جَازِياً، وَكَفى بِكَ حَسِيباً."
  },
  {
   "segment_id": 17,
   "arabic": "أَللَّهُمَّ إنَّكَ طَالِبِي إنْ أَنَا هَرَبْتُ،"
  },
  {
   "segment_id": 18,
   "arabic": "وَمُدْرِكِي إنْ أَنَا فَرَرْتُ،"
  },
  {
   "segment_id": 19,
   "arabic": "فَهَا أَنَا ذَا بَيْنَ يَدَيْكَ خَاضِعٌ ذَلِيلٌ رَاغِمٌ،"
  },
  {
   "segment_id": 20,
   "arabic": "إنْ تُعَذِّبْنِي فَإنّي لِذلِكَ أَهْلٌ،"
  },
  {
   "segment_id": 21,
   "arabic": "وَهُوَ يَارَبِّ مِنْكَ عَدْلٌ،"
  },
  {
   "segment_id": 22,
   "arabic": "وَإنْ تَعْفُ عَنِّي فَقَدِيماً شَمَلَنِي عَفْوُكَ،"
  },
  {
   "segment_id": 23,
   "arabic": "وَأَلْبَسْتَنِي عَافِيَتَكَ."
  },
  {
   "segment_id": 24,
   "arabic": "فَأَسْأَلُكَ اللَّهُمَّ بِالْمَخْزونِ مِنْ أَسْمائِكَ،"
  },
  {
   "segment_id": 25,
   "arabic": "وَبِمَا وَارتْهُ الْحُجُبُ مِنْ بَهَائِكَ،"
  },
  {
   "segment_id": 26,
   "arabic": "إلاَّ رَحِمْتَ هذِهِ النَّفْسَ الْجَزُوعَةَ،"
  },
  {
   "segment_id": 27,
   "arabic": "وَهَذِهِ الرِّمَّةَ الْهَلُوعَةَ،"
  },
  {
   "segment_id": 28,
   "arabic": "الَّتِي لاَ تَسْتَطِيعُ حَرَّ شَمْسِكَ،"
  },
  {
   "segment_id": 29,
   "arabic": "فَكَيْفَ تَسْتَطِيعُ حَرَّ نارِكَ؟"
  },
  {
   "segment_id": 30,
   "arabic": "وَالَّتِي لاَ تَسْتَطِيعُ صَوْتَ رَعْدِكَ،"
  },
  {
   "segment_id": 31,
   "arabic": "فَكَيْفَ تَسْتَطِيعُ صَوْتَ غَضَبِكَ؟"
  },
  {
   "segment_id": 32,
   "arabic": "فَارْحَمْنِي اللَّهُمَّ فَإنِّي امْرُؤٌ حَقِيرٌ، وَخَطَرِي يَسِيرٌ،"
  },
  {
   "segment_id": 33,
   "arabic": "وَلَيْسَ عَذَابِي مِمَّا يَزِيدُ فِي مُلْكِكَ مِثْقَالَ ذَرَّة،"
  },
  {
   "segment_id": 34,
   "arabic": "وَلَوْ أَنَّ عَذَابِي مِمَّا يَزِيدُ فِي مُلْكِكَ"
  },
  {
   "segment_id": 35,
   "arabic": "لَسَأَلْتُكَ الصَّبْرَ عَلَيْهِ،"
  },
  {
   "segment_id": 36,
   "arabic": "وَأَحْبَبْتُ أَنْ يَكُونَ ذلِكَ لَكَ،"
  },
  {
   "segment_id": 37,
   "arabic": "وَلكِنْ سُلْطَانُكَ اللَّهُمَّ أَعْظَمُ،"
  },
  {
   "segment_id": 38,
   "arabic": "وَمُلْكُكَ أَدْوَمُ مِنْ أَنْ تَزِيـدَ فِيْهِ طَاعَةُ الْمُطِيعِينَ،"
  },
  {
   "segment_id": 39,
   "arabic": "أَوْ تُنْقِصَ مِنْهُ مَعْصِيَةُ الْمُذْنِبِينَ."
  },
  {
   "segment_id": 40,
   "arabic": "فَارْحَمْنِي يا أَرْحَمَ الرَّاحِمِينَ،"
  },
  {
   "segment_id": 41,
   "arabic": "وَتَجاوَزْ عَنِّي يا ذَا الْجَلاَلِ وَالإكْرَامِ،"
  },
  {
   "segment_id": 42,
   "arabic": "وَتُبْ عَلَيَّ إنَّكَ أَنْتَ التَّوَّابُ الرَّحِيمُ."
  }
 ]
}