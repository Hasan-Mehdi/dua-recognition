{
 "dua_id": "dua-ramadan-2",
 "dua_name_en": "Day 2",
 "dua_name_ar": " شهر رمضان ٢",
 "source": "https://www.duaplayer.org/en/dua/ramadan-2",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 2,
   "arabic": "اللّهُمّ قَرّبْنِي فِيهِ إِلَى مَرْضَاتِكَ،"
  },
  {
   "segment_id": 3,
   "arabic": "وَجَنّبْنِي فِيهِ مِنْ سَخَطِكَ وَنَقِمَاتِكَ،"
  },
  {
   "segment_id": 4,
   "arabic": "وَوَفّقْنِي فِيهِ لِقِرَاءَةِ آيَاتِكَ،"
  },
  {
   "segment_id": 5,
   "arabic": "بِرَحْمَتِكَ يَاأَرْحَمَ الرَّاحِمِينَ."
  }
 ]
}