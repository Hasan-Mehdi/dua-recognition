{
 "dua_id": "dua-ramadan-24-night",
 "dua_name_en": "Dua Night 24",
 "dua_name_ar": "",
 "source": "https://www.duaplayer.org/en/dua/ramadan-24-night",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
  },
  {
   "segment_id": 2,
   "arabic": "اَللّهُمَّ صَلِّ عَلى مُحَمَّد وَآلِ مُحَمَّد"
  },
  {
   "segment_id": 3,
   "arabic": "يَا فَالِقَ ٱلإِصْبَاحِ"
  },
  {
   "segment_id": 4,
   "arabic": "وَجَاعِلَ ٱللَّيْلِ سَكَناً"
  },
  {
   "segment_id": 5,
   "arabic": "وَٱلشَّمْسَ وَٱلقَمَرَ حُسْبَاناً"
  },
  {
   "segment_id": 6,
   "arabic": "يَا عَزِيزُ يَا عَلِيمُ"
  },
  {
   "segment_id": 7,
   "arabic": "يَا ذَا ٱلْمَنِّ وَٱلطَّوْلِ"
  },
  {
   "segment_id": 8,
   "arabic": "وَٱلقُوَّةِ وَٱلْحَوْلِ"
  },
  {
   "segment_id": 9,
   "arabic": "وَٱلفَضْلِ وَٱلإِنْعَامِ"
  },
  {
   "segment_id": 10,
   "arabic": "وَٱلْجَلاَلِ وَٱلإِكْرَامِ"
  },
  {
   "segment_id": 11,
   "arabic": "يَا اللَّهُ يَا رَحْمٰنُ"
  },
  {
   "segment_id": 12,
   "arabic": "يَا اللَّهُ يَا فَرْدُ يَا وِتْرُ"
  },
  {
   "segment_id": 13,
   "arabic": "يَا اللَّهُ يَا ظَاهِرُ يَا بَاطِنُ"
  },
  {
   "segment_id": 14,
   "arabic": "يَا حَيُّ لاَ إِلٰهَ إِلاَّ انْتَ"
  },
  {
   "segment_id": 15,
   "arabic": "لَكَ ٱلاسْمَاءُ ٱلْحُسْنَىٰ"
  },
  {
   "segment_id": 16,
   "arabic": "وَٱلامْثَالُ ٱلْعُلْيَا"
  },
  {
   "segment_id": 17,
   "arabic": "وَٱلْكِبْرِيَاءُ وَٱلآلاَءُ"
  },
  {
   "segment_id": 18,
   "arabic": "اسْالُكَ انْ تُصَلِّيَ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 19,
   "arabic": "وَانْ تَجْعَلَ ٱسْمِي فِي هٰذِهِ ٱللَّيْلَةِ فِي ٱلسُّعَدَاءِ"
  },
  {
   "segment_id": 20,
   "arabic": "وَرُوحِي مَعَ ٱلشُّهَدَاءِ"
  },
  {
   "segment_id": 21,
   "arabic": "وَإِحْسَانِي فِي عِلِّيِّينَ"
  },
  {
   "segment_id": 22,
   "arabic": "وَإِسَاءَتِي مَغْفُورَةً"
  },
  {
   "segment_id": 23,
   "arabic": "وَانْ تَهَبَ لِي يَقِيناً تُبَاشِرُ بِهِ قَلْبِي"
  },
  {
   "segment_id": 24,
   "arabic": "وَإِيـمَاناً يُذْهِبُ ٱلشَّكَّ عَنِّي"
  },
  {
   "segment_id": 25,
   "arabic": "وَتُرْضِيَنِي بِمَا قَسَمْتَ لِي"
  },
  {
   "segment_id": 26,
   "arabic": "وَآتِنَا فِي ٱلدُّنْيَا حَسَنَةً"
  },
  {
   "segment_id": 27,
   "arabic": "وَفِي ٱلآخِرَةِ حَسَنَةً"
  },
  {
   "segment_id": 28,
   "arabic": "وَقِنَا عَذَابَ ٱلنَّارِ ٱلْحَرِيقِ"
  },
  {
   "segment_id": 29,
   "arabic": "وَٱرْزُقْنِي فِيهَا ذِكْرَكَ وَشُكْرَكَ وَٱلرَّغْبَةَ إِلَيْكَ"
  },
  {
   "segment_id": 30,
   "arabic": "وَٱلإِنَابَةَ وَٱلتَّوْفِيقَ لِمَا وَفَّقْتَ لَهُ مُحَمَّداً وَآلَ مُحَمَّدٍ عَلَيْهِ وَعَلَيْهِمُ ٱلسَّلاَمُ"
  }
 ]
}