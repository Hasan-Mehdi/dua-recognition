{
 "dua_id": "sahifa-23",
 "dua_name_en": "Sahifa 23: when he asked god for well being",
 "dua_name_ar": "ددُعَاؤُهُ بِالْعَافِيَةِ",
 "source": "https://duas.pro/23-when-he-asked-god-for-well-being",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "أَللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 2,
   "arabic": "وَأَلْبِسْنِي عَافِيَتَكَ وَجَلِّلْنِي عَافِيَتَكَ"
  },
  {
   "segment_id": 3,
   "arabic": "وَحَصِّنْنِي بِعَافِيَتِكَ وَأَكْرِمْنِي بِعَافِيَتِكَ"
  },
  {
   "segment_id": 4,
   "arabic": "وَأَغْنِنِي بِعَافِيَتِكَ وَتَصَدَّقْ عَلَيَّ بِعَافِيَتِكَ"
  },
  {
   "segment_id": 5,
   "arabic": "وَهَبْ لِي عَافِيَتَكَ وَأَفْرِشْنِي عَافِيَتَكَ"
  },
  {
   "segment_id": 6,
   "arabic": "وَأَصْلِحْ لِي عَافِيَتَكَ وَلَا تُفَرِّقْ بَيْنِي وَبَيْنَ عَافِيَتِكَ"
  },
  {
   "segment_id": 7,
   "arabic": "فِي الدُّنْيَا وَالْآخِرَةِ"
  },
  {
   "segment_id": 8,
   "arabic": "وَعَافِنِي عَافِيَةً كَافِيَةً شَافِيَةً"
  },
  {
   "segment_id": 9,
   "arabic": "عَالِيَةً نَامِيَةً عَافِيَةً تُوَلِّدُ فِي بَدَنِي الْعَافِيَةَ"
  },
  {
   "segment_id": 10,
   "arabic": "عَافِيَةَ الدُّنْيَا وَالْآخِرَةِ"
  },
  {
   "segment_id": 11,
   "arabic": "وَامْنُنْ عَلَيَّ بِالصِّحَّةِ وَالْأَمْنِ"
  },
  {
   "segment_id": 12,
   "arabic": "وَالسَّلَامَةِ فِي دِينِي وَبَدَنِي"
  },
  {
   "segment_id": 13,
   "arabic": "وَالْبَصِيرَةِ فِي قَلْبِي وَالنَّفَاذِ فِي أُمُورِي"
  },
  {
   "segment_id": 14,
   "arabic": "وَالْخَشْيَةِ لَكَ وَالْخَوْفِ مِنْكَ"
  },
  {
   "segment_id": 15,
   "arabic": "وَالْقُوَّةِ عَلَى مَا أَمَرْتَنِي بِهِ مِنْ طَاعَتِكَ"
  },
  {
   "segment_id": 16,
   "arabic": "وَالِاجْتِنَابِ لِمَا نَهَيْتَنِي عَنْهُ مِنْ مَعْصِيَتِكَ"
  },
  {
   "segment_id": 17,
   "arabic": "أَللَّهُمَّ وَامْنُنْ عَلَيَّ بِالْحَجِّ وَالْعُمْرَةِ"
  },
  {
   "segment_id": 18,
   "arabic": "وَزِيَارَةِ قَبْرِ رَسُولِكَ صَلَوَاتُكَ عَلَيْهِ"
  },
  {
   "segment_id": 19,
   "arabic": "وَرَحْمَتُكَ وَبَرَكَاتُكَ عَلَيْهِ وَعَلَى آلِهِ"
  },
  {
   "segment_id": 20,
   "arabic": "وَآلِ رَسُولِكَ عَلَيْهِمُ السَّلَامُ"
  },
  {
   "segment_id": 21,
   "arabic": "أَبَدًا مَا أَبْقَيْتَنِي فِي عَامِي هَذَا"
  },
  {
   "segment_id": 22,
   "arabic": "وَفِي كُلِّ عَامٍ وَاجْعَلْ ذَلِكَ مَقْبُولًا"
  },
  {
   "segment_id": 23,
   "arabic": "مَشْكُورًا مَذْكُورًا لَدَيْكَ مَذْخُورًا عِنْدَكَ"
  },
  {
   "segment_id": 24,
   "arabic": "وَأَنْطِقْ بِحَمْدِكَ وَشُكْرِكَ وَذِكْرِكَ"
  },
  {
   "segment_id": 25,
   "arabic": "وَحُسْنِ الثَّنَاءِ عَلَيْكَ لِسَانِي"
  },
  {
   "segment_id": 26,
   "arabic": "وَاشْرَحْ لِمَرَاشِدِ دِينِكَ قَلْبِي"
  },
  {
   "segment_id": 27,
   "arabic": "وَأَعِذْنِي وَذُرِّيَّتِي مِنَ الشَّيْطَانِ الرَّجِيمِ"
  },
  {
   "segment_id": 28,
   "arabic": "وَمِنْ شَرِّ السَّامَّةِ وَالْهَامَّةِ"
  },
  {
   "segment_id": 29,
   "arabic": "وَالْعَامَّةِ وَاللَّامَّةِ"
  },
  {
   "segment_id": 30,
   "arabic": "وَمِنْ شَرِّ كُلِّ شَيْطَانٍ مَرِيدٍ"
  },
  {
   "segment_id": 31,
   "arabic": "وَمِنْ شَرِّ كُلِّ سُلْطَانٍ عَنِيدٍ"
  },
  {
   "segment_id": 32,
   "arabic": "وَمِنْ شَرِّ كُلِّ مُتْرَفٍ حَفِيدٍ"
  },
  {
   "segment_id": 33,
   "arabic": "وَمِنْ شَرِّ كُلِّ ضَعِيفٍ وَشَدِيدٍ"
  },
  {
   "segment_id": 34,
   "arabic": "وَمِنْ شَرِّ كُلِّ شَرِيفٍ وَوَضِيعٍ"
  },
  {
   "segment_id": 35,
   "arabic": "وَمِنْ شَرِّ كُلِّ صَغِيرٍ وَكَبِيرٍ"
  },
  {
   "segment_id": 36,
   "arabic": "وَمِنْ شَرِّ كُلِّ قَرِيبٍ وَبَعِيدٍ"
  },
  {
   "segment_id": 37,
   "arabic": "وَمِنْ شَرِّ كُلِّ مَنْ نَصَبَ لِرَسُولِكَ"
  },
  {
   "segment_id": 38,
   "arabic": "وَلِأَهْلِ بَيْتِهِ حَرْبًا مِنَ الْجِنِّ وَالْإِنْسِ"
  },
  {
   "segment_id": 39,
   "arabic": "وَمِنْ شَرِّ كُلِّ دَابَّةٍ أَنْتَ آخِذٌ بِنَاصِيَتِهَا"
  },
  {
   "segment_id": 40,
   "arabic": "إِنَّكَ عَلَى صِرَاطٍ مُسْتَقِيمٍ"
  },
  {
   "segment_id": 41,
   "arabic": "أَللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَآلِهِ"
  },
  {
   "segment_id": 42,
   "arabic": "وَمَنْ أَرَادَنِي بِسُوءٍ فَاصْرِفْهُ عَنِّي"
  },
  {
   "segment_id": 43,
   "arabic": "وَادْحَرْ عَنِّي مَكْرَهُ وَادْرَأْ عَنِّي شَرَّهُ"
  },
  {
   "segment_id": 44,
   "arabic": "وَرُدَّ كَيْدَهُ فِي نَحْرِهِ"
  },
  {
   "segment_id": 45,
   "arabic": "وَاجْعَلْ بَيْنَ يَدَيْهِ سَدًّا"
  },
  {
   "segment_id": 46,
   "arabic": "حَتَّى تُعْمِيَ عَنِّي بَصَرَهُ"
  },
  {
   "segment_id": 47,
   "arabic": "وَتُصِمَّ عَنْ ذِكْرِي سَمْعَهُ"
  },
  {
   "segment_id": 48,
   "arabic": "وَتُقْفِلَ دُونَ إِخْطَارِي قَلْبَهُ"
  },
  {
   "segment_id": 49,
   "arabic": "وَتُخْرِسَ عَنِّي لِسَانَهُ"
  },
  {
   "segment_id": 50,
   "arabic": "وَتَقْمَعَ رَأْسَهُ وَتُذِلَّ عِزَّهُ"
  },
  {
   "segment_id": 51,
   "arabic": "وَتَكْسِرَ جَبَرُوتَهُ وَتُذِلَّ رَقَبَتَهُ"
  },
  {
   "segment_id": 52,
   "arabic": "وَتَفْسَخَ كِبْرَهُ وَتُؤْمِنَنِي مِنْ جَمِيعِ ضَرِّهِ"
  },
  {
   "segment_id": 53,
   "arabic": "وَشَرِّهِ وَغَمْزِهِ وَهَمْزِهِ وَلَمْزِهِ"
  },
  {
   "segment_id": 54,
   "arabic": "وَحَسَدِهِ وَعَدَاوَتِهِ وَحَبَائِلِهِ"
  },
  {
   "segment_id": 55,
   "arabic": "وَمَصَائِدِهِ وَرَجْلِهِ وَخَيْلِهِ"
  },
  {
   "segment_id": 56,
   "arabic": "إِنَّكَ عَزِيزٌ قَدِيرٌ"
  }
 ]
}