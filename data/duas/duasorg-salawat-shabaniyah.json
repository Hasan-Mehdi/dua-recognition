{
 "dua_id": "duasorg-salawat-shabaniyah",
 "dua_name_en": "Sha'aban - Daily Salawat",
 "dua_name_ar": "",
 "source": "https://www.duas.org/salawat-shabaniyah.html",
 "segments": [
  {
   "segment_id": 1,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 2,
   "arabic": "شَجَرَةِ ٱلنُّبُوَّةِ"
  },
  {
   "segment_id": 3,
   "arabic": "وَمَوضِعِ ٱلرِّسَالَةِ"
  },
  {
   "segment_id": 4,
   "arabic": "وَمُخْتَلَفِ ٱلْمَلاَئِكَةِ"
  },
  {
   "segment_id": 5,
   "arabic": "وَمَعْدِنِ ٱلْعِلْمِ"
  },
  {
   "segment_id": 6,
   "arabic": "وَأَهْلِ بَيْتِ ٱلْوَحْيِ"
  },
  {
   "segment_id": 7,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 8,
   "arabic": "ٱلْفُلْكِ ٱلْجَارِيَةِ فِي ٱللُّجَجِ ٱلْغَامِرَةِ"
  },
  {
   "segment_id": 9,
   "arabic": "يَأْمَنُ مَنْ رَكِبَهَا"
  },
  {
   "segment_id": 10,
   "arabic": "وَيَغْرَقُ مَنْ تَرَكَهَا"
  },
  {
   "segment_id": 11,
   "arabic": "ٱلْمُتَقَدِّمُ لَهُمْ مَارِقٌ"
  },
  {
   "segment_id": 12,
   "arabic": "وَٱلْمُتَأَخِّرُ عَنْهُمْ زَاهِقٌ"
  },
  {
   "segment_id": 13,
   "arabic": "وَٱللاَّزِمُ لَهُمْ لاَحِقٌ"
  },
  {
   "segment_id": 14,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 15,
   "arabic": "ٱلْكَهْفِ ٱلْحَصِينِ"
  },
  {
   "segment_id": 16,
   "arabic": "وَغِيَاثِ ٱلْمُضْطَرِّ ٱلْمُسْتَكِينِ"
  },
  {
   "segment_id": 17,
   "arabic": "وَمَلْجَإِ ٱلْهَارِبِينَ"
  },
  {
   "segment_id": 18,
   "arabic": "وَعِصْمَةِ ٱلْمُعْتَصِمِينَ"
  },
  {
   "segment_id": 19,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 20,
   "arabic": "صَلاةً كَثِيرَةً تَكُونُ لَهُمْ رِضاً"
  },
  {
   "segment_id": 21,
   "arabic": "وَلِحَقِّ مُحَمَّدٍ وَآلِ مُحَمَّدٍ أَدَاءً وَقَضَاءً"
  },
  {
   "segment_id": 22,
   "arabic": "بِحَوْلٍ مِنْكَ وَقُوَّةٍ يَا رَبَّ ٱلْعَالَمِينَ"
  },
  {
   "segment_id": 23,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 24,
   "arabic": "ٱلطَّيِّبِينَ ٱلأَبْرَارِ ٱلأَخْيَارِ"
  },
  {
   "segment_id": 25,
   "arabic": "ٱلَّذِينَ أَوْجَبْتَ حُقُوقَهُمْ"
  },
  {
   "segment_id": 26,
   "arabic": "وَفَرَضْتَ طَاعَتَهُمْ وَوِلايَتَهُمْ"
  },
  {
   "segment_id": 27,
   "arabic": "اَللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ"
  },
  {
   "segment_id": 28,
   "arabic": "وَٱعْمُرْ قَلْبِي بِطَاعَتِكَ"
  },
  {
   "segment_id": 29,
   "arabic": "وَلاَ تُخْزِنِي بِمَعْصِيَتِكَ"
  },
  {
   "segment_id": 30,
   "arabic": "وَٱرْزُقْنِي مُوَاسَاةَ مَنْ قَتَّرْتَ عَلَيْهِ مِنْ رِزْقِكَ"
  },
  {
   "segment_id": 31,
   "arabic": "بِمَا وَسَّعْتَ عَلَيَّ مِنْ فَضْلِكَ"
  },
  {
   "segment_id": 32,
   "arabic": "وَنَشَرْتَ عَلَيَّ مِنْ عَدْلِكَ"
  },
  {
   "segment_id": 33,
   "arabic": "وَأَحْيَيْتَنِي تَحْتَ ظِلِّكَ"
  },
  {
   "segment_id": 34,
   "arabic": "وَهٰذَا شَهْرُ نَبِيِّكَ سَيِّدِ رُسُلِكَ"
  },
  {
   "segment_id": 35,
   "arabic": "شَعْبَانُ ٱلَّذِي حَفَفْتَهُ مِنْكَ بِٱلرَّحْمَةِ وَٱلرِّضْوَانِ"
  },
  {
   "segment_id": 36,
   "arabic": "ٱلَّذِي كَانَ رَسُولُ ٱللَّهِ صَلَّىٰ ٱللَّهُ عَلَيْهِ وَآلِهِ وَسَلَّمَ"
  },
  {
   "segment_id": 37,
   "arabic": "يَدْأَبُ فِي صِيَامِهِ وَقِيَامِهِ"
  },
  {
   "segment_id": 38,
   "arabic": "فِي لَيَالِيهِ وَأَيَّامِهِ"
  },
  {
   "segment_id": 39,
   "arabic": "بُخُوعاً لَكَ فِي إِكْرَامِهِ وَإِعْظَامِهِ"
  },
  {
   "segment_id": 40,
   "arabic": "إِلَىٰ مَحَلِّ حِمَامِهِ"
  },
  {
   "segment_id": 41,
   "arabic": "اَللَّهُمَّ فَأَعِنَّا عَلَىٰ ٱلإِسْتِنَانِ بِسُنَّتِهِ فِيهِ"
  },
  {
   "segment_id": 42,
   "arabic": "وَنَيْلِ ٱلشَّفَاعَةِ لَدَيْهِ"
  },
  {
   "segment_id": 43,
   "arabic": "اَللَّهُمَّ وَٱجْعَلْهُ لِي شَفِيعاً مُشَفَّعاً"
  },
  {
   "segment_id": 44,
   "arabic": "وَطَرِيقاً إِلَيْكَ مَهْيَعاً"
  },
  {
   "segment_id": 45,
   "arabic": "وَٱجْعَلْنِي لَهُ مُتَّبِعاً"
  },
  {
   "segment_id": 46,
   "arabic": "حَتَّىٰ أَلْقَاكَ يَوْمَ ٱلْقِيَامَةِ عَنِّي رَاضِياً"
  },
  {
   "segment_id": 47,
   "arabic": "وَعَنْ ذُنُوبِي غَاضِياً"
  },
  {
   "segment_id": 48,
   "arabic": "قَدْ أَوْجَبْتَ لِي مِنْكَ ٱلرَّحْمَةَ وَٱلرِّضْوَانَ"
  },
  {
   "segment_id": 49,
   "arabic": "وَأَنْزَلْتَنِي دَارَ ٱلْقَرَارِ وَمَحَلِّ ٱلأَخْيَارِ"
  }
 ]
}