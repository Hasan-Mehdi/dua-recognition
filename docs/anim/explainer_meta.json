 "lines": {
  "31": "يَا وَجِيهًا عِندَ اللَّهِ اشْفَعْ لَنَا عِندَ اللَّهِ",
  "32": "يَآ أَبَا عَبْدِ اللَّهِ يَا حُسَيْنَ بْنَ عَلِيٍَّ",
  "33": "أَيُّهَا الشَّهِيدُ يَا ابْنَ رَسُولِ اللَّهِ",
  "34": "يَا حُجَّةَ اللَّهِ عَلى خَلْقِهِ",
  "35": "يَا سَيِّدَنَا وَمَوْلانَا",
  "36": "إِنَّا تَوَجَّهْنَا وَاسْتَشْفَعْنَا وَتَوَسَّلْنَا بِكَ إِلىَ اللَّهِ",
  "37": "وَقَدَّمْنَاكَ بَيْنَ يَدَيْ حَاجَاتِنَا",
  "38": "يَا وَجِيهًا عِندَ اللَّهِ اشْفَعْ لَنَا عِندَ اللَّهِ"
 },
